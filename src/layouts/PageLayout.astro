---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: Lang;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  omitLocales?: Lang[];
}

const { title, description, canonical, ogImage, lang = 'en', schema, omitLocales } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} lang={lang} schema={schema} omitLocales={omitLocales}>
  <main class="pt-[60px] max-[640px]:pt-[52px]">
    <slot />
  </main>
</BaseLayout>
