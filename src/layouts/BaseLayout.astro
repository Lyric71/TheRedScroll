---
import '../styles/global.css';
import '../styles/fonts.css';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import type { Lang } from '../i18n/config';
import { alternateUrl, getAvailableAlternateLangs, hreflangCode } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: Lang;
  hideFooterCta?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** `og:type` for the page. Articles (blog posts, case studies) should pass
   *  'article' so social/AI parsers treat them as dated content, not a site. */
  ogType?: string;
  /** ISO 8601 timestamps emitted as article:published_time / :modified_time
   *  when ogType is 'article'. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Locales this specific page is NOT translated into. Their hreflang
   *  alternates are suppressed so we never emit a link to a 404 (a single dead
   *  alternate invalidates the whole cluster for Google). */
  omitLocales?: Lang[];
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/images/og-default.jpg',
  lang = 'en',
  hideFooterCta = false,
  schema,
  ogType,
  publishedTime,
  modifiedTime,
  omitLocales = [],
} = Astro.props;

const siteName = 'TheRedScroll';
const siteUrl = 'https://www.theredscroll.com';
const currentPath = Astro.url.pathname;
const altLangs = getAvailableAlternateLangs(lang).filter((l) => !omitLocales.includes(l));
const localeMap: Record<string, string> = { en: 'en_US', fr: 'fr_FR', zh: 'zh_CN', es: 'es_ES', de: 'de_DE' };
const htmlLang = hreflangCode(lang);
const ogImageUrl = new URL(ogImage, siteUrl).href;

// Homepage detection: '/', '/fr/', '/zh/', '/es/', '/de/' (with or without trailing slash)
const isHomepage = /^\/(fr|zh|es|de)?\/?$/.test(currentPath);

// BreadcrumbList for non-home pages, generated from the URL path
function buildBreadcrumbs(pathname: string): { name: string; url: string }[] {
  const segments = pathname.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
  if (segments.length === 0) return [];
  const locales = new Set(['fr', 'zh', 'es', 'de']);
  const crumbs: { name: string; url: string }[] = [];
  let acc = '';
  // Home crumb (locale-aware)
  if (locales.has(segments[0])) {
    acc = `/${segments[0]}`;
    crumbs.push({ name: 'Home', url: `${siteUrl}${acc}/` });
    segments.shift();
  } else {
    crumbs.push({ name: 'Home', url: `${siteUrl}/` });
  }
  const brandCasing: Record<string, string> = {
    wechat: 'WeChat',
    rednote: 'RedNote',
    douyin: 'Douyin',
    weibo: 'Weibo',
    wecom: 'WeCom',
    kol: 'KOL',
    koc: 'KOC',
    aigc: 'AIGC',
    crm: 'CRM',
    ai: 'AI',
    jac: 'JAC',
    iguzzini: 'iGuzzini',
  };
  for (const seg of segments) {
    acc += `/${seg}`;
    const name = seg
      .split('-')
      .map((w) => brandCasing[w.toLowerCase()] ?? w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
    crumbs.push({ name, url: `${siteUrl}${acc}/` });
  }
  return crumbs;
}
const breadcrumbs = buildBreadcrumbs(currentPath);

// Schema descriptions localized per page language. Google does not require
// schema text to match the page language, but language-matched descriptions
// improve locale-specific rich results and AI retrieval. Copy follows
// TRANSLATION_GUIDE.md register per locale.
const orgDescriptions: Record<Lang, string> = {
  en: 'China social media agency. We grow Western brands on WeChat, Douyin, RedNote, Weibo, and 14 more platforms. Fixed scope, fixed price, team in Shanghai and Hong Kong.',
  fr: 'Agence social media Chine. Nous développons les marques occidentales sur WeChat, Douyin, RedNote, Weibo et 14 autres plateformes. Périmètre défini, prix fixe, équipes à Shanghai et Hong Kong.',
  zh: '中国社交媒体代理机构。我们帮助西方品牌在微信、抖音、小红书、微博以及另外 14 个平台上增长。范围写进合同，价格一口价，团队常驻上海与香港。',
  es: 'Agencia de redes sociales en China. Hacemos crecer marcas occidentales en WeChat, Douyin, RedNote, Weibo y 14 plataformas más. Alcance definido, precio fijo, equipo en Shanghái y Hong Kong.',
  de: 'Social-Media-Agentur für China. Wir lassen westliche Marken auf WeChat, Douyin, RedNote, Weibo und 14 weiteren Plattformen wachsen. Fester Umfang, fester Preis, Teams in Shanghai und Hongkong.',
};
const founderJobTitles: Record<Lang, string> = {
  en: 'Founder and CEO',
  fr: 'Fondateur et CEO',
  zh: '创始人兼首席执行官',
  es: 'Fundador y CEO',
  de: 'Gründer und CEO',
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: siteName,
  url: siteUrl,
  // Google's Organization/logo rich result only accepts raster formats
  // (JPG/PNG/WebP); an SVG here is silently ignored. Use a 512x512 PNG.
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/images/logo/theredscroll-logo-mark-512.png`,
    width: 512,
    height: 512,
  },
  description: orgDescriptions[lang],
  areaServed: ['CN', 'HK'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    url: `${siteUrl}/contact/`,
    areaServed: ['CN', 'HK'],
    availableLanguage: ['English', 'French', 'Chinese', 'Spanish', 'German'],
  },
  address: [
    {
      '@type': 'PostalAddress',
      addressLocality: 'Shanghai',
      addressCountry: 'CN',
    },
    {
      '@type': 'PostalAddress',
      addressLocality: 'Hong Kong',
      addressCountry: 'HK',
    },
  ],
  founder: { '@id': `${siteUrl}/#founder` },
  sameAs: [
    'https://www.linkedin.com/company/theredscroll',
  ],
};

const founderSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#founder`,
  name: 'Cyril Drouin',
  jobTitle: founderJobTitles[lang],
  worksFor: { '@id': `${siteUrl}/#organization` },
  url: `${siteUrl}/about/`,
  // Recommended for E-E-A-T / Knowledge Panel image eligibility.
  image: `${siteUrl}/images/team/Cyil-Drouin.jpg`,
  sameAs: [
    'https://www.linkedin.com/in/cyrildrouin',
  ],
};

const websiteSchema = isHomepage ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: siteName,
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: ['en', 'fr', 'zh-Hans', 'es', 'de'],
} : null;

const breadcrumbSchema = breadcrumbs.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
} : null;

const pageSchemas: Record<string, unknown>[] = Array.isArray(schema) ? schema : schema ? [schema] : [];
const allSchemas = [orgSchema, founderSchema, websiteSchema, breadcrumbSchema, ...pageSchemas].filter(Boolean) as Record<string, unknown>[];

// Default og:type to 'article' whenever the page ships Article/BlogPosting
// structured data (blog posts, case studies), so social/AI parsers treat it as
// dated content. An explicit ogType prop always wins.
const articleTypes = new Set(['Article', 'BlogPosting', 'NewsArticle']);
const hasArticleSchema = pageSchemas.some((s) => articleTypes.has(s['@type'] as string));
const resolvedOgType = ogType ?? (hasArticleSchema ? 'article' : 'website');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/logo/theredscroll-logo-5B-mark-only.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={hreflangCode(lang)} href={`${siteUrl}${currentPath}`} />
    {altLangs.map((al) => (
      <link rel="alternate" hreflang={hreflangCode(al)} href={`${siteUrl}${alternateUrl(currentPath, al)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${lang === 'en' ? currentPath : alternateUrl(currentPath, 'en')}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={resolvedOgType} />
    {resolvedOgType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {resolvedOgType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta property="og:locale" content={localeMap[lang] || 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-500.woff2" as="font" type="font/woff2" crossorigin />
    {isHomepage && (
      <>
        {/* Media-scoped preloads so mobile pulls the smaller hero variant.
            Must mirror the breakpoint in Hero.astro's .hero-bg media query. */}
        <link rel="preload" href="/images/hero/hero-phones-shanghai-640.webp" as="image" fetchpriority="high" media="(max-width: 640px)" />
        <link rel="preload" href="/images/hero/hero-phones-shanghai.webp" as="image" fetchpriority="high" media="(min-width: 640.1px)" />
      </>
    )}
    {allSchemas.map((s) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
    ))}
    <!-- GA4 via first-party country gate: /ga.js returns the gtag bootstrap
         outside CN and an empty stub for CN visitors (see src/pages/ga.js.ts) -->
    <script is:inline async src="/ga.js"></script>
    <!-- Microsoft Clarity (deferred to post-load to protect LCP/INP) -->
    <script is:inline>
      window.addEventListener('load', function () {
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "wahimcnpm5");
      });
    </script>
  </head>
  <body class="font-sans antialiased text-[var(--color-ink)] bg-[var(--color-white)]">
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
    <Analytics />
  </body>
</html>
