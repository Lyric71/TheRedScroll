---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: Lang;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  omitLocales?: Lang[];
}

const { title, description, canonical, ogImage, lang = 'en', schema, publishedTime, modifiedTime, omitLocales } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} lang={lang} schema={schema} ogType="article" publishedTime={publishedTime} modifiedTime={modifiedTime} omitLocales={omitLocales}>
  <main>
    <article>
      <slot />
    </article>
  </main>
</BaseLayout>
