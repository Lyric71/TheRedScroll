---
/**
 * Shared listing page for the editorial sections (/industries/, /tools/).
 * Same card grid as /insights/, plus an empty state for a section that has
 * no published page yet.
 */
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';

interface Item {
  href: string;
  title: string;
  excerpt: string;
  category: string;
  featuredImage?: string;
  readingTime: string;
  date: string;
}

interface Props {
  overline: string;
  heading: string;
  intro: string;
  items: Item[];
  emptyText: string;
}

const { overline, heading, intro, items, emptyText } = Astro.props;
---

<section class="pt-[96px] pb-[64px] max-[640px]:pt-[64px] max-[640px]:pb-[40px]">
  <Container>
    <div>
      <SectionBar />
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">
        {overline}
      </p>
      <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[16px]">
        {heading}
      </h1>
    </div>
    <p class="text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] text-[var(--color-stone)] max-w-[680px]">
      {intro}
    </p>
  </Container>
</section>

<section class="pb-[96px] max-[640px]:pb-[64px]">
  <Container>
    {items.length === 0 ? (
      <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px] max-w-[680px]">
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] mb-[16px]">
          {emptyText}
        </p>
        <a href="/contact/" class="inline-flex items-center justify-center h-[44px] px-[28px] bg-[var(--color-vermillion)] text-[#FFFFFF] text-[14px] font-medium leading-[1] no-underline rounded-[6px] transition-[background] duration-150 hover:bg-[var(--color-vermillion-hover)] active:scale-[0.98]">
          Book a call
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
        {items.map((item) => (
          <a href={item.href} class="block bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[8px] overflow-hidden transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)]">
            {item.featuredImage ? (
              <img src={item.featuredImage} alt={item.title} width="800" height="600" class="w-full aspect-[4/3] object-cover bg-[var(--color-warm-gray)]" loading="lazy" decoding="async" />
            ) : (
              <div class="w-full aspect-[4/3] bg-[var(--color-warm-gray)]"></div>
            )}
            <div class="p-[20px]">
              <p class="text-[11px] font-medium tracking-[0.05em] uppercase text-[var(--color-vermillion)] leading-[1.2] mb-[8px]">
                {item.category}
              </p>
              <h3 class="text-[18px] text-[var(--color-ink)] font-medium leading-[1.3] mb-[8px]">
                {item.title}
              </h3>
              <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[12px] line-clamp-2">
                {item.excerpt}
              </p>
              <p class="text-[12px] text-[var(--color-stone)] font-normal leading-[1.4]">
                {item.readingTime} of reading <span class="mx-[6px] text-[var(--color-warm-gray)]">|</span> {item.date}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}
  </Container>
</section>
