---
const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { label: 'Strategy & Analytics', href: '/services/strategy-campaigns' },
    { label: 'Content Production', href: '/services/content-production' },
    { label: 'Influencer Marketing', href: '/services/influencer-marketing' },
    { label: 'Advertising', href: '/services/advertising' },
    { label: 'China Market Entry', href: '/services/market-entry' },
    { label: 'CRM & Private Domain', href: '/services/crm-private-domain' },
    { label: 'Training & Consulting', href: '/services/training-consulting' },
  ],
  discover: [
    { label: 'About', href: '/about' },
    { label: 'Platforms', href: '/platforms/others' },
    { label: 'Pricing', href: '/pricing' },
    { label: 'Insights', href: '/insights' },
  ],
  connect: [
    { label: 'Contact', href: '/contact' },
    { label: 'Book a call', href: '/contact' },
  ],
  group: [
    { label: 'BeyondBorderGroup', href: 'https://beyondbordergroup.com' },
    { label: 'HubStudio.ai', href: 'https://hubstudio.ai' },
    { label: 'Nuvora Studio', href: 'https://nuvora.studio' },
    { label: 'ChinaWebFoundry', href: 'https://chinawebfoundry.com' },
  ],
};
---

<!-- Footer -->
<footer class="w-full bg-[#1A1A1A] pt-[48px] max-[640px]:pt-[40px] pb-[24px]">
  <div class="max-w-[1200px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
    <div class="grid grid-cols-[2fr_1fr_1fr_1fr_1fr] gap-[32px] max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 max-[640px]:gap-[32px]">
      <!-- Brand column -->
      <div>
        <a href="/" class="inline-block">
          <img src="/images/logo/theredscroll-logo-5B-dark.svg" alt="TheRedScroll" class="h-[36px] w-auto" loading="lazy" decoding="async" />
        </a>
        <p class="text-[rgba(255,255,255,0.4)] text-[13px] mt-[12px] leading-[1.6] max-w-[280px]">
          We grow your brand on China's social platforms. More followers. More engagement. More conversions. Fixed scope. Fixed price. No surprises.
        </p>
        <!-- Social icons -->
        <div class="flex gap-[8px] mt-[24px]">
          <a href="#" aria-label="LinkedIn" class="text-[#FFFFFF] opacity-100 transition-opacity duration-150 hover:opacity-60 w-[44px] h-[44px] flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Services column -->
      <div>
        <p class="text-[11px] font-medium tracking-[0.05em] uppercase text-[#CC3333] mb-[12px]">Services</p>
        {footerLinks.services.map((link) => (
          <a href={link.href} class="block text-[#FFFFFF] text-[14px] font-normal leading-[2] max-[640px]:py-[6px] transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)]">
            {link.label}
          </a>
        ))}
      </div>

      <!-- Discover column -->
      <div>
        <p class="text-[11px] font-medium tracking-[0.05em] uppercase text-[#CC3333] mb-[12px]">Discover</p>
        {footerLinks.discover.map((link) => (
          <a href={link.href} class="block text-[#FFFFFF] text-[14px] font-normal leading-[2] max-[640px]:py-[6px] transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)]">
            {link.label}
          </a>
        ))}
      </div>

      <!-- Connect column -->
      <div>
        <p class="text-[11px] font-medium tracking-[0.05em] uppercase text-[#CC3333] mb-[12px]">Connect</p>
        {footerLinks.connect.map((link) => (
          <a href={link.href} class="block text-[#FFFFFF] text-[14px] font-normal leading-[2] max-[640px]:py-[6px] transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)]">
            {link.label}
          </a>
        ))}
      </div>

      <!-- Group column -->
      <div>
        <p class="text-[11px] font-medium tracking-[0.05em] uppercase text-[#CC3333] mb-[12px]">Group</p>
        {footerLinks.group.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="block text-[#FFFFFF] text-[14px] font-normal leading-[2] max-[640px]:py-[6px] transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)]">
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Divider + bottom row -->
    <div class="border-t border-[rgba(255,255,255,0.1)] mt-[32px] pt-[16px] flex justify-between items-center max-[640px]:flex-col max-[640px]:gap-[8px] max-[640px]:text-center">
      <p class="text-[12px] text-[rgba(255,255,255,0.4)]">&copy; {currentYear} TheRedScroll. All rights reserved.</p>
      <div class="flex gap-[16px] max-[640px]:gap-[12px]">
        <a href="/privacy-policy" class="text-[12px] text-[rgba(255,255,255,0.4)] transition-colors duration-150 hover:text-[#FFFFFF] py-[8px]">
          Privacy policy
        </a>
        <a href="/terms-of-service" class="text-[12px] text-[rgba(255,255,255,0.4)] transition-colors duration-150 hover:text-[#FFFFFF] py-[8px]">
          Terms &amp; conditions
        </a>
        <a href="/cookie-policy" class="text-[12px] text-[rgba(255,255,255,0.4)] transition-colors duration-150 hover:text-[#FFFFFF] py-[8px]">
          Cookie policy
        </a>
      </div>
    </div>
  </div>
</footer>
