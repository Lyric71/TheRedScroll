---
import { t } from '../../i18n/ui';
import { localizedPath } from '../../i18n/config';
import type { Lang } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);
const currentYear = new Date().getFullYear();

const services = [
  { label: t('footer.strategyAnalytics', lang), href: lp('/services/strategy-campaigns') },
  { label: t('footer.contentProduction', lang), href: lp('/services/content-production') },
  { label: t('footer.influencerMarketing', lang), href: lp('/services/influencer-marketing') },
  { label: t('footer.advertising', lang), href: lp('/services/advertising') },
  { label: t('footer.crmPrivateDomain', lang), href: lp('/services/crm-private-domain') },
  { label: t('footer.trainingConsulting', lang), href: lp('/services/training-consulting') },
];
if (lang !== 'zh') {
  services.splice(4, 0, { label: t('footer.chinaMarketEntry', lang), href: lp('/services/market-entry') });
}
const discover = [
  { label: t('footer.about', lang), href: lp('/about') },
  { label: t('footer.platforms', lang), href: lp('/platforms/others') },
  { label: t('footer.pricing', lang), href: lp('/pricing') },
  { label: t('footer.insights', lang), href: lp('/insights') },
];

// Agency landing pages, shown on a horizontal row below the menu columns.
// English-only; no localized versions yet.
const agencyPages = lang === 'en'
  ? [
      { label: 'WeChat Agency', href: '/wechat-agency/' },
      { label: 'Douyin Agency', href: '/douyin-agency/' },
      { label: 'RedNote Agency', href: '/rednote-agency/' },
      { label: 'Weibo Agency', href: '/weibo-agency/' },
    ]
  : [];

const footerLinks = {
  services,
  discover,
};

// Sister agencies in the BearingBridge network
const ecosystemLabel = ({
  en: 'Part of',
  fr: 'Membre du groupe',
  zh: '隶属于',
  es: 'Parte del grupo',
  de: 'Teil der',
} as Record<string, string>)[lang] ?? 'Part of';

const ecosystemSites: { name: string; href: string; logo: string; label?: string; sizeClass?: string }[] = [
  { name: 'hubStudio', href: 'https://www.hubstudio.ai', logo: '/images/ecosystem/hubstudio.webp', sizeClass: 'h-[24px]' },
  { name: 'The China Path', href: 'https://www.thechinapath.com', logo: '/images/ecosystem/thechinapath.webp' },
  { name: 'BeyondBridge', href: 'https://www.beyondbridge.ai', logo: '/images/ecosystem/beyondbridge.webp' },
  { name: 'ChinaWebFoundry', href: 'https://www.chinawebfoundry.com', logo: '/images/ecosystem/chinawebfoundry.webp', label: 'ChinaWebFoundry', sizeClass: 'h-[24px]' },
  { name: 'Nuvora', href: 'https://nuvora.studio', logo: '/images/ecosystem/nuvora.webp' },
  { name: 'BearingBridge AI', href: 'https://bearingbridge.ai', logo: '/images/ecosystem/bearingbridge-ai.svg', sizeClass: 'h-[20px]' },
];
---

<!-- Footer -->
<footer class="w-full bg-[#1A1A1A] pt-[48px] max-[640px]:pt-[40px] pb-[24px]">
  <div class="max-w-[1200px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
    <div class="grid grid-cols-[2fr_1fr_1fr] gap-[32px] max-[768px]:grid-cols-2 max-[640px]:grid-cols-1 max-[640px]:gap-[32px]">
      <!-- Brand column -->
      <div>
        <a href={lp('/')} class="inline-block">
          <img src="/images/logo/theredscroll-logo-5B-dark.svg" alt="TheRedScroll" width="160" height="36" class="h-[36px] w-auto" loading="lazy" decoding="async" />
        </a>
        <p class="text-[rgba(255,255,255,0.4)] text-[13px] mt-[12px] leading-[1.6] max-w-[280px]">
          {t('footer.tagline', lang)}
        </p>
        <!-- Social icons -->
        <div class="flex gap-[8px] mt-[24px]">
          <a href="https://www.linkedin.com/company/bearingbridgegroup/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-[#FFFFFF] opacity-100 transition-opacity duration-150 hover:opacity-60 w-[44px] h-[44px] flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Services column -->
      <div>
        <a href={lp('/services')} class="block text-[11px] font-medium tracking-[0.05em] uppercase text-[#CC3333] mb-[12px] transition-colors duration-150 hover:text-[#B02D2D]">{t('footer.services', lang)}</a>
        {footerLinks.services.map((link) => (
          <a href={link.href} class="block text-[#FFFFFF] text-[14px] font-normal leading-[2] max-[640px]:py-[6px] transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)]">
            {link.label}
          </a>
        ))}
      </div>

      <!-- Discover column -->
      <div>
        <p class="text-[11px] font-medium tracking-[0.05em] uppercase text-[#CC3333] mb-[12px]">{t('footer.discover', lang)}</p>
        {footerLinks.discover.map((link) => (
          <a href={link.href} class="block text-[#FFFFFF] text-[14px] font-normal leading-[2] max-[640px]:py-[6px] transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)]">
            {link.label}
          </a>
        ))}
      </div>

    </div>

    {agencyPages.length > 0 && (
      <div class="border-t border-[rgba(255,255,255,0.1)] mt-[32px] pt-[16px] flex flex-wrap items-center justify-center gap-x-[24px] gap-y-[8px]">
        {agencyPages.map((link) => (
          <a href={link.href} class="text-[#FFFFFF] text-[13px] font-normal leading-[2] transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)]">
            {link.label}
          </a>
        ))}
      </div>
    )}

  </div>

  <!-- Sister agencies: BearingBridge network -->
  <div class="bg-[#F7F2EE] mt-[32px]">
    <div class="max-w-[1200px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] py-[32px]">
      <p class="flex items-center gap-[10px] text-[11px] font-medium tracking-[0.05em] uppercase text-[#5C5C5C] mb-[24px]">
        {ecosystemLabel}
        <a href="https://bearingbridge.com" target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0" aria-label="BearingBridge" title="BearingBridge">
          <img src="/images/ecosystem/bearingbridge.webp" alt="BearingBridge logo" class="h-[20px] w-auto object-contain" loading="lazy" decoding="async" />
        </a>
      </p>
      <div class="grid grid-cols-7 max-[1024px]:grid-cols-4 max-[640px]:grid-cols-2 gap-x-[24px] gap-y-[28px] items-center justify-items-center">
        {ecosystemSites.map((site) => (
          <a
            href={site.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-[8px] shrink-0 opacity-65 grayscale transition duration-200 ease-out hover:opacity-100 hover:grayscale-0"
            aria-label={site.name}
            title={site.name}
          >
            <img
              src={site.logo}
              alt={`${site.name} logo`}
              class:list={[site.sizeClass ?? 'h-[28px]', 'w-auto max-w-[150px] object-contain']}
              loading="lazy"
              decoding="async"
            />
            {site.label && <span class="text-[#1A1A1A] text-[14px] font-medium whitespace-nowrap">{site.label}</span>}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
    <!-- Divider + bottom row -->
    <div class="pt-[16px] flex justify-between items-center max-[640px]:flex-col max-[640px]:gap-[8px] max-[640px]:text-center">
      <p class="text-[12px] text-[rgba(255,255,255,0.4)]">&copy; {currentYear} TheRedScroll. {t('footer.rights', lang)}</p>
      <div class="flex gap-[16px] max-[640px]:gap-[12px]">
        <a href={lp('/privacy-policy')} class="text-[12px] text-[rgba(255,255,255,0.4)] transition-colors duration-150 hover:text-[#FFFFFF] py-[8px]">
          {t('footer.privacy', lang)}
        </a>
        <a href={lp('/terms-of-service')} class="text-[12px] text-[rgba(255,255,255,0.4)] transition-colors duration-150 hover:text-[#FFFFFF] py-[8px]">
          {t('footer.terms', lang)}
        </a>
        <a href={lp('/cookie-policy')} class="text-[12px] text-[rgba(255,255,255,0.4)] transition-colors duration-150 hover:text-[#FFFFFF] py-[8px]">
          {t('footer.cookies', lang)}
        </a>
      </div>
    </div>
  </div>
</footer>
