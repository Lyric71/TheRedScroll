---
import type { NavItem } from '../../data/navigation';
import { getLocalizedNav } from '../../i18n/navigation';
import { t } from '../../i18n/ui';
import { alternateUrl, localizedPath, getAlternateLangs, languages } from '../../i18n/config';
import type { Lang } from '../../i18n/config';
import Button from '../ui/Button.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const nav = getLocalizedNav(lang);
const altLangs = getAlternateLangs(lang);
const currentPath = Astro.url.pathname;
const contactHref = localizedPath('/contact', lang);
const langLabels: Record<string, string> = { en: 'EN', fr: 'FR', zh: '中文', es: 'ES', de: 'DE' };
const langFlags: Record<string, string> = {
  en: `<svg viewBox="0 0 18 12" width="18" height="12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="12" fill="#B22234"/><rect width="18" y="0.923" height="0.923" fill="#fff"/><rect width="18" y="2.769" height="0.923" fill="#fff"/><rect width="18" y="4.615" height="0.923" fill="#fff"/><rect width="18" y="6.461" height="0.923" fill="#fff"/><rect width="18" y="8.308" height="0.923" fill="#fff"/><rect width="18" y="10.154" height="0.923" fill="#fff"/><rect width="7.2" height="6.461" fill="#3C3B6E"/></svg>`,
  fr: `<svg viewBox="0 0 18 12" width="18" height="12" xmlns="http://www.w3.org/2000/svg"><rect width="6" height="12" fill="#002654"/><rect x="6" width="6" height="12" fill="#fff"/><rect x="12" width="6" height="12" fill="#CE1126"/></svg>`,
  zh: `<svg viewBox="0 0 18 12" width="18" height="12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="12" fill="#EE1C25"/><polygon points="4.5,2.2 5.03,3.67 6.59,3.72 5.36,4.68 5.79,6.18 4.5,5.3 3.21,6.18 3.64,4.68 2.41,3.72 3.97,3.67" fill="#FFDE00"/></svg>`,
  es: `<svg viewBox="0 0 18 12" width="18" height="12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="3" fill="#AA151B"/><rect y="3" width="18" height="6" fill="#F1BF00"/><rect y="9" width="18" height="3" fill="#AA151B"/></svg>`,
  de: `<svg viewBox="0 0 18 12" width="18" height="12" xmlns="http://www.w3.org/2000/svg"><rect width="18" height="4" fill="#000"/><rect y="4" width="18" height="4" fill="#DD0000"/><rect y="8" width="18" height="4" fill="#FFCE00"/></svg>`,
};
---

<header class="fixed top-0 left-0 w-full z-[1000] h-[60px] max-[640px]:h-[52px] bg-[#1A1A1A]">
  <nav class="max-w-[1200px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] flex items-center justify-between h-full">
    <!-- Logo -->
    <a href={localizedPath('/', lang)} class="flex items-center shrink-0">
      <img src="/images/logo/theredscroll-logo-5B-dark.svg" alt="TheRedScroll" class="h-[44px] w-auto" decoding="async" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden min-[1024px]:flex items-center gap-[16px] xl:gap-[24px] 2xl:gap-[32px]">
      {nav.map((link) => (
        link.children ? (
          <div class="relative" data-dropdown>
            <button
              class="flex items-center gap-[4px] text-[#FFFFFF] text-[14px] font-normal bg-transparent border-none cursor-pointer p-0 transition-colors duration-150 ease-in-out hover:text-[rgba(255,255,255,0.6)]"
              data-dropdown-trigger
            >
              {link.label}
              <svg class="w-[8px] h-[8px] ml-[4px] transition-transform duration-150" data-chevron viewBox="0 0 8 5" fill="none" aria-hidden="true">
                <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <!-- Mega menu panel -->
            <div
              class="fixed left-0 right-0 top-[60px] bg-[#1A1A1A] border-t-[0.5px] border-[rgba(255,255,255,0.1)] opacity-0 invisible pointer-events-none transition-[opacity,visibility] duration-150 ease-in-out"
              data-dropdown-panel
            >
              <div class="max-w-[1200px] mx-auto px-[48px] py-[32px]">
                <div class="grid grid-cols-3 gap-[24px] max-[1024px]:grid-cols-2">
                  {link.children.map((child: NavItem) => (
                    <a
                      href={child.href}
                      class="flex items-start gap-[16px] p-[16px] rounded-[8px] transition-[background] duration-150 hover:bg-[rgba(255,255,255,0.05)] group"
                    >
                      <div class="w-[40px] h-[40px] rounded-[6px] bg-[rgba(255,255,255,0.06)] border-[0.5px] border-[rgba(255,255,255,0.1)] shrink-0 flex items-center justify-center text-[#CC3333]">
                        {child.icon ? <Fragment set:html={child.icon} /> : <span class="text-[14px]">&rarr;</span>}
                      </div>
                      <div>
                        <span class="block text-[#FFFFFF] text-[14px] font-medium leading-[1.3] mb-[4px] group-hover:text-[#FFFFFF]">
                          {child.label}
                        </span>
                        <span class="block text-[rgba(255,255,255,0.4)] text-[12px] font-normal leading-[1.4]">
                          {child.subtitle || t('cta.learnMore', lang)}
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
                <!-- Footer link to parent page -->
                <div class="mt-[24px] pt-[16px] border-t-[0.5px] border-[rgba(255,255,255,0.1)]">
                  <a href={link.href} class="text-[#CC3333] text-[13px] font-medium transition-colors duration-150 hover:text-[#B02D2D]">
                    {link.viewAllLabel} &rarr;
                  </a>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="text-[#FFFFFF] text-[14px] font-normal transition-colors duration-150 ease-in-out hover:text-[rgba(255,255,255,0.6)]"
          >
            {link.label}
          </a>
        )
      ))}

      <!-- Language switcher (dropdown) -->
      <div class="relative" data-lang-dropdown>
        <button
          type="button"
          class="flex items-center gap-[8px] text-[rgba(255,255,255,0.7)] text-[13px] font-medium tracking-[0.03em] bg-transparent border-[0.5px] border-[rgba(255,255,255,0.15)] rounded-[4px] px-[10px] py-[5px] cursor-pointer transition-colors duration-150 ease-in-out hover:text-[#FFFFFF] hover:border-[rgba(255,255,255,0.3)]"
          data-lang-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label={languages[lang]}
        >
          <span aria-hidden="true" class="inline-flex w-[18px] h-[12px] rounded-[2px] overflow-hidden shrink-0"><Fragment set:html={langFlags[lang]} /></span>
          <span>{langLabels[lang]}</span>
          <svg class="w-[8px] h-[8px] transition-transform duration-150" data-lang-chevron viewBox="0 0 8 5" fill="none" aria-hidden="true">
            <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div
          class="absolute right-0 top-full mt-[8px] min-w-[160px] bg-[#1A1A1A] border-[0.5px] border-[rgba(255,255,255,0.15)] rounded-[6px] opacity-0 invisible pointer-events-none transition-[opacity,visibility] duration-150 ease-in-out overflow-hidden"
          data-lang-panel
          role="listbox"
        >
          {altLangs.map((al) => (
            <a
              href={alternateUrl(currentPath, al)}
              class="flex items-center gap-[10px] px-[12px] py-[10px] text-[rgba(255,255,255,0.8)] text-[13px] font-normal transition-colors duration-150 ease-in-out hover:bg-[rgba(255,255,255,0.05)] hover:text-[#FFFFFF]"
              role="option"
            >
              <span aria-hidden="true" class="inline-flex w-[18px] h-[12px] rounded-[2px] overflow-hidden shrink-0"><Fragment set:html={langFlags[al]} /></span>
              <span>{languages[al]}</span>
            </a>
          ))}
        </div>
      </div>

      <Button variant="primary" href={contactHref} class="whitespace-nowrap !px-[18px] xl:!px-[24px] 2xl:!px-[28px]">
        {t('nav.bookCall', lang)}
      </Button>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-toggle"
      class="min-[1024px]:hidden flex flex-col justify-center gap-[6px] w-[44px] h-[44px] items-center cursor-pointer bg-transparent border-none p-[12px]"
      aria-label="Open menu"
    >
      <span class="block w-full h-[2px] bg-[#FFFFFF] rounded-full"></span>
      <span class="block w-full h-[2px] bg-[#FFFFFF] rounded-full"></span>
      <span class="block w-full h-[2px] bg-[#FFFFFF] rounded-full"></span>
    </button>
  </nav>
</header>

<!-- Mobile overlay -->
<div id="mobile-overlay" class="fixed inset-0 bg-[rgba(0,0,0,0.5)] z-[1000] hidden" aria-hidden="true"></div>

<!-- Mobile slide-in panel -->
<div id="mobile-panel" class="fixed top-0 right-0 w-[280px] h-screen bg-[#1A1A1A] z-[1001] translate-x-full transition-transform duration-[250ms] ease-in-out pt-[64px] px-[20px] pb-[20px] overflow-y-auto">
  <button
    id="mobile-menu-close"
    class="absolute top-[20px] right-[20px] text-[#FFFFFF] text-[20px] leading-none cursor-pointer bg-transparent border-none w-[44px] h-[44px] flex items-center justify-center"
    aria-label="Close menu"
  >
    &#x2715;
  </button>

  {nav.map((link) => (
    <div>
      <a
        href={link.href}
        class="block py-[12px] min-h-[44px] flex items-center text-[#FFFFFF] text-[16px] font-normal border-b-[0.5px] border-[rgba(255,255,255,0.1)] transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)]"
      >
        {link.label}
      </a>
      {link.children && (
        <div class="pl-[16px]">
          {link.children.map((child: NavItem) => (
            <a
              href={child.href}
              class="block py-[10px] min-h-[44px] flex items-center text-[rgba(255,255,255,0.6)] text-[14px] font-normal transition-colors duration-150 hover:text-[#FFFFFF]"
            >
              {child.label}
            </a>
          ))}
        </div>
      )}
    </div>
  ))}

  <!-- Mobile language switcher -->
  <div class="mt-[16px] pt-[16px] border-t-[0.5px] border-[rgba(255,255,255,0.1)]">
    {altLangs.map((al) => (
      <a
        href={alternateUrl(currentPath, al)}
        class="py-[12px] min-h-[44px] flex items-center gap-[10px] text-[rgba(255,255,255,0.5)] text-[14px] font-medium transition-colors duration-150 hover:text-[#FFFFFF]"
      >
        <span aria-hidden="true" class="inline-flex w-[20px] h-[14px] rounded-[2px] overflow-hidden shrink-0"><Fragment set:html={langFlags[al]} /></span>
        <span>{languages[al]}</span>
      </a>
    ))}
  </div>

  <div class="mt-[24px]">
    <Button variant="primary" href={contactHref}>{t('nav.bookCall', lang)}</Button>
  </div>
</div>

<script>
  // Mobile menu
  const toggle = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const overlay = document.getElementById('mobile-overlay');
  const mobilePanel = document.getElementById('mobile-panel');

  function openMenu() {
    mobilePanel?.classList.remove('translate-x-full');
    mobilePanel?.classList.add('translate-x-0');
    overlay?.classList.remove('hidden');
  }

  function closeMenu() {
    mobilePanel?.classList.remove('translate-x-0');
    mobilePanel?.classList.add('translate-x-full');
    overlay?.classList.add('hidden');
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  // Desktop mega menu dropdowns
  document.querySelectorAll('[data-dropdown]').forEach((dropdown) => {
    const trigger = dropdown.querySelector('[data-dropdown-trigger]');
    const panel = dropdown.querySelector('[data-dropdown-panel]');
    const chevron = dropdown.querySelector('[data-chevron]');
    if (!trigger || !panel) return;

    let hideTimeout: ReturnType<typeof setTimeout>;

    function show() {
      clearTimeout(hideTimeout);
      // Close other open dropdowns
      document.querySelectorAll('[data-dropdown-panel]').forEach((p) => {
        if (p !== panel) {
          p.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
          p.classList.add('opacity-0', 'invisible', 'pointer-events-none');
        }
      });
      document.querySelectorAll('[data-chevron]').forEach((c) => {
        if (c !== chevron) c.classList.remove('rotate-180');
      });
      panel!.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      panel!.classList.add('opacity-100', 'visible', 'pointer-events-auto');
      chevron?.classList.add('rotate-180');
    }

    function hide() {
      hideTimeout = setTimeout(() => {
        panel!.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
        panel!.classList.add('opacity-0', 'invisible', 'pointer-events-none');
        chevron?.classList.remove('rotate-180');
      }, 150);
    }

    trigger.addEventListener('mouseenter', show);
    trigger.addEventListener('click', () => {
      if (panel.classList.contains('opacity-100')) hide();
      else show();
    });

    dropdown.addEventListener('mouseleave', hide);
    panel.addEventListener('mouseenter', () => clearTimeout(hideTimeout));
    panel.addEventListener('mouseleave', hide);
  });

  // Language dropdown
  const langDropdown = document.querySelector('[data-lang-dropdown]');
  if (langDropdown) {
    const langTrigger = langDropdown.querySelector('[data-lang-trigger]') as HTMLButtonElement | null;
    const langPanel = langDropdown.querySelector('[data-lang-panel]');
    const langChevron = langDropdown.querySelector('[data-lang-chevron]');

    function openLang() {
      langPanel?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      langPanel?.classList.add('opacity-100', 'visible', 'pointer-events-auto');
      langChevron?.classList.add('rotate-180');
      langTrigger?.setAttribute('aria-expanded', 'true');
    }

    function closeLang() {
      langPanel?.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
      langPanel?.classList.add('opacity-0', 'invisible', 'pointer-events-none');
      langChevron?.classList.remove('rotate-180');
      langTrigger?.setAttribute('aria-expanded', 'false');
    }

    langTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (langTrigger.getAttribute('aria-expanded') === 'true') closeLang();
      else openLang();
    });

    document.addEventListener('click', (e) => {
      if (!langDropdown.contains(e.target as Node)) closeLang();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLang();
    });
  }
</script>
