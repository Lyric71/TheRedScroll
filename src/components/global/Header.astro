---
import { mainNav } from '../../data/navigation';
import type { NavItem } from '../../data/navigation';
import Button from '../ui/Button.astro';
---

<header class="fixed top-0 left-0 w-full z-[1000] h-[60px] bg-[#1A1A1A]">
  <nav class="max-w-[1200px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] flex items-center justify-between h-full">
    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0">
      <img src="/images/logo/theredscroll-logo-5B-dark.svg" alt="TheRedScroll" class="h-[44px] w-auto" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden min-[641px]:flex items-center gap-[32px]">
      {mainNav.map((link) => (
        link.children ? (
          <div class="relative" data-dropdown>
            <button
              class="flex items-center gap-[4px] text-[#FFFFFF] text-[14px] font-normal bg-transparent border-none cursor-pointer p-0 transition-colors duration-150 ease-in-out hover:text-[rgba(255,255,255,0.6)]"
              data-dropdown-trigger
            >
              {link.label}
              <svg class="w-[8px] h-[8px] ml-[4px] transition-transform duration-150" data-chevron viewBox="0 0 8 5" fill="none" aria-hidden="true">
                <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <!-- Mega menu panel -->
            <div
              class="fixed left-0 right-0 top-[60px] bg-[#1A1A1A] border-t-[0.5px] border-[rgba(255,255,255,0.1)] opacity-0 invisible pointer-events-none transition-[opacity,visibility] duration-150 ease-in-out"
              data-dropdown-panel
            >
              <div class="max-w-[1200px] mx-auto px-[48px] py-[32px]">
                <div class="grid grid-cols-3 gap-[24px] max-[1024px]:grid-cols-2">
                  {link.children.map((child: NavItem) => (
                    <a
                      href={child.href}
                      class="flex items-start gap-[16px] p-[16px] rounded-[8px] transition-[background] duration-150 hover:bg-[rgba(255,255,255,0.05)] group"
                    >
                      <div class="w-[40px] h-[40px] rounded-[6px] bg-[rgba(255,255,255,0.06)] border-[0.5px] border-[rgba(255,255,255,0.1)] shrink-0 flex items-center justify-center text-[#CC3333]">
                        {child.icon ? <Fragment set:html={child.icon} /> : <span class="text-[14px]">&rarr;</span>}
                      </div>
                      <div>
                        <span class="block text-[#FFFFFF] text-[14px] font-medium leading-[1.3] mb-[4px] group-hover:text-[#FFFFFF]">
                          {child.label}
                        </span>
                        <span class="block text-[rgba(255,255,255,0.4)] text-[12px] font-normal leading-[1.4]">
                          {child.subtitle || 'Learn more'}
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
                <!-- Footer link to parent page -->
                <div class="mt-[24px] pt-[16px] border-t-[0.5px] border-[rgba(255,255,255,0.1)]">
                  <a href={link.href} class="text-[#CC3333] text-[13px] font-medium transition-colors duration-150 hover:text-[#B02D2D]">
                    View all {link.label.toLowerCase()} &rarr;
                  </a>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="text-[#FFFFFF] text-[14px] font-normal transition-colors duration-150 ease-in-out hover:text-[rgba(255,255,255,0.6)]"
          >
            {link.label}
          </a>
        )
      ))}
      <Button variant="primary" href="/contact">
        Book a call
      </Button>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-toggle"
      class="min-[641px]:hidden flex flex-col justify-center gap-[6px] w-[20px] cursor-pointer bg-transparent border-none p-0"
      aria-label="Open menu"
    >
      <span class="block w-full h-[2px] bg-[#FFFFFF] rounded-full"></span>
      <span class="block w-full h-[2px] bg-[#FFFFFF] rounded-full"></span>
      <span class="block w-full h-[2px] bg-[#FFFFFF] rounded-full"></span>
    </button>
  </nav>
</header>

<!-- Mobile overlay -->
<div id="mobile-overlay" class="fixed inset-0 bg-[rgba(0,0,0,0.5)] z-[1000] hidden" aria-hidden="true"></div>

<!-- Mobile slide-in panel -->
<div id="mobile-panel" class="fixed top-0 right-0 w-[280px] h-screen bg-[#1A1A1A] z-[1001] translate-x-full transition-transform duration-[250ms] ease-in-out pt-[72px] px-[20px] pb-[20px] overflow-y-auto">
  <button
    id="mobile-menu-close"
    class="absolute top-[20px] right-[20px] text-[#FFFFFF] text-[20px] leading-none cursor-pointer bg-transparent border-none p-0"
    aria-label="Close menu"
  >
    &#x2715;
  </button>

  {mainNav.map((link) => (
    <div>
      <a
        href={link.href}
        class="block py-[16px] text-[#FFFFFF] text-[16px] font-normal border-b-[0.5px] border-[rgba(255,255,255,0.1)] transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)]"
      >
        {link.label}
      </a>
      {link.children && (
        <div class="pl-[16px]">
          {link.children.map((child: NavItem) => (
            <a
              href={child.href}
              class="block py-[10px] text-[rgba(255,255,255,0.6)] text-[14px] font-normal transition-colors duration-150 hover:text-[#FFFFFF]"
            >
              {child.label}
            </a>
          ))}
        </div>
      )}
    </div>
  ))}

  <div class="mt-[24px]">
    <Button variant="primary" href="/contact">Book a call</Button>
  </div>
</div>

<script>
  // Mobile menu
  const toggle = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const overlay = document.getElementById('mobile-overlay');
  const mobilePanel = document.getElementById('mobile-panel');

  function openMenu() {
    mobilePanel?.classList.remove('translate-x-full');
    mobilePanel?.classList.add('translate-x-0');
    overlay?.classList.remove('hidden');
  }

  function closeMenu() {
    mobilePanel?.classList.remove('translate-x-0');
    mobilePanel?.classList.add('translate-x-full');
    overlay?.classList.add('hidden');
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  // Desktop mega menu dropdowns
  document.querySelectorAll('[data-dropdown]').forEach((dropdown) => {
    const trigger = dropdown.querySelector('[data-dropdown-trigger]');
    const panel = dropdown.querySelector('[data-dropdown-panel]');
    const chevron = dropdown.querySelector('[data-chevron]');
    if (!trigger || !panel) return;

    let hideTimeout: ReturnType<typeof setTimeout>;

    function show() {
      clearTimeout(hideTimeout);
      // Close other open dropdowns
      document.querySelectorAll('[data-dropdown-panel]').forEach((p) => {
        if (p !== panel) {
          p.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
          p.classList.add('opacity-0', 'invisible', 'pointer-events-none');
        }
      });
      document.querySelectorAll('[data-chevron]').forEach((c) => {
        if (c !== chevron) c.classList.remove('rotate-180');
      });
      panel!.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      panel!.classList.add('opacity-100', 'visible', 'pointer-events-auto');
      chevron?.classList.add('rotate-180');
    }

    function hide() {
      hideTimeout = setTimeout(() => {
        panel!.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
        panel!.classList.add('opacity-0', 'invisible', 'pointer-events-none');
        chevron?.classList.remove('rotate-180');
      }, 150);
    }

    trigger.addEventListener('mouseenter', show);
    trigger.addEventListener('click', () => {
      if (panel.classList.contains('opacity-100')) hide();
      else show();
    });

    dropdown.addEventListener('mouseleave', hide);
    panel.addEventListener('mouseenter', () => clearTimeout(hideTimeout));
    panel.addEventListener('mouseleave', hide);
  });
</script>
