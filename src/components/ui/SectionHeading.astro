---
interface Props {
  overline?: string;
  dark?: boolean;
}

const { overline, dark = false } = Astro.props;
---

<div>
  {overline && (
    <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">
      {overline}
    </p>
  )}
  <h2 class:list={[
    'text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px] max-[640px]:mb-[12px]',
    dark ? 'text-white' : 'text-[var(--color-ink)]'
  ]}>
    <slot />
  </h2>
</div>
