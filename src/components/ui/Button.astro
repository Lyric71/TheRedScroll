---
interface Props {
  variant?: 'primary' | 'secondary' | 'secondary-dark';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { variant = 'primary', href, type = 'button', class: className = '' } = Astro.props;

const baseStyles = 'inline-flex items-center justify-center h-[44px] px-[28px] text-[14px] font-medium leading-none tracking-normal rounded-[6px] cursor-pointer active:scale-[0.98]';

const variants = {
  primary: 'bg-[#CC3333] text-[#FFFFFF] border-none transition-[background] duration-150 ease-in-out hover:bg-[#B02D2D] focus-visible:outline-2 focus-visible:outline-[#CC3333] focus-visible:outline-offset-2',
  secondary: 'bg-transparent text-[#1A1A1A] border border-[rgba(0,0,0,0.15)] transition-[background,border-color] duration-150 ease-in-out hover:bg-[#F0F1F4] hover:border-[#E8E0D8] focus-visible:outline-2 focus-visible:outline-[#1A1A1A] focus-visible:outline-offset-2',
  'secondary-dark': 'bg-transparent text-[#FFFFFF] border border-[rgba(255,255,255,0.3)] transition-[background,border-color] duration-150 ease-in-out hover:bg-[rgba(255,255,255,0.05)] hover:border-[rgba(255,255,255,0.5)] focus-visible:outline-2 focus-visible:outline-[#FFFFFF] focus-visible:outline-offset-2',
};

const styles = `${baseStyles} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={styles}>
    <slot />
  </a>
) : (
  <button type={type} class={styles}>
    <slot />
  </button>
)}
