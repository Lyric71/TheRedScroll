---
interface Props {
  variant?: 'primary' | 'secondary' | 'secondary-dark';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { variant = 'primary', href, type = 'button', class: className = '' } = Astro.props;

const baseStyles = 'btn inline-flex items-center justify-center h-[44px] px-[28px] text-[14px] font-medium leading-none tracking-normal rounded-[6px] cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2';

const variants = {
  primary: 'btn-primary bg-[#CC3333] text-[#FFFFFF] border-none focus-visible:outline-[#CC3333]',
  secondary: 'btn-secondary bg-transparent text-[#1A1A1A] border border-[rgba(0,0,0,0.15)] focus-visible:outline-[#1A1A1A]',
  'secondary-dark': 'btn-secondary-dark bg-transparent text-[#FFFFFF] border border-[rgba(255,255,255,0.3)] focus-visible:outline-[#FFFFFF]',
};

const styles = `${baseStyles} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={styles}><slot /></a>
) : (
  <button type={type} class={styles}><slot /></button>
)}

<style>
  .btn {
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #1A1A1A;
  }

  .btn-secondary:hover {
    background-color: #1A1A1A;
    border-color: #1A1A1A;
    color: #FFFFFF;
  }

  .btn-secondary-dark:hover {
    background-color: #FFFFFF;
    border-color: #FFFFFF;
    color: #1A1A1A;
  }
</style>
