---
/**
 * KeyFacts — a TL;DR / key-facts callout for the top of an insights article.
 *
 * Sits inside the prose-article container in BlogLayout. Used by passing a
 * `facts` array via MDX or imported in an .astro page. For plain .md posts,
 * see the `<KeyFacts />` Markdoc usage via the `mdx` integration if/when added.
 *
 * Designed to be LLM-friendly: each fact is a self-contained sentence and the
 * block sits in the first viewport so AI extractors can lift the summary.
 */
interface Props {
  /** Optional heading override. Defaults to "Key facts". */
  heading?: string;
  /** List of facts. 3–5 items is the sweet spot. */
  facts: string[];
}

const { heading = 'Key facts', facts } = Astro.props;
---

<aside
  class="not-prose key-facts mb-[32px] px-[24px] py-[20px] bg-[var(--color-rice-paper)] border-l-[3px] border-[var(--color-vermillion)] max-[640px]:px-[20px] max-[640px]:py-[16px]"
  aria-label={heading}
>
  <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">
    {heading}
  </p>
  <ul class="m-0 p-0 list-none flex flex-col gap-[6px]">
    {facts.map((fact) => (
      <li class="text-[14px] font-normal leading-[1.55] text-[var(--color-ink)] pl-[16px] relative before:content-[''] before:absolute before:left-0 before:top-[10px] before:w-[6px] before:h-[6px] before:bg-[var(--color-vermillion)] before:rounded-full">
        {fact}
      </li>
    ))}
  </ul>
</aside>

<style>
  .key-facts ul li::marker { content: ''; }
</style>
