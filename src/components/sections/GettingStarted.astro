---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Step {
  title: string;
  description: string;
  icon: string;
}

interface CrossLink {
  label: string;
  href: string;
}

interface Props {
  heading: string;
  steps: Step[];
  backgroundImage: string;
  crossLinks?: CrossLink[];
  lang?: 'en' | 'fr' | 'zh' | 'es' | 'de';
}

const { heading, steps, backgroundImage, crossLinks = [], lang = 'en' } = Astro.props;
const overline = lang === 'zh' ? '合作流程' : lang === 'fr' ? 'Pour commencer' : lang === 'es' ? 'Cómo empezamos' : lang === 'de' ? 'So legen wir los' : 'Getting started';
const bookCall = lang === 'zh' ? '预约通话' : lang === 'fr' ? 'Prendre rendez-vous' : lang === 'es' ? 'Agendar una llamada' : lang === 'de' ? 'Gespräch vereinbaren' : 'Book a call';
const seeAlso = lang === 'zh' ? '也可以看看' : lang === 'fr' ? 'À voir aussi' : lang === 'es' ? 'Ver también' : lang === 'de' ? 'Auch interessant' : 'See also';
const contactHref = lang === 'zh' ? '/zh/contact' : lang === 'fr' ? '/fr/contact' : lang === 'es' ? '/es/contacto' : lang === 'de' ? '/de/contact' : '/contact';
---

<section class="relative mt-[96px] max-[640px]:mt-[64px] pt-[80px] pb-[80px] max-[1024px]:pt-[64px] max-[1024px]:pb-[64px] max-[640px]:pt-[48px] max-[640px]:pb-[48px] overflow-hidden">
  <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${backgroundImage}')`} aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.88]" aria-hidden="true"></div>

  <Container class="relative z-[1]">
    <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
      <div class="flex justify-center mb-[12px]">
        <div class="w-[40px] h-[3px] bg-[#CC3333] rounded-none"></div>
      </div>
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
        {overline}
      </p>
      <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF]">
        {heading}
      </h2>
    </div>

    <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[24px] max-[640px]:gap-[16px]">
      {steps.map((step) => (
        <div class="bg-[rgba(255,255,255,0.06)] border-[0.5px] border-[rgba(255,255,255,0.1)] rounded-[12px] p-[32px] max-[640px]:p-[20px] text-center">
          <div class="w-[64px] h-[64px] rounded-full bg-[rgba(255,255,255,0.08)] border-[0.5px] border-[rgba(255,255,255,0.15)] flex items-center justify-center mx-auto mb-[20px]">
            <Fragment set:html={step.icon} />
          </div>
          <h3 class="text-[18px] text-[#FFFFFF] font-medium leading-[1.3] mb-[8px]">
            {step.title}
          </h3>
          <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6]">
            {step.description}
          </p>
        </div>
      ))}
    </div>

    <div class="text-center mt-[40px]">
      <Button variant="primary" href={contactHref}>{bookCall}</Button>
    </div>

    {crossLinks.length > 0 && (
      <div class="mt-[48px] pt-[24px] border-t border-[rgba(255,255,255,0.1)] text-center">
        <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal mb-[12px]">{seeAlso}</p>
        <div class="flex justify-center gap-[24px] flex-wrap">
          {crossLinks.map((link) => (
            <a href={link.href} class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">{link.label} &rarr;</a>
          ))}
        </div>
      </div>
    )}
  </Container>
</section>
