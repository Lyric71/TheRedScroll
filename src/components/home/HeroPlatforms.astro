---
/**
 * Platform logo constellation for the homepage hero.
 * Real brand colors, animated float + pulse.
 * Hidden on mobile (< 1024px).
 */
---

<div
  class="hidden min-[1024px]:flex items-center justify-center pointer-events-none select-none w-full max-w-[420px]"
  aria-hidden="true"
>
  <svg viewBox="0 0 400 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
    <!-- Connecting lines with glow -->
    <line x1="120" y1="80" x2="280" y2="60" stroke="#CC3333" stroke-opacity="0.15" stroke-width="1" class="hero-line" />
    <line x1="120" y1="80" x2="80" y2="260" stroke="#CC3333" stroke-opacity="0.15" stroke-width="1" class="hero-line" />
    <line x1="120" y1="80" x2="300" y2="280" stroke="#CC3333" stroke-opacity="0.15" stroke-width="1" class="hero-line" />
    <line x1="280" y1="60" x2="300" y2="280" stroke="#CC3333" stroke-opacity="0.15" stroke-width="1" class="hero-line" />
    <line x1="280" y1="60" x2="80" y2="260" stroke="#CC3333" stroke-opacity="0.12" stroke-width="1" class="hero-line" />
    <line x1="80" y1="260" x2="300" y2="280" stroke="#CC3333" stroke-opacity="0.12" stroke-width="1" class="hero-line" />

    <!-- Douyin — top left -->
    <g transform="translate(88, 48)" class="hero-logo hero-logo-1">
      <circle cx="32" cy="32" r="36" fill="#000000" fill-opacity="0.5" />
      <svg viewBox="0 0 48 48" width="64" height="64">
        <path d="M33.3 8.1c-1.8-1.9-2.8-4.4-3.1-7.1h-5.8l0 27.7c0 3.1-2.5 5.7-5.7 5.7-1 0-2-.3-2.8-.7-1.7-1-2.8-2.8-2.8-4.9 0-3.1 2.5-5.7 5.7-5.7.6 0 1.2.1 1.7.3v-6c-.6-.1-1.1-.1-1.7-.1-6.5 0-11.7 5.3-11.7 11.7 0 4 2 7.5 5 9.7 1.9 1.4 4.2 2.2 6.7 2.2 6.5 0 11.7-5.3 11.7-11.7V17.5c2.5 1.8 5.5 2.8 8.8 2.8v-5.9c-2.4-.1-4.5-1-6-2.5z" fill="#25F4EE" transform="translate(-1.5,1)"/>
        <path d="M33.3 8.1c-1.8-1.9-2.8-4.4-3.1-7.1h-5.8l0 27.7c0 3.1-2.5 5.7-5.7 5.7-1 0-2-.3-2.8-.7-1.7-1-2.8-2.8-2.8-4.9 0-3.1 2.5-5.7 5.7-5.7.6 0 1.2.1 1.7.3v-6c-.6-.1-1.1-.1-1.7-.1-6.5 0-11.7 5.3-11.7 11.7 0 4 2 7.5 5 9.7 1.9 1.4 4.2 2.2 6.7 2.2 6.5 0 11.7-5.3 11.7-11.7V17.5c2.5 1.8 5.5 2.8 8.8 2.8v-5.9c-2.4-.1-4.5-1-6-2.5z" fill="#FE2C55" transform="translate(1.5,-1)"/>
        <path d="M33.3 8.1c-1.8-1.9-2.8-4.4-3.1-7.1h-5.8l0 27.7c0 3.1-2.5 5.7-5.7 5.7-1 0-2-.3-2.8-.7-1.7-1-2.8-2.8-2.8-4.9 0-3.1 2.5-5.7 5.7-5.7.6 0 1.2.1 1.7.3v-6c-.6-.1-1.1-.1-1.7-.1-6.5 0-11.7 5.3-11.7 11.7 0 4 2 7.5 5 9.7 1.9 1.4 4.2 2.2 6.7 2.2 6.5 0 11.7-5.3 11.7-11.7V17.5c2.5 1.8 5.5 2.8 8.8 2.8v-5.9c-2.4-.1-4.5-1-6-2.5z" fill="#FFFFFF"/>
      </svg>
    </g>

    <!-- WeChat — top right (brand green) -->
    <g transform="translate(248, 28)" class="hero-logo hero-logo-2">
      <circle cx="32" cy="32" r="36" fill="#07C160" fill-opacity="0.3" />
      <svg viewBox="0 0 2499.7 2024.2" width="64" height="64">
        <path d="m2499.7 1313.8c0-347.3-335.9-630.6-749.5-630.6s-747.2 283.3-747.2 630.6 335.9 630.6 749.5 630.6c80 0 155.4-9.1 226.2-29.7 20.6-4.6 43.4-2.3 64 6.9l185.1 100.5c11.4 6.9 27.4-4.6 22.8-18.3l-36.6-148.5c-4.6-22.8 2.3-45.7 22.8-59.4 160.1-116.5 262.9-287.9 262.9-482.1zm-1016.8-82.2c-57.1 0-102.8-45.7-102.8-102.8s45.7-102.8 102.8-102.8 102.8 45.7 102.8 102.8-45.7 102.8-102.8 102.8zm505 0c-57.1 0-102.8-45.7-102.8-102.8s45.7-102.8 102.8-102.8 102.8 45.7 102.8 102.8-48 102.8-102.8 102.8z" fill="#07C160"/><path d="m941.4 1316.1c0-386.1 365.6-699.2 818-699.2h34.3c-73.2-349.6-443.3-616.9-888.9-616.9-500.4 0-904.8 333.6-904.8 747.2 0 228.5 125.7 434.1 322.2 571.2 13.7 9.1 18.3 25.1 16 41.1l-68.5 242.2c-4.6 16 13.7 32 29.7 22.8l267.3-159.9c18.3-11.4 38.8-13.7 59.4-6.9 89.1 22.8 182.8 36.6 278.8 36.6 20.6 0 41.1 0 64-2.3-18.4-57.1-27.5-116.5-27.5-175.9zm267.3-920.8c66.3 0 121.1 54.8 121.1 121.1s-54.8 121.1-121.1 121.1-121.1-54.8-121.1-121.1 54.9-121.1 121.1-121.1zm-607.8 242.2c-66.3 0-121.1-54.8-121.1-121.1s54.8-121.1 121.1-121.1 121.1 54.8 121.1 121.1-52.5 121.1-121.1 121.1z" fill="#07C160"/>
      </svg>
    </g>

    <!-- RedNote — bottom left (brand red) -->
    <g transform="translate(48, 228)" class="hero-logo hero-logo-3">
      <circle cx="32" cy="32" r="36" fill="#FF2442" fill-opacity="0.3" />
      <svg viewBox="0 0 377.97 376.53" width="64" height="64">
        <path d="M43.86,1.11C21.81,5.7,3.59,22.91,1.34,46.07c-2.33,23.92,0,49.25,0,73.3v149.53c0,27.5-6.94,64.79,10.75,87.96,19.11,25.02,53.98,19.06,81.6,19.06h214.03c8.48,0,18.08,1.24,26.39-.49,22.05-4.59,40.26-21.8,42.51-44.96,2.33-23.92,0-49.25,0-73.3V107.64c0-27.5,6.94-64.79-10.75-87.96C346.76-5.34,311.89.62,284.27.62H70.24c-8.48,0-18.08-1.24-26.39.49" fill="#FF2442"/>
      </svg>
    </g>

    <!-- Weibo — bottom right (brand red + orange) -->
    <g transform="translate(268, 248)" class="hero-logo hero-logo-4">
      <circle cx="32" cy="32" r="36" fill="#E6162D" fill-opacity="0.25" />
      <svg viewBox="-5 -5 80 72" width="64" height="64">
        <path d="M5.53 41.936c0 8.758 11.402 15.86 25.47 15.86s25.47-7.103 25.47-15.86S45.067 26.077 31 26.077 5.53 33.178 5.53 41.936" fill="#FFFFFF"/>
        <path d="M31.593 56.504c-12.45 1.228-23.197-4.398-24.007-12.573-.808-8.173 8.633-15.795 21.081-17.026 12.451-1.232 23.199 4.396 24.007 12.567.807 8.176-8.63 15.8-21.081 17.032m24.903-27.135c-1.059-.316-1.785-.533-1.231-1.924 1.201-3.022 1.325-5.628.023-7.488-2.441-3.487-9.121-3.3-16.778-.093 0-.005-2.404 1.052-1.79-.855 1.178-3.787 1-6.958-.833-8.789-4.153-4.157-15.2.157-24.674 9.627C4.119 26.942 0 34.461 0 40.963 0 53.4 15.949 60.961 31.552 60.961c20.453 0 34.059-11.884 34.059-21.318 0-5.701-4.801-8.936-9.115-10.274" fill="#E6162D"/>
        <path d="M70.078 6.61C65.139 1.134 57.853-.953 51.128.476h-.002a2.879 2.879 0 0 0 1.203 5.632c4.784-1.016 9.961.472 13.475 4.36a14.156 14.156 0 0 1 2.957 13.847l.001.001a2.876 2.876 0 0 0 1.855 3.626 2.88 2.88 0 0 0 3.625-1.85l.001-.012c2.108-6.542.776-14-4.165-19.47" fill="#F93"/>
        <path d="M62.492 13.455c-2.404-2.667-5.953-3.68-9.23-2.983a2.478 2.478 0 1 0 1.033 4.845v.002a4.752 4.752 0 0 1 4.515 1.456 4.737 4.737 0 0 1 .987 4.641h.002a2.48 2.48 0 0 0 1.595 3.122 2.48 2.48 0 0 0 3.121-1.598c1.03-3.187.386-6.819-2.023-9.485" fill="#F93"/>
      </svg>
    </g>

    <!-- Pulsing accent dots -->
    <circle cx="190" cy="170" r="3" fill="#CC3333" class="hero-dot hero-dot-1" />
    <circle cx="200" cy="140" r="2" fill="#CC3333" class="hero-dot hero-dot-2" />
    <circle cx="160" cy="190" r="2.5" fill="#CC3333" class="hero-dot hero-dot-3" />
  </svg>
</div>

<style>
  .hero-logo {
    animation: heroFloat 5s ease-in-out infinite;
  }
  .hero-logo-1 { animation-delay: 0s; }
  .hero-logo-2 { animation-delay: -1.25s; }
  .hero-logo-3 { animation-delay: -2.5s; }
  .hero-logo-4 { animation-delay: -3.75s; }

  @keyframes heroFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .hero-dot {
    animation: heroPulse 3s ease-in-out infinite;
  }
  .hero-dot-1 { animation-delay: 0s; }
  .hero-dot-2 { animation-delay: -1s; }
  .hero-dot-3 { animation-delay: -2s; }

  @keyframes heroPulse {
    0%, 100% { opacity: 0.15; }
    50% { opacity: 0.5; }
  }

  .hero-line {
    animation: lineGlow 6s ease-in-out infinite;
  }

  @keyframes lineGlow {
    0%, 100% { stroke-opacity: 0.08; }
    50% { stroke-opacity: 0.25; }
  }
</style>
