---
import Button from '../ui/Button.astro';
---

<section class="relative w-full min-h-[600px] max-[640px]:min-h-[500px] overflow-hidden">
  <!-- Fixed parallax background image -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
    style="background-image: url('/images/hero/hero-phones-shanghai.png')"
    aria-hidden="true"
  ></div>
  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.82]" aria-hidden="true"></div>

  <!-- Watermark -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <span class="text-[#FFFFFF] opacity-[0.03] text-[140px] max-[640px]:text-[80px] font-medium whitespace-nowrap">
      TheRedScroll
    </span>
  </div>

  <!-- Content -->
  <div class="relative z-[1] max-w-[1200px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px]">
    <div class="max-w-[680px]">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        TheRedScroll
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        More followers. More engagement. More conversions.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[12px]">
        On every platform that matters in China.
      </p>
      <p class="text-[rgba(255,255,255,0.4)] text-[14px] font-normal leading-[1.6] mb-[40px]">
        Fixed scope. Fixed price. Team on the ground.
      </p>
      <div class="flex items-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary-dark" href="/services">See our services</Button>
      </div>
    </div>
  </div>
</section>
