                <path d="M33.3 8.1c-1.8-1.9-2.8-4.4-3.1-7.1h-5.8l0 27.7c0 3.1-2.5 5.7-5.7 5.7-1 0-2-.3-2.8-.7-1.7-1-2.8-2.8-2.8-4.9 0-3.1 2.5-5.7 5.7-5.7.6 0 1.2.1 1.7.3v-6c-.6-.1-1.1-.1-1.7-.1-6.5 0-11.7 5.3-11.7 11.7 0 4 2 7.5 5 9.7 1.9 1.4 4.2 2.2 6.7 2.2 6.5 0 11.7-5.3 11.7-11.7V17.5c2.5 1.8 5.5 2.8 8.8 2.8v-5.9c-2.4-.1-4.5-1-6-2.5z" fill="#FFFFFF"/>
              </svg>
            </g>
            <text x="404" y="254" text-anchor="middle" fill="#FFFFFF" font-size="12" font-weight="500" font-family="Inter, sans-serif">Douyin</text>
            <text x="404" y="268" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-size="10" font-family="Inter, sans-serif">抖音</text>
          </g>

