---
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const text = {
  en: {
    headline: 'We grow your brand on China\'s social platforms.',
    sub: 'More followers. More engagement. More conversions.',
    tagline: 'Fixed scope. Fixed price. No surprises.',
    cta1: 'Book a call',
    cta2: 'See our services',
    proof: 'Recent: Camper grew from 43K to 187K followers and lifted same-store sales 31% in 18 months.',
    proofHref: '/work/camper/',
    proofCta: 'Read the case',
    proofOverline: 'Recent client outcome',
  },
  fr: {
    headline: 'Votre marque prend racine sur les réseaux sociaux chinois.',
    sub: 'L\'audience grandit, l\'engagement monte, les ventes suivent.',
    tagline: 'Périmètre verrouillé, prix fixé d\'avance, aucune surprise en chemin.',
    cta1: 'Prendre rendez-vous',
    cta2: 'Voir nos services',
    proof: 'Récemment : Camper est passé de 43 000 à 187 000 abonnés et augmenté ses ventes en magasin de 31 % en 18 mois.',
    proofHref: '/work/camper/',
    proofCta: 'Lire l\'étude de cas',
    proofOverline: 'Résultat client récent',
  },
  zh: {
    headline: '中国社媒这件事，我们替你把品牌做起来。',
    sub: '粉丝涨得起来，互动有人接，转化看得见。',
    tagline: '范围写进合同，一口价到底，不会再来第二张账单。',
    cta1: '预约通话',
    cta2: '查看服务',
    proof: '近期案例：Camper 在 18 个月里把粉丝从 4.3 万做到 18.7 万，门店同店销售提升 31%。',
    proofHref: '/work/camper/',
    proofCta: '查看案例',
    proofOverline: '近期客户成果',
  },
  de: {
    headline: 'Ihre Marke. Sichtbar in Chinas sozialen Netzwerken.',
    sub: 'Reichweite wächst. Communities reden mit. Umsatz kommt an.',
    tagline: 'Klarer Leistungsumfang. Festpreis. Keine Nachforderungen.',
    cta1: 'Gespräch vereinbaren',
    cta2: 'Leistungen ansehen',
    proof: 'Aktuell: Camper hat seine Community von 43.000 auf 187.000 Follower ausgebaut und den vergleichbaren Filialumsatz binnen 18 Monaten um 31 Prozent gesteigert.',
    proofHref: '/work/camper/',
    proofCta: 'Zur Fallstudie',
    proofOverline: 'Aus der Praxis',
  },
  es: {
    headline: 'Hacemos crecer su marca en las redes sociales de China.',
    sub: 'Sube la audiencia. Arranca la conversación. Llegan las ventas.',
    tagline: 'Alcance cerrado. Precio fijo. Cero sorpresas.',
    cta1: 'Agendar una llamada',
    cta2: 'Ver nuestros servicios',
    proof: 'Caso reciente: en 18 meses, Camper pasó de 43.000 a 187.000 seguidores y elevó un 31 % las ventas por tienda.',
    proofHref: '/work/camper/',
    proofCta: 'Ver el caso',
    proofOverline: 'Resultado reciente de un cliente',
  },
}[lang];
---

<section class="relative w-full min-h-[600px] max-[640px]:min-h-[500px] overflow-hidden">
  <!-- Fixed parallax background image -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
    style="background-image: url('/images/hero/hero-phones-shanghai.webp')"
    aria-hidden="true"
  ></div>
  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.82]" aria-hidden="true"></div>

  <!-- Content -->
  <div class="relative z-[1] max-w-[1200px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px]">
    <div class="grid grid-cols-[1fr_1fr] max-[1024px]:grid-cols-1 gap-[48px] items-center">
      <!-- Left: text -->
      <div>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
          TheRedScroll
        </p>
        <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
          {text.headline}
        </h1>
        <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[12px]">
          {text.sub}
        </p>
        <p class="text-[rgba(255,255,255,0.4)] text-[14px] font-normal leading-[1.6] mb-[40px]">
          {text.tagline}
        </p>
        <div class="flex items-center gap-[12px] flex-wrap">
          <Button variant="primary" href={lp('/contact')}>{text.cta1}</Button>
          <Button variant="secondary-dark" href={lp('/services')}>{text.cta2}</Button>
        </div>
        {text.proof && (
          <div class="mt-[32px] pt-[24px] border-t border-[rgba(255,255,255,0.1)] max-w-[520px]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[6px]">
              {text.proofOverline}
            </p>
            <p class="text-[rgba(255,255,255,0.85)] text-[14px] font-normal leading-[1.5]">
              {text.proof}
            </p>
            {text.proofHref && text.proofCta && (
              <a href={lp(text.proofHref)} class="inline-flex items-center gap-[4px] text-[13px] font-medium text-[#FFFFFF] mt-[8px] transition-colors duration-150 hover:text-[#CC3333]">
                {text.proofCta} <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Right: platform logos SVG -->
      <div class="hidden min-[1024px]:flex items-center justify-center" aria-hidden="true">
        <svg viewBox="0 0 480 480" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[440px] h-auto" id="hero-svg">
          <!-- Center ring -->
          <circle cx="240" cy="240" r="160" stroke="#CC3333" stroke-opacity="0.12" stroke-width="1" stroke-dasharray="6 6" class="hero-ring" />
          <circle cx="240" cy="240" r="100" stroke="#FFFFFF" stroke-opacity="0.06" stroke-width="1" class="hero-ring-inner" />

          <!-- Connecting lines from center to each logo -->
          <line x1="240" y1="240" x2="240" y2="68" stroke="#CC3333" stroke-opacity="0.1" stroke-width="1" class="hero-line" />
          <line x1="240" y1="240" x2="404" y2="204" stroke="#CC3333" stroke-opacity="0.1" stroke-width="1" class="hero-line" />
          <line x1="240" y1="240" x2="340" y2="396" stroke="#CC3333" stroke-opacity="0.1" stroke-width="1" class="hero-line" />
          <line x1="240" y1="240" x2="76" y2="240" stroke="#CC3333" stroke-opacity="0.1" stroke-width="1" class="hero-line" />

          <!-- Center dot -->
          <circle cx="240" cy="240" r="6" fill="#CC3333" opacity="0.4" class="hero-center-dot" />
          <circle cx="240" cy="240" r="3" fill="#CC3333" opacity="0.8" />

          <!-- WeChat — top (12 o'clock) -->
          <g class="hero-logo hero-logo-1">
            <circle cx="240" cy="68" r="44" fill="#07C160" fill-opacity="0.15" />
            <circle cx="240" cy="68" r="32" fill="#07C160" fill-opacity="0.25" />
            <g transform="translate(228, 56) scale(1)">
              <svg viewBox="0 0 24 24" width="24" height="24"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-7.062-6.122zm-2.18 2.768c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982z" fill="#07C160"/></svg>
            </g>
