            </g>
            <text x="76" y="290" text-anchor="middle" fill="#FF2442" font-size="12" font-weight="500" font-family="Inter, sans-serif">RedNote</text>
            <text x="76" y="304" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-size="10" font-family="Inter, sans-serif">小红书</text>
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-logo {
    animation: heroFloat 5s ease-in-out infinite;
  }
  .hero-logo-1 { animation-delay: 0s; }
  .hero-logo-2 { animation-delay: -1.25s; }
  .hero-logo-3 { animation-delay: -2.5s; }
  .hero-logo-4 { animation-delay: -3.75s; }

  @keyframes heroFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .hero-ring {
    animation: ringRotate 30s linear infinite;
    transform-origin: 240px 240px;
  }

  @keyframes ringRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .hero-ring-inner {
    animation: ringRotate 20s linear infinite reverse;
    transform-origin: 240px 240px;
  }

  .hero-center-dot {
    animation: centerPulse 3s ease-in-out infinite;
  }

  @keyframes centerPulse {
    0%, 100% { opacity: 0.3; r: 6; }
    50% { opacity: 0.6; r: 8; }
  }

  .hero-line {
    animation: lineGlow 4s ease-in-out infinite;
  }

