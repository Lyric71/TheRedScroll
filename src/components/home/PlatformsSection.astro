---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const platforms = lang === 'de' ? [
  {
    name: 'WeChat', chineseName: '微信', brandColor: '#07C160',
    logo: '/images/platforms/wechat-logo.svg', href: lp('/platforms/wechat'),
    description: 'Die Super-App, an der in China kein Tag vorbeigeht. Official Accounts, Moments, Mini Programs, WeCom. Wer sich auf eine einzige Plattform festlegen müsste, käme an dieser nicht vorbei.',
  },
  {
    name: 'RedNote', chineseName: '小红书', brandColor: '#FF2442',
    logo: '/images/platforms/rednote-logo.svg', href: lp('/platforms/rednote'),
    description: 'Das Notizbuch, in dem chinesische Konsumenten vor fast jedem Kauf nachschlagen. Erfahrungsberichte, Tutorials, Shopping-Posts. Wirkt wie Instagram. Mit dem Unterschied, dass hier wirklich gekauft wird.',
  },
  {
    name: 'Douyin', chineseName: '抖音', brandColor: '#010101',
    logo: '/images/platforms/douyin-logo.svg', href: lp('/platforms/douyin'),
    description: 'Kurzvideo trifft Live-Commerce. Hohe Reichweite, kurzer Weg vom Inhalt zur Bestellung. Marken, die den Algorithmus knacken, sehen Ergebnisse binnen weniger Wochen.',
  },
  {
    name: 'Weibo', chineseName: '微博', brandColor: '#E6162D',
    logo: '/images/platforms/weibo-logo.svg', href: lp('/platforms/weibo'),
    description: 'Bühne für Massenreichweite und PR. Trendthemen, Promi-Kooperationen, Nachrichtenzyklen. Soll ein Markenname binnen Stunden quer durchs Land laufen, führt der Weg nach wie vor über Weibo.',
  },
] : lang === 'zh' ? [
  {
    name: '微信', chineseName: '国民超级应用', brandColor: '#07C160',
    logo: '/images/platforms/wechat-logo.svg', href: lp('/platforms/wechat'),
    description: '中国人一天都离不开的超级 App。公众号、朋友圈、小程序、企业微信，一应俱全。在中国只押一个平台，那就押它。',
  },
  {
    name: '小红书', chineseName: '种草决策场', brandColor: '#FF2442',
    logo: '/images/platforms/rednote-logo.svg', href: lp('/platforms/rednote'),
    description: '中国消费者出手前要翻的那本笔记。测评、攻略、种草笔记，从动心到下单，链路短得惊人。',
  },
  {
    name: '抖音', chineseName: '短视频 + 直播带货', brandColor: '#010101',
    logo: '/images/platforms/douyin-logo.svg', href: lp('/platforms/douyin'),
    description: '短视频加直播电商的主战场。流量足够大，从种草到下单只隔一次点击。摸透算法的品牌，几个月就能见效。',
  },
  {
    name: '微博', chineseName: '热搜与公关主场', brandColor: '#E6162D',
    logo: '/images/platforms/weibo-logo.svg', href: lp('/platforms/weibo'),
    description: '大众传播和公关的主阵地。热搜、明星合作、话题舆情，要让一个品牌名一夜传遍全国，至今没有比微博更快的地方。',
  },
] : lang === 'es' ? [
  {
    name: 'WeChat', chineseName: '微信', brandColor: '#07C160',
    logo: '/images/platforms/wechat-logo.svg', href: lp('/platforms/wechat'),
    description: 'La superapp que marca el día a día en China. Cuentas oficiales, Moments, Mini Programs y WeCom. Si en su plan solo cabe una plataforma, es esta.',
  },
  {
    name: 'RedNote', chineseName: '小红书', brandColor: '#FF2442',
    logo: '/images/platforms/rednote-logo.svg', href: lp('/platforms/rednote'),
    description: 'El cuaderno que el consumidor chino abre antes de comprar casi nada. Reseñas, tutoriales y publicaciones con compra integrada. Se parece a Instagram, salvo en un detalle: aquí sí se compra.',
  },
  {
    name: 'Douyin', chineseName: '抖音', brandColor: '#010101',
    logo: '/images/platforms/douyin-logo.svg', href: lp('/platforms/douyin'),
    description: 'Vídeo corto y venta en directo en el mismo tablero. Alcance enorme y un salto brevísimo del contenido a la venta. Las marcas que dominan el algoritmo ven resultados en pocas semanas.',
  },
  {
    name: 'Weibo', chineseName: '微博', brandColor: '#E6162D',
    logo: '/images/platforms/weibo-logo.svg', href: lp('/platforms/weibo'),
    description: 'La plaza pública del debate y de la prensa. Tendencias, alianzas con personalidades y ciclos de noticias. Para que un nombre recorra China en unas horas, Weibo sigue siendo el paso obligado.',
  },
] : lang === 'fr' ? [
  {
    name: 'WeChat', chineseName: '微信', brandColor: '#07C160',
    logo: '/images/platforms/wechat-logo.svg', href: lp('/platforms/wechat'),
    description: 'La super-application qui scande le quotidien chinois. Comptes officiels, Moments, Mini-Programmes, WeCom. Si une seule plateforme devait être retenue, ce serait celle-ci.',
  },
  {
    name: 'RedNote', chineseName: '小红书', brandColor: '#FF2442',
    logo: '/images/platforms/rednote-logo.svg', href: lp('/platforms/rednote'),
    description: 'Le carnet consulté par les consommateurs chinois avant chaque achat. Avis, tutoriels, publications marchandes. Souvent rapprochée d\'Instagram ; la conversion, elle, y est bien réelle.',
  },
  {
    name: 'Douyin', chineseName: '抖音', brandColor: '#010101',
    logo: '/images/platforms/douyin-logo.svg', href: lp('/platforms/douyin'),
    description: 'Le terrain de jeu de la vidéo courte et du commerce en direct. Portée massive, et un chemin éclair entre le contenu et l\'achat. Les marques qui apprivoisent l\'algorithme voient les résultats arriver en quelques semaines.',
  },
  {
    name: 'Weibo', chineseName: '微博', brandColor: '#E6162D',
    logo: '/images/platforms/weibo-logo.svg', href: lp('/platforms/weibo'),
    description: 'Le grand carrefour de l\'opinion publique et des relations presse. Tendances, partenariats avec des personnalités, cycles d\'actualité. Pour qu\'un nom traverse le pays, le passage par Weibo demeure obligé.',
  },
] : [
  {
    name: 'WeChat', chineseName: '微信', brandColor: '#07C160',
    logo: '/images/platforms/wechat-logo.svg', href: lp('/platforms/wechat'),
    description: 'China\'s super app. Official Accounts, Moments, Mini Programs, WeCom. If you\'re going to pick just one platform in China, this is the one.',
  },
  {
    name: 'RedNote', chineseName: '小红书', brandColor: '#FF2442',
    logo: '/images/platforms/rednote-logo.svg', href: lp('/platforms/rednote'),
    description: 'Where Chinese consumers go before they buy pretty much anything. Reviews, tutorials, shoppable posts. Think of it as China\'s version of Instagram, except people actually buy things from it.',
  },
  {
    name: 'Douyin', chineseName: '抖音', brandColor: '#010101',
    logo: '/images/platforms/douyin-logo.svg', href: lp('/platforms/douyin'),
    description: 'Short video meets live commerce. The reach is massive and the path from content to sale is short. Brands that crack Douyin tend to see results fast.',
  },
  {
    name: 'Weibo', chineseName: '微博', brandColor: '#E6162D',
    logo: '/images/platforms/weibo-logo.svg', href: lp('/platforms/weibo'),
    description: 'Mass reach and PR. Trending topics, celebrity tie-ins, news cycles. When you need a brand name to travel across China quickly, this is still where it happens.',
  },
];

const sectionText = lang === 'de' ? {
  overline: 'Wo wir publizieren',
  heading: 'WeChat. Douyin. RedNote. Weibo. Und vierzehn weitere.',
  note: 'Dazu Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Dianping, Pinduoduo, Taobao Live und weitere. Jede Plattform mit eigenem, ausgewiesenem Preis, zugeschnitten auf Ihre Branche.',
  cta: 'Alle Plattformen ansehen',
} : lang === 'zh' ? {
  overline: '我们发布的平台',
  heading: '微信、抖音、小红书、微博，再加 14 个。',
  note: '此外还有 B 站、快手、知乎、今日头条、美团、大众点评、拼多多、淘宝直播等。每个平台按你的行业单独报价，明码标价，一口到底。',
  cta: '查看全部平台',
} : lang === 'es' ? {
  overline: 'Dónde publicamos',
  heading: 'WeChat. Douyin. RedNote. Weibo. Y catorce más.',
  note: 'Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Dianping, Pinduoduo o Taobao Live, entre otras. Cada plataforma con su propia tarifa, según el sector. Sin letra pequeña.',
  cta: 'Ver todas las plataformas',
} : lang === 'fr' ? {
  overline: 'Nos terrains d\'activation',
  heading: 'WeChat. Douyin. RedNote. Weibo. Et quatorze autres.',
  note: 'S\'y ajoutent Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Dianping, Pinduoduo, Taobao Live et d\'autres encore. Chaque plateforme est tarifée à la carte, selon votre secteur.',
  cta: 'Voir toutes les plateformes',
} : {
  overline: 'Where we post',
  heading: 'WeChat. Douyin. RedNote. Weibo. And 14 more.',
  note: 'Plus Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Dianping, Pinduoduo, Taobao Live, and others. Each priced as a clear add-on based on your industry.',
  cta: 'See all platforms',
};
---

<section class="mt-[64px] max-[640px]:mt-[40px]">
  <Container>
    <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
      <div class="flex justify-center mb-[12px]">
        <SectionBar />
      </div>
      <SectionHeading overline={sectionText.overline}>
        {sectionText.heading}
      </SectionHeading>
    </div>

    <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
      {platforms.map((platform) => (
        <a href={platform.href} class="bg-[#F0F1F4] border-none rounded-[10px] overflow-hidden block transition-[border-color] duration-150 border border-transparent hover:border-[rgba(0,0,0,0.15)]">
          <!-- Branded visual header -->
          <div class="relative w-full aspect-[16/9] flex flex-col items-center justify-center overflow-hidden" style={`background: ${platform.brandColor}`}>
            <!-- Large Chinese character watermark -->
            <span class="absolute text-[80px] max-[640px]:text-[56px] font-medium text-[#FFFFFF] opacity-[0.08] select-none pointer-events-none" aria-hidden="true">
              {platform.chineseName}
            </span>
            <!-- Logo -->
            <img src={platform.logo} alt={`${platform.name} logo`} width="64" height="64" class="relative w-[64px] h-[64px] max-[640px]:w-[48px] max-[640px]:h-[48px] mb-[10px]" loading="lazy" decoding="async" />
            <!-- Platform name -->
            <span class="relative text-[#FFFFFF] text-[18px] font-medium leading-none">
              {platform.name}
            </span>
            <span class="relative text-[rgba(255,255,255,0.7)] text-[12px] font-normal mt-[4px]">
              {platform.chineseName}
            </span>
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              {platform.description}
            </p>
          </div>
        </a>
      ))}
    </div>

    <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] mt-[24px] text-center max-w-[680px] mx-auto">
      {sectionText.note}
    </p>

    <div class="mt-[24px] text-center">
      <Button variant="secondary" href={lp('/platforms/others')}>{sectionText.cta}</Button>
    </div>
  </Container>
</section>
