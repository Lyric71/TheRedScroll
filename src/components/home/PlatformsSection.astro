---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const platforms = lang === 'fr' ? [
  {
    name: 'WeChat', chineseName: '微信', brandColor: '#07C160',
    logo: '/images/platforms/wechat-logo.svg', href: lp('/platforms/wechat'),
    description: 'La super-application chinoise. Comptes officiels, Moments, Mini Programs, WeCom. S\'il ne fallait choisir qu\'une seule plateforme en Chine, ce serait celle-la.',
  },
  {
    name: 'RedNote', chineseName: '小红书', brandColor: '#FF2442',
    logo: '/images/platforms/rednote-logo.svg', href: lp('/platforms/rednote'),
    description: 'C\'est la que les consommateurs chinois se renseignent avant d\'acheter. Avis, tutoriels, publications marchandes. On compare souvent a Instagram, sauf qu\'ici les gens achetent pour de vrai.',
  },
  {
    name: 'Douyin', chineseName: '抖音', brandColor: '#010101',
    logo: '/images/platforms/douyin-logo.svg', href: lp('/platforms/douyin'),
    description: 'La video courte croise le commerce en direct. La portee est considerable et le chemin entre un contenu et une vente, tres court. Les marques qui maitrisent Douyin obtiennent des resultats vite.',
  },
  {
    name: 'Weibo', chineseName: '微博', brandColor: '#E6162D',
    logo: '/images/platforms/weibo-logo.svg', href: lp('/platforms/weibo'),
    description: 'Audience de masse et relations presse. Sujets en tendance, partenariats avec des celebrites, cycles d\'actualite. Pour faire connaitre une marque dans toute la Chine, ca reste le passage oblige.',
  },
] : [
  {
    name: 'WeChat', chineseName: '微信', brandColor: '#07C160',
    logo: '/images/platforms/wechat-logo.svg', href: lp('/platforms/wechat'),
    description: 'China\'s super app. Official Accounts, Moments, Mini Programs, WeCom. If you\'re going to pick just one platform in China, this is the one.',
  },
  {
    name: 'RedNote', chineseName: '小红书', brandColor: '#FF2442',
    logo: '/images/platforms/rednote-logo.svg', href: lp('/platforms/rednote'),
    description: 'Where Chinese consumers go before they buy pretty much anything. Reviews, tutorials, shoppable posts. Think of it as China\'s version of Instagram, except people actually buy things from it.',
  },
  {
    name: 'Douyin', chineseName: '抖音', brandColor: '#010101',
    logo: '/images/platforms/douyin-logo.svg', href: lp('/platforms/douyin'),
    description: 'Short video meets live commerce. The reach is massive and the path from content to sale is short. Brands that crack Douyin tend to see results fast.',
  },
  {
    name: 'Weibo', chineseName: '微博', brandColor: '#E6162D',
    logo: '/images/platforms/weibo-logo.svg', href: lp('/platforms/weibo'),
    description: 'Mass reach and PR. Trending topics, celebrity tie-ins, news cycles. When you need a brand name to travel across China quickly, this is still where it happens.',
  },
];

const sectionText = lang === 'fr' ? {
  overline: 'Ou on publie',
  heading: 'WeChat. Douyin. RedNote. Weibo. Et 14 autres.',
  note: 'Ainsi que Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Dianping, Pinduoduo, Taobao Live, entre autres. Chacune tarifee comme un complement a la carte, selon votre secteur.',
  cta: 'Voir toutes les plateformes',
} : {
  overline: 'Where we post',
  heading: 'WeChat. Douyin. RedNote. Weibo. And 14 more.',
  note: 'Plus Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Dianping, Pinduoduo, Taobao Live, and others. Each priced as a clear add-on based on your industry.',
  cta: 'See all platforms',
};
---

<section class="mt-[64px] max-[640px]:mt-[40px]">
  <Container>
    <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
      <div class="flex justify-center mb-[12px]">
        <SectionBar />
      </div>
      <SectionHeading overline={sectionText.overline}>
        {sectionText.heading}
      </SectionHeading>
    </div>

    <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
      {platforms.map((platform) => (
        <a href={platform.href} class="bg-[#F0F1F4] border-none rounded-[10px] overflow-hidden block transition-[border-color] duration-150 border border-transparent hover:border-[rgba(0,0,0,0.15)]">
          <!-- Branded visual header -->
          <div class="relative w-full aspect-[16/9] flex flex-col items-center justify-center overflow-hidden" style={`background: ${platform.brandColor}`}>
            <!-- Large Chinese character watermark -->
            <span class="absolute text-[80px] max-[640px]:text-[56px] font-medium text-[#FFFFFF] opacity-[0.08] select-none pointer-events-none" aria-hidden="true">
              {platform.chineseName}
            </span>
            <!-- Logo -->
            <img src={platform.logo} alt={`${platform.name} logo`} class="relative w-[64px] h-[64px] max-[640px]:w-[48px] max-[640px]:h-[48px] mb-[10px]" loading="lazy" decoding="async" />
            <!-- Platform name -->
            <span class="relative text-[#FFFFFF] text-[18px] font-medium leading-none">
              {platform.name}
            </span>
            <span class="relative text-[rgba(255,255,255,0.7)] text-[12px] font-normal mt-[4px]">
              {platform.chineseName}
            </span>
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              {platform.description}
            </p>
          </div>
        </a>
      ))}
    </div>

    <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] mt-[24px] text-center max-w-[680px] mx-auto">
      {sectionText.note}
    </p>

    <div class="mt-[24px] text-center">
      <Button variant="secondary" href={lp('/platforms/others')}>{sectionText.cta}</Button>
    </div>
  </Container>
</section>
