---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

import { getCollection } from 'astro:content';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const collectionName = lang === 'fr' ? 'blog-fr' : lang === 'zh' ? 'blog-zh' : lang === 'es' ? 'blog-es' : lang === 'de' ? 'blog-de' : 'blog';
const allPosts = await getCollection(collectionName);
// For locales without a routed insights folder yet, link to the English route so cards never 404.
const insightsHasLocaleRoute = lang === 'en' || lang === 'fr' || lang === 'zh' || lang === 'es' || lang === 'de';
const posts = allPosts
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3)
  .map((post) => ({
    category: post.data.category,
    title: post.data.title,
    readingTime: `${Math.ceil(post.body!.split(/\s+/).length / 200)} min`,
    date: new Date(post.data.publishDate).toLocaleDateString(
      lang === 'zh' ? 'zh-CN' : lang === 'fr' ? 'fr-FR' : lang === 'es' ? 'es-ES' : lang === 'de' ? 'de-DE' : 'en-US',
      { month: 'long', year: 'numeric' }
    ),
    slug: insightsHasLocaleRoute ? `${lp('/insights')}${post.id}/` : `/insights/${post.id}/`,
    featuredImage: post.data.featuredImage,
  }));

const sectionText = lang === 'de' ? {
  overline: 'Analysen',
  heading: 'Was uns dieser Tage beschäftigt.',
  readingLabel: 'Lesezeit',
  cta: 'Weitere Analysen lesen',
} : lang === 'zh' ? {
  overline: '行业洞察',
  heading: '我们最近在研究的几件事。',
  readingLabel: '阅读',
  cta: '查看更多文章',
} : lang === 'fr' ? {
  overline: 'Analyses',
  heading: 'Nos dernières lectures du marché chinois.',
  readingLabel: 'de lecture',
  cta: 'Toutes nos analyses',
} : lang === 'es' ? {
  overline: 'Análisis',
  heading: 'Lo que traemos entre manos estos días.',
  readingLabel: 'de lectura',
  cta: 'Ver todos los análisis',
} : {
  overline: 'Insights',
  heading: 'What we\'re writing about.',
  readingLabel: 'of reading',
  cta: 'Read more insights',
};
---

<section class="mt-[64px] max-[640px]:mt-[40px] pb-[96px] max-[640px]:pb-[64px]">
  <Container>
    <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
      <div class="flex justify-center mb-[12px]">
        <SectionBar />
      </div>
      <SectionHeading overline={sectionText.overline}>
        {sectionText.heading}
      </SectionHeading>
    </div>

    <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
      {posts.map((post) => (
        <a href={post.slug} class="block bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[8px] overflow-hidden transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)]">
          {post.featuredImage ? (
            <img src={post.featuredImage} alt={post.title} width="800" height="600" class="w-full aspect-[4/3] object-cover bg-[#F0F1F4]" loading="lazy" decoding="async" />
          ) : (
            <div class="w-full aspect-[4/3] bg-[#F0F1F4]"></div>
          )}
          <div class="p-[20px]">
            <p class="text-[11px] font-medium tracking-[0.05em] uppercase text-[#CC3333] leading-[1.2] mb-[8px]">
              {post.category}
            </p>
            <h3 class="text-[16px] text-[#1A1A1A] font-medium leading-[1.3] mb-[12px] line-clamp-2">
              {post.title}
            </h3>
            <p class="text-[12px] text-[#5C5C5C] font-normal leading-[1.4]">
              {post.readingTime} {sectionText.readingLabel} <span class="mx-[6px] text-[#E8E0D8]">|</span> {post.date}
            </p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-[32px] text-center">
      <Button variant="secondary" href={lp('/insights')}>{sectionText.cta}</Button>
    </div>
  </Container>
</section>
