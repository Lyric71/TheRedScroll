---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const projectText: Record<string, { title: string; industry: string; platform?: string }> = {
  viessmann: {
    title: lang === 'de' ? 'Viessmann: vom Social-Inhalt direkt in den Verkaufstrichter' : lang === 'zh' ? 'Viessmann：把社媒流量直接做成订单' : lang === 'fr' ? 'Viessmann : du contenu social au tunnel de vente, en direct' : lang === 'es' ? 'Viessmann: del social al pedido, sin escalas' : 'Viessmann: social-to-commerce engine in China',
    industry: lang === 'de' ? 'Klimasysteme' : lang === 'zh' ? '暖通系统' : lang === 'fr' ? 'Climatisation' : lang === 'es' ? 'Climatización' : 'Climate Systems',
    platform: lang === 'zh' ? '抖音 + 小红书 + 企业微信' : undefined,
  },
  jlr: {
    title: lang === 'de' ? 'Jaguar Land Rover: jüngere Kunden in den sozialen Netzwerken erreichen' : lang === 'zh' ? '捷豹路虎：用社媒打动更年轻的用户' : lang === 'fr' ? 'Jaguar Land Rover : capter une clientèle plus jeune sur les réseaux' : lang === 'es' ? 'Jaguar Land Rover: conectar con un público más joven' : 'Jaguar Land Rover: reaching younger consumers',
    industry: lang === 'de' ? 'Automobil' : lang === 'zh' ? '汽车' : lang === 'fr' ? 'Automobile' : lang === 'es' ? 'Automoción' : 'Automotive',
    platform: lang === 'zh' ? '抖音 + 小红书 + 微信' : undefined,
  },
  jac: {
    title: lang === 'de' ? 'JAC Motors: eine Community, mit KI aufgebaut' : lang === 'zh' ? 'JAC 江淮：靠 AI 把车主社群真正做起来' : lang === 'fr' ? 'JAC Motors : structurer une communauté propulsée par l\'IA' : lang === 'es' ? 'JAC Motors: una comunidad construida con IA' : 'JAC Motors: AI-powered community building',
    industry: lang === 'de' ? 'Automobil / E-Mobilität' : lang === 'zh' ? '汽车 / 新能源' : lang === 'fr' ? 'Automobile / VE' : lang === 'es' ? 'Automoción / VE' : 'Automotive / EV',
    platform: lang === 'zh' ? '微信 + 小红书 + 微博' : undefined,
  },
  iguzzini: {
    title: lang === 'de' ? 'iGuzzini: hochwertige Beleuchtung trifft auf ein breiteres Publikum' : lang === 'zh' ? 'iGuzzini：让高端照明走进大众视野' : lang === 'fr' ? 'iGuzzini : ouvrir l\'éclairage haut de gamme à un public élargi' : lang === 'es' ? 'iGuzzini: la iluminación de alta gama se abre al gran público' : 'iGuzzini: luxury lighting goes consumer',
    industry: lang === 'de' ? 'Premium-Beleuchtung' : lang === 'zh' ? '高端照明' : lang === 'fr' ? 'Éclairage haut de gamme' : lang === 'es' ? 'Iluminación de alta gama' : 'Luxury Lighting',
    platform: lang === 'zh' ? '微信 + 小红书 + 微博' : undefined,
  },
};

const projects = [
  {
    title: projectText.viessmann.title,
    industry: projectText.viessmann.industry,
    platform: projectText.viessmann.platform ?? 'Douyin + RedNote + WeCom',
    image: '/images/clients/Viessmann/Viessman-climate-solution.avif',
    href: lp('/work/viessmann'),
  },
  {
    title: projectText.jlr.title,
    industry: projectText.jlr.industry,
    platform: projectText.jlr.platform ?? 'Douyin + RedNote + WeChat',
    image: '/images/clients/Jaguar/Jaguar-Land-Rover.avif',
    href: lp('/work/jaguar-land-rover'),
  },
  {
    title: projectText.jac.title,
    industry: projectText.jac.industry,
    platform: projectText.jac.platform ?? 'WeChat + RedNote + Weibo',
    image: '/images/clients/JAC/JAC-Wechat-4.jpg',
    href: lp('/work/jac-motors'),
  },
  {
    title: projectText.iguzzini.title,
    industry: projectText.iguzzini.industry,
    platform: projectText.iguzzini.platform ?? 'WeChat + RedNote + Weibo',
    image: '/images/clients/iGuzzini/iguzzini4-1.png',
    href: lp('/work/iguzzini'),
  },
];

const sectionText = lang === 'de' ? {
  overline: 'Ausgewählte Projekte',
  heading: 'Kampagnen, die Marken in Chinas Plattformen verankern.',
  description: 'Vom Luxus-Launch bis zur B2B-Leadgenerierung. Echte Kampagnen, echte Plattformen, nachweisbare Ergebnisse.',
  cta: 'Alle Projekte ansehen',
} : lang === 'zh' ? {
  overline: '精选案例',
  heading: '这些品牌，已经在中国社媒真正跑出了结果。',
  description: '从奢侈品新品发布到 B2B 获客，真实的项目、真实的平台、可核验的数据。',
  cta: '查看全部案例',
} : lang === 'es' ? {
  overline: 'Proyectos destacados',
  heading: 'Campañas que asientan marcas en las redes sociales chinas.',
  description: 'Desde lanzamientos de lujo hasta generación de leads B2B. Campañas reales, plataformas reales, resultados verificables.',
  cta: 'Ver todos los proyectos',
} : lang === 'fr' ? {
  overline: 'Nos références',
  heading: 'Des campagnes qui installent durablement les marques sur les réseaux chinois.',
  description: 'Du lancement haut de gamme jusqu\'à l\'acquisition de prospects B2B. Des campagnes menées dans le réel, sur des plateformes identifiables, aux résultats vérifiables.',
  cta: 'Voir tous les projets',
} : {
  overline: 'Featured projects',
  heading: 'Campaigns that grow brands across China\'s platforms.',
  description: 'From luxury launches to B2B lead generation. Real campaigns, real platforms, real results.',
  cta: 'See all projects',
};
---

<section class="mt-[64px] max-[640px]:mt-[40px]">
  <Container>
    <!-- Header row -->
    <div class="flex items-start justify-between gap-[48px] max-[640px]:flex-col max-[640px]:gap-[16px] mb-[40px] max-[640px]:mb-[32px]">
      <div class="max-w-[480px] shrink-0">
        <SectionBar />
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">{sectionText.overline}</p>
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A]">
          {sectionText.heading}
        </h2>
      </div>
      <div class="flex items-start gap-[32px] max-[640px]:flex-col max-[640px]:gap-[16px]">
        <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[360px]">
          {sectionText.description}
        </p>
        <Button variant="primary" href={lp('/work')} class="shrink-0">{sectionText.cta}</Button>
      </div>
    </div>

    <!-- Projects grid: 4 columns -->
    <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
      {projects.map((project) => (
        <a href={project.href} class="group block">
          <!-- Image with tag overlay -->
          <div class="relative w-full aspect-[3/4] rounded-[10px] overflow-hidden bg-[#E8E0D8]">
            <img
              src={project.image}
              alt={project.title}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <!-- Industry + Platform tags -->
            <div class="absolute top-[12px] left-[12px] right-[12px] flex flex-wrap gap-[6px]">
              <span class="bg-[#FFFFFF] text-[#1A1A1A] text-[11px] font-medium px-[10px] py-[5px] rounded-[6px] leading-none">
                {project.industry}
              </span>
              <span class="bg-[#FFFFFF] text-[#1A1A1A] text-[11px] font-medium px-[10px] py-[5px] rounded-[6px] leading-none">
                {project.platform}
              </span>
            </div>
          </div>
          <!-- Title + arrow below -->
          <div class="flex items-center justify-between gap-[12px] mt-[12px]">
            <p class="text-[14px] text-[#1A1A1A] font-medium leading-[1.3]">
              {project.title}
            </p>
            <span class="text-[#1A1A1A] text-[16px] shrink-0">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
