            <div class="w-[40px] h-[40px] rounded-[6px] flex items-center justify-center mb-[16px]" style={`background: ${service.iconBg}`}>
              <Fragment set:html={service.icon} />
            </div>
            <h3 class="text-[18px] font-medium leading-[1.3] mb-[8px]" style={`color: ${service.textColor}`}>
              {service.title}
            </h3>
            <p class="text-[13px] font-normal leading-[1.5]" style={`color: ${service.descColor}`}>
