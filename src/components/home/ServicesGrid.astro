const heroText = lang === 'zh' ? {
  overline: '我们在做什么',
  heading: '八条能力，撑起中国社媒一整盘生意。',
  description: '从策略到内容，从达人营销到私域 CRM。做中国社媒要用的手牌，这里都齐了。',
  cta: '查看全部服务',
  ctaReady: '准备好在中国跑一把？',
  ctaReadySub: '一通电话，我们帮你把路线理清楚。',
  ctaBtn: '预约通话',
} : lang === 'fr' ? {
  overline: 'Ce qu\'on fait',
