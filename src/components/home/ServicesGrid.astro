---

<section class="mt-[64px] max-[640px]:mt-[40px]">
  <Container>
    <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">

      <!-- Hero card: spans 2 cols, 2 rows -->
      <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
        <!-- Background image -->
        <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/why-theredscroll-bg.png')" aria-hidden="true"></div>
        <div class="relative z-[1]">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">
            {heroText.overline}
          </p>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">
            {heroText.heading}
          </h2>
          <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">
            {heroText.description}
          </p>
        </div>
        <div class="relative z-[1] mt-[24px]">
          <Button variant="secondary-dark" href={lp('/services')}>{heroText.cta}</Button>
        </div>
      </div>

      <!-- First 2 service cards (next to hero) -->
      {services.slice(0, 2).map((service) => (
        <div class="border-none rounded-[10px] p-[24px] max-[640px]:p-[20px] flex flex-col justify-between service-card" data-tilt style={`background: ${service.bg}; border-radius: ${service.bg === '#1A1A1A' || service.bg === '#CC3333' ? '12px' : '10px'}`}>
          <div>
            <div class="w-[40px] h-[40px] rounded-[6px] flex items-center justify-center mb-[16px]" style={`background: ${service.iconBg}`}>
              <Fragment set:html={service.icon} />
            </div>
            <h3 class="text-[18px] font-medium leading-[1.3] mb-[8px]" style={`color: ${service.textColor}`}>
              {service.title}
            </h3>
            <p class="text-[13px] font-normal leading-[1.5]" style={`color: ${service.descColor}`}>
              {service.description}
            </p>
          </div>
          <a href={service.href} class="inline-flex items-center gap-[6px] text-[13px] font-medium mt-[16px] transition-colors duration-150" style={`color: ${service.linkColor}`}>
            {service.cta} <span>&rarr;</span>
          </a>
        </div>
      ))}

      <!-- Next row: 4 cards -->
      {services.slice(2, 6).map((service) => (
        <div class="border-none p-[24px] max-[640px]:p-[20px] flex flex-col justify-between service-card" data-tilt style={`background: ${service.bg}; border-radius: ${service.bg === '#1A1A1A' || service.bg === '#CC3333' ? '12px' : '10px'}`}>
          <div>
            <div class="w-[40px] h-[40px] rounded-[6px] flex items-center justify-center mb-[16px]" style={`background: ${service.iconBg}`}>
              <Fragment set:html={service.icon} />
            </div>
            <h3 class="text-[18px] font-medium leading-[1.3] mb-[8px]" style={`color: ${service.textColor}`}>
              {service.title}
            </h3>
            <p class="text-[13px] font-normal leading-[1.5]" style={`color: ${service.descColor}`}>
              {service.description}
            </p>
          </div>
          <a href={service.href} class="inline-flex items-center gap-[6px] text-[13px] font-medium mt-[16px] transition-colors duration-150" style={`color: ${service.linkColor}`}>
            {service.cta} <span>&rarr;</span>
          </a>
        </div>
      ))}

      <!-- Last 2 service cards + CTA -->
      {services.slice(6).map((service) => (
        <div class="border-none p-[24px] max-[640px]:p-[20px] flex flex-col justify-between service-card" data-tilt style={`background: ${service.bg}; border-radius: ${service.bg === '#1A1A1A' || service.bg === '#CC3333' ? '12px' : '10px'}`}>
          <div>
            <div class="w-[40px] h-[40px] rounded-[6px] flex items-center justify-center mb-[16px]" style={`background: ${service.iconBg}`}>
              <Fragment set:html={service.icon} />
            </div>
            <h3 class="text-[18px] font-medium leading-[1.3] mb-[8px]" style={`color: ${service.textColor}`}>
              {service.title}
            </h3>
            <p class="text-[13px] font-normal leading-[1.5]" style={`color: ${service.descColor}`}>
              {service.description}
            </p>
          </div>
          <a href={service.href} class="inline-flex items-center gap-[6px] text-[13px] font-medium mt-[16px] transition-colors duration-150" style={`color: ${service.linkColor}`}>
            {service.cta} <span>&rarr;</span>
          </a>
        </div>
      ))}

      <!-- CTA card -->
      <div class="col-span-2 max-[640px]:col-span-1 bg-[#CC3333] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex items-center justify-between max-[640px]:flex-col max-[640px]:items-start gap-[24px]">
        <div>
          <h3 class="text-[18px] text-[#FFFFFF] font-medium leading-[1.3] mb-[4px]">
            {heroText.ctaReady}
          </h3>
          <p class="text-[14px] text-[rgba(255,255,255,0.8)] font-normal leading-[1.5]">
            {heroText.ctaReadySub}
          </p>
        </div>
        <Button variant="secondary-dark" href={lp('/contact')}>{heroText.ctaBtn}</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .service-card {
    transition: transform 0.15s ease;
    transform-style: preserve-3d;
    will-change: transform;
  }
  /* Scroll reveal initial state */
  .service-card {
    opacity: 0;
    transform: translateY(24px);
  }
  .service-card.revealed {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
</style>

<script>
  // Tilt on hover (desktop only — disable on touch devices)
  const isTouchDevice = window.matchMedia('(hover: none)').matches;
  if (!isTouchDevice) {
    document.querySelectorAll('[data-tilt]').forEach((card) => {
      const el = card as HTMLElement;

      el.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -3;
        const rotateY = ((x - centerX) / centerX) * 3;
        el.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
      });

      el.addEventListener('mouseleave', () => {
        el.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)';
      });
    });
  }

  // Scroll reveal with stagger
  const cards = document.querySelectorAll('.service-card');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const card = entry.target as HTMLElement;
          const index = Array.from(cards).indexOf(card);
          setTimeout(() => {
            card.classList.add('revealed');
          }, index * 80);
          observer.unobserve(card);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  cards.forEach((card) => observer.observe(card));
</script>
