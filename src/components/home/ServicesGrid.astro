const heroText = lang === 'zh' ? {
  overline: '我们的服务',
  heading: '八大板块，助力品牌在中国社交平台全面增长。',
  description: '从策略到内容制作，从达人推广到私域CRM。你需要的一切，都在这里。',
  cta: '查看全部服务',
  ctaReady: '准备好在中国市场发力了吗？',
  ctaReadySub: '一通电话，我们帮你理清最适合你品牌的方案。',
  ctaBtn: '预约沟通',
} : lang === 'fr' ? {
  overline: 'Ce qu\'on fait',
  heading: 'Huit piliers pour developper vos reseaux en Chine.',
  description: 'De la strategie a la production de contenu, des campagnes d\'influence au CRM prive. Tout ce qu\'il faut, sous un meme toit.',
