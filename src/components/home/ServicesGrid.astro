    cta: 'Voir nos formations',
    bg: '#B02D2D', iconBg: 'rgba(255,255,255,0.2)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.8)', linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  },
] : [
  {
    title: 'Strategy, campaigns & analytics',
    description: 'Market research. Content calendars. Always-on campaigns plus event pushes for launches, festivals, shopping holidays. Monthly reporting with numbers you can act on.',
    href: lp('/services/strategy-campaigns'),
    cta: 'See our strategy services',
    bg: '#F0F1F4', iconBg: '#E8E0D8', textColor: '#1A1A1A', descColor: '#5C5C5C', linkColor: '#CC3333',
