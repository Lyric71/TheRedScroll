---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const services = lang === 'zh' ? [
  {
    title: '策略、推广与数据分析',
    description: '市场调研、内容日历、持续运营推广，再配合新品发布、节日和大促的集中爆发。每月出具可执行的数据报告。',
    href: lp('/services/strategy-campaigns'),
    cta: '查看策略服务',
    bg: '#F0F1F4', iconBg: '#E8E0D8', textColor: '#1A1A1A', descColor: '#5C5C5C', linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
  },
  {
    title: '平台',
