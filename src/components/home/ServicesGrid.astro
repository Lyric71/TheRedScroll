---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const services = lang === 'zh' ? [
  {
    title: '策略、活动与数据',
    description: '市场调研、内容日历、日常运营，新品、节日、大促各有各的节奏。每月一份可直接落地的数据报告，不是做给董事会看的 PPT。',
    href: lp('/services/strategy-campaigns'),
    cta: '了解策略服务',
    bg: '#F0F1F4', iconBg: '#E8E0D8', textColor: '#1A1A1A', descColor: '#5C5C5C', linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
  },
  {
    title: '平台',
    description: '微信、抖音、小红书、微博，另加 14 个头部和垂类平台。用户在哪里刷，我们就在哪里发。',
    href: lp('/platforms/others'),
    cta: '查看全部 18 个平台',
    bg: '#1A1A1A', iconBg: 'rgba(255,255,255,0.1)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.6)', linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>`,
  },
  {
    title: '广告策略与投放',
    description: '媒介规划、账户搭建、素材测试、效果复盘。广告费单独结算，不抽点、不返佣、不掺水。',
    href: lp('/services/advertising'),
    cta: '了解广告服务',
    bg: '#E8E0D8', iconBg: '#FFFFFF', textColor: '#1A1A1A', descColor: '#5C5C5C', linkColor: '#CC3333',
