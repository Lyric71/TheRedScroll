        </div>
        <div class="relative z-[1] mt-[24px]">
          <Button variant="secondary-dark" href={lp('/services')}>{heroText.cta}</Button>
        </div>
      </div>

      <!-- First 2 service cards (next to hero) -->
      {services.slice(0, 2).map((service) => (
        <div class="border-none rounded-[10px] p-[24px] max-[640px]:p-[20px] flex flex-col justify-between service-card" data-tilt style={`background: ${service.bg}; border-radius: ${service.bg === '#1A1A1A' || service.bg === '#CC3333' ? '12px' : '10px'}`}>
