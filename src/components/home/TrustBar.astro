---
// Client logos. Replace src values with actual client logo files.
const logos = [
  { name: 'Client 1', src: '/images/clients/logo-placeholder-1.svg' },
  { name: 'Client 2', src: '/images/clients/logo-placeholder-2.svg' },
  { name: 'Client 3', src: '/images/clients/logo-placeholder-3.svg' },
  { name: 'Client 4', src: '/images/clients/logo-placeholder-4.svg' },
  { name: 'Client 5', src: '/images/clients/logo-placeholder-5.svg' },
  { name: 'Client 6', src: '/images/clients/logo-placeholder-6.svg' },
];
// Duplicate for seamless infinite scroll
const allLogos = [...logos, ...logos];
---

<section class="py-[32px] bg-transparent overflow-hidden">
  <div class="relative w-full">
    <!-- Fade edges -->
    <div class="absolute left-0 top-0 bottom-0 w-[80px] bg-gradient-to-r from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none"></div>

    <!-- Scrolling track -->
    <div class="flex items-center gap-[60px] animate-scroll w-max">
      {allLogos.map((logo) => (
        <img
          src={logo.src}
          alt={logo.name}
          class="h-[32px] w-auto shrink-0 grayscale opacity-50 transition-[filter,opacity] duration-150 ease-in-out hover:grayscale-0 hover:opacity-100"
          loading="lazy"
        />
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-scroll {
    animation: scroll 20s linear infinite;
  }
  .animate-scroll:hover {
    animation-play-state: paused;
  }
</style>
