---
// Client logos. Replace with actual client logo files when available.
const logos = [
  { name: 'Client 1', src: '/images/clients/logo-placeholder-1.svg' },
  { name: 'Client 2', src: '/images/clients/logo-placeholder-2.svg' },
  { name: 'Client 3', src: '/images/clients/logo-placeholder-3.svg' },
  { name: 'Client 4', src: '/images/clients/logo-placeholder-4.svg' },
  { name: 'Client 5', src: '/images/clients/logo-placeholder-5.svg' },
  { name: 'Client 6', src: '/images/clients/logo-placeholder-6.svg' },
];
const allLogos = [...logos, ...logos];
---

<section class="py-[16px] bg-transparent overflow-hidden">
  <div class="relative w-full flex items-center justify-center min-h-[64px]">
    <!-- Fade edges -->
    <div class="absolute left-0 top-0 bottom-0 w-[80px] max-[640px]:w-[40px] bg-gradient-to-r from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute right-0 top-0 bottom-0 w-[80px] max-[640px]:w-[40px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>

    <!-- Scrolling track -->
    <div class="flex items-center gap-[60px] max-[640px]:gap-[32px] animate-scroll w-max">
      {allLogos.map((logo) => (
        <div class="h-[32px] px-[16px] shrink-0 flex items-center justify-center bg-[#F0F1F4] rounded-[6px]">
          <span class="text-[12px] text-[#5C5C5C] font-medium whitespace-nowrap">{logo.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-scroll {
    animation: scroll 20s linear infinite;
  }
  .animate-scroll:hover {
    animation-play-state: paused;
  }
</style>
