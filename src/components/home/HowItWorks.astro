---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const steps = [
  {
    number: '01',
    title: 'Discovery call.',
    description: '30 minutes. We ask about your brand, your goals, how ready you are for China. No pitch deck. Just the right questions.',
  },
  {
    number: '02',
    title: 'Proposal.',
    description: 'Clear SOW. Fixed price. Every deliverable listed out. You see what you\'re getting and what it costs before you commit to anything.',
  },
  {
    number: '03',
    title: 'Live in 2 weeks.',
    description: 'Onboarding, accounts set up, first content published. Fourteen days from signed contract to first post going live.',
  },
];
---

<section class="mt-[96px] max-[640px]:mt-[64px]">
  <Container>
    <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
      <div class="flex justify-center mb-[12px]">
        <SectionBar />
      </div>
      <SectionHeading overline="Getting started">
        One call. One proposal. One price.
      </SectionHeading>
    </div>

    <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[32px] max-[640px]:gap-[24px]">
      {steps.map((step, index) => (
        <div class="text-center">
          <!-- Step number circle -->
          <div class="w-[56px] h-[56px] rounded-full bg-[#F7F2EE] flex items-center justify-center mx-auto mb-[20px]">
            <span class="text-[#CC3333] text-[18px] font-medium">{step.number}</span>
          </div>
          <h3 class="text-[18px] text-[#1A1A1A] font-medium leading-[1.3] mb-[8px]">
            {step.title}
          </h3>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[320px] mx-auto">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </Container>
</section>
