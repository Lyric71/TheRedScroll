---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const textByLang = {
  en: {
    overline: 'Getting started',
    heading: 'One call. One proposal. One price.',
    cta: 'Book a call',
    steps: [
      {
        number: '01',
        title: 'Discovery call.',
        description: '30 minutes. We ask about your brand, your goals, how ready you are for China. No pitch deck. Just the right questions.',
      },
      {
        number: '02',
        title: 'Proposal.',
        description: 'Clear SOW. Fixed price. Every deliverable listed out. You see what you\'re getting and what it costs before you commit to anything.',
      },
      {
        number: '03',
        title: 'Live in 2 weeks.',
        description: 'Onboarding, accounts set up, first content published. Fourteen days from signed contract to first post going live.',
      },
    ],
  },
  fr: {
    overline: 'Démarrer',
    heading: 'Un appel. Une proposition. Un tarif.',
    cta: 'Prendre rendez-vous',
    steps: [
      {
        number: '01',
        title: 'Échange préliminaire.',
        description: 'Trente minutes pour cerner votre marque, vos objectifs et votre niveau de préparation au marché chinois. Aucune présentation commerciale, uniquement les questions qui comptent.',
      },
      {
        number: '02',
        title: 'Proposition chiffrée.',
        description: 'Cahier des charges détaillé, tarif arrêté, livrables ligne à ligne. Avant toute signature, vous savez précisément ce que vous obtenez et ce que cela vous coûtera.',
      },
      {
        number: '03',
        title: 'Lancement en deux semaines.',
        description: 'Intégration, ouverture des comptes, première publication. Quatorze jours séparent la signature de la mise en ligne du premier contenu.',
      },
    ],
  },
  zh: {
    overline: '合作流程',
    heading: '一通电话、一份方案、一口价。',
    cta: '预约通话',
    steps: [
      {
        number: '01',
        title: '先聊 30 分钟',
        description: '直接聊你的品牌、目标、在中国这边的准备情况。没有 PPT，不走流程，只问真正该问的问题。',
      },
      {
        number: '02',
        title: '出方案、给报价',
        description: 'SOW 写得一清二楚，一口报价，每一条交付都摆上台面。签字之前，你就知道能拿到什么、要花多少钱。',
      },
      {
        number: '03',
        title: '14 天内上线',
        description: '对接、开户、搭账号、首批内容出街。从合同签完算起，14 天内首条内容在平台上跑起来。',
      },
    ],
  },
  de: {
    overline: 'So legen wir los',
    heading: 'Ein Gespräch. Ein Angebot. Ein Preis.',
    cta: 'Gespräch vereinbaren',
    steps: [
      {
        number: '01',
        title: 'Erstgespräch.',
        description: 'Dreißig Minuten. Wir sprechen über Ihre Marke, Ihre Ziele und Ihren Reifegrad für China. Keine Folienschlacht. Nur die Fragen, die zählen.',
      },
      {
        number: '02',
        title: 'Angebot.',
        description: 'Klares Leistungsverzeichnis. Festpreis. Jede Leistung schriftlich aufgeführt. Bevor Sie unterschreiben, wissen Sie genau, was Sie bekommen und was es kostet.',
      },
      {
        number: '03',
        title: 'In zwei Wochen live.',
        description: 'Onboarding, Konten eingerichtet, erster Beitrag veröffentlicht. Vierzehn Tage zwischen unterschriebenem Vertrag und erstem Post.',
      },
    ],
  },
  es: {
    overline: 'Cómo empezamos',
    heading: 'Una llamada. Una propuesta. Un precio.',
    cta: 'Agendar una llamada',
    steps: [
      {
        number: '01',
        title: 'Llamada inicial.',
        description: 'Media hora. Hablamos de su marca, de sus objetivos y de cómo está de preparado para China. Sin presentación comercial. Solo las preguntas que importan.',
      },
      {
        number: '02',
        title: 'Propuesta.',
        description: 'Pliego detallado. Precio cerrado. Cada entregable, escrito línea a línea. Antes de la firma, sabrá exactamente qué recibe y cuánto le cuesta.',
      },
      {
        number: '03',
        title: 'En marcha en dos semanas.',
        description: 'Integración, apertura de cuentas, primera publicación al aire. Catorce días desde la firma hasta el primer contenido en plataforma.',
      },
    ],
  },
};
const text = (textByLang as Record<string, typeof textByLang.en>)[lang] ?? textByLang.en;

const icons = [
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
];
---

<section class="relative mt-[64px] max-[640px]:mt-[40px] py-[80px] max-[1024px]:py-[64px] max-[640px]:py-[48px] overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/hero/getting-started-bg.webp')" aria-hidden="true"></div>
  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.88]" aria-hidden="true"></div>

  <Container class="relative z-[1]">
    <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
      <div class="flex justify-center mb-[12px]">
        <div class="w-[40px] h-[3px] bg-[#CC3333] rounded-none"></div>
      </div>
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
        {text.overline}
      </p>
      <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF]">
        {text.heading}
      </h2>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[24px] max-[640px]:gap-[16px]">
      {text.steps.map((step, i) => (
        <div class="bg-[rgba(255,255,255,0.06)] border-[0.5px] border-[rgba(255,255,255,0.1)] rounded-[12px] p-[32px] max-[640px]:p-[20px] text-center">
          <!-- Icon circle -->
          <div class="w-[64px] h-[64px] max-[640px]:w-[48px] max-[640px]:h-[48px] rounded-full bg-[rgba(255,255,255,0.08)] border-[0.5px] border-[rgba(255,255,255,0.15)] flex items-center justify-center mx-auto mb-[20px]">
            <Fragment set:html={icons[i]} />
          </div>
          <!-- Step number -->
          <p class="text-[12px] font-medium text-[#CC3333] leading-none mb-[8px]">
            {lang === 'zh' ? '第' : lang === 'fr' ? 'Étape' : lang === 'es' ? 'Paso' : lang === 'de' ? 'Schritt' : 'Step'} {step.number} {lang === 'zh' ? '步' : ''}
          </p>
          <h3 class="text-[18px] text-[#FFFFFF] font-medium leading-[1.3] mb-[8px]">
            {step.title}
          </h3>
          <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6]">
            {step.description}
          </p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-[40px]">
      <Button variant="primary" href={lp('/contact')}>{text.cta}</Button>
    </div>
  </Container>
</section>
