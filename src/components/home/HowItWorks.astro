---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

const steps = [
  {
    number: '01',
    title: 'Discovery call.',
    description: '30 minutes. We ask about your brand, your goals, how ready you are for China. No pitch deck. Just the right questions.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Proposal.',
    description: 'Clear SOW. Fixed price. Every deliverable listed out. You see what you\'re getting and what it costs before you commit to anything.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'Live in 2 weeks.',
    description: 'Onboarding, accounts set up, first content published. Fourteen days from signed contract to first post going live.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];
---

<section class="relative mt-[96px] max-[640px]:mt-[64px] py-[80px] max-[640px]:py-[48px] overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/hero/getting-started-bg.png')" aria-hidden="true"></div>
  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.88]" aria-hidden="true"></div>

  <Container class="relative z-[1]">
    <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
      <div class="flex justify-center mb-[12px]">
        <div class="w-[40px] h-[3px] bg-[#CC3333] rounded-none"></div>
      </div>
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
        Getting started
      </p>
      <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF]">
        One call. One proposal. One price.
      </h2>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[24px] max-[640px]:gap-[16px]">
      {steps.map((step) => (
        <div class="bg-[rgba(255,255,255,0.06)] border-[0.5px] border-[rgba(255,255,255,0.1)] rounded-[12px] p-[32px] max-[640px]:p-[24px] text-center">
          <!-- Icon circle -->
          <div class="w-[64px] h-[64px] rounded-full bg-[rgba(255,255,255,0.08)] border-[0.5px] border-[rgba(255,255,255,0.15)] flex items-center justify-center mx-auto mb-[20px]">
            <Fragment set:html={step.icon} />
          </div>
          <!-- Step number -->
          <p class="text-[12px] font-medium text-[#CC3333] leading-none mb-[8px]">
            Step {step.number}
          </p>
          <h3 class="text-[18px] text-[#FFFFFF] font-medium leading-[1.3] mb-[8px]">
            {step.title}
          </h3>
          <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6]">
            {step.description}
          </p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-[40px]">
      <Button variant="primary" href="/contact">Book a call</Button>
    </div>
  </Container>
</section>
