---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Lang } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const text = {
  en: {
    overline: 'About TheRedScroll',
    heading: 'We grow social networks in China. From the ground.',
    p1: 'TheRedScroll is a social media agency built for China. We work from Shanghai and Hong Kong, inside the platforms, every single day.',
    p2: 'Our team is native Chinese speakers. They live on WeChat, Douyin, RedNote, and Weibo the same way your audience does. When a trending topic breaks on Weibo at 9 AM Beijing time, we\'re already on it.',
    p3: 'We serve three types of clients: international brands entering China for the first time, international brands already operating in China who want better results, and Chinese brands growing their domestic social presence.',
    stats: [
      { value: '20+', label: 'Years of experience' },
      { value: '18+', label: 'Platforms covered' },
      { value: 'Our own', label: 'Studio' },
    ],
  },
  fr: {
    overline: 'A propos de TheRedScroll',
    heading: 'On developpe vos reseaux sociaux en Chine. Depuis le terrain.',
    p1: 'TheRedScroll est une agence pensee pour la Chine. On travaille depuis Shanghai et Hong Kong, au coeur des plateformes, tous les jours.',
    p2: 'Notre equipe est chinoise. Ils vivent sur WeChat, Douyin, RedNote et Weibo exactement comme votre audience. Quand un sujet explose sur Weibo a 9h du matin heure de Pekin, on est deja dessus.',
    p3: 'On accompagne trois profils de clients : les marques internationales qui arrivent en Chine, celles qui y sont deja mais veulent de meilleurs resultats, et les marques chinoises qui cherchent a muscler leur presence sur les reseaux.',
    stats: [
      { value: '20+', label: 'Ans d\'experience' },
      { value: '18+', label: 'Plateformes couvertes' },
      { value: 'Notre propre', label: 'Studio' },
    ],
  },
  zh: {
    overline: '关于我们',
    heading: '做中国社媒增长，人就在现场。',
    p1: 'TheRedScroll是一家扎在本地做社媒的机构，办公室在上海和香港。每天的工作就是泡在平台里——不是隔着仪表盘看数据的那种。',
    p2: '团队基本上全是本地人，跟你的用户一样，早上起来先刷微信，通勤刷小红书和抖音，开会间隙翻微博。北京时间早九点一条热搜冒头，这边的人早就在群里讨论怎么跟了。',
    p3: '合作的品牌主要分三类：一是刚把中国社媒当回事做的，二是已经在做但数据一直上不去的，三是正在国内抢增量的本土品牌。',
    stats: [
      { value: '20+', label: '年行业经验' },
      { value: '18+', label: '运营平台' },
      { value: '自建', label: '内容工作室' },
    ],
  },
}[lang];
---

<section class="mt-[64px] max-[640px]:mt-[40px]">
  <Container>
    <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
      <!-- Image collage column -->
      <div class="grid grid-cols-2 grid-rows-2 gap-[12px]">
        <!-- Large image top-left spanning 1 col, 2 rows -->
        <div class="row-span-2 rounded-[8px] bg-[#F0F1F4] aspect-[3/4] overflow-hidden">
          <img src="/images/team/china-office.png" alt={lang === 'fr' ? 'Bureau TheRedScroll en Chine' : lang === 'zh' ? 'TheRedScroll中国办公室' : 'TheRedScroll China office'} class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </div>
        <!-- Top-right image -->
        <div class="rounded-[8px] bg-[#F0F1F4] aspect-[4/3] overflow-hidden">
          <img src="/images/team/hongkong-office.png" alt={lang === 'fr' ? 'Bureau TheRedScroll a Hong Kong' : lang === 'zh' ? 'TheRedScroll香港办公室' : 'TheRedScroll Hong Kong office'} class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </div>
        <!-- Bottom-right image -->
        <div class="rounded-[8px] bg-[#F0F1F4] aspect-[4/3] overflow-hidden">
          <img src="/images/team/team-photo.png" alt={lang === 'fr' ? 'Equipe TheRedScroll' : lang === 'zh' ? 'TheRedScroll团队' : 'TheRedScroll team'} class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Text column -->
      <div>
        <SectionBar />
        <SectionHeading overline={text.overline}>
          {text.heading}
        </SectionHeading>
        <div class="mt-[24px]">
          <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6] mb-[24px]">
            {text.p1}
          </p>
          <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6] mb-[24px]">
            {text.p2}
          </p>
          <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6]">
            {text.p3}
          </p>
        </div>

        <!-- Stats row -->
        <div class="flex items-start gap-[0px] mt-[32px]">
          {text.stats.map((stat, i) => (
            <div class:list={[
              'text-center flex-1',
              i > 0 && 'border-l border-[#E8E0D8] pl-[24px] max-[640px]:pl-[16px]',
              i < text.stats.length - 1 && 'pr-[24px] max-[640px]:pr-[16px]',
            ]}>
              <p class="text-[28px] max-[640px]:text-[22px] text-[#1A1A1A] font-medium leading-[1.2]">{stat.value}</p>
              <p class="text-[13px] max-[640px]:text-[11px] text-[#5C5C5C] font-normal mt-[4px] leading-[1.3]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
