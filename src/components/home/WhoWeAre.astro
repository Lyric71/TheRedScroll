---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Lang } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const textByLang = {
  en: {
    overline: 'About TheRedScroll',
    heading: 'We grow social networks in China. From the ground.',
    p1: 'TheRedScroll is a China social media agency. We grow brands on WeChat, Douyin, RedNote, Weibo, and 14 other Chinese platforms. Our offices are in Shanghai and Hong Kong, where we run accounts every day, not from a desk in another time zone.',
    p2: 'Our team is native Chinese speakers. They live on WeChat, Douyin, RedNote, and Weibo the same way your audience does. When a trending topic breaks on Weibo at 9 AM Beijing time, we\'re already on it.',
    p3: 'We work with three types of clients. International brands entering China for the first time. International brands already operating here who want better results. Chinese brands scaling their domestic social presence. Every project runs on a fixed scope and a fixed price, agreed before anything starts. In our April 2026 review of 37 agencies in this space, none offered the same model.',
    stats: [
      { value: '20+', label: 'Years of experience' },
      { value: '18+', label: 'Platforms covered' },
      { value: 'Our own', label: 'Studio' },
    ],
  },
  fr: {
    overline: 'À propos de TheRedScroll',
    heading: 'Nous installons votre marque sur les réseaux chinois depuis le terrain, jamais à distance.',
    p1: 'TheRedScroll est une agence de réseaux sociaux dédiée à la seule Chine. Nous développons les marques sur WeChat, Douyin, RedNote, Weibo et quatorze autres plateformes chinoises. Nos équipes de Shanghai et de Hong Kong sont au contact des plateformes chaque jour, pas derrière un bureau à l’autre bout du monde.',
    p2: 'L’équipe est 100 % sinophone. Elle vit sur WeChat, Douyin, RedNote et Weibo exactement comme votre public. Qu’un sujet s’enflamme sur Weibo à neuf heures, heure de Pékin, et nous sommes déjà dessus.',
    p3: 'Nous accompagnons trois profils de clients. Les marques internationales qui arrivent en Chine. Celles qui y opèrent déjà et veulent de meilleurs résultats. Et les marques chinoises prêtes à passer un cap sur leurs propres réseaux. Chaque mission a un périmètre et un tarif fixés avant le premier jour. En avril 2026, nous avons passé en revue 37 agences du secteur : aucune ne proposait le même modèle.',
    stats: [
      { value: '20+', label: 'années d\'expérience' },
      { value: '18+', label: 'plateformes couvertes' },
      { value: 'Notre propre', label: 'studio' },
    ],
  },
  zh: {
    overline: '关于 TheRedScroll',
    heading: '在中国社媒做增长，靠的是一支常驻本地的团队。',
    p1: 'TheRedScroll 是一家只做中国社交媒体的代理。我们在微信、抖音、小红书、微博，再加另外 14 个中国平台上，替品牌做增长。上海、香港两地办公，团队天天泡在平台上做内容，而不是隔着几个时区盯后台。',
    p2: '团队全是土生土长的中国人，跟你的用户一样，天天泡在微信、抖音、小红书、微博上。北京时间早上九点一条热搜刚冒头，我们这边早就盯上了。',
    p3: '我们只服务三类客户：头一回进中国市场的国际品牌；已经在国内、却想做出更好成绩的国际品牌；想把国内社媒推上一个量级的本土品牌。每个项目都按固定范围、固定价格来，启动前先把方案谈清楚。2026 年 4 月，我们盘点了这一行的 37 家代理，没有一家是同样的做法。',
    stats: [
      { value: '20+', label: '年行业经验' },
      { value: '18+', label: '覆盖平台' },
      { value: '自有', label: '内容工作室' },
    ],
  },
  de: {
    overline: 'Über TheRedScroll',
    heading: 'Wir bauen Marken in Chinas sozialen Netzwerken auf. Von innen heraus.',
    p1: 'TheRedScroll ist eine Social-Media-Agentur, die ausschließlich für China arbeitet. Wir schaffen Reichweite auf WeChat, Douyin, RedNote, Weibo und vierzehn weiteren chinesischen Plattformen. Wir sitzen in Shanghai und Hongkong, direkt an den Plattformen, jeden Tag und nicht aus einer fernen Zeitzone.',
    p2: 'Unser Team besteht aus chinesischen Muttersprachlern. Sie sind auf WeChat, Douyin, RedNote und Weibo zu Hause, genau wie Ihre Zielgruppe. Wenn um neun Uhr morgens Pekinger Zeit ein Thema auf Weibo hochkocht, sind wir schon dran.',
    p3: 'Wir arbeiten für drei Arten von Kunden. Internationale Marken, die zum ersten Mal nach China gehen. Internationale Marken, die bereits vor Ort sind und mehr erwarten. Und chinesische Marken, die in den sozialen Netzwerken eine Stufe höher wollen. Jedes Projekt hat einen klar umrissenen Umfang und einen Festpreis, verbindlich vereinbart, bevor es losgeht. In unserer Branchenstudie vom April 2026 unter 37 Agenturen bot keine ein vergleichbares Modell.',
    stats: [
      { value: '20+', label: 'Jahre Erfahrung' },
      { value: '18+', label: 'abgedeckte Plattformen' },
      { value: 'Eigenes', label: 'Studio' },
    ],
  },
  es: {
    overline: 'Sobre TheRedScroll',
    heading: 'Hacemos crecer marcas en las redes sociales de China. Desde dentro.',
    p1: 'TheRedScroll es una agencia de redes sociales hecha para China. Trabajamos en WeChat, Douyin, RedNote, Weibo y otras catorce plataformas del país. Operamos a diario desde Shanghái y Hong Kong, metidos de lleno en las plataformas, no desde otra zona horaria.',
    p2: 'El equipo es íntegramente chino. Vive WeChat, Douyin, RedNote y Weibo igual que su audiencia. Cuando una tendencia estalla en Weibo a las nueve de la mañana en Pekín, ya estamos encima.',
    p3: 'Trabajamos con tres perfiles. Marcas internacionales que llegan a China por primera vez. Marcas internacionales ya instaladas que buscan otro nivel de resultados. Y marcas chinas decididas a dar un salto en sus redes nacionales. Cada proyecto se ejecuta en circuito cerrado y con tarifa fija, acordados antes de empezar. En nuestra revisión de abril de 2026, sobre 37 agencias del sector, ninguna ofrecía este modelo.',
    stats: [
      { value: '20+', label: 'años de experiencia' },
      { value: '18+', label: 'plataformas cubiertas' },
      { value: 'Estudio', label: 'propio' },
    ],
  },
};
const text = (textByLang as Record<string, typeof textByLang.en>)[lang] ?? textByLang.en;
---

<section class="mt-[64px] max-[640px]:mt-[40px]">
  <Container>
    <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
      <!-- Image collage column -->
      <div class="grid grid-cols-2 grid-rows-2 gap-[12px]">
        <!-- Large image top-left spanning 1 col, 2 rows -->
        <div class="row-span-2 rounded-[8px] bg-[#F0F1F4] aspect-[3/4] overflow-hidden">
          <img src="/images/team/china-office.webp" alt={lang === 'fr' ? 'Bureau TheRedScroll en Chine' : lang === 'zh' ? 'TheRedScroll 中国办公室' : lang === 'es' ? 'Oficina de TheRedScroll en China' : lang === 'de' ? 'TheRedScroll-Büro in China' : 'TheRedScroll China office'} width="600" height="800" class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </div>
        <!-- Top-right image -->
        <div class="rounded-[8px] bg-[#F0F1F4] aspect-[4/3] overflow-hidden">
          <img src="/images/team/hongkong-office.webp" alt={lang === 'fr' ? 'Bureau TheRedScroll à Hong Kong' : lang === 'zh' ? 'TheRedScroll 香港办公室' : lang === 'es' ? 'Oficina de TheRedScroll en Hong Kong' : lang === 'de' ? 'TheRedScroll-Büro in Hongkong' : 'TheRedScroll Hong Kong office'} width="800" height="600" class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </div>
        <!-- Bottom-right image -->
        <div class="rounded-[8px] bg-[#F0F1F4] aspect-[4/3] overflow-hidden">
          <img src="/images/team/team-photo.webp" alt={lang === 'fr' ? 'Équipe TheRedScroll' : lang === 'zh' ? 'TheRedScroll 团队' : lang === 'es' ? 'Equipo de TheRedScroll' : lang === 'de' ? 'TheRedScroll-Team' : 'TheRedScroll team'} width="800" height="600" class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Text column -->
      <div>
        <SectionBar />
        <SectionHeading overline={text.overline}>
          {text.heading}
        </SectionHeading>
        <div class="mt-[24px]">
          <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6] mb-[24px]">
            {text.p1}
          </p>
          <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6] mb-[24px]">
            {text.p2}
          </p>
          <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6]">
            {text.p3}
          </p>
        </div>

        <!-- Stats row -->
        <div class="flex items-start gap-[0px] mt-[32px]">
          {text.stats.map((stat, i) => (
            <div class:list={[
              'text-center flex-1',
              i > 0 && 'border-l border-[#E8E0D8] pl-[24px] max-[640px]:pl-[16px]',
              i < text.stats.length - 1 && 'pr-[24px] max-[640px]:pr-[16px]',
            ]}>
              <p class="text-[28px] max-[640px]:text-[22px] text-[#1A1A1A] font-medium leading-[1.2]">{stat.value}</p>
              <p class="text-[13px] max-[640px]:text-[11px] text-[#5C5C5C] font-normal mt-[4px] leading-[1.3]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
