---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const stats = [
  { value: '18+', label: 'Platforms covered' },
  { value: '37', label: 'Agencies analyzed' },
  { value: '0', label: 'Offer fixed pricing' },
];
---

<section class="mt-[96px] max-[640px]:mt-[64px]">
  <Container>
    <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
      <!-- Image collage column -->
      <div class="grid grid-cols-2 grid-rows-2 gap-[12px]">
        <!-- Large image top-left spanning 1 col, 2 rows -->
        <div class="row-span-2 rounded-[8px] bg-[#F7F2EE] aspect-[3/4] flex items-center justify-center overflow-hidden">
          <span class="text-[#5C5C5C] text-[12px] font-normal">Team photo</span>
        </div>
        <!-- Top-right image -->
        <div class="rounded-[8px] bg-[#F7F2EE] aspect-[4/3] flex items-center justify-center overflow-hidden">
          <span class="text-[#5C5C5C] text-[12px] font-normal">Shanghai office</span>
        </div>
        <!-- Bottom-right image -->
        <div class="rounded-[8px] bg-[#F7F2EE] aspect-[4/3] flex items-center justify-center overflow-hidden">
          <span class="text-[#5C5C5C] text-[12px] font-normal">Hong Kong office</span>
        </div>
      </div>

      <!-- Text column -->
      <div>
        <SectionBar />
        <SectionHeading overline="About TheRedScroll">
          We grow social networks in China. From the ground.
        </SectionHeading>
        <div class="mt-[24px]">
          <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6] mb-[24px]">
            TheRedScroll is a social media agency built for China. We work from Shanghai and Hong Kong, inside the platforms, every single day.
          </p>
          <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6] mb-[24px]">
            Our team is native Chinese speakers. They live on WeChat, Douyin, RedNote, and Weibo the same way your audience does. When a trending topic breaks on Weibo at 9 AM Beijing time, we're already on it.
          </p>
          <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6]">
            We serve three types of clients: international brands entering China for the first time, international brands already operating in China who want better results, and Chinese brands growing their domestic social presence.
          </p>
        </div>

        <!-- Stats row -->
        <div class="flex items-start gap-[0px] mt-[32px]">
          {stats.map((stat, i) => (
            <div class:list={[
              'text-center flex-1',
              i > 0 && 'border-l border-[#E8E0D8] pl-[24px]',
              i < stats.length - 1 && 'pr-[24px]',
            ]}>
              <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">{stat.value}</p>
              <p class="text-[13px] text-[#5C5C5C] font-normal mt-[4px] leading-[1.3]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
