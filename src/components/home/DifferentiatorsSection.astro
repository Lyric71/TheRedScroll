---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import Button from '../ui/Button.astro';

const fixes = [
  {
    title: 'Clear scope.',
    description: 'Every deliverable defined before you sign. No ambiguity.',
  },
  {
    title: 'Fixed price.',
    description: 'One price. No hidden fees. No scope creep. Zero of the 37 agencies we benchmarked offer this.',
  },
  {
    title: 'Team on the ground.',
    description: 'Shanghai and Hong Kong. Native speakers. Real-time platform access. Cultural fluency.',
  },
  {
    title: 'AI-powered content.',
    description: 'Faster delivery. Lower costs. Strategy stays 100% human.',
  },
];
---

<section class="mt-[96px] max-[640px]:mt-[64px]">
  <Container>
    <div class="relative rounded-[12px] py-[48px] px-[48px] max-[640px]:px-[20px] max-[640px]:py-[32px] overflow-hidden bg-[#1A1A1A]">
      <!-- Background image -->
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/why-theredscroll-bg.png')" aria-hidden="true"></div>
      <div class="relative z-[1]">

      <!-- Header -->
      <div class="mb-[40px] max-[640px]:mb-[32px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Why TheRedScroll
        </p>
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF]">
          The agency model is broken. Here's how we fixed it.
        </h2>
      </div>

      <!-- Two-column layout -->
      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px]">

        <!-- Left: The Problem -->
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            The problem
          </p>
          <p class="text-[16px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] mb-[24px]">
            Platforms move fast. Content doesn't translate. Agencies are expensive and opaque. Results are hard to measure.
          </p>
          <p class="text-[16px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6]">
            Whether you're entering China, already here, or a Chinese brand scaling up, growing on social media is hard without the right team.
          </p>
        </div>

        <!-- Right: How We Fix It -->
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            How we fix it
          </p>
          <div class="flex flex-col gap-[20px]">
            {fixes.map((item) => (
              <div class="border-l-[3px] border-[#CC3333] pl-[16px]">
                <h3 class="text-[16px] text-[#FFFFFF] font-medium leading-[1.3] mb-[4px]">
                  {item.title}
                </h3>
                <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.5]">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
          <div class="mt-[32px]">
            <Button variant="primary" href="/contact">Book a call</Button>
          </div>
        </div>
      </div>

      </div>
    </div>
  </Container>
</section>
