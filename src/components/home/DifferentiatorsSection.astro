---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const text = lang === 'zh' ? {
  overline: '为什么选TheRedScroll',
  heading: '老一套代理模式早就不灵了。我们换了个玩法。',
  problemLabel: '现在的问题',
  problemP1: '平台跑得比代理快，内容硬翻译一套不管用，收费不透明，效果也说不清楚。',
  problemP2: '不管你是刚把中国社媒重新拎起来做的，还是做了很久但一直找不到节奏的，没有靠谱的团队，社媒增长基本上就是在赌运气。',
  fixLabel: '我们的做法',
  fixes: [
    { title: '范围写清楚。', description: '每一项交付物在签合同前就全部写明白，没有模糊地带。' },
    { title: '一口价。', description: '一个价钱，不加项、不变动、不二次报价。市面上37家同行调研下来，这一条没人做到。' },
    { title: '团队在本地。', description: '人在上海、香港。本地团队，实时操作平台，文化这事儿不用翻译。' },
    { title: 'AI做内容。', description: '产出更快，成本更低。但策略这块，始终是人在拍板。' },
  ],
  cta: '预约通话',
} : lang === 'fr' ? {
  overline: 'Pourquoi TheRedScroll',
  heading: 'Le modele classique des agences ne marche plus. On a construit autre chose.',
  problemLabel: 'Le constat',
  problemP1: 'Les plateformes bougent vite. Le contenu ne se traduit pas. Les agences coutent cher et restent opaques. Les resultats, difficiles a mesurer.',
  problemP2: 'Que vous debarquiez en Chine, que vous y soyez deja installe, ou que vous soyez une marque chinoise en pleine croissance, grandir sur les reseaux sans la bonne equipe c\'est un pari risque.',
  fixLabel: 'Ce qu\'on fait differemment',
  fixes: [
    { title: 'Un cadre clair.', description: 'Chaque livrable est defini avant la signature. Pas de zone grise.' },
    { title: 'Un prix fixe.', description: 'Un seul prix. Pas de frais caches. Pas de depassement. Sur les 37 agences qu\'on a etudiees, aucune ne propose ca.' },
    { title: 'Une equipe sur place.', description: 'Shanghai et Hong Kong. Sinophones natifs. Acces en temps reel aux plateformes. Maitrise culturelle reelle.' },
    { title: 'Du contenu augmente par l\'IA.', description: 'Production plus rapide. Couts en baisse. La strategie, elle, reste 100 % humaine.' },
  ],
  cta: 'Prendre rendez-vous',
} : {
  overline: 'Why TheRedScroll',
  heading: 'The agency model is broken. Here\'s how we fixed it.',
  problemLabel: 'The problem',
  problemP1: 'Platforms move fast. Content doesn\'t translate. Agencies are expensive and opaque. Results are hard to measure.',
  problemP2: 'Whether you\'re entering China, already here, or a Chinese brand scaling up, growing on social media is hard without the right team.',
  fixLabel: 'How we fix it',
  fixes: [
    { title: 'Clear scope.', description: 'Every deliverable defined before you sign. No ambiguity.' },
    { title: 'Fixed price.', description: 'One price. No hidden fees. No scope creep. Zero of the 37 agencies we benchmarked offer this.' },
    { title: 'Team on the ground.', description: 'Shanghai and Hong Kong. Native speakers. Real-time platform access. Cultural fluency.' },
    { title: 'AI-powered content.', description: 'Faster delivery. Lower costs. Strategy stays 100% human.' },
  ],
  cta: 'Book a call',
};
---

<section class="mt-[64px] max-[640px]:mt-[40px]">
  <Container>
    <div class="relative rounded-[12px] py-[48px] px-[48px] max-[640px]:px-[20px] max-[640px]:py-[32px] overflow-hidden bg-[#1A1A1A]">
      <!-- Background image -->
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/why-theredscroll-bg.png')" aria-hidden="true"></div>
      <div class="relative z-[1]">

      <!-- Header -->
      <div class="mb-[40px] max-[640px]:mb-[32px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          {text.overline}
        </p>
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF]">
          {text.heading}
        </h2>
      </div>

      <!-- Two-column layout -->
      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px]">

        <!-- Left: The Problem -->
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            {text.problemLabel}
          </p>
          <p class="text-[16px] max-[640px]:text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] mb-[24px]">
            {text.problemP1}
          </p>
          <p class="text-[16px] max-[640px]:text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6]">
            {text.problemP2}
          </p>
        </div>

        <!-- Right: How We Fix It -->
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            {text.fixLabel}
          </p>
          <div class="flex flex-col gap-[20px]">
            {text.fixes.map((item) => (
              <div class="border-l-[3px] border-[#CC3333] pl-[16px]">
                <h3 class="text-[16px] text-[#FFFFFF] font-medium leading-[1.3] mb-[4px]">
                  {item.title}
                </h3>
                <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.5]">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
          <div class="mt-[32px]">
            <Button variant="primary" href={lp('/contact')}>{text.cta}</Button>
          </div>
        </div>
      </div>

      </div>
    </div>
  </Container>
</section>
