---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const text = lang === 'de' ? {
  overline: 'Warum TheRedScroll',
  heading: 'Das klassische Agenturmodell hat ausgedient. Wir machen es anders.',
  problemLabel: 'Der Befund',
  problemP1: 'Plattformen ziehen davon. Übersetzte Inhalte bleiben hängen. Agenturen rechnen hoch und erklären wenig. Performance lässt sich kaum sauber messen.',
  problemP2: 'Ob Sie zum ersten Mal nach China gehen, schon im Markt sind oder als chinesische Marke skalieren wollen: ohne das richtige Team bleibt Wachstum in den sozialen Netzwerken Glückssache.',
  fixLabel: 'Unsere Antwort',
  fixes: [
    { title: 'Klar definierter Umfang.', description: 'Jedes Deliverable steht vor Vertragsschluss fest. Keine Grauzonen.' },
    { title: 'Fester Preis.', description: 'Ein Preis. Keine versteckten Kosten, kein Scope-Creep. Von 37 verglichenen Agenturen tut das keine einzige.' },
    { title: 'Team vor Ort.', description: 'Shanghai und Hongkong. Muttersprachler. Direkter Plattform-Zugriff. Kulturelle Lesart aus erster Hand.' },
    { title: 'KI für die Produktion, Köpfe für die Entscheidung.', description: 'Schnellere Auslieferung. Niedrigere Kosten. Die Strategie liegt zu 100 Prozent in menschlicher Hand.' },
  ],
  cta: 'Gespräch vereinbaren',
} : lang === 'zh' ? {
  overline: '为什么选 TheRedScroll',
  heading: '传统代理那一套早就跟不上了。我们换了另一条路。',
  problemLabel: '问题在哪',
  problemP1: '平台跑得比代理快，内容硬翻没人看，报价雾里看花，效果说不清道不明。',
  problemP2: '无论你是第一次进中国、卡在半路，还是想在国内社媒再上一个台阶，没有一支过硬的团队，增长这件事基本靠运气。',
  fixLabel: '我们的做法',
  fixes: [
    { title: '范围白纸黑字', description: '每一条交付，在签约前就写清楚，不留模糊地带。' },
    { title: '一口价', description: '一次算清，不加项、不漂移、不追加。我们调研过的 37 家同行，没有一家做到这一条。' },
    { title: '团队常驻本地', description: '人在上海和香港，每天亲手用平台，文化这关不用再翻译一次。' },
    { title: 'AI 负责产能，人负责判断', description: '出片更快、成本更低。策略判断始终留在人手上。' },
  ],
  cta: '预约通话',
} : lang === 'es' ? {
  overline: 'Por qué TheRedScroll',
  heading: 'El modelo clásico de agencia ha caducado. Hemos rehecho las reglas.',
  problemLabel: 'El diagnóstico',
  problemP1: 'Las plataformas aceleran. Los contenidos traducidos no enganchan. Las agencias cobran mucho y explican poco. El rendimiento, casi imposible de medir.',
  problemP2: 'Primera implantación en China, marca ya instalada o enseña china en plena escalada: sin un equipo a la altura, crecer en redes es lotería.',
  fixLabel: 'Nuestra respuesta',
  fixes: [
    { title: 'Alcance por escrito.', description: 'Cada entregable queda cerrado antes de la firma. Sin zonas grises.' },
    { title: 'Precio cerrado.', description: 'Un solo precio. Sin extras, sin desvíos. De las 37 agencias que hemos analizado, ninguna lo ofrece.' },
    { title: 'Equipo sobre el terreno.', description: 'Shanghái y Hong Kong. Nativos. Acceso directo a las plataformas. Lectura cultural de primera mano.' },
    { title: 'IA para producir, personas para decidir.', description: 'Más rapidez, menos coste. La estrategia se queda íntegramente en manos del equipo humano.' },
  ],
  cta: 'Reservar una llamada',
} : lang === 'fr' ? {
  overline: 'Pourquoi TheRedScroll',
  heading: 'Le modèle classique des agences a vécu. Nous en proposons un autre.',
  problemLabel: 'Le constat',
  problemP1: 'Les plateformes accélèrent. Les contenus traduits trébuchent. Les agences facturent beaucoup et expliquent peu. La performance se laisse difficilement mesurer.',
  problemP2: 'Première implantation en Chine, marque déjà sur place ou enseigne chinoise en pleine accélération : sans la bonne équipe, la croissance sociale relève du pari.',
  fixLabel: 'Notre réponse',
  fixes: [
    { title: 'Un cadre précis.', description: 'Chaque livrable est arrêté avant signature. Aucune zone grise n\'est laissée à l\'interprétation.' },
    { title: 'Un tarif ferme.', description: 'Un seul prix, aucun frais caché, aucune dérive. Sur les 37 agences que nous avons étudiées, aucune ne souscrit à ce principe.' },
    { title: 'Une équipe locale.', description: 'Shanghai et Hong Kong. Locuteurs natifs, accès direct aux plateformes, compétence culturelle de premier rang.' },
    { title: 'L\'IA comme accélérateur.', description: 'Production accélérée, coûts allégés. La décision stratégique demeure intégralement entre les mains de nos consultants.' },
  ],
  cta: 'Prendre rendez-vous',
} : {
  overline: 'Why TheRedScroll',
  heading: 'The agency model is broken. Here\'s how we fixed it.',
  problemLabel: 'The problem',
  problemP1: 'Platforms move fast. Content doesn\'t translate. Agencies are expensive and opaque. Results are hard to measure.',
  problemP2: 'Whether you\'re entering China, already here, or a Chinese brand scaling up, growing on social media is hard without the right team.',
  fixLabel: 'How we fix it',
  fixes: [
    { title: 'Clear scope.', description: 'Every deliverable defined before you sign. No ambiguity.' },
    { title: 'Fixed price.', description: 'One price. No hidden fees. No scope creep. Zero of the 37 agencies we benchmarked offer this.' },
    { title: 'Team on the ground.', description: 'Shanghai and Hong Kong. Native speakers. Real-time platform access. Cultural fluency.' },
    { title: 'AI-powered content.', description: 'Faster delivery. Lower costs. Strategy stays 100% human.' },
  ],
  cta: 'Book a call',
};
---

<section class="mt-[64px] max-[640px]:mt-[40px]">
  <Container>
    <div class="relative rounded-[12px] py-[48px] px-[48px] max-[1024px]:px-[32px] max-[1024px]:py-[40px] max-[640px]:px-[20px] max-[640px]:py-[32px] overflow-hidden bg-[#1A1A1A]">
      <!-- Background image -->
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/why-theredscroll-bg.png')" aria-hidden="true"></div>
      <div class="relative z-[1]">

      <!-- Header -->
      <div class="mb-[40px] max-[640px]:mb-[32px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          {text.overline}
        </p>
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF]">
          {text.heading}
        </h2>
      </div>

      <!-- Two-column layout -->
      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px]">

        <!-- Left: The Problem -->
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            {text.problemLabel}
          </p>
          <p class="text-[16px] max-[640px]:text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] mb-[24px]">
            {text.problemP1}
          </p>
          <p class="text-[16px] max-[640px]:text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6]">
            {text.problemP2}
          </p>
        </div>

        <!-- Right: How We Fix It -->
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            {text.fixLabel}
          </p>
          <div class="flex flex-col gap-[20px]">
            {text.fixes.map((item) => (
              <div class="border-l-[3px] border-[#CC3333] pl-[16px]">
                <h3 class="text-[16px] text-[#FFFFFF] font-medium leading-[1.3] mb-[4px]">
                  {item.title}
                </h3>
                <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.5]">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
          <div class="mt-[32px]">
            <Button variant="primary" href={lp('/contact')}>{text.cta}</Button>
          </div>
        </div>
      </div>

      </div>
    </div>
  </Container>
</section>
