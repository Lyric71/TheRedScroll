---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import Button from '../ui/Button.astro';

const pillars = [
  {
    title: 'Audience.',
    description: '1 billion users. Dozens of platforms. Each one different. Find your audience first. Then pick the platform.',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.85)',
    image: '/images/ecosystem/audience.png',
    gradient: 'linear-gradient(to top, rgba(26,26,26,0.9) 30%, rgba(26,26,26,0.3) 100%)',
  },
  {
    title: 'Content.',
    description: 'What works on Douyin fails on WeChat. Every platform has its own format, language, and pace. Build for each one.',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.85)',
    image: '/images/ecosystem/content.png',
    gradient: 'linear-gradient(to top, rgba(26,26,26,0.9) 30%, rgba(26,26,26,0.2) 100%)',
  },
  {
    title: 'Influencers.',
    description: 'KOLs and KOCs drive buying decisions more than ads do. Right influencer, right platform, right moment. Everything else is waste.',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.85)',
    image: '/images/ecosystem/influencers.png',
    gradient: 'linear-gradient(to top, rgba(204,51,51,0.95) 25%, rgba(204,51,51,0.3) 100%)',
  },
  {
    title: 'Platforms.',
    description: 'WeChat, Douyin, RedNote, Weibo, and 14 more. Algorithms change monthly. You need a team that\'s on them every day.',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.85)',
    image: '/images/ecosystem/platforms.png',
    gradient: 'linear-gradient(to top, rgba(26,26,26,0.9) 30%, rgba(26,26,26,0.15) 100%)',
  },
];
---

<section class="mt-[96px] max-[640px]:mt-[64px]">
  <Container>
    <!-- Bento grid: heading card + image left, 4 pillar cards right -->
    <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[16px]">
      <!-- Left column -->
      <div class="flex flex-col gap-[16px]">
        <!-- Heading card -->
        <div class="relative rounded-[10px] p-[32px] max-[640px]:p-[24px] flex flex-col justify-between overflow-hidden">
          <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/hero/hero-phones-shanghai.png')" aria-hidden="true"></div>
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(26,26,26,0.95) 40%, rgba(26,26,26,0.5) 100%)" aria-hidden="true"></div>
          <div class="relative z-[1]">
            <div class="w-[40px] h-[3px] bg-[#CC3333] rounded-none mb-[12px]"></div>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[12px]">
              Chinese social media is not a channel. It's an ecosystem.
            </h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.7)] font-normal leading-[1.6]">
              Audience, content, influencers, platforms, and commerce are all connected. You can't win on one without the others.
            </p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="primary" href="/contact">Book a call</Button>
          </div>
        </div>
        <!-- Commerce card -->
        <div class="relative rounded-[12px] min-h-[180px] flex flex-col justify-end overflow-hidden">
          <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/ecosystem/commerce.png')" aria-hidden="true"></div>
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(26,26,26,0.92) 35%, rgba(26,26,26,0.3) 100%)" aria-hidden="true"></div>
          <div class="relative z-[1] p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] text-[#FFFFFF] font-medium leading-[1.3] mb-[6px]">
              Commerce.
            </h3>
            <p class="text-[14px] text-[rgba(255,255,255,0.85)] font-normal leading-[1.5]">
              Social media in China is where people buy, not just browse. Content and commerce are the same thing here.
            </p>
          </div>
        </div>
      </div>

      <!-- Right column: 2x2 pillar cards -->
      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {pillars.map((pillar) => (
          <div class="relative overflow-hidden rounded-[12px] min-h-[200px] flex flex-col justify-end">
            <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${pillar.image}')`} aria-hidden="true"></div>
            <div class="absolute inset-0" style={`background: ${pillar.gradient}`} aria-hidden="true"></div>
            <div class="relative z-[1] p-[24px] max-[640px]:p-[20px]">
              <h3 class="text-[18px] font-medium leading-[1.3] mb-[6px]" style={`color: ${pillar.textColor}`}>
                {pillar.title}
              </h3>
              <p class="text-[13px] font-normal leading-[1.5]" style={`color: ${pillar.descColor}`}>
                {pillar.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
