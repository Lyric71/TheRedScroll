---
import Container from '../ui/Container.astro';
import SectionBar from '../ui/SectionBar.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/config';
import { localizedPath } from '../../i18n/config';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lp = (path: string) => localizedPath(path, lang);

const pillars = lang === 'de' ? [
  {
    title: 'Zielgruppe.',
    description: 'Eine Milliarde Nutzer, verteilt auf Dutzende Plattformen, jede mit eigenen Regeln. Erst die Zielgruppe definieren, dann den Kanal wählen. In umgekehrter Reihenfolge wird es teuer.',
    stat: '1B+', statLabel: 'Nutzer',
    image: '/images/ecosystem/audience.png',
  },
  {
    title: 'Content.',
    description: 'Was auf Douyin viral geht, geht auf WeChat unter. Jede Plattform hat ihren eigenen Takt und ihre eigene Sprache. Wir produzieren für jede einzeln.',
    stat: '18+', statLabel: 'Plattformen',
    image: '/images/ecosystem/content.png',
  },
  {
    title: 'Influencer.',
    description: 'KOLs und KOCs steuern Kaufentscheidungen sicherer als klassische Werbung. Richtiges Profil, richtige Plattform, richtiger Zeitpunkt. Der Rest verpufft.',
    stat: '80%', statLabel: 'vertrauen KOLs',
    image: '/images/ecosystem/influencers.png',
  },
  {
    title: 'Plattformen.',
    description: 'WeChat, Douyin, RedNote, Weibo, dazu vierzehn weitere Netzwerke. Die Algorithmen ändern sich Monat für Monat. Wer mithalten will, braucht ein Team, das täglich dranbleibt.',
    stat: '14+', statLabel: 'weitere Plattformen',
    image: '/images/ecosystem/platforms.png',
  },
  {
    title: 'Commerce.',
    description: 'In China wird gekauft, ohne den Feed zu verlassen. Soziale Netzwerke dienen nicht der Produktentdeckung, sondern dem Verkauf. Content macht direkt die Kasse.',
    stat: '3.5T', statLabel: 'RMB GMV Douyin',
    image: '/images/ecosystem/commerce.png',
  },
] : lang === 'zh' ? [
  {
    title: '人群',
    description: '十亿用户散在几十个平台，每个圈层都有自己的规则。先把人找准，再挑战场。顺序反了，预算白烧。',
    stat: '1B+', statLabel: '用户',
    image: '/images/ecosystem/audience.png',
  },
  {
    title: '内容',
    description: '抖音上爆的片子，搬到微信可能没人点开。每个平台有自己的节奏和语感，一条通稿包打天下早就行不通。',
    stat: '18+', statLabel: '平台',
    image: '/images/ecosystem/content.png',
  },
  {
    title: '达人',
    description: '用户信 KOL 和 KOC，不信硬广。人挑对、平台对、时机对，预算才有用武之地。',
    stat: '80%', statLabel: '用户更信 KOL',
    image: '/images/ecosystem/influencers.png',
