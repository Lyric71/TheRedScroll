---
import Button from '../ui/Button.astro';
---

<section class="mt-[96px] max-[640px]:mt-[64px] mb-[0px]">
  <div class="w-full bg-[#F7F2EE] py-[64px] max-[640px]:py-[48px] px-[48px] max-[640px]:px-[20px]">
    <div class="max-w-[600px] mx-auto text-center">
      <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
        Let's talk about China.
      </h2>
      <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] mb-[24px]">
        One call. We'll walk you through what package fits, what platforms to prioritize, and what to expect in the first 90 days.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary" href="/services">See our services</Button>
      </div>
    </div>
  </div>
</section>
