            <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[rgba(255,255,255,0.7)] mb-[8px]">Content production</p>
            <h3 class="text-[22px] max-[640px]:text-[18px] font-medium leading-[1.25] text-[#FFFFFF] mb-[8px]">
