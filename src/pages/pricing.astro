    <!-- Content Production -->
    <section class="mt-[96px] max-[640px]:mt-[64px]">
      <Container>
        <div class="bg-[#CC3333] rounded-[12px] p-[48px] max-[640px]:p-[24px] flex items-center justify-between max-[640px]:flex-col max-[640px]:items-start gap-[32px]">
