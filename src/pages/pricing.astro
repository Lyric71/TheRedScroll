            </div>
          </div>

          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal mt-[24px]">
            Platforms covered: WeChat Ads, Douyin Ads, RedNote Ads, Weibo Ads, Baidu SEM/PPC, Bilibili Ads, Kuaishou Ads.
          </p>
        </div>
      </Container>
    </section>

