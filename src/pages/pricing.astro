---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import SectionBar from '../components/ui/SectionBar.astro';

const packages = [
  {
    name: 'Launch',
    price: '$3,600',
    description: 'Get started on China\'s core platforms with a focused content plan.',
    highlighted: false,
    strategy: {
      competitor: 'Month 1',
      contentStrategy: true,
      editorialCalendar: true,
      accountOpening: 'If needed',
    },
    content: {
      wechat: '1 article/week',
      weibo: '1 post/week',
      rednote: '1 post/week',
      douyinClient: '1 video/week',
      douyinAi: false,
      douyinTotal: '1/week',
    },
    ai: false,
    socialListening: false,
    support: {
      accountManager: true,
      chatSupport: true,
      monthlyReport: true,
      strategyCalls: 'Monthly',
    },
  },
  {
    name: 'Scale',
    price: '$5,100',
    description: 'Triple your output with AI video and more frequent posting.',
    highlighted: true,
    strategy: {
      competitor: 'Month 1',
      contentStrategy: true,
      editorialCalendar: true,
      accountOpening: 'If needed',
    },
    content: {
      wechat: '1 article/week',
      weibo: '3 posts/week',
      rednote: '3 posts/week',
      douyinClient: '1 video/week',
      douyinAi: '1 video/week',
      douyinTotal: '2/week',
    },
    ai: true,
    socialListening: false,
    support: {
      accountManager: true,
      chatSupport: true,
      monthlyReport: true,
      strategyCalls: 'Weekly',
    },
  },
  {
    name: 'Command',
    price: '$6,550',
    description: 'Full coverage. Daily posting. Social listening. Anytime access.',
    highlighted: false,
    strategy: {
      competitor: 'Month 1',
      contentStrategy: true,
      editorialCalendar: true,
      accountOpening: 'If needed',
    },
    content: {
      wechat: '1 article/week',
      weibo: '7 posts/week',
      rednote: '5 posts/week',
      douyinClient: '2 videos/week',
      douyinAi: '2 videos/week',
      douyinTotal: '4/week',
    },
    ai: true,
    socialListening: true,
    support: {
      accountManager: true,
      chatSupport: true,
      monthlyReport: true,
      strategyCalls: 'Anytime',
    },
  },
];

const addOnPlatforms = [
  { category: 'Video platforms', items: [
    { name: 'Bilibili (long-form, 2-5 min)', price: '$250/post' },
    { name: 'Bilibili (short-form, under 60s)', price: '$150/post' },
    { name: 'Kuaishou (short video)', price: '$120/post' },
  ]},
  { category: 'Text & Q&A platforms', items: [
    { name: 'Zhihu (long-form article)', price: '$180/post' },
    { name: 'Zhihu (short answer)', price: '$90/post' },
    { name: 'Toutiao (news-style article)', price: '$130/post' },
    { name: 'Baidu Tieba (forum post)', price: '$80/post' },
  ]},
  { category: 'Commerce & lifestyle', items: [
    { name: 'Meituan / Dianping', price: '$200/month' },
    { name: 'Pinduoduo (product listing)', price: '$150/post' },
    { name: 'Lemon8 (lifestyle post)', price: '$100/post' },
    { name: 'QQ (community post)', price: '$70/post' },
  ]},
];
---

<BaseLayout
  title="Pricing | TheRedScroll"
  description="Fixed scope, fixed price packages for China social media marketing. WeChat, Douyin, RedNote, Weibo. From $3,600/month."
>
  <main class="pt-[60px] max-[640px]:pt-[52px]">

    <!-- Hero -->
    <section class="relative w-full bg-[#1A1A1A] rounded-none overflow-hidden py-[80px] max-[640px]:py-[48px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/pricing-bg.png')" aria-hidden="true"></div>
      <div class="relative z-[1] max-w-[800px] mx-auto text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">Pricing</p>
        <h1 class="text-[#FFFFFF] text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] mb-[8px]">
          Fixed scope. Fixed price. No surprises.
        </h1>
        <p class="text-[rgba(255,255,255,0.6)] text-[16px] font-normal leading-[1.6]">
          All prices in USD, tax excluded. 6-month minimum contract on all packages.
        </p>
      </div>
    </section>

    <!-- Core Packages Comparison Table -->
    <section class="mt-[96px] max-[640px]:mt-[64px]">
      <Container>
        <div class="text-center mb-[48px]">
          <div class="flex justify-center mb-[12px]"><SectionBar /></div>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A]">Core packages</h2>
        </div>

        <!-- Desktop comparison table -->
        <div class="max-[640px]:hidden overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="w-[280px] p-[16px] align-bottom"></th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tl-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Launch</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">$3,600<span class="text-[14px] text-[#5C5C5C] font-normal">/mo</span></p>
                  <Button variant="secondary" href="/contact" class="mt-[16px] w-full justify-center text-[13px]">Get started</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] relative border-x-[3px] border-[#CC3333]">
                  <div class="absolute top-0 left-[-3px] right-[-3px] h-[3px] bg-[#CC3333]"></div>
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">Most popular</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">$5,100<span class="text-[14px] text-[#5C5C5C] font-normal">/mo</span></p>
                  <Button variant="primary" href="/contact" class="mt-[16px] w-full justify-center text-[13px]">Get started</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tr-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Command</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">$6,550<span class="text-[14px] text-[#5C5C5C] font-normal">/mo</span></p>
                  <Button variant="secondary" href="/contact" class="mt-[16px] w-full justify-center text-[13px]">Get started</Button>
                </th>
              </tr>
            </thead>
            <tbody>
              <!-- Section: Strategy & Setup -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Strategy & setup</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Competitor study</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Month 1</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">Month 1</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Month 1</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Content strategy & pillars</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Monthly editorial calendar</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Account opening & registration</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">If needed</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">If needed</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">If needed</td>
              </tr>

              <!-- Section: Content -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Content</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">WeChat</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 article/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1 article/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 article/week</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Weibo</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 post/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3 posts/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">7 posts/week</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">RedNote (Xiaohongshu)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 post/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3 posts/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">5 posts/week</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin (client footage)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 video/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1 video/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2 videos/week</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin (AI-generated, max 15s)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">1 video/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2 videos/week</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)] bg-[#F0F1F4]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium">Total Douyin videos</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center">1/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">2/week</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">4/week</td>
              </tr>

              <!-- Section: AI Production -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">AI production</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">AI video via HubStudio.ai</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Brief validated before production</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Social Listening -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Social listening</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Brand mention monitoring</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Competitor activity tracking</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Monthly sentiment summary</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Support & Reporting -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Support & reporting</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Dedicated account manager</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Chat support (Mon-Fri)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Monthly performance report</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Strategy calls</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Monthly</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">Weekly</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">Anytime</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Mobile: stacked cards with full features (shown only on mobile) -->
        <div class="hidden max-[640px]:flex flex-col gap-[16px]">
          {packages.map((pkg) => {
            const dark = pkg.highlighted;
            const textPrimary = dark ? 'text-[#FFFFFF]' : 'text-[#1A1A1A]';
            const textSecondary = dark ? 'text-[rgba(255,255,255,0.6)]' : 'text-[#5C5C5C]';
            const borderColor = dark ? 'border-[rgba(255,255,255,0.1)]' : 'border-[rgba(0,0,0,0.06)]';

            const features = [
              { section: 'Strategy & setup', items: [
                { label: 'Competitor study', value: pkg.strategy.competitor },
                { label: 'Content strategy & pillars', value: pkg.strategy.contentStrategy },
                { label: 'Monthly editorial calendar', value: pkg.strategy.editorialCalendar },
                { label: 'Account opening & registration', value: pkg.strategy.accountOpening },
              ]},
              { section: 'Content', items: [
                { label: 'WeChat', value: pkg.content.wechat },
                { label: 'Weibo', value: pkg.content.weibo },
                { label: 'RedNote (Xiaohongshu)', value: pkg.content.rednote },
                { label: 'Douyin (client footage)', value: pkg.content.douyinClient },
                { label: 'Douyin (AI-generated)', value: pkg.content.douyinAi },
                { label: 'Total Douyin videos', value: pkg.content.douyinTotal },
              ]},
              { section: 'AI production', items: [
                { label: 'AI video via HubStudio.ai', value: pkg.ai },
                { label: 'Brief validated before production', value: pkg.ai },
              ]},
              { section: 'Social listening', items: [
                { label: 'Brand mention monitoring', value: pkg.socialListening },
                { label: 'Competitor activity tracking', value: pkg.socialListening },
                { label: 'Monthly sentiment summary', value: pkg.socialListening },
              ]},
              { section: 'Support & reporting', items: [
                { label: 'Dedicated account manager', value: pkg.support.accountManager },
                { label: 'Chat support (Mon-Fri)', value: pkg.support.chatSupport },
                { label: 'Monthly performance report', value: pkg.support.monthlyReport },
                { label: 'Strategy calls', value: pkg.support.strategyCalls },
              ]},
            ];

            return (
              <div class:list={[
                'rounded-[12px] p-[24px]',
                dark ? 'bg-[#1A1A1A]' : 'bg-[#F0F1F4]'
              ]}>
                <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">
                  {dark ? 'Most popular' : pkg.name}
                </p>
                {dark && <p class="text-[14px] font-medium text-[#FFFFFF] mb-[2px]">{pkg.name}</p>}
                <p class:list={['text-[28px] font-medium leading-[1.2] mb-[4px]', textPrimary]}>
                  {pkg.price}<span class:list={['text-[14px] font-normal', textSecondary]}>/mo</span>
                </p>
                <p class:list={['text-[13px] font-normal leading-[1.5] mb-[20px]', textSecondary]}>
                  {pkg.description}
                </p>

                <Button variant={dark ? 'primary' : 'secondary'} href="/contact" class="w-full justify-center">Get started</Button>

                <div class="mt-[24px] flex flex-col gap-[20px]">
                  {features.map((group) => (
                    <div>
                      <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[8px]">{group.section}</p>
                      <div class="flex flex-col">
                        {group.items.map((item) => (
                          <div class:list={['flex justify-between items-center py-[8px] border-b', borderColor]}>
                            <span class:list={['text-[13px] font-normal', textPrimary]}>{item.label}</span>
                            <span class:list={['text-[13px] font-medium shrink-0 ml-[12px]',
                              item.value === true ? 'text-[#CC3333]' :
                              item.value === false ? textSecondary :
                              textPrimary
                            ]}>
                              {item.value === true ? '\u2713' : item.value === false ? '\u2014' : item.value}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Content specs -->
