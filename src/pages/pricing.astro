        </p>

        <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
          {addOnPlatforms.map((group) => (
            <div class="bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[16px]">{group.category}</p>
              <div class="flex flex-col gap-[12px]">
                {group.items.map((item) => (
                  <div class="flex justify-between items-start gap-[12px]">
                    <span class="text-[13px] text-[#1A1A1A] font-normal leading-[1.4]">{item.name}</span>
                    <span class="text-[13px] text-[#1A1A1A] font-medium leading-[1.4] shrink-0">{item.price}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </Container>
