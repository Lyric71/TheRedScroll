---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import WhoWeAre from '../components/home/WhoWeAre.astro';
import ServicesGrid from '../components/home/ServicesGrid.astro';
import DifferentiatorsSection from '../components/home/DifferentiatorsSection.astro';
import PlatformsSection from '../components/home/PlatformsSection.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import BlogPreview from '../components/home/BlogPreview.astro';
import CtaSection from '../components/home/CtaSection.astro';
---

<BaseLayout
