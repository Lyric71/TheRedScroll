---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { faqPageSchema, serviceSchema } from '../lib/schema';

const heroStats = [
  { value: 567, decimals: 0, suffix: 'M', label: 'monthly active users' },
  { value: 140, decimals: 0, suffix: '', label: 'characters before a post folds' },
  { value: 2, decimals: 0, suffix: ' weeks', label: 'from contract to first post' },
  { value: 6, decimals: 0, suffix: '', label: 'services in one scope of work' },
];

const scopeItems = [
  { label: 'Corporate account setup and Blue V verification', href: '/platforms/weibo/' },
  { label: 'Content written by native Chinese speakers', href: '/services/content-production/' },
  { label: 'Fan Headlines, Fan Tunnel, display, and search ads', href: '/services/advertising/' },
  { label: 'KOL and celebrity campaigns with verified data', href: '/services/influencer-marketing/' },
  { label: 'Hot Search and Super Topic campaigns', href: '/platforms/weibo/' },
];

const services = [
  {
    glyph: '号',
    title: 'Account setup and Blue V verification',
    tag: 'Verified in 2 to 4 weeks',
    description:
      'We register your corporate account, translate your documents into Chinese, and push verification through. Weibo charges international companies a one-time $1,000 fee. Approval takes 2 to 4 weeks. We handle all of it.',
    deliverables: ['Corporate account', 'Document translation', 'Blue V verification', 'Profile buildout'],
    image: '/images/platforms/weibo-services/account-setup.webp',
    imageAlt: 'Phone showing a verified Weibo corporate profile with a Blue V badge, next to business registration documents',
  },
  {
    glyph: '文',
    title: 'Content strategy and Chinese copywriting',
    tag: 'Native Chinese copywriters',
    description:
      'Monthly content plans, daily posts, 9-grid carousels, and short video. Written in Chinese by native speakers, not translators. Posts fold after 140 characters, so every first sentence has to earn the tap.',
    deliverables: ['Monthly content plans', 'Daily posts', '9-grid carousels', 'Short video'],
    image: '/images/platforms/weibo-services/content-strategy.webp',
    imageAlt: 'Editorial desk with a phone showing a branded Weibo post with a 9-grid photo carousel',
  },
  {
    glyph: '广',
    title: 'Weibo paid advertising',
    tag: 'Ad spend at cost, no markup',
    description:
      'Fan Headlines (粉丝头条), Fan Tunnel (粉丝通), in-feed display, splash ads, search promotion, and hashtag promotion. Targeting by demographics, interests, and behavior. Ad spend is billed at cost. No markup, ever.',
    deliverables: ['Fan Headlines', 'Fan Tunnel', 'Display and splash', 'Search promotion'],
    image: '/images/platforms/weibo-services/paid-advertising.webp',
    imageAlt: 'Hand holding a phone showing a sponsored brand post inside the Weibo public feed',
  },
  {
    glyph: '达',
    title: 'KOL and influencer campaigns',
    tag: 'Verified engagement data only',
    description:
      'Key Opinion Leader (KOL) sourcing, vetting, briefs, negotiation, and reporting. We audit real engagement and run fake-follower checks before we recommend anyone. Follower counts alone never make the shortlist.',
    deliverables: ['KOL sourcing', 'Vetting and briefs', 'Negotiation', 'Reporting'],
    image: '/images/platforms/weibo-services/kol-campaigns.webp',
    imageAlt: 'Content creator filming a product video, with a phone showing a Weibo KOL post and its engagement numbers',
  },
  {
    glyph: '评',
    title: 'Community management and customer service',
    tag: 'Daily monitoring',
    description:
      'The comment section is where Weibo actually happens. We reply to comments, answer direct messages, monitor brand mentions daily, and flag sentiment shifts before they become problems.',
    deliverables: ['Comment replies', 'Direct messages', 'Mention monitoring', 'Sentiment flags'],
    image: '/images/platforms/weibo-ecosystem/community.webp',
    imageAlt: 'Phone showing a lively Weibo comment section under a brand post, with replies from the verified account',
  },
  {
    glyph: '数',
    title: 'Analytics and monthly reporting',
    tag: 'Plain-English reporting',
    description:
      'Follower growth, engagement by format, ad results (CPM, CPC, CPA, ROAS), KOL returns, and competitive benchmarks. Every report ends with clear recommendations for next month, in plain English.',
    deliverables: ['Growth and engagement', 'Ad results', 'KOL returns', 'Competitive benchmarks'],
    image: '/images/platforms/weibo-services/analytics.webp',
    imageAlt: 'Laptop showing a Weibo performance dashboard with follower growth and engagement charts',
  },
];

const platformRows = [
  {
    platform: 'Weibo',
    href: '/platforms/weibo/',
    bestFor: 'Mass awareness, PR, trending topics',
    style: 'Public feed. Short posts, hashtags, Hot Search',
    startIf: 'You need China to learn your brand name fast',
  },
  {
    platform: 'WeChat',
    href: '/platforms/wechat/',
    bestFor: 'Retention, CRM, customer service',
    style: 'Closed circles. Long articles, Mini Programs',
    startIf: 'You already have Chinese customers to keep',
  },
  {
    platform: 'RedNote',
    href: '/platforms/rednote/',
    bestFor: 'Product discovery, reviews, lifestyle',
    style: 'Search-driven. Photo and video notes',
    startIf: 'You sell products people research before buying',
  },
  {
    platform: 'Douyin',
    href: '/platforms/douyin/',
    bestFor: 'Short video reach, live commerce',
    style: 'Algorithm feed. Entertaining short video',
    startIf: 'You can produce video that competes for attention',
  },
];

const segments = [
  {
    title: 'Luxury and consumer brands',
    description: 'Chinese consumers search brand names on Weibo before they buy. A strong verified presence builds trust. No presence raises red flags.',
    icon: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
  },
  {
    title: 'Tourism and education',
    description: 'Chinese travelers and students research destinations and schools on Weibo months before they commit. We keep your brand in that conversation.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'F&B and e-commerce',
    description: 'Shoppable posts link to Tmall and Taobao. Live streams sync with Taobao Live. The distance between a Weibo post and a purchase is short.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Consumer tech and B2B',
    description: 'Product launches, PR amplification, and reputation management. When you need millions of people to learn your name fast, Weibo is the channel.',
    icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>',
  },
];

const pillars = [
  {
    title: 'Clear SOW',
    description: 'Every deliverable is defined upfront. Posts, videos, campaigns, reports. You know exactly what you get each month.',
  },
  {
    title: 'Fixed price, no surprises',
    description: 'One price per package. No hourly rates, no scope creep charges, no invoices you weren\'t expecting.',
  },
  {
    title: 'AI-powered content production',
    description: 'Visuals and video powered by HubStudio.ai, which keeps costs down and output fast. Strategy is 100% human-led.',
  },
  {
    title: 'Team on the ground',
    description: 'Shanghai and Hong Kong. Native speakers who check the Hot Search list every morning, with direct KOL relationships.',
  },
];

const steps = [
  {
    title: 'Audit and strategy',
    description: 'Week 1. We review your brand, your competitors on Weibo, and your goals. You get a content strategy and a clear scope of work.',
  },
  {
    title: 'Account setup and verification',
    description: 'Weeks 1 to 4. We register the account and submit Blue V verification. We don\'t wait for the badge. Profile buildout starts immediately.',
  },
  {
    title: 'Content calendar',
    description: 'Week 2. First month of posts planned, written, and designed. You review everything before it goes live.',
  },
  {
    title: 'Launch',
    description: 'Week 2. First posts published, first campaign running. Fourteen days from signed contract to first post.',
  },
  {
    title: 'Optimize',
    description: 'Ongoing. We track what works by format and topic, react to trends within the hour, and adjust ad bids weekly.',
  },
  {
    title: 'Report',
    description: 'Monthly. Growth, engagement, ad results, KOL returns, and benchmarks. Plus a mid-month check-in during active campaigns.',
  },
];

const caseStudies = [
  {
    client: 'JAC Motors',
    image: '/images/clients/JAC/JAC-Wechat-4.webp',
    imageAlt: 'JAC Motors social media content produced by TheRedScroll',
    metric: '10M',
    metricLabel: 'vehicles sold, community rebuilt',
    summary: 'A Chinese auto giant with 10 million vehicles sold and a quiet social presence. We rebuilt the community across Weibo, WeChat, and RedNote with AI-powered content.',
    href: '/work/jac-motors/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Mission Foods campaign visual for the China launch',
    metric: 'Gen Z',
    metricLabel: 'campaigns for a new food category',
    summary: 'Launching corn chips, an unfamiliar food category, in China. Gen Z campaigns and food pairing content across Weibo, WeChat, and RedNote.',
    href: '/work/mission-foods/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Camper footwear campaign visual for China social media',
    metric: '187K',
    metricLabel: 'followers, up from 43K in 18 months',
    summary: 'A European footwear brand that grew from 43K to 187K followers in 18 months, with engagement up from 1.2% to 4.7% and same-store sales up 31% year over year.',
    href: '/work/camper/',
  },
];

const faqs = [
  {
    q: 'How much does a Weibo agency cost?',
    a: 'Two budgets matter. Agency work: we quote a fixed monthly price against a clear scope of work, so you see every deliverable and the full cost before you sign. We analyzed 37 China marketing agencies in April 2026 and 0 out of 37 offer fixed-price packages. We do. Ad spend: paid to Weibo separately and billed at cost, with no markup. Fan Headlines are the low-cost entry point, while Hot Search placements sit at the premium end.',
  },
  {
    q: 'Can a foreign company open a Weibo account?',
    a: 'Yes, and we do this regularly. Foreign companies can get a verified corporate account with a Blue V badge. You need business registration documents translated into Chinese and a one-time $1,000 verification fee paid to Weibo. We prepare the documents, handle the translation, and deal with Weibo\'s verification team so you don\'t have to.',
  },
  {
    q: 'How long does Weibo verification take?',
    a: 'About 2 to 4 weeks with complete documents. Missing or inconsistent paperwork is the most common cause of delays, so we review everything before submission. We don\'t sit around waiting either. Profile buildout and content production start while the Blue V badge is being processed.',
  },
  {
    q: 'Do I need a Chinese business license for Weibo?',
    a: 'No. An overseas business registration is enough for a verified corporate account. You don\'t need a Chinese entity, a Chinese bank account, or an ICP license to run a Weibo account. A Chinese entity only becomes relevant later, for things like domestic e-commerce integrations. Our China market entry service covers that path when you\'re ready.',
  },
  {
    q: 'Weibo vs WeChat: which should I start with?',
    a: 'It depends on your goal. Weibo is China\'s open public square: 567 million monthly users, trending topics, and posts anyone can see. It builds awareness fast. WeChat is closed: content circulates inside private circles, which makes it better for retention and CRM. Brands entering China usually start with Weibo for reach, then add WeChat once there\'s an audience worth keeping. Most of our clients run both.',
  },
  {
    q: 'How do you measure Weibo campaign success?',
    a: 'Against the goals we set in your scope of work. Monthly reports cover follower growth, engagement rates, content performance by format, ad campaign results (CPM, CPC, CPA, ROAS), KOL campaign returns, and competitive benchmarks. Every report ends with specific recommendations for the following month. You also get a mid-month check-in during active campaigns.',
  },
  {
    q: 'What ad formats does Weibo offer?',
    a: 'The main ones are Fan Headlines to boost posts, Fan Tunnel for interest-based targeting beyond your followers, display placements, and Hot Search or topic placements at the premium end. We match the format to the goal: Fan Tunnel for growth, Hot Search for launches. All ad spend is billed at cost.',
  },
  {
    q: 'How do KOL campaigns work on Weibo?',
    a: 'Bookings run through Weibo\'s official channels, so audience and engagement data is verified before any money moves. Weibo suits celebrity and top-tier KOL moments that put a brand into public conversation, backed by vertical KOLs for credibility. We handle selection, briefing, contracts, and per-post reporting.',
  },
  {
    q: 'Is Weibo still relevant for brands in 2026?',
    a: 'Yes. Weibo is where China\'s public conversation happens: 567 million monthly users, trending topics, and open comment threads that media report on. Launches, brand announcements, and celebrity campaigns still break on Weibo first. It will not replace a sales channel, but for visibility and credibility it has no substitute.',
  },
  {
    q: 'What happens if we get negative comments on Weibo?',
    a: 'We watch for it daily. Community management includes comment moderation, a response playbook agreed with you upfront, and same-day escalation when something could spread. Most issues fade when a brand answers fast and in the right tone. For a real crisis, we put a response plan in front of you within hours.',
  },
];

const pageSchemas = [
  serviceSchema({
    name: 'Weibo Agency Services',
    description:
      'Full-service Weibo agency for international brands: corporate account setup and Blue V verification, content, paid advertising, KOL campaigns, and reporting.',
    url: '/weibo-agency',
    serviceType: 'Social Media Marketing',
  }),
  faqPageSchema(faqs),
];
---

<PageLayout
  title="Weibo Agency for Brands Entering China | TheRedScroll"
  description="A full-service Weibo agency in Shanghai and Hong Kong. Blue V setup, content, ads, and KOL campaigns for brands entering China. Fixed scope, fixed price."
  schema={pageSchemas}
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      微博
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">博</span>
            <img src="/images/platforms/weibo-logo.svg" alt="" width="22" height="22" class="block" aria-hidden="true" />
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Weibo agency</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            The Weibo agency for brands entering China
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Account setup, Blue V verification, content, advertising, and KOL campaigns. Run from Shanghai and Hong Kong, every day. Fixed scope. Fixed price.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/contact/">Book a call</Button>
            <Button variant="secondary-dark" href="#results">See the results</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            A 30-minute call. No pitch deck.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/weibo-agency/hero-phones-blend.webp"
            alt="Two phones showing the real Weibo app: the public feed and the Hot Search trending list"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Why Weibo matters
          </p>
          <p class="manifesto" data-manifesto>
            Weibo is China's public square. 567 million people watch what trends there every month. Reputations are made in hours. If your brand is not part of the conversation, someone else is <span class="manifesto-hl">writing it</span> for you.
          </p>
        </div>
        <div>
          <img
            src="/images/weibo-agency/ecosystem-banner-tight.webp"
            alt="Three phones showing the three sides of Weibo: the public feed, the Hot Search list, and a verified brand profile"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            One app, three jobs: public feed, trending topics, and brand reputation.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            One agency for the whole Weibo playbook
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Weibo has 567 million monthly active users and 252 million daily active users (May 2026). It's where trends start, news breaks, and Chinese consumers research brands before they buy.
            </p>
            <p>
              A Weibo agency registers and verifies your corporate account, writes your content in Chinese, buys your ads, and runs your KOL campaigns. Doing this in-house means hiring native speakers, learning the Hot Search rhythm, and navigating verification paperwork. Most brands get further, faster, with a specialist.
            </p>
            <p>
              We're that specialist. We post on <a href="/platforms/weibo/" class="text-[#CC3333] hover:underline">Weibo</a> every day, from inside China.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Scope at a glance
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Our Weibo marketing services</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Six services. Each with a clear deliverable.
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Everything is listed in your scope of work before you sign. No vague retainers.
              </p>
            </div>
            <div class="svc-frame relative max-[900px]:hidden">
              <div class="relative w-full aspect-[1344/570] rounded-[10px] overflow-hidden bg-[#FFFFFF]">
                {services.map((service, i) => (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="1344"
                    height="570"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class:list={['svc-img absolute inset-0 w-full h-full object-cover', i === 0 && 'is-active']}
                    data-svc-img={i}
                  />
                ))}
              </div>
            </div>
            <div class="flex items-center gap-[16px] mt-[24px] max-[900px]:hidden">
              <div class="flex gap-[6px] grow" aria-hidden="true">
                {services.map((_, i) => (
                  <span class:list={['svc-tick', i === 0 && 'is-active']} data-svc-tick={i}></span>
                ))}
              </div>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-none m-0 shrink-0" data-svc-caption aria-hidden="true">{services[0].title}</p>
            </div>
          </div>
        </div>

        <!-- Scrolling step cards -->
        <div class="flex flex-col gap-[16px]">
          {services.map((service, i) => (
            <div class:list={['svc-step bg-[#FFFFFF] rounded-[10px] p-[32px] max-[640px]:p-[20px]', i === 0 && 'is-active']} data-svc-step={i}>
              <div class="flex items-center gap-[12px] mb-[16px]">
                <span class="svc-seal" aria-hidden="true">{service.glyph}</span>
                <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">{service.tag}</span>
              </div>
              <h3 class="text-[22px] max-[640px]:text-[19px] font-medium leading-[1.25] text-[#1A1A1A] mb-[10px]">{service.title}</h3>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.65] max-w-[480px] mb-[16px]">{service.description}</p>
              <ul class="flex flex-wrap gap-[8px] list-none m-0 p-0" aria-label={`${service.title}: deliverables`}>
                {service.deliverables.map((d) => (
                  <li class="text-[12px] font-normal leading-none text-[#1A1A1A] bg-[#F7F2EE] border-[0.5px] border-[#E8E0D8] rounded-[6px] px-[10px] py-[7px]">{d}</li>
                ))}
              </ul>
              <img
                src={service.image}
                alt={service.imageAlt}
                width="1344"
                height="570"
                loading="lazy"
                class="hidden max-[900px]:block w-full h-auto rounded-[8px] mt-[16px]"
