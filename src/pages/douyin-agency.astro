---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { faqPageSchema, serviceSchema } from '../lib/schema';

const heroStats = [
  { value: 750, decimals: 0, suffix: 'M', label: 'daily active users' },
  { value: 120, decimals: 0, suffix: ' min', label: 'average time in app per day' },
  { value: 3.5, decimals: 1, suffix: 'T', label: 'RMB in yearly e-commerce sales' },
  { value: 2, decimals: 0, suffix: ' weeks', label: 'from signing to first content live' },
];

const scopeItems = [
  { label: 'Account setup and blue V verification', href: '/platforms/douyin/' },
  { label: 'Mandarin-native short video production', href: '/services/content-production/' },
  { label: 'KOL and KOC campaigns via Xingtu', href: '/services/influencer-marketing/' },
  { label: 'Ocean Engine advertising', href: '/services/advertising/' },
  { label: 'Livestream commerce and Douyin Shop', href: '/platforms/douyin/' },
];

const services = [
  {
    glyph: '号',
    title: 'Account setup and verification',
    tag: 'Live and verified',
    description:
      'We register and verify your enterprise account, including blue V verification. Foreign companies need a Chinese business license or an authorized agency. We handle both paths, so you can start without a local entity.',
    deliverables: ['Enterprise account', 'Blue V verification', 'License path advice', 'Account handover'],
    image: '/images/platforms/douyin-services/setup-strategy.webp',
    imageAlt: 'Phone showing a verified Douyin enterprise account profile next to registration documents',
  },
  {
    glyph: '视',
    title: 'Content strategy and video production',
    tag: 'Mandarin-native video',
    description:
      'Douyin-native short video produced by our team in China. Product demos, tutorials, trend formats, and mini-dramas. HubStudio.ai speeds up production. Native Mandarin speakers write and edit every piece.',
    deliverables: ['Content strategy', 'Short video production', 'Trend formats', 'Mini-dramas'],
    image: '/images/platforms/douyin-services/content-production.webp',
    imageAlt: 'Editing desk with a phone showing a vertical Douyin short video in production',
  },
  {
    glyph: '达',
    title: 'KOL and KOC campaigns',
    tag: 'Verified creators via Xingtu',
    description:
      'KOL (Key Opinion Leader) and KOC (Key Opinion Consumer) campaigns sourced through Xingtu, Douyin\'s official creator marketplace, plus our own network. Every creator is vetted for fake followers and audience fit. You approve the final list.',
    deliverables: ['KOL sourcing', 'KOC seeding', 'Fake-follower checks', 'Campaign reporting'],
    image: '/images/platforms/douyin-services/kol-campaigns.webp',
    imageAlt: 'Content creator filming a product video for a Douyin KOL campaign',
  },
  {
    glyph: '广',
    title: 'Paid advertising via Ocean Engine',
    tag: 'Ad spend at cost, no markup',
    description:
      'Ocean Engine (巨量引擎) is ByteDance\'s ad platform for Douyin. TopView for launches. In-Feed Ads for traffic. Search Ads for high-intent buyers. DOU+ for testing content. Ad spend is billed at cost, no markups.',
    deliverables: ['TopView', 'In-Feed Ads', 'Search Ads', 'DOU+ boosts'],
    image: '/images/platforms/douyin-services/advertising.webp',
    imageAlt: 'Phone showing a sponsored in-feed brand ad inside the Douyin video feed',
  },
  {
    glyph: '播',
    title: 'Livestream and Douyin Shop',
    tag: 'Live commerce built in',
    description:
      'Live commerce is built into Douyin. We plan and run live selling sessions: host selection, product scripting, real-time engagement. We also set up and optimize your Douyin Shop (抖音小店) storefront.',
    deliverables: ['Livestream planning', 'Host selection', 'Product scripting', 'Douyin Shop setup'],
    image: '/images/platforms/douyin-services/live-commerce.webp',
    imageAlt: 'Host presenting products on camera during a Douyin livestream selling session',
  },
  {
    glyph: '数',
    title: 'Analytics, reporting, and optimization',
    tag: 'One report a month',
    description:
      'Monthly reports with clear numbers. Follower growth, views, engagement rate, ad efficiency, GMV, and ROAS where commerce is live. What worked, what didn\'t, and what changes next month.',
    deliverables: ['Follower growth', 'Engagement rate', 'GMV and ROAS', 'Next-month plan'],
    image: '/images/blog/douyin-control-room.webp',
    imageAlt: 'Control room screens tracking Douyin follower growth, engagement, and sales numbers',
  },
];

const segments = [
  {
    title: 'Beauty and fashion',
    description: 'Beauty and fashion perform on Douyin. Short demos, tutorials, and creator reviews drive discovery, and checkout is built into the app.',
    icon: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  },
  {
    title: 'Food and beverage',
    description: 'Food performs on Douyin. Quick demos and taste-test formats turn viewers into first-time buyers, in the feed and in livestreams.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Consumer electronics and home',
    description: 'Consumer electronics and home goods perform on Douyin. Product demos show value in seconds, which is what the algorithm rewards.',
    icon: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  },
  {
    title: 'Hospitality, automotive, and B2B',
    description: 'Hospitality, automotive, health, and B2B all perform on Douyin. First-tier city or fifth, age 22 or 52, your Chinese audience is already there.',
    icon: '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>',
  },
];

const pillars = [
  {
    title: 'Team on the ground',
    description: 'Shanghai and Hong Kong. Native Mandarin speakers who post on Douyin every day, not consultants who read about it.',
  },
  {
    title: 'Fixed scope, fixed price',
    description: 'We benchmarked 37 agencies in April 2026. 0 out of 37 offer fixed-price packages. We do. Every deliverable is defined upfront.',
  },
  {
    title: 'English-language account management',
    description: 'One dedicated account manager who knows your brand. You get clear communication in English and content in native Mandarin.',
  },
  {
    title: 'Compliance handled',
    description: 'Business license paths, account verification, content rules, and ad review. We deal with the paperwork so your campaigns don\'t stall.',
  },
];

const steps = [
  {
    title: 'Audit',
    description:
      'We review your category on Douyin. Competitors, content formats, price points, and what the algorithm rewards in your vertical right now.',
  },
  {
    title: 'Strategy',
    description:
      'Content pillars, posting schedule, KOL shortlist, ad plan, and KPI targets. Everything written into a clear SOW (Scope of Work) with a fixed price.',
  },
  {
    title: 'Localization',
    description:
      'Nothing gets translated. Our Mandarin-native team creates your content from scratch for Chinese viewers. Translated content underperforms badly on Douyin.',
  },
  {
    title: 'Launch',
    description:
      'Account verified, first content live within 2 weeks of signing. Your account manager works with you in English. No Chinese language skills needed on your side.',
  },
  {
    title: 'Scale',
    description:
      'We double down on what performs. Winning formats get more budget through DOU+ and Ocean Engine. Underperformers get cut. Monthly reports track it all.',
  },
];

const caseStudies = [
  {
    client: "AGE 20's",
    image: '/images/clients/Age20/Age20-Picture1-scaled.jpg',
    imageAlt: "AGE 20's campaign visual for the foundation launch in China",
    metric: '3.87M',
    metricLabel: 'Douyin impressions against a 1M target',
    summary: 'Korean beauty brand launching a foundation in China. The campaign hit 3.87 million Douyin impressions against a 1 million target, with a product nickname that went organic.',
    href: '/work/age20s/',
  },
  {
    client: 'Langnese',
    image: '/images/clients/Langnese/Langnese-Douyin-Livestream.jpg',
    imageAlt: 'Langnese honey presented during a Douyin livestream selling session',
    metric: 'Live',
    metricLabel: 'livestream commerce for a heritage brand',
    summary: 'German honey brand repositioned for Chinese consumers. Douyin livestreams and quick-demo videos changed how people use the product, connected to Tmall sales.',
    href: '/work/langnese/',
  },
];

const faqs = [
  {
    q: 'Can foreign companies advertise on Douyin?',
    a: 'Yes. Foreign brands advertise on Douyin through an authorized agency like TheRedScroll. We open the account, run the ads through Ocean Engine, and bill ad spend at cost. No local incorporation needed.',
  },
  {
    q: 'Do I need a Chinese business license or a WFOE?',
    a: 'Not to start. Enterprise accounts need a Chinese business license or an authorized agency, and we cover the agency path. For selling through Douyin Shop, cross-border options exist for brands without a Chinese entity. We recommend the right setup on the first call.',
  },
  {
    q: 'How much does a Douyin agency cost?',
    a: 'Most agencies quote custom prices with unclear deliverables. We work with fixed-price packages that list every deliverable upfront. Ad spend on Ocean Engine is billed separately, at cost, with no markups. Book a call and we\'ll recommend a fit for your budget.',
  },
  {
    q: 'How is Douyin different from TikTok for advertisers?',
    a: 'They are separate apps run by ByteDance with zero content crossover. Douyin serves mainland China and runs on Ocean Engine, its own ad platform. In-app commerce is far deeper on Douyin: shops, livestream selling, and checkout without leaving the app. A TikTok strategy does not transfer.',
  },
  {
    q: 'How long until we see results?',
    a: 'Paid campaigns can show results within days. Organic traction usually takes 8 to 12 weeks of consistent posting. The algorithm rewards watch-through rate and consistency, so 3 to 5 posts per week is the minimum we run.',
  },
  {
    q: 'Can we reuse our TikTok videos on Douyin?',
    a: 'Usually not. Douyin detects watermarked re-uploads and buries them. Viewers expect Mandarin speech, local trends, and local formats. We sometimes adapt a strong concept, but the video itself gets remade natively for Chinese viewers.',
  },
  {
    q: 'How do KOL campaigns work on Douyin?',
    a: 'We book creators through Xingtu, the official ByteDance platform, so every booking has verified audience and engagement data. We shortlist by fit and performance, not follower count. Briefing, contracts, payment, and usage rights all run through us. A layer of smaller KOCs often outperforms one big name.',
  },
  {
    q: 'How does Douyin Shop work for overseas brands?',
    a: 'Douyin runs a cross-border program for brands without a Chinese entity. You sell through a cross-border store and ship from a bonded warehouse or from overseas. Categories, deposits, and document requirements vary, so we confirm eligibility before setup. Livestreams and short videos then link straight to checkout.',
  },
  {
    q: 'Do we need Chinese speakers on our team?',
    a: 'No. Your account manager works with you in English: strategy, approvals, and reporting. Our Mandarin-native team handles everything China-facing, from scripts and captions to comment replies. You approve English summaries, not raw Chinese documents.',
  },
  {
    q: 'How do you measure Douyin campaign success?',
    a: 'Against the goals in your scope of work. Monthly reports cover views, watch-through rate, follower growth, engagement, Ocean Engine ad results, and livestream sales where relevant. Every report ends with recommendations for the next month. Underperforming formats get cut, not defended.',
  },
];

const pageSchemas = [
  serviceSchema({
    name: 'Douyin Agency Services',
    description:
      'Douyin agency for global brands entering China. Account setup and verification, short-video content production, KOL and KOC campaigns, Ocean Engine advertising, livestream commerce, and Douyin Shop.',
    url: '/douyin-agency',
    serviceType: 'Social Media Marketing',
  }),
  faqPageSchema(faqs),
];
---

<PageLayout
  title="Douyin Agency for Global Brands | TheRedScroll"
  description="Full-service Douyin agency for global brands: account setup, content, KOL campaigns, Ocean Engine ads, and livestream commerce. Book a call."
  schema={pageSchemas}
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      抖音
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">抖</span>
            <img src="/images/platforms/douyin-logo.svg" alt="" width="22" height="22" class="block" aria-hidden="true" />
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Douyin agency</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            Douyin agency: grow your brand on China's #1 short-video platform
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Account setup, content, KOL campaigns, Ocean Engine ads, and livestream commerce. Run by our team in Shanghai and Hong Kong. Fixed scope, fixed price.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/contact/">Book a call</Button>
            <Button variant="secondary-dark" href="#results">See the results</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            A 30-minute call. No pitch deck.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/douyin-agency/hero-phones-blend.webp"
            alt="Two phones showing real Douyin screens: a vertical short-video feed with a product card, and a livestream selling session"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Why Douyin matters
          </p>
          <p class="manifesto" data-manifesto>
            Douyin is not TikTok. It is China's short-video economy. 750 million people watch, shop, and check out without ever leaving the app. If your brand is not in the feed, your <span class="manifesto-hl">competitor</span> is.
          </p>
        </div>
        <div>
          <img
            src="/images/douyin-agency/ecosystem-banner-tight.webp"
            alt="Three phones showing the three sides of Douyin: the video feed, a livestream selling session, and a Douyin Shop product page"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            One app, three jobs: entertainment feed, livestream channel, and checkout.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Douyin agency services for brands entering China
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Douyin (抖音) reaches 750 million people in China every day. Your customers are on it. Your competitors may already be too.
            </p>
            <p>
              TheRedScroll is a China-based social media agency. We open Douyin accounts for foreign brands, produce Mandarin-native video, run KOL campaigns, buy ads through Ocean Engine, and sell through livestreams and Douyin Shop.
            </p>
            <p>
              Every engagement has a clear SOW and a fixed price. You know what you get and what it costs before you sign.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Scope at a glance
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Our Douyin agency services</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Six services. Each with a clear deliverable.
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Everything is listed in your scope of work before you sign. No vague retainers.
              </p>
            </div>
            <div class="svc-frame relative max-[900px]:hidden">
              <div class="relative w-full aspect-[1344/570] rounded-[10px] overflow-hidden bg-[#FFFFFF]">
                {services.map((service, i) => (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="1344"
                    height="570"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class:list={['svc-img absolute inset-0 w-full h-full object-cover', i === 0 && 'is-active']}
                    data-svc-img={i}
                  />
                ))}
              </div>
            </div>
            <div class="flex items-center gap-[16px] mt-[24px] max-[900px]:hidden">
              <div class="flex gap-[6px] grow" aria-hidden="true">
                {services.map((_, i) => (
                  <span class:list={['svc-tick', i === 0 && 'is-active']} data-svc-tick={i}></span>
                ))}
              </div>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-none m-0 shrink-0" data-svc-caption aria-hidden="true">{services[0].title}</p>
            </div>
          </div>
        </div>

        <!-- Scrolling step cards -->
        <div class="flex flex-col gap-[16px]">
          {services.map((service, i) => (
            <div class:list={['svc-step bg-[#FFFFFF] rounded-[10px] p-[32px] max-[640px]:p-[20px]', i === 0 && 'is-active']} data-svc-step={i}>
              <div class="flex items-center gap-[12px] mb-[16px]">
                <span class="svc-seal" aria-hidden="true">{service.glyph}</span>
                <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">{service.tag}</span>
              </div>
              <h3 class="text-[22px] max-[640px]:text-[19px] font-medium leading-[1.25] text-[#1A1A1A] mb-[10px]">{service.title}</h3>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.65] max-w-[480px] mb-[16px]">{service.description}</p>
              <ul class="flex flex-wrap gap-[8px] list-none m-0 p-0" aria-label={`${service.title}: deliverables`}>
                {service.deliverables.map((d) => (
                  <li class="text-[12px] font-normal leading-none text-[#1A1A1A] bg-[#F7F2EE] border-[0.5px] border-[#E8E0D8] rounded-[6px] px-[10px] py-[7px]">{d}</li>
                ))}
              </ul>
              <img
                src={service.image}
                alt={service.imageAlt}
                width="1344"
                height="570"
                loading="lazy"
                class="hidden max-[900px]:block w-full h-auto rounded-[8px] mt-[16px]"
              />
            </div>
          ))}
          <div class="py-[16px] flex items-center justify-between gap-[16px] flex-wrap" data-reveal>
            <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] m-0 max-w-[420px]">
              <span class="text-[#1A1A1A] font-medium">Need more than Douyin?</span> Most of our clients pair it with RedNote and WeChat.
            </p>
            <a href="/platforms/others/" class="text-[14px] text-[#CC3333] font-medium shrink-0 hover:underline">All platforms &rarr;</a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ CASE STUDIES ============ -->
  <section id="results" class="mt-[128px] max-[640px]:mt-[72px] scroll-mt-[80px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[40px] max-[640px]:mb-[24px]" data-reveal>
        <div class="max-w-[560px]">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Case studies</p>
          <h2 class="text-[36px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[8px]">
            Results from the ground
          </h2>
