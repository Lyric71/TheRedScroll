    socialListening: false,
    support: {
      accountManager: true,
      chatSupport: true,
      monthlyReport: true,
      strategyCalls: '每周1次',
    },
  },
  {
    name: 'Lead',
    price: '¥46,000',
    description: '全平台高频发布，舆情实时盯，突发情况随叫随到。',
