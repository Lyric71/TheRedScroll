---

<BaseLayout
  title="价格方案 | TheRedScroll"
  description="透明定价，固定费率。WeChat、Douyin、RedNote、Weibo中国社交媒体营销服务。起步价¥25,600/月。"
  lang="zh"
>
  <main class="pt-[60px] max-[640px]:pt-[52px]">

    <!-- Hero -->
    <section class="relative w-full bg-[#1A1A1A] rounded-none overflow-hidden py-[80px] max-[640px]:py-[48px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/pricing-bg.png')" aria-hidden="true"></div>
      <div class="relative z-[1] max-w-[800px] mx-auto text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">价格方案</p>
        <h1 class="text-[#FFFFFF] text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] mb-[8px]">
          清晰框架，固定价格，没有意外。
        </h1>
        <p class="text-[rgba(255,255,255,0.6)] text-[16px] font-normal leading-[1.6]">
          价格以人民币计，不含税。所有方案最低签约6个月。
        </p>
      </div>
    </section>

    <!-- Core Packages Comparison Table -->
    <section class="mt-[96px] max-[640px]:mt-[64px]">
      <Container>
        <div class="text-center mb-[48px]">
          <div class="flex justify-center mb-[12px]"><SectionBar /></div>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A]">服务方案</h2>
        </div>

        <!-- Desktop comparison table -->
        <div class="max-[640px]:hidden overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="w-[280px] p-[16px] align-bottom"></th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tl-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Launch</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">¥25,600<span class="text-[14px] text-[#5C5C5C] font-normal">/月</span></p>
                  <Button variant="secondary" href="/zh/contact" class="mt-[16px] w-full justify-center text-[13px]">立即开始</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] relative border-x-[3px] border-[#CC3333]">
                  <div class="absolute top-0 left-[-3px] right-[-3px] h-[3px] bg-[#CC3333]"></div>
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">热门之选</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">¥37,600<span class="text-[14px] text-[#5C5C5C] font-normal">/月</span></p>
                  <Button variant="primary" href="/zh/contact" class="mt-[16px] w-full justify-center text-[13px]">立即开始</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tr-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Command</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">¥46,100<span class="text-[14px] text-[#5C5C5C] font-normal">/月</span></p>
                  <Button variant="secondary" href="/zh/contact" class="mt-[16px] w-full justify-center text-[13px]">立即开始</Button>
                </th>
              </tr>
            </thead>
            <tbody>
              <!-- Section: Strategy & Setup -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">策略与部署</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">竞品分析</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">第1个月</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">第1个月</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">第1个月</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">内容策略与选题方向</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">月度编辑日历</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">账号开设与配置</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">按需开通</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">按需开通</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">按需开通</td>
              </tr>

              <!-- Section: Content -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">内容</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">WeChat</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1篇文章/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1篇文章/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1篇文章/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Weibo</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">7条/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">RedNote (小红书)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">5条/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin（客户提供视频）</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1条视频/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1条视频/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2条视频/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin（AI视频，15秒以内）</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">1条视频/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2条视频/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)] bg-[#F0F1F4]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium">Douyin 合计</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center">1条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">2条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">4条/周</td>
              </tr>

              <!-- Section: AI Production -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">AI制作</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">通过HubStudio.ai生成AI视频</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">拍摄前创意简报确认</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Social Listening -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">舆情监控</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">品牌提及追踪</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">竞品动态监测</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">月度口碑分析报告</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Support & Reporting -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">支持与报告</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">专属客户经理</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">在线消息支持（周一至周五）</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">月度绩效报告</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">策略沟通会</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">每月1次</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">每周一次</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">随时沟通</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Mobile: stacked cards with full features (shown only on mobile) -->
        <div class="hidden max-[640px]:flex flex-col gap-[16px]">
          {packages.map((pkg) => {
            const dark = pkg.highlighted;
            const textPrimary = dark ? 'text-[#FFFFFF]' : 'text-[#1A1A1A]';
            const textSecondary = dark ? 'text-[rgba(255,255,255,0.6)]' : 'text-[#5C5C5C]';
            const borderColor = dark ? 'border-[rgba(255,255,255,0.1)]' : 'border-[rgba(0,0,0,0.06)]';

            const features = [
              { section: '策略与部署', items: [
                { label: '竞品分析', value: pkg.strategy.competitor },
                { label: '内容策略与选题方向', value: pkg.strategy.contentStrategy },
                { label: '月度编辑日历', value: pkg.strategy.editorialCalendar },
                { label: '账号开设与配置', value: pkg.strategy.accountOpening },
              ]},
              { section: '内容', items: [
                { label: 'WeChat', value: pkg.content.wechat },
                { label: 'Weibo', value: pkg.content.weibo },
                { label: 'RedNote (小红书)', value: pkg.content.rednote },
                { label: 'Douyin（客户提供视频）', value: pkg.content.douyinClient },
                { label: 'Douyin（AI视频）', value: pkg.content.douyinAi },
                { label: 'Douyin 合计', value: pkg.content.douyinTotal },
              ]},
              { section: 'AI制作', items: [
                { label: '通过HubStudio.ai生成AI视频', value: pkg.ai },
                { label: '拍摄前创意简报确认', value: pkg.ai },
              ]},
              { section: '舆情监控', items: [
                { label: '品牌提及追踪', value: pkg.socialListening },
                { label: '竞品动态监测', value: pkg.socialListening },
                { label: '月度口碑分析报告', value: pkg.socialListening },
              ]},
              { section: '支持与报告', items: [
                { label: '专属客户经理', value: pkg.support.accountManager },
                { label: '在线消息支持（周一至周五）', value: pkg.support.chatSupport },
                { label: '月度绩效报告', value: pkg.support.monthlyReport },
                { label: '策略沟通会', value: pkg.support.strategyCalls },
              ]},
            ];

            return (
              <div class:list={[
                'rounded-[12px] p-[24px]',
                dark ? 'bg-[#1A1A1A]' : 'bg-[#F0F1F4]'
              ]}>
                <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">
                  {dark ? '热门之选' : pkg.name}
                </p>
                {dark && <p class="text-[14px] font-medium text-[#FFFFFF] mb-[2px]">{pkg.name}</p>}
                <p class:list={['text-[28px] font-medium leading-[1.2] mb-[4px]', textPrimary]}>
                  {pkg.price}<span class:list={['text-[14px] font-normal', textSecondary]}>/月</span>
                </p>
                <p class:list={['text-[13px] font-normal leading-[1.5] mb-[20px]', textSecondary]}>
                  {pkg.description}
                </p>

                <Button variant={dark ? 'primary' : 'secondary'} href="/zh/contact" class="w-full justify-center">立即开始</Button>

                <div class="mt-[24px] flex flex-col gap-[20px]">
                  {features.map((group) => (
                    <div>
                      <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[8px]">{group.section}</p>
                      <div class="flex flex-col">
                        {group.items.map((item) => (
                          <div class:list={['flex justify-between items-center py-[8px] border-b', borderColor]}>
                            <span class:list={['text-[13px] font-normal', textPrimary]}>{item.label}</span>
                            <span class:list={['text-[13px] font-medium shrink-0 ml-[12px]',
                              item.value === true ? 'text-[#CC3333]' :
                              item.value === false ? textSecondary :
                              textPrimary
                            ]}>
                              {item.value === true ? '\u2713' : item.value === false ? '\u2014' : item.value}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Content specs -->
        <div class="mt-[48px] max-w-[680px]">
          <h3 class="text-[18px] text-[#1A1A1A] font-medium leading-[1.3] mb-[16px]">内容规格说明</h3>
