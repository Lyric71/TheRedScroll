    <!-- Content Production -->
    <section class="mt-[96px] max-[640px]:mt-[64px]">
      <Container>
        <div class="bg-[#CC3333] rounded-[12px] p-[48px] max-[640px]:p-[20px] flex items-center justify-between max-[640px]:flex-col max-[640px]:items-start gap-[32px]">
          <div class="max-w-[560px]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[rgba(255,255,255,0.7)] mb-[8px]">内容制作</p>
            <h3 class="text-[22px] max-[640px]:text-[18px] font-medium leading-[1.25] text-[#FFFFFF] mb-[8px]">
              本地摄影、视频拍摄。
            </h3>
            <p class="text-[14px] text-[rgba(255,255,255,0.8)] font-normal leading-[1.6]">
              产品图、品牌片、达人联拍。报价根据项目范围、拍摄地、团队配置、交付物而定。brief确认后2到3周出片。
            </p>
          </div>
          <a href="/zh/contact" class="inline-flex items-center justify-center h-[44px] px-[28px] text-[14px] font-medium leading-none rounded-[6px] cursor-pointer bg-[#FFFFFF] text-[#1A1A1A] shrink-0 transition-[background] duration-150 hover:bg-[#F0F1F4] active:scale-[0.98]">
            索取报价 &rarr;
