---

<BaseLayout
  title="价格方案 | TheRedScroll"
  description="价格全摆明面。微信、抖音、小红书、微博一站打理。起步¥25,000/月。"
  lang="zh"
>
  <main class="pt-[60px] max-[640px]:pt-[52px]">

    <!-- Hero -->
    <section class="relative w-full bg-[#1A1A1A] rounded-none overflow-hidden py-[80px] max-[640px]:py-[48px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/pricing-bg.png')" aria-hidden="true"></div>
      <div class="relative z-[1] max-w-[800px] mx-auto text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">价格方案</p>
        <h1 class="text-[#FFFFFF] text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] mb-[8px]">
          范围写明白，一口价，不藏猫腻。
        </h1>
        <p class="text-[rgba(255,255,255,0.6)] text-[16px] font-normal leading-[1.6]">
          报价人民币、税前。所有方案最低签6个月。
        </p>
      </div>
    </section>

    <!-- Core Packages Comparison Table -->
    <section class="mt-[96px] max-[640px]:mt-[64px]">
      <Container>
        <div class="text-center mb-[48px]">
          <div class="flex justify-center mb-[12px]"><SectionBar /></div>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A]">三档方案</h2>
        </div>

        <!-- Desktop comparison table -->
        <div class="max-[640px]:hidden overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="w-[280px] p-[16px] align-bottom"></th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tl-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Start</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">¥25,000<span class="text-[14px] text-[#5C5C5C] font-normal">/月</span></p>
                  <Button variant="secondary" href="/zh/contact" class="mt-[16px] w-full justify-center text-[13px]">立即开始</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] relative border-x-[3px] border-[#CC3333]">
                  <div class="absolute top-0 left-[-3px] right-[-3px] h-[3px] bg-[#CC3333]"></div>
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">Grow</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">¥37,000<span class="text-[14px] text-[#5C5C5C] font-normal">/月</span></p>
                  <Button variant="primary" href="/zh/contact" class="mt-[16px] w-full justify-center text-[13px]">立即开始</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tr-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Lead</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">¥46,000<span class="text-[14px] text-[#5C5C5C] font-normal">/月</span></p>
                  <Button variant="secondary" href="/zh/contact" class="mt-[16px] w-full justify-center text-[13px]">立即开始</Button>
                </th>
              </tr>
            </thead>
            <tbody>
              <!-- Section: Strategy & Setup -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">策略与启动</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">竞品调研</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">首月完成</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">首月完成</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">首月完成</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">内容策略与选题</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">月度发布日历</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">账号开通与搭建</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">按需配置</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">按需配置</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">按需配置</td>
              </tr>

              <!-- Section: Content -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">内容</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">微信</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1篇/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1篇/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1篇/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">微博</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">7条/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">小红书</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">5条/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">抖音（客户素材剪辑）</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2条/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">抖音（AI生成，15秒内）</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">1条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2条/周</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)] bg-[#F0F1F4]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium">抖音合计</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center">1条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">2条/周</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">4条/周</td>
              </tr>

              <!-- Section: AI Production -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">AI制作</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">HubStudio.ai生成短视频</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">拍前创意brief过审</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Social Listening -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">舆情监控</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">品牌口碑跟踪</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">竞品动态盯梢</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">月度舆情分析报告</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Support & Reporting -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">服务与汇报</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">专属客户经理</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">工作日在线消息答疑</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">月度数据复盘</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">策略对齐会</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">每月1次</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">每周1次</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">随叫随到</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Mobile: stacked cards with full features (shown only on mobile) -->
        <div class="hidden max-[640px]:flex flex-col gap-[16px]">
          {packages.map((pkg) => {
            const dark = pkg.highlighted;
            const textPrimary = dark ? 'text-[#FFFFFF]' : 'text-[#1A1A1A]';
            const textSecondary = dark ? 'text-[rgba(255,255,255,0.6)]' : 'text-[#5C5C5C]';
            const borderColor = dark ? 'border-[rgba(255,255,255,0.1)]' : 'border-[rgba(0,0,0,0.06)]';

            const features = [
              { section: '策略与启动', items: [
                { label: '竞品调研', value: pkg.strategy.competitor },
                { label: '内容策略与选题', value: pkg.strategy.contentStrategy },
                { label: '月度发布日历', value: pkg.strategy.editorialCalendar },
                { label: '账号开通与搭建', value: pkg.strategy.accountOpening },
              ]},
              { section: '内容', items: [
                { label: '微信', value: pkg.content.wechat },
                { label: '微博', value: pkg.content.weibo },
                { label: '小红书', value: pkg.content.rednote },
                { label: '抖音（客户素材剪辑）', value: pkg.content.douyinClient },
                { label: '抖音（AI生成）', value: pkg.content.douyinAi },
                { label: '抖音合计', value: pkg.content.douyinTotal },
              ]},
              { section: 'AI制作', items: [
                { label: 'HubStudio.ai生成短视频', value: pkg.ai },
                { label: '拍前创意brief过审', value: pkg.ai },
              ]},
              { section: '舆情监控', items: [
                { label: '品牌口碑跟踪', value: pkg.socialListening },
                { label: '竞品动态盯梢', value: pkg.socialListening },
                { label: '月度舆情分析报告', value: pkg.socialListening },
              ]},
              { section: '服务与汇报', items: [
                { label: '专属客户经理', value: pkg.support.accountManager },
                { label: '工作日在线消息答疑', value: pkg.support.chatSupport },
                { label: '月度数据复盘', value: pkg.support.monthlyReport },
                { label: '策略对齐会', value: pkg.support.strategyCalls },
              ]},
            ];

            return (
              <div class:list={[
                'rounded-[12px] p-[24px]',
                dark ? 'bg-[#1A1A1A]' : 'bg-[#F0F1F4]'
              ]}>
                <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">
                  {pkg.name}
                </p>
                <p class:list={['text-[28px] font-medium leading-[1.2] mb-[4px]', textPrimary]}>
                  {pkg.price}<span class:list={['text-[14px] font-normal', textSecondary]}>/月</span>
                </p>
                <p class:list={['text-[13px] font-normal leading-[1.5] mb-[20px]', textSecondary]}>
                  {pkg.description}
                </p>

                <Button variant={dark ? 'primary' : 'secondary'} href="/zh/contact" class="w-full justify-center">立即开始</Button>

                <div class="mt-[24px] flex flex-col gap-[20px]">
                  {features.map((group) => (
                    <div>
                      <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[8px]">{group.section}</p>
                      <div class="flex flex-col">
                        {group.items.map((item) => (
                          <div class:list={['flex justify-between items-center py-[8px] border-b', borderColor]}>
                            <span class:list={['text-[13px] font-normal', textPrimary]}>{item.label}</span>
                            <span class:list={['text-[13px] font-medium shrink-0 ml-[12px]',
                              item.value === true ? 'text-[#CC3333]' :
                              item.value === false ? textSecondary :
                              textPrimary
                            ]}>
                              {item.value === true ? '\u2713' : item.value === false ? '\u2014' : item.value}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Content specs -->
        <div class="mt-[48px] max-w-[680px]">
          <h3 class="text-[18px] text-[#1A1A1A] font-medium leading-[1.3] mb-[16px]">内容规格</h3>
          <div class="text-[14px] text-[#5C5C5C] font-normal leading-[1.8]">
            <p><span class="font-medium text-[#1A1A1A]">微信推文：</span>1500字以内，配3张图。</p>
            <p><span class="font-medium text-[#1A1A1A]">微博：</span>300字以内，配1张图。</p>
            <p><span class="font-medium text-[#1A1A1A]">小红书笔记：</span>500字以内，6张轮播图。</p>
            <p><span class="font-medium text-[#1A1A1A]">抖音视频：</span>60秒以内。客户自有素材，我们负责剪辑和字幕。AI生成视频限15秒，拍前先过创意brief。</p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Add-On Platforms -->
    <section class="mt-[96px] max-[640px]:mt-[64px]">
      <Container>
        <SectionBar />
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">可加平台</h2>
        <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] mb-[32px] max-w-[680px]">
          按月叠加到任意方案。每个平台每月起4条。报价含文案、图文/视频制作、发布。
        </p>

        <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
          {addOnPlatforms.map((group) => (
            <div class="bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[16px]">{group.category}</p>
              <div class="flex flex-col gap-[12px]">
                {group.items.map((item) => (
                  <div class="flex justify-between items-start gap-[12px]">
                    <span class="text-[13px] text-[#1A1A1A] font-normal leading-[1.4]">{item.name}</span>
                    <span class="text-[13px] text-[#1A1A1A] font-medium leading-[1.4] shrink-0">{item.price}</span>
                  </div>
