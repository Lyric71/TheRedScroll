---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import EditorialIndex from '../../components/pages/EditorialIndex.astro';

const SITE_URL = 'https://www.theredscroll.com';

const pages = (await getCollection('tools-zh'))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .map((post) => ({
    href: `/zh/gongju/${post.id}/`,
    title: post.data.title,
    excerpt: post.data.description,
    category: post.data.category,
    featuredImage: post.data.featuredImage,
    readingTime: `${Math.ceil((post.body || '').split(/\s+/).length / 200)} min`,
    date: new Date(post.data.publishDate).toLocaleDateString('zh-CN', { month: 'long', year: 'numeric' }),
  }));

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/zh/gongju/#collectionpage`,
  name: "中国社交媒体规划工具",
  url: `${SITE_URL}/zh/gongju/`,
  description: "免费的计算器和清单，用于规划微信、小红书和抖音的中国社交媒体预算与上线节奏。",
  isPartOf: { '@id': `${SITE_URL}/#website` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: 'zh-Hans',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: pages.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}${p.href}`,
      name: p.title,
    })),
  },
};
---

<PageLayout
  title={"中国社交媒体规划工具 | TheRedScroll"}
  description={"免费的计算器和清单，用于规划微信、小红书和抖音的中国社交媒体预算与上线节奏。"}
  lang="zh"
  schema={collectionSchema}
>
  <EditorialIndex
    lang="zh"
    overline={"工具"}
    heading={"先把账算清楚，再花钱。"}
    intro={"计算器和清单，来自我们每月经手的真实预算。不用注册，不用留资。"}
    items={pages}
    emptyText={"第一个工具是预算计算器，今年内上线。在此之前，价格页列出了每档月度服务包含的内容。"}
  />
</PageLayout>
