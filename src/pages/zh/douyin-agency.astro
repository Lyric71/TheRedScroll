---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 7.5, decimals: 1, suffix: '亿', label: '日活跃用户' },
  { value: 120, decimals: 0, suffix: ' 分钟', label: '人均每日使用时长' },
  { value: 3.5, decimals: 1, suffix: '万亿', label: '年电商成交额（人民币）' },
  { value: 2, decimals: 0, suffix: ' 周', label: '从签约到首条内容上线' },
];

const scopeItems = [
  { label: '开户与蓝V认证', href: '/zh/platforms/douyin/' },
  { label: '母语团队短视频制作', href: '/zh/services/content-production/' },
  { label: '星图 KOL 与 KOC 投放', href: '/zh/services/influencer-marketing/' },
  { label: '巨量引擎广告投放', href: '/zh/services/advertising/' },
  { label: '直播电商与抖音小店', href: '/zh/platforms/douyin/' },
];

const services = [
  {
    glyph: '号',
    title: '开户与认证',
    tag: '上线即认证',
    description:
      '企业号注册加蓝V认证，全程我们办。海外公司需要中国营业执照或授权代理，两条路我们都能走，你不用先在中国设公司。',
    deliverables: ['企业号', '蓝V认证', '资质路径建议', '账号交接'],
    image: '/images/platforms/douyin-services/setup-strategy.webp',
    imageAlt: '手机显示已认证的抖音企业号主页，旁边是营业注册文件',
  },
  {
    glyph: '视',
    title: '内容策略与视频制作',
    tag: '母语团队出片',
    description:
      '短视频全部由中国团队原创：产品演示、教程、热点玩法、短剧。HubStudio.ai 用来提产能，每一条的脚本和剪辑仍出自母语团队之手。',
    deliverables: ['内容策略', '短视频制作', '热点玩法', '短剧'],
    image: '/images/platforms/douyin-services/content-production.webp',
    imageAlt: '剪辑台上的手机屏幕显示一条制作中的竖屏抖音短视频',
  },
  {
    glyph: '达',
    title: 'KOL 与 KOC 投放',
    tag: '星图认证达人',
    description:
      '选人走抖音官方达人平台星图（Xingtu），再加我们自有的达人库，KOL 和 KOC 一起跑。每位达人先查水号、核受众画像，最终名单由你拍板。',
    deliverables: ['KOL 选人', 'KOC 铺量', '查水号', '投放报告'],
    image: '/images/platforms/douyin-services/kol-campaigns.webp',
    imageAlt: '内容创作者正在为抖音 KOL 项目拍摄产品视频',
  },
  {
    glyph: '广',
    title: '巨量引擎付费投放',
    tag: '广告费按原价走，零加价',
    description:
      '巨量引擎（Ocean Engine）是字节跳动旗下的抖音广告平台。TopView 打新品，信息流广告拉流量，搜索广告接高意向买家，DOU+ 测内容。广告费按原价结算，零加价。',
    deliverables: ['TopView', '信息流广告', '搜索广告', 'DOU+ 加热'],
    image: '/images/platforms/douyin-services/advertising.webp',
    imageAlt: '手机显示抖音视频信息流中的品牌信息流广告',
  },
  {
    glyph: '播',
    title: '直播与抖音小店',
    tag: '直播电商原生内置',
    description:
      '直播电商是抖音的原生能力。我们策划并执行直播带货：主播选择、产品脚本、实时互动。同时搭建并优化你的抖音小店。',
    deliverables: ['直播策划', '主播选择', '产品脚本', '抖音小店搭建'],
    image: '/images/platforms/douyin-services/live-commerce.webp',
    imageAlt: '主播在抖音直播带货中出镜讲解产品',
  },
  {
    glyph: '数',
    title: '数据、报告与优化',
    tag: '每月一份报告',
    description:
      '每月一份数字说话的报告：涨粉、播放、互动率、广告效率，电商跑起来后再加 GMV 和 ROAS。哪些有效、哪些没效、下个月改什么，写得明明白白。',
    deliverables: ['涨粉数据', '互动率', 'GMV 与 ROAS', '下月计划'],
    image: '/images/blog/douyin-control-room.webp',
    imageAlt: '监控屏幕上跟踪抖音涨粉、互动和销售数据',
  },
];

const segments = [
  {
    title: '美妆与时尚',
    description: '美妆和时尚在抖音天生能打。短演示、教程、达人测评带动发现，下单直接在 App 里完成。',
    icon: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  },
  {
    title: '食品饮料',
    description: '食品饮料是抖音的流量大类。快节奏演示和试吃玩法，把观众变成第一批下单的人，信息流和直播间都跑得通。',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: '消费电子与家居',
    description: '消费电子和家居用品在抖音有天然优势。几秒钟的产品演示就能讲清价值，算法奖励的正是这类内容。',
    icon: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  },
  {
    title: '酒店、汽车与 B2B',
    description: '酒店、汽车、大健康、B2B，在抖音都有打法。一线城市还是五线，22 岁还是 52 岁，你的中国用户早就在这了。',
    icon: '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>',
  },
];

const pillars = [
  {
    title: '团队就在中国',
    description: '上海和香港。母语团队每天都在抖音上发内容，不是只读报告的顾问。',
  },
  {
    title: '范围写死，价格固定',
    description: '2026 年 4 月我们对标了 37 家代理，0 家提供固定价格套餐。我们提供。每项交付提前定死。',
  },
  {
    title: '客户对接全程英文',
    description: '一位懂你品牌的专属客户经理。沟通用清晰的英文，内容是地道的中文。',
  },
  {
    title: '合规我们扛',
    description: '营业执照路径、账号认证、内容规范、广告审核。文书工作我们来啃，你的投放不卡壳。',
  },
];

const steps = [
  {
    title: '审计',
    description:
      '先摸清你的品类在抖音的盘面：竞品、内容形式、价格带，以及算法当下在你的垂类里奖励什么。',
  },
  {
    title: '策略',
    description:
      '内容主轴、发布节奏、KOL 候选名单、广告计划、KPI 目标，全部写进一份明确的 SOW（工作范围），价格固定。',
  },
  {
    title: '本地化',
    description:
      '没有任何东西是翻译出来的。母语团队为中国观众从零创作内容。翻译腔内容在抖音上表现惨淡。',
  },
  {
    title: '上线',
    description:
      '账号认证完成，签约 2 周内首条内容上线。客户经理用英文和你对接，你这边不需要任何中文能力。',
  },
  {
    title: '放大',
    description:
      '什么跑得好就加码什么。赢的形式通过 DOU+ 和巨量引擎追加预算，跑不动的直接砍掉。月报全程跟踪。',
  },
];

const caseStudies = [
  {
    client: "AGE 20's",
    image: '/images/clients/Age20/Age20-Picture1-scaled.jpg',
    imageAlt: "AGE 20's 粉底中国上市战役的宣传视觉",
    metric: '387万',
    metricLabel: '次抖音曝光，目标是 100 万',
    summary: '韩国美妆品牌把粉底产品带进中国。这一战役在抖音拿下 387 万次曝光，目标是 100 万，产品昵称还被用户自发叫开了。',
    href: '/zh/work/age20s/',
  },
  {
    client: 'Langnese',
    image: '/images/clients/Langnese/Langnese-Douyin-Livestream.jpg',
    imageAlt: '抖音直播带货中展示的 Langnese 蜂蜜',
    metric: '直播',
    metricLabel: '为老牌品牌打通直播电商',
    summary: '德国蜂蜜品牌面向中国消费者重新定位。抖音直播和快节奏演示视频改变了消费者的食用习惯，销售直接引流到天猫。',
    href: '/zh/work/langnese/',
  },
];

const faqs = [
  {
    q: '海外公司能在抖音投广告吗？',
    a: '能。海外品牌通过 TheRedScroll 这样的授权代理就能投抖音广告。我们负责开户，通过巨量引擎跑投放，广告费按原价结算。不需要在中国注册公司。',
  },
  {
    q: '需要中国营业执照或 WFOE 吗？',
    a: '起步阶段不需要。企业号需要中国营业执照或授权代理，代理这条路我们直接覆盖。想通过抖音小店卖货，没有中国主体的品牌也有跨境方案。第一通电话里我们就会给出适合你的路径。',
  },
  {
    q: '抖音代运营要花多少钱？',
    a: '多数代理报价不透明，交付物含糊。我们用固定价格套餐，每项交付提前列清。巨量引擎的广告费单独结算，按原价走，零加价。约个电话，我们按你的预算给出建议。',
  },
  {
    q: '对广告主来说，抖音和 TikTok 有什么区别？',
    a: '两个独立的 App，同属字节跳动，内容零互通。抖音服务中国大陆，广告走自己的巨量引擎平台。站内电商抖音深得多：小店、直播带货、站内下单一条龙。TikTok 的打法搬不过来。',
  },
  {
    q: '多久能看到效果？',
    a: '付费投放几天内就能出数据。自然流量通常需要 8 到 12 周的持续更新。算法奖励完播率和稳定性，所以每周 3 到 5 条是我们运营的底线。',
  },
  {
    q: 'TikTok 上的视频能直接搬到抖音吗？',
    a: '基本不行。带水印的搬运视频会被抖音识别并限流。观众要看的是中文口播、本地热点和本地化的呈现方式。好的创意我们偶尔会改编，但视频一定会为中国观众重新做一遍。',
  },
  {
    q: '抖音达人投放怎么做？',
    a: '我们通过字节跳动官方平台星图下单，每次合作背后都有经过查证的受众和互动数据。选人看匹配度和实际表现，不看粉丝数。需求沟通、合同、结算、授权，全流程我们来跑。一批中小达人种草，效果常常好过一个大头部。',
  },
  {
    q: '海外品牌怎么开抖音小店？',
    a: '抖音有面向无中国主体品牌的跨境项目。你可以开跨境店，从保税仓或海外直接发货。品类、保证金和资料要求各不相同，开店前我们会先确认资质。之后直播和短视频就能直接挂车成交。',
  },
  {
    q: '我们团队需要会中文的人吗？',
    a: '不需要。客户经理用英文和你对接：策略、审批、报告。面向中国市场的一切由我们的中文母语团队负责，从脚本、字幕到评论区回复。你审批的是英文摘要，不用面对中文原稿。',
  },
  {
    q: '抖音投放效果怎么衡量？',
    a: '对照工作范围里定下的目标。月报覆盖播放量、完播率、涨粉、互动、巨量引擎投放数据，涉及直播的还有直播销售。每份月报都以下月建议收尾。表现差的格式直接砍掉，不找借口。',
  },
];
---

<PageLayout
  title="抖音代运营，服务全球品牌 | TheRedScroll"
  description="抖音全案代运营：开户认证、内容制作、KOL 投放、巨量引擎广告、直播电商。团队在上海和香港。预约通话。"
  lang="zh"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      抖音
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">抖</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">抖音代运营</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            抖音代运营：在中国第一短视频平台做增长
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            开户、内容、KOL 投放、巨量引擎广告、直播电商。上海和香港的团队亲自操盘。范围写死，价格固定。
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/zh/contact/">预约通话</Button>
            <Button variant="secondary-dark" href="#results">查看成果</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            30 分钟通话，没有推销 PPT。
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/douyin-agency/hero-phones-blend.webp"
            alt="两台手机显示真实抖音界面：带商品卡的竖屏短视频信息流，以及一场直播带货"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            为什么抖音重要
          </p>
          <p class="manifesto" data-manifesto>
            抖音不是 TikTok，它是中国的短视频经济。7.5 亿人在这里看视频、逛店、下单，全程不出 App。你的品牌不在信息流里，<span class="manifesto-hl">竞争对手</span>就在。
          </p>
        </div>
        <div>
          <img
            src="/images/douyin-agency/ecosystem-banner-tight.webp"
            alt="三台手机展示抖音的三个面向：视频信息流、直播带货、抖音小店商品页"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            一个 App，三重角色：娱乐信息流、直播渠道、下单结算。
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            为进入中国市场的品牌做抖音代运营
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              抖音每天触达 7.5 亿中国用户。你的客户在上面，你的竞争对手可能也已经在了。
            </p>
            <p>
              TheRedScroll 是一家扎根中国的社媒代理。我们替海外品牌开抖音账号、产出母语短视频、跑 KOL 投放、通过巨量引擎买量，再用直播和抖音小店把货卖出去。
            </p>
            <p>
              每个合作都有明确的 SOW 和固定价格。签约之前，拿到什么、花多少钱，你都清楚。
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            服务范围一览
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
