const faqs = [
  {
    q: '微博代运营要花多少钱？',
    a: '两笔预算要分开看。代理费：按明确工作范围报一个固定月费，签约前每项交付和总价都摆在桌面上。2026 年 4 月我们分析了 37 家中国营销代理，0 家提供固定价格套餐。我们提供。广告费：直接付给微博，单独结算，按原价走，零加价。粉丝头条是低成本的入门位，热搜位处在最贵的一档。',
  },
  {
    q: '海外公司能开微博账号吗？',
    a: '能，这活我们常干。海外公司可以拿到带蓝V标识的认证企业号。需要翻译成中文的营业注册文件，外加付给微博的 1,000 美元一次性认证费。材料准备、翻译、和微博认证团队的往来沟通，都由我们处理。',
  },
  {
    q: '微博认证要多久？',
