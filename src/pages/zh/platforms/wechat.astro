    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
  },
  {
    name: '视频号',
    chineseName: 'WeChat Channels',
    description: '短视频加直播，和公众号、小程序无缝联动。从看内容到下单付款，用户一步都不用跳出微信。',
    image: '/images/platforms/wechat-ecosystem/wechat-channels.png',
    bg: '#CC3333',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
  },
  {
    name: '微信支付',
    chineseName: 'WeChat Pay',
    description: '国民级移动支付，9.35亿+活跃用户。路边摊、奢侈品专柜，哪里都在用。想在中国卖货，这一环没法跳过。',
    image: '/images/platforms/wechat-ecosystem/wechat-pay.png',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  },
  {
    name: '企业微信',
    chineseName: 'WeCom',
    description: '企业级CRM工具。一对一沟通、用户分层、自动化触达，覆盖7.5亿+微信用户。多数品牌都吃亏在起步太晚。',
    image: '/images/platforms/wechat-ecosystem/wecom.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    name: '朋友圈',
    chineseName: 'Moments',
    description: '用户每天刷日常动态的社交信息流。品牌广告原生出现在其中，是做认知和曝光最高效的一块。',
    image: '/images/platforms/wechat-ecosystem/moments.png',
    bg: '#B02D2D',
