    bg: '#B02D2D',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];

const services = [
  {
    title: '开号和认证',
    description: '服务号注册、蓝V认证、菜单排布、自动回复、品牌门面，全套我们接。和腾讯往返的每一份材料，你都不用碰。',
    result: '一个认证到位、立刻可以发第一条内容的账号。',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/wechat-services/account-setup.png',
  },
  {
    title: '内容策略和出品',
    description: '从内容主轴、排期表，到图文、视觉、短视频一条龙出片。文案由本地中文写手从零起稿，HubStudio.ai在后面把产量顶起来。',
    result: '用户会一路滑到底的本土内容。',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
    image: '/images/platforms/wechat-services/content-strategy.png',
  },
  {
    title: '小程序开发',
    description: '线上商城、留资表单、会员体系、预约工具，全部在微信里搭好，直连微信支付。',
    result: '一家把读者直接变成买家的店，用户不用跳App。',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
    image: '/images/platforms/wechat-services/mini-program.png',
  },
  {
    title: '微信广告投放',
    description: '媒介排期、素材创作、AB测、出价、复盘，一条龙跑完。朋友圈广告、Banner、小程序广告都能投。广告费按平台原价走，我们一分不加。',
    result: '人群打得准，每一笔花销都能对账。',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/wechat-services/advertising.png',
  },
  {
    title: '企微和私域',
    description: '私域从第一天就跑起来。人群分层、欢迎SOP、1对1触达、社群运营全程落地。这一块，多数代理都做得不细。',
    result: '一笔真正属于你、换个平台也带得走的用户资产。',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    image: '/images/platforms/wechat-services/wecom-crm.png',
  },
  {
    title: '视频号和KOL',
    description: '短视频制作、视频号直播，外加KOL选人、评估、执行、复盘。互动数据必须能查实，刷量的账号我们直接不用。',
    result: '内容和达人项目，都和你的公众号、小程序串成一条线。',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
    image: '/images/platforms/wechat-services/channels-kol.png',
  },
];

const bestPractices = [
  {
    title: '质量永远压过频率',
    description: '服务号一个月只有4次推送机会。一篇被疯狂转发的爆文，比四篇只有30次打开的稿子值钱太多。',
  },
  {
    title: '别翻译，要本地重写',
    description: '英文稿丢给翻译，永远出不来能看的内容。brief直接用中文写，再交给真正在这个平台上混的人去做。',
  },
  {
    title: '小程序越早上越好',
    description: '不用一开张就卖货。一本产品手册、一个品牌小测试、一张报名表都行。关键是让读者读完文章还有下一步可走。',
  },
  {
    title: '企微第一天就要开',
    description: '每一个新关注，都要顺手沉到企微里。半年下来，有私域和没私域的品牌，根本不是一盘棋。',
  },
  {
    title: '付费和自然流量要一起跑',
    description: '朋友圈广告能把粉丝数迅速拉起来。但粉丝来了发现账号一片空，几周之内就走光。',
  },
  {
    title: '把矩阵当一盘棋来下',
    description: '公众号带小程序，企微管留存，视频号管拉新。每一环都在给别的环输血。单独看一个账号，看不出门道。',
  },
];

const steps = [
  {
    number: '01',
    title: '先聊一次。',
    description: '聊你的品牌、你的目标、你当下卡在哪一步。不用准备PPT，也没有流程话术，把该问的问清楚。',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: '报方案。',
    description: 'SOW写明白，固定价格，交付物一条一条列齐。签合同之前你就看清楚，拿到的是什么、要花多少钱。',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: '两周上线。',
    description: '对接、开户、搭账号、出首篇内容。从合同签字到第一条推文发出去，大概14天。',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  {
    q: '实际是谁在跑我的微信账号？',
    a: '我们自己的人，就坐在上海和香港。本地中文写手，每天都在这个平台上混。你会对接一位专属客户经理，背后是一整支完整团队：文案、设计、视频、策略，全在中国本地。我们不外包给自由职业者，也不会隔着大半个地球远程操盘你的号。',
  },
  {
    q: '海外公司也能开公众号吗？',
    a: '能。拿海外营业执照就可以申请服务号，整个流程1到2周跑完。注册、认证、后台配置都由我们接手，你不用去啃那一堆腾讯表单。',
  },
  {
    q: '必须在中国有公司吗？',
    a: '简单答：起步阶段不用。海外公司可以直接开服务号。但有些功能走国内主体更顺手，比如微信支付收款、某些广告位。我们会先把你手上的主体盘一遍，再告诉你能走多远、哪一步需要换档。',
  },
  {
    q: '收费怎么算？',
    a: '范围写死，价格锁定。启动前每一项交付都列明白：推文几篇、视频几条、项目几个、报告几份。按月走固定费用，不按工时跳表，也没有临时加项。广告预算永远单独走，按平台原价结算，我们不从里面抽一分。',
  },
  {
    q: '我们已经有账号，但一直没起色，能接手吗？',
    a: '这种情况见得太多了。先做一次账号审计，哪里跑通了、哪里卡住了，一条条看清楚，再重新搭框架。有时是内容没打到对的人，有时是缺一个小程序，用户读完一篇就没下一步可走。先诊断，再动手。',
  },
  {
    q: '多久能上线？',
    a: '从零开始的客户，大多数两周内就能走到认证通过、开始发第一批内容。注册、认证、后台配置、首批稿件都包含在内。如果你已经有认证过的号，几天内就能开工。',
  },
  {
    q: '你们只接国际品牌吗？',
    a: '不只。客户大致分三类：刚进中国的国际品牌、已经落地中国的国际品牌，以及跑国内社媒的本土品牌。能做的服务是同一套，策略按你所处的阶段和目标来调。',
  },
  {
    q: '你们出内容的方式和别家代理哪里不一样？',
    a: '文案是本地中文写手，专门为微信下笔，不是拿着英文稿做翻译。视觉和视频产能由HubStudio.ai顶起来，速度和成本都能压下来。但创意方向和策略，始终是人在拍板。',
  },
  {
    q: '微信上的KOL项目怎么跑？',
    a: '全程我们接：选人、写brief、共创内容、协调排期、追效果。互动数据必须经得起查。粉丝数有水分的KOL，我们直接不用。',
  },
  {
    q: '效果怎么汇报？',
    a: '每月一份报告。涨粉、打开率、小程序流量、广告ROI、转化率都列清楚。数据说得具体，话讲得直接。哪一环没跑通，我们会点明卡在哪、下个月怎么改。',
  },
];
---

<PageLayout
  title="微信营销服务 | TheRedScroll"
  description="团队在上海和香港，每天都在跑微信账号。公众号、小程序、企微、视频号、广告投放。范围写死，固定报价。"
  lang="zh"
>
  <!-- Hero: Dark hero banner (Style A) -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/wechat-hero.png')" aria-hidden="true"></div>
    <!-- Watermark -->
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      微信
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/zh/platforms/others" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; 返回全部平台
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          微信营销
        </p>
        <UpdatedDate lang="zh" date="2026 年 5 月" variant="light" class="mb-[8px]" />
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          14亿人，在微信上聊天、付钱、下单、认品牌。
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          我们团队在上海和香港，每天都在微信里实战。要涨粉、要互动、要转化，这事我们接。
        </p>
        <Button variant="primary" href="/zh/contact">预约通话</Button>
      </div>
    </Container>
  </section>

  <!-- Stats section — horizontal scroll strip -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            这些数据不是拿给董事会摆拍用的。你的中国用户，早就泡在这里。
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            微信的事，数据自己会说话。
          </p>
        </div>
        <Button variant="primary" href="/zh/contact" class="shrink-0">预约通话</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>

      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div
              class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none"
              data-stat-index={i}
            >
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
