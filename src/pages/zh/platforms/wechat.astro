---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const stats = [
  { label: '月活用户', value: '1.4B+', image: '/images/platforms/wechat-stats/monthly-active-users.png' },
  { label: '中国用户', value: '810M+', image: '/images/platforms/wechat-stats/users-in-china.png' },
  { label: '人均日使用时长', value: '82 min', image: '/images/platforms/wechat-stats/daily-time-per-user.png' },
  { label: '小程序月活用户', value: '945M', image: '/images/platforms/wechat-stats/mini-program-users.png' },
  { label: '微信支付活跃用户', value: '935M+', image: '/images/platforms/wechat-stats/wechat-pay-users.png' },
  { label: '日发送消息量', value: '45B', image: '/images/platforms/wechat-stats/messages-sent-daily.png' },
  { label: '公众号数量', value: '3.5M+', image: '/images/platforms/wechat-stats/official-accounts.png' },
  { label: '每天打开10次以上的用户比例', value: '60%+', image: '/images/platforms/wechat-stats/daily-opens.png' },
];

const ecosystem = [
  {
    name: '服务号',
    chineseName: 'Service Account',
    description: '品牌在微信里的根据地。自定义菜单、微信支付接入、CRM工具一应俱全。每月可推送4次，单次最多32篇。海外企业能独立开通的，只有这一类。',
    image: '/images/platforms/wechat-ecosystem/service-account.png',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
  },
  {
    name: '小程序',
    chineseName: 'Mini Programs',
    description: '装在微信里的App，免下载即用。电商、预约、会员、小游戏都能跑。月活9.45亿，原生接入微信支付。',
    image: '/images/platforms/wechat-ecosystem/mini-programs.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
