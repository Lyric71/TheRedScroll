const steps = [
  {
    number: '01',
    title: 'Appel decouverte.',
    description: 'Parlez-nous de votre marque, de vos objectifs et de votre situation actuelle vis-a-vis de la Chine. Pas de dossier de presentation. Les bonnes questions, c\'est tout.',
