const videoAndCommunity = platforms.filter(p => p.category === 'Video et communaute');
const textAndKnowledge = platforms.filter(p => p.category === 'Texte et savoir');
const commerceAndLifestyle = platforms.filter(p => p.category === 'Commerce et lifestyle');
---

<PageLayout
  title="Plateformes complementaires : Bilibili, Kuaishou, Zhihu et plus | TheRedScroll"
  description="14 plateformes que la plupart des agences ignorent. Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Pinduoduo et d'autres. Perimetre fixe, prix fixe. Equipe sur le terrain en Chine."
  lang="zh"
>
  <!-- Hero: Dark hero banner -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/additional-platforms-hero.png')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      更多平台
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Au-dela des quatre grandes
        </p>
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          14 plateformes que la plupart des agences ignorent
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          Vos clients regardent Bilibili pendant deux heures d'affilee. Ils consultent Dianping avant de choisir un restaurant. Ils font davantage confiance aux reponses sur Zhihu qu'a la publicite. Ils achetent en live sur Kuaishou dans le metro. Nous publions sur toutes ces plateformes. Chaque jour, depuis Shanghai et Hong Kong.
        </p>
        <div class="flex items-center justify-center gap-[12px] flex-wrap">
          <Button variant="primary" href="/zh/contact">Prendre rendez-vous</Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- Stats section — horizontal scroll strip -->
