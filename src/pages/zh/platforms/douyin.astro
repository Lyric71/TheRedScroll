  { label: '人均日使用时长', value: '120 min', image: '/images/platforms/douyin-stats/daily-time.webp' },
  { label: '电商GMV（2024）', value: '¥3.5T', image: '/images/platforms/douyin-stats/ecommerce-sales.webp' },
  { label: '电商同比增速', value: '34%', image: '/images/platforms/douyin-stats/yoy-growth.webp' },
  { label: '日均直播场次', value: '30M+', image: '/images/platforms/douyin-stats/live-commerce.webp' },
