<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .svc-panel {
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
