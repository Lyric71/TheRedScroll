  { label: '人均日使用时长', value: '120 min', image: '/images/platforms/douyin-stats/daily-time.png' },
  { label: '电商GMV（2024）', value: '¥3.5T', image: '/images/platforms/douyin-stats/ecommerce-sales.png' },
  { label: '电商同比增速', value: '34%', image: '/images/platforms/douyin-stats/yoy-growth.png' },
  { label: '日均直播场次', value: '30M+', image: '/images/platforms/douyin-stats/live-commerce.png' },
  { label: '内容品类数', value: '100+', image: '/images/platforms/douyin-stats/content-variety.png' },
  { label: '创作者账号数', value: '15M+', image: '/images/platforms/douyin-stats/creator-economy.png' },
];

const ecosystem = [
  {
