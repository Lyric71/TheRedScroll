const faqs = [
  {
    q: '具体是谁在帮我们运营账号？',
    a: '我们自己的团队，人就在中国。本地中文写手，天天在抖音上跑内容和广告。你会有一位专属客户经理对接，他对你的品牌熟门熟路。',
  },
  {
    q: '一定要有中国营业执照吗？',
    a: '企业号需要一张中国营业执照，或者通过授权代理商开。这两种情况我们都能接。不在本地注册实体，你也一样可以发内容、跑广告。',
  },
  {
    q: 'TheRedScroll和别家有什么不同？',
    a: '范围写死、固定价格。团队常驻中国。AI辅助制作。我们把行业里的37家同行都看过一遍，没有一家做真正的固定报价套餐。',
  },
  {
    q: '多久能看到效果？',
    a: '大多数品牌8到12周就能看到起势。付费广告几天之内就能拿到数据。具体速度，看品类，也看你想打多激进的打法。',
  },
  {
    q: '价格是怎么算的？',
    a: '固定报价套餐，每一项交付都写在合同里。广告预算单独走账，按实际成本结算，一分不加。先聊一下，我们会给你匹配合适的方案。',
  },
  {
    q: '没有中国实体也能投广告吗？',
    a: '可以。海外品牌通过我们这边的授权代理资质，就能在抖音上投广告，不用在本地注册实体。',
  },
  {
    q: '你们都做哪些类型的内容？',
    a: '产品演示、生活方式、教程、小剧情、KOL合作、直播。全部中文，由我们在中国的团队操刀。产能交给AI工具，但每一条内容都要人工过一遍。',
  },
