import Button from '../../../components/ui/Button.astro';
import UpdatedDate from '../../../components/ui/UpdatedDate.astro';

const stats = [
  { label: '日活用户', value: '750M+', image: '/images/platforms/douyin-stats/daily-active-users.webp' },
