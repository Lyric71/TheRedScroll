const faqs = [
  {
    q: '到底是谁在帮我们运营账号？',
    a: '我们自己的团队，人在中国。本地中文写手，天天在抖音上跑内容、跑广告。你有一位专属客户经理对接，他对你的品牌熟门熟路。',
  },
  {
    q: '一定得有中国营业执照吗？',
    a: '企业号要么你自己拿一张中国营业执照，要么走授权代理商。两条路我们都能接。没在本地落户，照样发内容、跑广告。',
  },
  {
    q: 'TheRedScroll跟别家区别在哪？',
