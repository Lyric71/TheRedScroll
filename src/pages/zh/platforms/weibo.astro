const services = [
  {
    title: 'Creation de compte et verification',
    description: 'Nous enregistrons votre compte entreprise Blue V de bout en bout. Preparation des documents, traduction chinoise, soumission, creation complete du profil. Les entreprises internationales paient des frais de verification uniques de 1 000 $. L\'approbation prend 2 a 4 semaines. Nous gerons tout.',
