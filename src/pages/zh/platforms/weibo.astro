const bestPractices = [
  {
    title: 'Publiez chaque jour.',
    description: 'Une fois par jour minimum. Trois a cinq en phase de croissance. L\'algorithme recompense la regularite.',
  },
  {
    title: 'Privilegiez les visuels.',
    description: 'Utilisez les 9 emplacements d\'images. L\'image centrale attire le plus l\'attention. La video courte surpasse systematiquement les publications statiques.',
  },
  {
    title: 'Reagissez vite aux tendances.',
    description: 'Consultez la Hot Search chaque matin. Publiez dans l\'heure quand un sujet pertinent emerge.',
  },
