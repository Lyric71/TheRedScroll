---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog-zh');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const readingTime = Math.ceil((post.body || '').split(/\s+/).length / 200);
const formattedDate = new Date(post.data.publishDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BlogLayout
  title={`${post.data.title} | TheRedScroll`}
  description={post.data.metaDescription}
  ogImage={post.data.featuredImage}
  lang="zh"
>
  <!-- Hero -->
  <section class="pt-[92px] pb-[0px] max-[640px]:pt-[72px]">
    <Container>
      <div class="max-w-[680px] mx-auto">
        <a href="/zh/insights" class="inline-flex items-center gap-[6px] text-[13px] font-normal text-[var(--color-stone)] no-underline hover:text-[var(--color-ink)] mb-[16px] transition-colors duration-150">
          &#8592; 返回文章列表
        </a>
        <div class="flex items-center mb-[12px]">
          <SectionBar />
        </div>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">
          {post.data.category}
        </p>
        <h1 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.25] text-[var(--color-ink)] mb-[8px]">
          {post.data.title}
        </h1>
        <div class="flex items-center gap-[8px] flex-wrap text-[12px] font-normal text-[var(--color-stone)] leading-[1.4]">
          <span>阅读约 {readingTime} 分钟</span>
          <span class="text-[var(--color-warm-gray)]">|</span>
          <span>{formattedDate}</span>
        </div>
      </div>
    </Container>
  </section>

  <!-- Featured image -->
  {post.data.featuredImage && (
    <section class="mt-[24px]">
      <Container>
        <img
          src={post.data.featuredImage}
          alt={post.data.title}
          class="w-full aspect-[16/9] object-cover rounded-[0px] block"
          loading="eager"
        />
      </Container>
    </section>
  )}

  <!-- Article body -->
  <section class="pt-[48px] pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="max-w-[680px] mx-auto prose-article">
        <Content />
      </div>

      <!-- CTA -->
      <div class="max-w-[680px] mx-auto mt-[48px] pt-[32px] border-t-[0.5px] border-[var(--color-border)]">
        <p class="text-[16px] font-normal text-[var(--color-ink)] leading-[1.6] mb-[16px]">
          想让你的品牌在中国社媒真正跑起来?
        </p>
        <a href="/zh/contact" class="inline-flex items-center justify-center h-[44px] px-[28px] bg-[var(--color-vermillion)] text-[#FFFFFF] text-[14px] font-medium leading-[1] no-underline rounded-[6px] transition-[background] duration-150 hover:bg-[var(--color-vermillion-hover)] active:scale-[0.98]">
          预约通话
        </a>
      </div>
    </Container>
  </section>
</BlogLayout>

<script>
  document.querySelectorAll('.prose-article table').forEach((table) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'table-wrap';
    table.parentNode?.insertBefore(wrapper, table);
    wrapper.appendChild(table);
  });
</script>

<style is:global>
  .prose-article h2 {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-ink);
    margin-top: 48px;
    margin-bottom: 16px;
  }
  @media (max-width: 640px) {
    .prose-article h2 {
      font-size: 22px;
      margin-top: 40px;
      margin-bottom: 12px;
    }
  }
  .prose-article h3 {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink);
    margin-top: 32px;
    margin-bottom: 12px;
  }
  @media (max-width: 640px) {
    .prose-article h3 {
      margin-top: 24px;
      margin-bottom: 8px;
    }
  }
  .prose-article p {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-ink);
    margin-bottom: 24px;
  }
  .prose-article blockquote {
    background: var(--color-rice-paper);
    border-left: 3px solid var(--color-vermillion);
    border-radius: 0;
    padding: 20px;
    margin: 32px 0;
  }
  .prose-article blockquote p {
    font-size: 14px;
    color: var(--color-stone);
    margin-bottom: 0;
  }
  .prose-article a {
    color: var(--color-vermillion);
    text-decoration: none;
    transition: text-decoration 0.15s ease;
  }
  .prose-article a:hover {
    text-decoration: underline;
  }
  .prose-article .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 32px 0;
  }
  .prose-article table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
  }
  .prose-article th {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-warm-gray);
  }
  .prose-article td {
    font-size: 14px;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.5;
    padding: 12px 16px;
    border-bottom: 0.5px solid var(--color-border);
    vertical-align: top;
  }
  .prose-article tr:last-child td {
    border-bottom: none;
  }
  .prose-article strong {
    font-weight: 500;
  }
  .prose-article em {
    font-style: normal;
    color: var(--color-stone);
  }
  .prose-article img {
    width: 100%;
    border-radius: 8px;
    margin: 32px 0;
    display: block;
  }
  .prose-article ul, .prose-article ol {
    margin-bottom: 24px;
    padding-left: 24px;
  }
  .prose-article li {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-ink);
    margin-bottom: 8px;
  }
</style>
