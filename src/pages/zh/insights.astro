---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import PlatformFilter from '../../components/pages/PlatformFilter.astro';

const allPosts = await getCollection('blog-zh');
const articles = allPosts
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .map((post) => ({
    category: post.data.category,
    platforms: post.data.platforms ?? [],
    title: post.data.title,
    excerpt: post.data.description,
    readingTime: `${Math.ceil(post.body!.split(/\s+/).length / 200)} 分钟`,
    date: new Date(post.data.publishDate).toLocaleDateString('zh-CN', { month: 'long', year: 'numeric' }),
    slug: `/zh/insights/${post.id}`,
    featuredImage: post.data.featuredImage,
  }));

const PLATFORM_LABELS = [
  { value: 'wechat', label: '微信 WeChat' },
  { value: 'rednote', label: '小红书 RedNote' },
  { value: 'douyin', label: '抖音 Douyin' },
  { value: 'weibo', label: '微博 Weibo' },
];
const presentPlatforms = new Set<string>(articles.flatMap((a) => a.platforms));
const platformOptions = PLATFORM_LABELS.filter((p) => presentPlatforms.has(p.value));
---

<PageLayout
  title="中国社媒洞察与指南 | TheRedScroll"
  description="中国社媒营销的一线观察与实战笔记。微信、小红书、抖音、微博，我们怎么做、怎么想。"
  lang="zh"
>

  <!-- Hero -->
  <section class="pt-[96px] pb-[64px] max-[640px]:pt-[64px] max-[640px]:pb-[40px]">
    <Container>
      <div class="max-w-[680px]">
        <SectionBar />
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">
          行业观察
        </p>
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[16px]">
          我们在中国社媒上看到的、踩过的、想透的事
        </h1>
      </div>
      <p class="text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] text-[var(--color-stone)]">
        平台的新动向、策略的拆解，一线跑出来的真经验。
      </p>
    </Container>
  </section>

  <!-- Articles grid -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <PlatformFilter allLabel="全部" ariaLabel="按平台筛选文章" platforms={platformOptions} />
      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
        {articles.map((article) => (
          <a href={article.slug} data-insight-card data-platforms={article.platforms.join(' ')} class="block bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[8px] overflow-hidden transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)]">
            {article.featuredImage ? (
              <img src={article.featuredImage} alt={article.title} class="w-full aspect-[4/3] object-cover bg-[var(--color-warm-gray)]" loading="lazy" />
            ) : (
              <div class="w-full aspect-[4/3] bg-[var(--color-warm-gray)] flex items-center justify-center">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(0,0,0,0.15)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                  <polyline points="14,2 14,8 20,8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
              </div>
            )}
            <div class="p-[20px]">
              <p class="text-[11px] font-medium tracking-[0.05em] uppercase text-[var(--color-vermillion)] leading-[1.2] mb-[8px]">
                {article.category}
              </p>
              <h3 class="text-[18px] text-[var(--color-ink)] font-medium leading-[1.3] mb-[8px]">
                {article.title}
              </h3>
              <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[12px] line-clamp-2">
                {article.excerpt}
              </p>
              <p class="text-[12px] text-[var(--color-stone)] font-normal leading-[1.4]">
                阅读约 {article.readingTime} <span class="mx-[6px] text-[var(--color-warm-gray)]">|</span> {article.date}
              </p>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

</PageLayout>
