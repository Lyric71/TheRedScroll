---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 14, decimals: 0, suffix: '亿', label: '全球月活' },
  { value: 9.45, decimals: 2, suffix: '亿', label: '小程序月活' },
  { value: 18, decimals: 0, suffix: ' 个', label: '同时运营的中国平台' },
  { value: 4, decimals: 0, suffix: ' 周', label: '从签约到内容首发' },
];

const scopeItems = [
  { label: '公众号注册与认证', href: '/zh/platforms/wechat/' },
  { label: '本地中文写手原创内容', href: '/zh/services/content-production/' },
  { label: '朋友圈广告、公众号广告、小程序广告', href: '/zh/services/advertising/' },
  { label: '小程序与微信电商', href: '/zh/platforms/wechat/' },
  { label: '企业微信 CRM 与私域流量', href: '/zh/services/crm-private-domain/' },
];

const services = [
  {
    glyph: '号',
    title: '公众号注册与认证',
    tag: '1 到 2 周上线',
    description:
      '注册服务号、备齐认证材料、盯着腾讯把审核走完，全程我们来。菜单、自动回复、品牌素材一次配齐。多数账号 1 到 2 周开出来。',
    deliverables: ['服务号注册', '腾讯认证', '菜单与自动回复', '品牌素材'],
    image: '/images/wechat-agency/service-setup.webp',
    imageAlt: '手机与公司注册文件并排摆在桌面，屏幕上是一个完成认证的微信公众号品牌主页',
  },
  {
    glyph: '文',
    title: '内容与 CRM',
    tag: '本地中文写手',
    description:
      '内容主轴、排期、图文、视觉、视频，一套班子做完。稿子由本地中文写手从零写起，不走翻译。每个新关注都导进企业微信，攒出一份任何平台都收不走的客户名单。',
    deliverables: ['内容排期表', '图文推送', '视觉与视频', '企微搭建'],
    image: '/images/wechat-agency/service-content.webp',
    imageAlt: '编辑台上的手机屏幕正划过一篇品牌微信公众号推文',
  },
  {
    glyph: '广',
    title: '微信广告投放',
    tag: '广告费原价结算，零加价',
    description:
      '媒介排期、素材创作、A/B 测试、出价调优，朋友圈广告、公众号广告、小程序广告全覆盖。广告费按腾讯原价结算，我们一分不加。',
    deliverables: ['媒介计划', '广告素材', 'A/B 测试', '出价管理'],
    image: '/images/wechat-agency/service-ads.webp',
    imageAlt: '咖啡馆内手持手机，朋友圈信息流里插着一条品牌赞助广告',
  },
  {
    glyph: '店',
    title: '小程序与电商',
    tag: '9.45 亿月活用户',
    description:
      '商城、留资、预约、会员体系，全部搭进微信，直连微信支付。小程序每月有 9.45 亿人在用。读者看完内容，顺手就能走到下一步。',
    deliverables: ['线上商城', '微信支付', '留资表单', '会员体系'],
    image: '/images/wechat-agency/service-miniprogram.webp',
    imageAlt: '两台手机并排，一台是微信小程序商城，一台是微信支付付款成功页',
  },
  {
    glyph: '播',
    title: 'KOL 与联合推广',
    tag: '互动数据必须查得实',
    description:
      '选人、评估、brief、复盘，KOL 项目整条链路我们跑。互动数据要经得起核对。粉丝明显掺水的账号，我们不碰。',
    deliverables: ['KOL 选人', '账号评估', '投放 brief', '效果报告'],
    image: '/images/wechat-agency/service-kol.webp',
    imageAlt: '创作者正在拍产品视频，一旁的手机开着微信视频号直播',
  },
];

const segments = [
  {
    title: 'B2C 零售与奢侈品',
    description: '中国消费者下单前，先上微信查一圈。公众号、内容、小程序商城，这条转化链我们替你搭齐。',
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  },
  {
    title: 'B2B 与工业',
    description: '销售周期越长，越需要一条能持续跟进的通道。公众号文章配企微触达，展会上换来的名片才会变成线索。',
    icon: '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
  },
  {
    title: '旅游与教育',
    description: '中国游客和留学生，出发前几个月就在微信上做攻略。我们让品牌一直待在他们的视线里。',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: '跨境电商',
    description: '没有中国主体，一样能把货卖进中国。小程序商城配跨境微信支付，这条路我们已经替客户走通。',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  },
];

const pillars = [
  {
    title: 'SOW 写明白',
    description: '每项交付提前定死：文章几篇、视频几条、项目几个、报告几份。每个月拿到手的东西，一目了然。',
  },
  {
    title: '价格固定，没有意外',
    description: '一个套餐一个价。不按工时跳表，不收加项费，月底不会冒出一张看不懂的账单。',
  },
  {
    title: 'AI 加持的内容产能',
    description: '视觉和视频交给 HubStudio.ai，产量上得去，成本压得住。方向和策略，始终由人拍板。',
  },
  {
    title: '团队就在中国',
    description: '上海加香港。母语团队天天泡在微信里，一线 KOL 资源和平台入口都握在手上。',
  },
];

const steps = [
  {
    title: '先聊一次',
    description: '30 分钟，聊品牌、聊目标、聊你在中国市场走到了哪一步。没有推销 PPT。',
  },
  {
    title: '报方案',
    description: 'SOW 写明白，价格锁死，交付物一条条列清。签字之前，你就知道花多少钱、拿到什么。',
  },
  {
    title: '4 周上线',
    description: '对接、开户、认证、首批内容发出。从合同落笔到第一条推文，4 周。',
  },
];

const caseStudies = [
  {
    client: 'JAC Motors',
    image: '/images/clients/JAC/JAC-Wechat-4.webp',
    imageAlt: 'TheRedScroll 为 JAC Motors 运营的微信内容画面',
    metric: '1000万',
    metricLabel: '辆整车卖出，用户社区从零重建',
    summary: '一家累计销量 1000 万辆的中国车企，社媒上却几乎没有声音。我们用 AI 加持的内容产线，在微信、小红书和微博上把它的用户社区重新建了起来。',
    href: '/zh/work/jac-motors/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Mission Foods 中国上市战役主视觉',
    metric: 'Z 世代',
    metricLabel: '替一个陌生食品品类打开市场',
    summary: '玉米片在中国是个陌生品类。我们面向 Z 世代做传播，配上食物搭配内容，把微信、小红书和微博一起铺开。',
    href: '/zh/work/mission-foods/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Camper 鞋履品牌中国社媒战役主视觉',
    metric: '18.7万',
    metricLabel: '粉丝，18 个月前还是 4.3 万',
    summary: '这家欧洲鞋履品牌，18 个月里粉丝从 4.3 万做到 18.7 万，互动率从 1.2% 拉到 4.7%，同店销售同比多了 31%。',
    href: '/zh/work/camper/',
  },
];

const faqs = [
  {
    q: '开公众号，一定要有中国营业执照吗？',
    a: '不需要。海外公司凭海外营业执照就能注册服务号。要备的材料有三样：公司注册文件、法人身份证明、品牌所有权证明。真正要求中国主体的，只有订阅号、国内微信支付商户资质和部分广告形式。',
  },
  {
    q: '订阅号和服务号，差别在哪？',
    a: '订阅号天天能发，但被折叠进订阅消息栏，而且只对中国主体开放。服务号每月推送 4 次，直接进聊天列表，能挂自定义菜单、微信支付和 CRM 工具。海外公司自己能注册的只有服务号。对多数品牌来说，服务号本来就是更合适的选择。',
  },
  {
    q: '微信营销的预算怎么算？',
    a: '要分两笔看。一笔是代理费：我们按写明的工作范围收固定月费，签约前每项交付和总价都摆在台面上。另一笔是广告费：朋友圈广告走竞价，起步预算大约每天 1,000 元人民币；排期类优质广告位每档约 50,000 元人民币起。广告费永远单独结算，按原价走，零加价。',
  },
  {
    q: '开户加认证要多长时间？',
    a: '材料齐的话，注册加腾讯认证 1 到 2 周。最耽误事的是材料缺项或前后对不上，所以提交前我们会把全部文件先过一遍。已经有认证账号的，几天内就能开始发内容。',
  },
  {
    q: '我们在中国没有团队，能整盘交给你们吗？',
    a: '能，这也是我们客户里最典型的一种。上海和香港的团队每天替你把号跑起来：策略、内容、发布、评论区回复、广告，每月再交一份英文报告。你对接一位专属客户经理，全程透明，不用在中国多招一个人。',
  },
  {
    q: '账号和粉丝到底归谁？',
    a: '归你。账号以你的公司名义、用你的材料注册，我们只负责运营。合作哪天结束，账号、粉丝和全部内容存档都留在你手里。',
  },
  {
    q: '手上已有微信账号，能直接接手吗？',
    a: '能。先审计一轮：认证状态、粉丝质量、内容历史、合规风险。该补的补完，再接过发布工作。多数交接一周内走完，粉丝那头毫无察觉。',
  },
  {
    q: '先做微信，还是先做小红书、抖音？',
    a: '看你要什么。中国消费者在微信上阅读、提问、下单，它适合当大本营。小红书和抖音是负责拉新的发现型平台。我们多数客户的布阵：微信坐镇中枢，发现型平台在外围引流。',
  },
  {
    q: '私域流量是什么，为什么绕不开？',
    a: '私域流量，指那批你能直接触达、不用每次掏广告费的粉丝。做法很实在：把微信粉丝沉淀进企微社群和 1 对 1 会话。这份名单归你，算法再怎么改也收不走。',
  },
  {
    q: '效果怎么向我们汇报？',
    a: '每月一份说人话的报告：涨粉、阅读、互动、按原价列明的广告花费，以及可追踪的线索或销售。有问题，随时给你的专属客户经理留言。',
  },
];
---

<PageLayout
  title="微信代运营，团队常驻上海与香港 | TheRedScroll"
  description="微信全案代运营：公众号注册、内容、广告投放、小程序、CRM。团队常驻上海和香港。范围写明，价格固定。"
  lang="zh"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      微信
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">微</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">微信代运营</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            中国市场的增长，从把微信做扎实开始。
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            公众号注册、内容、广告投放、小程序、CRM。团队常驻上海和香港，每天在一线操盘。范围写明，价格固定。
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/zh/contact/">预约通话</Button>
            <Button variant="secondary-dark" href="#results">查看成果</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            30 分钟通话，不放推销 PPT。
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/wechat-agency/hero-phones-blend.webp"
            alt="两台手机展示真实微信界面：一条插在朋友圈信息流里的品牌赞助广告，和一个微信支付付款成功页"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            为什么先做微信
          </p>
          <p class="manifesto" data-manifesto>
            在中国，微信不是一个 App，它就是互联网本身。聊天、阅读、购物、付款，你的客户一步都不用离开。品牌不在微信上，在他们眼里就是<span class="manifesto-hl">隐形</span>的。
          </p>
        </div>
        <div>
          <img
            src="/images/wechat-agency/ecosystem-banner-tight.webp"
            alt="三台手机并排展示微信的三个面向：朋友圈信息流、公众号文章、微信支付支付成功页面"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            一个 App，三副面孔：社交信息流、内容渠道、支付工具。
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            一支团队，管起整个微信矩阵
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              一家微信代运营公司，要替你开账号、做内容、投广告、搭小程序。这些事自己上手，等于要招一支母语团队、吃透腾讯的规则、再通过中国账户去买广告。
            </p>
            <p>
              多数品牌把这摊事交给专业团队，走得更快，也走得更稳。我们就是这样一支团队，人在中国，每天都在<a href="/zh/platforms/wechat/" class="text-[#CC3333] hover:underline">微信</a>上发内容。
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            服务范围一览
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">微信营销服务</p>
