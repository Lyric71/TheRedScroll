---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="AI把游戏规则改了 | TheRedScroll"
  description="AI已经进到我们每一项服务、每一个平台、每一个客户项目里。策略和创意的判断仍然在人手里，其余的交给AI。"
  lang="zh"
>

  <!-- Hero — same pattern as about page: background image + dark overlay -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[500px] overflow-hidden">
    <img
      src="/images/ai/ai-hero.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.82]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        AI能力
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        AI把游戏规则改了。我们早就把它接进了日常工作。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        每项服务、每个平台、每个客户项目，都在用。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact">预约通话</Button>
        <Button variant="secondary-dark" href="#how-it-works">看具体怎么用</Button>
      </div>
    </div>
  </section>

  <!-- Intro — two-column, same as "Why we exist" on about page -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <!-- Left -->
        <div>
          <SectionBar />
          <SectionHeading overline="为什么是AI">我们不讲AI概念，我们把它真的放进每一项交付里。</SectionHeading>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            市场调研、社媒监测、数据报告、效果分析、项目管理、文案、图和视频。每一项服务，每个客户，每天都在用。
          </p>
        </div>
        <!-- Right -->
        <div class="flex flex-col pt-[48px] max-[640px]:pt-[0px]">
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] w-full">
            <p>
              这不是要替掉谁，而是让每个人都能把力气花在对的地方。重复的、耗时的活交给AI，团队把精力放在真正重要的东西上——策略、创意判断、客户关系。
            </p>
            <p>
              "说自己在用AI"和"真的在用AI"差别就在这里。
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- AI does the work — two-column with SVG illustration (same as "Our mission" on about) -->
  <section id="how-it-works" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="AI赋能工作流程的每一个环节">
          <svg viewBox="0 0 440 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Title -->
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">AI辅助工作流程</text>

            <!-- Step 1: Research -->
            <rect x="20" y="48" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="48" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="68" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">01</text>
            <text x="60" y="68" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">调研</text>
            <text x="40" y="86" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">AI筛查数千条帖子和竞争对手账号</text>
            <rect x="340" y="58" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="73" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">以小时计,非以周计</text>

            <!-- Arrow -->
            <line x1="220" y1="100" x2="220" y2="116" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,114 220,122 225,114" fill="#E8E0D8" />

            <!-- Step 2: Content -->
            <rect x="20" y="124" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="124" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="144" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">02</text>
            <text x="60" y="144" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">内容制作</text>
            <text x="40" y="162" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">AI撰写文案,通过HubStudio.ai生成视觉素材</text>
            <rect x="340" y="134" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="149" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">提速80%</text>

            <!-- Arrow -->
            <line x1="220" y1="176" x2="220" y2="192" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,190 220,198 225,190" fill="#E8E0D8" />

            <!-- Step 3: Review (human) -->
            <rect x="20" y="200" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#1A1A1A" stroke-width="1" />
            <rect x="20" y="200" width="4" height="52" rx="2" fill="#1A1A1A" />
            <text x="40" y="220" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif">03</text>
            <text x="60" y="220" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">人工审核</text>
            <text x="40" y="238" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">母语编辑润色修改,创意团队逐一审核。</text>
            <rect x="340" y="210" width="68" height="22" rx="4" fill="#1A1A1A" opacity="0.08" stroke="#1A1A1A" stroke-width="0.5" />
            <text x="374" y="225" text-anchor="middle" fill="#1A1A1A" font-size="7" font-weight="500" font-family="Inter, sans-serif">100%人工</text>

            <!-- Arrow -->
            <line x1="220" y1="252" x2="220" y2="268" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,266 220,274 225,266" fill="#E8E0D8" />

            <!-- Step 4: Reporting -->
            <rect x="20" y="276" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="276" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="296" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">04</text>
            <text x="60" y="296" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">数据报告</text>
            <text x="40" y="314" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">AI汇总数据,策略师负责解读分析。</text>
            <rect x="340" y="286" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="301" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">实时数据</text>

            <!-- Bottom stats -->
            <line x1="20" y1="348" x2="420" y2="348" stroke="#E8E0D8" stroke-width="0.5" />

            <g transform="translate(20, 364)">
              <text x="0" y="12" fill="#CC3333" font-size="18" font-weight="500" font-family="Inter, sans-serif">AI</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">承担大量重复工作</text>
            </g>
            <g transform="translate(150, 364)">
              <text x="0" y="12" fill="#1A1A1A" font-size="18" font-weight="500" font-family="Inter, sans-serif">团队</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">掌控策略与思考</text>
            </g>
            <g transform="translate(310, 364)">
              <text x="0" y="12" fill="#1A1A1A" font-size="18" font-weight="500" font-family="Inter, sans-serif">100%</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">人工审核把关</text>
            </g>
          </svg>
        </div>
        <div>
          <SectionBar />
          <SectionHeading overline="具体怎么跑的">AI负责干活，我们负责拿主意。</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              社媒团队每天都在用AI。那些费时间、不产生价值的重复工作被一刀切掉，剩下的都是真正值得人去做的事。
            </p>
            <p>
              策略、创意方向、客户关系这三块始终在人手里。AI的作用是把前面的路障清掉，让这三件事跑得更快。
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- AI vs Human table — two-column with SVG on right (same as "Our vision" on about, reversed) -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="谁做什么">AI做批量，团队拿方向。</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              AI用中文和英文写内容，团队定品牌tone和内容主线。AI生成图片、视频素材，团队把创意方向盯住，每一个元素过完才发。
            </p>
            <p>
              AI把各平台的数据汇成结构化报告，策略师深入解读、调整打法。KOL那边，AI扫几千份资料、挑出假粉账号，最后由团队选人、谈合作。
            </p>
          </div>
          <!-- Callout — same pattern as about page "Our vision" callout -->
          <div class="bg-[#F0F1F4] border-l-[3px] border-[#CC3333] rounded-none p-[20px] mt-[24px]">
            <p class="text-[16px] font-normal text-[#1A1A1A] leading-[1.6] m-0">
              每一条内容在发出去之前都有人过，没有例外。
            </p>
          </div>
        </div>
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="AI与团队的职责分工">
          <svg viewBox="0 0 440 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Title -->
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">分工明细</text>

            <!-- Column headers -->
            <rect x="20" y="44" width="196" height="28" rx="4" fill="#CC3333" opacity="0.1" />
            <text x="118" y="62" text-anchor="middle" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">AI负责</text>
            <rect x="224" y="44" width="196" height="28" rx="4" fill="#1A1A1A" opacity="0.06" />
            <text x="322" y="62" text-anchor="middle" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">团队负责</text>

            <!-- Row 1 -->
            <line x1="20" y1="84" x2="420" y2="84" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="102" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">撰写中英文内容</text>
            <text x="232" y="102" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">确立品牌调性和内容支柱</text>

            <!-- Row 2 -->
            <line x1="20" y1="116" x2="420" y2="116" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="134" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">制作视觉素材和视频</text>
            <text x="232" y="134" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">把关创意方向,逐一审核每个元素</text>

            <!-- Row 3 -->
            <line x1="20" y1="148" x2="420" y2="148" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="166" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">汇总各平台绩效数据</text>
            <text x="232" y="166" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">深入解读数据并调整策略</text>

            <!-- Row 4 -->
            <line x1="20" y1="180" x2="420" y2="180" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="198" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">监控品牌提及并识别趋势</text>
            <text x="232" y="198" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">决定利用哪些趋势以及如何利用</text>

            <!-- Row 5 -->
            <line x1="20" y1="212" x2="420" y2="212" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="230" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">跟踪进度和审批流程</text>
            <text x="232" y="230" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">主持工作坊,提出关键问题</text>

            <!-- Row 6 -->
            <line x1="20" y1="244" x2="420" y2="244" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="262" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">筛查数千条竞品内容</text>
            <text x="232" y="262" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">选择适合目标受众的平台</text>

            <!-- Row 7 -->
            <line x1="20" y1="276" x2="420" y2="276" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="294" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">起草月度报告初稿</text>
            <text x="232" y="294" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">提出战略建议</text>

            <!-- Row 8 -->
            <line x1="20" y1="308" x2="420" y2="308" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="326" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">筛选KOL资料,识别虚假粉丝</text>
            <text x="232" y="326" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">选定达人,洽谈合作</text>
            <line x1="20" y1="340" x2="420" y2="340" stroke="#E8E0D8" stroke-width="0.5" />

            <!-- Bottom summary -->
            <g transform="translate(20, 360)">
              <rect x="0" y="0" width="196" height="40" rx="6" fill="#CC3333" opacity="0.08" />
              <text x="98" y="17" text-anchor="middle" fill="#CC3333" font-size="14" font-weight="500" font-family="Inter, sans-serif">速度与规模</text>
              <text x="98" y="32" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">批量处理、数据整合、初稿生成</text>
            </g>
            <g transform="translate(224, 360)">
              <rect x="0" y="0" width="196" height="40" rx="6" fill="#1A1A1A" opacity="0.06" />
              <text x="98" y="17" text-anchor="middle" fill="#1A1A1A" font-size="14" font-weight="500" font-family="Inter, sans-serif">判断与洞察</text>
              <text x="98" y="32" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">策略、文化适配、客户关系</text>
            </g>
          </svg>
        </div>
      </div>
    </Container>
  </section>

  <!-- Better content — rice paper card, same as about page "clients who trust" stats section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#F0F1F4] rounded-[10px] p-[48px] max-[640px]:p-[32px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[24px] text-center">内容要的是质感，不是机器堆量</p>
        <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[32px] max-[640px]:gap-[24px] text-center">
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]">0</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">AI生成内容直接发出去的条数</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]">100%</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">内容都过人工</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#CC3333] mb-[4px]">每一条文案</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">都由本地中文编辑改过</p>
          </div>
        </div>
        <div class="max-w-[680px] mx-auto mt-[32px] flex flex-col gap-[24px] text-center">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            我们不发AI味儿的内容。没有千篇一律的帖子，没有生硬的文案，也没有那种直接塞进信息流的AI图。在国内社媒上，这是掉粉、掉口碑最快的方式。
          </p>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">
            AI先出初稿，本地编辑一条一条改过。HubStudio.ai出视觉素材，创意团队一张一张过。AI抓数据做报告，策略师解读完再告诉你要看哪里。
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Where AI shows up — numbered cards, same as about page "Our values" grid -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="用在哪里">AI实际落在哪几个环节</SectionHeading>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-market-research.svg" alt="市场调研示意图" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">市场调研</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">AI几个小时就能扫完几千条帖子、评论、竞品账号。以前这事要花一到两周。</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-social-listening.svg" alt="社交舆情监测示意图" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">舆情监测</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">覆盖微信、抖音、小红书、微博等14个以上平台。AI实时抓趋势、情绪、品牌提及。</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-content-writing.svg" alt="内容撰写示意图" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
