---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="AI改写了规则 | TheRedScroll"
  description="AI 早就长在我们的每一项服务、每一个平台、每一个客户项目里。策略和创意永远是人来拍板，其余的交给机器。"
  lang="zh"
>

  <!-- Hero — same pattern as about page: background image + dark overlay -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[500px] overflow-hidden">
    <img
      src="/images/ai/ai-hero.webp"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.82]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        AI 能力
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        AI 已经改写了规则。我们早把它揉进了日常。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        每项服务、每个平台、每个客户都在跑。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact/">预约通话</Button>
        <Button variant="secondary-dark" href="#how-it-works">看怎么跑</Button>
      </div>
    </div>
  </section>

  <!-- Intro — two-column, same as "Why we exist" on about page -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <!-- Left -->
        <div>
          <SectionBar />
          <SectionHeading overline="为什么是 AI">不谈概念，直接落到每一份交付里。</SectionHeading>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            市场调研、舆情监测、数据报表、效果复盘、项目排期、文案、图片、视频。这些每天都在跑，每个客户都在用。
          </p>
        </div>
        <!-- Right -->
        <div class="flex flex-col pt-[48px] max-[640px]:pt-[0px]">
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] w-full">
            <p>
              AI 不是来替掉谁，而是让每个人把力气都使在对的地方。重复、耗时的活儿丢给 AI，团队就能腾出脑子去做真正值钱的事：策略、创意判断、客户关系。
            </p>
            <p>
              "号称在用 AI"和"真在用 AI"，差的就是这一步。
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- AI does the work — two-column with SVG illustration (same as "Our mission" on about) -->
  <section id="how-it-works" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="AI 跑通工作流程的每一个环节">
          <svg viewBox="0 0 440 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Title -->
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">AI 辅助工作流程</text>

            <!-- Step 1: Research -->
            <rect x="20" y="48" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="48" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="68" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">01</text>
            <text x="60" y="68" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">调研</text>
            <text x="40" y="86" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">AI 扫几千条帖子和竞品账号</text>
            <rect x="340" y="58" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="73" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">以小时计，不是按周</text>

            <!-- Arrow -->
            <line x1="220" y1="100" x2="220" y2="116" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,114 220,122 225,114" fill="#E8E0D8" />

            <!-- Step 2: Content -->
            <rect x="20" y="124" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="124" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="144" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">02</text>
            <text x="60" y="144" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">内容制作</text>
            <text x="40" y="162" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">AI 起文案，HubStudio.ai 出视觉</text>
            <rect x="340" y="134" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="149" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">提速 80%</text>

            <!-- Arrow -->
            <line x1="220" y1="176" x2="220" y2="192" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,190 220,198 225,190" fill="#E8E0D8" />

            <!-- Step 3: Review (human) -->
            <rect x="20" y="200" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#1A1A1A" stroke-width="1" />
            <rect x="20" y="200" width="4" height="52" rx="2" fill="#1A1A1A" />
            <text x="40" y="220" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif">03</text>
            <text x="60" y="220" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">人工把关</text>
            <text x="40" y="238" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">本地编辑改稿，创意团队一条条过</text>
            <rect x="340" y="210" width="68" height="22" rx="4" fill="#1A1A1A" opacity="0.08" stroke="#1A1A1A" stroke-width="0.5" />
            <text x="374" y="225" text-anchor="middle" fill="#1A1A1A" font-size="7" font-weight="500" font-family="Inter, sans-serif">100% 人工</text>

            <!-- Arrow -->
            <line x1="220" y1="252" x2="220" y2="268" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,266 220,274 225,266" fill="#E8E0D8" />

            <!-- Step 4: Reporting -->
            <rect x="20" y="276" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="276" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="296" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">04</text>
            <text x="60" y="296" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">数据报表</text>
            <text x="40" y="314" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">AI 拉数据，策略师负责读懂</text>
            <rect x="340" y="286" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="301" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">实时更新</text>

            <!-- Bottom stats -->
            <line x1="20" y1="348" x2="420" y2="348" stroke="#E8E0D8" stroke-width="0.5" />

            <g transform="translate(20, 364)">
              <text x="0" y="12" fill="#CC3333" font-size="18" font-weight="500" font-family="Inter, sans-serif">AI</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">扛下重复工作</text>
            </g>
            <g transform="translate(150, 364)">
              <text x="0" y="12" fill="#1A1A1A" font-size="18" font-weight="500" font-family="Inter, sans-serif">团队</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">拿策略和方向</text>
            </g>
            <g transform="translate(310, 364)">
              <text x="0" y="12" fill="#1A1A1A" font-size="18" font-weight="500" font-family="Inter, sans-serif">100%</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">人工审核</text>
            </g>
          </svg>
        </div>
        <div>
          <SectionBar />
          <SectionHeading overline="具体怎么跑">AI 干活，我们拿主意。</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              社媒团队天天用 AI。那些又费时间又没价值的重复活儿，一刀切掉；剩下的，全是真正值得人做的事。
            </p>
            <p>
              策略、创意方向、客户关系，这三块永远攥在人手里。AI 的角色，是把路障搬开，让这三件事跑得更快。
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- AI vs Human table — two-column with SVG on right (same as "Our vision" on about, reversed) -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="谁做什么">AI 跑批量，团队定方向。</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              AI 出中英文稿子，团队定品牌调性和内容主线。AI 生成图片和短视频素材，团队盯死创意方向，每个元素都过一遍才放出去。
            </p>
            <p>
              AI 把各平台数据汇成结构化报表，策略师再深读、再调打法。KOL 这块，AI 扫几千份资料、揪出假粉账号，最后还是由人来选人、谈合作。
            </p>
          </div>
          <!-- Callout — same pattern as about page "Our vision" callout -->
          <div class="bg-[#F0F1F4] border-l-[3px] border-[#CC3333] rounded-none p-[20px] mt-[24px]">
            <p class="text-[16px] font-normal text-[#1A1A1A] leading-[1.6] m-0">
              每条内容发出去之前，都有人过手。一条不漏。
            </p>
          </div>
        </div>
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="AI 与团队的分工">
          <svg viewBox="0 0 440 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Title -->
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">分工一览</text>

            <!-- Column headers -->
            <rect x="20" y="44" width="196" height="28" rx="4" fill="#CC3333" opacity="0.1" />
            <text x="118" y="62" text-anchor="middle" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">AI 负责</text>
            <rect x="224" y="44" width="196" height="28" rx="4" fill="#1A1A1A" opacity="0.06" />
            <text x="322" y="62" text-anchor="middle" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">团队负责</text>

            <!-- Row 1 -->
            <line x1="20" y1="84" x2="420" y2="84" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="102" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">起中英文内容</text>
            <text x="232" y="102" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">定品牌调性和内容主线</text>

            <!-- Row 2 -->
            <line x1="20" y1="116" x2="420" y2="116" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="134" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">出图片和短视频素材</text>
            <text x="232" y="134" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">盯创意方向，逐项审核</text>

            <!-- Row 3 -->
            <line x1="20" y1="148" x2="420" y2="148" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="166" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">汇总各平台数据</text>
            <text x="232" y="166" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">读懂数据，调整打法</text>

            <!-- Row 4 -->
            <line x1="20" y1="180" x2="420" y2="180" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="198" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">盯品牌提及，抓趋势</text>
            <text x="232" y="198" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">挑哪些趋势能用，怎么用</text>

            <!-- Row 5 -->
            <line x1="20" y1="212" x2="420" y2="212" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="230" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">跟进度，跑审批流程</text>
            <text x="232" y="230" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">主持工作坊，问对问题</text>

            <!-- Row 6 -->
            <line x1="20" y1="244" x2="420" y2="244" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="262" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">扫几千条竞品内容</text>
            <text x="232" y="262" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">挑出最对的平台</text>

            <!-- Row 7 -->
            <line x1="20" y1="276" x2="420" y2="276" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="294" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">起月度报表初稿</text>
            <text x="232" y="294" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">给出战略建议</text>

            <!-- Row 8 -->
            <line x1="20" y1="308" x2="420" y2="308" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="326" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">扫 KOL 资料，揪假粉</text>
            <text x="232" y="326" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">选人，谈合作</text>
            <line x1="20" y1="340" x2="420" y2="340" stroke="#E8E0D8" stroke-width="0.5" />

            <!-- Bottom summary -->
            <g transform="translate(20, 360)">
              <rect x="0" y="0" width="196" height="40" rx="6" fill="#CC3333" opacity="0.08" />
              <text x="98" y="17" text-anchor="middle" fill="#CC3333" font-size="14" font-weight="500" font-family="Inter, sans-serif">速度和规模</text>
              <text x="98" y="32" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">批量处理、数据汇总、起初稿</text>
            </g>
            <g transform="translate(224, 360)">
              <rect x="0" y="0" width="196" height="40" rx="6" fill="#1A1A1A" opacity="0.06" />
              <text x="98" y="17" text-anchor="middle" fill="#1A1A1A" font-size="14" font-weight="500" font-family="Inter, sans-serif">判断和洞察</text>
              <text x="98" y="32" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">策略、文化、客户关系</text>
            </g>
          </svg>
        </div>
      </div>
    </Container>
  </section>

  <!-- Better content — rice paper card, same as about page "clients who trust" stats section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#F0F1F4] rounded-[10px] p-[48px] max-[1024px]:p-[32px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[24px] text-center">内容拼的是质感，不是机器堆量</p>
        <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[32px] max-[640px]:gap-[24px] text-center">
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]">0</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">直接发出的 AI 原稿数</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]">100%</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">内容全部经人工审核</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#CC3333] mb-[4px]">每条文案</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">都由本地中文编辑亲手改过</p>
          </div>
        </div>
        <div class="max-w-[680px] mx-auto mt-[32px] flex flex-col gap-[24px] text-center">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            我们不发一眼就透着 AI 味儿的内容。没有千篇一律的帖子，没有生硬的文案，更没有那种直接塞进信息流的 AI 图。在国内社媒，这是掉粉、砸口碑最快的路子。
          </p>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">
            AI 先起稿，本地编辑一条条改；HubStudio.ai 出视觉，创意团队一张张过；AI 拉数据，策略师读完才告诉你重点在哪。
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Where AI shows up — numbered cards, same as about page "Our values" grid -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="用在哪里">AI 到底落在哪几个环节</SectionHeading>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-market-research.svg" alt="市场调研示意图" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">市场调研</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">几个小时，AI 就把几千条帖子、评论和竞品账号扫完。搁以前，这活儿得一到两周。</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-social-listening.svg" alt="社交舆情监测示意图" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">舆情监测</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">覆盖微信、抖音、小红书、微博等 14 个以上平台。AI 实时抓趋势、情绪和品牌提及。</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-content-writing.svg" alt="内容撰写示意图" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
