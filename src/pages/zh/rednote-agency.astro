    href: '/zh/work/mission-foods/',
  },
];

const faqs = [
  {
    q: '小红书、RedNote、Little Red Book 是同一个平台吗？',
    a: '是。小红书是官方中文名，Little Red Book 是它的英文直译。公司早年在国际上用 RED，2025 年 1 月起正式启用 RedNote 作为官方英文名。Xiao Hong Shu 只是把拼音拆成三个词的写法。一个 App，一套算法，一群用户。',
  },
  {
    q: '海外品牌能在小红书上卖货吗？',
    a: '能。海外企业凭营业执照翻译件加商标文件就能开专业号（蓝V），不需要中国主体。平台的跨境电商项目还允许海外品牌开站内店铺、直接跨境发货。材料、开店、平台审核，全流程我们接。',
  },
  {
    q: '小红书营销要花多少钱？',
    a: '三笔预算要分开看。代理费：按明确工作范围报一个固定月费，签约前每项交付和总价都摆在桌面上。广告费：通过聚光平台单独结算，按原价走，零加价。达人费用：随粉丝量级和品类浮动，跨度很大，我们透明转付，每次合作背后都有经过查证的互动数据。',
  },
  {
    q: '多久能看到效果？',
    a: '这个平台不奖励急性子。新账号要过算法观察期，前 2 到 3 个月用来积累内容库、让算法认识你的品类。付费广告和达人投放第一周就能把流量带起来，先顶住，等自然流量跟上。我们的最短合作期是 3 个月，原因就在这。',
  },
  {
    q: '需要中国营业执照或主体吗？',
    a: '开账号不需要，海外营业执照的翻译件就够开专业号。付费投放是例外：聚光平台开广告账户需要中国主体。我们通过自己的本地架构替海外客户代开代管广告账户，每周出花费报告，全程透明。',
  },
  {
    q: '小红书的用户是谁？他们用它做什么？',
    a: '每月约 3.5 亿人在用小红书。核心用户年轻、集中在城市、约七成为女性，消费力可观。他们把小红书当搜索引擎用，查的是真实的产品体验：买什么、去哪儿、什么真的好用。正是这种购买意图，让重转化的品牌把第一站放在这里。',
  },
  {
    q: '小红书和抖音，我的品牌该先做哪个？',
    a: '两者分工不同。抖音是算法快速推流的娱乐短视频，擅长冲曝光、促成冲动消费。小红书节奏慢、由搜索驱动：用户下单前先做功课，一篇好笔记能连续几个月带来流量。美妆、服饰、旅行这类决策周期长的品类，通常先做小红书。多数品牌最后两个都做。',
  },
  {
    q: '小红书的达人投放怎么做？',
    a: '付费合作必须走官方交易平台蒲公英，私下接单的笔记随时可能被下架。我们依据可查证的受众数据筛人，需求沟通、合同、结算、逐篇复盘全由我们负责。在小红书，几十篇小博主的真实测评往往胜过一条明星帖。',
  },
  {
    q: '内容可以用英文写吗？',
    a: '中国用户用中文搜索，英文笔记几乎拿不到曝光。我们发布的内容全部由上海团队用中文原创，不做翻译。英文只够触达 2025 年初涌入的那一小批海外用户。想在中国卖货，这仍然是个中文平台。',
  },
  {
    q: '什么样的笔记在小红书上能起量？',
    a: '标题埋进搜索关键词，封面图足够抓人，通篇像一条真实的第一人称推荐。硬广口吻会被算法压流量，未报备的商业内容有下架风险，所以商业笔记我们一律通过平台正规报备。每篇笔记围绕关键词规划来写，发布后持续盯排名。',
  },
];
---

<PageLayout
  title="小红书代运营 | RedNote（Little Red Book）营销"
  description="在小红书（RedNote / Little Red Book）上做品牌增长。KOL 投放、内容、广告，团队常驻上海。范围写死，价格固定。预约通话。"
  lang="zh"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">红</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">小红书代运营</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            小红书（RedNote / Little Red Book）营销代运营
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            一个平台，四个名字，3.5 亿+月活。我们替西方品牌在小红书上跑 KOL 投放、内容、广告和社交电商。团队在上海，天天在平台上操盘。范围写死，价格固定。
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/zh/contact/">预约通话</Button>
            <Button variant="secondary-dark" href="#results">查看成果</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            30 分钟通话，没有推销 PPT。
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/rednote-agency/hero-phones-blend.webp"
            alt="两台手机显示真实小红书 App：笔记发现页和一篇产品测评笔记"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            为什么种草要先跑小红书
          </p>
          <p class="manifesto" data-manifesto>
            在中国，消费从小红书上的一次搜索开始。3.5 亿人花钱之前先看真实测评。在这里，让人下单的不是广告，是<span class="manifesto-hl">信任</span>。能攒下信任的笔记、测评和达人声音，我们来做。
          </p>
        </div>
        <div>
          <img
            src="/images/rednote-agency/ecosystem-banner-tight.webp"
            alt="三台手机展示小红书的用户路径：发现页、产品测评笔记、搜索结果"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            一个 App，三重角色：发现信息流、真实测评、站内搜索。
          </figcaption>
        </div>
      </figure>

