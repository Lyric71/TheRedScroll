const pillars = [
  {
    title: 'SOW 写明白',
    description: '每项交付提前定死：笔记几篇、视频几条、达人合作几场、报告几份。每个月拿到什么，一清二楚。',
  },
  {
    title: '价格固定，没有意外',
    description: '一个套餐一个价。不按工时跳表，不收超范围加项费，也不会冒出你没见过的账单。',
  },
  {
    title: 'AI 加持的内容产能',
