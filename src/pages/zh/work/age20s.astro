---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campaign', '内容制作', 'KOL项目', '社媒'];
const platforms = ['小红书', '抖音'];

const stats = [
  { value: '387万', label: '抖音曝光（目标100万）' },
  { value: '75万', label: '小红书曝光（目标30万）' },
  { value: '3.3%', label: 'ROI，高于行业基准' },
  { value: '4倍', label: '抖音目标超额完成' },
];
---

<PageLayout
  title="AGE 20's小奶砖中国战役 | TheRedScroll"
  description="AGE 20's怎么在中国推出小奶砖气垫粉底。抖音曝光387万，小红书75万，产品昵称在用户里自发传开。"
  ogImage="/images/clients/Age20/Age20-Picture1-scaled.jpg"
  lang="zh"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Age20/Age20-Picture1-scaled.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        客户案例
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        AGE 20's：小奶砖中国战役。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        AGE 20's要在全球最卷的美妆市场之一推一款粉底。小奶砖这一场战役，在抖音上直接超出目标4倍。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact">预约通话</Button>
        <Button variant="secondary-dark" href="#case-study">看完整案例</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">客户背景</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">AGE 20's</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">行业</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">美妆 / 化妆品</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">服务内容</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">平台</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- 客户背景 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="客户背景">韩国美妆品牌。饱和市场。只有一次机会把定位立住。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              AGE 20's是一个面向职场女性的韩国专业级美妆品牌。这次在中国推的是一款新的气垫粉底：小奶砖。奶雾哑光妆效、持妆8小时、甜品风的包装。产品本身够好，切入的角度也够特别。
            </p>
            <p>
              难的是怎么被看见。国内的粉底市场已经卷到极致。AGE 20's需要一场战役，把这款产品立成专业级的高端选项，而不是又一款气垫粉底。同时这是一个每年都会做的常规项目，今年的动作会变成明年迭代的底子。第一年必须把品牌认知打对。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Campaign visuals -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/Age20/Age20-Picture1-scaled.jpg"
        alt="AGE 20's小奶砖营销主视觉与产品包装"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Age20/Age20-Picture6.jpg"
        alt="AGE 20's小奶砖小红书和抖音社交内容"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Age20/Age20-Picture11.png"
        alt="AGE 20's KOL营销与用户原创内容成果"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        AGE 20's小奶砖战役。产品视觉、KOL内容和小红书、抖音的社媒素材。
      </p>
    </Container>
  </section>

  <!-- 服务内容 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="服务内容">四个阶段的战役，围绕一个过目难忘的名字展开。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们在小红书和抖音上做了一场分阶段的战役，小奶砖这个身份从头到尾贯穿全场。
            </p>
          </div>
        </div>

        <!-- The name -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">名字本身就把大部分传播的活干了</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们围绕这个名字做了一整套视觉和语言风格。产品包装是每条内容的主角。这样就给了用户一个她们自己会记住、愿意主动说出来的名字。
            </p>
          </div>
        </div>

        <!-- Four phases -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">四个阶段，每个阶段的活都不一样</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              预热期在官方账号上把小奶砖的视觉世界铺开，让用户先眼熟。上市期切进真实的职场场景：办公室里的女生、会议间隙、通勤路上。在真实环境里验证持妆效果。
            </p>
            <p>
              转化期正好卡在购物高峰，这时候激活KOL合作。种草要出现在用户最想下单的那一刻。维护期把用户自发的笔记和内容放大，让话题在上市之后还能继续发酵。
            </p>
          </div>
        </div>

        <!-- Platform content -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">每个平台的内容都不一样</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              小红书：详细的教程和使用前后对比。抖音：办公室快速补妆、职场美妆小技巧。节奏快、视觉强，贴合每个平台用户真实的使用习惯。
            </p>
          </div>
        </div>

        <!-- HubStudio callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            HubStudio.ai让内容生产线跑得更顺。产品视觉、社媒素材、创意衍生。出得更快，质感不妥协。
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- Stats grid -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {stats.map((stat) => (
          <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">{stat.value}</p>
            <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 项目成果 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="项目成果">昵称自发在用户里传开。这在今天的中国美妆市场上，几乎不会自然发生。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              所有目标都被大幅超越。小红书做到75万曝光，目标是30万。抖音累计387万曝光，目标是100万。ROI做到3.3%，高于行业基准。
            </p>
            <p>
              但真正起作用的是这件事：小奶砖这个昵称在用户里自己传开了。消费者开始在自己的笔记里主动用这个名字，没有人要求她们这么做，也没有任何付费推广。我们打进用户心里的认知，变成了她们自然而然的说法。在这么卷的市场里，这种自发传播几乎不会发生。
            </p>
            <p>
              AGE 20's从一个功能型美妆品牌，升级成了专业级的高端美妆品牌。因为这个项目每年都会迭代复用，我们在第一年打下的基础后来一直在继续产生回报。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[640px]:p-[32px] text-center">
        <SectionHeading overline="下一个就是你">想在中国社媒上做一场产品上市战役？</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          范围固定，一口价，团队就在本地。
        </p>
        <Button variant="primary" href="/zh/contact">预约通话</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
