---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['咨询', '策略', '社媒', '内容'];
const platforms = ['小红书', '抖音', '微信', '天猫'];
---

<PageLayout
  title="Langnese中国咨询 | TheRedScroll"
  description="TheRedScroll如何帮助德国第一蜂蜜品牌Langnese重新定位以实现中国市场增长。消费者研究、全新定位与平台化社交策略。"
  ogImage="/images/clients/Langnese/Langnese-Honey.png"
  lang="zh"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Langnese/Langnese-Honey.png')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        客户案例
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Langnese：德国第一蜂蜜品牌在中国重新定位。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Langnese想在国内做增长。我们做了消费者调研、重塑了品牌定位、搭了一套打开新渠道和新人群的社媒策略。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact">预约通话</Button>
        <Button variant="secondary-dark" href="#case-study">看案例详情</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">客户背景</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Langnese</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">行业</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">食品 / 快消</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">服务内容</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">平台</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- 客户背景 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="客户背景">百年历史。准备在中国加速增长。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Langnese是德国排名第一的蜂蜜品牌，拥有超过一百年的历史。在中国，分销渠道已经打通，货架位置已经拿到，经销商关系也已建立。
            </p>
            <p>
              但品牌知道自己可以做得更多。机会就在眼前。需要的是更精准的定位和一套专为中国消费者设计的社交策略。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Visuals -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/Langnese/Langnese-Honey.png"
        alt="Langnese蜂蜜中国市场产品线"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Langnese/Langnese-Douyin-Livestream.jpg"
        alt="Langnese抖音直播展示蜂蜜产品"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Langnese/Langnese-Tmall-2.png"
        alt="Langnese天猫旗舰店全新品牌定位"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Langnese在中国。产品线、抖音直播与天猫旗舰店。
      </p>
    </Container>
  </section>

  <!-- 调研发现 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="调研发现">市场已经变了。Langnese多年来一直在用同样的方式卖蜂蜜。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们做了全面的梳理。从进口到货架，绘制了完整的分销链路。分析了中国蜂蜜品牌在小红书、抖音、微信和天猫上的表现。在一线和二线城市开展了消费者调研。
            </p>
            <p>
              在一线城市，泛泛的健康叙事已经不管用了。每个蜂蜜品牌都在讲健康。本土竞品在包装、定价和社交内容上已经明显提升。在二线城市，消费者不理解为什么要为进口蜂蜜多付一倍的价格，本土品牌明明只要一半的钱。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- 服务内容 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="服务内容">九大增长支柱。可以立即执行。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们制定了一套涵盖品牌重新定位、渠道布局、产品规格和社交内容的完整框架。共九个增长支柱。
            </p>
          </div>
        </div>

        <!-- Consumer groups -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">没有人在触达的消费群体</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              在咖啡或果昔中加蜂蜜的年轻职场人。寻找天然糖替代品的家长。把蜂蜜当食材使用的烹饪爱好者。每个群体都获得了扎根于日常场景的具体消费理由。
            </p>
          </div>
        </div>

        <!-- Repositioning -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">围绕具体卖点的重新定位</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              不再把"德国品质"当标题。换成了具体的、与使用场景挂钩的理由。为什么某种风味适合特定菜式。为什么质地在热饮中表现不同。真正的产品卖点，而不是原产国的空泛宣传。
            </p>
          </div>
        </div>

        <!-- Social strategy -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">逐平台重建社交策略</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              RedNote用于食谱融入和日常使用场景。抖音用于快速演示新的食用方法。微信用于品牌故事讲述。目标不是提醒人们Langnese的存在，而是改变人们每天对蜂蜜的思考方式。
            </p>
          </div>
        </div>

        <!-- Distribution + formats -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">新渠道与新产品规格</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们在品牌此前缺席的区域打开了新的分销渠道。并推荐了新的产品规格：小包装用于试用、独立便携装适合办公场景、全新包装设计在货架上传达新定位。
            </p>
          </div>
        </div>

        <!-- Callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            九大增长支柱经品牌方和经销商共同确认，设计为可立即执行。
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- 项目成果 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="项目成果">新定位。新渠道。新增长。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              重新定位奏效了。新渠道打开了。经销商的积极性被调动起来了。
            </p>
            <p>
              经销商从数据中看到了变化。Langnese不再是"那个贵的德国蜂蜜"，而是融入了早晨的果昔、周末的烘焙和孩子的下午茶。真实的购买理由，扎根于消费者的日常生活。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[640px]:p-[32px] text-center">
        <SectionHeading overline="下一个就是你">需要针对中国市场的品牌策略咨询？</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          固定范围。固定价格。本地团队。
        </p>
        <Button variant="primary" href="/zh/contact">预约通话</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
