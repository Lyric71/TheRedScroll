---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campaign', '内容制作', '社媒', 'AI内容'];
const platforms = ['微信', '小红书', '微博'];
---

<PageLayout
  title="JAC江淮 中国社媒案例 | TheRedScroll"
  description="JAC江淮怎么在微信、小红书、微博搭起一个真正活跃的品牌社群。AI内容、奥运战役，以及从国内一路传到海外的影响力。"
  ogImage="/images/clients/JAC/JAC-Wechat-4.jpg"
  lang="zh"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/JAC/JAC-Wechat-4.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        客户案例
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        JAC江淮：帮一家国内车企把社群真正做起来。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        JAC要的远不止"每天发帖"这件事。我们在微信、小红书、微博搭起了一个真正的品牌社群，再用AI驱动的内容把影响力带出了国门。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact">预约通话</Button>
        <Button variant="secondary-dark" href="#case-study">查看案例</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">客户背景</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">JAC Motors</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">行业</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">汽车 / 新能源</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">服务内容</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">平台</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- 客户背景 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="客户背景">累计销量1000万辆，社媒表现却差得远。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              JAC是中国最大的汽车制造商之一。三十多年的积累，全球累计销量超过1000万辆。乘用车、新能源车、商用车都有。规模大，底子厚。
            </p>
            <p>
              可他们的社媒完全没把这些体现出来。微信、小红书、微博每天都在按时更新。问题是几乎没人真在互动。评论很少，转发更少，完全没有社群的感觉。
            </p>
            <p>
              一家这种体量的企业，市场地位和社媒表现之间的落差，已经大到没法再忽视。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- WeChat content — horizontal scroll -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/JAC/JAC-Wechat.jpg"
        alt="JAC Motors微信公众号文章：E30X阿联酋发布"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-1.jpg"
        alt="JAC Motors微信公众号文章：媒体报道与RCEP论坛"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-2.jpg"
        alt="JAC Motors微信公众号文章：AI创作的J-Bot奥运营销"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-3.jpg"
        alt="JAC Motors微信公众号文章：巴黎奥运中国红主题"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        微信内容：新车发布、奥运Campaign和全球化叙事。左右滑动查看更多。
      </p>
    </Container>
  </section>

  <!-- 服务内容 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="服务内容">内容从零开始重做，让社群真的有归属感。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们接手了三个平台的内容运营。JAC要的不是多发几条帖子，而是要真正成为汽车圈愿意主动关注的品牌。他们想要的，是一个建立在信任和身份认同上的社群。
            </p>
            <p>
              所以我们把内容从零重做，围绕三条主线：过硬的汽车专业知识，JAC内部和周边的人物故事，还有和用户真正的对话，不再是品牌自说自话。
            </p>
          </div>
        </div>

        <!-- AI -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">AI贯穿整个内容生产流程</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们用HubStudio.ai产出定制化视觉内容，速度比传统做法快很多。AI也负责三个平台的数据监测，让我们当下就能看出哪条内容跑得动，同一周内就能调好。
            </p>
            <p>
              创意团队按平台分别做内容。微信上的内容和小红书上的完全是两回事。格式不同，语气不同，用户也不同。
            </p>
          </div>
        </div>

        <!-- Content strategy -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">让人愿意停下来看的内容</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们把JAC的定位重新做成一个真正的汽车知识输出者。技术解析、生产线幕后、车主真实用车故事。那种让人愿意停下来认真看完的内容。
            </p>
            <p>
              头几个月得耐着性子做。但变化慢慢就看得出来了。评论越写越长。用户开始@自己的朋友。转发量也上来了。账号从一个只负责对外广播的企业号，变成了用户愿意主动回来看的地方。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Campaign visuals — full width -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <img
        src="/images/clients/JAC/JAC-Wechat-4.jpg"
        alt="JAC Motors E30X与奥运运动员Nuria Diosdado的联名营销"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-5.jpg"
        alt="JAC Motors伊拉克市场发布活动"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        全球化营销内容：E30X运动员联名，以及伊拉克市场发布。
      </p>
    </Container>
  </section>

  <!-- J-Bot奥运营销 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="J-Bot奥运Campaign">一个AI生成的吉祥物，没有全球推广预算，却传到了全世界。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              J-Bot这一波，是社群建设真正开始回本的那一刻。我们用AI把JAC的吉祥物重新设计成六个奥运主题版本。J-Bot的视觉在微信、小红书、微博同步发出去，反应立刻就来了。高互动、大量转发，自然流量早就超出JAC原有粉丝的范围。
            </p>
            <p>
              接下来的事完全没想到。JAC的海外团队看到J-Bot之后，自己直接把内容转到了Facebook和Instagram上。没人要求他们这么做，他们就是觉得效果好，拿去用了。
            </p>
            <p>
              一批专门给中国社媒做的内容，没有独立的海外推广计划，自己跑到了全球。普通内容做不到这一点。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- J-Bot visuals — full width -->
  <section class="mb-[16px]">
    <img
      src="/images/clients/JAC/Wechat-JAC-Automobile-1.png"
      alt="JAC J-Bot吉祥物六个AI创作的奥运主题版本"
      class="w-full"
      loading="lazy"
      decoding="async"
    />
  </section>

  <!-- J-Bot Facebook post + WeChat -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:overflow-x-auto max-[640px]:justify-start scrollbar-hide">
      <img
        src="/images/clients/JAC/Wechat-JAC-Automobile-2.png"
        alt="JAC Motors Global Facebook帖子展示J-Bot奥运营销的高互动量"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-3.jpg"
        alt="JAC Motors微信公众号文章：巴黎奥运中国红主题"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        J-Bot Campaign从中国社媒一路传到了JAC的全球Facebook主页，全程没有单独策划海外版本。
      </p>
    </Container>
  </section>

  <!-- 项目成果 + Ground team -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Ground team -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            这一波战役坐实了JAC的创新品牌形象，也在国内用户和海外用户之间搭起了一座桥。事实证明，真正好的社群内容，不需要护照。
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[640px]:p-[32px] text-center">
        <SectionHeading overline="下一个就是你">想把自己的社媒账号做成一个真正的品牌社群？</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          范围明确，报价透明，本地团队执行。
        </p>
        <Button variant="primary" href="/zh/contact">预约通话</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
