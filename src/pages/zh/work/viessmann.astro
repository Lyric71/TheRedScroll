---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campaign', '电商', 'KOL项目', '直播', '媒介', '社媒'];
const platforms = ['抖音', '小红书', '企微', '天猫', '京东'];
---

<PageLayout
  title="Viessmann：中国社交电商案例 | TheRedScroll"
  description="Viessmann如何靠抖音、小红书、企微，把中国线上销量做起来。一套社媒打法、KOL项目、直播带货，跑出了实打实的结果。"
  ogImage="/images/clients/Viessmann/viessmann-og.jpg"
  lang="zh"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Viessmann/Viessman-climate-solution.avif')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.78]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        客户案例
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Viessmann：社媒如何把中国线上销量做起来。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Viessmann想靠社媒，把国内线上销量拉起来。我们在抖音、小红书和企微上搭了一整套运营，销量月月稳增。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact/">预约通话</Button>
        <Button variant="secondary-dark" href="#case-study">看完整案例</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">客户背景</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Viessmann (Carrier)</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">行业</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">暖通空调</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">服务内容</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">平台</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- 客户背景 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="客户背景">百年暖通品牌，中国市场却始终是块没啃下来的硬骨头。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Viessmann从1917年起就做暖通系统，如今归在Carrier旗下，产品销往全球几十个市场，覆盖供暖、热水、空气净化和新能源。
            </p>
            <p>
              中国市场却始终难啃。天猫和京东旗舰店早就开好，产品齐全，店铺照常运转。可就是没流量。在中国，这归根到底是社媒的事：消费者先得在社媒上认识一个品牌，才肯下单。Viessmann缺的，正是那种能把人引进店铺的内容。
            </p>
          </div>
        </div>

        <!-- Tmall store images -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
            <img
              src="/images/clients/Viessmann/Tmall-Store-Viessmann-3.webp"
              alt="Viessmann天猫旗舰店产品详情页"
              class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
              loading="lazy"
              decoding="async"
            />
            <img
              src="/images/clients/Viessmann/Tmall-Store-Viessmann-6.webp"
              alt="Viessmann天猫旗舰店产品目录"
              class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
            Viessmann天猫旗舰店。产品全上了架，流量却远远跟不上。
          </p>
        </div>

        <!-- 服务内容 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="服务内容">三个平台，各管一段。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们搭了一整套运营，从社媒一路直通Viessmann的电商店铺。三个平台，各管一段，各有各的任务。
            </p>
          </div>
        </div>

        <!-- 抖音 -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">抖音：负责引流</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们拍暖通题材的短视频，但不端工程师的腔调。讲的是家里更暖、电费更省、冬天不必再缩手缩脚地过。
            </p>
            <p>
              再配上产品演示和直播专场，把用户直接导进天猫旗舰店。效果来得很快。没多久，抖音就成了Viessmann线上新客最主要的来源之一。
            </p>
          </div>
        </div>

        <!-- 小红书 -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">小红书：做功课和拍板的地方</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              暖通系统是大件消费，国内用户出手前要做足功课。所以Viessmann必须出现在搜索结果里：产品测评、安装攻略、真实业主的使用分享。
            </p>
            <p>
              KOL合作和KOC笔记一起铺。道理很简单：有人在小红书搜"哪款暖通系统好"的时候，Viessmann得带着实证出现，而不是只剩一句空话。
            </p>
          </div>
        </div>

        <!-- 企微 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">企微：把一句咨询聊成一笔成交</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              下单之前，用户总有一堆问题。家里该上多大功率？和我的户型搭不搭？我们的团队在企微上用中文实时答复。
            </p>
            <p>
              成交之后，同一个聊天窗口顺势变成售后通道：安装跟进、维保预约、定期回访。从第一条咨询到成为老客户，整条线都在同一个窗口里走完。
            </p>
          </div>
        </div>

        <!-- Second image row -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
            <img
              src="/images/clients/Viessmann/Tmall-Store-Viessmann-4.webp"
              alt="Viessmann天猫旗舰店会员体系与售后服务"
              class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
              loading="lazy"
              decoding="async"
            />
            <img
              src="/images/clients/Viessmann/Tmall-Store-Viessmann-5.webp"
              alt="Viessmann天猫旗舰店品牌故事"
              class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
            Viessmann天猫旗舰店：品牌故事和会员体系。
          </p>
        </div>

        <!-- Ground team -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            这些都不是隔着屏幕遥控出来的，全部由国内本地团队亲手在跑。每个平台都有本地运营盯着，每周照着真实数据调整内容。
          </p>
        </div>

        <!-- 项目成果 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="项目成果">从一个展示橱窗，长成每天都在出货的销售渠道。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              两年下来，Viessmann在国内的线上营收月月攀升。天猫和京东，从一个只挂着产品的展示橱窗，变成了每天真出货的销售渠道。
            </p>
            <p>
              但营收只是其中一面。更要紧的，是这套运营运转的方式：抖音把人引进来，小红书养有意向的用户，企微再把人沉淀成长期客户。到今天，线下门店、经销商和售后服务商，也都接进了这条链路。
            </p>
            <p>
              最初的诉求其实很朴素：不光要把线上销量做起来，还要让每个渠道都朝同一个方向使劲。我们做的，正是这件事。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="下一个就是你">想为你的品牌，在中国搭起一套社交电商？</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          范围固定，一口价，团队就在国内。
        </p>
        <Button variant="primary" href="/zh/contact/">预约通话</Button>
      </div>
    </Container>
  </section>

</PageLayout>
