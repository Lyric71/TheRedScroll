---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campaign', '电商', 'KOL项目', '直播', '媒介', '社媒'];
const platforms = ['微信', '小红书', '微博'];
---

<PageLayout
  title="Mission Foods：中国社媒案例 | TheRedScroll"
  description="看Mission Foods怎么用微信、小红书、微博在中国推出玉米片：面向Z世代的社媒打法、吃法搭配内容和社群增长。"
  ogImage="/images/clients/MissionFoods/head-pic.jpg"
  lang="zh"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/MissionFoods/head-pic.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        客户案例
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Mission Foods：用社媒把玉米片带进中国市场。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Mission Foods要让一群从没吃过玉米片的国内消费者认识它。我们做了一套社媒打法，硬是把一个全新品类带了进来。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact/">预约通话</Button>
        <Button variant="secondary-dark" href="#case-study">看完整案例</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">客户背景</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Mission Foods</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">行业</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">食品 / 快消</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">服务内容</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">平台</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- 客户背景 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="客户背景">一个全球品牌，要在中国从零推一个陌生的零食品类。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Mission Foods是全球知名的墨西哥食品品牌，也是世界最大的玉米饼生产商之一。这回在中国推的是玉米片。品牌在海外底子很厚，但玉米片在国内的零食习惯里几乎不存在。
            </p>
            <p>
              大多数人没吃过，不少人压根没听过。偏偏，目标人群就是Z世代。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Social screenshots -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/MissionFoods/1-1.jpg"
        alt="Mission Foods中国社交平台美食搭配内容"
        class="w-[340px] max-[640px]:w-[280px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/MissionFoods/1-2.jpg"
        alt="Mission Foods RedNote和微信上的Z世代零食营销内容"
        class="w-[340px] max-[640px]:w-[280px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Mission Foods在微信、微博、小红书上的内容：吃法搭配，加上Z世代的零食场景。
      </p>
    </Container>
  </section>

  <!-- 服务内容 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="服务内容">让玉米片落地本土，而不是停在"洋气"。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              微信、微博、小红书三个号同时开跑，战役内容和日常运营一起做。整套打法只围着一个判断转：玉米片想在中国成，得先不再像"外国货"。
            </p>
          </div>
        </div>

        <!-- Food pairing -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">吃法搭配，正面回答用户最想问的问题</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们拍玉米片配中国菜的吃法：蘸酱、当火锅搭子，把酥脆口感和国内熟悉的味道凑成创意食谱。正好回答了每个消费者心里那句话：这东西到底怎么吃？
            </p>
            <p>
              搭法既自然，又顺着本地的口味。这正是它打动人的地方。
            </p>
          </div>
        </div>

        <!-- Gen Z -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">围着Z世代的零食场景做内容</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              轻松的聚会、深夜嘴馋、和朋友分享的瞬间。好玩、节奏快、画面感强，是那种Z世代会顺手收藏、再甩进群聊的内容。重点不在品牌，而在零食本身。
            </p>
          </div>
        </div>

        <!-- KOLs -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">小红书KOL演示真实的吃法</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              真实的厨房、真实的嘴馋瞬间、真实的反应。KOC笔记也带来大量原生传播，把玉米片从一个陌生品类，做成了真有人会下单的产品。
            </p>
          </div>
        </div>

        <!-- Halloween -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">万圣节战役，是全年最高光的一仗</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              主题内容把玉米片做成了派对的必备零食：变装造型、拼盘、聚会场景。时机也踩得准。万圣节这几年在国内Z世代里越来越火，玉米片很自然地嵌进了这个场景。
            </p>
            <p>
              这一波在三个平台同时拉动粉丝和互动，涨幅都很明显。
            </p>
          </div>
        </div>

        <!-- WeChat -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">战役之间的空窗期，微信负责留人</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              食谱、新品上架、当季优惠。没有大战役的日子，这些常规内容把用户的注意力一直拴着。
            </p>
          </div>
        </div>

        <!-- Ground team callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            所有内容都由我们的国内团队自己做。母语运营，贴着本地文化，每周复盘真实数据。
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- 项目成果 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="项目成果">爆款时刻当然重要。可爆款之间发生的事，更重要。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              万圣节战役跑出了最漂亮的数据，粉丝增长和互动都越过了此前的所有基准。
            </p>
            <p>
              但更关键的，是两次爆款之间的那段日子。靠日常内容，粉丝每周都在涨：食谱、优惠、零食创意。用户一直在看，也一直在互动。
            </p>
            <p>
              Mission Foods从一次陌生品类的上市起步，做成了一个真正有自己社群的品牌。内容只要对味，社媒就办得到。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="下一个就是你">想在中国社媒上推一款新产品？</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          范围固定，一口价，团队就在本地。
        </p>
        <Button variant="primary" href="/zh/contact/">预约通话</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
