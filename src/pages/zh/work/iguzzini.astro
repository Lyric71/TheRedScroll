---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['品牌体验', 'Campaign', '电商', 'KOL项目', '直播', '媒介', '社媒'];
const platforms = ['微信', '小红书', '微博', '天猫'];
---

<PageLayout
  title="iGuzzini 中国社媒案例 | TheRedScroll"
  description="iGuzzini怎么用微信、小红书、微博走进国内高端消费者的视野。社媒运营加KOL合作，24个月稳步增长。"
  ogImage="/images/clients/iGuzzini/iguzzini4-1.png"
  lang="zh"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/iGuzzini/iguzzini4-1.png')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        客户案例
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        iGuzzini：高端照明品牌在中国站稳脚跟。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        在国内建筑师圈子里，iGuzzini声名不小，普通消费者却很少听说。我们用社媒把这个B2B品牌做进了中国高端消费者的视野。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact">预约通话</Button>
        <Button variant="secondary-dark" href="#case-study">查看案例</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">客户背景</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">iGuzzini</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">行业</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">高端照明 / 设计</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">服务内容</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">平台</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- 客户背景 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="客户背景">建筑师都知道iGuzzini，普通消费者却不熟。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              iGuzzini从1959年开始做建筑照明，做的是博物馆、酒店、公共空间和高端住宅。建筑师画图纸时会直接点名要这个牌子。在设计圈子里，它的份量很重。
            </p>
            <p>
              但在中国，这层知名度只停在专业圈里。建筑师熟，消费者不熟。品牌想打动的，是那些会亲自为自家住宅挑灯的人。不只是指定型号的设计师，也包括愿意为好设计花钱的终端买家。
            </p>
            <p>
              难就难在这里。没人会在小红书上专门搜"吊灯"。灯具一般是施工队或者设计师替业主拍板。我们得让消费者对一个自己从没想过要亲手挑的品类，开始有想法。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Product visuals — side by side, matched height -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <Container>
      <div class="flex gap-[16px] items-center max-[640px]:flex-col">
        <img
          src="/images/clients/iGuzzini/iGuzzini-Image-Front-Case-Study.png"
          alt="iGuzzini Sinolo无线台灯，中国市场产品展示"
          class="h-[320px] max-[640px]:h-auto max-[640px]:w-full w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
          loading="lazy"
          decoding="async"
        />
        <img
          src="/images/clients/iGuzzini/iGuzzini-Image-3-Case-Study.png"
          alt="iGuzzini Conero吊灯产品展示"
          class="h-[320px] max-[640px]:h-auto max-[640px]:w-full w-auto min-w-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        社媒产品内容：Sinolo无线台灯和Conero吊灯，专为微信、小红书定制。
      </p>
    </Container>
  </section>

  <!-- 服务内容 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="服务内容">三个平台，一个目标。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              微信、小红书、微博三个号都是我们在做。从策划到执行，全部由国内本地团队跑。
            </p>
          </div>
        </div>

        <!-- WeChat -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">微信作为品牌主阵地</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              项目案例、设计师合作、新品发布。我们把iGuzzini的灯放回真实场景：酒店、画廊、私宅。让读者开始想"好灯光能让一个空间变成什么样"，而不是翻目录挑型号。
            </p>
          </div>
        </div>

        <!-- RedNote -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">小红书：最难做，也最关键</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们找室内设计师、空间设计师和家装KOL合作，让iGuzzini出现在真实的装修项目里。用户把笔记一收藏，转头就发给施工方做选品参考。再加上大量设计类KOC的种草，真实口碑慢慢起来了。
            </p>
            <p>
              微博负责更大面积的曝光。活动事件、设计行业动态、建筑话题。让品牌出现在那些本来不会主动搜照明品牌的人面前。
            </p>
          </div>
        </div>

        <!-- Livestream -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">直播是效果最好的内容形式</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              灯装上墙之后的样子，和照片里完全是两回事。直播就在真实空间里点亮，把设计背后的考虑讲清楚，当场回答观众的问题。亲眼看灯光怎么把一个空间撑起来，这一点最能留住人。
            </p>
            <p>
              HubStudio.ai让内容产出的节奏跟得上。产品图、场景图、社媒素材。三个平台同时供稿，每个平台风格还不一样，这一点很关键。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Product banners + Tmall store -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <Container>
      <div class="flex flex-col gap-[16px]">
        <img
          src="/images/clients/iGuzzini/iguzzini4-1.png"
          alt="iGuzzini Whisper系列中国电商营销视觉"
          class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
          loading="lazy"
          decoding="async"
        />
        <img
          src="/images/clients/iGuzzini/iguzzini5-1.png"
          alt="iGuzzini Portonovo无线台灯系列"
          class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
          loading="lazy"
          decoding="async"
        />
        <div class="flex justify-center mt-[16px]">
          <img
            src="/images/clients/iGuzzini/iGuzzini-Tmall-Part-1-scaled-1.webp"
            alt="iGuzzini天猫旗舰店产品详情与热销排名"
            class="w-full max-w-[360px] max-[640px]:max-w-[280px] rounded-[8px] border border-[rgba(0,0,0,0.08)]"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        电商视觉与天猫旗舰店。消费者点进来之前，种草工作早就在社媒上做完了。
      </p>
    </Container>
  </section>

  <!-- 项目成果 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="项目成果">24个月，从专业小圈子走进高端消费者的视线。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              24个月，iGuzzini从一个只在专业圈里被提起的名字，变成了国内高端消费者真正认得的品牌。设计师和终端消费者的互动，一月比一月多。
            </p>
            <p>
              天猫的销售数据也能说明问题。增长稳扎稳打。店铺跑得起来，是因为社媒早就把种草做完了。消费者下单，是因为他们在微信上关注过这个品牌，几周前在小红书收藏过一条笔记，或者在某场直播里看见过这盏灯装在真实客厅里的样子。
            </p>
          </div>
        </div>

        <!-- Callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            品牌不只是在一个新市场露了个脸。它让国内高端消费者开始重新想，怎么挑灯具这件事。这一步比看上去难得多。
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="下一个就是你">想在中国社媒上做起一个高端品牌？</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          范围明确，报价透明，本地团队执行。
        </p>
        <Button variant="primary" href="/zh/contact">预约通话</Button>
      </div>
    </Container>
  </section>

</PageLayout>
