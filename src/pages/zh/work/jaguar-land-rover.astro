---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campaign', 'KOL 项目', 'UGC', '内容制作', '社媒'];
const platforms = ['抖音', '小红书', '微信'];
---

<PageLayout
  title="捷豹路虎 中国社媒案例 | TheRedScroll"
  description="看捷豹路虎怎么用抖音、小红书、微信打进国内更年轻的那批潜在车主：社媒内容、KOL 合作、UGC 跑出的真实结果。"
  ogImage="/images/clients/Jaguar/jaguar-land-rover-og.jpg"
  lang="zh"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Jaguar/Jaguar-Land-Rover.avif')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.78]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        客户案例
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        捷豹路虎：用社媒打动中国更年轻的那批买家。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        捷豹路虎想打进国内更年轻的那批潜在车主。我们在抖音、小红书、微信上搭起一套打法，把品牌形象往新的方向推。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact/">预约通话</Button>
        <Button variant="secondary-dark" href="#case-study">查看案例</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">客户背景</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Jaguar Land Rover</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">行业</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">汽车 / 奢侈品</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">服务内容</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">平台</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- 客户背景 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="客户背景">百年英伦设计底蕴。可在中国，问题卡在年龄层。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              捷豹路虎造过世界上辨识度最高的一批车：豪华 SUV、跑车，一个多世纪的英伦设计底子。几乎人人对这个品牌都有印象。
            </p>
            <p>
              但在中国，问题卡在年龄。在成熟、有钱的车主里，JLR 认知度不差。可年轻一代的国内消费者，也就是未来五到十年真正会掏钱买豪华车的那群人，对它提不起兴趣。社媒上没有，别处也没有。
            </p>
            <p>
              JLR 得出现在这群人活跃的地方，说话的方式，也得对上他们的胃口。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Social content — full width -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <img
      src="/images/clients/Jaguar/100-JLR-1.webp"
      alt="Jaguar Land Rover 中国社交媒体内容，包括 Range Rover 百年系列和 Jaguar 经典日历"
      class="w-full"
      loading="lazy"
      decoding="async"
    />
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        为 JLR 中国受众做的社媒内容：Range Rover 百年系列和 Jaguar 经典日历。
      </p>
    </Container>
  </section>

  <!-- Case study content continued -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- 服务内容 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="我们做的事">把捷豹路虎送进年轻奢侈品消费者的信息流里。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              抖音、小红书、微信三个平台同时铺，目标只有一个：让捷豹路虎出现在国内年轻奢侈品消费者的信息流里。
            </p>
          </div>
        </div>

        <!-- Visual content -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">视觉内容先走一步</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              短视频加图片系列，专讲 JLR 的设计和工艺，全踩着抖音、小红书的节奏来。电影质感，节奏快，全程竖屏。
            </p>
            <p>
              所有内容都在国内拍、国内做，专供中国市场。不是拿全球素材二次剪辑，而是从零开始的原创。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Hero video — full width single row -->
  <section class="mb-[32px] max-[640px]:mb-[24px]">
    <video
      src="/images/clients/Jaguar/JLR-Video-1.mp4"
      class="w-full"
      muted
      loop
      playsinline
      autoplay
    ></video>
  </section>

  <!-- Douyin video content — full width -->
  <section class="mb-[48px] max-[640px]:mb-[32px]">
    <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <video
        src="/images/clients/Jaguar/JLR-Video-2.mp4"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        muted
        loop
        playsinline
        autoplay
      ></video>
      <video
        src="/images/clients/Jaguar/JLR-Video-3.mp4"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        muted
        loop
        playsinline
        autoplay
      ></video>
      <video
        src="/images/clients/Jaguar/JLR-Video-4.mp4"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        muted
        loop
        playsinline
        autoplay
      ></video>
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        抖音内容：电影质感、竖屏构图，在中国本地、为中国市场制作。
      </p>
    </Container>
  </section>

  <!-- Case study content continued -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Brand storytelling -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">品牌故事开始引起共鸣</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们围绕几个主题做了一批叙事内容：创新、探索，还有当代奢华对二三十岁这代人到底意味着什么。微纪录片、制造工艺幕后，再加上把车和真实生活连起来的日常画面。
            </p>
            <p>
              我们不是要硬给 JLR 装嫩。这个品牌本就配得上新一代人对驾驶的理解，只是这一层，过去一直没被讲清楚。
            </p>
          </div>
        </div>

        <!-- UGC -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">真正跑出圈的是 UGC</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              我们发起话题挑战和征集活动，让真实车主和爱好者自己拍自己那台 JLR：长途自驾、城市通勤、周末出门。跑得最好的，不是做得最精致的那批视频，而是真实、有点糙、一看就不是摆拍的瞬间。
            </p>
            <p>
              这类用户自己发的内容，数据一直都比官方号发的好。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Douyin screenshots — full width -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <img
        src="/images/clients/Jaguar/JLR-3.webp"
        alt="Jaguar Land Rover Douyin 短视频展示车辆动态"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Jaguar/JLR-4.webp"
        alt="Jaguar Land Rover Douyin 内容涵盖 Defender、Discovery 及经典车型"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        抖音短视频：产品展示、生活方式内容，加上真实车主的 UGC。
      </p>
    </Container>
  </section>

  <!-- Case study content continued -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Ground team -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            整个项目从头到尾由我们的中国本地团队把关：内容制作、社群运营、KOL对接，每周复盘真实数据。母语运营，在第一线做判断。
          </p>
        </div>

        <!-- 项目成果 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="项目成果">从“听说过”到“真的开始在意”。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              三个平台的互动整体都起来了，粉丝增速明显加快，抖音和小红书跑在最前面。UGC项目源源不断地带来原创内容，年轻用户开始自发聊起捷豹路虎。
            </p>
            <p>
              品牌从“被认识”，变成在新人群里“真有人在意”。这不只是粉丝数的事。这一步走通了，将来走进门店看车的人，更有可能真的坐进驾驶位。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="下一个就是你">想把品牌打进中国新一代消费者的视野里？</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          范围明确，报价透明，本地团队执行。
        </p>
        <Button variant="primary" href="/zh/contact/">预约通话</Button>
      </div>
    </Container>
  </section>

</PageLayout>
