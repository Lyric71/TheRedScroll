---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campaign', '电商', 'KOL项目', '媒介', '社媒'];
const platforms = ['微信', '微博', '天猫'];
---

<PageLayout
  title="Marriott中国超级品牌日 | TheRedScroll"
  description="Marriott怎么在中国办了第一场超级品牌日。社媒、媒介、电商和KOL一起发力，天猫跑出数千万销售额，Bonvoy新增几十万会员。"
  ogImage="/images/clients/Marriott/Marriot-campaign-SBD-KV.jpg"
  lang="zh"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Marriott/Marriot-campaign-SBD-KV.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        客户案例
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        万豪：一场跑出千万GMV的天猫超级品牌日。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        万豪在国内办的第一场天猫超级品牌日。整场战役由我们操盘，几天之内，天猫跑出了数千万销售额。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact/">预约通话</Button>
        <Button variant="secondary-dark" href="#case-study">看完整案例</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">客户背景</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Marriott International</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">行业</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">酒店 / 旅游</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">服务内容</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">平台</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- 客户背景 -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="客户背景">全球9000家酒店，但中国是第一次做超级品牌日。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Marriott旗下30个品牌，超过9000家酒店，全球知名度高。但在国内，集团要和本土酒店连锁抢同一批高消费旅客。
            </p>
            <p>
              战役的目标很清楚：直接出单、Marriott Bonvoy会员拉新、在国内高端用户里把品牌定位再往上推一层。打法选了阿里巴巴的超级品牌日。Marriott从来没做过。曝光大、流量大、压力也大。没有试水期，第一天一切都要到位。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Campaign visuals -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/Marriott/campaign-SBD-Marriot-1.png"
        alt="Marriott超级品牌日天猫营销视觉"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Marriott/campaign-SBD-Marriot-2.png"
        alt="Marriott黑卡超级品牌日促销内容"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Marriott/Campaign-SBD-Marriot-3.jpg"
        alt="Marriott超级品牌日社交与媒体营销视觉"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Marriott超级品牌日主视觉。黑卡权益、天猫旗舰店和社媒内容。
      </p>
    </Container>
  </section>

  <!-- 服务内容 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="服务内容">全链路操盘，只有一个目标：第一天就要卖出去。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              整场战役从头到尾都由我们一手包办。
            </p>
          </div>
        </div>

        <!-- Black card -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">一张黑卡，让这件事变得可买</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              整场战役围绕一张Marriott专属黑卡展开，附带全球尊享权益。限量款包含集团旗下顶级酒店的住宿和餐饮礼遇。与其做一场常规的品牌曝光，不如直接给用户一个具体的、当场就能下单的东西。
            </p>
            <p>
              阿里站内，独家资源位直接打到高价值用户。站外靠明星背书、公关传播和线下活动把热度和信任感拉起来。
            </p>
          </div>
        </div>

        <!-- Social -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">短周期事件，用长线内容铺垫</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              微信、微博和旅行类KOL从开售前几周就开始造势。内容只聚焦两件事：黑卡的稀缺感，和入住Marriott酒店的真实体验。
            </p>
            <p>
              超级品牌日那天，用户早就准备好了。KOL内容在整个营销周期里一直在发酵。
            </p>
          </div>
        </div>

        <!-- Tmall -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">天猫页面收口转化</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              社媒、媒介、KOL、公关。所有流量都汇到同一个电商页面。用户一次下单，既能买到黑卡，也能直接注册成Bonvoy会员。
            </p>
          </div>
        </div>

        <!-- Ground team callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            整个项目由我们国内团队操盘。创意制作、媒体采买、KOL对接，发售当天遇到要临时调整，现场拍板的也是本地团队。
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- 项目成果 -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="项目成果">天猫销售数千万，Bonvoy新增几十万会员。</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Marriott的第一场超级品牌日，天猫跑出数千万销售额。Bonvoy新增几十万会员。品牌在国内高端旅行用户里的定位，明显往上走了一档。
            </p>
            <p>
              数据说明了一切。媒介、社媒、电商和线下活动在国内真正一起发力的时候，一家国际酒店集团能在几天之内跑出可观的营收。
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="下一个就是你">想在中国做一场大型品牌战役？</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          范围固定，一口价，团队就在国内。
        </p>
        <Button variant="primary" href="/zh/contact/">预约通话</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
