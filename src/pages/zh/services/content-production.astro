---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import FaqAccordion from '../../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'AI真的能跑出高端品牌级别的内容吗？', a: '能，前提是模型训练到位。通用输出就是通用，一看就知道。我们基于你的品牌视觉、色彩、包装、摄影风格训练专属模型，产出的东西是你的样子，不是别人的。' },
  { q: 'AI生成和实拍各占多少？', a: '看品牌看平台。大多数客户AIGC占60%到70%的视觉产能（产品图、社媒素材、短视频），剩下30%到40%是实拍（品牌大片、生活方式、达人联拍）。' },
  { q: '你们是直接写中文还是从英文翻的？', a: '直接写，不是翻译。差别一眼就看得出来。文案团队全是母语写手，常驻上海。你给的英文品牌指南只是参考起点，最终的中文稿是从零开始为国内平台写的。' },
  { q: '你们怎么跟热点？', a: '运营团队每天泡在平台上，盯热搜词、盯新格式、盯季节档、盯对手动向。机会一出现，24到48小时之内内容就能做出来发出去。' },
  { q: '如果我们已经有一套全球创意素材怎么办？', a: '可以做本地化适配，但说实话本地化适配的效果一般比不过本地原创。我们会在合适的位置用你原有的素材，日常内容靠AIGC和本地拍摄补上。' },
  { q: '每个月要发多少内容？', a: '维持基本存在感：每个平台每月8到12条。想保持竞争力：20到30条。这只是自然内容，广告素材不算。我们会按你的预算和目标定一个内容节奏。' },
  { q: '能同时做多个平台吗？', a: '这就是我们的常态做法。大部分客户会同时运营两到四个平台。每个平台一套独立的节奏、tone和格式。同一条内容复制到不同平台——那一套我们不做，没用。' },
  { q: '价格怎么算？', a: '一口价，范围写死。每个月多少条帖子、多少条视频、多少篇文章、多少次拍摄——全部提前列出来。广告预算、额外拍摄另外报价，全部透明。' },
  { q: '内容版权归谁？', a: '归你。我们做的所有内容，AI的也好、实拍的也好，完整使用权都归你的品牌。没有授权限制，没有到期日。' },
  { q: '多久能交付？', a: 'AIGC素材：2到3个工作日从需求到交付。实拍一到两周，包括前期、拍摄、后期。蹭热点内容紧急情况下可以24到48小时内从idea到上线。' },
];

const gettingStartedSteps = [
  {
    title: '先聊聊',
    description: '说说你的品牌、主要运营的平台、现在内容上卡在哪里。',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: '内容方案',
    description: '确定格式、制作方式、AIGC和实拍的配比、报价。范围从一开始就写清楚。',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: '两周上线',
    description: '内容策略定稿、首批素材制作、首批内容上线。签合同后14天。',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="中国社媒内容制作 | TheRedScroll"
  description="AIGC视觉、视频、文案、文化本地化。微信、抖音、小红书。范围写死，AI的速度。团队常驻上海。"
  lang="zh"
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/content-production-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        内容制作
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        内容说什么，远比制作成本重要。
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        策略、创意方向、AIGC、实拍、文案、文化本地化。团队常驻上海和香港。
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/zh/contact">预约通话</Button>
        <Button variant="secondary-dark" href="#what-we-do">服务内容</Button>
      </div>
    </div>
  </section>

  <!-- Why content production has changed -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">转折点</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">内容制作这件事已经变了</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">AI现在几分钟就能出视觉和文字。当所有人都能低成本产内容的时候，真正拉开差距的，是内容背后的那套判断。</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">服务内容</Button>
          </div>
        </div>
        <div class="bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">每个平台的调性都不一样</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">小红书偏轻松、偏私密。微博要抓眼的标题。微信要有深度。抖音看开头和节奏。四个平台一套调性，哪个都跑不起来。</p>
        </div>
        <div class="bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">趋势翻得太快</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">今天在抖音上爆的热搜词，下一周可能连水花都没有了。得有人天天盯着平台，在窗口期抓住节点。</p>
        </div>
        <div class="bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">量实在太大</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">三四个平台同时跑，每月至少30到50条内容，广告素材还没算进来。只靠传统制作方式，没有哪个团队吃得下这个量。</p>
        </div>
        <div class="bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">AI是唯一能跟上节奏的办法</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">AIGC出产量，团队把创意方向握在自己手里。思考这一块还是人在做，被提速的是制作。</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do — Content structure & AIGC -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="我们做的事">内容体系和策略</SectionHeading>

      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img src="/images/what-we-do/content-production.png" alt="TheRedScroll团队在内容拍摄现场" class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">内容策略</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">内容主线、信息框架、tone、平台专属格式。这一块100%由人拿主意。一个热点该追还是不追，AI答不了这个问题。</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">AIGC视觉和视频</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">AI生成的产品图、场景图、短视频。模型基于你的品牌视觉体系训练过，出来的东西是你的样子。比传统制作大概快80%。</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">实拍</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">在本地拍。幕后、开箱、品牌短片、达人联拍。真人在用你的产品——这件事AI替不了。</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Copywriting & Indicative pricing — dark section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">文案和文化本地化</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">我们不做翻译。</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            微信公众号文章要结构、要深度。小红书的图文配文读起来得像朋友在给你支招。抖音视频前两秒抓不住人就结束了。产品可能是同一个，写法完全不同。
          </p>
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            AI出初稿，本地写手负责文化这一关和改稿。如果是刚进入中国市场的品牌，中文品牌名、slogan、核心信息的改写也一起做。
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">AIGC参考价</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              10张AIGC产品图：¥2,000到¥5,000。5条社交短视频（15到30秒）：¥5,000到¥12,000。对比一下：上海一天传统产品摄影大概在¥8,000到¥25,000之间，一条30秒视频起步¥15,000，最高能到¥50,000。
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">实拍参考价</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              上海半天拍摄：¥8,000到¥15,000。一整天视频拍摄（含团队+后期）：¥20,000到¥60,000。具体看范围、场地、出镜人、后期量。
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Content formats by platform -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="按平台的内容格式">抖音</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">短视频（15到60秒）</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">核心格式。产品演示、教程、场景化、蹭热点。9:16竖屏，前两秒是关键。音乐和字幕是标配。</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">直播</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">产品演示、答疑互动、限时秒杀。一场1到4小时，通过抖音商城直接成交。要的是专业主播、弹幕互动、选品节奏。</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">抖音图文</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">最多20张图滑动。适合做科普、分步教程、产品对比。这个格式最近涨得很快，美妆和护肤品牌特别吃这一套。</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- RedNote formats -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="按平台的内容格式">小红书</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">图文笔记</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">1到9张图配文字。平台原生格式。生活照、平铺、使用前后对比。调性要真实、个人化——像日记，不像新闻稿。</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">视频笔记</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">1到5分钟。比抖音有更多叙事空间。测评、日常、教程。像真人在分享自己的体验，效果最好。</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">搜索向笔记</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">专门为小红书站内搜索写的内容。本质上就是社媒上的SEO——需要针对小红书的搜索逻辑做关键词研究。</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- WeChat formats -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
