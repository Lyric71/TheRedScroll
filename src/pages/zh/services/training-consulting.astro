      <style>
        .col-panel {
          position: relative;
          flex: 0 0 56px;
          background: var(--color-rice-paper);
          cursor: pointer;
          overflow: hidden;
          transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .col-panel.is-active {
          flex: 1 1 0%;
          cursor: default;
        }
        .col-label {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 1;
          transition: opacity 0.3s ease;
        }
        .col-panel.is-active .col-label {
          opacity: 0;
          pointer-events: none;
        }
        .col-label-text {
          writing-mode: vertical-rl;
          text-orientation: mixed;
          transform: rotate(180deg);
          font-size: 14px;
          font-weight: 500;
          color: var(--color-ink);
          white-space: nowrap;
          letter-spacing: 0.02em;
        }
        .col-content {
          position: absolute;
          inset: 0;
          padding: 32px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          opacity: 0;
          transition: opacity 0.35s ease 0.15s;
        }
        .col-panel.is-active .col-content {
          opacity: 1;
        }
        .col-panel.is-active::before {
          content: '';
          position: absolute;
          left: 0;
          top: 15%;
          bottom: 15%;
          width: 3px;
          background: var(--color-vermillion);
          border-radius: 0 2px 2px 0;
        }
        .col-panel:not(.is-active):hover {
          background: var(--color-warm-gray);
        }
        @media (max-width: 640px) {
          .col-panel {
            flex: 0 0 48px;
          }
          .col-panel.is-active {
            flex: 0 0 auto;
            min-height: 200px;
          }
          .col-label-text {
            writing-mode: horizontal-tb;
            transform: none;
            font-size: 13px;
          }
          .col-content {
            position: relative;
            padding: 20px;
          }
          .col-panel.is-active::before {
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            height: auto;
          }
        }
      </style>

      <script>
        document.querySelectorAll('[data-col-accordion]').forEach((accordion) => {
          const panels = accordion.querySelectorAll('[data-col-panel]');
          panels.forEach((panel) => {
            panel.addEventListener('click', () => {
              if (panel.classList.contains('is-active')) return;
              panels.forEach((p) => p.classList.remove('is-active'));
              panel.classList.add('is-active');
            });
          });
        });
      </script>
