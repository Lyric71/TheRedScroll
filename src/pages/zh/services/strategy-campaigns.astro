          <div class="col-label">
            <span class="col-label-text">数据和报告</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">数据和报告</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">月度报告涵盖涨粉数据、互动率、不同内容维度的表现、广告投入产出、竞品对比。跨平台打通追踪、细颗粒度的互动拆解，外加下一步可以直接上手的建议——不只是几张图表。</p>
          </div>
        </div>

      </div>

      <style>
        .col-panel {
          position: relative;
          flex: 0 0 56px;
          background: var(--color-rice-paper);
          cursor: pointer;
          overflow: hidden;
          transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .col-panel.is-active {
          flex: 1 1 0%;
          cursor: default;
        }

        /* Vertical rotated label — visible when collapsed */
        .col-label {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 1;
          transition: opacity 0.3s ease;
        }
        .col-panel.is-active .col-label {
          opacity: 0;
          pointer-events: none;
        }
        .col-label-text {
          writing-mode: vertical-rl;
          text-orientation: mixed;
          transform: rotate(180deg);
          font-size: 14px;
          font-weight: 500;
          color: var(--color-ink);
          white-space: nowrap;
          letter-spacing: 0.02em;
        }

        /* Expanded content */
        .col-content {
          position: absolute;
          inset: 0;
          padding: 32px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          opacity: 0;
          transition: opacity 0.35s ease 0.15s;
        }
        .col-panel.is-active .col-content {
          opacity: 1;
        }

        /* Vermillion left accent on active panel */
        .col-panel.is-active::before {
          content: '';
          position: absolute;
          left: 0;
          top: 15%;
          bottom: 15%;
          width: 3px;
          background: var(--color-vermillion);
          border-radius: 0 2px 2px 0;
        }

        /* Hover state for collapsed panels */
        .col-panel:not(.is-active):hover {
          background: var(--color-warm-gray);
        }

        /* Mobile: stack vertically */
        @media (max-width: 640px) {
          .col-panel {
            flex: 0 0 48px;
          }
          .col-panel.is-active {
            flex: 0 0 auto;
            min-height: 200px;
          }
          .col-label-text {
            writing-mode: horizontal-tb;
            transform: none;
            font-size: 13px;
          }
          .col-content {
            position: relative;
            padding: 20px;
          }
          .col-panel.is-active::before {
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            height: auto;
          }
        }
      </style>

      <script>
        document.querySelectorAll('[data-col-accordion]').forEach((accordion) => {
          const panels = accordion.querySelectorAll('[data-col-panel]');
          panels.forEach((panel) => {
            panel.addEventListener('click', () => {
              if (panel.classList.contains('is-active')) return;
              panels.forEach((p) => p.classList.remove('is-active'));
              panel.classList.add('is-active');
            });
          });
        });
      </script>
    </Container>
  </section>

