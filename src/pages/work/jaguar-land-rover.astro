---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';

const services = ['Campaign', 'eCommerce', 'Influencer / KOL', 'Livestream', 'Media', 'Social'];
const platforms = ['Douyin', 'RedNote', 'WeChat'];
---

<PageLayout
  title="JLR China Social Media Case Study | TheRedScroll"
  description="How Jaguar Land Rover used Douyin, RedNote, and WeChat to reach younger Chinese consumers. Social content, KOL campaigns, and UGC results."
  ogImage="/images/clients/Jaguar/Jaguar-Land-Rover.avif"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Jaguar/Jaguar-Land-Rover.avif')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.78]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Case study
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Jaguar Land Rover: reaching younger consumers through social in China.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Jaguar Land Rover needed to reach younger buyers in China. We built a social strategy across Douyin, RedNote, and WeChat that shifted brand relevance.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary-dark" href="#case-study">Read the case study</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Jaguar Land Rover</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Industry</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Automotive / Luxury</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Platforms</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- The Client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="The client">Over a century of British design. The problem in China was age.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Jaguar Land Rover makes some of the most recognizable vehicles in the world. Luxury SUVs, performance cars, over a century of British design behind them. The kind of brand people have opinions about.
            </p>
            <p>
              In China, the problem was age. JLR had good recognition with established, older buyers. But younger Chinese consumers, the ones who'll actually be buying luxury cars in the next five to ten years, just weren't paying attention. Not on social, not anywhere that mattered.
            </p>
            <p>
              JLR needed to show up where that audience lives. And the content had to feel native to how they actually consume it.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Social content — full width -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <img
      src="/images/clients/Jaguar/100-JLR-1.png"
      alt="Jaguar Land Rover social content for Chinese platforms, including Range Rover and Jaguar heritage series"
      class="w-full"
      loading="lazy"
      decoding="async"
    />
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Social content produced for JLR's Chinese audience. Range Rover centenary series and Jaguar heritage calendar.
      </p>
    </Container>
  </section>

  <!-- Case study content continued -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- What We Did -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="What we did">Getting Jaguar Land Rover into the feed of younger luxury consumers.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              We ran social content across Douyin, RedNote, and WeChat. Everything aimed at one thing: getting Jaguar Land Rover into the feed of younger luxury consumers in China.
            </p>
          </div>
        </div>

        <!-- Visual content -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Visual content came first</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Short videos and image series that showed off JLR's design and engineering, but produced specifically for how content performs on Douyin and RedNote. Cinematic, fast-paced, vertical.
            </p>
            <p>
              All shot and edited in China for the Chinese market. Not adapted global campaigns. This was made here.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Hero video — full width single row -->
  <section class="mb-[32px] max-[640px]:mb-[24px]">
    <video
      src="/images/clients/Jaguar/JLR-Video-1.mp4"
      class="w-full"
      muted
      loop
      playsinline
      autoplay
    ></video>
  </section>

  <!-- Douyin video content — full width -->
  <section class="mb-[48px] max-[640px]:mb-[32px]">
    <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <video
        src="/images/clients/Jaguar/JLR-Video-2.mp4"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        muted
        loop
        playsinline
        autoplay
      ></video>
      <video
        src="/images/clients/Jaguar/JLR-Video-3.mp4"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        muted
        loop
        playsinline
        autoplay
      ></video>
      <video
        src="/images/clients/Jaguar/JLR-Video-4.mp4"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        muted
        loop
        playsinline
        autoplay
      ></video>
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Douyin content: cinematic, vertical, made in China for the Chinese market.
      </p>
    </Container>
  </section>

  <!-- Case study content continued -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Brand storytelling -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Brand storytelling that resonated</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              We built narrative content around innovation, adventure, and what modern luxury actually looks like to someone in their twenties or thirties. Mini-docs, behind-the-scenes series, lifestyle pieces that tied the vehicles to real experiences.
            </p>
            <p>
              We weren't trying to make JLR seem younger. The brand already fits how a new generation thinks about driving. We just had to show that.
            </p>
          </div>
        </div>

        <!-- UGC -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">UGC did the heaviest lifting</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              We set up hashtag challenges and contests to get real owners and fans making their own JLR content. Road trips, city drives, weekend stuff. The best posts weren't the polished ones. They were the genuine moments, slightly messy, clearly real.
            </p>
            <p>
              That kind of organic content outperforms anything a brand account can put out.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Douyin screenshots — full width -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <img
        src="/images/clients/Jaguar/JLR-3.png"
        alt="Jaguar Land Rover Douyin short videos showing vehicles in action"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Jaguar/JLR-4.png"
        alt="Jaguar Land Rover Douyin content featuring Defender, Discovery, and heritage models"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Douyin short videos: product showcases, lifestyle content, and UGC from real owners.
      </p>
    </Container>
  </section>

  <!-- Case study content continued -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Ground team -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[24px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Our team ran all of this from China. Content production, community management, KOL coordination, weekly tweaks to what was running. Native speakers making calls on the ground.
          </p>
        </div>

        <!-- The Outcome -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="The outcome">From recognized to relevant with a whole new audience.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Engagement went up across all three platforms. Follower growth picked up, Douyin and RedNote especially. And the UGC campaigns brought a steady flow of organic content from younger consumers who were now talking about Jaguar Land Rover on their own.
            </p>
            <p>
              The brand went from being recognized to being relevant with a whole new audience. That's not just a follower count. That's the kind of shift that turns future browsers into future buyers.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[640px]:p-[32px] text-center">
        <SectionHeading overline="Your turn">Want to grow your brand with China's next generation of consumers?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Fixed scope. Fixed price. Team on the ground.
        </p>
        <Button variant="primary" href="/contact">Book a call</Button>
      </div>
    </Container>
  </section>

</PageLayout>
