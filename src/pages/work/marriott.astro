---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';

const services = ['Campaign', 'eCommerce', 'Influencer / KOL', 'Media', 'Social'];
const platforms = ['WeChat', 'Weibo', 'Tmall'];
---

<PageLayout
  title="Marriott China Super Brand Day Case Study | TheRedScroll"
  description="How Marriott ran its first Super Brand Day in China. Social, media, eCommerce, and KOL activation that drove millions in Tmall sales and Bonvoy signups."
  ogImage="/images/clients/Marriott/Marriot-campaign-SBD-KV.jpg"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Marriott/Marriot-campaign-SBD-KV.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Case study
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Marriott: a Super Brand Day campaign that drove millions in China.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Marriott's first Super Brand Day in China needed everything to land at once. We ran the full campaign and delivered millions in sales on Tmall.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary-dark" href="#case-study">Read the case study</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Marriott International</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Industry</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Hospitality / Travel</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Platforms</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- The Client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="The client">9,000 properties worldwide. First Super Brand Day in China.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Marriott runs over 9,000 properties across 30 brands. Big name, global footprint. In China, they are competing hard for affluent travelers alongside strong domestic hotel brands.
            </p>
            <p>
              They wanted direct sales, Marriott Bonvoy loyalty enrollments, and a stronger position with high-spending Chinese consumers. The vehicle was Alibaba's Super Brand Day. Marriott had never run one. High visibility, high traffic, high pressure. There is no soft launch. Everything has to be ready on day one.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Campaign visuals -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/Marriott/campaign-SBD-Marriot-1.png"
        alt="Marriott Super Brand Day campaign creative on Tmall"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Marriott/campaign-SBD-Marriot-2.png"
        alt="Marriott black card promotional content for Super Brand Day"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Marriott/Campaign-SBD-Marriot-3.jpg"
        alt="Marriott Super Brand Day social and media campaign assets"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Marriott Super Brand Day campaign creative. Black card offer, Tmall storefront, and social content.
      </p>
    </Container>
  </section>

  <!-- What We Did -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="What we did">End-to-end campaign with one goal: sell on day one.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              We managed the campaign end to end.
            </p>
          </div>
        </div>

        <!-- Black card -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">The black card made it sellable</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              We built the campaign around an exclusive Marriott black card with global privileges. A limited edition added complimentary stays and dinners at top-tier properties. Instead of a brand awareness push, we gave people something to actually buy.
            </p>
            <p>
              Inside Alibaba's ecosystem, exclusive media placements reached high-value consumers. Outside of it, celebrity endorsement, PR, and offline events drove buzz and credibility.
            </p>
          </div>
        </div>

        <!-- Social -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Playing the long game around a short event</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              WeChat, Weibo, and travel KOLs built anticipation weeks before launch. Content focused on the black card's exclusivity and on what staying at a Marriott property actually feels like.
            </p>
            <p>
              By the time Super Brand Day arrived, the audience was primed. Influencer content kept energy up through the campaign window.
            </p>
          </div>
        </div>

        <!-- Tmall -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">The Tmall page closed the loop</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Social, media, KOLs, PR. All pointed to one eCommerce page where people could buy the card and sign up for Bonvoy in the same transaction.
            </p>
          </div>
        </div>

        <!-- Ground team callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Our team coordinated everything from China. Creative, media buying, influencer management, real-time calls on launch day when things needed adjusting.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- Outcome -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="The outcome">Millions in sales. Hundreds of thousands of new Bonvoy members.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Marriott's first Super Brand Day generated millions in sales on Tmall. Hundreds of thousands of new Bonvoy members signed up. The brand came out of it with noticeably stronger positioning among affluent Chinese travelers.
            </p>
            <p>
              Those numbers speak for themselves. When media, social, eCommerce, and offline work are coordinated on the ground in China, a global hotel brand can move serious money in a matter of days.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="Your turn">Want to run a major campaign in China?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Fixed scope. Fixed price. Team on the ground.
        </p>
        <Button variant="primary" href="/contact">Book a call</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
