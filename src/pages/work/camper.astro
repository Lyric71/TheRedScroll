---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import { caseStudySchema } from '../../lib/schema';

const services = ['Campaign', 'Content Production', 'Influencer / KOL', 'Social'];
const platforms = ['WeChat', 'RedNote', 'Weibo'];

const stats = [
  { value: '43K → 187K', label: 'Followers in 18 months' },
  { value: '4.7%', label: 'Engagement rate (from 1.2%)' },
  { value: '38%', label: 'eCommerce traffic from RedNote' },
  { value: '+31%', label: 'Same-store sales YoY' },
];
---

<PageLayout
  title="Camper China Social Media Case Study | TheRedScroll"
  description="How Camper grew from 43K to 187K followers on WeChat, RedNote, and Weibo. Social strategy that drove 31% same-store sales growth in Chinese cities."
  ogImage="/images/clients/Camper/Camper-Case-Study-Hero.jpg"
  schema={caseStudySchema({
    clientName: 'Camper',
    headline: 'Camper: growing a design brand on China\'s social platforms',
    description: 'Camper grew from 43K to 187K followers on WeChat, RedNote, and Weibo, driving 31% same-store sales growth across 18 months.',
    url: '/work/camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    industry: 'Fashion / Footwear',
    platforms,
  })}
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Camper/Camper-Case-Study-Hero.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Case study
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Camper: growing a design brand on China's social platforms.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Camper needed social growth in China without losing its design identity. We grew followers 4x and drove 31% same-store sales growth in 18 months.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact/">Book a call</Button>
        <Button variant="secondary-dark" href="#case-study">Read the case study</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Camper</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Industry</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Fashion / Footwear</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Platforms</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- The Client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="The client">Shoes from Mallorca since 1975. Social in China wasn't keeping up.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Camper has been making shoes in Mallorca since 1975. Unconventional design, Mediterranean craftsmanship, comfort over trends.
            </p>
            <p>
              In China, they had accounts on WeChat, Weibo, and RedNote with a combined 43,000 followers. Engagement at 1.2%. Stores in tier-one cities, but social wasn't driving people into them. The brand needed growth, but not at any cost. Camper's design identity had to come through in everything. No discount campaigns, no generic lifestyle posts.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Social screenshots — horizontal scroll, all same ratio -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/Camper/2e9bc97593dbe520397f52be0fb8e584.jpg"
        alt="Camper RedNote official account profile with 19.3K followers"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Camper/3721890f3b2783008e73034b5b06b315.jpg"
        alt="Camper WeChat official account with articles and content"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Camper/4bccf3f158a489f020e0a273f13c19ab.jpg"
        alt="Camper x Issey Miyake collaboration article on WeChat"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Camper/b2a4eecb0f6665ce6c27c35983d5e7fb.jpg"
        alt="Camper Pix London campaign on RedNote with KOL content"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Camper's social presence across RedNote and WeChat. KOL collaborations, brand stories, and designer partnerships.
      </p>
    </Container>
  </section>

  <!-- What We Did -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="What we did">Content built around what makes Camper worth following.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Camper's target in China is design-conscious professionals, roughly 28 to 45. Not the audience that responds to hard sells. So we built content around what makes Camper worth following: design stories, artist collaborations, and how real people in Chinese cities actually wear the shoes.
            </p>
          </div>
        </div>

        <!-- RedNote -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">RedNote: where we focused the most energy</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              We partnered with micro-influencers in architecture, interiors, and creative fields. Content went deep on why the shoes are made the way they are. Materials, construction, design intent. It pulled in a smaller audience than a fashion influencer push would have, but engagement was significantly higher.
            </p>
          </div>
        </div>

        <!-- WeChat -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">WeChat: the longer stories</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Mini-documentaries from the Mallorca workshops. Behind-the-scenes of how Camper designs and builds their shoes. Content with enough substance that people actually had a reason to stay subscribed.
            </p>
          </div>
        </div>

        <!-- Weibo -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Weibo: for conversation</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              One thread about whether shoes should be designed for how they feel or how they look ran for three days and pulled in thousands of comments.
            </p>
          </div>
        </div>

        <!-- Ground team -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Our team handled all of this from China. Native speakers, platform-specific content, weekly reviews to see what was and wasn't landing.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- Stats grid -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {stats.map((stat) => (
          <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">{stat.value}</p>
            <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Outcome -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="The outcome">The first few months were slow. Then things picked up.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Over 18 months, followers grew from 43,000 to 187,000. Engagement went from 1.2% to 4.7%, well above footwear benchmarks.
            </p>
            <p>
              RedNote was the surprise. Despite the smallest follower count, it drove 38% of all eCommerce traffic. Smaller audience, higher intent.
            </p>
            <p>
              The effect showed up in stores too. Same-store sales grew 31% year over year. Retention improved 22%. Purchase frequency moved from 1.3 to 2.1 per customer annually.
            </p>
          </div>
        </div>

        <!-- Organic callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Three RedNote collaborators kept posting about Camper after the paid campaigns were done. No contract, no brief. They just liked the shoes. That kind of thing doesn't come from a campaign brief.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="Your turn">Want to grow a premium brand on China's social platforms?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Fixed scope. Fixed price. Team on the ground.
        </p>
        <Button variant="primary" href="/contact/">Book a call</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
