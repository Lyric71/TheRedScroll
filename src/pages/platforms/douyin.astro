---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';

const stats = [
  { label: 'Daily active users', value: '750M+', image: '/images/platforms/douyin-stats/daily-active-users.png' },
  { label: 'Monthly active users', value: '1B+', image: '/images/platforms/douyin-stats/monthly-active-users.png' },
  { label: 'Avg. daily time per user', value: '120 min', image: '/images/platforms/douyin-stats/daily-time.png' },
  { label: 'E-commerce sales (2024)', value: '¥3.5T', image: '/images/platforms/douyin-stats/ecommerce-sales.png' },
  { label: 'Year-on-year sales growth', value: '34%', image: '/images/platforms/douyin-stats/yoy-growth.png' },
  { label: 'Live commerce sessions daily', value: '30M+', image: '/images/platforms/douyin-stats/live-commerce.png' },
  { label: 'Content categories', value: '100+', image: '/images/platforms/douyin-stats/content-variety.png' },
  { label: 'Creator accounts', value: '15M+', image: '/images/platforms/douyin-stats/creator-economy.png' },
];

const ecosystem = [
  {
    name: 'For You Feed',
    chineseName: '推荐页',
    description: 'The algorithm-driven feed where users discover content. It does not care about follower count. A brand-new account can reach millions with the right video.',
    image: '/images/platforms/douyin-ecosystem/for-you-feed.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
  },
  {
    name: 'Live Commerce',
    chineseName: '直播电商',
    description: 'Live selling built right into the app. Host selection, product scripting, real-time audience engagement. Some brand livestreams pull millions of viewers in a single session.',
    image: '/images/platforms/douyin-ecosystem/live-commerce.png',
    bg: '#CC3333',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>`,
  },
  {
    name: 'Douyin Shop',
    chineseName: '抖音商城',
    description: 'In-app storefront where users search, browse, and buy your products. Every video and livestream drives traffic to the shop. No redirects needed.',
    image: '/images/platforms/douyin-ecosystem/douyin-shop.png',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  },
  {
    name: 'Ocean Engine',
    chineseName: '巨量引擎',
    description: 'ByteDance\'s ad platform. TopView for big launches. In-Feed Ads for clicks. Search Ads for high-intent buyers. DOU+ for testing content. Ad spend billed separately, no markups.',
    image: '/images/platforms/douyin-ecosystem/ocean-engine.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
  },
  {
    name: 'Xingtu',
    chineseName: '星图',
    description: 'Douyin\'s official KOL marketplace. We find creators, vet them for fake followers, check past campaign results and audience fit. You approve the final list before we move.',
    image: '/images/platforms/douyin-ecosystem/xingtu.png',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    name: 'DOU+',
    chineseName: '抖加',
    description: 'Content boosting tool for testing which videos resonate. Put a small budget behind a post, see how it performs with a wider audience, then scale what works.',
    image: '/images/platforms/douyin-ecosystem/dou-plus.png',
    bg: '#B02D2D',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const services = [
  {
    title: 'Setup and strategy',
    description: 'We register and verify your enterprise account, handle the compliance paperwork, and build your content strategy from scratch. Content pillars, posting schedule, editorial calendar, KPI targets.',
    result: 'A live, verified Douyin account with a clear content roadmap.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/douyin-services/setup-strategy.png',
  },
  {
    title: 'Content production',
    description: 'Douyin-native videos produced by our China team. Product demos, lifestyle shoots, educational clips, behind-the-scenes footage, trend-driven formats, and mini-dramas. HubStudio.ai for visuals and copy drafts. Native Mandarin speakers edit every piece.',
    result: 'Localized short-form video content that performs on Douyin.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
    image: '/images/platforms/douyin-services/content-production.png',
  },
  {
    title: 'Live commerce',
    description: 'We plan and run live selling sessions. Host selection, product scripting, real-time audience engagement, post-session performance review. Works for product launches, seasonal campaigns, and steady sales channels.',
    result: 'Revenue-generating livestreams that convert viewers into buyers.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>`,
    image: '/images/platforms/douyin-services/live-commerce.png',
  },
  {
    title: 'KOL and KOC campaigns',
    description: 'We find creators through Xingtu and our own network built over years on the ground. Every creator gets vetted for fake followers, past campaign results, and audience fit. You approve the final list before we move.',
    result: 'Influencer campaigns with verified engagement and real results.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    image: '/images/platforms/douyin-services/kol-campaigns.png',
  },
  {
    title: 'Advertising',
    description: 'Paid campaigns through Ocean Engine. TopView for big launches. In-Feed Ads for clicks and traffic. Search Ads for high-intent buyers. DOU+ for testing. Branded Effects for user participation. Ad spend billed separately, no markups.',
    result: 'Ads that reach the right audience with transparent spend reporting.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/douyin-services/advertising.png',
  },
  {
    title: 'Douyin Shop',
    description: 'In-app storefront where users search, browse, and buy your products. We handle setup, listings, pricing, and optimization. Every video and livestream we produce drives traffic to the shop.',
    result: 'A storefront that turns viewers into customers without leaving the app.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
    image: '/images/platforms/douyin-services/douyin-shop.png',
  },
];

const bestPractices = [
  {
    title: 'First second wins or loses.',
    description: 'Start with motion, a question, something visual. Never open with a logo. You\'ll lose them before they even know what the video is about.',
  },
  {
    title: 'Vertical only. 9:16.',
    description: 'If it looks like a repurposed TV ad, it\'s going to underperform. Douyin is vertical-first, always.',
  },
  {
    title: 'Three to five posts per week, minimum.',
    description: 'The algorithm rewards consistency. Go quiet for a week, your reach drops. Simple as that.',
  },
  {
    title: 'Watch-through rate is everything.',
    description: 'The algorithm\'s top signal is how many people make it to the end of your video. Cut anything that doesn\'t earn the next second.',
  },
  {
    title: 'Trends move fast.',
    description: 'We track trending sounds, hashtags, and formats daily. Catching a wave early can dramatically multiply reach on a single video.',
  },
  {
    title: 'Sell softly.',
    description: 'Hard sells die on Douyin. Content that actually performs educates or entertains first. Product comes second.',
  },
  {
    title: 'Sound on.',
    description: 'Douyin is not a silent-scroll platform. Music, voiceover, audio cues. They matter as much as what\'s on screen.',
  },
  {
    title: 'Mandarin from scratch.',
    description: 'Translated content underperforms badly on the platform. Our team writes all copy natively.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Discovery call.',
    description: 'Tell us about your brand, your goals, and where you stand with China right now. No pitch deck. Just the right questions.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Proposal.',
    description: 'Clear SOW. Fixed price. Every deliverable listed out. You see what you\'re getting and what it costs before you commit.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'Live in 2 weeks.',
    description: 'Onboarding, accounts set up, first content published. Fourteen days from signed contract to first post going live.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  {
    q: 'Who runs my account?',
    a: 'Our team in China. Native Mandarin speakers who create content and run ads on Douyin every day. You get a dedicated account manager who knows your brand.',
  },
  {
    q: 'Do I need a Chinese business license?',
    a: 'Enterprise accounts need one, or an authorized agency partner. We handle both paths. You can start posting and running ads without setting up a local entity.',
  },
  {
    q: 'How is TheRedScroll different?',
    a: 'Fixed scope, fixed price. Team on the ground in China. AI-powered production. We benchmarked 37 agencies in this space and not a single one offers fixed-price packages.',
  },
  {
    q: 'How long before results?',
    a: 'Most brands see traction in 8 to 12 weeks. Paid campaigns can show results within days. It depends on the category and how aggressive you want to go.',
  },
  {
    q: 'How much does it cost?',
    a: 'Fixed-price packages that spell out exactly what you get. Ad spend billed at cost, separately. No markups. Book a call and we\'ll recommend a fit.',
  },
  {
    q: 'Can you run ads without a Chinese entity?',
    a: 'Foreign brands advertise on Douyin through us as an authorized agency. No local incorporation needed.',
  },
  {
    q: 'What content do you produce?',
    a: 'Product demos, lifestyle videos, tutorials, mini-dramas, KOL collaborations, livestreams. All in Mandarin, by our China team. AI tools for speed, human editing on every piece.',
  },
  {
    q: 'How do you pick KOLs?',
    a: 'Xingtu plus our own network. Every creator checked for fake followers, engagement quality, demographics, and brand fit. You approve the final list.',
  },
  {
    q: 'Can you set up a Douyin Shop?',
    a: 'Yes. Setup, listings, pricing, optimization. Connected to your content strategy so every video drives buyers to your products.',
  },
  {
    q: 'What do reports look like?',
    a: 'Monthly. Clear numbers. Follower growth, views, engagement, ad efficiency, conversions. What worked, what didn\'t, what\'s changing next.',
  },
];
---

<PageLayout
  title="Douyin Marketing Agency | TheRedScroll"
  description="Douyin marketing services from Shanghai. Content, ads, KOL campaigns, live commerce, and Douyin Shop setup. Fixed scope, fixed price. Book a call."
>
  <!-- Hero: Dark hero banner -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/douyin-hero.png')" aria-hidden="true"></div>
    <!-- Watermark -->
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      抖音
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/platforms/others" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; All platforms
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Douyin marketing
        </p>
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          750 million daily users. One platform. We post on it every day.
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          Douyin marketing services from our team in China. Content production, advertising, KOL campaigns, live commerce, and Douyin Shop. Fixed scope, fixed price.
        </p>
        <Button variant="primary" href="/contact">Book a call</Button>
      </div>
    </Container>
  </section>

  <!-- Stats section — horizontal scroll strip -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            Not vanity numbers. Your Chinese audience is already here.
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            Douyin by the numbers.
          </p>
        </div>
        <Button variant="primary" href="/contact" class="shrink-0">Book a call</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>

      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div
              class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none"
              data-stat-index={i}
            >
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why Douyin Matters -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Why Douyin matters">
          Algorithm-driven reach. Full-funnel commerce. Built-in live selling.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <!-- Card 1: Algorithm doesn't care about follower count -->
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/douyin-why/algorithm.png" alt="Person discovering brand content through Douyin algorithm feed" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">The algorithm levels the playing field</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              Douyin's algorithm does not care about follower count. It cares about content quality. A brand-new account can reach millions with the right video. Newcomers compete from day one.
            </p>
          </div>
        </div>

        <!-- Card 2: Full funnel in one app -->
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/douyin-why/full-funnel.png" alt="Douyin video to checkout shopping flow on smartphone" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Discover, decide, buy. One app.</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              Users discover products, make decisions, and check out without ever leaving the app. No redirects, no separate website. The path from content to sale is as short as it gets.
            </p>
          </div>
        </div>

        <!-- Card 3: Live commerce built in -->
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/douyin-why/live-built-in.png" alt="Live commerce session on Douyin with viewers and shopping cart" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Live commerce is built right in</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              Some brand livestreams pull millions of viewers in a single session. Live selling works for product launches, seasonal campaigns, and brands that want a steady sales channel on the platform.
            </p>
          </div>
        </div>
      </div>

      <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] mt-[24px] text-center max-w-[680px] mx-auto">
        Whether your customers are 22 or 52, first-tier city or fifth, they are spending more time on Douyin than on any other app in China. Douyin works for beauty, fashion, food, consumer electronics, home goods, hospitality, automotive, health, and B2B.
      </p>
    </Container>
  </section>

  <!-- The Douyin ecosystem -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="The Douyin ecosystem">
          Six tools that drive content, commerce, and growth.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {ecosystem.map((item) => (
          <div
            class="eco-card relative border-none overflow-hidden flex flex-col justify-between"
            style={`border-radius: ${item.bg === '#1A1A1A' || item.bg === '#CC3333' || item.bg === '#B02D2D' ? '12px' : '10px'}`}
            data-tilt-eco
          >
            <!-- Background image -->
            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out eco-bg" style={`background-image: url('${item.image}')`} aria-hidden="true"></div>
            <div class="absolute inset-0" style={`background: ${item.bg}; opacity: 0.72`} aria-hidden="true"></div>
            <!-- Content -->
            <div class="relative z-[1] p-[24px] max-[640px]:p-[20px]">
