---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';

const stats = [
  { label: 'Monthly active users', value: '350M+' },
  { label: 'Daily post views', value: '9.12B' },
  { label: 'Monthly search queries', value: '1B+' },
  { label: 'Users aged 18 to 35', value: '70%' },
  { label: 'Content that is user-generated', value: '90%' },
  { label: 'Conversion rate for global brands', value: '21.4%' },
  { label: 'Average daily time per user', value: '55 min' },
  { label: 'Users seeking purchase advice monthly', value: '200M+' },
];

const whyEssential = [
  {
    number: '01',
    title: 'It\'s China\'s purchase decision engine',
    description: '60%+ of users start with the search bar, looking for reviews and recommendations. RedNote is the first stop before buying.',
  },
  {
    number: '02',
    title: 'Trust drives distribution',
    description: 'The algorithm rewards authentic content and buries ads. Saves and comments matter more than likes.',
  },
  {
    number: '03',
    title: 'The audience has spending power',
    description: 'Young, urban, affluent. Tier-1 and tier-2 cities. Willing to spend on quality.',
  },
  {
    number: '04',
    title: 'Social commerce is built in',
    description: 'Find, review, demo, buy. All without leaving the app.',
  },
];

const services = [
  {
    number: '01',
    title: 'Account setup and verification',
    description: 'Professional Account (Blue V) registration, overseas license translation, trademark documentation, platform compliance.',
    result: 'A live, verified RedNote account ready to publish.',
  },
  {
    number: '02',
    title: 'Content strategy and production',
    description: 'Content pillars, editorial calendar, platform-specific formats. AIGC visuals powered by HubStudio.ai. Real-life shoots in China. Native Chinese copywriting and cultural adaptation.',
    result: 'Content built for how RedNote actually works, not repurposed from Instagram.',
  },
  {
    number: '03',
    title: 'KOL and KOC campaigns',
    description: 'Full-service via RedNote\'s official Pugongying platform. Influencer sourcing, fake follower detection, content co-creation, ROI reporting.',
    result: 'Verified influencer partnerships with transparent performance data.',
  },
  {
    number: '04',
    title: 'Paid advertising',
    description: 'In-Feed Ads, Search Ads, Juguang full management, Juguang Lite, Chengfeng for e-commerce. Creative testing, bid optimization, real-time adjustments. Ad spend billed separately. No markups.',
    result: 'Ads that reach the right audience with transparent spend reporting.',
  },
  {
    number: '05',
    title: 'E-commerce and live commerce',
    description: 'In-app store setup, shoppable notes, live-streaming production. Live sessions drive 90% of RedNote\'s in-platform sales.',
    result: 'A storefront inside RedNote where content leads directly to purchase.',
  },
  {
    number: '06',
    title: 'Analytics and social listening',
    description: 'Growth, engagement, search ranking, campaign ROI dashboards. Brand monitoring, sentiment analysis, trend detection, competitor tracking.',
    result: 'Clear reporting on what\'s working and what needs adjustment.',
  },
];

const algorithm = [
  {
    title: 'Staged distribution',
    description: 'New posts reach 100 to 500 test users first. Strong engagement in the first 24 hours pushes it to thousands, then hundreds of thousands.',
  },
  {
    title: 'CES scoring',
    description: 'Follows (8 pts), comments and shares (4 pts each), likes and saves (1 pt each). Deep engagement moves you up. Likes alone don\'t.',
  },
  {
    title: 'Authenticity enforced',
    description: 'Hard-sell content, fake reviews, and bot behavior get suppressed. Consistent quality posting earns higher visibility over time.',
  },
  {
    title: 'Dual engine',
    description: 'Every note competes for Explore feed traffic (recommendations) and Search traffic (intent). Optimize for both.',
  },
];

const bestPractices = [
  {
    title: 'Write for RedNote, not Instagram.',
    description: 'Detailed, practical, experience-based notes win. Tutorials, honest reviews, and step-by-step guides outperform polished brand campaigns.',
  },
  {
    title: 'Nail the cover image and title.',
    description: 'They determine whether users click. Clear, benefit-driven titles with relevant keywords. Clean, text-overlaid cover images.',
  },
  {
    title: 'Optimize for search.',
    description: 'RedNote is a search engine. Use trending keywords, write titles that match what users type, and use the platform\'s built-in hashtag recommendation tool.',
  },
  {
    title: 'Encourage saves and comments.',
    description: 'End notes with a question or a reason to bookmark. Saves and comments drive the CES score that controls distribution.',
  },
  {
    title: 'Stay in the platform.',
    description: 'RedNote penalizes external links. Keep users engaged within the app. In-app stores and internal funnels outperform redirects.',
  },
  {
    title: 'Post consistently.',
    description: 'Accounts with 180+ days of consistent activity get bonus exposure. Pick your content pillars. Stick to them.',
  },
];

const industries = [
  {
    title: 'Beauty and cosmetics',
    description: 'The most popular category. Reviews, tutorials, ingredient breakdowns.',
  },
  {
    title: 'Fashion and apparel',
    description: 'Styling, trends, seasonal lookbooks, KOC seeding.',
  },
  {
    title: 'Luxury',
    description: 'Storytelling-led content for a high-intent, affluent audience.',
  },
  {
    title: 'Food and beverage',
    description: 'Restaurant reviews, recipes, product tastings.',
  },
  {
    title: 'Travel and hospitality',
    description: 'Destination guides, hotel reviews. 64% of Chinese travelers use RedNote for trip planning.',
  },
  {
    title: 'Health and wellness',
    description: 'Fitness, supplements, wellness tips. Fast-growing vertical.',
  },
  {
    title: 'B2B',
    description: 'RedNote covers 100+ professional verticals. Decision-makers research suppliers and vendors on the platform.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Book a 30-minute call.',
    description: 'Your brand, your goals, your China readiness.',
  },
  {
    number: '02',
    title: 'We send back a proposal.',
    description: 'Clear scope. Fixed price. You know exactly what you get.',
  },
  {
    number: '03',
    title: 'We get to work.',
    description: 'Account setup, content strategy, first notes live within two weeks.',
  },
];
---

<PageLayout
  title="RedNote / Xiaohongshu Marketing Services | TheRedScroll"
  description="We run RedNote accounts from Shanghai. Content strategy, KOL campaigns, paid ads, e-commerce, and analytics. Fixed scope, fixed price."
>
  <!-- Hero -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/platforms" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; All platforms
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          RedNote marketing
        </p>
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          China's product discovery platform. 350M+ users. The first place consumers go before they buy.
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          We don't talk about RedNote. We post on it. Every day. From Shanghai.
        </p>
        <Button variant="primary" href="/contact">Book a call</Button>
      </div>
    </Container>
  </section>

  <!-- Stats -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="RedNote by the numbers">
          Not vanity numbers. This is where your Chinese customers make buying decisions.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-2 gap-[16px]">
        {stats.map((stat) => (
          <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px] text-center">
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]">
              {stat.value}
            </p>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4]">
              {stat.label}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Why RedNote is essential -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="mb-[48px] max-[640px]:mb-[32px]">
        <SectionBar />
        <SectionHeading overline="Why RedNote is essential">
          If your brand isn't on RedNote, you're invisible at the moment people decide what to buy.
        </SectionHeading>
      </div>

      <div class="max-w-[680px]">
        <p class="text-[16px] text-[#1A1A1A] font-normal leading-[1.6] mb-[24px]">
          RedNote (Xiaohongshu) is where Chinese consumers research products, compare brands, and make buying decisions. Social content, community trust, and in-app shopping in one platform.
        </p>
      </div>

      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] mt-[32px]">
        {whyEssential.map((item) => (
          <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
            <p class="text-[12px] font-medium text-[#CC3333] leading-none mb-[8px]">{item.number}</p>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">{item.title}</h3>
            <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5]">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Our RedNote services -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="mb-[48px] max-[640px]:mb-[32px]">
        <SectionBar />
        <SectionHeading overline="What we do on RedNote">
          Six services. Each with a clear deliverable.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {services.map((service) => (
          <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
            <p class="text-[12px] font-medium text-[#CC3333] leading-none mb-[8px]">{service.number}</p>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">{service.title}</h3>
            <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] mb-[12px]">
              {service.description}
            </p>
            <p class="text-[13px] text-[#1A1A1A] font-normal leading-[1.5]">
              You get: {service.result}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- How the algorithm works -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="How the algorithm works">
          Understanding distribution is the difference between 300 views and 300,000.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {algorithm.map((item) => (
          <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">{item.title}</h3>
            <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5]">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Best practices (dark section) -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] py-[48px] px-[48px] max-[640px]:px-[20px] max-[640px]:py-[32px]">
        <div class="mb-[40px] max-[640px]:mb-[32px]">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
            From our team on the ground
          </p>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF]">
            RedNote best practices
          </h2>
          <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.5] mt-[8px] max-w-[680px]">
            We post on RedNote from China, every day. These come from doing the work.
          </p>
        </div>

        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[20px]">
          {bestPractices.map((practice) => (
            <div class="border-l-[3px] border-[#CC3333] pl-[16px]">
              <h3 class="text-[16px] text-[#FFFFFF] font-medium leading-[1.3] mb-[4px]">
                {practice.title}
              </h3>
              <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.5]">
                {practice.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Industries -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="mb-[48px] max-[640px]:mb-[32px]">
        <SectionBar />
        <SectionHeading overline="Industries we serve on RedNote">
          From beauty to B2B. Each vertical has its own playbook.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {industries.map((industry) => (
          <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">{industry.title}</h3>
            <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5]">
              {industry.description}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Why TheRedScroll -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="mb-[48px] max-[640px]:mb-[32px]">
        <SectionBar />
        <SectionHeading overline="Why TheRedScroll">
          We don't advise on RedNote from a different timezone.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">On the ground in China</h3>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5]">
            Our team is in Shanghai. Native speakers who post on RedNote daily, with real-time access to every feature, direct KOL relationships, and the cultural instinct you only get from being here.
          </p>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Fixed scope. Fixed price.</h3>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5]">
            Every deliverable gets spelled out before we start. Posts, campaigns, reports. One monthly price. No scope creep charges, no invoices you didn't expect.
          </p>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">AI-powered production</h3>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5]">
            We use HubStudio.ai to produce visuals, video drafts, and first-pass copy at speed. Strategy, brand voice, and creative direction are always our team. Always will be.
          </p>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">We know the algorithm</h3>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5]">
            CES scoring, staged distribution, search optimization. We build content strategies around how RedNote actually ranks and surfaces content, not guesswork from reading articles about it.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Getting started -->
  <section class="mt-[96px] max-[640px]:mt-[64px] mb-[96px] max-[640px]:mb-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Getting started">
          From zero to a live RedNote account in two weeks.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px]">
        {steps.map((step) => (
          <div class="bg-[#F7F2EE] rounded-[10px] p-[24px] max-[640px]:p-[20px] text-center">
            <p class="text-[12px] font-medium text-[#CC3333] leading-none mb-[8px]">Step {step.number}</p>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">{step.title}</h3>
            <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5]">
              {step.description}
            </p>
          </div>
        ))}
      </div>

      <div class="text-center mt-[40px]">
        <Button variant="primary" href="/contact">Book a call</Button>
      </div>

      <!-- Cross-links -->
      <div class="mt-[48px] pt-[24px] border-t border-[rgba(0,0,0,0.08)] text-center">
        <p class="text-[13px] text-[#5C5C5C] font-normal mb-[12px]">See also</p>
        <div class="flex justify-center gap-[24px] flex-wrap">
          <a href="/platforms/wechat" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">WeChat marketing &rarr;</a>
          <a href="/platforms/douyin" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Douyin marketing &rarr;</a>
          <a href="/platforms/weibo" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Weibo marketing &rarr;</a>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
