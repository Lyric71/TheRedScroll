---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';

const stats = [
  { label: 'Monthly active users', value: '350M+', image: '/images/platforms/rednote-stats/monthly-active-users.png' },
  { label: 'Daily post views', value: '9.12B', image: '/images/platforms/rednote-stats/daily-post-views.png' },
  { label: 'Monthly search queries', value: '1B+', image: '/images/platforms/rednote-stats/monthly-search-queries.png' },
  { label: 'Users aged 18 to 35', value: '70%', image: '/images/platforms/rednote-stats/users-aged-18-35.png' },
  { label: 'Content that is user-generated', value: '90%', image: '/images/platforms/rednote-stats/user-generated-content.png' },
  { label: 'Conversion rate for global brands', value: '21.4%', image: '/images/platforms/rednote-stats/conversion-rate.png' },
  { label: 'Avg. daily time per user', value: '55 min', image: '/images/platforms/rednote-stats/daily-time-per-user.png' },
  { label: 'Users seeking purchase advice monthly', value: '200M+', image: '/images/platforms/rednote-stats/purchase-advice-users.png' },
];

const whyEssential = [
  {
    title: 'It\'s China\'s purchase decision engine',
    description: '60%+ of users start with the search bar, looking for reviews and recommendations. RedNote is the first stop before buying.',
    image: '/images/platforms/rednote-why/purchase-decision.png',
  },
  {
    title: 'Trust drives distribution',
    description: 'The algorithm rewards authentic content and buries ads. Saves and comments matter more than likes.',
    image: '/images/platforms/rednote-why/trust-distribution.png',
  },
  {
    title: 'The audience has spending power',
    description: 'Young, urban, affluent. Tier-1 and tier-2 cities. Willing to spend on quality.',
    image: '/images/platforms/rednote-why/spending-power.png',
  },
  {
    title: 'Social commerce is built in',
    description: 'Find, review, demo, buy. All without leaving the app.',
    image: '/images/platforms/rednote-why/social-commerce.png',
  },
];

const algorithm = [
  {
    title: 'Staged distribution',
    description: 'New posts reach 100 to 500 test users first. Strong engagement in the first 24 hours pushes it to thousands, then hundreds of thousands.',
    image: '/images/platforms/rednote-algorithm/staged-distribution.png',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  },
  {
    title: 'CES scoring',
    description: 'Follows (8 pts), comments and shares (4 pts each), likes and saves (1 pt each). Deep engagement moves you up. Likes alone don\'t.',
    image: '/images/platforms/rednote-algorithm/ces-scoring.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
  },
  {
    title: 'Authenticity enforced',
    description: 'Hard-sell content, fake reviews, and bot behavior get suppressed. Consistent quality posting earns higher visibility over time.',
    image: '/images/platforms/rednote-algorithm/authenticity-enforced.png',
    bg: '#CC3333',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: 'Dual engine',
    description: 'Every note competes for Explore feed traffic (recommendations) and Search traffic (intent). Optimize for both.',
    image: '/images/platforms/rednote-algorithm/dual-engine.png',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
  },
];

const services = [
  {
    title: 'Account setup and verification',
    description: 'Professional Account (Blue V) registration, overseas license translation, trademark documentation, platform compliance. We deal with the paperwork so you\'re not waiting around.',
    result: 'A live, verified RedNote account ready to publish.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/rednote-services/account-setup.png',
  },
  {
    title: 'Content strategy and production',
    description: 'Content pillars, editorial calendar, platform-specific formats. AIGC visuals powered by HubStudio.ai. Real-life shoots in China. Native Chinese copywriting and cultural adaptation.',
    result: 'Content built for how RedNote actually works, not repurposed from Instagram.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
    image: '/images/platforms/rednote-services/content-strategy.png',
  },
  {
    title: 'KOL and KOC campaigns',
    description: 'Full-service via RedNote\'s official Pugongying platform. Influencer sourcing, fake follower detection, content co-creation, ROI reporting.',
    result: 'Verified influencer partnerships with transparent performance data.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    image: '/images/platforms/rednote-services/kol-koc.png',
  },
  {
    title: 'Paid advertising',
    description: 'In-Feed Ads, Search Ads, Juguang full management, Juguang Lite, Chengfeng for e-commerce. Creative testing, bid optimization, real-time adjustments. Ad spend billed separately. No markups.',
    result: 'Ads that reach the right audience with transparent spend reporting.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/rednote-services/paid-advertising.png',
  },
  {
    title: 'E-commerce and live commerce',
    description: 'In-app store setup, shoppable notes, live-streaming production. Live sessions drive 90% of RedNote\'s in-platform sales.',
    result: 'A storefront inside RedNote where content leads directly to purchase.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
    image: '/images/platforms/rednote-services/ecommerce-live.png',
  },
  {
    title: 'Analytics and social listening',
    description: 'Growth, engagement, search ranking, campaign ROI dashboards. Brand monitoring, sentiment analysis, trend detection, competitor tracking.',
    result: 'Clear reporting on what\'s working and what needs adjustment.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
    image: '/images/platforms/rednote-services/analytics-listening.png',
  },
];

const bestPractices = [
  {
    title: 'Write for RedNote, not Instagram.',
    description: 'Detailed, practical, experience-based notes win. Tutorials, honest reviews, and step-by-step guides outperform polished brand campaigns.',
  },
  {
    title: 'Nail the cover image and title.',
    description: 'They determine whether users click. Clear, benefit-driven titles with relevant keywords. Clean, text-overlaid cover images.',
  },
  {
    title: 'Optimize for search.',
    description: 'RedNote is a search engine. Use trending keywords, write titles that match what users type, and use the platform\'s built-in hashtag recommendation tool.',
  },
  {
    title: 'Encourage saves and comments.',
    description: 'End notes with a question or a reason to bookmark. Saves and comments drive the CES score that controls distribution.',
  },
  {
    title: 'Stay in the platform.',
    description: 'RedNote penalizes external links. Keep users engaged within the app. In-app stores and internal funnels outperform redirects.',
  },
  {
    title: 'Post consistently.',
    description: 'Accounts with 180+ days of consistent activity get bonus exposure. Pick your content pillars. Stick to them.',
  },
];

const industries = [
  { title: 'Beauty and cosmetics', description: 'The most popular category. Reviews, tutorials, ingredient breakdowns.' },
  { title: 'Fashion and apparel', description: 'Styling, trends, seasonal lookbooks, KOC seeding.' },
  { title: 'Luxury', description: 'Storytelling-led content for a high-intent, affluent audience.' },
  { title: 'Food and beverage', description: 'Restaurant reviews, recipes, product tastings.' },
  { title: 'Travel and hospitality', description: 'Destination guides, hotel reviews. 64% of Chinese travelers use RedNote for trip planning.' },
  { title: 'Health and wellness', description: 'Fitness, supplements, wellness tips. Fast-growing vertical.' },
  { title: 'B2B', description: 'RedNote covers 100+ professional verticals. Decision-makers research suppliers and vendors on the platform.' },
];

const steps = [
  {
    number: '01',
    title: 'Discovery call.',
    description: 'Your brand, your goals, your China readiness. No pitch deck. Just the right questions.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Proposal.',
    description: 'Clear scope. Fixed price. Every deliverable listed out. You see what you\'re getting and what it costs before you commit.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'Live in 2 weeks.',
    description: 'Account setup, content strategy, first notes live. Fourteen days from signed contract to first post going live.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  {
    q: 'Where is your team based?',
    a: 'Shanghai and Hong Kong. Native Chinese speakers with real-time access to every major platform. We post on RedNote daily, run ad accounts from inside the ecosystem, and work directly with KOLs across the country. This isn\'t remote consulting. We\'re on the ground.',
  },
  {
    q: 'Can my brand get on RedNote without a Chinese company?',
    a: 'Yes. RedNote lets overseas businesses open a Professional Account (Blue V) using a translated business license and trademark docs. We take care of the paperwork, the platform submission, and the back-and-forth with RedNote\'s review team. Most accounts are live within two weeks.',
  },
  {
    q: 'How long until we see results?',
    a: 'RedNote doesn\'t reward impatience. New accounts go through an algorithm observation window, so the first 2 to 3 months are really about building your content library and training the algorithm on your category. Paid ads and KOL campaigns can bring traffic from week one while the organic side catches up.',
  },
  {
    q: 'What exactly do we get each month?',
    a: 'Everything is spelled out before you sign. Posts, videos, ad campaigns, KOL activations, reports. You review and approve content before it goes live. No gray areas. No surprise invoices showing up at month end.',
  },
  {
    q: 'How does pricing work?',
    a: 'One fixed monthly fee covers everything in your scope. Ad spend gets billed separately at cost, and you see every line item. We don\'t take commissions on media. The number in the proposal is the number you pay. That\'s it.',
  },
  {
    q: 'Who creates the content, and who checks it?',
    a: 'Strategy and copy come from our Shanghai team. AI-generated visuals are produced through HubStudio.ai, trained specifically on your brand guidelines. Photo and video shoots happen on location in China. Before anything goes live, a native Chinese editor reviews for tone, cultural fit, and platform compliance.',
  },
  {
    q: 'How do you find the right KOLs for our brand?',
    a: 'Through RedNote\'s official Pugongying platform. Over 100,000 verified influencers. Every KOL we shortlist goes through audience authenticity checks, fake follower detection, engagement-quality scoring. Then we match on niche, content style, and your budget.',
  },
  {
    q: 'Can you run RedNote ads for a company based outside China?',
    a: 'Yes, though there\'s a catch. RedNote\'s Juguang ad platform needs a Chinese entity to open an account. We set up and run ad accounts on behalf of overseas clients through our local structure, and you get weekly spend reports with full visibility into performance.',
  },
  {
    q: 'Do we need to commit for a long time?',
    a: 'Shortest engagement is 3 months. That\'s the minimum to get past RedNote\'s algorithm ramp-up and collect enough performance data to know what\'s working. Most clients stay longer once the numbers start moving.',
  },
  {
    q: 'We don\'t speak Chinese. Is that a problem?',
    a: 'No. All client communication happens in English. Strategy calls, monthly reports, content approvals, everything. The team is fully bilingual. You focus on your brand, we handle the platform side in Chinese.',
  },
];
---

<PageLayout
  title="RedNote / Xiaohongshu Marketing Services | TheRedScroll"
  description="We run RedNote accounts from Shanghai. Content strategy, KOL campaigns, paid ads, e-commerce, and analytics. Fixed scope, fixed price."
>
  <!-- Hero -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/rednote-hero.png')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/platforms/others" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; All platforms
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          RedNote marketing
        </p>
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          China's product discovery platform. 350M+ users. The first place consumers go before they buy.
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          We don't talk about RedNote. We post on it. Every day. From Shanghai.
        </p>
        <Button variant="primary" href="/contact">Book a call</Button>
      </div>
    </Container>
  </section>

  <!-- Stats — horizontal scroll strip -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            Not vanity numbers. This is where buying decisions happen.
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            RedNote by the numbers.
          </p>
        </div>
        <Button variant="primary" href="/contact" class="shrink-0">Book a call</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>

      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div
              class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none"
              data-stat-index={i}
            >
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why RedNote is essential -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Why RedNote is essential">
          If your brand isn't on RedNote, you're invisible at the moment people decide what to buy.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {whyEssential.map((item) => (
          <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
            <div class="w-full aspect-[16/9] overflow-hidden">
              <img src={item.image} alt={item.title} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div class="p-[24px] max-[640px]:p-[20px]">
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">{item.title}</h3>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] mt-[24px] text-center max-w-[680px] mx-auto">
        RedNote (Xiaohongshu) is where Chinese consumers research products, compare brands, and make buying decisions. Social content, community trust, and in-app shopping in one platform.
      </p>
    </Container>
  </section>

  <!-- How the algorithm works — ServicesGrid-style cards -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="How the algorithm works">
          Understanding distribution is the difference between 300 views and 300,000.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {algorithm.map((item) => (
          <div
            class="algo-card relative border-none overflow-hidden flex flex-col justify-between"
            style={`border-radius: ${item.bg === '#1A1A1A' || item.bg === '#CC3333' ? '12px' : '10px'}`}
            data-tilt-algo
          >
            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out algo-bg" style={`background-image: url('${item.image}')`} aria-hidden="true"></div>
            <div class="absolute inset-0" style={`background: ${item.bg}; opacity: 0.72`} aria-hidden="true"></div>
            <div class="relative z-[1] p-[24px] max-[640px]:p-[20px]">
              <div class="w-[40px] h-[40px] rounded-[6px] flex items-center justify-center mb-[16px]" style={`background: ${item.iconBg}`}>
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="text-[18px] font-medium leading-[1.3] mb-[8px]" style={`color: ${item.textColor}`}>
                {item.title}
              </h3>
              <p class="text-[13px] font-normal leading-[1.5]" style={`color: ${item.descColor}`}>
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- What we do on RedNote — selector + panel -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="What we do on RedNote">
          Six services. Each with a clear deliverable.
        </SectionHeading>
      </div>

      <!-- Desktop: two-column selector + panel -->
      <div class="grid grid-cols-[340px_1fr] max-[1024px]:grid-cols-[280px_1fr] max-[768px]:hidden gap-[24px] items-stretch">
        <!-- Left: selector list -->
        <div class="flex flex-col gap-[4px]">
          {services.map((service, i) => (
            <button
              class:list={[
                'svc-selector flex items-center gap-[12px] px-[16px] py-[14px] rounded-[8px] text-left cursor-pointer border-none transition-all duration-300 relative',
                i === 0 ? 'svc-selector-active' : '',
              ]}
              data-svc-select={i}
              style={i === 0 ? 'background: #F7F2EE' : 'background: transparent'}
            >
              <div
                class="svc-sel-indicator absolute left-0 top-[12px] bottom-[12px] w-[3px] rounded-full transition-all duration-300"
                style={i === 0 ? 'background: #CC3333; opacity: 1' : 'background: #CC3333; opacity: 0'}
              ></div>
              <div
                class="svc-sel-icon w-[36px] h-[36px] rounded-[6px] shrink-0 flex items-center justify-center transition-all duration-300"
                style={i === 0 ? 'background: #E8E0D8; color: #CC3333' : 'background: transparent; color: #5C5C5C'}
              >
                <Fragment set:html={service.icon} />
              </div>
              <span
                class="svc-sel-label text-[14px] font-medium leading-[1.3] transition-colors duration-300"
                style={i === 0 ? 'color: #1A1A1A' : 'color: #5C5C5C'}
              >
                {service.title}
              </span>
            </button>
          ))}
        </div>

        <!-- Right: content panel -->
