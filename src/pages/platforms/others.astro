---
import PageLayout from '../../layouts/PageLayout.astro';
import UpdatedDate from '../../components/ui/UpdatedDate.astro';
import { faqPageSchema, serviceSchema } from '../../lib/schema';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';

const platforms = [
  {
    name: 'Bilibili',
    chineseName: 'B站',
    mau: '366M',
    audience: 'Gen Z, urban, educated. 78% under 35',
    category: 'Video and community',
    description: 'China\'s home for long-form video. Started in anime and gaming, now covers tech, education, beauty, automotive and just about everything else. Close to 70% of Chinese Gen Z are active here. Users don\'t scroll through quick clips. They sit down and watch. Average session: 107 minutes.',
    detail: 'Bilibili turned profitable for the first time in 2025. Ad revenue grew 27% year over year. The danmu feature (bullet comments that scroll across the video while you watch) turns passive viewing into something closer to a shared experience.',
    bestFor: 'Tech, gaming, education, beauty, automotive. Top formats: deep-dives, tutorials, unboxing series, collabs with UP主 (Bilibili creators).',
    image: '/images/platforms/additional-platforms/bilibili.png',
    logo: '/images/platforms/bilibili-logo.svg',
    brandColor: '#00A1D6',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
  },
  {
    name: 'Kuaishou',
    chineseName: '快手',
    mau: '731M',
    audience: 'Broad. Strong in tier 3-4 cities',
    category: 'Video and community',
    description: '731 million monthly users. The audience skews tier 3-5 cities and values real content over polished brand videos. The "Laotie" culture (roughly: trusted friend) rewards creators who show up week after week and talk straight.',
    detail: 'One detail most brands miss: users over 40 drive more than 47% of total e-commerce spending on the platform. That\'s a demographic most companies aren\'t even thinking about.',
    bestFor: 'FMCG, food and beverage, agriculture, brands selling outside tier 1-2 cities. Top formats: live commerce, product demos, factory tours.',
    image: '/images/platforms/additional-platforms/kuaishou.png',
    logo: '/images/platforms/kuaishou-logo.svg',
    brandColor: '#FF4906',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
  },
  {
    name: 'Zhihu',
    chineseName: '知乎',
    mau: '~83M',
    audience: 'Professionals. 80%+ bachelor\'s degree',
    category: 'Text and knowledge',
    description: 'China\'s leading Q&A platform. Over 80% of users hold a bachelor\'s degree. 59% female as of Q2 2025. Content gets indexed by Baidu and keeps pulling traffic for months. On Douyin, a post disappears in 48 hours. On Zhihu, it compounds.',
    detail: 'About 83 million monthly users. Smaller audience, but these are high-intent buyers who do their homework before purchasing. And 14.2 million of them pay for premium content.',
    bestFor: 'B2B, professional services, education, tech, healthcare, luxury. Top formats: expert answers, industry analysis, case studies.',
    image: '/images/platforms/additional-platforms/zhihu.png',
    logo: '/images/platforms/zhihu-logo.svg',
    brandColor: '#0066FF',
    bg: '#CC3333',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
  },
  {
    name: 'Toutiao',
    chineseName: '今日头条',
    mau: '410M',
    audience: 'News readers. Ages 25-35',
    category: 'Text and knowledge',
    description: 'ByteDance\'s news platform. 410 million monthly users. Distributes content by interest, not follower count. A brand with zero followers can reach millions on day one if the article gets traction.',
    detail: 'Account setup is painful and bans come fast. You need a team that already knows the rules.',
    bestFor: 'B2B, manufacturing, tech, product launches.',
    image: '/images/platforms/additional-platforms/toutiao.png',
    logo: '/images/platforms/toutiao-logo.svg',
    brandColor: '#ED1C24',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
  },
  {
    name: 'Baidu Tieba',
    chineseName: '百度贴吧',
    mau: '300M',
    audience: 'Interest-based communities',
    category: 'Text and knowledge',
    description: 'China\'s original forum platform. Organized by keyword, like Reddit. 300 million monthly users. Posts get indexed by Baidu, so active participation builds community trust and search rankings at the same time.',
    detail: '',
    bestFor: 'Consumer electronics, gaming, automotive, brands with niche fan communities.',
    image: '/images/platforms/additional-platforms/baidu-tieba.png',
    logo: '/images/platforms/baidu-tieba-logo.svg',
    brandColor: '#4879BD',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
  },
  {
    name: 'Meituan/Dianping',
    chineseName: '美团/大众点评',
    mau: '770M+',
    audience: 'Food, travel, local services',
    category: 'Commerce and lifestyle',
    description: 'China\'s biggest local services platform. 770M+ annual users, 14.5M merchants. Dianping is where consumers check reviews before visiting any physical business. A strong profile drives foot traffic. A neglected one pushes people to the competition.',
    detail: '',
    bestFor: 'Hospitality, F&B, beauty, wellness, tourism, retail with physical stores.',
    image: '/images/platforms/additional-platforms/meituan.png',
    logo: '/images/platforms/meituan-logo.svg',
    brandColor: '#FFD100',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
  },
  {
    name: 'Pinduoduo',
    chineseName: '拼多多',
    mau: '880M+',
    audience: 'Value shoppers. Tier 3-4 cities',
    category: 'Commerce and lifestyle',
    description: 'Third-largest e-commerce platform in China. Parent company also runs Temu. 880M+ monthly users, mostly in tier 3-4 cities. Built on group buying and steep discounts. Also supports cross-border e-commerce and live commerce.',
    detail: '',
    bestFor: 'FMCG, consumer goods, health and beauty, cross-border. Not the right platform for luxury-first brands.',
    image: '/images/platforms/additional-platforms/pinduoduo.png',
    logo: '/images/platforms/pinduoduo-logo.svg',
    brandColor: '#E02E24',
    bg: '#B02D2D',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
  },
  {
    name: 'Lemon8',
    chineseName: '柠檬8',
    mau: '23M',
    audience: 'Lifestyle, visual content',
    category: 'Commerce and lifestyle',
    description: 'ByteDance\'s visual lifestyle platform. 23M users and the number keeps climbing. Think Pinterest meets RedNote, built around curated aesthetic content. The platform is newer but gaining traction fast, especially in beauty and travel verticals.',
    detail: '',
    bestFor: 'Beauty, fashion, food, travel, home decor. Photo-first content, carousels, product styling.',
    image: '/images/platforms/additional-platforms/lemon8.png',
    logo: '/images/platforms/lemon8-logo.svg',
    brandColor: '#FFE135',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
  },
  {
    name: 'QQ',
    chineseName: '腾讯QQ',
    mau: '534M',
    audience: '91% of users aged 15-24',
    category: 'Commerce and lifestyle',
    description: '534M monthly users. 91% of users aged 15-24 are on it. Communities function kind of like Discord servers for the youngest slice of Chinese Gen Z. The platform also integrates gaming and music features, which keeps engagement high among students.',
    detail: 'QQ is not WeChat. Different audience, different rules entirely.',
    bestFor: 'Gaming, education, entertainment, youth brands.',
    image: '/images/platforms/additional-platforms/qq.png',
    logo: '/images/platforms/qq-logo.svg',
    brandColor: '#12B7F5',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
  },
];

const stats = [
  { label: 'Bilibili daily session', value: '107 min', image: '/images/platforms/additional-platforms/bilibili.png' },
  { label: 'Kuaishou MAU', value: '731M', image: '/images/platforms/additional-platforms/kuaishou.png' },
  { label: 'Pinduoduo MAU', value: '880M+', image: '/images/platforms/additional-platforms/pinduoduo.png' },
  { label: 'Meituan annual users', value: '770M+', image: '/images/platforms/additional-platforms/meituan.png' },
  { label: 'QQ monthly users', value: '534M', image: '/images/platforms/additional-platforms/qq.png' },
  { label: 'Toutiao MAU', value: '410M', image: '/images/platforms/additional-platforms/toutiao.png' },
  { label: 'Bilibili MAU', value: '366M', image: '/images/platforms/additional-platforms/bilibili.png' },
  { label: 'Baidu Tieba MAU', value: '300M', image: '/images/platforms/additional-platforms/baidu-tieba.png' },
  { label: 'Zhihu MAU', value: '~83M', image: '/images/platforms/additional-platforms/zhihu.png' },
  { label: 'Lemon8 users', value: '23M', image: '/images/platforms/additional-platforms/lemon8.png' },
];

const services = [
  {
    title: 'Account setup and verification',
    description: 'Registration, verification, profile optimization. Full platform compliance. We handle the paperwork on every platform so you don\'t get stuck on forms written in Chinese.',
    result: 'Live, verified accounts ready to publish.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/additional-services/account-setup.png',
  },
  {
    title: 'Content production',
    description: 'AI-powered visuals via HubStudio.ai plus native Chinese copywriting. Strategy is human-led. Every post reviewed and approved by native speakers in China. Content gets adapted to each platform\'s format and audience.',
    result: 'Platform-native content your audience wants to engage with.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
    image: '/images/platforms/additional-services/content-production.png',
  },
  {
    title: 'Publishing and community management',
    description: 'Scheduled posting at platform-optimal times, comment moderation, community engagement, audience growth. Posting frequency is agreed upfront in your scope of work.',
    result: 'Consistent presence with active community engagement.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
    image: '/images/platforms/additional-services/publishing.png',
  },
  {
    title: 'Advertising',
    description: 'Ad account setup, campaign management, creative production, performance reporting. We bill ad spend at cost with no markup.',
    result: 'Ads that reach the right audience with transparent spend.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/additional-services/advertising.png',
  },
  {
    title: 'KOL and KOC campaigns',
    description: 'Influencer sourcing, vetting, campaign management and ROI reporting across all platforms. UP主 on Bilibili, 达人 on Kuaishou, 大V on Zhihu. We source, vet, manage and report. Verified engagement data only.',
    result: 'Influencer campaigns with transparent ROI reporting.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    image: '/images/platforms/additional-services/kol-campaigns.png',
  },
  {
    title: 'Analytics and reporting',
    description: 'Monthly reports on growth, engagement, content performance and business-relevant KPIs. All reporting delivered in English with Chinese-language data attached for your local teams.',
    result: 'Clear monthly reports with actionable insights.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
    image: '/images/platforms/additional-services/analytics.png',
  },
];

const recommendations = [
  { goal: 'Reach Gen Z with in-depth video', platforms: 'Bilibili' },
  { goal: 'Sell to value-conscious buyers in smaller cities', platforms: 'Kuaishou, Pinduoduo' },
  { goal: 'Build long-term search visibility', platforms: 'Zhihu, Baidu Tieba' },
  { goal: 'Drive foot traffic to physical locations', platforms: 'Meituan/Dianping' },
  { goal: 'Reach mass audiences with news content', platforms: 'Toutiao' },
  { goal: 'Connect with students and gamers', platforms: 'QQ' },
  { goal: 'Build a visual lifestyle presence', platforms: 'Lemon8' },
];

const steps = [
  {
    number: '01',
    title: 'Book a call.',
    description: '30 minutes. Your brand, your audience, your China goals. No pitch deck. Just the right questions.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Get a recommendation.',
    description: 'We identify which platforms fit and build them into your package. Clear scope. Fixed price.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'Launch.',
    description: 'Account setup, first content, ongoing management. Usually within two weeks.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  {
    q: 'Who creates the content for these platforms?',
    a: 'Native Chinese speakers in Shanghai and Hong Kong. HubStudio.ai speeds up visual production, but a human strategist builds the content plan and a native editor reviews every piece for cultural fit, tone and compliance. No post goes live without a real person signing off.',
  },
  {
    q: 'Do you have actual access to all 14 platforms?',
    a: 'Yes. We log into these platforms from China every single day. Several platforms restrict features from overseas IPs. Agencies working remotely from other countries run into access issues they can\'t fix. We don\'t have that problem.',
  },
  {
    q: 'How do you pick which platforms are right for my brand?',
    a: 'We look at your industry, audience and goals. A hospitality brand needs Meituan/Dianping. A B2B tech company gets more from Zhihu and Toutiao. We recommend what fits your business, not what pads a proposal.',
  },
  {
    q: 'Can I add platforms to an existing package?',
    a: 'Yes. Any platform, any time. We add it to your scope with clear deliverables and a fixed price.',
  },
  {
    q: 'What does "AI-powered content" actually mean?',
    a: 'Strategy and editorial direction are 100% human. HubStudio.ai handles the visual side of production: product imagery, social assets, video drafts. A native editor then goes through every piece for accuracy, platform rules and brand voice. The AI makes production faster. The people on our team make sure everything is right.',
  },
  {
    q: 'How do you handle content moderation rules?',
    a: 'Every platform runs its own moderation system and they\'re all different. Bilibili flags certain keywords that Zhihu wouldn\'t care about. Toutiao bans accounts faster than most platforms. We know what gets approved and what gets your account suspended because we deal with this stuff daily.',
  },
  {
    q: 'How long to get set up on a new platform?',
    a: 'One to three weeks depending on the platform. We handle registration, verification, profile setup and first content. Most clients see their first post go live within two to three weeks.',
  },
  {
    q: 'Do you run influencer campaigns on these platforms?',
    a: 'Yes. UP主 on Bilibili, 达人 on Kuaishou, 大V on Zhihu. We source, vet, manage and report. Influencer fees quoted separately and transparently.',
  },
  {
    q: 'How do you measure results?',
    a: 'We pull data from platform backends directly, not third-party tools. Reports cover follower growth, engagement, content performance and platform-specific KPIs. For Zhihu that might mean Baidu search impressions. For Meituan, review volume and rating trends. For Kuaishou, live commerce conversions. We report on what actually moves the needle for your business.',
  },
  {
    q: 'How does pricing work?',
    a: 'Fixed scope, fixed price. Every deliverable spelled out before we begin. You pay one monthly fee per platform. No hourly rates, no scope creep charges. Ad spend is always billed separately at cost.',
  },
];

const videoAndCommunity = platforms.filter(p => p.category === 'Video and community');
const textAndKnowledge = platforms.filter(p => p.category === 'Text and knowledge');
const commerceAndLifestyle = platforms.filter(p => p.category === 'Commerce and lifestyle');
---

<PageLayout
  title="Additional Platforms: Bilibili, Kuaishou, Zhihu, and More | TheRedScroll"
  description="14 platforms most agencies skip. Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Pinduoduo, and more. Fixed scope, fixed price. Team on the ground in China."
  schema={[
    serviceSchema({
      name: 'Additional China Platform Marketing',
      description: 'Marketing services for Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Pinduoduo and other Chinese platforms most agencies do not cover.',
      url: '/platforms/others',
      serviceType: 'Social Media Marketing',
    }),
    faqPageSchema(faqs),
  ]}
>
  <!-- Hero: Dark hero banner -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/additional-platforms-hero.png')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      更多平台
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Beyond the big four
        </p>
        <UpdatedDate date="May 2026" variant="light" class="mb-[8px]" />
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          14 platforms most agencies skip
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          Your customers watch Bilibili for two hours straight. They check Dianping before picking a restaurant. They trust Zhihu answers over ads. They shop live on Kuaishou during the commute home. We post on all of them. Every day, from Shanghai and Hong Kong.
        </p>
        <div class="flex items-center justify-center gap-[12px] flex-wrap">
          <Button variant="primary" href="/contact">Book a call</Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- Stats section — horizontal scroll strip -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            Over 1.1 billion people in China use social media. They don't stick to four apps.
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            The numbers across 9 additional platforms.
          </p>
        </div>
        <Button variant="primary" href="/contact" class="shrink-0">Book a call</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>

      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div
              class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none"
              data-stat-index={i}
            >
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>{stat.value}</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why these platforms matter -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Why these platforms matter">
          Most agencies stop at four. Going further takes a team on the ground.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/additional-why/focused-attention.png" alt="Person watching long-form video content with full attention" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
