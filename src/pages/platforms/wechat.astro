---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import UpdatedDate from '../../components/ui/UpdatedDate.astro';
import { faqPageSchema, serviceSchema } from '../../lib/schema';

const stats = [
  { label: 'Monthly active users', value: '1.4B+', image: '/images/platforms/wechat-stats/monthly-active-users.png' },
  { label: 'Users in China', value: '810M+', image: '/images/platforms/wechat-stats/users-in-china.png' },
  { label: 'Avg. daily time per user', value: '82 min', image: '/images/platforms/wechat-stats/daily-time-per-user.png' },
  { label: 'Mini Program monthly users', value: '945M', image: '/images/platforms/wechat-stats/mini-program-users.png' },
  { label: 'WeChat Pay active users', value: '935M+', image: '/images/platforms/wechat-stats/wechat-pay-users.png' },
  { label: 'Messages sent daily', value: '45B', image: '/images/platforms/wechat-stats/messages-sent-daily.png' },
  { label: 'Official Accounts', value: '3.5M+', image: '/images/platforms/wechat-stats/official-accounts.png' },
  { label: 'Users opening 10+ times/day', value: '60%+', image: '/images/platforms/wechat-stats/daily-opens.png' },
];

const ecosystem = [
  {
    name: 'Service Account',
    chineseName: '服务号',
    description: 'Your brand\'s home base. Custom menus, WeChat Pay, CRM tools. 4 posts per month, up to 32 articles total. The only account type foreign companies can register on their own.',
    image: '/images/platforms/wechat-ecosystem/service-account.png',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
  },
  {
    name: 'Mini Programs',
    chineseName: '小程序',
    description: 'Apps inside WeChat. No download needed. E-commerce, bookings, loyalty, games. 945M monthly users. Plugs straight into WeChat Pay.',
    image: '/images/platforms/wechat-ecosystem/mini-programs.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
  },
  {
    name: 'WeChat Channels',
    chineseName: '视频号',
    description: 'Short video and livestreaming. Links to your Official Account and Mini Program. Watch a video, tap through, buy. Stays inside WeChat.',
    image: '/images/platforms/wechat-ecosystem/wechat-channels.png',
    bg: '#CC3333',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
  },
  {
    name: 'WeChat Pay',
    chineseName: '微信支付',
    description: 'Mobile payments. 935M+ active users. Street food to designer bags. If you sell anything in China, you need it.',
    image: '/images/platforms/wechat-ecosystem/wechat-pay.png',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  },
  {
    name: 'WeCom',
    chineseName: '企业微信',
    description: 'Enterprise CRM. Direct messaging, audience segments, automated outreach. Reaches 750M+ WeChat users. Most brands set it up way too late.',
    image: '/images/platforms/wechat-ecosystem/wecom.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    name: 'Moments',
    chineseName: '朋友圈',
    description: 'Social feed where users share life updates. Brands place paid ads right in the feed. Best format for broad awareness.',
    image: '/images/platforms/wechat-ecosystem/moments.png',
    bg: '#B02D2D',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];

const services = [
  {
    title: 'Account setup and verification',
    description: 'We register your Service Account, push it through verification, set up menus, auto-replies, and brand assets. We deal with the paperwork so you\'re not waiting around.',
    result: 'A live, verified WeChat account ready to publish.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/wechat-services/account-setup.png',
  },
  {
    title: 'Content strategy and production',
    description: 'We map your content pillars, build the calendar, and produce articles, graphics, and short videos. Native Chinese speakers write everything. HubStudio.ai keeps production moving fast.',
    result: 'Localized content your Chinese audience actually wants to read.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
    image: '/images/platforms/wechat-services/content-strategy.png',
  },
  {
    title: 'Mini Program development',
    description: 'Online stores, lead capture, loyalty programs, booking tools. Built inside WeChat, connected to Pay.',
    result: 'A storefront that turns readers into buyers without sending them somewhere else.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
    image: '/images/platforms/wechat-services/mini-program.png',
  },
  {
    title: 'WeChat advertising',
    description: 'Media planning, creative, A/B tests, bid management, performance reports. Moments Ads, Banner Ads, Mini Program Ads. We bill ad spend at cost with no markup.',
    result: 'Ads that reach the right audience with transparent spend reporting.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/wechat-services/advertising.png',
  },
  {
    title: 'WeCom and CRM',
    description: 'Private domain setup from the start. Segmentation, welcome sequences, one-on-one outreach, group chats. This is the part most agencies skip.',
    result: 'A customer list that no platform can take from you.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    image: '/images/platforms/wechat-services/wecom-crm.png',
  },
  {
    title: 'Channels and KOL campaigns',
    description: 'Short video production, livestreams on WeChat Channels, plus Key Opinion Leader sourcing, vetting, and campaign management. Verified engagement data only.',
    result: 'Content and influencer campaigns that connect back to your account and Mini Program.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
    image: '/images/platforms/wechat-services/channels-kol.png',
  },
];

const bestPractices = [
  {
    title: 'Quality beats frequency, every time.',
    description: 'Service Accounts get 4 posts a month. One article that people share is worth more than four with 30 opens.',
  },
  {
    title: 'Don\'t translate. Localize.',
    description: 'Taking your English content and running it through translation doesn\'t cut it. Start from a Chinese brief, written by someone who knows the platform.',
  },
  {
    title: 'Build your Mini Program early.',
    description: 'You don\'t need to be selling yet. A product catalog, a brand quiz, an event sign-up form. Give readers a next step after your article.',
  },
  {
    title: 'Start WeCom on day one.',
    description: 'Every follower should become a WeCom contact. Six months in, brands with a strong private domain are playing a different game.',
  },
  {
    title: 'Paid and organic together.',
    description: 'Moments Ads grow your follower count fast. But if there\'s nothing worth reading when they land, they unfollow within weeks.',
  },
  {
    title: 'Think in systems, not channels.',
    description: 'Connect your Official Account to a Mini Program, tie in WeCom for retention, use Channels for discovery. Each piece feeds the others.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Discovery call.',
    description: 'Tell us about your brand, your goals, and where you stand with China right now. No pitch deck. Just the right questions.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Proposal.',
    description: 'Clear SOW. Fixed price. Every deliverable listed out. You see what you\'re getting and what it costs before you commit.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'Live in 2 weeks.',
    description: 'Onboarding, accounts set up, first content published. Fourteen days from signed contract to first post going live.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  {
    q: 'Who actually runs my WeChat account?',
    a: 'Our team in Shanghai and Hong Kong. Native Chinese speakers who use the platform every day. You\'ll have a dedicated account manager, and behind them sits a full team: copywriters, designers, video producers, strategists. Everyone is in China. We\'re not outsourcing to freelancers or managing your account remotely from another continent.',
  },
  {
    q: 'Can you set up a WeChat Official Account for a foreign company?',
    a: 'Yes. Foreign companies can register a Service Account with an overseas business license. Takes about 1 to 2 weeks. We handle the whole process: registration, verification, configuration, so you don\'t get bogged down in Tencent\'s paperwork.',
  },
  {
    q: 'Do we need a Chinese business entity?',
    a: 'Short answer: no, not to get started. Foreign companies can open a Service Account directly. That said, a few things work better with a Chinese entity, like WeChat Pay merchant acceptance and certain ad formats. We\'ll map out what you can and can\'t do with your current setup before anything kicks off.',
  },
  {
    q: 'How does pricing work?',
    a: 'Fixed scope, fixed price. Before we begin, we spell out every deliverable: articles, videos, campaigns, reports. You pay one monthly fee. No hourly rates, no scope creep charges, no invoices you weren\'t expecting. Ad spend is always billed separately at cost. No markup.',
  },
  {
    q: 'We already have a WeChat account but it\'s not going anywhere. Can you help?',
    a: 'That\'s pretty common. We audit the account, look at what\'s working and what isn\'t, and rebuild from there. Sometimes the content just doesn\'t land. Sometimes there\'s no Mini Program, so followers read an article and then have nowhere to go. We diagnose first, then fix.',
  },
  {
    q: 'How fast can we go live?',
    a: 'Most clients go from zero to a live, publishing account in under two weeks. That covers registration, verification, setup, and first content. If you\'ve already got a verified account, we can start producing content within a few days.',
  },
  {
    q: 'Do you only work with international brands?',
    a: 'No. We work with three types of clients: international brands entering China, international brands already here, and Chinese domestic brands growing their social presence. Services are the same. Strategy changes based on where you are and what you\'re after.',
  },
  {
    q: 'What makes your content production different from other agencies?',
    a: 'Our copywriters are native Chinese speakers who write for WeChat specifically, not translators working off an English doc. On the production side, we use HubStudio.ai for visuals and video, which speeds things up and brings costs down. But creative direction and strategy are always human-led.',
  },
  {
    q: 'How do you handle KOL campaigns on WeChat?',
    a: 'We run the whole thing from sourcing to reporting. Finding the right Key Opinion Leaders, writing briefs, co-creating content, coordinating posts, tracking results. We only use verified engagement data. If a KOL\'s follower count looks inflated, we pass.',
  },
  {
    q: 'How do you report on results?',
    a: 'Monthly reports. Follower growth, article open rates, Mini Program traffic, ad performance, conversions. Real numbers, plain language. If something\'s underperforming, we tell you what\'s off and what we\'re changing.',
  },
];

const pageSchemas = [
  serviceSchema({
    name: 'WeChat Marketing Services',
    description: 'WeChat Official Account management, Mini Program development, WeCom CRM, Channels, and paid advertising for international brands in China.',
    url: '/platforms/wechat',
    serviceType: 'Social Media Marketing',
  }),
  faqPageSchema(faqs),
];
---

<PageLayout
  title="WeChat Marketing Services for International Brands | TheRedScroll"
  description="We run WeChat accounts from Shanghai and Hong Kong. Official Accounts, Mini Programs, WeCom, Channels, and ads. Fixed scope, fixed price."
  schema={pageSchemas}
>
  <!-- Hero: Dark hero banner (Style A) -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/wechat-hero.png')" aria-hidden="true"></div>
    <!-- Watermark -->
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      微信
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/platforms/others" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; All platforms
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          WeChat marketing
        </p>
        <UpdatedDate date="May 2026" variant="light" class="mb-[8px]" />
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          WeChat is where 1.4 billion people chat, pay, shop, and follow brands
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          We run WeChat accounts from Shanghai and Hong Kong. Every day. For brands that want more followers, more engagement, and more conversions in China.
        </p>
        <Button variant="primary" href="/contact">Book a call</Button>
      </div>
    </Container>
  </section>

  <!-- Stats section — horizontal scroll strip -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            Not vanity numbers. Your Chinese audience is already here.
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            WeChat by the numbers.
          </p>
        </div>
        <Button variant="primary" href="/contact" class="shrink-0">Book a call</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>

      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div
              class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none"
              data-stat-index={i}
            >
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>{stat.value}</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why WeChat comes first -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Why WeChat comes first">
          Your website, email list, CRM, and payment page. All in one app.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <!-- Card 1: You own your audience -->
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/wechat-why/own-audience.png" alt="Person scrolling through WeChat followers on their phone" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">You own your audience</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              Douyin and RedNote are algorithm-driven. WeChat is different. Your followers are yours. You message them, sort them by behavior, build the relationship month after month. People in China call this private domain traffic: a customer list no platform can take from you.
            </p>
          </div>
        </div>

        <!-- Card 2: Full journey in one app -->
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/wechat-why/full-journey.png" alt="Customer completing a purchase through WeChat Mini Program" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">One app, full journey</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              Someone finds your brand, reads your article, opens your Mini Program store, pays with WeChat Pay, joins your loyalty group. No app switching, no broken links, no drop-off between steps.
            </p>
          </div>
        </div>

        <!-- Card 3: Verified account -->
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/wechat-why/verification.png" alt="Brand storefront with WeChat verified account QR code" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Verification matters</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              That blue checkmark on your Official Account carries real weight. It tells Chinese consumers you went through Tencent's verification, you're a legitimate business, and you're not just testing the waters.
            </p>
          </div>
        </div>
      </div>

      <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] mt-[24px] text-center max-w-[680px] mx-auto">
        WeChat isn't just a messaging app. It's where people pay bills, shop, read the news, book taxis, and follow brands. Chinese consumers check WeChat before they buy. If there's no Official Account, there's no trust.
      </p>
    </Container>
  </section>

  <!-- The WeChat ecosystem -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="The WeChat ecosystem">
          How do WeChat's six products work together for brands?
        </SectionHeading>
      </div>

