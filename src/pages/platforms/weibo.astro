---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';

const stats = [
  { label: 'Monthly active users', value: '567M', image: '/images/platforms/weibo-stats/monthly-active-users.png' },
  { label: 'Daily active users', value: '252M', image: '/images/platforms/weibo-stats/daily-active-users.png' },
  { label: 'Mobile usage', value: '95%', image: '/images/platforms/weibo-stats/mobile-usage.png' },
  { label: 'Ad revenue (FY2025)', value: '$1.5B', image: '/images/platforms/weibo-stats/ad-revenue.png' },
  { label: 'Biggest age group (25–34)', value: '42%', image: '/images/platforms/weibo-stats/age-group.png' },
  { label: 'Daily posts', value: '100M+', image: '/images/platforms/weibo-stats/daily-posts.png' },
  { label: 'Gender split (women)', value: '51%', image: '/images/platforms/weibo-stats/gender-split.png' },
];

const ecosystem = [
  {
    name: 'Mass awareness and PR',
    chineseName: '品牌曝光',
    description: 'Nothing in China generates national attention faster than a Weibo trend. Product launches, press amplification, event campaigns, crisis response.',
    image: '/images/platforms/weibo-ecosystem/mass-awareness.png',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  },
  {
    name: 'Trending topic campaigns',
    chineseName: '热搜营销',
    description: 'Ride organic trends with fast content, or run paid hashtag promotions to place your brand inside the national conversation at the right moment.',
    image: '/images/platforms/weibo-ecosystem/trending-topics.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
  {
    name: 'KOL and celebrity partnerships',
    chineseName: 'KOL合作',
    description: 'Top Weibo KOLs have tens of millions of followers. One post from the right influencer shifts awareness, credibility, and sales all at once.',
    image: '/images/platforms/weibo-ecosystem/kol-partnerships.png',
    bg: '#CC3333',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    name: 'Community building',
    chineseName: '超级话题',
    description: 'Weibo Super Topics create branded hubs where followers post their own content, discuss products, and engage with the brand directly.',
    image: '/images/platforms/weibo-ecosystem/community.png',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    name: 'Social commerce',
    chineseName: '社交电商',
    description: 'Shoppable posts link to Tmall and Taobao. Live streams sync with Taobao Live for real-time selling. The distance between a Weibo post and a purchase is very short.',
    image: '/images/platforms/weibo-ecosystem/social-commerce.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
  },
  {
    name: 'Reputation management',
    chineseName: '舆情管理',
    description: 'People share opinions on Weibo publicly. Monitoring brand mentions, tracking competitors, and catching sentiment shifts early is not optional.',
    image: '/images/platforms/weibo-ecosystem/reputation.png',
    bg: '#B02D2D',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
  },
];

const services = [
  {
    title: 'Account setup and verification',
    description: 'We register your Blue V corporate account end to end. Document prep, Chinese translation, submission, full profile buildout. International companies pay a one-time $1,000 verification fee. Approval takes 2 to 4 weeks. We handle everything.',
    result: 'A live, verified Weibo corporate account ready to publish.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/weibo-services/account-setup.png',
  },
  {
    title: 'Content strategy and production',
    description: 'Monthly content plans with brand posts, trending topic tie-ins, interactive formats, and campaign assets. Native Chinese content by native Chinese speakers. Short posts, 9-grid carousels, short video, live stream assets.',
    result: 'Localized content built for how Weibo\'s algorithm works today.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
    image: '/images/platforms/weibo-services/content-strategy.png',
  },
  {
    title: 'Paid advertising',
    description: 'Fan Headlines, Fan Tunnels, in-feed display, splash page ads, search promotion, hashtag promotion. Targeting by demographics, interests, behavior, and lookalike audiences. Weekly reporting on CPM, CPC, CPA, ROAS. Ad spend billed separately. No markups.',
    result: 'Ads that reach the right audience with transparent spend reporting.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/weibo-services/paid-advertising.png',
  },
  {
    title: 'KOL and KOC campaigns',
    description: 'We find, vet, negotiate, and brief influencers. Selection based on verified engagement, audience authenticity checks, niche fit, and budget. Full campaign management from creative brief to ROI report.',
    result: 'Influencer campaigns backed by verified data, not follower counts.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    image: '/images/platforms/weibo-services/kol-campaigns.png',
  },
  {
    title: 'Hot Search and topic campaigns',
    description: 'Topic creation, content seeding, KOL amplification, community activation, paid promotion. Built to put your brand in the national conversation when it matters most.',
    result: 'Your brand inside China\'s most-watched trending list.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    image: '/images/platforms/weibo-services/hot-search.png',
  },
  {
    title: 'Social listening and analytics',
    description: 'Daily monitoring of brand mentions, competitor moves, sentiment shifts, and trending conversations. Monthly reports on follower growth, engagement, content performance, ad results, KOL returns, and competitive benchmarks.',
    result: 'Actionable reports with specific recommendations for next month.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
    image: '/images/platforms/weibo-services/analytics.png',
  },
];

const bestPractices = [
  {
    title: 'Post every day.',
    description: 'Once a day minimum. Three to five in growth mode. The algorithm rewards consistency.',
  },
  {
    title: 'Lead with visuals.',
    description: 'Use all 9 image slots. Center image gets the most attention. Short video outperforms static posts consistently.',
  },
  {
    title: 'React fast to trends.',
    description: 'Check the Hot Search list every morning. Publish within the hour when something relevant breaks.',
  },
  {
    title: 'Write tight.',
    description: 'Posts fold after 140 characters. Strong first sentence. Clear call to action above the fold.',
  },
  {
    title: 'Actually reply to people.',
    description: 'The comment section is where real conversations happen. Brands that engage build loyalty much faster than brands that just broadcast.',
  },
  {
    title: 'Verify early.',
    description: 'The Blue V badge builds trust, improves reach, unlocks ad tools, and protects against copycat accounts.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Discovery call.',
    description: 'Tell us about your brand, your goals, and how ready you are for China. No pitch deck. Just the right questions.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Proposal.',
    description: 'Clear scope. Fixed price. Every deliverable listed out. No surprises.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'Live in 2 weeks.',
    description: 'Account live, first content published, first campaign running. Fourteen days from signed contract to first post.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  {
    q: 'Who actually runs our Weibo account?',
    a: 'Our team in Shanghai and Hong Kong. Native Chinese speakers write your content, buy the ads, and deal with KOLs directly. We are not a remote agency sitting in London or New York guessing what is trending in China. We log into Weibo every morning, same timezone as your audience.',
  },
  {
    q: 'Can a company registered outside China open a Weibo account?',
    a: 'Yes, and we do this regularly. Foreign companies can get a verified corporate account with a Blue V badge. You will need business registration documents translated into Chinese and a one-time $1,000 fee paid to Weibo for verification. Takes about 2 to 4 weeks to get approved. We handle the documents, translation, and back-and-forth with Weibo\'s team so you don\'t have to.',
  },
  {
    q: 'How does pricing work?',
    a: 'Fixed scope. Fixed price. We define every deliverable before the project starts. How many posts, how many videos, which campaigns, what reporting. You see the full picture and the total cost upfront. No vague custom quotes. No hidden fees that show up three months in.',
  },
  {
    q: 'What makes you different from other agencies doing Weibo?',
    a: 'We are physically based in China with direct access to every platform, not running things remotely from overseas. We use AI tools (HubStudio.ai) for content production, which means faster turnaround and lower costs without cutting corners on quality. And we are the only agency we have found that offers fixed-price packages. We looked at 37 competitors. None of them do this.',
  },
  {
    q: 'How fast can we get going?',
    a: 'About two weeks from signing. Account registration, profile setup, first content live, first campaign launched. Weibo\'s own verification process takes 2 to 4 weeks on their end, but we don\'t sit around waiting. We start building and posting while the Blue V badge is being processed.',
  },
  {
    q: 'Is all the content written in Chinese?',
    a: 'Yes. Everything we publish on Weibo is written in Chinese by native speakers, then proofread by a second native speaker for tone and cultural accuracy. You will receive English summaries of content plans and monthly reports. If you want to review individual posts before they go live, we build that into the workflow.',
  },
  {
    q: 'Do we really need Weibo if we already use WeChat and RedNote?',
    a: 'Short answer: yes. WeChat keeps content inside closed circles. RedNote is strong for product discovery. But neither lets your brand reach a mass public audience or participate in national trending conversations. If a crisis breaks, a cultural moment is blowing up, or you simply need millions of people to learn your brand name quickly, Weibo is the only platform in China that does that.',
  },
  {
    q: 'How do you choose which KOLs to work with?',
    a: 'Not by follower count. We audit real engagement rates, run fake-follower checks, analyze audience demographics, and review each KOL\'s content style against your brand. We also compare their pricing against market rates so you know you\'re getting a fair deal. Every KOL we recommend comes with the data behind the recommendation.',
  },
  {
    q: 'What does reporting look like?',
    a: 'Monthly. Each report covers follower growth, engagement rates, content performance broken down by format, ad campaign results (CPM, CPC, CPA, ROAS), KOL campaign returns, and competitive benchmarks. We end every report with clear recommendations for the following month. You also get a mid-month check-in if you\'re running active campaigns.',
  },
  {
    q: 'What if we want more than just Weibo?',
    a: 'Most of our clients do. Weibo is one of over 18 platforms we work on. We build and run campaigns across Weibo, WeChat, RedNote, Douyin, and others like Bilibili, Zhihu, or Kuaishou depending on your industry. Everything is coordinated by one team, delivered under one scope of work, and billed at one fixed price.',
  },
];
---

<PageLayout
  title="Weibo Marketing Services | TheRedScroll"
  description="Weibo marketing services from Shanghai. Account setup, content, ads, KOL campaigns, and analytics. Fixed scope. Fixed price. 567M monthly active users."
>
  <!-- Hero: Dark hero banner -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/weibo-hero.png')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      微博
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/platforms/others" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; All platforms
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Weibo marketing
        </p>
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          We don't talk about Weibo strategy. We post on Weibo. Every day. From Shanghai.
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          Weibo marketing from Shanghai. Account setup, content, ads, KOL campaigns, analytics. 567 million monthly users. Fixed scope. Fixed price. Team on the ground.
        </p>
        <Button variant="primary" href="/contact">Book a call</Button>
      </div>
    </Container>
  </section>

  <!-- Stats section — horizontal scroll strip -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            China's open public square. 567 million people, every month.
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            Weibo by the numbers.
          </p>
        </div>
        <Button variant="primary" href="/contact" class="shrink-0">Book a call</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>

      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div
              class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none"
              data-stat-index={i}
            >
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why Weibo matters -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Why Weibo matters">
          Trends start here. News breaks here. Public opinion takes shape here.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/weibo-why/public-square.png" alt="Weibo app open showing public feed with trending posts and user discussions" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Everything is public</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              WeChat content stays locked inside friend circles. On Weibo, anyone can see your posts. A single product launch or a well-timed comment on a trending topic can reach millions of people who have never followed your account.
            </p>
          </div>
        </div>

        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/weibo-why/hot-search.png" alt="Weibo Hot Search trending list showing top 50 topics refreshing in real time" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">The Hot Search list drives the platform</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              It refreshes every minute. Topics that hit the top 50 get seen by hundreds of millions of users within hours. Brands that create content around those moments get organic reach that paid ads alone can't match.
            </p>
          </div>
        </div>

        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden">
            <img src="/images/platforms/weibo-why/brand-research.png" alt="Consumer scrolling through Weibo brand page checking reviews and comments before purchasing" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Consumers research brands here</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
              Chinese shoppers search for brand names and scroll through what real users are saying. Strong presence builds trust. No presence raises red flags. Negative comments left unanswered do real damage.
            </p>
          </div>
        </div>
      </div>

      <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] mt-[24px] text-center max-w-[680px] mx-auto">
        Weibo covers the full funnel. Mass awareness through trending topics at the top. Direct sales through Tmall and Taobao Live integrations at the bottom. Few Chinese platforms do both well. Weibo does.
      </p>
    </Container>
  </section>

  <!-- How Weibo helps brands grow -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="How Weibo helps brands grow">
          Six ways to turn attention into revenue.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {ecosystem.map((item) => (
          <div
            class="eco-card relative border-none overflow-hidden flex flex-col justify-between"
            style={`border-radius: ${item.bg === '#1A1A1A' || item.bg === '#CC3333' || item.bg === '#B02D2D' ? '12px' : '10px'}`}
            data-tilt-eco
          >
            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out eco-bg" style={`background-image: url('${item.image}')`} aria-hidden="true"></div>
