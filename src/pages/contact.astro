---
import BaseLayout from '../layouts/BaseLayout.astro';
import { mainNav } from '../data/navigation';

const servicesNav = mainNav.find((item) => item.label === 'Services');
const platformsNav = mainNav.find((item) => item.label === 'Platforms');

const services = (servicesNav?.children ?? []).map((s) => s.label);
const platforms = (platformsNav?.children ?? []).map((p) =>
  p.label === 'Additional Platforms' ? 'Other (Bilibili, Kuaishou, Zhihu…)' : p.label,
);

const budgets = [
  'Under 5,000 USD',
  '5,000 to 15,000 USD',
  '15,000 to 30,000 USD',
  'Over 30,000 USD',
];
---

<BaseLayout
  title="Contact | TheRedScroll"
  description="Get in touch with TheRedScroll. Book a call or tell us about your project. Offices in Shanghai and Hong Kong."
  hideFooterCta={true}
>
  <main class="pt-[60px] max-[640px]:pt-[52px]">

    <!-- Contact: dark section with info + form -->
    <section class="relative w-full bg-[#1A1A1A] py-[80px] max-[1024px]:py-[64px] max-[640px]:py-[48px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/hero/contact-bg.png')" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.75]" aria-hidden="true"></div>
      <div class="relative z-[1] max-w-[1200px] mx-auto">
        <!-- Title -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">Contact</p>
          <h1 class="text-[#FFFFFF] text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] mb-[8px]">
            Let's talk about growing your brand in China.
          </h1>
          <p class="text-[rgba(255,255,255,0.6)] text-[16px] font-normal leading-[1.6] max-w-[480px]">
            Book a call, ask a question, or tell us about your project. We respond within one business day.
          </p>
        </div>

        <div class="grid grid-cols-[1fr_1fr] max-[1024px]:grid-cols-1 gap-[64px] max-[640px]:gap-[48px] items-start">

          <!-- Left: Contact form card -->
          <div class="bg-[#FFFFFF] rounded-[10px] p-[32px] max-[640px]:p-[20px] max-[1024px]:order-1">
            <h2 class="text-[18px] text-[#1A1A1A] font-medium leading-[1.3] mb-[24px]">Tell us about your project</h2>

            <form id="contact-form" class="flex flex-col gap-[16px]">
              <!-- Name row -->
              <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[12px]">
                <div>
                  <label class="block text-[13px] font-normal text-[#5C5C5C] mb-[4px]">First name <span class="text-[#CC3333]">*</span></label>
                  <input type="text" name="firstName" required class="block w-full h-[44px] px-[12px] text-[14px] font-normal text-[#1A1A1A] bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[6px] outline-none transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)] focus:border-[#1A1A1A] placeholder:text-[#5C5C5C] placeholder:opacity-60" placeholder="First name" />
                </div>
                <div>
                  <label class="block text-[13px] font-normal text-[#5C5C5C] mb-[4px]">Last name <span class="text-[#CC3333]">*</span></label>
                  <input type="text" name="lastName" required class="block w-full h-[44px] px-[12px] text-[14px] font-normal text-[#1A1A1A] bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[6px] outline-none transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)] focus:border-[#1A1A1A] placeholder:text-[#5C5C5C] placeholder:opacity-60" placeholder="Last name" />
                </div>
              </div>

              <!-- Email -->
              <div>
                <label class="block text-[13px] font-normal text-[#5C5C5C] mb-[4px]">Email <span class="text-[#CC3333]">*</span></label>
                <input type="email" name="email" required class="block w-full h-[44px] px-[12px] text-[14px] font-normal text-[#1A1A1A] bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[6px] outline-none transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)] focus:border-[#1A1A1A] placeholder:text-[#5C5C5C] placeholder:opacity-60" placeholder="you@company.com" />
              </div>

              <!-- Company -->
              <div>
                <label class="block text-[13px] font-normal text-[#5C5C5C] mb-[4px]">Company <span class="text-[#CC3333]">*</span></label>
                <input type="text" name="company" required class="block w-full h-[44px] px-[12px] text-[14px] font-normal text-[#1A1A1A] bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[6px] outline-none transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)] focus:border-[#1A1A1A] placeholder:text-[#5C5C5C] placeholder:opacity-60" placeholder="Company name" />
              </div>

              <!-- Website -->
              <div>
                <label class="block text-[13px] font-normal text-[#5C5C5C] mb-[4px]">Website</label>
                <input type="url" name="website" class="block w-full h-[44px] px-[12px] text-[14px] font-normal text-[#1A1A1A] bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[6px] outline-none transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)] focus:border-[#1A1A1A] placeholder:text-[#5C5C5C] placeholder:opacity-60" placeholder="https://yourcompany.com" />
              </div>

              <!-- Services -->
              <fieldset class="border-0 p-0 m-0">
                <legend class="block text-[13px] font-normal text-[#5C5C5C] mb-[8px]">Services you're interested in</legend>
                <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-x-[12px] gap-y-[8px]">
                  {services.map((service) => (
                    <label class="flex items-center gap-[8px] text-[13px] font-normal text-[#1A1A1A] leading-[1.4] cursor-pointer">
                      <input type="checkbox" name="services" value={service} class="w-[16px] h-[16px] accent-[#CC3333] cursor-pointer flex-shrink-0" />
                      <span>{service}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <!-- Platforms -->
              <fieldset class="border-0 p-0 m-0">
                <legend class="block text-[13px] font-normal text-[#5C5C5C] mb-[8px]">Platforms you're interested in</legend>
                <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-x-[12px] gap-y-[8px]">
                  {platforms.map((platform) => (
                    <label class="flex items-center gap-[8px] text-[13px] font-normal text-[#1A1A1A] leading-[1.4] cursor-pointer">
                      <input type="checkbox" name="platforms" value={platform} class="w-[16px] h-[16px] accent-[#CC3333] cursor-pointer flex-shrink-0" />
                      <span>{platform}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <!-- Budget -->
              <fieldset class="border-0 p-0 m-0">
                <legend class="block text-[13px] font-normal text-[#5C5C5C] mb-[8px]">Estimated budget</legend>
                <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-x-[12px] gap-y-[8px]">
                  {budgets.map((budget) => (
                    <label class="flex items-center gap-[8px] text-[13px] font-normal text-[#1A1A1A] leading-[1.4] cursor-pointer">
                      <input type="radio" name="budget" value={budget} class="w-[16px] h-[16px] accent-[#CC3333] cursor-pointer flex-shrink-0" />
                      <span>{budget}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <!-- Message -->
              <div>
                <label class="block text-[13px] font-normal text-[#5C5C5C] mb-[4px]">Tell us about your project <span class="text-[#CC3333]">*</span></label>
                <textarea name="message" required rows="5" class="block w-full px-[12px] py-[12px] text-[14px] font-normal text-[#1A1A1A] bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[6px] outline-none transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)] focus:border-[#1A1A1A] placeholder:text-[#5C5C5C] placeholder:opacity-60 resize-vertical leading-[1.5] min-h-[120px]" placeholder="What are your goals in China? Timing, audience, anything we should know."></textarea>
              </div>

              <!-- Honeypot — hidden from humans, bots fill it -->
              <div class="absolute opacity-0 h-0 w-0 overflow-hidden" aria-hidden="true" tabindex="-1">
                <label for="website_url">Website URL</label>
                <input type="text" name="website_url" id="website_url" autocomplete="off" tabindex="-1" />
              </div>

              <!-- Captcha -->
              <div>
                <label id="captcha-label" class="block text-[13px] font-normal text-[#5C5C5C] mb-[4px]"></label>
                <input type="text" name="captcha" id="captcha-input" required inputmode="numeric" class="block w-full h-[44px] px-[12px] text-[14px] font-normal text-[#1A1A1A] bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[6px] outline-none transition-[border-color] duration-150 hover:border-[rgba(0,0,0,0.15)] focus:border-[#1A1A1A] placeholder:text-[#5C5C5C] placeholder:opacity-60" placeholder="Your answer" />
                <input type="hidden" name="captcha_answer" id="captcha-answer" />
              </div>

              <!-- Submit -->
              <div class="flex justify-end mt-[8px]">
                <button type="submit" id="submit-btn" class="inline-flex items-center justify-center h-[44px] px-[28px] text-[14px] font-medium leading-none text-[#FFFFFF] bg-[#CC3333] rounded-[6px] border-none cursor-pointer transition-[background] duration-150 hover:bg-[#B02D2D] active:scale-[0.98]">
                  Send message
                </button>
              </div>

              <!-- Status message -->
              <div id="form-status" class="hidden text-[13px] font-normal leading-[1.5] mt-[8px]"></div>
            </form>
          </div>

          <!-- Right: Contact info -->
          <div class="max-[1024px]:order-2">
            <!-- Email -->
            <div class="mb-[32px]">
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[8px]">Email</p>
              <a href="mailto:hello@beyondbordergroup.com" class="text-[16px] text-[#FFFFFF] font-medium transition-colors duration-150 hover:text-[rgba(255,255,255,0.6)] break-all">
                hello@beyondbordergroup.com
              </a>
            </div>

            <!-- Response time -->
            <div class="mb-[32px]">
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[8px]">Response time</p>
              <p class="text-[14px] text-[#FFFFFF] font-normal leading-[1.6]">
                Within 24 hours, Monday to Friday
              </p>
            </div>

            <!-- Shanghai office -->
            <div class="mb-[32px]">
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[8px]">Shanghai, China</p>
              <p class="text-[14px] text-[#FFFFFF] font-normal leading-[1.6]">
                Trinity Plaza, 19th floor, Changshou Road 868, Putuo district, Shanghai, China
              </p>
              <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.6] mt-[4px]">
                中港汇大厦, 上海市普陀区长寿路868号19楼
              </p>
            </div>

            <!-- Hong Kong office -->
            <div>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[8px]">Hong Kong</p>
              <p class="text-[14px] text-[#FFFFFF] font-normal leading-[1.6]">
                806 Capitol Center, 5-19 Jardine's Bazaar, Causeway Bay, Hong Kong
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');
  const captchaLabel = document.getElementById('captcha-label');
  const captchaAnswer = document.getElementById('captcha-answer') as HTMLInputElement;

  function generateCaptcha() {
    const a = Math.floor(Math.random() * 9) + 1;
    const b = Math.floor(Math.random() * 9) + 1;
    if (captchaLabel) captchaLabel.textContent = `What is ${a} + ${b}? *`;
    if (captchaAnswer) captchaAnswer.value = String(a + b);
  }

  generateCaptcha();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !submitBtn) return;

    submitBtn.textContent = 'Sending...';
    submitBtn.setAttribute('disabled', 'true');

    const data = new FormData(form);
    const selectedServices = data.getAll('services').join(', ') || 'None selected';
    const selectedPlatforms = data.getAll('platforms').join(', ') || 'None selected';
    const selectedBudget = data.get('budget') || 'Not specified';

    const composedMessage = [
      `Website: ${data.get('website') || 'N/A'}`,
      `Services: ${selectedServices}`,
      `Platforms: ${selectedPlatforms}`,
      `Budget: ${selectedBudget}`,
      '',
      data.get('message'),
    ].join('\n');

    const body = {
      name: `${data.get('firstName')} ${data.get('lastName')}`,
      email: data.get('email'),
      company: data.get('company'),
      message: composedMessage,
      honeypot: data.get('website_url'),
      captcha: data.get('captcha'),
      captchaAnswer: data.get('captcha_answer'),
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        window.location.href = '/thank-you';
        return;
      } else {
        const err = await res.json();
        status.textContent = err.error || 'Something went wrong. Try again.';
        status.className = 'text-[13px] font-normal leading-[1.5] mt-[8px] text-[#CC3333]';
      }
    } catch {
      status.textContent = 'Network error. Check your connection and try again.';
      status.className = 'text-[13px] font-normal leading-[1.5] mt-[8px] text-[#CC3333]';
    }

    submitBtn.textContent = 'Send message';
    submitBtn.removeAttribute('disabled');
  });
</script>
