---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campagne', 'Design', 'Médias', 'Site web'];
const platforms = ['Web', 'Réseaux sociaux', 'Publicité payante'];
---

<PageLayout
  title="Blue Insurance lancement numérique à Hong Kong | TheRedScroll"
  description="Comment Blue Insurance a lancé le premier assureur vie 100 % numérique de Hong Kong : un site bilingue, du SEO et une campagne qui a recruté 10 000 abonnés en un mois."
  ogImage="/images/clients/Blue/Blue Insurance 1.png"
  lang="fr"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Blue/Blue Insurance 1.png')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Étude de cas
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Blue Insurance : le lancement numérique du premier assureur vie 100 % digital de Hong Kong.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Blue voulait un site et une campagne de lancement pour le premier assureur vie 100 % digital de Hong Kong. Nous avons livré les deux et conquis 10 000 abonnés dès le premier mois.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#case-study">Lire l'étude de cas</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Le client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Blue Insurance</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Secteur</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Assurance / Fintech</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Marché</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Hong Kong</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Canaux</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- The Client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Le client">Le premier assureur vie 100 % digital de Hong Kong. Sans agent, sans formalités lourdes.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Blue est le premier assureur vie 100 % digital de Hong Kong. Aucun agent. Quelques questions en ligne suffisent pour obtenir sa couverture dans la foulée. Le principe est limpide : savoir de quelle assurance on a besoin, sans devoir enchaîner rendez-vous et formulaires.
            </p>
            <p>
              Blue arrivait toutefois sur un marché où les assureurs historiques avaient déjà amorcé leur virage digital. Le statut de premier acteur en ligne ne suffisait plus. Il fallait un site nettement plus simple que la concurrence et une campagne capable de générer rapidement des prospects.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Website visuals -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/Blue/Blue Insurance 1.png"
        alt="Site web Blue Insurance et campagne de lancement numérique à Hong Kong"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Blue/Blue Insurance 2.png"
        alt="Site bilingue Blue Insurance sur ordinateur et mobile"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Blue/Blue Insurance 3.png"
        alt="Campagne numérique Blue Insurance générant des abonnés et des inscriptions"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Le site Blue Insurance. Bilingue, pensé mobile-first, conçu pour les devis instantanés et les inscriptions.
      </p>
    </Container>
  </section>

  <!-- What We Did -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Notre intervention">Un site et une campagne de lancement, pensés pour aller vite.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons mené de front la création du site et la campagne de lancement digitale.
            </p>
          </div>
        </div>

        <!-- Website -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Le site devait être à la hauteur du produit</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Blue commercialise une assurance simple. Le site devait incarner la même promesse. Bilingue chinois-anglais, fluide sur mobile comme sur grand écran. Mise en page volontairement épurée. Aucun pavé de jargon assurantiel. Aucune navigation alambiquée. Chaque écran ramène le visiteur vers un devis ou une inscription.
            </p>
          </div>
        </div>

        <!-- SEO -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Un SEO intégré à l'architecture, jamais plaqué par-dessus</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Contenu, métadonnées et arborescence ont été conçus pour que Blue émerge dès qu'un habitant de Hong Kong cherche une assurance en ligne ou une couverture vie dématérialisée. Prêt à défendre sa position sur la recherche dès le premier jour.
            </p>
          </div>
        </div>

        <!-- Campaign -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">La campagne a démarré dans la même semaine</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Réseaux sociaux et publicité payante ont visé les consommateurs lassés de l'assurance traditionnelle. Le message portait sur tout ce que Blue supprime : rendez-vous, formulaires et lignes en bas de contrat.
            </p>
          </div>
        </div>

        <!-- Ground team callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Site, SEO et campagne, l'ensemble piloté par notre équipe sur place à Hong Kong.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- Stats grid -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <Container>
      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
          <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">10 000</p>
          <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">Nouveaux abonnés dès le premier mois</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
          <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">3 000+</p>
          <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">Inscriptions à la newsletter en une semaine</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
          <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">Bilingue</p>
          <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">Chinois et anglais, optimisé pour les deux</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Outcome -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Les résultats">10 000 abonnés et 3 000 inscriptions avant que la plupart des jeunes pousses n'aient terminé leur lancement.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Le site est sorti bilingue, rapide, optimisé sur tous les supports. L'expérience mobile rivalisait avec celle du grand écran. Sur un marché où l'assurance se compare depuis un téléphone, cet équilibre compte.
            </p>
            <p>
              Les résultats sont arrivés vite : 10 000 nouveaux abonnés dès le premier mois, plus de 3 000 inscriptions à la newsletter en une semaine. Pour un assureur tout juste lancé, sans audience préexistante, les chiffres en disent long. Les habitants de Hong Kong attendaient ce type d'offre.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="À votre tour">Besoin d'un site et d'une campagne de lancement à Hong Kong ?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Périmètre arrêté. Tarif ferme. Équipe sur place.
        </p>
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
