---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campagne', 'eCommerce', 'Influenceur / KOL', 'Médias', 'Social'];
const platforms = ['WeChat', 'Weibo', 'Tmall'];
---

<PageLayout
  title="Marriott Super Brand Day en Chine | TheRedScroll"
  description="Comment Marriott a organisé son premier Super Brand Day en Chine. Social, médias, eCommerce et activation KOL pour des millions de ventes sur Tmall et des inscriptions Bonvoy."
  ogImage="/images/clients/Marriott/Marriot-campaign-SBD-KV.jpg"
  lang="fr"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Marriott/Marriot-campaign-SBD-KV.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Étude de cas
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Marriott : un Super Brand Day chiffré en millions.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Marriott orchestrait son premier Super Brand Day en Chine. Nous avons piloté l'intégralité de la campagne et déclenché plusieurs millions de ventes sur Tmall.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#case-study">Lire l'étude de cas</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Le client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Marriott International</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Secteur</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Hôtellerie / Voyage</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Plateformes</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- The Client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Le client">Neuf mille établissements dans le monde. Premier Super Brand Day en Chine.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Marriott exploite plus de 9 000 établissements, répartis entre une trentaine d'enseignes. Une notoriété mondiale, une présence partout. En Chine, le groupe affronte les chaînes hôtelières locales pour capter les voyageurs à fort pouvoir d'achat.
            </p>
            <p>
              L'objectif : générer des ventes directes, accroître les inscriptions au programme de fidélité Marriott Bonvoy et consolider le positionnement auprès des consommateurs chinois les plus dépensiers. Le levier retenu : le Super Brand Day d'Alibaba. Marriott n'en avait jamais orchestré. Visibilité maximale, trafic considérable, pression totale. Aucun rodage possible : tout devait être en place dès le jour J.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Campaign visuals -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/Marriott/campaign-SBD-Marriot-1.webp"
        alt="Visuels de la campagne Marriott Super Brand Day sur Tmall"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Marriott/campaign-SBD-Marriot-2.webp"
        alt="Contenu promotionnel de la carte noire Marriott pour le Super Brand Day"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Marriott/Campaign-SBD-Marriot-3.jpg"
        alt="Visuels de la campagne social media et media Marriott Super Brand Day"
        class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Visuels de la campagne Marriott Super Brand Day. Offre carte noire, boutique Tmall et contenu social.
      </p>
    </Container>
  </section>

  <!-- What We Did -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Notre intervention">Une campagne intégrée avec un seul objectif : vendre dès le premier jour.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons pris la campagne en main sur l'ensemble de la chaîne.
            </p>
          </div>
        </div>

        <!-- Black card -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">La carte noire a rendu l'offre commercialisable</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons bâti la campagne autour d'une carte noire Marriott exclusive, assortie de privilèges internationaux. Une édition limitée donnait accès à des nuits et des dîners dans les plus belles adresses du groupe. Au lieu d'une campagne de notoriété classique, nous avons proposé aux consommateurs quelque chose de concret à acquérir.
            </p>
            <p>
              Chez Alibaba, des emplacements médias exclusifs ont ciblé les consommateurs à haute valeur. À l'extérieur, le soutien de célébrités, les retombées presse et des événements physiques ont nourri l'engouement et la crédibilité.
            </p>
          </div>
        </div>

        <!-- Social -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Jouer le temps long autour d'un événement court</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              WeChat, Weibo et des KOL spécialisés voyage ont entretenu l'attente plusieurs semaines avant le lancement. Le contenu mettait en avant l'exclusivité de la carte noire et l'expérience réelle d'un séjour Marriott.
            </p>
            <p>
              Le jour du Super Brand Day, l'audience était déjà préparée. Le contenu des influenceurs a entretenu l'énergie pendant toute la durée de la campagne.
            </p>
          </div>
        </div>

        <!-- Tmall -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">La page Tmall a refermé le parcours</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Social, médias, KOL, relations presse : tout convergeait vers une même page e-commerce où les consommateurs acquéraient la carte et rejoignaient Bonvoy en une seule transaction.
            </p>
          </div>
        </div>

        <!-- Ground team callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Notre équipe a tout coordonné depuis la Chine : création, achat média, pilotage des influenceurs, arbitrages en temps réel le jour J pour ajuster le dispositif.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- Outcome -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Les résultats">Plusieurs millions de ventes. Des centaines de milliers de nouveaux membres Bonvoy.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Le premier Super Brand Day de Marriott a dégagé plusieurs millions de ventes sur Tmall. Des centaines de milliers de nouveaux membres ont rejoint Bonvoy. La marque en sort avec un positionnement nettement renforcé auprès des voyageurs chinois aisés.
            </p>
            <p>
              Les chiffres en attestent. Lorsque le média, le social, l'e-commerce et le terrain avancent d'un même pas en Chine, une chaîne hôtelière internationale peut dégager des revenus considérables en quelques jours.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="À votre tour">Vous voulez lancer une campagne d'envergure en Chine ?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Périmètre arrêté. Tarif ferme. Équipe sur place.
        </p>
        <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
