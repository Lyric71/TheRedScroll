---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campagne', 'Production de contenu', 'Influenceur / KOL', 'Social'];
const platforms = ['WeChat', 'RedNote', 'Weibo'];

const stats = [
  { value: '43K → 187K', label: 'Abonnés en 18 mois' },
  { value: '4,7 %', label: 'Taux d\'engagement (contre 1,2 %)' },
  { value: '38 %', label: 'Trafic eCommerce via RedNote' },
  { value: '+31 %', label: 'Ventes en boutique sur un an' },
];
---

<PageLayout
  title="Camper : étude de cas social media en Chine | TheRedScroll"
  description="Comment Camper est passé de 43K à 187K abonnés sur WeChat, RedNote et Weibo. Une stratégie sociale qui a porté les ventes en boutique à +31 % dans les villes chinoises."
  ogImage="/images/clients/Camper/Camper-Case-Study-Hero.jpg"
  lang="fr"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Camper/Camper-Case-Study-Hero.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Étude de cas
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Camper : installer une marque de design sur les réseaux sociaux chinois.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Camper voulait grandir sur le social chinois sans rien concéder à son identité de design. Nous avons quadruplé les abonnés et porté les ventes en boutique à +31 % en dix-huit mois.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#case-study">Lire l'étude de cas</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Le client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Camper</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Secteur</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Mode / Chaussures</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Plateformes</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Le client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Le client">Des chaussures nées à Majorque en 1975. En Chine, le social ne suivait pas.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Camper fabrique des chaussures à Majorque depuis 1975. Un design singulier, un savoir-faire méditerranéen, le confort placé avant la tendance.
            </p>
            <p>
              En Chine, la marque additionnait WeChat, Weibo et RedNote pour 43 000 abonnés au total et un engagement de 1,2 %. Des boutiques dans les grandes villes, mais le social ne ramenait personne en magasin. Camper voulait grandir sans renoncer à l'essentiel : l'identité de design devait imprégner chaque contenu, sans promotion agressive, sans publications lifestyle interchangeables.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Social screenshots — horizontal scroll -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/Camper/2e9bc97593dbe520397f52be0fb8e584.jpg"
        alt="Compte officiel Camper sur RedNote avec 19,3K abonnés"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Camper/3721890f3b2783008e73034b5b06b315.jpg"
        alt="Compte officiel Camper sur WeChat avec articles et contenu"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Camper/4bccf3f158a489f020e0a273f13c19ab.jpg"
        alt="Article WeChat sur la collaboration Camper x Issey Miyake"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Camper/b2a4eecb0f6665ce6c27c35983d5e7fb.jpg"
        alt="Campagne Camper Pix London sur RedNote avec contenu KOL"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        La présence sociale de Camper sur RedNote et WeChat. Collaborations KOL, récits de marque et alliances avec des designers.
      </p>
    </Container>
  </section>

  <!-- Notre intervention -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Notre intervention">Un contenu bâti autour de ce qui rend Camper digne d'intérêt.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              La cible chinoise de Camper : des professionnels sensibles au design, 28 à 45 ans. Un public que les approches commerciales frontales font fuir. Nous avons donc bâti le contenu autour de ce qui rend Camper digne d'être suivi : récits de design, collaborations artistiques, manière dont ces chaussures se portent réellement dans les villes chinoises.
            </p>
          </div>
        </div>

        <!-- RedNote -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">RedNote : notre principal terrain de jeu</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons collaboré avec des micro-influenceurs issus de l'architecture, de la décoration d'intérieur et des métiers créatifs. Le contenu approfondissait la raison d'être de chaque modèle : matériaux, construction, intention de design. Une audience plus resserrée qu'une campagne d'influence mode classique, mais un engagement nettement supérieur.
            </p>
          </div>
        </div>

        <!-- WeChat -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">WeChat : les récits au long cours</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Des mini-documentaires tournés dans les ateliers de Majorque. Les coulisses de la conception et de la fabrication. Une matière assez riche pour justifier l'abonnement dans la durée.
            </p>
          </div>
        </div>

        <!-- Weibo -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Weibo : le terrain de la conversation</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Un débat lancé sur la question récurrente (dessiner une chaussure pour le confort ou pour l'esthétique) a tenu trois jours et rassemblé des milliers de commentaires.
            </p>
          </div>
        </div>

        <!-- Ground team -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Notre équipe a tout piloté depuis la Chine. Locuteurs natifs, contenu calibré pour chaque plateforme, point hebdomadaire pour trancher sur ce qui produisait des résultats.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- Stats grid -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {stats.map((stat) => (
          <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">{stat.value}</p>
            <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Les resultats -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Les résultats">Une montée en charge progressive, puis l'accélération.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              En dix-huit mois, les abonnés sont passés de 43 000 à 187 000. L'engagement progresse de 1,2 % à 4,7 %, bien au-dessus des moyennes du secteur chaussure.
            </p>
            <p>
              RedNote constitue la vraie surprise. Avec la plus petite base d'abonnés, la plateforme génère 38 % du trafic e-commerce total. Audience resserrée, intention d'achat renforcée.
            </p>
            <p>
              L'effet se lit aussi en boutique. Les ventes à périmètre constant progressent de 31 % sur un an. La fidélisation gagne 22 %. La fréquence d'achat passe de 1,3 à 2,1 par client et par an.
            </p>
          </div>
        </div>

        <!-- Organic callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Trois créateurs RedNote ont continué à publier sur Camper après la fin des campagnes payantes. Sans contrat, sans brief. Les chaussures leur plaisaient, simplement. Ce genre de prolongement ne se commande pas.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="À votre tour">Vous voulez faire grandir une marque premium sur les réseaux sociaux chinois ?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Périmètre arrêté. Tarif ferme. Équipe sur place.
        </p>
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
