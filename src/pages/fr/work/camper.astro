---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campagne', 'Production de contenu', 'Influenceur / KOL', 'Social'];
const platforms = ['WeChat', 'RedNote', 'Weibo'];

const stats = [
  { value: '43K → 187K', label: 'Abonnes en 18 mois' },
  { value: '4,7 %', label: 'Taux d\'engagement (contre 1,2 %)' },
  { value: '38 %', label: 'Trafic eCommerce via RedNote' },
  { value: '+31 %', label: 'Ventes en boutique sur un an' },
];
---

<PageLayout
  title="Camper : etude de cas social media en Chine | TheRedScroll"
  description="Comment Camper est passe de 43K a 187K abonnes sur WeChat, RedNote et Weibo. Une strategie sociale qui a genere +31 % de ventes en boutique dans les villes chinoises."
  ogImage="/images/clients/Camper/Camper-Case-Study-Hero.jpg"
  lang="fr"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Camper/Camper-Case-Study-Hero.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Etude de cas
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Camper : developper une marque de design sur les plateformes sociales chinoises.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Camper avait besoin de croissance sociale en Chine sans renier son identite de design. Nous avons multiplie les abonnes par quatre et genere +31 % de ventes en boutique en 18 mois.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#case-study">Lire l'etude de cas</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Le client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Camper</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Secteur</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Mode / Chaussures</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Plateformes</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Le client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Le client">Des chaussures de Majorque depuis 1975. Le social en Chine ne suivait pas.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Camper fabrique des chaussures a Majorque depuis 1975. Design singulier, savoir-faire mediterraneen, le confort avant les tendances.
            </p>
            <p>
              En Chine, la marque disposait de comptes sur WeChat, Weibo et RedNote totalisant 43 000 abonnes. Taux d'engagement a 1,2 %. Des boutiques dans les villes de premier rang, mais le social ne ramenait personne en magasin. La marque avait besoin de croissance, mais pas a n'importe quel prix. L'identite de design de Camper devait transparaitre dans chaque contenu. Pas de campagnes promotionnelles, pas de posts lifestyle generiques.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Social screenshots — horizontal scroll -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/Camper/2e9bc97593dbe520397f52be0fb8e584.jpg"
        alt="Compte officiel Camper sur RedNote avec 19,3K abonnes"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Camper/3721890f3b2783008e73034b5b06b315.jpg"
        alt="Compte officiel Camper sur WeChat avec articles et contenu"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Camper/4bccf3f158a489f020e0a273f13c19ab.jpg"
        alt="Article WeChat sur la collaboration Camper x Issey Miyake"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/Camper/b2a4eecb0f6665ce6c27c35983d5e7fb.jpg"
        alt="Campagne Camper Pix London sur RedNote avec contenu KOL"
        class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        La presence sociale de Camper sur RedNote et WeChat. Collaborations KOL, recits de marque et partenariats avec des designers.
      </p>
    </Container>
  </section>

  <!-- Notre intervention -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Notre intervention">Du contenu construit autour de ce qui rend Camper digne d'interet.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              La cible de Camper en Chine, ce sont des professionnels sensibles au design, environ 28 a 45 ans. Pas le public qui reagit aux approches commerciales frontales. Nous avons donc construit le contenu autour de ce qui rend Camper digne d'etre suivi : recits de design, collaborations artistiques, et la façon dont les gens dans les villes chinoises portent vraiment ces chaussures.
            </p>
          </div>
        </div>

        <!-- RedNote -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">RedNote : la ou nous avons concentre le plus d'energie</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons travaille avec des micro-influenceurs en architecture, decoration d'interieur et metiers creatifs. Le contenu allait en profondeur sur la raison d'etre de chaque modele. Materiaux, construction, intention de design. Cela a attire une audience plus reduite qu'une campagne influenceur mode classique, mais l'engagement etait nettement superieur.
            </p>
          </div>
        </div>

        <!-- WeChat -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">WeChat : les recits au long cours</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Des mini-documentaires tournes dans les ateliers de Majorque. Les coulisses de la conception et de la fabrication chez Camper. Du contenu assez riche pour donner aux gens une vraie raison de rester abonnes.
            </p>
          </div>
        </div>

        <!-- Weibo -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Weibo : pour la conversation</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Un fil de discussion sur la question de savoir si une chaussure doit etre concue pour le confort ou pour l'esthetique a dure trois jours et genere des milliers de commentaires.
            </p>
          </div>
        </div>

        <!-- Ground team -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Notre equipe a gere l'ensemble depuis la Chine. Locuteurs natifs, contenu adapte a chaque plateforme, revues hebdomadaires pour evaluer ce qui fonctionnait ou non.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- Stats grid -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {stats.map((stat) => (
          <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">{stat.value}</p>
            <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Les resultats -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Les resultats">Les premiers mois ont ete lents. Puis les choses se sont accelerees.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              En 18 mois, le nombre d'abonnes est passe de 43 000 a 187 000. L'engagement est passe de 1,2 % a 4,7 %, bien au-dessus des moyennes du secteur de la chaussure.
            </p>
            <p>
              RedNote a ete la surprise. Malgre la plus petite base d'abonnes, la plateforme a genere 38 % de l'ensemble du trafic eCommerce. Audience plus restreinte, intention d'achat plus forte.
            </p>
            <p>
              L'effet s'est aussi manifeste en boutique. Les ventes a perimetre constant ont progresse de 31 % sur un an. La fidelisation s'est amelioree de 22 %. La frequence d'achat est passee de 1,3 a 2,1 par client et par an.
            </p>
          </div>
        </div>

        <!-- Organic callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Trois collaborateurs RedNote ont continue a publier du contenu sur Camper apres la fin des campagnes payantes. Sans contrat, sans brief. Les chaussures leur plaisaient, tout simplement. Ce genre de chose ne se commande pas dans un brief de campagne.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[640px]:p-[32px] text-center">
        <SectionHeading overline="A votre tour">Vous souhaitez developper une marque premium sur les reseaux sociaux chinois ?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Perimetre fixe. Prix fixe. Equipe sur place.
        </p>
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
