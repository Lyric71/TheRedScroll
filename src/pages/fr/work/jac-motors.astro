---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campagne', 'Production de contenu', 'Social', 'Contenu propulsé par l\'IA'];
const platforms = ['WeChat', 'RedNote', 'Weibo'];
---

<PageLayout
  title="JAC Motors : étude de cas social media en Chine | TheRedScroll"
  description="Comment JAC Motors a bâti une vraie communauté sociale sur WeChat, RedNote et Weibo. Contenu signé IA, campagne olympique et rayonnement international."
  ogImage="/images/clients/JAC/JAC-Wechat-4.jpg"
  lang="fr"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/JAC/JAC-Wechat-4.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Étude de cas
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        JAC Motors : bâtir une communauté propulsée par l'IA autour d'un géant chinois de l'automobile.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        JAC Motors visait bien plus que la simple publication. Nous avons bâti une communauté sur WeChat, RedNote et Weibo, portée par un contenu propulsé par l'IA, qui a fini par franchir les frontières chinoises.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#case-study">Lire l'étude de cas</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Le client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">JAC Motors</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Secteur</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Automobile / VE</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Plateformes</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Le client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Le client">Dix millions de véhicules vendus. Une présence sociale qui ne reflétait rien.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              JAC compte parmi les premiers constructeurs automobiles chinois. Trente ans d'activité, plus de dix millions de véhicules vendus dans le monde. Voitures particulières, véhicules électriques, utilitaires. Une entreprise d'envergure, une empreinte établie.
            </p>
            <p>
              La présence sociale, en revanche, ne témoignait pas de cette réalité. Le contenu paraissait régulièrement sur WeChat, RedNote et Weibo, mais sans susciter de réaction. Peu de commentaires, peu de partages, aucune dynamique communautaire.
            </p>
            <p>
              Pour une entreprise de cette dimension, l'écart entre le rang de marché et la présence sociale devenait trop visible.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- WeChat content — horizontal scroll -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/JAC/JAC-Wechat.jpg"
        alt="Article WeChat de JAC Motors sur le lancement du E30X aux Émirats arabes unis"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-1.jpg"
        alt="Article WeChat de JAC Motors sur la couverture médiatique et le forum RCEP"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-2.jpg"
        alt="Article WeChat de JAC Motors sur la campagne olympique J-Bot créée par IA"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-3.jpg"
        alt="Article WeChat de JAC Motors sur la campagne Rouge chinois des Jeux de Paris"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Contenu WeChat : lancements produits, campagne olympique et récits d'expansion à l'international. Faites défiler.
      </p>
    </Container>
  </section>

  <!-- Notre intervention -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Notre intervention">Reprendre depuis la base. Bâtir une communauté qui sonne juste.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons repris le contenu sur les trois plateformes. JAC ne se contentait pas de vouloir publier davantage. La marque souhaitait s'imposer comme une référence pour les passionnés d'automobile et voir naître autour d'elle une communauté authentique, fondée sur la confiance et une identité partagée.
            </p>
            <p>
              Nous avons reconstruit l'ensemble autour de trois axes : la connaissance automobile, les récits humains issus de l'intérieur et de l'entourage de JAC, et un véritable dialogue avec l'audience à la place d'un monologue de marque.
            </p>
          </div>
        </div>

        <!-- IA -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">L'IA au cœur de la production</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons mobilisé HubStudio.ai pour produire du contenu visuel sur mesure à une cadence qu'aucune production classique ne tient. L'IA a également pris en charge le suivi de performance sur les trois plateformes : lecture immédiate de ce qui fonctionnait, correctifs apportés dans la semaine.
            </p>
            <p>
              Notre équipe créative a pensé chaque contenu plateforme par plateforme. Ce qui passait sur WeChat n'avait rien de commun avec ce qui passait sur RedNote. Format distinct, ton distinct, audience distincte.
            </p>
          </div>
        </div>

        <!-- Content strategy -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Un contenu qui mérite l'attention</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons installé JAC comme une source de connaissance automobile véritable. Analyses techniques, coulisses de la fabrication, portraits de propriétaires au volant de leur JAC au quotidien. Le type de contenu qui arrête le défilement.
            </p>
            <p>
              Quelques mois ont suffi pour voir la bascule. Les commentaires se sont allongés. Les utilisateurs ont commencé à identifier leurs proches. Les partages ont progressé. Les comptes sont passés d'une vitrine institutionnelle à un espace où l'audience revient d'elle-même.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Campaign visuals — full width -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <img
        src="/images/clients/JAC/JAC-Wechat-4.jpg"
        alt="Campagne JAC Motors E30X avec Nuria Diosdado, athlète olympique"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-5.jpg"
        alt="Événement de lancement JAC Motors sur le marché irakien"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Campagne internationale : collaboration athlète E30X et lancement sur le marché irakien.
      </p>
    </Container>
  </section>

  <!-- Campagne J-Bot -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="La campagne olympique J-Bot">Une mascotte propulsée par l'IA qui a fait le tour du monde sans campagne mondiale.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              La campagne J-Bot marque le moment où le travail communautaire a vraiment porté ses fruits. L'IA a permis de décliner la mascotte JAC en six versions olympiques thématiques. Les visuels J-Bot ont été publiés sur WeChat, RedNote et Weibo. La réaction fut immédiate : engagement élevé, partages en cascade, portée organique bien au-delà des abonnés JAC.
            </p>
            <p>
              La suite ne figurait pas au plan. Les équipes internationales de JAC ont vu le contenu J-Bot et se sont mises à le republier sur Facebook et Instagram, de leur propre initiative. Personne ne l'avait demandé. Elles ont simplement constaté la performance et repris la création.
            </p>
            <p>
              Un contenu pensé pour les réseaux sociaux chinois a fini par rayonner dans le monde entier, sans qu'aucune campagne distincte n'ait été planifiée. Une trajectoire qui n'arrive jamais avec du contenu ordinaire.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- J-Bot visuals — full width -->
  <section class="mb-[16px]">
    <img
      src="/images/clients/JAC/Wechat-JAC-Automobile-1.png"
      alt="Mascotte J-Bot de JAC en six versions thématiques olympiques créées par IA"
      class="w-full"
      loading="lazy"
      decoding="async"
    />
  </section>

  <!-- J-Bot Facebook post + WeChat -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:overflow-x-auto max-[640px]:justify-start scrollbar-hide">
      <img
        src="/images/clients/JAC/Wechat-JAC-Automobile-2.png"
        alt="Publication Facebook de JAC Motors Global présentant la campagne olympique J-Bot avec fort engagement"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-3.jpg"
        alt="Article WeChat de JAC Motors sur la campagne Rouge chinois des Jeux de Paris"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        La campagne J-Bot est passée des réseaux sociaux chinois à la page Facebook mondiale de JAC, sans brief séparé.
      </p>
    </Container>
  </section>

  <!-- Resultats + Ground team -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Ground team -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            La campagne a consolidé l'image de JAC comme marque innovante et jeté un pont entre son audience chinoise et son audience mondiale. La preuve qu'un bon contenu communautaire n'a pas besoin de passeport.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="À votre tour">Vous voulez transformer vos réseaux sociaux en véritable communauté ?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Périmètre arrêté. Tarif ferme. Équipe sur place.
        </p>
        <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
