---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campagne', 'Production de contenu', 'Social', 'Contenu propulsé par l\'IA'];
const platforms = ['WeChat', 'RedNote', 'Weibo'];
---

<PageLayout
  title="JAC Motors : étude de cas social media en Chine | TheRedScroll"
  description="Comment JAC Motors a bâti une vraie communauté sociale sur WeChat, RedNote et Weibo. Contenu signé IA, campagne olympique et rayonnement international."
  ogImage="/images/clients/JAC/JAC-Wechat-4.jpg"
  lang="fr"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/JAC/JAC-Wechat-4.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Étude de cas
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        JAC Motors : bâtir une communauté sociale pour un géant chinois de l'automobile.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        JAC Motors voulait bien plus que publier. Nous avons bâti une communauté sur WeChat, RedNote et Weibo, avec un contenu signé IA qui a fini par dépasser les frontières chinoises.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#case-study">Lire l'étude de cas</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Le client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">JAC Motors</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Secteur</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Automobile / VE</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Plateformes</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Le client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Le client">10 millions de véhicules vendus. Une présence sociale qui ne suivait pas.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              JAC est l'un des plus grands constructeurs automobiles chinois. Plus de 30 ans d'activité, plus de 10 millions de véhicules vendus dans le monde. Voitures particulières, véhicules électriques, utilitaires. Une entreprise de grande envergure, une empreinte sérieuse.
            </p>
            <p>
              Sauf que leur présence sociale ne disait rien de tout cela. Le contenu sortait régulièrement sur WeChat, RedNote et Weibo. Le problème : personne n'y réagissait vraiment. Peu de commentaires, peu de partages, aucun sentiment de communauté.
            </p>
            <p>
              Pour une entreprise de cette taille, l'écart entre le rang de marché et la présence sociale devenait trop voyant.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- WeChat content — horizontal scroll -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/JAC/JAC-Wechat.jpg"
        alt="Article WeChat de JAC Motors sur le lancement du E30X aux Émirats arabes unis"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-1.jpg"
        alt="Article WeChat de JAC Motors sur la couverture médiatique et le forum RCEP"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-2.jpg"
        alt="Article WeChat de JAC Motors sur la campagne olympique J-Bot créée par IA"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-3.jpg"
        alt="Article WeChat de JAC Motors sur la campagne Rouge chinois des Jeux de Paris"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Contenu WeChat : lancements produits, campagne olympique et récits d'expansion à l'international. Faites défiler.
      </p>
    </Container>
  </section>

  <!-- Notre intervention -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Notre intervention">Repartir de zéro. Bâtir une communauté qui sonne vrai.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons repris le contenu sur les trois plateformes. JAC ne voulait pas simplement publier plus. La marque voulait devenir une référence pour les passionnés d'automobile. Et voir naître autour d'elle une communauté authentique, bâtie sur la confiance et une identité partagée.
            </p>
            <p>
              Nous avons donc tout rebâti autour de trois axes : le savoir automobile, les histoires humaines venues de l'intérieur et de l'entourage de JAC, et un vrai dialogue avec l'audience plutôt qu'un monologue de marque.
            </p>
          </div>
        </div>

        <!-- IA -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">L'IA au cœur de la production</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons utilisé HubStudio.ai pour créer du contenu visuel sur mesure à un rythme qu'aucune production classique ne tient. L'IA a aussi pris en charge le suivi de performance sur les trois plateformes. De quoi voir ce qui marchait et corriger dans la semaine.
            </p>
            <p>
              Notre équipe créative a pensé chaque contenu plateforme par plateforme. Ce qui passait sur WeChat n'avait rien à voir avec ce qui passait sur RedNote. Format différent, ton différent, audience différente.
            </p>
          </div>
        </div>

        <!-- Content strategy -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Un contenu qui mérite l'attention</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons installé JAC comme une source de vrai savoir automobile. Analyses techniques, coulisses de la fabrication, portraits de propriétaires au volant de leur JAC au quotidien. Le genre de contenu qui arrête le scroll.
            </p>
            <p>
              Il a fallu quelques mois. Puis le basculement est devenu net. Les commentaires se sont allongés. Les gens se sont mis à identifier leurs amis. Les partages ont grimpé. Les comptes sont passés d'une vitrine corporate à un espace où l'on revenait de soi-même.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Campaign visuals — full width -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <img
        src="/images/clients/JAC/JAC-Wechat-4.jpg"
        alt="Campagne JAC Motors E30X avec Nuria Diosdado, athlète olympique"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-5.jpg"
        alt="Événement de lancement JAC Motors sur le marché irakien"
        class="w-full rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Campagne internationale : collaboration athlète E30X et lancement sur le marché irakien.
      </p>
    </Container>
  </section>

  <!-- Campagne J-Bot -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="La campagne olympique J-Bot">Une mascotte signée IA qui a fait le tour du monde sans campagne mondiale.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              La campagne J-Bot, c'est le moment où le travail communautaire a vraiment payé. Nous avons utilisé l'IA pour redessiner la mascotte de JAC en six versions thématiques olympiques. Les visuels J-Bot ont été publiés sur WeChat, RedNote et Weibo. La réaction a été immédiate. Fort engagement, partages en cascade, portée organique bien au-delà des abonnés JAC.
            </p>
            <p>
              La suite n'était pas prévue. Les équipes internationales de JAC ont vu le contenu J-Bot et se sont mises à le republier sur Facebook et Instagram, de leur propre chef. Personne ne le leur avait demandé. Elles ont simplement vu que ça marchait, et elles l'ont repris.
            </p>
            <p>
              Un contenu pensé pour les réseaux sociaux chinois a fini par rayonner dans le monde entier, sans qu'aucune campagne séparée n'ait été planifiée. Ce genre de chose n'arrive pas avec du contenu ordinaire.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- J-Bot visuals — full width -->
  <section class="mb-[16px]">
    <img
      src="/images/clients/JAC/Wechat-JAC-Automobile-1.png"
      alt="Mascotte J-Bot de JAC en six versions thématiques olympiques créées par IA"
      class="w-full"
      loading="lazy"
      decoding="async"
    />
  </section>

  <!-- J-Bot Facebook post + WeChat -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:overflow-x-auto max-[640px]:justify-start scrollbar-hide">
      <img
        src="/images/clients/JAC/Wechat-JAC-Automobile-2.png"
        alt="Publication Facebook de JAC Motors Global présentant la campagne olympique J-Bot avec fort engagement"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/JAC/JAC-Wechat-3.jpg"
        alt="Article WeChat de JAC Motors sur la campagne Rouge chinois des Jeux de Paris"
        class="h-[480px] max-[640px]:h-[400px] w-auto shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        La campagne J-Bot est passée des réseaux sociaux chinois à la page Facebook mondiale de JAC, sans brief séparé.
      </p>
    </Container>
  </section>

  <!-- Resultats + Ground team -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Ground team -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            La campagne a renforcé l'image de JAC comme marque innovante et jeté un pont entre son audience chinoise et son audience mondiale. Preuve qu'un bon contenu communautaire n'a pas besoin de passeport.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[640px]:p-[32px] text-center">
        <SectionHeading overline="À votre tour">Vous voulez transformer vos réseaux sociaux en véritable communauté ?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Périmètre fixe. Prix fixe. Équipe sur place.
        </p>
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
