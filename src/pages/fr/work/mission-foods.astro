---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campagne', 'eCommerce', 'Influenceur / KOL', 'Livestream', 'Médias', 'Social'];
const platforms = ['WeChat', 'RedNote', 'Weibo'];
---

<PageLayout
  title="Mission Foods : étude de cas social media en Chine | TheRedScroll"
  description="Comment Mission Foods a lancé les chips de maïs en Chine via WeChat, RedNote et Weibo. Campagnes sociales Gen Z, contenu d'accords culinaires et croissance communautaire."
  ogImage="/images/clients/MissionFoods/head-pic.jpg"
  lang="fr"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/MissionFoods/head-pic.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Étude de cas
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Mission Foods : lancer les chips de maïs en Chine grâce au social.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Mission Foods devait faire découvrir les chips de maïs à des consommateurs chinois qui n'y avaient jamais goûté. Nous avons bâti une stratégie sociale qui a installé une catégorie de snack totalement inédite.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#case-study">Lire l'étude de cas</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Le client</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Mission Foods</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Secteur</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Agroalimentaire / Grande consommation</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Services</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Plateformes</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study content -->
  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <!-- Le client -->
        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Le client">Une marque mondiale qui lance une catégorie de snack inconnue en Chine.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Mission Foods est une marque mondiale de cuisine mexicaine et l'un des plus grands producteurs de tortillas au monde. En Chine, elle lançait les chips de maïs. Solide à l'international, mais une catégorie qui n'existe tout simplement pas dans les habitudes chinoises.
            </p>
            <p>
              La plupart des consommateurs n'en avaient jamais goûté. Beaucoup n'en avaient jamais entendu parler. Et la cible, c'était la génération Z.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Social screenshots -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img
        src="/images/clients/MissionFoods/1-1.jpg"
        alt="Contenu social Mission Foods montrant des accords culinaires avec chips de maïs sur les plateformes chinoises"
        class="w-[340px] max-[640px]:w-[280px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/clients/MissionFoods/1-2.jpg"
        alt="Contenu de campagne snacking Gen Z de Mission Foods sur RedNote et WeChat"
        class="w-[340px] max-[640px]:w-[280px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Contenu social Mission Foods sur WeChat, Weibo et RedNote. Campagnes d'accords culinaires et moments snacking Gen Z.
      </p>
    </Container>
  </section>

  <!-- Notre intervention -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Notre intervention">Rendre les chips de maïs familières, pas exotiques.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons mené des campagnes sociales et un contenu éditorial régulier sur WeChat, Weibo et RedNote. Une idée portait toute la stratégie : les chips de maïs ne perceraient en Chine que le jour où elles cesseraient de paraître étrangères.
            </p>
          </div>
        </div>

        <!-- Food pairing -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Des accords culinaires qui répondaient à la vraie question</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nous avons associé les chips de maïs à des plats chinois. Trempettes, compagnon de fondue chinoise, recettes où le croquant des chips rencontre des saveurs familières. De quoi répondre à la question que chaque consommateur se posait : concrètement, ça se mange comment ?
            </p>
            <p>
              Les accords paraissaient naturels et respectaient la culture culinaire locale. C'est ce qui les a rendus efficaces.
            </p>
          </div>
        </div>

        <!-- Gen Z -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Pensé autour des moments snacking de la génération Z</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Soirées entre amis, petites faims du soir, partages à plusieurs. Ludique, rapide, visuel. Le genre de contenu que l'on enregistre et que l'on renvoie dans les conversations de groupe. Pas centré sur la marque. Centré sur le snack.
            </p>
          </div>
        </div>

        <!-- KOLs -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Les KOL RedNote ont montré le produit dans la vraie vie</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              De vraies cuisines, de vrais moments de grignotage, des réactions spontanées. Le contenu KOC a apporté un volume organique et a contribué à installer les chips de maïs comme un produit que l'on achète vraiment.
            </p>
          </div>
        </div>

        <!-- Halloween -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Halloween a été le temps fort</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Un contenu thématique qui installait les chips de maïs comme le snack de soirée par excellence. Visuels de costumes, plateaux d'apéritifs, scènes de fête. Le moment était parfait. Halloween monte vite chez la génération Z chinoise, et les chips s'y sont intégrées sans effort.
            </p>
            <p>
              La campagne a déclenché un pic net de nouveaux abonnés et d'engagement sur les trois plateformes.
            </p>
          </div>
        </div>

        <!-- WeChat -->
        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">WeChat a assuré la continuité entre les campagnes</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Recettes, nouveautés produit, promotions saisonnières. Un rythme régulier qui maintient l'attention de l'audience, même quand aucune grande campagne n'est à l'antenne.
            </p>
          </div>
        </div>

        <!-- Ground team callout -->
        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            L'ensemble a été produit en Chine par notre équipe. Des locuteurs natifs, un contenu pensé pour la culture locale, et un point hebdomadaire sur les performances.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- Les resultats -->
  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Les résultats">Les temps forts ont compté. Ce qui s'est joué entre eux a compté davantage.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              La campagne Halloween a livré les meilleurs chiffres : croissance d'abonnés et engagement au-dessus des références précédentes.
            </p>
            <p>
              Mais l'essentiel s'est joué entre les temps forts. Le contenu régulier a fait grandir l'audience semaine après semaine. Recettes, offres, idées snacking. Les gens continuaient à s'abonner, continuaient à réagir.
            </p>
            <p>
              Mission Foods est passé du lancement d'un produit inconnu à la construction d'une vraie communauté autour de lui. C'est ce que le social produit quand le contenu épouse vraiment le marché.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[640px]:p-[32px] text-center">
        <SectionHeading overline="À votre tour">Vous souhaitez lancer un produit sur les plateformes sociales chinoises ?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Périmètre fixe. Prix fixe. Équipe sur place.
        </p>
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
