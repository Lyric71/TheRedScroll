---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="À propos | TheRedScroll"
  description="TheRedScroll, agence de réseaux sociaux basée en Chine. Périmètre défini, prix fixe, équipe à Shanghai et Hong Kong, au contact des plateformes chaque jour."
  lang="fr"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[500px] overflow-hidden">
    <!-- Background image with overlay -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/team/team-photo.webp')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.82]" aria-hidden="true"></div>

    <!-- Content -->
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        À propos
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Les femmes et les hommes qui portent votre marque en Chine.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Vingt-cinq ans de terrain. Une équipe aguerrie. Aucune sous-traitance.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#leadership">Découvrir l’équipe</Button>
      </div>
    </div>
  </section>

  <!-- Why we exist -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <!-- Left -->
        <div>
          <SectionBar />
          <SectionHeading overline="Pourquoi nous existons">La plupart des agences vendent de la stratégie. Puis confient l’exécution à des équipes qui n’ont jamais ouvert Douyin.</SectionHeading>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Une belle présentation, quelques formules bien senties. Derrière, une équipe junior qui ignore les codes de RedNote et recycle le même contenu d’une plateforme à l’autre. Six mois plus tard, plus personne ne sait où est passé le budget.
          </p>
        </div>
        <!-- Right -->
        <div class="flex flex-col items-end pt-[48px] max-[640px]:pt-[0px]">
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] mb-[32px] w-full">
            <p>
              Nous avons fondé TheRedScroll pour en finir avec ça. Ici, ceux qui pensent la stratégie la publient eux-mêmes. Le prix est fixe, les résultats se mesurent.
            </p>
            <p>
              Du concret, visible sur les plateformes, jour après jour, et piloté depuis la Chine.
            </p>
          </div>
          <div class="flex items-center gap-[16px]">
            <img
              src="/images/team/Cyril-Drouin-Signature-Transparent.webp"
              alt="Signature de Cyril Drouin"
              width="100"
              height="60"
              class="shrink-0"
              style="width: 100px; height: auto; filter: brightness(0) saturate(100%) invert(23%) sepia(95%) saturate(2068%) hue-rotate(346deg) brightness(89%) contrast(89%);"
              loading="lazy"
              decoding="async"
            />
            <div>
              <p class="text-[14px] font-medium text-[var(--color-ink)] leading-[1.4]">Cyril Drouin</p>
              <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Fondateur et PDG, TheRedScroll</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our mission -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="Écrans de téléphone montrant la croissance sur les réseaux sociaux chinois">
          <svg viewBox="0 0 480 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Phone 1: Douyin (left) -->
            <g transform="translate(20, 40)">
              <rect x="0" y="0" width="130" height="240" rx="16" fill="#1A1A1A" />
              <rect x="4" y="4" width="122" height="232" rx="14" fill="#FFFFFF" />
              <!-- Status bar -->
              <rect x="4" y="4" width="122" height="28" rx="14" fill="#1A1A1A" />
              <circle cx="65" cy="18" r="4" fill="#333" />
              <!-- App header -->
              <text x="65" y="50" text-anchor="middle" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif">Douyin</text>
              <!-- Content placeholder -->
              <rect x="14" y="60" width="102" height="70" rx="6" fill="#F7F2EE" />
              <!-- Metrics -->
              <text x="14" y="150" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Abonnés</text>
              <text x="14" y="163" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">127,4K</text>
              <!-- Growth chart -->
              <polyline points="14,210 34,200 54,195 74,185 94,175 116,160" stroke="#CC3333" stroke-width="2" fill="none" stroke-linecap="round" />
              <circle cx="116" cy="160" r="3" fill="#CC3333" />
              <!-- Growth arrow -->
              <text x="80" y="224" fill="#CC3333" font-size="8" font-weight="500" font-family="Inter, sans-serif">+34 %</text>
            </g>

            <!-- Phone 2: WeChat (center, taller) -->
            <g transform="translate(175, 10)">
              <rect x="0" y="0" width="130" height="260" rx="16" fill="#1A1A1A" />
              <rect x="4" y="4" width="122" height="252" rx="14" fill="#FFFFFF" />
              <!-- Status bar -->
              <rect x="4" y="4" width="122" height="28" rx="14" fill="#07C160" />
              <text x="65" y="22" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">WeChat</text>
              <!-- Content placeholder -->
              <rect x="14" y="42" width="102" height="50" rx="6" fill="#F7F2EE" />
              <rect x="14" y="100" width="102" height="50" rx="6" fill="#F7F2EE" />
              <!-- Metrics -->
              <text x="14" y="172" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Lectures d’articles</text>
              <text x="14" y="185" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">89,2K</text>
              <text x="14" y="205" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Engagement</text>
              <text x="14" y="218" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">12,8 %</text>
              <!-- Growth chart -->
              <polyline points="14,248 34,244 54,238 74,230 94,220 116,208" stroke="#07C160" stroke-width="2" fill="none" stroke-linecap="round" />
              <circle cx="116" cy="208" r="3" fill="#07C160" />
            </g>

            <!-- Phone 3: RedNote (right) -->
            <g transform="translate(330, 50)">
              <rect x="0" y="0" width="130" height="240" rx="16" fill="#1A1A1A" />
              <rect x="4" y="4" width="122" height="232" rx="14" fill="#FFFFFF" />
              <!-- Status bar -->
              <rect x="4" y="4" width="122" height="28" rx="14" fill="#FF2442" />
              <text x="65" y="22" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">RedNote</text>
              <!-- Content grid -->
              <rect x="14" y="40" width="48" height="48" rx="4" fill="#F7F2EE" />
              <rect x="68" y="40" width="48" height="48" rx="4" fill="#F7F2EE" />
              <rect x="14" y="94" width="48" height="48" rx="4" fill="#F7F2EE" />
              <rect x="68" y="94" width="48" height="48" rx="4" fill="#F7F2EE" />
              <!-- Metrics -->
              <text x="14" y="162" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Abonnés</text>
              <text x="14" y="175" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">56,1K</text>
              <!-- Growth chart -->
              <polyline points="14,220 34,215 54,208 74,198 94,188 116,172" stroke="#FF2442" stroke-width="2" fill="none" stroke-linecap="round" />
              <circle cx="116" cy="172" r="3" fill="#FF2442" />
              <text x="80" y="230" fill="#FF2442" font-size="8" font-weight="500" font-family="Inter, sans-serif">+52 %</text>
            </g>

            <!-- Floating metric badges -->
            <g class="mission-badge mission-badge-1">
              <rect x="145" y="290" width="90" height="28" rx="6" fill="#1A1A1A" />
              <text x="190" y="308" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">+2,4K aujourd’hui</text>
            </g>
            <g class="mission-badge mission-badge-2">
              <rect x="260" y="300" width="100" height="28" rx="6" fill="#CC3333" />
              <text x="310" y="318" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">Conversions +41 %</text>
            </g>
            <g class="mission-badge mission-badge-3">
              <rect x="50" y="310" width="84" height="28" rx="6" fill="#07C160" />
              <text x="92" y="328" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">89,2K lectures</text>
            </g>
          </svg>
        </div>
        <div>
          <SectionBar />
          <SectionHeading overline="Notre mission">Développer les marques sur les réseaux sociaux chinois.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Non pour garnir une présentation de plus, mais pour livrer du concret : des abonnés, de l’engagement, des conversions.
            </p>
            <p>
              Les plateformes chinoises sont saturées et coûteuses. Les marques locales en connaissent les codes par cœur. Depuis l’étranger, tout l’enjeu est de combler cet écart. Nous y parvenons avec un périmètre défini, un prix fixe et une équipe qui vit sur ces plateformes.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our vision -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Notre vision">Un bon responsable réseaux sociaux, bien épaulé par l’IA, vaut mieux que l’ancien modèle d’agence.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Le modèle classique empile les postes : planneurs, rédacteurs, graphistes, chefs de projet. Chacun facture ses heures. La moitié n’a jamais rien posté sur Douyin.
            </p>
            <p>
              Nous nous appuyons sur HubStudio.ai pour produire les contenus, les visuels et les premiers jets. Ce qui prenait une semaine se boucle en un jour. La stratégie et la lecture culturelle, elles, restent tout entières entre les mains de notre équipe. Aucun outil ne déplacera cette frontière.
            </p>
          </div>
          <!-- Callout -->
          <div class="bg-[#F0F1F4] border-l-[3px] border-[#CC3333] rounded-none p-[20px] mt-[24px]">
            <p class="text-[16px] font-normal text-[#1A1A1A] leading-[1.6] m-0">
              En 2025, le marché chinois de l’AIGC a dépassé 25,7 milliards d’euros, en progression de 60 % par an. Plus d’un annonceur chinois sur deux recourt déjà à l’IA pour sa création. Source : données sectorielles, 2025.
            </p>
          </div>
        </div>
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="Comparaison de rapidité : ancien modèle d’agence contre TheRedScroll avec IA">
          <svg viewBox="0 0 440 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Title -->
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">DÉLAI DE LIVRAISON</text>

            <!-- Old agency model -->
            <text x="20" y="62" fill="#5C5C5C" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">ANCIEN MODÈLE D’AGENCE</text>

            <!-- Timeline bar: 5 weeks -->
            <rect x="20" y="74" width="400" height="36" rx="6" fill="#E8E0D8" />

            <!-- Week segments -->
            <line x1="100" y1="74" x2="100" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />
            <line x1="180" y1="74" x2="180" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />
            <line x1="260" y1="74" x2="260" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />
            <line x1="340" y1="74" x2="340" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />

            <!-- Week labels inside bar -->
            <text x="60" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 1</text>
            <text x="140" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 2</text>
            <text x="220" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 3</text>
            <text x="300" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 4</text>
            <text x="380" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 5</text>

            <!-- Role stack below old model -->
            <g transform="translate(20, 122)">
              <rect x="0" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="38" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Planificateur</text>

              <rect x="82" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="120" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Rédacteur</text>

              <rect x="164" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="202" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Designer</text>

              <rect x="246" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="284" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Chef de projet</text>

              <rect x="328" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="366" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Chargé de cpte</text>
            </g>

            <!-- Divider -->
            <line x1="20" y1="168" x2="420" y2="168" stroke="#E8E0D8" stroke-width="0.5" />

            <!-- TheRedScroll model -->
            <text x="20" y="198" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">THEREDSCROLL + IA</text>

            <!-- Timeline bar: 1 day highlighted -->
            <rect x="20" y="210" width="80" height="36" rx="6" fill="#CC3333" class="vision-bar" />
            <!-- Rest of bar (empty/saved time) -->
            <rect x="100" y="210" width="320" height="36" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" stroke-dasharray="4 4" />

            <!-- Day label -->
            <text x="60" y="232" text-anchor="middle" fill="#FFFFFF" font-size="9" font-weight="500" font-family="Inter, sans-serif">1 jour</text>

            <!-- Saved time label -->
            <text x="260" y="232" text-anchor="middle" fill="#E8E0D8" font-size="9" font-family="Inter, sans-serif">Temps gagné</text>

            <!-- Role stack below TheRedScroll model -->
            <g transform="translate(20, 258)">
              <rect x="0" y="0" width="110" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
              <text x="55" y="14" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">Stratège terrain</text>

              <rect x="118" y="0" width="80" height="22" rx="4" fill="#1A1A1A" opacity="0.05" stroke="#1A1A1A" stroke-width="0.5" />
              <text x="158" y="14" text-anchor="middle" fill="#1A1A1A" font-size="7" font-weight="500" font-family="Inter, sans-serif">HubStudio.ai</text>
            </g>

            <!-- Bottom stats -->
            <line x1="20" y1="304" x2="420" y2="304" stroke="#E8E0D8" stroke-width="0.5" />

            <g transform="translate(20, 320)">
              <text x="0" y="12" fill="#1A1A1A" font-size="20" font-weight="500" font-family="Inter, sans-serif">5x</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">plus rapide</text>
            </g>
            <g transform="translate(140, 320)">
              <text x="0" y="12" fill="#1A1A1A" font-size="20" font-weight="500" font-family="Inter, sans-serif">80 %</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">de postes facturables en moins</text>
            </g>
            <g transform="translate(290, 320)">
              <text x="0" y="12" fill="#CC3333" font-size="20" font-weight="500" font-family="Inter, sans-serif">100 %</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">stratégie portée par l’humain</text>
            </g>
          </svg>
        </div>
      </div>
    </Container>
  </section>

  <!-- Leadership -->
  <section id="leadership" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Direction">Les visages derrière TheRedScroll.</SectionHeading>
      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="leader-card bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/team/Cyil-Drouin.jpg" alt="Cyril Drouin" class="w-full aspect-[3/4] object-cover object-top" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">Cyril Drouin</h3>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5] mb-[12px]">Fondateur et PDG</p>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5]">
              Vingt-cinq ans dans le numérique, la publicité et le commerce. Ancien PDG de Publicis Commerce and Performance Marketing pour la Chine et l’Asie du Nord.
            </p>
          </div>
        </div>
        <div class="leader-card bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/team/Echo-peng.jpg" alt="Echo Peng" class="w-full aspect-[3/4] object-cover object-top" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">Echo Peng</h3>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5] mb-[12px]">Directrice senior</p>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5]">
              Dix-huit ans dans le commerce en ligne et le numérique en Chine. Ancienne directrice des opérations de Publicis China.
            </p>
          </div>
        </div>
        <div class="leader-card bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/team/Liyan-Ye.jpg" alt="Liyan Ye" class="w-full aspect-[3/4] object-cover object-top" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">Liyan Ye</h3>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5] mb-[12px]">Directrice senior</p>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5]">
              Vingt ans d’expérience en marketing auprès d’entreprises du Fortune 500 en Chine.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our team -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Notre équipe">D’anciens cadres de grandes agences devenus stratèges de plateformes, et qui publient eux-mêmes, chaque jour.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Des stratèges qui publient chaque jour sur WeChat, Douyin, RedNote et Weibo. Des producteurs de contenu qui ont tenu les calendriers éditoriaux de dizaines de marques en Chine. La plupart exercent ce métier depuis plus de dix ans.
            </p>
            <p>
              La personne qui trace votre feuille de route éditoriale est aussi celle qui veille à ce que le contenu sorte et porte. Aucun écart entre la stratégie sur le papier et ce qui paraît en ligne.
            </p>
            <p>
              Nous avons lancé des marques de beauté sur RedNote, animé des communautés agroalimentaires sur WeChat, construit des audiences automobiles sur Douyin.
