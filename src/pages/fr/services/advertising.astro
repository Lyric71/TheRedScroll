---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import FaqAccordion from '../../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'Quel budget faut-il pour démarrer ?', a: 'Cela dépend de la plateforme. RedNote à partir de ¥5,000. Douyin in-feed à partir de ¥1,000/jour. WeChat Moments ¥1,000/jour minimum. Nous recommandons ¥15,000 à ¥30,000/mois pour collecter suffisamment de données et optimiser réellement.' },
  { q: 'Gérez-vous les dépenses publicitaires directement ?', a: 'Oui. Les dépenses vont directement à la plateforme. Nous ne prenons aucune marge dessus. Nos honoraires couvrent la stratégie, la mise en place, la création et le reporting.' },
  { q: 'En combien de temps peut-on voir des résultats ?', a: 'Campagnes de trafic : dès la première semaine. Conversions : deux à trois semaines d\'optimisation. Notoriété de marque : 30 à 60 jours.' },
  { q: 'Et si nos publicités actuelles ne performent pas ?', a: 'Nous commençons par un audit. Campagnes, ciblage, créations, répartition du budget. Puis nous reconstruisons ce qui ne fonctionne pas. Problèmes courants : mauvais format, créations usées, ciblage trop large, personne pour optimiser au quotidien.' },
  { q: 'Produisez-vous les créations publicitaires ?', a: 'Oui. Vidéo, image, texte pour chaque plateforme. La direction créative est assurée par des humains. La production est accélérée par l\'IA via HubStudio.ai.' },
  { q: 'Sponsoriser une publication vs. lancer une campagne ?', a: 'Sponsoriser est simple mais limité. Une campagne offre un ciblage précis, des tests créatifs, des objectifs de conversion, une optimisation des enchères et un suivi du ROAS. L\'écart de résultats est en général significatif.' },
  { q: 'Le ROAS est-il toujours la bonne métrique ?', a: 'Pour le e-commerce et la réponse directe, quasiment toujours. Pour la notoriété, nous basculons sur le CPM et la couverture. L\'essentiel, c\'est de définir ce qu\'est le succès avant le lancement, pas après.' },
  { q: 'Peut-on faire de la publicité sur plusieurs plateformes ?', a: 'Oui, et dans la plupart des cas, c\'est recommandé. Douyin + RedNote couvrent la notoriété et la découverte. WeChat retarget les personnes qui ont interagi ailleurs. Nous déterminons le mix en fonction de vos objectifs et de votre budget.' },
  { q: 'Et la vérification des comptes ?', a: 'La plupart des plateformes n\'autorisent pas l\'accès au gestionnaire de publicités sans vérification. Nous gérons le processus. Comptez une à trois semaines.' },
  { q: 'Comment fonctionne votre tarification ?', a: 'Honoraires fixes pour le travail créatif. Les dépenses publicitaires sont séparées et versées directement aux plateformes. Aucune confusion.' },
];

const gettingStartedSteps = [
  {
    title: 'Appel découverte.',
    description: 'Votre marque, vos objectifs et votre budget envisagé. Nous déterminerons la bonne approche.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Plan média.',
    description: 'Recommandations de plateformes, répartition budgétaire et KPI prévisionnels. Périmètre clair. Honoraires de gestion fixes.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'Publicités en ligne sous 2 semaines.',
    description: 'Configuration des comptes, production créative et lancement des campagnes. Optimisation quotidienne dès le premier jour.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="Publicité sur les réseaux sociaux chinois | TheRedScroll"
  description="Planification, achat et optimisation publicitaire sur WeChat, Douyin et RedNote. Honoraires de gestion fixes. Dépenses publicitaires transparentes. Équipe à Shanghai."
  lang="fr"
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/advertising-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Planification et achat publicitaire
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Toucher les bonnes personnes. Pas simplement plus de personnes.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Nous planifions, achetons et optimisons des campagnes publicitaires sur WeChat, Douyin, RedNote et Weibo. Honoraires de gestion fixes. Dépenses publicitaires transparentes.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#what-we-do">Ce que nous faisons</Button>
      </div>
    </div>
  </section>

  <!-- Why advertising is (almost) mandatory -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">L'argument du paid</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Pourquoi la publicité est quasi indispensable</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">La portée organique construit une audience avec le temps. Mais elle ne peut pas cibler les femmes de 25 à 34 ans à Shanghai qui ont cherché "soin naturel" la semaine dernière. La publicité, si.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">Ce que nous faisons</Button>
          </div>
        </div>
        <div class="relative overflow-hidden bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">C'est plus rapide</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">L'organique prend des mois. Une campagne bien ciblée peut générer des conversions en quelques jours.</p>
        </div>
        <div class="relative overflow-hidden bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">C'est précis</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">Ciblage par âge, genre, catégorie de ville, centres d'intérêt, appareil, comportement d'achat et historique d'interaction. Les publicités vont là où vous le décidez.</p>
        </div>
        <div class="relative overflow-hidden bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">C'est scalable</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">Testez avec ¥5,000 le lundi et montez à ¥50,000 le vendredi si les chiffres sont bons. Essayez de faire pareil avec du contenu organique.</p>
        </div>
        <div class="relative overflow-hidden bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Mais ce n'est pas gratuit</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Une campagne mal préparée brûle du budget plus vite que pas de campagne du tout. La planification média, l'optimisation quotidienne et des KPI clairs comptent autant que les publicités elles-mêmes.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Ce que nous faisons">Planification média</SectionHeading>

      <!-- Hero image -->
      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img
          src="/images/what-we-do/advertising.png"
          alt="L'équipe TheRedScroll analysant les performances publicitaires"
          class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Overlapping cards -->
      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Planification média</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Avant de dépenser un seul yuan, nous construisons le plan. Quelles plateformes, quels formats, quels segments d'audience, quel budget par canal, et à quoi ressemble le coût par résultat attendu.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Configuration et optimisation des campagnes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Cycle complet. Configuration des comptes, upload créatif, ciblage d'audience, stratégie d'enchères, A/B testing. Optimisation quotidienne. Une création qui marchait lundi peut s'essouffler dès jeudi.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Couverture des plateformes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Nous gérons des campagnes sur Ocean Engine (Douyin), Tencent Ads (WeChat), Juguang (RedNote) et Weibo Fan Tong. Nous savons où sont enfouis les paramètres qui font la différence.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Ad creative + Retargeting + Compliance + Reporting — dark section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Service complet</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">De la création à la conformité au reporting</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            Une publicité qui ressemble à une publicité est ignorée. Une publicité qui ressemble à du contenu est regardée. Nous produisons des créations adaptées au format de chaque plateforme et les renouvelons avant que la performance ne chute. L'IA absorbe le volume de production. Notre équipe gère la direction créative.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Retargeting et audiences personnalisées</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Quelqu'un a regardé 50 % de votre vidéo Douyin sans cliquer ? Retargetez-le avec un angle différent. Un utilisateur a visité votre Mini Program sans acheter ? Montrez-lui un suivi. Sur RedNote, vous pouvez construire des audiences à partir d'utilisateurs ayant interagi avec des notes spécifiques ou recherché des mots-clés précis. C'est souvent là que le meilleur ROAS se trouve.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Conformité et validation publicitaire</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Chaque plateforme a son propre processus de validation publicitaire. Certains secteurs font face à des restrictions ou à des interdictions totales. Nous gérons les vérifications de conformité en amont, le processus de validation et signalons les restrictions sectorielles avant tout engagement budgétaire.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Reporting de performance</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Le ROAS (Return on Ad Spend) est le chiffre autour duquel tout s'organise. Nous suivons aussi le CPC, le CPM, le CTR, le CPA, le taux de conversion et la fréquence. Rapports hebdomadaires pendant les campagnes actives. Bilans mensuels. Pour les budgets plus importants, accès à un tableau de bord en temps réel.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Dépenses transparentes</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Les dépenses publicitaires sont facturées séparément. Pas de marge. Pas de frais d'agence cachés sur le média. Vous voyez exactement où va chaque yuan.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Ad formats & indicative pricing — WeChat -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Formats publicitaires et tarifs">WeChat (via Tencent Ads)</SectionHeading>
      <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[24px] max-w-[680px]">
        Les tarifs ci-dessous sont basés sur les données du T1 2026 et nos propres benchmarks. Ils sont là pour vous aider à planifier. Ce ne sont pas des devis.
      </p>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-moments-ad.svg" alt="Exemple de publicité WeChat Moments" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Publicités Moments</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Publicités natives dans le fil social des utilisateurs. Carrousel (jusqu'à six cartes), vidéo autoplay (6-15 sec) ou canvas (plein écran au tap). 122 sous-catégories d'intérêt. Enchères à partir de ¥1,000/jour. CPM de ¥50 à ¥180 selon la catégorie de ville.</p>
          </div>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-banner-ad.svg" alt="Bannière publicitaire dans un article de Compte Officiel WeChat" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Bannières publicitaires</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">En bas ou au milieu des articles de Compte Officiel. CPC à partir de ¥0.5. CPM de ¥15 à ¥25. Coût par nouvel abonné : ¥8 à ¥20. Le format le plus abordable.</p>
          </div>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-channels-ad.svg" alt="Publicité vidéo WeChat Channels" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
