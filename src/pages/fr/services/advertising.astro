---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import FaqAccordion from '../../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'Quel budget prévoir pour commencer ?', a: 'Tout dépend de la plateforme. RedNote démarre à ¥5 000. Douyin, comptez ¥1 000/jour minimum pour les annonces dans le fil. WeChat Moments, pareil : ¥1 000/jour au plancher. On recommande plutôt ¥15 000 à ¥30 000 par mois pour accumuler assez de données et pouvoir vraiment affiner les campagnes.' },
  { q: 'Vous gérez les budgets publicitaires vous-mêmes ?', a: 'Oui. L\'argent va directement aux plateformes. On ne prend aucune commission dessus. Nos honoraires couvrent la stratégie, la mise en place, la conception des annonces et les rapports de suivi.' },
  { q: 'Au bout de combien de temps on voit des résultats ?', a: 'Pour le trafic, dès la première semaine en général. Les conversions demandent deux à trois semaines d\'ajustements. La notoriété, c\'est plutôt 30 à 60 jours.' },
  { q: 'Nos publicités actuelles ne donnent rien. Que faire ?', a: 'On commence toujours par un audit. Campagnes, ciblage, visuels, répartition du budget. Ensuite on reconstruit ce qui cloche. Les problèmes les plus fréquents : format inadapté, visuels qui ont tourné trop longtemps, ciblage trop large, et surtout personne pour optimiser au jour le jour.' },
  { q: 'Vous produisez aussi les visuels et vidéos ?', a: 'Oui. Vidéo, image, rédaction, pour chaque plateforme. La direction artistique est pilotée par notre équipe. La production est accélérée grâce à l\'IA, via HubStudio.ai.' },
  { q: 'Mettre en avant une publication ou lancer une vraie campagne ?', a: 'Mettre en avant, c\'est rapide mais limité. Une campagne structurée permet un ciblage fin, des tests sur les visuels, des objectifs de conversion, une stratégie d\'enchères et un suivi du retour sur investissement publicitaire. La différence de résultats est souvent très nette.' },
  { q: 'Le ROAS, c\'est toujours le bon indicateur ?', a: 'Pour la vente en ligne et la réponse directe, oui, dans la grande majorité des cas. Pour la notoriété, on bascule sur le coût pour mille impressions et la couverture. L\'important c\'est de s\'accorder sur ce que veut dire "succès" avant de lancer, pas après coup.' },
  { q: 'On peut diffuser sur plusieurs plateformes en même temps ?', a: 'Oui. Et c\'est même souvent préférable. Douyin et RedNote couvrent la découverte et la notoriété. WeChat permet de recibler les personnes qui ont déjà interagi ailleurs. On détermine la bonne combinaison en fonction de vos objectifs et de ce que vous pouvez investir.' },
  { q: 'Et la vérification des comptes publicitaires ?', a: 'La plupart des plateformes bloquent l\'accès au gestionnaire de publicités tant que le compte n\'est pas vérifié. On s\'occupe de toute la procédure. Il faut compter entre une et trois semaines.' },
  { q: 'Comment sont calculés vos honoraires ?', a: 'Honoraires fixes pour le travail de conception et de gestion. Le budget publicitaire est séparé et versé directement aux plateformes. Pas de zone grise.' },
];

const gettingStartedSteps = [
  {
    title: 'Premier échange.',
    description: 'Votre marque, vos objectifs, le budget que vous avez en tête. On détermine ensemble la bonne approche.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Plan média.',
    description: 'Choix des plateformes, ventilation du budget, indicateurs prévisionnels. Périmètre clair. Honoraires de gestion fixes.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'Vos annonces en ligne sous 2 semaines.',
    description: 'Ouverture des comptes, production des visuels, lancement. L\'optimisation commence dès le premier jour.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="Publicité sur les réseaux sociaux chinois | TheRedScroll"
  description="Achat média et optimisation publicitaire sur WeChat, Douyin et RedNote. Honoraires fixes. Budget publicitaire transparent. Équipe basée à Shanghai."
  lang="fr"
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/advertising-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Achat média et diffusion publicitaire
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Toucher les bonnes personnes. Pas juste davantage de monde.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        On planifie, on achète et on optimise vos campagnes publicitaires sur WeChat, Douyin, RedNote et Weibo. Honoraires de gestion fixes. Budget média transparent.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Réserver un appel</Button>
        <Button variant="secondary-dark" href="#what-we-do">Voir nos prestations</Button>
      </div>
    </div>
  </section>

  <!-- Why advertising is (almost) mandatory -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Pourquoi payer</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">La publicité n'est plus une option, ou presque</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">La visibilité naturelle construit une audience au fil du temps. Mais elle ne sait pas viser les femmes de 25 à 34 ans à Shanghai qui ont cherché "soin naturel" la semaine dernière. La publicité, elle, le peut.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">Voir nos prestations</Button>
          </div>
        </div>
        <div class="relative overflow-hidden bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">La rapidité</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Le contenu naturel prend des mois à porter ses fruits. Une campagne bien calibrée peut générer des ventes en quelques jours.</p>
        </div>
        <div class="relative overflow-hidden bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">La précision</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">On cible par âge, sexe, catégorie de ville, centres d'intérêt, type d'appareil, habitudes d'achat, historique de navigation. Les annonces vont exactement où vous le décidez.</p>
        </div>
        <div class="relative overflow-hidden bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">La montée en charge</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">Vous testez avec ¥5 000 le lundi. Si les chiffres suivent, vous passez à ¥50 000 le vendredi. Essayez d'en faire autant avec du contenu naturel.</p>
        </div>
        <div class="relative overflow-hidden bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Mais ça a un coût</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Une campagne mal ficelée brûle du budget plus vite que l'absence totale de campagne. La planification média, l'optimisation au quotidien et des indicateurs clairs comptent autant que les annonces elles-mêmes.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Nos prestations">Planification média</SectionHeading>

      <!-- Hero image -->
      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img
          src="/images/what-we-do/advertising.png"
          alt="L'équipe TheRedScroll en train d'analyser les résultats de campagnes publicitaires"
          class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Overlapping cards -->
      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Planification média</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Avant de dépenser le moindre yuan, on pose le cadre. Quelles plateformes, quels formats, quels profils d'audience, combien par canal, et quel coût par résultat on peut raisonnablement viser.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Mise en place et optimisation des campagnes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">De bout en bout. Ouverture des comptes, envoi des visuels, ciblage, stratégie d'enchères, tests comparatifs. Optimisation quotidienne. Un visuel qui marchait lundi peut s'essouffler dès jeudi.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Toutes les plateformes couvertes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">On gère des campagnes sur Ocean Engine (Douyin), Tencent Ads (WeChat), Juguang (RedNote) et Weibo Fan Tong. On connait les réglages enfouis qui font vraiment la différence.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Ad creative + Retargeting + Compliance + Reporting — dark section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Prise en charge complète</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">De la conception au suivi, en passant par la conformité</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            Une publicité qui a l'air d'une publicité, personne ne la regarde. Celle qui ressemble à du contenu natif, si. On conçoit des visuels adaptés au format propre à chaque plateforme, et on les renouvelle avant que les résultats ne fléchissent. L'IA nous aide à absorber le volume de production. La direction artistique reste entre les mains de notre équipe.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Reciblage et audiences sur mesure</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Quelqu'un a regardé 50 % de votre vidéo Douyin sans cliquer ? On le relance avec un angle différent. Un visiteur est passé sur votre Mini Program sans rien acheter ? On lui montre une relance. Sur RedNote, on peut constituer des audiences à partir des utilisateurs qui ont interagi avec des notes précises ou cherché certains mots-clés. C'est souvent là qu'on obtient le meilleur retour sur investissement.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Conformité et validation des annonces</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Chaque plateforme applique ses propres règles de validation. Certains secteurs sont soumis à des restrictions, d'autres carrément interdits. On gère les vérifications de conformité en amont, le processus de validation, et on signale les contraintes sectorielles avant que vous n'engagiez le moindre budget.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Rapports de performance</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Le retour sur investissement publicitaire est le chiffre autour duquel tout s'articule. On suit aussi le coût par clic, le coût pour mille, le taux de clic, le coût par acquisition, le taux de conversion et la fréquence d'affichage. Rapports hebdomadaires tant que les campagnes tournent. Bilan mensuel. Pour les budgets conséquents, accès à un tableau de bord en temps réel.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Budget transparent</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Le budget publicitaire est facturé à part. Pas de commission. Pas de frais cachés sur l'achat média. Vous voyez exactement où passe chaque yuan.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Ad formats & indicative pricing — WeChat -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Formats et tarifs indicatifs">WeChat (via Tencent Ads)</SectionHeading>
      <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[24px] max-w-[680px]">
        Les tarifs ci-dessous s'appuient sur les données du premier trimestre 2026 et nos propres références. Ils sont là pour vous aider à cadrer votre budget. Ce ne sont pas des devis.
      </p>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-moments-ad.svg" alt="Exemple d'annonce WeChat Moments" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Annonces Moments</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Annonces natives dans le fil social. Carrousel (jusqu'à six cartes), vidéo en lecture automatique (6-15 sec) ou plein écran au toucher. 122 sous-catégories de centres d'intérêt. Enchères à partir de ¥1 000/jour. Coût pour mille de ¥50 à ¥180, selon la catégorie de ville.</p>
          </div>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-banner-ad.svg" alt="Bannière dans un article de Compte Officiel WeChat" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Bannières</h3>
