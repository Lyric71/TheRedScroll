---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import FaqAccordion from '../../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'Combien de temps dure la phase stratégique ?', a: 'Tout dépend du périmètre, mais comptez généralement de deux à quatre semaines. Cet exercice constitue notre quotidien depuis des années, le déroulé reste donc rapide.' },
  { q: 'Travaillez-vous uniquement avec les marques en phase de lancement ?', a: 'Non. Trois profils nous sollicitent : les marques qui entrent en Chine, celles déjà installées qui visent de meilleurs résultats, et les marques locales qui veulent gagner du terrain sur les réseaux. Trois points de départ distincts, une même exigence.' },
  { q: 'Peut-on démarrer sur une seule plateforme ?', a: 'Oui, et c\'est même souvent notre recommandation. Concentrer les moyens, identifier ce qui produit du résultat, installer une dynamique, puis élargir le dispositif.' },
  { q: 'Quelles plateformes couvrez-vous ?', a: 'WeChat, Douyin, RedNote et Weibo sont intégrés à toutes nos formules. Bilibili, Zhihu, Kuaishou, Toutiao, Meituan, Dianping et neuf autres plateformes restent disponibles en option.' },
  { q: 'Comment vos tarifs sont-ils structurés ?', a: 'Périmètre arrêté, tarif ferme. Une liste précise de livrables et un forfait mensuel unique. Les dépenses publicitaires sont refacturées à part. Aucun frais caché, aucune dérive en cours de contrat.' },
  { q: 'En quoi vos analyses se distinguent-elles d\'un tableau de bord classique ?', a: 'Suivi de performance multiplateforme, comparatifs concurrentiels détaillés, données d\'engagement ventilées contenu par contenu. Surtout, nous traduisons ces chiffres en recommandations actionnables. Pas de simples courbes.' },
  { q: 'Gérez-vous aussi la production de contenu, ou uniquement la stratégie ?', a: 'La stratégie et les campagnes relèvent de cette prestation. La production (visuels, vidéos, rédaction) constitue un service distinct, mais les deux avancent de concert : la stratégie dicte ce qui sort en production.' },
  { q: 'À quelle fréquence la stratégie est-elle revue ?', a: 'Tous les mois au minimum. Chaque trimestre, nous allons plus loin : recalibrage des indicateurs, actualisation du comparatif concurrentiel, réexamen du choix des plateformes.' },
  { q: 'Pouvez-vous intervenir en parallèle de notre équipe interne ou de notre agence actuelle ?', a: 'Certains clients nous confient l\'ensemble du pilotage. D\'autres ne nous demandent que la stratégie et conservent l\'exécution en interne. Nous nous adaptons à l\'organisation qui vous convient.' },
  { q: 'Et si nos comptes existent déjà mais ne produisent pas de résultats ?', a: 'Nous commençons par un audit : comptes existants, contenus publiés, engagement, positionnement face à la concurrence. Puis nous bâtissons une stratégie révisée à partir de ce que les données indiquent. Parfois, le choix des plateformes est en cause. Parfois, c\'est le contenu lui-même, la cadence ou le calendrier éditorial qui pèche. Nous identifions la faille avant toute intervention.' },
];

const gettingStartedSteps = [
  {
    title: 'Appel découverte.',
    description: 'Votre marque, vos objectifs, votre maturité sur le marché chinois. Pas d\'argumentaire commercial, seulement les bonnes questions.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Proposition.',
    description: 'Périmètre limpide, prix fixe, chaque livrable détaillé. Vous savez exactement ce que vous obtenez avant même de signer.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'En ligne sous deux semaines.',
    description: 'Stratégie livrée, campagnes paramétrées, premiers contenus publiés. Deux semaines après la signature.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="Stratégie réseaux sociaux et campagnes en Chine | TheRedScroll"
  description="Stratégie social media, pilotage de campagnes et analyse pour les marques présentes en Chine. Périmètre fixe, prix fixe. Une équipe basée à Shanghai."
  lang="fr"
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/strategy-campaigns-hero.webp')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Stratégie, campagnes et analyse
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        La bonne stratégie. Les bonnes plateformes. Les bons indicateurs.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Nous analysons votre marché, bâtissons votre plan, orchestrons vos campagnes et mesurons ce qui compte réellement. Depuis Shanghai et Hong Kong.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#what-we-do">Nos services</Button>
      </div>
    </div>
  </section>

  <!-- Problem intro -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Le constat">La plupart des marques publient sans plan d'ensemble.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Elles choisissent leurs plateformes à l'instinct, publient quand un créneau se libère, et n'examinent les chiffres qu'une fois par trimestre. Parfois moins souvent encore.
            </p>
            <p>
              Une stratégie sérieuse part d'autres prémices : quelles plateformes correspondent à votre secteur, ce que font vos concurrents et là où ils butent, quels formats produisent du résultat, comment vérifier chiffres à l'appui que la mécanique tourne.
            </p>
            <p>
              Nous bâtissons chaque stratégie depuis une feuille blanche. Données de marché réelles, analyse concurrentielle approfondie, connaissance des plateformes au quotidien. Nous pilotons ensuite les campagnes en propre, sans relais.
            </p>
          </div>
        </div>
        <div class="flex items-center justify-center">
          <img src="/images/strategy-compass.svg" alt="Boussole sans aiguille, une stratégie sans direction" class="w-full max-w-[320px]" loading="lazy" />
        </div>
      </div>
    </Container>
  </section>

  <!-- Why you need a platform-specific strategy -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <!-- Hero card: 2 cols, 2 rows -->
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/><circle cx="7" cy="16" r="1.5"/><circle cx="11" cy="8" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="21" cy="4" r="1.5"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Pourquoi ça compte</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Pourquoi chaque plateforme mérite sa propre stratégie</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">Chaque plateforme possède sa propre audience, ses propres formats et son propre algorithme. Appliquer une même recette partout revient à dilapider le budget et à laisser les vraies opportunités passer.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">Nos services</Button>
          </div>
        </div>
        <!-- Cards -->
        <div class="bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="8" height="8" rx="1"/><rect x="14" y="3" width="8" height="8" rx="1"/><rect x="2" y="13" width="8" height="8" rx="1"/><rect x="14" y="13" width="8" height="8" rx="1"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Chaque plateforme impose ses propres règles</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">WeChat, Douyin, RedNote et Weibo ne partagent ni les mêmes formats, ni les mêmes régies publicitaires, ni les mêmes attentes des utilisateurs. Se tromper de plateforme équivaut à brûler un budget.</p>
        </div>
        <div class="bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M7 7l3.5 9M17 7l-3.5 9"/><path d="M7 6h10"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Les audiences circulent d'une plateforme à l'autre</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">Le consommateur se renseigne sur RedNote, suit les marques sur WeChat, visionne les démonstrations produit sur Douyin et consulte les avis sur Weibo.</p>
        </div>
        <div class="bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">La concurrence a pris ses positions</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">Vos concurrents publient au quotidien, orchestrent des campagnes d'influence et investissent en média. À défaut de plan clair, vous dépensez à l'aveugle.</p>
        </div>
        <div class="bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Le terrain se déplace en permanence</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Les algorithmes évoluent sans préavis. De nouveaux formats publicitaires surgissent tous les deux à trois mois. Une stratégie efficace en janvier peut perdre sa pertinence dès avril.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do — Market & Competitor Research -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Ce qu'on fait">Étude de marché et analyse concurrentielle</SectionHeading>

      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img src="/images/what-we-do/strategy-campaigns.webp" alt="L'équipe TheRedScroll analysant les données stratégiques et concurrentielles" class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Analyse concurrentielle</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Nous cartographions les comptes de vos concurrents sur chaque grande plateforme. Abonnés, cadence de publication, taux d'engagement, thématiques éditoriales, investissements publicitaires. Une analyse calibrée pour votre marque, jamais un rapport préformaté.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Choix des plateformes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Aucune marque n'a besoin de toutes les plateformes à la fois. La beauté se joue sur RedNote. Le B2B passe par WeChat et Zhihu. La mode prend son essor sur Douyin. Nous retenons celles qui correspondent à votre secteur, et à lui seul.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Stratégie éditoriale et calendrier</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Piliers de contenu, lignes de force du discours, ton éditorial calibré pour chaque plateforme. Sujets, formats, cadence de publication. Chaque plateforme a son propre calendrier, réajusté tous les mois au regard des résultats.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Creative & Planning — dark section (1 per page) -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[1024px]:p-[32px] max-[640px]:p-[32px_20px]">
        <div class="grid grid-cols-[1fr_1px_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px]">
          <!-- Col 1: heading + intro -->
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Création et planification</p>
            <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[24px]">Le terrain où tout se décide.</h2>
            <div class="flex flex-col gap-[24px]">
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                L'IA a redistribué les cartes de la production de contenu. Visuels, montages vidéo, premières versions rédactionnelles sortent plus rapidement et à un coût sans commune mesure avec celui de l'an dernier. Les coûts de fabrication tendent vers zéro.
              </p>
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                Ce basculement rend la planification créative plus décisive, jamais moins. Lorsque tous les acteurs peuvent produire en série, les marques qui se détachent sont celles qui disposent des meilleures idées et de la direction artistique la plus fine. Le livrable a cessé d'être l'obstacle. La vraie question demeure : quoi produire, pourquoi, et comment tout s'articule. C'est, et cela reste, un travail humain.
              </p>
            </div>
          </div>
          <!-- Vertical separator -->
          <div class="flex items-center max-[640px]:hidden">
            <div class="w-[1px] h-[60%] bg-[var(--color-vermillion)]"></div>
          </div>
          <!-- Col 2: service details -->
          <div class="flex flex-col gap-[32px]">
            <div>
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Direction créative</h3>
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                Nous rédigeons un brief créatif pour chaque campagne. Direction visuelle, ton, contraintes de format, références propres à chaque plateforme. Chaque brief s'appuie sur ce qui produit réellement du résultat sur la plateforme visée. Nous décortiquons les contenus les mieux classés de votre catégorie, prélevons nos références dans les publications les plus performantes, et identifions les contenus de KOL (Key Opinion Leader) qui captent l'attention au moment du brief.
              </p>
            </div>
            <div>
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Orchestration de campagnes</h3>
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                Une campagne ne se résume pas à une succession de publications. Elle s'apparente à une partition coordonnée entre contenu, influenceurs, achat média et animation de communauté. Nos responsables réseaux sociaux synchronisent les calendriers des KOL avec les sorties de la marque, alignent l'achat média sur la dynamique organique, et redéploient les budgets en cours de route dès qu'un contenu s'envole ou s'effondre.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Day-to-day + KPI + Analytics — service cards -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Exécution">Opérations au quotidien et suivi</SectionHeading>

      <!-- Horizontal column accordion -->
      <div class="flex gap-[2px] mt-[24px] h-[400px] max-[640px]:flex-col max-[640px]:h-auto" data-col-accordion>

        <div class="col-panel is-active rounded-l-[10px] max-[640px]:rounded-l-none max-[640px]:rounded-t-[10px]" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Gestion des comptes</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Gestion des comptes</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Nous assurons l'exploitation quotidienne sur WeChat, Douyin, RedNote, Weibo et quatorze autres plateformes. Publication, animation de communauté, modération des commentaires, veille des tendances. Vous vous épargnez la constitution d'une équipe locale.</p>
          </div>
        </div>

        <div class="col-panel" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Campagnes et opérations spéciales</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Campagnes et opérations spéciales</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Campagnes saisonnières, lancements produit, opérations événementielles, accélérations multiplateformes. Brief précis, indicateurs arrêtés, rétroplanning, bilan circonstancié dès la clôture.</p>
          </div>
        </div>

        <div class="col-panel" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Indicateurs et objectifs</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Indicateurs et objectifs</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Des objectifs mesurables dès le premier jour. Croissance des abonnés, taux d'engagement, vues vidéo, taux de clic, conversions. Les indicateurs sont arrimés à des résultats concrets, jamais à des chiffres de vitrine. Revue mensuelle, recalibrage trimestriel.</p>
          </div>
        </div>

        <div class="col-panel rounded-r-[10px] max-[640px]:rounded-r-none max-[640px]:rounded-b-[10px]" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Analyse et rapports</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Analyse et rapports</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Les rapports mensuels couvrent la croissance des abonnés, les taux d'engagement, la performance par contenu, la rentabilité des dépenses publicitaires et le comparatif concurrentiel. Suivi multiplateforme, données d'engagement détaillées, recommandations à la clé. Pas de simples graphiques.</p>
          </div>
        </div>

      </div>

      <style>
        .col-panel {
          position: relative;
          flex: 0 0 56px;
          background: var(--color-rice-paper);
          cursor: pointer;
          overflow: hidden;
          transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .col-panel.is-active {
          flex: 1 1 0%;
          cursor: default;
        }

        /* Vertical rotated label — visible when collapsed */
        .col-label {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 1;
          transition: opacity 0.3s ease;
        }
        .col-panel.is-active .col-label {
          opacity: 0;
          pointer-events: none;
        }
        .col-label-text {
          writing-mode: vertical-rl;
          text-orientation: mixed;
          transform: rotate(180deg);
          font-size: 14px;
          font-weight: 500;
          color: var(--color-ink);
          white-space: nowrap;
          letter-spacing: 0.02em;
        }

        /* Expanded content */
        .col-content {
          position: absolute;
          inset: 0;
          padding: 32px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          opacity: 0;
          transition: opacity 0.35s ease 0.15s;
        }
        .col-panel.is-active .col-content {
          opacity: 1;
        }

        /* Vermillion left accent on active panel */
        .col-panel.is-active::before {
          content: '';
          position: absolute;
          left: 0;
          top: 15%;
          bottom: 15%;
          width: 3px;
          background: var(--color-vermillion);
          border-radius: 0 2px 2px 0;
        }

        /* Hover state for collapsed panels */
        .col-panel:not(.is-active):hover {
          background: var(--color-warm-gray);
        }

        /* Mobile: stack vertically */
        @media (max-width: 640px) {
          .col-panel {
            flex: 0 0 48px;
          }
          .col-panel.is-active {
            flex: 0 0 auto;
            min-height: 200px;
          }
          .col-label-text {
            writing-mode: horizontal-tb;
            transform: none;
            font-size: 13px;
          }
          .col-content {
            position: relative;
            padding: 20px;
          }
          .col-panel.is-active::before {
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            height: auto;
          }
        }
      </style>

      <script>
        document.querySelectorAll('[data-col-accordion]').forEach((accordion) => {
          const panels = accordion.querySelectorAll('[data-col-panel]');
          panels.forEach((panel) => {
            panel.addEventListener('click', () => {
              if (panel.classList.contains('is-active')) return;
              panels.forEach((p) => p.classList.remove('is-active'));
              panel.classList.add('is-active');
            });
          });
        });
      </script>
    </Container>
  </section>

