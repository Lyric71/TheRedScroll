---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import FaqAccordion from '../../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'L\'IA peut-elle vraiment produire du contenu de qualité suffisante pour des marques premium ?', a: 'Oui, à condition d\'entraîner le modèle correctement. Un rendu IA générique reste générique. Nous entraînons des modèles personnalisés sur l\'identité visuelle de votre marque, votre palette de couleurs, votre packaging et votre style de photo produit. Le résultat correspond à votre marque. Pas à celle d\'un autre.' },
  { q: 'Quel pourcentage du contenu est IA vs. réel ?', a: 'Cela dépend de la marque et de la plateforme. Pour la majorité de nos clients, l\'AIGC prend en charge 60 à 70 % de la production visuelle (images produit, visuels pour les réseaux, vidéos courtes). La production réelle couvre les 30 à 40 % restants (vidéos phares, contenu lifestyle, tournages KOL).' },
  { q: 'Vous rédigez en chinois ou vous adaptez depuis l\'anglais ?', a: 'Nous rédigeons en chinois. Nous ne traduisons pas. La différence est considérable. Nos rédacteurs sont des locuteurs natifs du mandarin basés à Shanghai. Si vous fournissez des guidelines de marque en anglais, nous les utilisons comme point de départ, mais le résultat est rédigé pour les plateformes chinoises depuis zéro.' },
  { q: 'Comment suivez-vous les tendances ?', a: 'Nos social media managers sont sur les plateformes chaque jour. Ils suivent les hashtags en vogue, les formats viraux, les temps forts saisonniers et l\'activité concurrentielle. Quand quelque chose de pertinent apparaît, nous pouvons produire et publier une réponse sous 24 à 48 heures.' },
  { q: 'Et si nous avons déjà des assets créatifs globaux ?', a: 'Nous pouvons les adapter, mais l\'adaptation performe généralement moins bien que du contenu produit localement. Nous utiliserons vos assets globaux là où c\'est pertinent et les compléterons avec du contenu AIGC et de la production réelle pour les publications courantes.' },
  { q: 'Combien de publications par mois faut-il ?', a: 'Présence minimale viable : 8 à 12 publications par plateforme et par mois. Présence compétitive : 20 à 30. C\'est uniquement l\'organique. Les créations publicitaires viennent en plus. Nous construisons un calendrier de contenu qui correspond à votre budget et vos objectifs.' },
  { q: 'Pouvez-vous produire du contenu pour plusieurs plateformes en même temps ?', a: 'C\'est en fait le fonctionnement par défaut. La plupart des clients opèrent sur deux à quatre plateformes. Chacune reçoit son propre calendrier de contenu, son propre ton et ses propres formats. Nous ne recyclons pas la même publication d\'une plateforme à l\'autre. Cela ne fonctionne pas.' },
  { q: 'Comment fonctionne la tarification ?', a: 'Périmètre fixe. Prix fixe. Vous connaissez le nombre de publications, vidéos, articles et tournages inclus chaque mois. Les dépenses publicitaires et les options de production réelle sont chiffrées séparément et en toute transparence.' },
  { q: 'À qui appartient le contenu que vous produisez ?', a: 'À vous. Chaque asset que nous produisons, qu\'il soit AIGC ou réel, appartient à votre marque. Droits d\'utilisation complets, aucune restriction de licence, aucune date d\'expiration. Vous pouvez le réutiliser où vous voulez.' },
  { q: 'En combien de temps pouvez-vous livrer du contenu ?', a: 'Assets AIGC : 2 à 3 jours ouvrés du brief à la livraison. Les tournages réels nécessitent 1 à 2 semaines pour la planification, le tournage et la post-production. Le contenu réactif aux tendances peut aller du concept à la publication en 24 à 48 heures si nécessaire.' },
];

const gettingStartedSteps = [
  {
    title: 'Appel découverte.',
    description: 'Parlez-nous de votre marque, de vos plateformes et de là où le contenu pèche.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Plan de contenu.',
    description: 'Recommandations de formats, approche de production, répartition AIGC vs. réel, et tarification. Périmètre clair.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'En ligne sous 2 semaines.',
    description: 'Stratégie de contenu, production des assets et premières publications. Quatorze jours après la signature du contrat.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="Production de contenu pour les réseaux sociaux chinois | TheRedScroll"
  description="Images AIGC, production vidéo, rédaction et localisation pour WeChat, Douyin et RedNote. Périmètre fixe. Rapidité IA. Équipe à Shanghai."
  lang="fr"
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/content-production-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Production de contenu
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Ce que vous dites compte plus que le prix auquel vous le produisez.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Stratégie, direction créative, AIGC, tournages réels, rédaction et localisation. Depuis Shanghai et Hong Kong.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#what-we-do">Ce que nous faisons</Button>
      </div>
    </div>
  </section>

  <!-- Why content production has changed -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Le tournant</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Pourquoi la production de contenu a changé</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">L'IA peut désormais produire des visuels et du texte en quelques minutes. Quand tout le monde peut créer à bas coût, la réflexion derrière le contenu devient le vrai facteur de différenciation.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">Ce que nous faisons</Button>
          </div>
        </div>
        <div class="bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Le ton est propre à chaque plateforme</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">RedNote récompense un contenu décontracté, presque intime. Weibo exige des titres percutants. WeChat demande de la profondeur. Douyin vit d'accroches et de rythme. Un même ton sur les quatre plateformes ne fonctionnera pas.</p>
        </div>
        <div class="bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Les tendances évoluent vite</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">Un hashtag tendance sur Douyin aujourd'hui peut avoir disparu la semaine prochaine. Votre équipe contenu doit être sur les plateformes au quotidien, pour repérer les opportunités en temps réel.</p>
        </div>
        <div class="bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Le volume est considérable</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">Avec trois ou quatre plateformes, comptez 30 à 50 contenus par mois, plus les créations publicitaires. Aucune équipe ne peut tenir ce rythme avec de la production traditionnelle seule.</p>
        </div>
        <div class="bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">L'IA est le seul moyen de suivre</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">L'AIGC absorbe le volume de production. Votre équipe gère la direction créative. La réflexion est humaine. La vitesse d'exécution ne l'est pas.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do — Content structure & AIGC -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Ce que nous faisons">Structure de contenu et stratégie</SectionHeading>

      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img src="/images/what-we-do/content-production.png" alt="L'équipe TheRedScroll dirigeant un tournage de production de contenu" class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Stratégie de contenu</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Piliers de contenu, cadre de messages, ton éditorial et formats par plateforme. 100 % piloté par des humains. L'IA ne peut pas décider si votre marque doit surfer sur une tendance ou rester en retrait.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Images et vidéos AIGC</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Visuels produit, images lifestyle et vidéos courtes générés par IA. Modèles personnalisés entraînés sur votre identité de marque pour un rendu qui vous ressemble. Environ 80 % plus rapide que la production traditionnelle.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Production réelle</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Tourné sur place en Chine. Coulisses, unboxings produit, films de marque, tournages en collaboration avec des KOL. L'IA ne peut pas remplacer une vraie personne utilisant votre produit.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Copywriting & Indicative pricing — dark section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Rédaction et localisation</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">Ce n'est pas de la traduction.</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            Un article WeChat a une structure et de la profondeur. Une légende RedNote se lit comme un ami qui partage un conseil. Un texte superposé sur Douyin doit accrocher en deux secondes. Le texte est différent pour chaque plateforme, même quand le produit est le même.
          </p>
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            L'IA ébauche. Des rédacteurs chinois natifs relisent et adaptent culturellement. Pour les marques qui entrent sur le marché, nous prenons aussi en charge le naming de marque, la localisation des accroches et l'adaptation du messaging.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Tarifs indicatifs AIGC</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              10 images produit AIGC : ¥2,000 à ¥5,000. 5 vidéos courtes pour les réseaux (15-30 sec) : ¥5,000 à ¥12,000. À titre de comparaison : un shooting photo produit à Shanghai revient à ¥8,000 à ¥25,000/jour. Une vidéo de 30 secondes démarre à ¥15,000 à ¥50,000.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Tarifs indicatifs production réelle</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Demi-journée photo (Shanghai) : ¥8,000 à ¥15,000. Journée complète de production vidéo avec équipe et montage : ¥20,000 à ¥60,000. Selon le périmètre, le lieu, les talents et la post-production.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Content formats by platform -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Formats par plateforme">Douyin</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Vidéo courte (15-60 sec)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Le format dominant. Démonstrations produit, tutoriels, clips lifestyle, contenu de tendance. Vertical 9:16. L'accroche doit fonctionner dans les 2 premières secondes. Musique et sous-titres indispensables.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Live streaming</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Démonstrations produit, questions-réponses, ventes flash. Durée de 1 à 4 heures. Génère des ventes directes via Douyin Shop. Nécessite un présentateur formé, un chat en temps réel et une coordination de l'affichage produit.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Carrousel Douyin</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Jusqu'à 20 images dans un format à faire défiler. Adapté au contenu pédagogique, aux guides étape par étape, aux comparatifs produit. De plus en plus utilisé par les marques beauté et soin.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- RedNote formats -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Formats par plateforme">RedNote / Xiaohongshu</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Notes photo</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">1 à 9 images avec légende. Le format natif. Photos lifestyle, compositions à plat, avant-après. Le ton doit sembler personnel et sincère. Pensez journal intime, pas communiqué de presse.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Notes vidéo</h3>
