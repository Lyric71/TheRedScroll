---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import FaqAccordion from '../../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'Comment detectez-vous les faux abonnes ?', a: 'Nous croisons le nombre d\'abonnes avec les taux d\'engagement, la qualite des commentaires et la composition de l\'audience. Un createur avec 200 000 abonnes et 50 commentaires par publication, principalement des emojis generiques, c\'est un signal d\'alerte. Les outils natifs comme Xingtu et Pugongying fournissent aussi des donnees certifiees. Apres plusieurs centaines de campagnes, on repere vite les anomalies.' },
  { q: 'Combien de KOL faut-il mobiliser ?', a: 'Tout depend de l\'objectif. Campagne de seeding : 20 a 50 KOC. Notoriete de marque : 3 a 5 KOL de moyenne envergure. Lancement produit phare : un createur de premier plan soutenu par 10 a 15 KOC. On ajuste le mix en fonction de votre budget et de vos objectifs.' },
  { q: 'Peut-on valider le contenu avant publication ?', a: 'En regle generale, oui. Nous partageons les brouillons ou les previsualisations avant mise en ligne. Certains createurs refusent les retouches trop poussees, car cela nuit a l\'authenticite. Et ils ont souvent raison. Mais les messages cles, les mentions legales et les directives de marque sont toujours verifies.' },
  { q: 'Quelle difference entre KOL et KOC ?', a: 'Les KOL sont des createurs professionnels avec de larges audiences et du contenu soigne. Les KOC (Key Opinion Consumers) sont des utilisateurs ordinaires, avec des communautes plus restreintes, qui partagent leurs experiences produit de maniere spontanee. Les KOL portent la notoriete. Les KOC construisent la confiance et la presence dans les resultats de recherche. La plupart des campagnes ont besoin des deux.' },
  { q: 'Quel delai pour lancer une campagne ?', a: 'Deux a quatre semaines entre le brief et la premiere publication. Ce delai couvre l\'identification des createurs, la prise de contact, la negociation, le briefing, la production de contenu et la validation. Les campagnes de seeding avec des KOC vont plus vite, parfois une a deux semaines.' },
  { q: 'Peut-on reutiliser le contenu des influenceurs comme publicite ?', a: 'Parfois. Les droits d\'utilisation doivent etre negocies en amont. Certains createurs incluent l\'usage publicitaire dans leur tarif. D\'autres demandent un paiement de licence supplementaire, qui peut representer 30 a 50 % en plus. Nous reglons cette question pendant la phase contractuelle pour eviter les surprises.' },
  { q: 'Quels secteurs obtiennent les meilleurs resultats ?', a: 'La beaute, les soins et la mode affichent les meilleurs resultats parce que l\'ecosysteme de createurs y est le plus developpe. L\'alimentaire, la sante et le bien-etre, l\'hotellerie et l\'electronique grand public suivent de pres. Les marques B2B peuvent aussi obtenir de bons resultats, notamment sur WeChat et Zhihu, mais le vivier de createurs pertinents est plus restreint.' },
  { q: 'Gerez-vous les paiements aux createurs ?', a: 'L\'ensemble du processus. Negociation, contrat, paiement, documentation fiscale. Vous nous reglez. Nous nous occupons du reste avec les createurs et leurs MCN.' },
];

const gettingStartedSteps = [
  {
    title: 'Appel decouverte.',
    description: 'Votre marque, vos objectifs et le type de createurs avec lesquels vous souhaitez collaborer.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Selection de KOL.',
    description: 'Des createurs verifies, adaptes a votre marque, votre niche et votre budget. Chaque chiffre d\'engagement controle.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'Premieres publications en 2 a 4 semaines.',
    description: 'Prise de contact, briefing, production de contenu, validation et publication.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  lang="fr"
  title="Agence KOL et KOC en Chine | TheRedScroll"
  description="Campagnes KOL et KOC sur Douyin, RedNote, WeChat. Selection de createurs, live commerce, pilotage de campagne. Perimetre fixe. Equipe a Shanghai."
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/influencer-marketing-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Marketing d'influence
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Le bon createur qui parle de votre marque vaut plus que n'importe quelle publicite.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Nous trouvons les bons KOL et KOC, les verifions, les briefons, gerons la relation et mesurons ce qui a reellement fonctionne. Depuis Shanghai et Hong Kong.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#ce-que-nous-faisons">Nos prestations</Button>
      </div>
    </div>
  </section>

  <!-- Pourquoi le marketing d'influence est incontournable -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><path d="M20.84 4.61a5.5 5.5 0 0 1-8.69 4.28"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">L'atout createurs</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Pourquoi le marketing d'influence est incontournable</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">La publicite place votre message devant les gens. Le marketing d'influence place votre produit entre les mains d'une personne en qui ils ont deja confiance.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#ce-que-nous-faisons">Nos prestations</Button>
          </div>
        </div>
        <div class="relative overflow-hidden bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">On touche des communautes, pas des segments</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Les abonnes d'un KOL partagent des centres d'interet, des gouts et une relation de confiance. Quand cette personne recommande un produit, l'audience reagit d'une facon que la publicite classique n'obtient pas.</p>
        </div>
        <div class="relative overflow-hidden bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Des taux de conversion plus eleves</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">Les marques qui font appel a des KOL sur RedNote constatent des taux de conversion environ 2,3 fois superieurs a ceux des canaux publicitaires classiques.</p>
        </div>
        <div class="relative overflow-hidden bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Un marche en pleine acceleration</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">L'economie de l'influence devrait atteindre 117 milliards de RMB d'ici fin 2025. Plus de la moitie des annonceurs utilisent deja du contenu de createurs.</p>
        </div>
        <div class="relative overflow-hidden bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Mais c'est un travail considerable</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Trouver des createurs, verifier leurs abonnes, negocier les tarifs, valider les contenus, suivre les resultats. Une seule campagne avec 15 createurs peut representer plus de 100 heures de travail.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Ce que nous faisons -->
  <section id="ce-que-nous-faisons" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Ce que nous faisons">Identification de KOL et KOC</SectionHeading>

      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img src="/images/what-we-do/influencer-kol-douyin.png" alt="Telephone affichant un flux video Douyin avec du contenu de createurs chinois" class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Identification des createurs</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Base de donnees de createurs sur Douyin, RedNote, WeChat, Weibo, Bilibili et Kuaishou. Chaque createur est verifie : authenticite de l'engagement, qualite de l'audience, style de contenu et adequation avec la marque.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Planification et briefing de campagne</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Chaque campagne dispose d'un brief. Objectifs, messages cles, format de contenu, calendrier de publication, regles de la plateforme. Le calendrier des KOL est coordonne avec votre planning editorial et vos campagnes payantes.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Negociation et contractualisation</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Nous negocions les tarifs, les droits d'utilisation, les clauses d'exclusivite et les livrables. L'ecart entre les tarifs affiches et le prix reel peut depasser 15 %. Nous connaissons le juste prix.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Live commerce, conformite, reporting — section sombre -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Service complet</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">Du live commerce a la conformite, jusqu'au reporting</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            Le live streaming est un canal de vente a part entiere. Une seule session sur Douyin ou Taobao Live peut generer des milliers de commandes en quelques heures. Nous coordonnons le choix de l'animateur, le briefing produit, l'elaboration du script, la moderation du chat en temps reel et le reporting post-session.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Conformite et mentions legales</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Le contenu sponsorise sur les plateformes chinoises est soumis a la reglementation publicitaire. RedNote impose des mentions de divulgation claires. Douyin signale les promotions non declarees. Nous veillons a ce que chaque contenu de KOL respecte les exigences des plateformes et se conforme aux regles publicitaires en vigueur.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Suivi de performance</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Chaque campagne est mesuree. Impressions, taux d'engagement, clics, conversions, cout par resultat. Les rapports post-campagne indiquent avec qui continuer, qui ecarter et qui tester la prochaine fois. Nous affinons le mix de createurs sur la base des donnees, pas de l'intuition.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Live commerce</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Pour les marques disposant d'un Douyin Shop, nous organisons des sessions liees directement a vos pages produit. Selection de l'animateur, briefing produit, moderation du chat en direct et reporting post-session. Le modele a la commission signifie que votre risque est en partie partage avec l'animateur.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Gestion des paiements</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Negociation, contrat, paiement, documentation fiscale. Vous nous reglez. Nous nous occupons du reste avec les createurs et leurs MCN. Forfait fixe, commission sur les ventes, echange produit ou formule hybride selon la campagne.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Qu'est-ce qu'un MCN -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Contexte sectoriel">Qu'est-ce qu'un MCN ?</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              MCN signifie Multi-Channel Network. Dans les faits, c'est une agence de talents pour createurs. Les MCN signent des contrats avec des KOL et des KOC, puis gerent leur production de contenu, leurs collaborations avec les marques et leur monetisation.
            </p>
            <p>
              En 2025, on recense environ 29 000 MCN enregistrees sur le marche. Ces structures forment les createurs, produisent leur contenu, gerent les chaines d'approvisionnement du live commerce et assurent la conformite reglementaire. Bon nombre des createurs les plus suivis sur Douyin et RedNote ont ete lances par des MCN.
            </p>
            <p>
              Quand vous voulez travailler avec un KOL de moyenne ou grande envergure, vous negociez presque toujours avec son MCN. Nous collaborons avec les principaux MCN sur Douyin, RedNote et WeChat. Ces relations nous donnent des delais de reponse plus courts, un acces prioritaire a des createurs souvent complets, et des tarifs difficiles a obtenir en demarchant a froid.
            </p>
          </div>
        </div>
        <div class="flex items-center justify-center">
          <img src="/images/ecosystem/influencers.png" alt="Reseau MCN et influenceurs en Chine" class="w-full max-w-[320px]" loading="lazy" />
        </div>
      </div>
    </Container>
  </section>

  <!-- Tarifs indicatifs KOL/KOC — RedNote -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center mb-[48px] max-[640px]:mb-[32px]">
        <div>
          <SectionBar />
          <SectionHeading overline="Tarifs indicatifs">RedNote / Xiaohongshu</SectionHeading>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">
            Les tarifs varient selon le nombre d'abonnes, le taux d'engagement, le format de contenu, la niche et l'exclusivite. Ces fourchettes refletent les benchmarks du T1 2026. Ce ne sont pas des devis.
          </p>
        </div>
        <div class="flex items-center justify-center">
          <img src="/images/platforms/rednote-services/kol-koc.png" alt="Createurs KOL et KOC sur RedNote" class="w-full max-w-[420px] rounded-[10px]" loading="lazy" decoding="async" />
        </div>
      </div>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Nano-KOC (moins de 5K)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">100 a 500 ¥/publication, ou echange produit uniquement. Ideal pour les campagnes de seeding qui construisent une presence dans les resultats de recherche par le volume.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Micro-KOC (5K a 20K)</h3>
