---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import EditorialIndex from '../../components/pages/EditorialIndex.astro';

const SITE_URL = 'https://www.theredscroll.com';

const pages = (await getCollection('industries-fr'))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .map((post) => ({
    href: `/fr/secteurs/${post.id}/`,
    title: post.data.title,
    excerpt: post.data.description,
    category: post.data.category,
    featuredImage: post.data.featuredImage,
    readingTime: `${Math.ceil((post.body || '').split(/\s+/).length / 200)} min`,
    date: new Date(post.data.publishDate).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' }),
  }));

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/fr/secteurs/#collectionpage`,
  name: "Le marketing social en Chine, secteur par secteur",
  url: `${SITE_URL}/fr/secteurs/`,
  description: "Ce qui change, secteur par secteur, quand une marque se lance sur les réseaux sociaux chinois : règles, plateformes, budgets et périmètre d'un accompagnement.",
  isPartOf: { '@id': `${SITE_URL}/#website` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: 'fr',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: pages.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}${p.href}`,
      name: p.title,
    })),
  },
};
---

<PageLayout
  title={"Marketing social en Chine, secteur par secteur | TheRedScroll"}
  description={"Beauté, mode, alimentaire, voyage, B2B, automobile, santé, luxe. Ce que la catégorie change sur WeChat, Xiaohongshu et Douyin."}
  lang="fr"
  schema={collectionSchema}
>
  <EditorialIndex
    lang="fr"
    overline={"Secteurs"}
    heading={"Le secteur commande les règles du jeu."}
    intro={"Règles, plateformes, budget : tout bouge avec le secteur. Une page par catégorie, écrite depuis les comptes que nous pilotons."}
    items={pages}
    emptyText={"Les premières pages sectorielles arrivent. En attendant, indiquez-nous votre secteur : nous vous dirons ce qui change."}
  />
</PageLayout>
