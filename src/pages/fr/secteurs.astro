---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import EditorialIndex from '../../components/pages/EditorialIndex.astro';

const SITE_URL = 'https://www.theredscroll.com';

const pages = (await getCollection('industries-fr'))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .map((post) => ({
    href: `/fr/secteurs/${post.id}/`,
    title: post.data.title,
    excerpt: post.data.description,
    category: post.data.category,
    featuredImage: post.data.featuredImage,
    readingTime: `${Math.ceil((post.body || '').split(/\s+/).length / 200)} min`,
    date: new Date(post.data.publishDate).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' }),
  }));

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/fr/secteurs/#collectionpage`,
  name: "Le marketing social en Chine par secteur",
  url: `${SITE_URL}/fr/secteurs/`,
  description: "Comment le marketing social en Chine fonctionne dans votre secteur : règles, plateformes, budgets et contenu d'un accompagnement.",
  isPartOf: { '@id': `${SITE_URL}/#website` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: 'fr',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: pages.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}${p.href}`,
      name: p.title,
    })),
  },
};
---

<PageLayout
  title={"Marketing social en Chine par secteur | TheRedScroll"}
  description={"Beauté, mode, alimentaire, voyage, B2B, automobile, santé et luxe. Ce qui change sur WeChat, Xiaohongshu et Douyin selon votre catégorie."}
  lang="fr"
  schema={collectionSchema}
>
  <EditorialIndex
    lang="fr"
    overline={"Secteurs"}
    heading={"Votre secteur change les règles du jeu."}
    intro={"Les règles, les plateformes et le budget bougent avec le secteur. Une page par catégorie, écrite à partir des comptes que nous pilotons."}
    items={pages}
    emptyText={"Les premières pages sectorielles arrivent. En attendant, dites-nous votre secteur et nous vous expliquons ce qui change."}
  />
</PageLayout>
