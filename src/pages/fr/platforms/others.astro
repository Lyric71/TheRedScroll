    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.88]" aria-hidden="true"></div>

    <Container class="relative z-[1]">
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <div class="w-[40px] h-[3px] bg-[#CC3333] rounded-none"></div>
        </div>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Pour commencer
        </p>
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF]">
          De zéro à opérationnel sur n'importe quelle plateforme, en deux semaines.
        </h2>
      </div>

      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[24px] max-[640px]:gap-[16px]">
        {steps.map((step) => (
          <div class="bg-[rgba(255,255,255,0.06)] border-[0.5px] border-[rgba(255,255,255,0.1)] rounded-[12px] p-[32px] max-[640px]:p-[20px] text-center">
            <div class="w-[64px] h-[64px] rounded-full bg-[rgba(255,255,255,0.08)] border-[0.5px] border-[rgba(255,255,255,0.15)] flex items-center justify-center mx-auto mb-[20px]">
              <Fragment set:html={step.icon} />
            </div>
            <h3 class="text-[18px] text-[#FFFFFF] font-medium leading-[1.3] mb-[8px]">
              {step.title}
            </h3>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6]">
              {step.description}
            </p>
          </div>
        ))}
      </div>

      <div class="text-center mt-[40px]">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
      </div>

      <!-- Cross-links -->
      <div class="mt-[48px] pt-[24px] border-t border-[rgba(255,255,255,0.1)] text-center">
        <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal mb-[12px]">Voir aussi</p>
        <div class="flex justify-center gap-[24px] flex-wrap">
          <a href="/fr/platforms/wechat" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Marketing WeChat &rarr;</a>
          <a href="/fr/platforms/douyin" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Marketing Douyin &rarr;</a>
          <a href="/fr/platforms/rednote" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Marketing RedNote &rarr;</a>
          <a href="/fr/platforms/weibo" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Marketing Weibo &rarr;</a>
        </div>
      </div>
    </Container>
  </section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .svc-panel {
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .svc-selector:hover {
    background: #F7F2EE !important;
  }
  .faq-content {
    transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  }
  .stat-card {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 1s ease, transform 1s ease;
  }
  .stat-card.revealed {
    opacity: 1;
    transform: translateY(0);
  }
  .stat-card:hover .stat-bg {
    transform: scale(1.08);
  }
  .eco-card:hover .eco-bg {
    transform: scale(1.08);
  }
</style>

<script>
  // Stats horizontal scroll — drag to scroll
  const statsScroll = document.getElementById('stats-scroll');
  if (statsScroll) {
    let isDown = false;
    let startX: number;
    let scrollLeft: number;

    statsScroll.addEventListener('mousedown', (e) => {
      isDown = true;
      statsScroll.style.cursor = 'grabbing';
      startX = e.pageX - statsScroll.offsetLeft;
      scrollLeft = statsScroll.scrollLeft;
    });
    statsScroll.addEventListener('mouseleave', () => { isDown = false; statsScroll.style.cursor = ''; resumeAuto(); });
    statsScroll.addEventListener('mouseup', () => { isDown = false; statsScroll.style.cursor = ''; resumeAuto(); });
    statsScroll.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - statsScroll.offsetLeft;
      statsScroll.scrollLeft = scrollLeft - (x - startX);
    });

    let autoInterval: ReturnType<typeof setInterval>;
    const scrollSpeed = 0.5;

    function startAuto() {
      autoInterval = setInterval(() => {
        if (isDown) return;
        statsScroll!.scrollLeft += scrollSpeed;
        if (statsScroll!.scrollLeft >= statsScroll!.scrollWidth - statsScroll!.clientWidth) {
          statsScroll!.scrollLeft = 0;
        }
      }, 16);
    }

    function pauseAuto() { clearInterval(autoInterval); }
    function resumeAuto() { pauseAuto(); startAuto(); }

    statsScroll.addEventListener('mouseenter', pauseAuto);
    statsScroll.addEventListener('touchstart', pauseAuto);
    statsScroll.addEventListener('touchend', () => { setTimeout(resumeAuto, 2000); });

    startAuto();
  }

  // Stats scroll reveal with stagger + trigger counters
  const statCards = document.querySelectorAll('.stat-card');
  const statsObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const card = entry.target as HTMLElement;
          const index = parseInt(card.dataset.statIndex || '0');
          const delay = index * 150;
          setTimeout(() => {
            card.classList.add('revealed');
            const counter = card.querySelector('.stat-counter') as HTMLElement;
            if (counter) {
              setTimeout(() => {
                animateCounter(counter, counter.dataset.target || '0');
              }, 400);
            }
          }, delay);
          statsObserver.unobserve(card);
        }
      });
    },
    { threshold: 0.05 }
  );
  statCards.forEach((card) => statsObserver.observe(card));

  function animateCounter(el: HTMLElement, target: string) {
    const match = target.match(/^([~]?)([\d.]+)(.*)$/);
    if (!match) { el.textContent = target; return; }

    const prefix = match[1];
    const endNum = parseFloat(match[2]);
    const suffix = match[3];
    const duration = 2000;
    const startTime = performance.now();

    function tick(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = eased * endNum;

      if (endNum >= 10) {
        el.textContent = prefix + Math.round(current) + suffix;
      } else {
        el.textContent = prefix + current.toFixed(1).replace(/\.0$/, '') + suffix;
      }

      if (progress < 1) requestAnimationFrame(tick);
      else el.textContent = target;
    }

    requestAnimationFrame(tick);
  }

  // Service selector — desktop two-column
  const selectors = document.querySelectorAll('[data-svc-select]');
  const panels = document.querySelectorAll('[data-svc-panel]');
  let activeIndex = 0;
  let isAnimating = false;

  selectors.forEach((sel) => {
    sel.addEventListener('click', () => {
      const index = parseInt((sel as HTMLElement).dataset.svcSelect || '0');
      if (index === activeIndex || isAnimating) return;
      isAnimating = true;

      selectors.forEach((s) => {
        const el = s as HTMLElement;
        el.style.background = 'transparent';
        const ind = el.querySelector('.svc-sel-indicator') as HTMLElement;
        const ico = el.querySelector('.svc-sel-icon') as HTMLElement;
        const lbl = el.querySelector('.svc-sel-label') as HTMLElement;
        if (ind) ind.style.opacity = '0';
        if (ico) { ico.style.background = 'transparent'; ico.style.color = '#5C5C5C'; }
        if (lbl) lbl.style.color = '#5C5C5C';
      });

      const active = sel as HTMLElement;
      active.style.background = '#F7F2EE';
      const ind = active.querySelector('.svc-sel-indicator') as HTMLElement;
      const ico = active.querySelector('.svc-sel-icon') as HTMLElement;
      const lbl = active.querySelector('.svc-sel-label') as HTMLElement;
      if (ind) ind.style.opacity = '1';
      if (ico) { ico.style.background = '#E8E0D8'; ico.style.color = '#CC3333'; }
      if (lbl) lbl.style.color = '#1A1A1A';

      const oldPanel = panels[activeIndex] as HTMLElement;
      const newPanel = panels[index] as HTMLElement;
      const goingDown = index > activeIndex;

      oldPanel.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      oldPanel.style.opacity = '0';
      oldPanel.style.transform = goingDown ? 'translateY(-20px)' : 'translateY(20px)';

      setTimeout(() => {
        oldPanel.style.display = 'none';
        oldPanel.style.transform = '';
        oldPanel.style.transition = '';

        newPanel.style.opacity = '0';
        newPanel.style.transform = goingDown ? 'translateY(20px)' : 'translateY(-20px)';
        newPanel.style.display = '';

        requestAnimationFrame(() => {
          newPanel.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
          newPanel.style.opacity = '1';
          newPanel.style.transform = 'translateY(0)';

          setTimeout(() => {
            newPanel.style.transition = '';
            activeIndex = index;
            isAnimating = false;
          }, 350);
        });
      }, 280);
    });
  });

  // Ecosystem cards — tilt on hover
  document.querySelectorAll('[data-tilt-eco]').forEach((card) => {
    const el = card as HTMLElement;
    el.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -3;
      const rotateY = ((x - centerX) / centerX) * 3;
      el.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
    });
    el.addEventListener('mouseleave', () => {
      el.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)';
    });
  });

  // FAQ accordion
  document.querySelectorAll('[data-faq]').forEach((item) => {
    const trigger = item.querySelector('[data-faq-trigger]') as HTMLButtonElement;
    const content = item.querySelector('.faq-content') as HTMLElement;
    if (!trigger || !content) return;

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        content.style.height = content.scrollHeight + 'px';
        requestAnimationFrame(() => {
          content.style.height = '0';
          content.style.opacity = '0';
        });
        trigger.setAttribute('aria-expanded', 'false');
        const ch = trigger.querySelector('.faq-chevron') as HTMLElement;
        if (ch) ch.style.transform = 'rotate(0deg)';
      } else {
        content.style.height = '0';
        requestAnimationFrame(() => {
          content.style.height = content.scrollHeight + 'px';
          content.style.opacity = '1';
        });
        trigger.setAttribute('aria-expanded', 'true');
        const ch = trigger.querySelector('.faq-chevron') as HTMLElement;
        if (ch) ch.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
</PageLayout>
