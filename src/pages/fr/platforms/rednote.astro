---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const stats = [
  { label: 'Utilisateurs actifs mensuels', value: '350M+', image: '/images/platforms/rednote-stats/monthly-active-users.png' },
  { label: 'Vues de publications par jour', value: '9.12B', image: '/images/platforms/rednote-stats/daily-post-views.png' },
  { label: 'Recherches mensuelles', value: '1B+', image: '/images/platforms/rednote-stats/monthly-search-queries.png' },
  { label: 'Utilisateurs de 18 a 35 ans', value: '70%', image: '/images/platforms/rednote-stats/users-aged-18-35.png' },
  { label: 'Contenu genere par les utilisateurs', value: '90%', image: '/images/platforms/rednote-stats/user-generated-content.png' },
  { label: 'Taux de conversion pour les marques internationales', value: '21.4%', image: '/images/platforms/rednote-stats/conversion-rate.png' },
  { label: 'Temps moyen quotidien par utilisateur', value: '55 min', image: '/images/platforms/rednote-stats/daily-time-per-user.png' },
  { label: 'Utilisateurs cherchant des conseils d\'achat chaque mois', value: '200M+', image: '/images/platforms/rednote-stats/purchase-advice-users.png' },
];

const whyEssential = [
  {
    title: 'Le moteur de decision d\'achat en Chine',
    description: 'Plus de 60 % des utilisateurs commencent par la barre de recherche pour trouver des avis et des recommandations. RedNote est la premiere etape avant tout achat.',
    image: '/images/platforms/rednote-why/purchase-decision.png',
  },
  {
    title: 'La confiance conditionne la visibilite',
    description: 'L\'algorithme recompense le contenu authentique et penalise la publicite agressive. Les sauvegardes et les commentaires comptent davantage que les mentions "j\'aime".',
    image: '/images/platforms/rednote-why/trust-distribution.png',
  },
  {
    title: 'Une audience a fort pouvoir d\'achat',
    description: 'Jeune, urbaine, aisee. Villes de rang 1 et 2. Prete a investir dans la qualite.',
    image: '/images/platforms/rednote-why/spending-power.png',
  },
  {
    title: 'Le commerce social est natif',
    description: 'Decouvrir, evaluer, tester, acheter. Tout se passe dans l\'application.',
    image: '/images/platforms/rednote-why/social-commerce.png',
  },
];

const algorithm = [
  {
    title: 'Distribution par paliers',
    description: 'Les nouvelles publications touchent d\'abord 100 a 500 utilisateurs test. Un fort engagement dans les 24 premieres heures propulse le contenu vers des milliers, puis des centaines de milliers de vues.',
    image: '/images/platforms/rednote-algorithm/staged-distribution.png',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  },
  {
    title: 'Score CES',
    description: 'Abonnements (8 pts), commentaires et partages (4 pts chacun), mentions "j\'aime" et sauvegardes (1 pt chacun). C\'est l\'engagement profond qui fait monter. Les "j\'aime" seuls ne suffisent pas.',
    image: '/images/platforms/rednote-algorithm/ces-scoring.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
  },
  {
    title: 'Authenticite imposee',
    description: 'Le contenu trop commercial, les faux avis et les comportements automatises sont penalises. Publier regulierement du contenu de qualite augmente la visibilite dans la duree.',
    image: '/images/platforms/rednote-algorithm/authenticity-enforced.png',
    bg: '#CC3333',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: 'Double moteur',
    description: 'Chaque note entre en competition pour le fil Explorer (recommandations) et le trafic Recherche (intention). Il faut optimiser les deux.',
    image: '/images/platforms/rednote-algorithm/dual-engine.png',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
  },
];

const services = [
  {
    title: 'Creation de compte et verification',
    description: 'Inscription au Compte Professionnel (Blue V), traduction de licence commerciale, documentation de marque, conformite plateforme. On s\'occupe de l\'administratif pour que vous n\'ayez pas a attendre.',
    result: 'Un compte RedNote verifie, actif et pret a publier.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/rednote-services/account-setup.png',
  },
  {
    title: 'Strategie et production de contenu',
    description: 'Piliers editoriaux, calendrier de publication, formats adaptes a la plateforme. Visuels AIGC produits via HubStudio.ai. Tournages en conditions reelles en Chine. Redaction en chinois natif et adaptation culturelle.',
    result: 'Du contenu concu pour le fonctionnement reel de RedNote, pas un recyclage d\'Instagram.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
    image: '/images/platforms/rednote-services/content-strategy.png',
  },
  {
    title: 'Campagnes KOL et KOC',
    description: 'Service complet via la plateforme officielle Pugongying de RedNote. Sourcing d\'influenceurs, detection de faux abonnes, co-creation de contenu, reporting ROI.',
    result: 'Des partenariats avec des influenceurs verifies et des donnees de performance transparentes.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    image: '/images/platforms/rednote-services/kol-koc.png',
  },
  {
    title: 'Publicite payante',
    description: 'In-Feed Ads, Search Ads, gestion complete Juguang, Juguang Lite, Chengfeng pour le e-commerce. Tests creatifs, optimisation des encheres, ajustements en temps reel. Budget publicitaire facture separement. Sans majoration.',
    result: 'Des publicites qui atteignent la bonne audience avec un reporting de depenses transparent.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/rednote-services/paid-advertising.png',
  },
  {
    title: 'E-commerce et live commerce',
    description: 'Configuration de boutique in-app, notes interactives avec liens d\'achat, production de sessions live. Le live commerce represente 90 % des ventes realisees directement sur RedNote.',
    result: 'Une vitrine au sein de RedNote ou le contenu mene directement a l\'achat.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
    image: '/images/platforms/rednote-services/ecommerce-live.png',
  },
  {
    title: 'Analytique et veille sociale',
    description: 'Tableaux de bord de croissance, engagement, classement dans les recherches, ROI des campagnes. Surveillance de marque, analyse de sentiment, detection de tendances, suivi concurrentiel.',
    result: 'Des rapports clairs sur ce qui fonctionne et ce qui doit etre ajuste.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
    image: '/images/platforms/rednote-services/analytics-listening.png',
  },
];

const bestPractices = [
  {
    title: 'Ecrivez pour RedNote, pas pour Instagram.',
    description: 'Les notes detaillees, pratiques et fondees sur l\'experience fonctionnent le mieux. Tutoriels, avis honnetes et guides pas a pas surpassent les campagnes de marque trop polies.',
  },
  {
    title: 'Soignez l\'image de couverture et le titre.',
    description: 'Ce sont eux qui determinent si l\'utilisateur clique. Des titres clairs, axes sur le benefice, avec des mots-cles pertinents. Des images de couverture nettes, avec du texte superpose.',
  },
  {
    title: 'Optimisez pour la recherche.',
    description: 'RedNote est un moteur de recherche. Utilisez les mots-cles tendance, redigez des titres qui correspondent aux requetes des utilisateurs et servez-vous de l\'outil de recommandation de hashtags integre a la plateforme.',
  },
  {
    title: 'Encouragez les sauvegardes et les commentaires.',
    description: 'Terminez vos notes par une question ou une raison de mettre en favori. Sauvegardes et commentaires alimentent le score CES qui controle la distribution.',
  },
  {
    title: 'Restez dans la plateforme.',
    description: 'RedNote penalise les liens externes. Gardez les utilisateurs dans l\'application. Les boutiques in-app et les parcours internes sont plus performants que les redirections.',
  },
  {
    title: 'Publiez de facon reguliere.',
    description: 'Les comptes actifs depuis plus de 180 jours consecutifs beneficient d\'un bonus de visibilite. Choisissez vos piliers editoriaux. Tenez-vous-y.',
  },
];

const industries = [
  { title: 'Beaute et cosmetiques', description: 'La categorie la plus populaire. Avis, tutoriels, analyses d\'ingredients.' },
  { title: 'Mode et habillement', description: 'Conseils de style, tendances, lookbooks saisonniers, seeding KOC.' },
  { title: 'Luxe', description: 'Contenu narratif pour une audience aisee a forte intention d\'achat.' },
  { title: 'Alimentation et boissons', description: 'Critiques de restaurants, recettes, degustations de produits.' },
  { title: 'Voyage et hotellerie', description: 'Guides de destination, avis d\'hotels. 64 % des voyageurs chinois utilisent RedNote pour planifier leurs voyages.' },
  { title: 'Sante et bien-etre', description: 'Fitness, complements alimentaires, conseils sante. Secteur en forte croissance.' },
  { title: 'B2B', description: 'RedNote couvre plus de 100 secteurs professionnels. Les decideurs y recherchent fournisseurs et prestataires.' },
];

const steps = [
  {
    number: '01',
    title: 'Appel decouverte.',
    description: 'Votre marque, vos objectifs, votre etat de preparation pour la Chine. Pas de presentation commerciale. Juste les bonnes questions.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Proposition.',
    description: 'Perimetre defini. Prix fixe. Chaque livrable detaille. Vous voyez ce que vous obtenez et ce que cela coute avant de vous engager.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'En ligne en 2 semaines.',
    description: 'Creation du compte, strategie de contenu, premieres notes publiees. Quatorze jours entre la signature du contrat et la mise en ligne de votre premier post.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  {
    q: 'Ou est basee votre equipe ?',
    a: 'A Shanghai et Hong Kong. Des locuteurs natifs chinois avec un acces en temps reel a chaque grande plateforme. Nous publions sur RedNote tous les jours, gerons des comptes publicitaires depuis l\'interieur de l\'ecosysteme et travaillons directement avec des KOL a travers le pays. Ce n\'est pas du conseil a distance. Nous sommes sur le terrain.',
  },
  {
    q: 'Notre marque peut-elle acceder a RedNote sans entite chinoise ?',
    a: 'Oui. RedNote permet aux entreprises etrangeres d\'ouvrir un Compte Professionnel (Blue V) avec une licence commerciale traduite et des documents de marque. Nous prenons en charge les formalites, la soumission a la plateforme et les echanges avec l\'equipe de validation de RedNote. La plupart des comptes sont actifs en moins de deux semaines.',
  },
  {
    q: 'Au bout de combien de temps voit-on des resultats ?',
    a: 'RedNote ne recompense pas l\'impatience. Les nouveaux comptes passent par une phase d\'observation algorithmique. Les 2 a 3 premiers mois servent donc a construire votre bibliotheque de contenu et a former l\'algorithme sur votre categorie. La publicite payante et les campagnes KOL peuvent generer du trafic des la premiere semaine, le temps que la croissance organique prenne le relais.',
  },
  {
    q: 'Que recevons-nous exactement chaque mois ?',
    a: 'Tout est detaille avant la signature. Publications, videos, campagnes publicitaires, activations KOL, rapports. Vous examinez et validez le contenu avant sa mise en ligne. Pas de zone grise. Pas de facture surprise en fin de mois.',
  },
  {
    q: 'Comment fonctionne la tarification ?',
    a: 'Un forfait mensuel fixe couvre l\'ensemble du perimetre convenu. Le budget publicitaire est facture separement au prix coutant, et vous voyez chaque ligne de depense. Nous ne prenons aucune commission sur les achats media. Le montant figurant dans la proposition est celui que vous payez. C\'est aussi simple que cela.',
  },
  {
    q: 'Qui cree le contenu, et qui le verifie ?',
    a: 'La strategie et la redaction sont assurees par notre equipe de Shanghai. Les visuels generes par IA sont produits via HubStudio.ai, entraine specifiquement sur les directives de votre marque. Les tournages photo et video se font sur place en Chine. Avant toute publication, un editeur natif chinois verifie le ton, l\'adequation culturelle et la conformite avec la plateforme.',
  },
  {
    q: 'Comment trouvez-vous les bons KOL pour notre marque ?',
    a: 'Via la plateforme officielle Pugongying de RedNote. Plus de 100 000 influenceurs verifies. Chaque KOL que nous preselectionnons fait l\'objet d\'une verification d\'authenticite de l\'audience, d\'une detection de faux abonnes et d\'une evaluation de la qualite de l\'engagement. Ensuite, nous faisons correspondre niche, style de contenu et budget.',
  },
  {
    q: 'Pouvez-vous diffuser des publicites RedNote pour une entreprise basee hors de Chine ?',
    a: 'Oui, mais il y a une contrainte. La plateforme publicitaire Juguang de RedNote necessite une entite chinoise pour ouvrir un compte. Nous creons et gerons les comptes publicitaires pour le compte de clients etrangers via notre structure locale. Vous recevez des rapports hebdomadaires de depenses avec une visibilite complete sur les performances.',
  },
  {
    q: 'Doit-on s\'engager sur une longue duree ?',
    a: 'L\'engagement minimal est de 3 mois. C\'est le minimum necessaire pour depasser la phase de montee en puissance de l\'algorithme RedNote et collecter suffisamment de donnees de performance pour savoir ce qui fonctionne. La plupart des clients restent plus longtemps une fois que les chiffres commencent a bouger.',
  },
  {
    q: 'Nous ne parlons pas chinois. Est-ce un probleme ?',
    a: 'Non. Toute la communication client se fait en anglais. Appels strategiques, rapports mensuels, validations de contenu, tout. L\'equipe est entierement bilingue. Vous vous concentrez sur votre marque, nous gerons la plateforme en chinois.',
  },
];
---

<PageLayout
  title="Services Marketing RedNote / Xiaohongshu | TheRedScroll"
  description="Nous gerons des comptes RedNote depuis Shanghai. Strategie de contenu, campagnes KOL, publicite payante, e-commerce et analytique. Perimetre fixe, prix fixe."
  lang="fr"
>
  <!-- Hero -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/rednote-hero.png')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/fr/platforms/others" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; Toutes les plateformes
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Marketing RedNote
        </p>
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          La plateforme de decouverte produit en Chine. Plus de 350M d'utilisateurs. Le premier reflexe des consommateurs avant d'acheter.
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          Nous ne parlons pas de RedNote. Nous y publions. Chaque jour. Depuis Shanghai.
        </p>
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
      </div>
    </Container>
  </section>

  <!-- Stats — horizontal scroll strip -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            Pas des chiffres pour impressionner. C'est ici que se prennent les decisions d'achat.
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            RedNote en chiffres.
          </p>
        </div>
        <Button variant="primary" href="/fr/contact" class="shrink-0">Prendre rendez-vous</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>

      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div
              class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none"
              data-stat-index={i}
            >
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why RedNote is essential -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Pourquoi RedNote est incontournable">
          Si votre marque n'est pas sur RedNote, elle est invisible au moment ou les consommateurs decident quoi acheter.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {whyEssential.map((item) => (
          <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
            <div class="w-full aspect-[16/9] overflow-hidden">
              <img src={item.image} alt={item.title} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div class="p-[24px] max-[640px]:p-[20px]">
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">{item.title}</h3>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] mt-[24px] text-center max-w-[680px] mx-auto">
        RedNote (Xiaohongshu) est l'endroit ou les consommateurs chinois se renseignent sur les produits, comparent les marques et prennent leurs decisions d'achat. Contenu social, confiance communautaire et commerce in-app reunis sur une seule plateforme.
      </p>
    </Container>
  </section>

  <!-- How the algorithm works — ServicesGrid-style cards -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
