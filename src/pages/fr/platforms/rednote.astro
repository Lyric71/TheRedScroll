---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import UpdatedDate from '../../../components/ui/UpdatedDate.astro';

const stats = [
  { label: 'Utilisateurs actifs chaque mois', value: '350M+', image: '/images/platforms/rednote-stats/monthly-active-users.png' },
  { label: 'Vues de notes par jour', value: '9.12B', image: '/images/platforms/rednote-stats/daily-post-views.png' },
  { label: 'Recherches effectuées chaque mois', value: '1B+', image: '/images/platforms/rednote-stats/monthly-search-queries.png' },
  { label: 'Des utilisateurs ont entre 18 et 35 ans', value: '70%', image: '/images/platforms/rednote-stats/users-aged-18-35.png' },
  { label: 'Du contenu créé par les utilisateurs eux-mêmes', value: '90%', image: '/images/platforms/rednote-stats/user-generated-content.png' },
  { label: 'Taux de conversion pour les marques étrangères', value: '21.4%', image: '/images/platforms/rednote-stats/conversion-rate.png' },
  { label: 'Minutes passées sur la plateforme chaque jour', value: '55 min', image: '/images/platforms/rednote-stats/daily-time-per-user.png' },
  { label: 'Utilisateurs en quête de conseils d\'achat chaque mois', value: '200M+', image: '/images/platforms/rednote-stats/purchase-advice-users.png' },
];

const whyEssential = [
  {
    title: 'Là où les Chinois prennent leurs décisions d\'achat',
    description: 'Plus de 60 % des utilisateurs ouvrent la barre de recherche en premier. Ils cherchent des avis, des retours d\'expérience. RedNote, c\'est leur premier réflexe avant d\'acheter.',
    image: '/images/platforms/rednote-why/purchase-decision.png',
  },
  {
    title: 'La confiance avant tout le reste',
    description: 'L\'algorithme prime l\'authenticité et pénalise la pub déguisée. Une sauvegarde ou un commentaire pèse infiniment plus qu\'un simple "j\'aime".',
    image: '/images/platforms/rednote-why/trust-distribution.png',
  },
  {
    title: 'Une audience qui a les moyens de ses envies',
    description: 'Jeune, urbaine, aisée. Concentrée dans les villes de rang 1 et 2. Elle sait ce qu\'elle veut et elle a de quoi payer.',
    image: '/images/platforms/rednote-why/spending-power.png',
  },
  {
    title: 'Du contenu à l\'achat, sans sortir de l\'appli',
    description: 'Découvrir, comparer, tester, acheter. Tout le parcours se déroule à l\'intérieur. Aucune redirection, aucune friction.',
    image: '/images/platforms/rednote-why/social-commerce.png',
  },
];

const algorithm = [
  {
    title: 'Une diffusion par paliers',
    description: 'Chaque nouvelle note est d\'abord exposée à 100 à 500 utilisateurs. Si l\'engagement décolle dans les 24 heures, la plateforme élargit la diffusion, par vagues successives, jusqu\'à des centaines de milliers de vues.',
    image: '/images/platforms/rednote-algorithm/staged-distribution.png',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  },
  {
    title: 'Le score CES',
    description: 'Un abonnement vaut 8 points. Un commentaire ou un partage, 4. Un "j\'aime" ou une sauvegarde, 1. Ce qui compte, c\'est l\'engagement profond. Accumuler des "j\'aime" ne mène nulle part.',
    image: '/images/platforms/rednote-algorithm/ces-scoring.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
  },
  {
    title: 'L\'authenticité comme règle du jeu',
    description: 'Contenu trop commercial, faux avis, automatisation : la plateforme sanctionne sans prévenir. La seule visibilité qui tient dans le temps, c\'est celle que l\'on construit note après note, avec rigueur.',
    image: '/images/platforms/rednote-algorithm/authenticity-enforced.png',
    bg: '#CC3333',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: 'Deux moteurs, une seule stratégie',
    description: 'Chaque note travaille sur deux fronts : le fil Explorer qui recommande et la Recherche qui capte l\'intention d\'achat. L\'un nourrit l\'autre. On ne choisit pas entre les deux.',
    image: '/images/platforms/rednote-algorithm/dual-engine.png',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
  },
];

const services = [
  {
    title: 'Ouverture et vérification du compte',
    description: 'Inscription au Compte Professionnel (Blue V), traduction de la licence commerciale, constitution du dossier de marque, mise en conformité. Nous prenons en charge l\'ensemble des formalités, vous épargnant plusieurs mois de délai.',
    result: 'Un compte RedNote vérifié, actif et prêt à publier.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/rednote-services/account-setup.png',
  },
  {
    title: 'Stratégie et production éditoriale',
    description: 'Piliers éditoriaux, calendrier de parution, formats conçus pour la plateforme. Visuels produits avec HubStudio.ai. Tournages en Chine. Rédaction en mandarin par des natifs, avec une adaptation culturelle véritable.',
    result: 'Du contenu pensé pour la mécanique de RedNote, pas pour Instagram.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
    image: '/images/platforms/rednote-services/content-strategy.png',
  },
  {
    title: 'Campagnes KOL et KOC',
    description: 'Prise en charge complète via Pugongying, la régie officielle de RedNote. Sélection des créateurs, détection des faux abonnés, co-création de contenu, reporting précis du ROI.',
    result: 'Des collaborations avec des créateurs vérifiés et des résultats sans zone d\'ombre.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    image: '/images/platforms/rednote-services/kol-koc.png',
  },
  {
    title: 'Publicité payante',
    description: 'In-Feed Ads, Search Ads, pilotage complet de Juguang, Juguang Lite et Chengfeng côté e-commerce. Tests créatifs, ajustement des enchères, arbitrages en temps réel. Le budget média est facturé à part, au prix coûtant.',
    result: 'Des campagnes ciblées, avec un reporting de dépenses à livre ouvert.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/rednote-services/paid-advertising.png',
  },
  {
    title: 'E-commerce et live commerce',
    description: 'Mise en place de la boutique in-app, notes interactives avec liens d\'achat, production des sessions en direct. Le live commerce représente 90 % des ventes réalisées sans quitter RedNote.',
    result: 'Une boutique intégrée à RedNote, où chaque note conduit l\'utilisateur jusqu\'au panier.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
    image: '/images/platforms/rednote-services/ecommerce-live.png',
  },
  {
    title: 'Analytique et veille',
    description: 'Tableaux de bord sur la croissance, l\'engagement, le positionnement dans les recherches et le ROI des campagnes. Surveillance de marque, analyse de sentiment, détection de tendances, lecture du terrain concurrentiel.',
    result: 'Des rapports nets sur ce qui fonctionne, et sur ce qui demande à être corrigé.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
    image: '/images/platforms/rednote-services/analytics-listening.png',
  },
];

const bestPractices = [
  {
    title: 'Écrivez pour RedNote, pas pour Instagram.',
    description: 'Les notes denses, utiles, ancrées dans le vécu sortent du lot. Tutoriels, avis honnêtes et guides pratiques écrasent les campagnes de marque trop polies.',
  },
  {
    title: 'Soignez la couverture et le titre.',
    description: 'Tout se joue dans les premières secondes. Titre clair, orienté bénéfice, avec les mots-clés qui comptent. Visuel propre, texte en surimpression lisible.',
  },
  {
    title: 'Pensez moteur de recherche.',
    description: 'RedNote se comporte comme Google pour les achats. Repérez les mots-clés en hausse, calquez vos titres sur les vraies requêtes, exploitez l\'outil de suggestion de hashtags natif.',
  },
  {
    title: 'Provoquez les sauvegardes et les commentaires.',
    description: 'Terminez chaque note par une question ou une raison de la mettre en favori. Ces deux actions nourrissent le score CES qui commande la diffusion.',
  },
  {
    title: 'Restez dans l\'appli.',
    description: 'RedNote pénalise les liens sortants. Maintenez l\'utilisateur à l\'intérieur. Une boutique in-app convertit bien mieux qu\'une redirection vers un site externe.',
  },
  {
    title: 'Tenez la cadence.',
    description: 'Au-delà de 180 jours d\'activité continue, la plateforme accorde un bonus de visibilité. Définissez vos piliers éditoriaux, puis publiez sans vous arrêter.',
  },
];

const industries = [
  { title: 'Beauté et cosmétiques', description: 'La catégorie dominante de la plateforme. Avis produits, tutoriels de maquillage, décryptage d\'ingrédients.' },
  { title: 'Mode et prêt-à-porter', description: 'Conseils de style, tendances du moment, lookbooks saisonniers, campagnes de seeding KOC.' },
  { title: 'Luxe', description: 'Récits de marque ciselés pour une audience aisée, souvent à un pas de passer à l\'achat.' },
  { title: 'Alimentation et boissons', description: 'Critiques de restaurants, recettes, dégustations filmées en direct.' },
  { title: 'Voyage et hôtellerie', description: 'Guides de destination, avis d\'hôtels. 64 % des voyageurs chinois préparent leur séjour sur RedNote.' },
  { title: 'Santé et bien-être', description: 'Fitness, compléments, conseils santé. L\'un des secteurs qui progresse le plus vite.' },
  { title: 'B2B', description: 'Plus de 100 filières professionnelles représentées sur RedNote. Les décideurs s\'en servent pour identifier fournisseurs et prestataires.' },
];

const steps = [
  {
    number: '01',
    title: 'Appel de cadrage.',
    description: 'Nous discutons de votre marque, de vos objectifs, de votre niveau de préparation au marché chinois. Aucun discours commercial, uniquement les questions qui comptent.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Proposition commerciale.',
    description: 'Périmètre arrêté, tarif ferme, chaque livrable détaillé noir sur blanc. Avant la signature, vous savez précisément ce que vous obtenez et ce que cela vous coûtera.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'En ligne sous 2 semaines.',
    description: 'Compte ouvert, stratégie posée, premières notes publiées. Quinze jours séparent la signature de votre toute première publication.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  {
    q: 'Où se trouve votre équipe ?',
    a: 'À Shanghai et à Hong Kong. Des rédacteurs chinois natifs, connectés en permanence aux grandes plateformes. Nous publions sur RedNote chaque jour, pilotons les comptes publicitaires depuis l\'intérieur et travaillons directement avec des KOL partout en Chine. Ce n\'est pas du conseil à distance.',
  },
  {
    q: 'Peut-on être présent sur RedNote sans entité juridique en Chine ?',
    a: 'Oui. RedNote permet aux entreprises étrangères d\'ouvrir un Compte Professionnel (Blue V) sur la base d\'une licence commerciale traduite et d\'un dossier de marque. Nous prenons en charge les formalités, le dépôt sur la plateforme et les échanges avec l\'équipe de validation de RedNote. La plupart des comptes sont actifs en moins de deux semaines.',
  },
  {
    q: 'Au bout de combien de temps les résultats arrivent-ils ?',
    a: 'RedNote ne récompense pas la précipitation. Chaque nouveau compte passe d\'abord par une phase d\'observation algorithmique. Les deux ou trois premiers mois permettent de construire votre catalogue de contenus et d\'apprendre à la plateforme qui vous êtes. La publicité payante et les campagnes KOL, elles, peuvent générer du trafic dès la première semaine, le temps que la croissance organique prenne le relais.',
  },
  {
    q: 'Que recevons-nous concrètement chaque mois ?',
    a: 'Tout est contractualisé avant la signature. Notes, vidéos, campagnes publicitaires, activations KOL, rapports mensuels. Vous relisez et validez chaque contenu avant sa mise en ligne. Pas de zone grise. Pas de mauvaise surprise en fin de mois.',
  },
  {
    q: 'Comment fonctionne la tarification ?',
    a: 'Un forfait mensuel fixe couvre l\'ensemble du périmètre convenu. Le budget média est facturé séparément, au prix coûtant, avec chaque ligne de dépense visible. Nous ne prenons aucune commission sur les achats média. Le montant de la proposition est le montant que vous payez.',
  },
  {
    q: 'Qui produit le contenu, et qui en assure le contrôle ?',
    a: 'La stratégie et la rédaction sont assurées par notre équipe de Shanghai. Les visuels générés par IA passent par HubStudio.ai, entraîné sur les lignes directrices de votre marque. Les prises de vue photo et vidéo sont réalisées en Chine. Avant chaque publication, un éditeur natif vérifie le contenu : ton, pertinence culturelle, conformité à la plateforme.',
  },
  {
    q: 'Comment sélectionnez-vous les KOL pour notre marque ?',
    a: 'Via Pugongying, la régie officielle de RedNote, qui référence plus de 100 000 créateurs vérifiés. Chaque KOL présélectionné fait l\'objet d\'une vérification d\'audience, d\'une détection de faux abonnés et d\'une évaluation de la qualité de l\'engagement. Nous croisons ensuite niche, ligne éditoriale et budget.',
  },
  {
    q: 'Pouvez-vous activer de la publicité RedNote pour une entreprise basée hors de Chine ?',
    a: 'Oui, sous une condition. La régie Juguang de RedNote requiert une entité juridique chinoise pour ouvrir un compte publicitaire. Nous créons et pilotons ces comptes pour le compte de nos clients étrangers via notre structure locale. Vous recevez un rapport hebdomadaire et une visibilité totale sur les performances.',
  },
  {
    q: 'Quelle est la durée minimale d\'engagement ?',
    a: 'Trois mois. C\'est le temps nécessaire pour traverser la phase de rodage de l\'algorithme et accumuler assez de données pour comprendre ce qui fonctionne. La plupart des clients prolongent dès que les premières courbes commencent à bouger.',
  },
  {
    q: 'Nous ne parlons pas chinois. Est-ce un problème ?',
    a: 'Non. Toute la relation client se déroule en anglais : appels stratégiques, rapports mensuels, validations de contenu. L\'équipe est entièrement bilingue. Vous vous concentrez sur votre marque, nous nous occupons de la plateforme.',
  },
];
---

<PageLayout
  title="Agence marketing RedNote / Xiaohongshu | TheRedScroll"
  description="TheRedScroll pilote des comptes RedNote depuis Shanghai. Stratégie éditoriale, campagnes KOL, publicité payante, e-commerce, analytique. Périmètre clair, prix ferme."
  lang="fr"
>
  <!-- Hero -->
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/rednote-hero.png')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/fr/platforms/others/" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; Toutes les plateformes
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Marketing RedNote
        </p>
        <UpdatedDate lang="fr" date="mai 2026" variant="light" class="mb-[8px]" />
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          La plateforme chinoise de la découverte produit. 350 millions d'utilisateurs. Le premier réflexe à l'approche de chaque achat.
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.85)] font-normal leading-[1.6] mb-[12px]">
          RedNote, connu en chinois sous le nom de Xiaohongshu (小红书 / Little Red Book), est la plateforme de social commerce où les consommateurs chinois se renseignent avant d'acheter. 70 % des utilisateurs ont entre 18 et 35 ans, vivent dans les villes de premier et de deuxième rang et disposent d'un pouvoir d'achat supérieur à la moyenne.
        </p>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          Nous n'observons pas RedNote depuis l'extérieur. Nous y publions chaque jour, depuis Shanghai.
        </p>
        <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
      </div>
    </Container>
  </section>

  <!-- Stats — horizontal scroll strip -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            Ce ne sont pas des chiffres pour impressionner. C'est là que les décisions d'achat se prennent.
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            RedNote en chiffres.
          </p>
        </div>
        <Button variant="primary" href="/fr/contact/" class="shrink-0">Prendre rendez-vous</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>

      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div
              class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none"
              data-stat-index={i}
            >
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why RedNote is essential -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Pourquoi RedNote est incontournable">
          Sans présence sur RedNote, votre marque est absente au moment précis où le consommateur chinois décide ce qu'il va acheter.
        </SectionHeading>
