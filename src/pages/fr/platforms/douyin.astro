const faqs = [
  {
    q: 'Qui pilote notre compte au quotidien ?',
    a: 'Notre équipe basée en Chine. Des rédacteurs chinois natifs qui produisent du contenu et pilotent des campagnes publicitaires sur Douyin tous les jours. Vous avez un responsable de compte dédié, qui connaît votre marque sur le bout des doigts.',
  },
