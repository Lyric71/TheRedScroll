  { label: 'Temps passé chaque jour, par personne', value: '120 min', image: '/images/platforms/douyin-stats/daily-time.png' },
  { label: 'Volume e-commerce annuel (2024)', value: '¥3.5T', image: '/images/platforms/douyin-stats/ecommerce-sales.png' },
  { label: 'Progression des ventes sur un an', value: '34%', image: '/images/platforms/douyin-stats/yoy-growth.png' },
  { label: 'Lives marchands diffusés chaque jour', value: '30M+', image: '/images/platforms/douyin-stats/live-commerce.png' },
  { label: 'Catégories de contenu recensées', value: '100+', image: '/images/platforms/douyin-stats/content-variety.png' },
