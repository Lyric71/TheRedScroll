---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 567, decimals: 0, suffix: 'M', label: 'utilisateurs actifs chaque mois' },
  { value: 140, decimals: 0, suffix: '', label: 'caractères affichés avant le repli du post' },
  { value: 2, decimals: 0, suffix: ' semaines', label: 'de la signature à la première publication' },
  { value: 6, decimals: 0, suffix: '', label: 'prestations réunies dans un seul périmètre de travail' },
];

const scopeItems = [
  { label: 'Compte entreprise et vérification Blue V', href: '/fr/platforms/weibo/' },
  { label: 'Contenus écrits en chinois par des rédacteurs natifs', href: '/fr/services/content-production/' },
  { label: 'Publicité Fan Headlines, Fan Tunnel, display et recherche', href: '/fr/services/advertising/' },
  { label: 'Campagnes KOL et célébrités sur données vérifiées', href: '/fr/services/influencer-marketing/' },
  { label: 'Opérations Hot Search et Super Topic', href: '/fr/platforms/weibo/' },
];

const services = [
  {
    glyph: '号',
    title: 'Ouverture de compte et vérification Blue V',
    tag: 'Badge obtenu en deux à quatre semaines',
    description:
      'Nous enregistrons votre compte entreprise, faisons traduire vos statuts en chinois et suivons la vérification jusqu’au badge. Weibo facture aux sociétés étrangères des frais uniques de 1 000 dollars. Comptez deux à quatre semaines d’instruction. Nous prenons tout en charge.',
    deliverables: ['Compte entreprise', 'Traduction du dossier', 'Vérification Blue V', 'Habillage du profil'],
    image: '/images/platforms/weibo-services/account-setup.webp',
    imageAlt: 'Téléphone présentant un profil entreprise Weibo vérifié avec badge Blue V, posé près de documents d’immatriculation',
  },
  {
    glyph: '文',
    title: 'Stratégie éditoriale et rédaction en chinois',
    tag: 'Écrit par des rédacteurs chinois',
    description:
      'Plan éditorial mensuel, posts quotidiens, carrousels en grille de neuf, vidéos courtes. Le tout rédigé en chinois par des natifs, jamais traduit. Passé 140 caractères, un post se replie. Tout se joue donc sur la première phrase.',
    deliverables: ['Plan éditorial mensuel', 'Posts quotidiens', 'Carrousels en grille de neuf', 'Vidéos courtes'],
    image: '/images/platforms/weibo-services/content-strategy.webp',
    imageAlt: 'Poste de travail éditorial, téléphone affichant un post Weibo de marque avec carrousel photo en grille de neuf',
  },
  {
    glyph: '广',
    title: 'Publicité payante sur Weibo',
    tag: 'Média refacturé au coût réel',
    description:
      'Fan Headlines (粉丝头条), Fan Tunnel (粉丝通), display dans le fil, écrans d’ouverture, promotion de la recherche et des hashtags. Le ciblage croise profil, centres d’intérêt et comportement. Le budget média vous est refacturé au coût réel, sans la moindre marge.',
    deliverables: ['Fan Headlines', 'Fan Tunnel', 'Display et écrans d’ouverture', 'Promotion de la recherche'],
    image: '/images/platforms/weibo-services/paid-advertising.webp',
    imageAlt: 'Main tenant un téléphone où s’affiche un post de marque sponsorisé dans le fil public Weibo',
  },
  {
    glyph: '达',
    title: 'Campagnes KOL et influence',
    tag: 'Engagement vérifié, rien d’autre',
    description:
      'Repérage des KOL, audit, briefs, négociation, bilan. Avant toute recommandation, nous mesurons l’engagement réel et débusquons les abonnés factices. Un compteur d’abonnés, aussi haut soit-il, ne qualifie personne.',
    deliverables: ['Repérage des KOL', 'Audit et briefs', 'Négociation', 'Bilan de campagne'],
    image: '/images/platforms/weibo-services/kol-campaigns.webp',
    imageAlt: 'Créateur filmant une vidéo produit, téléphone affichant un post KOL Weibo et ses statistiques d’engagement',
  },
  {
    glyph: '评',
    title: 'Animation de communauté et relation client',
    tag: 'Surveillance quotidienne',
    description:
      'Sur Weibo, tout se joue dans les commentaires. Nous y répondons, traitons les messages privés et suivons chaque jour les mentions de la marque. Le moindre glissement de sentiment vous est signalé avant qu’il ne dégénère.',
    deliverables: ['Réponses aux commentaires', 'Messages privés', 'Veille des mentions', 'Alertes de sentiment'],
    image: '/images/platforms/weibo-ecosystem/community.webp',
    imageAlt: 'Téléphone montrant une file de commentaires active sous un post de marque Weibo, avec les réponses du compte vérifié',
  },
  {
    glyph: '数',
    title: 'Mesure et bilan mensuel',
    tag: 'Un bilan rédigé en anglais clair',
    description:
      'Croissance des abonnés, engagement par format, résultats média (CPM, CPC, CPA, ROAS), retombées KOL, repères concurrentiels. Chaque bilan s’achève sur des recommandations concrètes pour le mois suivant, formulées en anglais clair.',
    deliverables: ['Croissance et engagement', 'Résultats média', 'Retombées KOL', 'Repères concurrentiels'],
    image: '/images/platforms/weibo-services/analytics.webp',
    imageAlt: 'Ordinateur portable ouvert sur un tableau de bord Weibo, courbes de croissance et d’engagement à l’écran',
  },
];

const platformRows = [
  {
    platform: 'Weibo',
    href: '/fr/platforms/weibo/',
    bestFor: 'Notoriété de masse, relations presse, sujets tendance',
    style: 'Fil public. Posts brefs, hashtags, Hot Search',
    startIf: 'La Chine doit apprendre votre nom, et vite',
  },
  {
    platform: 'WeChat',
    href: '/fr/platforms/wechat/',
    bestFor: 'Fidélisation, CRM, relation client',
    style: 'Cercles fermés. Articles longs, Mini Programs',
    startIf: 'Vos clients chinois existent déjà, il faut les garder',
  },
  {
    platform: 'RedNote',
    href: '/fr/platforms/rednote/',
    bestFor: 'Découverte produit, avis, art de vivre',
    style: 'Guidé par la recherche. Notes photo et vidéo',
    startIf: 'Vos produits se comparent avant de s’acheter',
  },
  {
    platform: 'Douyin',
    href: '/fr/platforms/douyin/',
    bestFor: 'Portée en vidéo courte, live commerce',
    style: 'Fil algorithmique. Vidéos courtes et divertissantes',
    startIf: 'Vous savez produire des vidéos qui retiennent l’attention',
  },
];

const segments = [
  {
    title: 'Luxe et grande consommation',
    description: 'Avant d’acheter, le consommateur chinois tape le nom de la marque sur Weibo. Un compte vérifié et actif rassure. Le vide, lui, inquiète.',
    icon: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
  },
  {
    title: 'Tourisme et éducation',
    description: 'Voyageurs et étudiants chinois préparent destinations et écoles sur Weibo, des mois en amont. Nous maintenons votre marque au cœur de ces recherches.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'Agroalimentaire et e-commerce',
    description: 'Les posts achetables mènent droit vers Tmall et Taobao. Les directs se branchent sur Taobao Live. Du post Weibo à l’achat, le chemin est court.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Tech grand public et B2B',
    description: 'Lancements de produits, amplification presse, gestion de réputation. Pour faire connaître un nom à des millions de personnes en peu de temps, Weibo reste le canal.',
    icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>',
  },
];

const pillars = [
  {
    title: 'Un périmètre écrit noir sur blanc',
    description: 'Le SOW, votre périmètre de travail, fixe chaque livrable avant la signature. Posts, vidéos, campagnes, bilans. Vous savez ce que chaque mois vous apporte.',
  },
  {
    title: 'Un prix ferme, sans surprise',
    description: 'Une formule, un prix. Ni taux horaire, ni facturation au dépassement, ni ligne inattendue en fin de mois.',
  },
  {
    title: 'Une production assistée par IA',
    description: 'Visuels et vidéos produits avec HubStudio.ai : des coûts tenus, un rythme soutenu. La stratégie, elle, reste entièrement humaine.',
  },
  {
    title: 'Une équipe installée en Chine',
    description: 'Shanghai et Hong Kong. Des natifs qui ouvrent la Hot Search chaque matin et parlent en direct aux KOL.',
  },
];

const steps = [
  {
    title: 'Audit et stratégie',
    description: 'Semaine 1. Nous étudions votre marque, vos concurrents sur Weibo et vos objectifs. Vous repartez avec une stratégie éditoriale et un périmètre de travail chiffré.',
  },
  {
    title: 'Ouverture et vérification du compte',
    description: 'Semaines 1 à 4. Le compte est enregistré, le dossier Blue V déposé. Le profil se construit sans attendre le badge.',
  },
  {
    title: 'Calendrier éditorial',
    description: 'Semaine 2. Le premier mois de publications est écrit, maquetté et planifié. Rien ne part en ligne sans votre accord.',
  },
  {
    title: 'Lancement',
    description: 'Semaine 2. Les premiers posts sont en ligne, la première campagne tourne. Quatorze jours séparent la signature de la première publication.',
  },
  {
    title: 'Optimisation',
    description: 'En continu. Nous repérons ce qui marche, format par format, réagissons aux tendances dans l’heure et ajustons les enchères chaque semaine.',
  },
  {
    title: 'Bilan',
    description: 'Chaque mois. Croissance, engagement, résultats média, retombées KOL, repères concurrentiels. Un point d’étape s’ajoute à mi-mois pendant les campagnes.',
  },
];

const caseStudies = [
  {
    client: 'JAC Motors',
    image: '/images/clients/JAC/JAC-Wechat-4.webp',
    imageAlt: 'Contenus sociaux de JAC Motors réalisés par TheRedScroll',
    metric: '10M',
    metricLabel: 'véhicules vendus, une communauté relancée',
    summary: 'Un constructeur automobile chinois, 10 millions de véhicules vendus, des comptes sociaux endormis. Nous avons relancé la communauté sur Weibo, WeChat et RedNote avec des contenus assistés par IA.',
    href: '/fr/work/jac-motors/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Visuel de campagne Mission Foods pour son lancement en Chine',
    metric: 'Gen Z',
    metricLabel: 'des campagnes pour installer une catégorie alimentaire inédite',
    summary: 'Installer les chips de maïs en Chine, une catégorie que personne n’y connaissait. Campagnes Gen Z et contenus d’accords culinaires sur Weibo, WeChat et RedNote.',
    href: '/fr/work/mission-foods/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Visuel de campagne Camper pour les réseaux sociaux chinois',
    metric: '187K',
    metricLabel: 'abonnés, contre 43K dix-huit mois auparavant',
    summary: 'La marque européenne de chaussures est passée de 43K à 187K abonnés en dix-huit mois. L’engagement a grimpé de 1,2 % à 4,7 %. Les ventes à magasins comparables ont gagné 31 % sur un an.',
    href: '/fr/work/camper/',
  },
];

const faqs = [
  {
    q: 'Combien coûte une agence Weibo ?',
    a: 'Deux enveloppes sont à prévoir. Les honoraires d’agence d’abord : un prix mensuel ferme, adossé à un périmètre de travail signé où figurent chaque livrable et le coût total. En avril 2026, nous avons étudié 37 agences de marketing actives en Chine : 0 sur 37 affiche des formules à prix ferme. Nous le faisons. Le budget média ensuite : versé à Weibo à part et refacturé au coût réel, sans marge. Les Fan Headlines constituent le ticket d’entrée, les emplacements Hot Search le haut du panier.',
  },
  {
    q: 'Une société étrangère peut-elle ouvrir un compte Weibo ?',
    a: 'Oui, et c’est une procédure que nous menons régulièrement. Une société étrangère peut obtenir un compte entreprise vérifié, avec badge Blue V. Il faut fournir des statuts traduits en chinois et régler à Weibo des frais de vérification uniques de 1 000 dollars. Nous montons le dossier, faisons traduire les pièces et dialoguons avec les équipes de vérification de Weibo à votre place.',
  },
  {
    q: 'Combien de temps prend la vérification Weibo ?',
    a: 'Comptez deux à quatre semaines avec un dossier complet. Une pièce manquante ou incohérente reste la première cause de retard, d’où notre relecture intégrale avant dépôt. L’attente n’est pas du temps perdu : le profil se construit et les contenus se préparent pendant l’instruction du badge Blue V.',
  },
  {
    q: 'Faut-il une licence commerciale chinoise pour Weibo ?',
    a: 'Non. Une immatriculation étrangère suffit pour un compte entreprise vérifié. Ni entité chinoise, ni compte bancaire local, ni licence ICP ne sont exigés pour animer un compte Weibo. L’entité chinoise n’entre en jeu que plus tard, pour des intégrations e-commerce domestiques par exemple. Notre service d’entrée sur le marché chinois prend alors le relais.',
  },
  {
    q: 'Weibo ou WeChat : par lequel commencer ?',
    a: 'Tout dépend de l’objectif. Weibo est la place publique chinoise : 567 millions d’utilisateurs mensuels, des sujets tendance, des posts ouverts à tous. La notoriété s’y bâtit vite. WeChat fonctionne en cercles privés, ce qui en fait l’outil de la fidélisation et du CRM. Les marques qui abordent la Chine ouvrent en général Weibo pour la portée, puis ajoutent WeChat une fois l’audience constituée. La plupart de nos clients animent les deux.',
  },
  {
    q: 'Comment mesurez-vous le succès d’une campagne Weibo ?',
    a: 'À l’aune des objectifs inscrits dans votre périmètre de travail. Le bilan mensuel détaille la croissance des abonnés, les taux d’engagement, la performance par format, les résultats média (CPM, CPC, CPA, ROAS), les retombées KOL et les repères concurrentiels. Il s’achève sur des recommandations précises pour le mois suivant. Un point d’étape s’ajoute à mi-mois pendant les campagnes actives.',
  },
];
---

<PageLayout
  title="Agence Weibo pour les marques visant la Chine | TheRedScroll"
  description="Agence Weibo à service complet depuis Shanghai et Hong Kong : vérification Blue V, contenu en chinois, publicité, campagnes KOL. Périmètre et prix fermes."
  lang="fr"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      微博
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">博</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Agence Weibo</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            L’agence Weibo des marques qui visent la Chine
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Ouverture de compte, vérification Blue V, contenu, publicité, campagnes KOL. Une équipe à Shanghai et Hong Kong pilote le tout, jour après jour. Périmètre ferme. Prix ferme.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
            <Button variant="secondary-dark" href="#results">Voir les résultats</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Trente minutes au téléphone. Sans discours commercial.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/weibo-agency/hero-phones-blend.webp"
            alt="Deux téléphones ouverts sur l’appli Weibo : le fil public et le classement des tendances Hot Search"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Pourquoi Weibo pèse
          </p>
          <p class="manifesto" data-manifesto>
            Weibo est la place publique de la Chine. 567 millions de personnes y suivent, chaque mois, ce qui monte et ce qui tombe. Une réputation s’y joue en quelques heures. Si votre marque se tait, quelqu’un d’autre <span class="manifesto-hl">écrit</span> son histoire à sa place.
          </p>
        </div>
        <div>
          <img
            src="/images/weibo-agency/ecosystem-banner-tight.webp"
            alt="Trois téléphones, trois facettes de Weibo : le fil public, le classement Hot Search et un profil de marque vérifié"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Une appli, trois usages : fil public, sujets tendance, réputation des marques.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Une seule agence pour tout ce que Weibo exige
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Weibo revendique 567 millions d’utilisateurs actifs par mois et 252 millions par jour (mai 2026). Les tendances y naissent, les nouvelles y tombent, et le consommateur chinois y vérifie les marques avant d’acheter.
            </p>
            <p>
              Une agence Weibo enregistre et fait vérifier votre compte entreprise, rédige vos contenus en chinois, achète votre média et pilote vos campagnes KOL. Internaliser tout cela suppose de recruter des natifs, d’apprivoiser le rythme de la Hot Search et de démêler la paperasse de vérification. Avec un spécialiste, la plupart des marques avancent plus vite et plus loin.
            </p>
            <p>
              Ce spécialiste, c’est nous. Nous publions chaque jour sur <a href="/fr/platforms/weibo/" class="text-[#CC3333] hover:underline">Weibo</a>, depuis la Chine.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Le périmètre, d’un coup d’œil
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Nos prestations Weibo</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Six prestations, toutes assorties de livrables précis
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Tout est écrit dans le périmètre de travail avant la signature. Aucun forfait flou.
              </p>
