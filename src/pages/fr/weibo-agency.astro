        </div>
      </div>
    </Container>
  </section>

  <!-- ============ FINAL CTA (ink bookend, full bleed) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#1A1A1A] border-b border-[rgba(255,255,255,0.1)] relative overflow-hidden">
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[200px] max-[640px]:text-[90px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      微博
    </span>
    <Container class="relative z-[1]">
      <div class="py-[96px] max-[640px]:py-[56px] text-center">
        <p class="flex items-center justify-center gap-[10px] mb-[20px]" data-reveal>
          <span class="seal" aria-hidden="true">博</span>
          <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Lancez votre présence Weibo</span>
        </p>
        <h2 class="text-[40px] max-[640px]:text-[26px] font-medium leading-[1.15] tracking-[-0.01em] text-[#FFFFFF] max-w-[720px] mx-auto mb-[16px]" data-reveal style="--d: 80ms">
          C’est sur Weibo que la Chine converse. Prenez-y la parole en marque vérifiée.
        </h2>
        <p class="text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[520px] mx-auto mb-[32px]" data-reveal style="--d: 160ms">
          Trente minutes au téléphone. Nous vous dirons ce que votre marque peut obtenir sur Weibo avec vos moyens actuels, et ce qu’exigerait l’étape suivante. Sans discours commercial.
        </p>
        <div data-reveal style="--d: 240ms">
          <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
        </div>

        <div class="mt-[56px] pt-[24px] border-t border-[rgba(255,255,255,0.1)]" data-reveal style="--d: 300ms">
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal mb-[12px]">Voir aussi</p>
          <div class="flex justify-center gap-[24px] flex-wrap">
            <a href="/fr/platforms/weibo/" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Marketing Weibo &rarr;</a>
            <a href="/fr/services/market-entry/" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Entrée sur le marché chinois &rarr;</a>
            <a href="/fr/platforms/wechat/" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Marketing WeChat &rarr;</a>
            <a href="/fr/platforms/rednote/" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Marketing RedNote &rarr;</a>
            <a href="/fr/platforms/douyin/" class="text-[14px] text-[#CC3333] font-medium transition-colors duration-150 hover:text-[#B02D2D]">Marketing Douyin &rarr;</a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <style>
    /* ---------- Signature: the red thread ---------- */
    .red-thread {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: #CC3333;
      transform: scaleX(0);
      transform-origin: left;
      z-index: 1100;
      pointer-events: none;
    }

    /* ---------- Seal mark ---------- */
    .seal {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border: 1.5px solid #CC3333;
      border-radius: 4px;
      color: #CC3333;
      font-size: 12px;
      font-weight: 500;
      line-height: 1;
    }

    /* ---------- Hero ---------- */
    .hero-title {
      font-size: clamp(40px, 5.4vw, 72px);
      font-weight: 500;
      line-height: 1.06;
      letter-spacing: -0.025em;
    }
    .hero-float {
      animation: heroFloat 7s ease-in-out infinite alternate;
    }
    @keyframes heroFloat {
      from { transform: translateY(0); }
      to { transform: translateY(-10px); }
    }
    [data-hero-reveal] {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.6s ease, transform 0.6s ease;
      transition-delay: var(--d, 0ms);
    }
    [data-hero-reveal].is-in {
      opacity: 1;
      transform: translateY(0);
    }

    /* ---------- Manifesto ---------- */
    .manifesto {
      font-size: clamp(18px, 1.9vw, 24px);
      font-weight: 500;
      line-height: 1.4;
      letter-spacing: -0.01em;
      color: #1A1A1A;
      margin: 0;
    }
    .manifesto .w {
      opacity: 0.12;
      transition: opacity 0.3s ease;
    }
    .manifesto .w.is-on {
      opacity: 1;
    }
    .manifesto-hl {
      color: #CC3333;
    }

    /* ---------- Scroll reveal ---------- */
    [data-reveal] {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease, transform 0.6s ease;
      transition-delay: var(--d, 0ms);
    }
    [data-reveal].is-in {
      opacity: 1;
      transform: translateY(0);
    }

    /* ---------- Scope arrows ---------- */
    .scope-arrow {
      opacity: 0;
      transform: translateX(-6px);
      transition: opacity 0.15s ease, transform 0.15s ease;
    }
    a:hover .scope-arrow,
    a:focus-visible .scope-arrow {
      opacity: 1;
      transform: translateX(0);
    }

    /* ---------- Services scrollytelling ---------- */
    /* Print-offset frame: a vermillion outline registered slightly off the media card */
    .svc-frame {
      isolation: isolate;
    }
    .svc-frame::after {
      content: '';
      position: absolute;
      inset: 0;
      border: 1.5px solid #CC3333;
      border-radius: 10px;
      transform: translate(10px, 10px);
      z-index: -1;
      pointer-events: none;
    }
    .svc-img {
      opacity: 0;
      transform: scale(1);
      transition: opacity 0.45s ease, transform 6s ease;
    }
    .svc-img.is-active {
      opacity: 1;
      transform: scale(1.04);
    }
    .svc-tick {
      display: block;
      height: 3px;
      flex: 1;
      background: #E8E0D8;
      transition: background 0.3s ease;
    }
    .svc-tick.is-active {
      background: #CC3333;
    }
    .svc-seal {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border: 1.5px solid #CC3333;
      border-radius: 6px;
      color: #CC3333;
      font-size: 14px;
      font-weight: 500;
      line-height: 1;
      transition: background 0.3s ease, color 0.3s ease;
    }
    .svc-step {
      border: 0.5px solid rgba(0, 0, 0, 0.08);
      transition: opacity 0.3s ease, border-color 0.3s ease;
    }
    @media (min-width: 901px) {
      .svc-step { opacity: 0.45; }
      .svc-step.is-active { opacity: 1; border-color: rgba(0, 0, 0, 0.15); }
      .svc-step.is-active .svc-seal { background: #CC3333; color: #FFFFFF; }
    }

    /* ---------- Cards ---------- */
    .lift-card {
      transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .lift-card:hover {
      transform: translateY(-4px);
      border-color: rgba(0, 0, 0, 0.15);
    }
    .cs-card {
      transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .cs-card:hover {
      transform: translateY(-4px);
      border-color: rgba(0, 0, 0, 0.15);
    }
    .cs-arrow {
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .cs-card:hover .cs-arrow {
      transform: translateX(4px);
    }
    .cs-img {
      transition: transform 0.3s ease;
    }
    .cs-card:hover .cs-img {
      transform: scale(1.03);
    }
    .pillar-bar {
      transform-origin: left;
      transition: transform 0.3s ease;
    }
    .pillar-card:hover .pillar-bar {
      transform: scaleX(1.75);
    }

    /* ---------- Process line ---------- */
    .proc-fill {
      width: 0;
      transition: width 1.2s ease;
    }
    .proc.is-in .proc-fill {
      width: 100%;
    }

    /* ---------- FAQ ---------- */
    .faq-content {
      transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
    }

    /* ---------- Quality floor: focus + smooth scroll ---------- */
    .cs-card:focus-visible,
    .faq-trigger:focus-visible {
      outline: 2px solid #CC3333;
      outline-offset: 2px;
    }
    :global(html) {
      scroll-behavior: smooth;
    }
    @media (prefers-reduced-motion: reduce) {
      :global(html) {
        scroll-behavior: auto;
      }
    }

    /* ---------- Reduced motion ---------- */
    @media (prefers-reduced-motion: reduce) {
      [data-hero-reveal],
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .hero-float {
        animation: none;
      }
      .manifesto .w {
        opacity: 1 !important;
        transition: none;
      }
      .svc-step {
        opacity: 1 !important;
      }
      .svc-img,
      .svc-img.is-active {
        transform: none;
        transition: opacity 0.45s ease;
      }
      .proc-fill {
        transition: none;
      }
      .proc .proc-fill {
        width: 100%;
      }
      .lift-card:hover,
      .cs-card:hover {
        transform: none;
      }
    }
  </style>

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- Hero load-in ---
    requestAnimationFrame(() => {
      document.querySelectorAll('[data-hero-reveal]').forEach((el) => el.classList.add('is-in'));
    });

    // --- The red thread: scroll progress ---
    const thread = document.querySelector('[data-thread]') as HTMLElement | null;
    if (thread) {
      let threadTick = false;
      const drawThread = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
        thread.style.transform = `scaleX(${p})`;
        threadTick = false;
      };
      window.addEventListener('scroll', () => {
        if (!threadTick) {
          threadTick = true;
          requestAnimationFrame(drawThread);
        }
      }, { passive: true });
      drawThread();
    }

    // --- Scroll reveal ---
    const revealEls = document.querySelectorAll('[data-reveal]');
    if (reducedMotion) {
      revealEls.forEach((el) => el.classList.add('is-in'));
    } else {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      revealEls.forEach((el) => revealObserver.observe(el));
    }

    // --- Count-up numbers ---
    const formatCount = (value: number, decimals: number) =>
      value.toLocaleString('fr-FR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });

    const animateCount = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.count || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      if (reducedMotion) {
        el.textContent = formatCount(target, decimals);
        return;
      }
      const duration = 1400;
      let t0: number | null = null;
      const tick = (now: number) => {
        if (t0 === null) t0 = now;
        const p = Math.min((now - t0) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = formatCount(target * eased, decimals);
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const countObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            countObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.5 }
    );
    document.querySelectorAll('[data-count]').forEach((el) => countObserver.observe(el));

    // --- Hero watermark parallax ---
    const parallaxEls = Array.from(document.querySelectorAll('[data-parallax]')) as HTMLElement[];
    if (!reducedMotion && parallaxEls.length) {
      let ticking = false;
      const applyParallax = () => {
        const y = window.scrollY;
        parallaxEls.forEach((el) => {
          if (y < window.innerHeight * 1.2) {
            const speed = parseFloat(el.dataset.parallax || '0');
            el.style.transform = `translateY(${y * speed}px)`;
          }
        });
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(applyParallax);
        }
      }, { passive: true });
    }

    // --- Manifesto: word-by-word reveal ---
    const manifesto = document.querySelector('[data-manifesto]') as HTMLElement | null;
    if (manifesto) {
      // Wrap each word in a span, preserving the highlight span
      const wrapWords = (node: Node) => {
        if (node.nodeType === Node.TEXT_NODE) {
          const frag = document.createDocumentFragment();
          (node.textContent || '').split(/(\s+)/).forEach((part) => {
            if (/^\s+$/.test(part) || part === '') {
              frag.appendChild(document.createTextNode(part));
            } else {
              const span = document.createElement('span');
              span.className = 'w';
              span.textContent = part;
              frag.appendChild(span);
            }
          });
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          Array.from(node.childNodes).forEach(wrapWords);
        }
      };
      Array.from(manifesto.childNodes).forEach(wrapWords);
      const words = Array.from(manifesto.querySelectorAll('.w')) as HTMLElement[];

      if (reducedMotion) {
        words.forEach((w) => w.classList.add('is-on'));
      } else {
        let mTick = false;
        const drawManifesto = () => {
          const rect = manifesto.getBoundingClientRect();
          const viewH = window.innerHeight;
          // 0 when the block enters the lower third, 1 when its bottom passes the middle
          const start = viewH * 0.85;
          const end = viewH * 0.35;
          const p = Math.min(Math.max((start - rect.top) / (start - end), 0), 1);
          const active = Math.floor(p * words.length);
          words.forEach((w, i) => w.classList.toggle('is-on', i < active));
          mTick = false;
        };
        window.addEventListener('scroll', () => {
          if (!mTick) {
            mTick = true;
            requestAnimationFrame(drawManifesto);
          }
        }, { passive: true });
        drawManifesto();
      }
    }

    // --- Services scrollytelling ---
    const svcSteps = Array.from(document.querySelectorAll('[data-svc-step]')) as HTMLElement[];
    const svcImgs = Array.from(document.querySelectorAll('[data-svc-img]')) as HTMLElement[];
    const svcTicks = Array.from(document.querySelectorAll('[data-svc-tick]')) as HTMLElement[];
    const svcCaption = document.querySelector('[data-svc-caption]') as HTMLElement | null;
    if (svcSteps.length && svcImgs.length) {
      const setActive = (index: string | undefined) => {
        svcImgs.forEach((img) => img.classList.toggle('is-active', img.dataset.svcImg === index));
        svcTicks.forEach((tick) => tick.classList.toggle('is-active', tick.dataset.svcTick === index));
        svcSteps.forEach((step) => {
          const on = step.dataset.svcStep === index;
          step.classList.toggle('is-active', on);
          if (on && svcCaption) {
            const heading = step.querySelector('h3');
            if (heading) svcCaption.textContent = heading.textContent;
          }
        });
      };
      setActive('0');
      const stepObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActive((entry.target as HTMLElement).dataset.svcStep);
            }
          });
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );
      svcSteps.forEach((step) => stepObserver.observe(step));
    }

    // --- Process line draw ---
    const proc = document.querySelector('[data-proc]') as HTMLElement | null;
    if (proc) {
      if (reducedMotion) {
        proc.classList.add('is-in');
      } else {
        const procObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                proc.classList.add('is-in');
                procObserver.unobserve(proc);
              }
            });
          },
          { threshold: 0.3 }
        );
        procObserver.observe(proc);
      }
    }

    // --- FAQ accordion ---
    document.querySelectorAll('[data-faq]').forEach((item) => {
      const trigger = item.querySelector('[data-faq-trigger]') as HTMLButtonElement;
      const content = item.querySelector('.faq-content') as HTMLElement;
      if (!trigger || !content) return;

      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        const chevron = trigger.querySelector('.faq-chevron') as HTMLElement;

        if (isOpen) {
          content.style.height = content.scrollHeight + 'px';
          requestAnimationFrame(() => {
            content.style.height = '0';
            content.style.opacity = '0';
          });
          trigger.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.style.transform = 'rotate(0deg)';
        } else {
          content.style.height = '0';
          requestAnimationFrame(() => {
            content.style.height = content.scrollHeight + 'px';
            content.style.opacity = '1';
          });
          trigger.setAttribute('aria-expanded', 'true');
          if (chevron) chevron.style.transform = 'rotate(180deg)';
        }
      });
    });
  </script>
</PageLayout>
