---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 350, decimals: 0, suffix: 'M+', label: 'utilisateurs actifs chaque mois' },
  { value: 1, decimals: 0, suffix: 'B+', label: 'recherches lancées chaque mois' },
  { value: 70, decimals: 0, suffix: '%', label: 'des utilisateurs ont de 18 à 35 ans' },
  { value: 2, decimals: 0, suffix: ' semaines', label: 'entre la signature et la première note publiée' },
];

const platformNames = [
  { name: '小红书 (Xiǎohóngshū)', detail: 'Le nom officiel en Chine. On le romanise en Xiaohongshu, parfois Xiao Hong Shu.' },
  { name: 'Little Red Book', detail: 'La traduction littérale de 小红书 en anglais.' },
  { name: 'RED', detail: 'L’ancienne identité internationale de la plateforme. La presse l’emploie encore.' },
  { name: 'RedNote', detail: 'Le nom anglais officiel depuis janvier 2025. Celui que nous retenons ici.' },
];

const services = [
  {
    glyph: '号',
    title: 'Ouverture et vérification du compte',
    tag: 'Opérationnel en deux semaines',
    description:
      'Enregistrement du Professional Account (企业号, Blue V), traduction de votre licence commerciale, constitution du dossier de marque déposée. Nous suivons le dossier jusqu’au feu vert de la plateforme. La plupart des comptes ouvrent en moins de deux semaines.',
    deliverables: ['Professional Account', 'Vérification Blue V', 'Traduction de la licence', 'Validation plateforme'],
    image: '/images/platforms/rednote-services/account-setup.webp',
    imageAlt: 'Profil Professional Account RedNote vérifié avec badge Blue V sur un téléphone, posé près de documents d’immatriculation',
  },
  {
    glyph: '达',
    title: 'Campagnes KOL et KOC',
    tag: 'Des créateurs vérifiés sur Pugongying',
    description:
      'Nous montons les campagnes KOL (Key Opinion Leader) et KOC (Key Opinion Consumer) sur Pugongying, la place de marché d’influence officielle. Plus de 100 000 créateurs vérifiés. Chaque présélection passe au crible de la détection des faux abonnés.',
    deliverables: ['Présélections KOL', 'Seeding KOC', 'Détection des faux abonnés', 'Rapport de campagne'],
    image: '/images/platforms/rednote-services/kol-koc.webp',
    imageAlt: 'Créatrice filmant une note d’avis produit dans le cadre d’une campagne KOL RedNote',
  },
  {
    glyph: '记',
    title: 'Création de contenu et localisation',
    tag: 'Écrit en mandarin, jamais traduit',
    description:
      'Notes (笔记), vidéos et visuels rédigés directement en mandarin, sans détour par l’anglais. Visuels AIGC produits avec HubStudio.ai, tournages en conditions réelles en Chine. Chaque contenu vise le grass-planting (种草), le bouche-à-oreille qui irrigue toute la plateforme.',
    deliverables: ['Notes et vidéos', 'Visuels AIGC', 'Tournages en Chine', 'Contenus grass-planting'],
    image: '/images/platforms/rednote-services/content-strategy.webp',
    imageAlt: 'Poste de travail éditorial, un téléphone affiche une note RedNote rédigée en mandarin',
  },
  {
    glyph: '广',
    title: 'Publicité payante',
    tag: 'Budget média facturé au coût réel',
    description:
      'In-Feed Ads (信息流广告), Search Ads et Brand Ads via la régie Juguang. Nous testons les créations, pilotons les enchères et ajustons en continu. Le budget média est refacturé au coût réel, sans la moindre marge.',
    deliverables: ['In-Feed Ads', 'Search Ads', 'Brand Ads', 'Tests créatifs'],
    image: '/images/platforms/rednote-services/paid-advertising.webp',
    imageAlt: 'Publicité In-Feed sponsorisée affichée dans la grille de découverte RedNote sur un téléphone',
  },
  {
    glyph: '店',
    title: 'E-commerce et boutique intégrée',
    tag: 'Du contenu au panier, sans quitter l’appli',
    description:
      'Ouverture de la boutique dans l’appli, notes achetables, production de live commerce. Les sessions en direct pèsent 90 % des ventes internes de la plateforme. Le contenu conduit à l’achat sans jamais sortir de l’appli.',
    deliverables: ['Boutique dans l’appli', 'Notes achetables', 'Sessions en direct', 'Dispositif transfrontalier'],
    image: '/images/platforms/rednote-services/ecommerce-live.webp',
    imageAlt: 'Session de live commerce RedNote sur un téléphone, boutique produit intégrée affichée à côté',
  },
  {
    glyph: '数',
    title: 'Reporting et analyse',
    tag: 'Des rapports en anglais clair',
    description:
      'Croissance des abonnés, engagement, positions de recherche, ROI des campagnes : tout tient dans un rapport mensuel unique, rédigé en anglais clair. La veille sociale suit les mentions de marque, le sentiment et les mouvements des concurrents.',
    deliverables: ['Croissance et engagement', 'Positions de recherche', 'ROI des campagnes', 'Veille sociale'],
    image: '/images/platforms/rednote-services/analytics-listening.webp',
    imageAlt: 'Tableau de bord RedNote sur ordinateur portable : croissance des abonnés, engagement et positions de recherche',
  },
];

const industries = [
  {
    title: 'Beauté et cosmétiques',
    description: 'La catégorie reine de la plateforme. Avis produits, tutoriels, décryptage d’ingrédients.',
    icon: '<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>',
  },
  {
    title: 'Mode et habillement',
    description: 'Conseils de style, lookbooks de saison, campagnes de seeding KOC.',
    icon: '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>',
  },
  {
    title: 'Alimentation et boissons',
    description: 'Critiques de restaurants, recettes, dégustations produit.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Voyage et tourisme',
    description: 'Guides de destination, avis d’hôtels. 64 % des voyageurs chinois préparent leur séjour sur RedNote.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'Luxe',
    description: 'Des récits de marque pour une clientèle aisée, souvent à un pas de l’achat.',
    icon: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
  },
  {
    title: 'Santé et bien-être',
    description: 'Fitness, compléments alimentaires, conseils bien-être. Un secteur en pleine accélération.',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
  },
];

const pillars = [
  {
    title: 'Un périmètre noir sur blanc',
    description: 'Le SOW, le périmètre de travail, fixe chaque livrable dès le départ. Notes, vidéos, activations KOL, campagnes, rapports. Vous savez, mois après mois, ce qui vous sera livré.',
  },
  {
    title: 'Un prix ferme, sans surprise',
    description: 'Un tarif par formule. Ni taux horaire, ni facturation au dépassement, ni ligne inattendue en fin de mois.',
  },
  {
    title: 'Des contenus produits avec l’IA',
    description: 'Visuels et vidéos réalisés avec HubStudio.ai : des coûts tenus, une cadence soutenue. La stratégie, elle, reste entièrement humaine.',
  },
  {
    title: 'Une équipe sur le terrain',
    description: 'Shanghai et Hong Kong. Des bilingues natifs qui publient sur RedNote tous les jours, avec des relations KOL en direct et un accès permanent à la plateforme.',
  },
];

const steps = [
  {
    title: 'Audit et stratégie',
    description:
      'Trente minutes d’appel découverte, puis un audit de votre catégorie : mots-clés recherchés, comptes concurrents, angles de contenu délaissés. Vous recevez une proposition à prix ferme, livrable par livrable.',
  },
  {
    title: 'Compte et premiers contenus',
    description:
      'Nous déposons le dossier du Professional Account, posons vos piliers éditoriaux et produisons la première série de notes. En ligne deux semaines après la signature.',
  },
  {
    title: 'Lancement et activation KOL',
    description:
      'Une cadence de publication régulière apprend votre catégorie à l’algorithme. Le seeding KOC et quelques appuis payants amènent du trafic pendant que l’organique s’installe.',
  },
  {
    title: 'Optimisation et montée en puissance',
    description:
      'Nous lisons les données d’engagement CES et les positions de recherche. Ce qui cale s’arrête, ce qui convertit reçoit davantage de moyens.',
  },
];

const caseStudies = [
  {
    client: 'AGE 20\'s',
    image: '/images/clients/Age20/Age20-Picture11.webp',
    imageAlt: 'Visuel de la campagne RedNote du fond de teint Little Milk Brick d’AGE 20’s',
    metric: '750K',
    metricLabel: 'impressions, pour 300K visées',
    summary: 'Une marque de beauté coréenne lance son fond de teint Little Milk Brick en Chine. La campagne RedNote signe 750K impressions pour 300K visées. Le surnom du produit a pris tout seul.',
    href: '/fr/work/age20s/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Visuel de la campagne Camper sur les réseaux sociaux chinois',
    metric: '38%',
    metricLabel: 'du trafic e-commerce venu de la plus petite audience',
    summary: 'Une marque de chaussures européenne passée de 43K à 187K abonnés en dix-huit mois. RedNote restait sa plus petite audience et apportait pourtant 38 % du trafic e-commerce.',
    href: '/fr/work/camper/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Visuel de la campagne Mission Foods pour le lancement en Chine',
    metric: 'Gen Z',
    metricLabel: 'ciblée pour une catégorie alimentaire inconnue en Chine',
    summary: 'Introduire les chips de maïs, une catégorie que la Chine ignorait. Les KOL RedNote ont montré le produit en situation, et les accords culinaires l’ont rendu familier.',
    href: '/fr/work/mission-foods/',
  },
];

const faqs = [
  {
    q: 'Xiaohongshu, RedNote, Little Red Book : parle-t-on de la même appli ?',
    a: 'Oui. Xiaohongshu (小红书) est le nom chinois officiel, Little Red Book sa traduction littérale. À l’international, la société s’est longtemps appelée RED, puis a adopté RedNote comme nom anglais officiel en janvier 2025. Xiao Hong Shu n’est que la transcription pinyin en trois mots. Une appli, un algorithme, une audience.',
  },
  {
    q: 'Une marque étrangère peut-elle vendre sur Xiaohongshu ?',
    a: 'Oui. Une licence commerciale traduite et un dossier de marque déposée suffisent pour ouvrir un Professional Account (Blue V), sans entité chinoise. Le programme e-commerce transfrontalier permet en plus de tenir une boutique dans l’appli et d’expédier depuis l’étranger. Nous prenons en charge le dossier, la boutique et la validation par la plateforme.',
  },
  {
    q: 'Combien coûte le marketing sur Xiaohongshu ?',
    a: 'Trois budgets à distinguer. Les honoraires d’agence : un prix mensuel ferme, adossé à un périmètre précis, le tout connu avant la signature. Le budget média : facturé à part, au coût réel, via la régie Juguang, sans marge. Les cachets KOL : très variables selon le palier d’abonnés et la catégorie, refacturés sans marge cachée, données d’engagement vérifiées à l’appui.',
  },
  {
    q: 'Quand arrivent les premiers résultats ?',
    a: 'La plateforme ne récompense pas la précipitation. Tout nouveau compte traverse une fenêtre d’observation de l’algorithme. Les deux ou trois premiers mois servent à constituer votre bibliothèque de contenus et à habituer l’algorithme à votre catégorie. Publicité et campagnes KOL peuvent amener du trafic dès la première semaine, en attendant que l’organique prenne le relais. Notre engagement minimal de trois mois tient précisément à cela.',
  },
  {
    q: 'Faut-il une licence commerciale ou une entité chinoise ?',
    a: 'Pas pour le compte : une licence commerciale étrangère traduite suffit pour un Professional Account. La publicité fait exception. La régie Juguang exige une entité chinoise pour ouvrir un compte publicitaire. Nous opérons ces comptes pour nos clients étrangers via notre structure locale, avec rapports de dépenses hebdomadaires et visibilité complète.',
  },
  {
    q: 'Qui utilise RedNote, et pour quoi faire ?',
    a: 'Quelque 350 millions de personnes s’y connectent chaque mois. Le cœur d’audience est jeune, urbain, féminin à près de 70 %, doté d’un vrai pouvoir d’achat. RedNote leur sert de moteur de recherche d’expériences produit : quoi acheter, où partir, ce qui tient ses promesses. C’est cette intention d’achat qui pousse les marques orientées conversion à commencer ici.',
  },
  {
    q: 'RedNote ou Douyin : lequel pour ma marque ?',
    a: 'Les deux plateformes ne jouent pas le même rôle. Douyin mise sur la vidéo de divertissement et un fil algorithmique rapide, taillé pour la portée et l’achat d’impulsion. RedNote avance au rythme de la recherche : on s’y renseigne avant d’acheter, et une bonne note draine du trafic des mois durant. Beauté, mode, voyage : les catégories à forte considération démarrent le plus souvent sur RedNote. Beaucoup de marques finissent par mener les deux de front.',
  },
  {
    q: 'Comment fonctionnent les campagnes KOL et KOC sur RedNote ?',
    a: 'Toute collaboration payante passe par Pugongying, la place de marché officielle de la plateforme ; réserver en dehors expose au retrait des contenus. Nous présélectionnons des créateurs aux données d’audience vérifiées, puis prenons en charge briefs, contrats, paiements et bilan par publication. Sur RedNote, des dizaines d’avis de petits KOC pèsent souvent plus qu’un post de célébrité.',
  },
  {
    q: 'Peut-on publier en anglais ?',
    a: 'Les utilisateurs chinois cherchent en chinois : une note en anglais ne remonte presque jamais. Tout ce que nous publions est écrit directement en mandarin par notre équipe de Shanghai, jamais traduit. L’anglais ne touche que la petite communauté étrangère arrivée début 2025. Pour vendre en Chine, RedNote reste une plateforme en mandarin.',
  },
  {
    q: 'Qu’est-ce qui fait le succès d’une note sur RedNote ?',
    a: 'Des mots-clés de recherche dans le titre, une couverture qui accroche et une première personne qui sonne comme une vraie recommandation. L’algorithme étouffe les discours trop commerciaux, et la publicité non déclarée risque le retrait. Nous déclarons donc chaque note commerciale dans les règles de la plateforme. Chaque publication repose sur un plan de mots-clés, dont nous suivons le positionnement.',
  },
];
---

<PageLayout
  title="Agence RedNote | Marketing Xiaohongshu (Little Red Book)"
  description="Faites grandir votre marque sur RedNote (Xiaohongshu, Little Red Book) : KOL, contenus et publicité pilotés depuis Shanghai. Prix ferme, périmètre écrit."
  lang="fr"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">红</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Agence RedNote</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            Agence marketing RedNote (Xiaohongshu / Little Red Book)
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Une plateforme, quatre noms, plus de 350 M d’utilisateurs chaque mois. Nous pilotons campagnes KOL, contenus, publicité et commerce social pour les marques occidentales. Depuis Shanghai, au quotidien. Périmètre écrit, prix ferme.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
            <Button variant="secondary-dark" href="#results">Voir les résultats</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Trente minutes de conversation. Pas de discours commercial.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/rednote-agency/hero-phones-blend.webp"
            alt="Deux téléphones montrant l’appli RedNote telle quelle : la grille de découverte des notes et une note d’avis produit"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Pourquoi tout commence sur RedNote
          </p>
          <p class="manifesto" data-manifesto>
            En Chine, un achat commence par une recherche sur RedNote. 350 millions de personnes y lisent des avis réels avant de dépenser. La publicité n’y gagne pas la partie. La <span class="manifesto-hl">confiance</span>, oui. Nous écrivons les notes, les avis et les voix de créateurs qui la bâtissent.
          </p>
        </div>
        <div>
          <img
            src="/images/rednote-agency/ecosystem-banner-tight.webp"
            alt="Trois téléphones qui retracent le parcours RedNote : grille de découverte, note d’avis produit, résultats de recherche"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Une seule appli pour trois usages : découvrir, lire des avis sincères, chercher.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">
            Qu’est-ce que RedNote
          </p>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Xiaohongshu, Little Red Book, RED, RedNote : de quoi parle-t-on
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              RedNote (小红书 / Xiaohongshu) est la plateforme où la Chine découvre les produits. Plus de 350 M d’utilisateurs actifs chaque mois, plus d’un milliard de recherches mensuelles. Et 90 % des contenus viennent des utilisateurs, pas des marques (mai 2026).
            </p>
            <p>
              70 % des utilisateurs ont de 18 à 35 ans. Ce sont surtout des femmes des villes de premier et deuxième rang, au pouvoir d’achat supérieur à la moyenne. Elles viennent se renseigner avant d’acheter. Avis, tutoriels et recommandations sincères pèsent ici plus que partout ailleurs en Chine.
            </p>
            <p>
              Pour le dire simplement : Douyin divertit les consommateurs chinois, WeChat fidélise les clients des marques, et <a href="/fr/platforms/rednote/" class="text-[#CC3333] hover:underline">RedNote</a> décide des achats.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Pourquoi tant de noms pour une seule appli
          </p>
          <ul class="flex flex-col gap-[14px] list-none m-0 p-0">
            {platformNames.map((item) => (
              <li>
                <p class="text-[14px] font-medium leading-[1.4] text-[#1A1A1A] m-0">{item.name}</p>
                <p class="text-[13px] font-normal leading-[1.5] text-[#5C5C5C] m-0 mt-[2px]">{item.detail}</p>
              </li>
            ))}
          </ul>
        </div>
