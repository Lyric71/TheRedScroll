---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 1.4, decimals: 1, suffix: 'B', label: 'utilisateurs actifs chaque mois' },
  { value: 945, decimals: 0, suffix: 'M', label: 'personnes sur les Mini Programs chaque mois' },
  { value: 18, decimals: 0, suffix: '', label: 'plateformes chinoises gérées au quotidien' },
  { value: 4, decimals: 0, suffix: ' semaines', label: 'de la signature au premier contenu publié' },
];

const scopeItems = [
  { label: 'Création et vérification du Compte Officiel', href: '/fr/platforms/wechat/' },
  { label: 'Contenus écrits par des rédacteurs chinois natifs', href: '/fr/services/content-production/' },
  { label: 'Moments Ads, annonces Compte Officiel et Mini Program', href: '/fr/services/advertising/' },
  { label: 'Mini Programs et vente en ligne sur WeChat', href: '/fr/platforms/wechat/' },
  { label: 'CRM WeCom et construction du domaine privé', href: '/fr/services/crm-private-domain/' },
];

const services = [
  {
    glyph: '号',
    title: 'Création et vérification du Compte Officiel',
    tag: 'Compte actif en une à deux semaines',
    description:
      'Enregistrement du Service Account, constitution du dossier Tencent, vérification menée jusqu’au bout. Menus, réponses automatiques, identité de marque : nous réglons tout. Le compte est en général actif sous une à deux semaines.',
    deliverables: ['Enregistrement', 'Vérification Tencent', 'Menus et réponses automatiques', 'Identité de marque'],
    image: '/images/wechat-agency/service-setup.webp',
    imageAlt: 'Sur un bureau, un téléphone affiche un Compte Officiel WeChat vérifié, entouré de documents d’immatriculation',
  },
  {
    glyph: '文',
    title: 'Contenus et CRM',
    tag: 'Écrits par des Chinois natifs',
    description:
      'Ligne éditoriale, calendrier, articles, visuels, vidéos. Nos rédacteurs sont des Chinois natifs, jamais des traducteurs. Chaque nouvel abonné bascule dans WeCom. Votre fichier clients reste à vous, quoi que décide la plateforme.',
    deliverables: ['Calendrier éditorial', 'Articles', 'Visuels et vidéo', 'Mise en place de WeCom'],
    image: '/images/wechat-agency/service-content.webp',
    imageAlt: 'Poste de travail éditorial, un téléphone au premier plan ouvert sur un article de Compte Officiel WeChat',
  },
  {
    glyph: '广',
    title: 'Publicité WeChat',
    tag: 'Média refacturé au coût réel',
    description:
      'Plan média, créations, tests A/B et enchères sur Moments Ads, annonces Compte Officiel et Mini Program Ads. Vous payez le média au prix versé à Tencent. Pas un yuan de marge.',
    deliverables: ['Plan média', 'Créations publicitaires', 'Tests A/B', 'Pilotage des enchères'],
    image: '/images/wechat-agency/service-ads.webp',
    imageAlt: 'Dans un café, une main tient un téléphone où s’affiche une publicité de marque sponsorisée dans le fil Moments de WeChat',
  },
  {
    glyph: '店',
    title: 'Mini Programs et e-commerce',
    tag: '945 millions d’utilisateurs chaque mois',
    description:
      'Boutique, prise de contacts, réservation, fidélité : tout se construit dans WeChat, relié à WeChat Pay. Les Mini Programs touchent 945 millions de personnes chaque mois. Après la lecture, vos abonnés savent où aller. Et cette étape convertit.',
    deliverables: ['Boutique en ligne', 'WeChat Pay', 'Collecte de contacts', 'Programmes de fidélité'],
    image: '/images/wechat-agency/service-miniprogram.webp',
    imageAlt: 'Deux téléphones présentent une boutique Mini Program WeChat et la confirmation d’un paiement WeChat Pay',
  },
  {
    glyph: '播',
    title: 'Campagnes KOL et co-promotions',
    tag: 'Chiffres d’engagement vérifiés uniquement',
    description:
      'Sélection des Key Opinion Leaders (KOL), contrôle des audiences, briefs, suivi des retombées. Seuls les chiffres d’engagement vérifiés entrent dans nos analyses. Un compteur d’abonnés suspect, et le KOL sort de la liste.',
    deliverables: ['Sourcing KOL', 'Vérification', 'Briefs de campagne', 'Reporting'],
    image: '/images/wechat-agency/service-kol.webp',
    imageAlt: 'Créateur en train de filmer une vidéo produit, un téléphone diffuse un direct WeChat Channels',
  },
];

const segments = [
  {
    title: 'Commerce B2C et luxe',
    description: 'Avant d’acheter, le consommateur chinois vérifie la marque sur WeChat. Compte Officiel, contenus, boutique Mini Program : nous fermons la boucle jusqu’à l’achat.',
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  },
  {
    title: 'B2B et industrie',
    description: 'Un cycle de vente long exige un canal pour entretenir la relation. Articles WeChat et relances WeCom font des contacts noués en salon un vrai pipeline commercial.',
    icon: '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
  },
  {
    title: 'Tourisme et éducation',
    description: 'Étudiants et voyageurs chinois comparent sur WeChat des mois avant de se décider. Nous installons votre marque dans cette conversation, et l’y maintenons.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'E-commerce transfrontalier',
    description: 'Vendre en Chine sans y créer de société, c’est possible. Une boutique Mini Program et WeChat Pay transfrontalier suffisent.',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  },
];

const pillars = [
  {
    title: 'Un périmètre écrit noir sur blanc',
    description: 'Le SOW, notre périmètre de travail, liste chaque livrable avant signature. Articles, vidéos, campagnes, rapports. Vous savez ce qui arrive chaque mois.',
  },
  {
    title: 'Un prix ferme, sans surprise',
    description: 'Un forfait, un prix. Ni taux horaire, ni supplément de dernière minute, ni facture imprévue en fin de mois.',
  },
  {
    title: 'Des contenus produits avec l’IA',
    description: 'HubStudio.ai accélère les visuels et les vidéos, et fait baisser les coûts. La stratégie, elle, reste entre les mains de l’équipe.',
  },
  {
    title: 'Une équipe installée en Chine',
    description: 'Shanghai et Hong Kong. Des natifs qui ouvrent WeChat tous les jours, des relations directes avec les KOL, un accès permanent à la plateforme.',
  },
];

const steps = [
  {
    title: 'Appel découverte',
    description: 'Trente minutes pour parler de votre marque, de vos objectifs et de votre présence actuelle en Chine. Aucun argumentaire commercial.',
  },
  {
    title: 'Proposition',
    description: 'Un SOW précis, un prix ferme, chaque livrable écrit noir sur blanc. Vous connaissez le contenu et le coût avant de signer.',
  },
  {
    title: 'En ligne en quatre semaines',
    description: 'Cadrage, création du compte, vérification, premiers contenus. Quatre semaines séparent la signature de la première publication.',
  },
];

const caseStudies = [
  {
    client: 'JAC Motors',
    image: '/images/clients/JAC/JAC-Wechat-4.webp',
    imageAlt: 'Contenus WeChat créés par TheRedScroll pour JAC Motors',
    metric: '10M',
    metricLabel: 'véhicules vendus, une communauté relancée',
    summary: 'Dix millions de véhicules vendus, mais des réseaux sociaux endormis. Nous avons relancé la communauté du constructeur chinois sur WeChat, RedNote et Weibo, avec des contenus assistés par IA.',
    href: '/fr/work/jac-motors/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Visuel de la campagne de lancement de Mission Foods en Chine',
    metric: 'Gen Z',
    metricLabel: 'au cœur du lancement d’une catégorie inconnue',
    summary: 'Introduire les chips de maïs en Chine, où la catégorie n’existait pas. Campagnes Gen Z et idées d’accords culinaires sur WeChat, RedNote et Weibo.',
    href: '/fr/work/mission-foods/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Visuel de campagne réalisé pour Camper sur les réseaux sociaux chinois',
    metric: '187K',
    metricLabel: 'abonnés, contre 43K dix-huit mois plus tôt',
    summary: 'En dix-huit mois, cette marque européenne de chaussures est passée de 43K à 187K abonnés. L’engagement a grimpé de 1,2 % à 4,7 %. Les ventes à magasins comparables ont gagné 31 % sur un an.',
    href: '/fr/work/camper/',
  },
];

const faqs = [
  {
    q: 'Une licence commerciale chinoise est-elle obligatoire pour ouvrir un Compte Officiel WeChat ?',
    a: 'Non. Une licence commerciale étrangère suffit pour enregistrer un Service Account. Préparez les documents d’immatriculation de la société, la pièce d’identité du représentant légal et une preuve de propriété de la marque. L’entité chinoise ne devient obligatoire que pour les comptes Subscription, le statut de marchand WeChat Pay domestique et certains formats publicitaires.',
  },
  {
    q: 'Compte Subscription ou Service Account, quelle différence ?',
    a: 'Le compte Subscription publie tous les jours, mais ses articles tombent dans un dossier replié. Il reste réservé aux entités chinoises. Le Service Account publie quatre fois par mois et arrive directement dans la liste de conversations. Il gère les menus personnalisés, WeChat Pay et les outils CRM. C’est aussi le seul compte qu’une société étrangère peut ouvrir seule. Et pour la plupart des marques, le bon choix.',
  },
  {
    q: 'Combien coûte le marketing WeChat ?',
    a: 'Il faut distinguer deux budgets. Les honoraires d’agence d’abord : un forfait mensuel ferme, adossé à un périmètre de travail écrit. Chaque livrable et le coût total sont connus avant signature. Le média ensuite : les Moments Ads se vendent aux enchères, avec un ticket d’entrée autour de 1 000 RMB par jour. Les emplacements programmés premium démarrent près de 50 000 RMB par campagne. Le média est toujours refacturé à part, au coût réel, sans marge.',
  },
  {
    q: 'Quel délai pour créer et faire vérifier le compte ?',
    a: 'Avec un dossier complet, l’enregistrement et la vérification Tencent demandent une à deux semaines. Le premier facteur de retard reste un document manquant ou incohérent. Nous contrôlons donc tout avant dépôt. Compte déjà vérifié ? La publication peut démarrer en quelques jours.',
  },
  {
    q: 'Pouvez-vous piloter WeChat sans équipe dédiée de notre côté ?',
    a: 'Oui, et c’est le cas le plus fréquent chez nos clients. Depuis Shanghai et Hong Kong, notre équipe fait vivre le compte au quotidien : stratégie, contenus, publication, réponses aux abonnés, publicité, rapport mensuel en anglais clair. Vous disposez d’un responsable de compte dédié et d’une visibilité complète, sans recruter qui que ce soit en Chine.',
  },
  {
    q: 'À qui appartiennent le compte WeChat et ses abonnés ?',
    a: 'À vous, sans ambiguïté. Le compte est enregistré au nom de votre société, avec vos documents. Nous l’opérons, rien de plus. Si la collaboration s’arrête un jour, vous conservez le compte, les abonnés et toutes les archives de contenu.',
  },
  {
    q: 'Pouvez-vous reprendre un compte WeChat déjà ouvert ?',
    a: 'Oui. Un audit d’abord : statut de vérification, qualité des abonnés, historique des publications, risques de conformité. Nous corrigeons ensuite ce qui doit l’être, puis la publication reprend. La plupart des reprises se règlent en une semaine, sans coupure pour vos abonnés.',
  },
  {
    q: 'Commencer par WeChat, ou par RedNote et Douyin ?',
    a: 'Cela dépend de l’objectif. Sur WeChat, les consommateurs chinois lisent, posent leurs questions et achètent. C’est le camp de base. RedNote et Douyin, eux, servent la découverte et amènent de nouvelles audiences. La plupart de nos clients ancrent tout sur WeChat, puis ajoutent les plateformes de découverte autour.',
  },
  {
    q: 'Qu’appelle-t-on trafic de domaine privé, et pourquoi y tenir ?',
    a: 'Le domaine privé regroupe les abonnés que vous joignez directement, sans racheter de publicité à chaque message. En pratique, vos abonnés WeChat rejoignent des groupes WeCom et des conversations individuelles. Cette liste est à vous. Aucun changement d’algorithme ne peut vous l’enlever.',
  },
  {
    q: 'Comment mesurez-vous et présentez-vous les résultats ?',
    a: 'Par un rapport mensuel rédigé en anglais clair. Croissance des abonnés, lectures d’articles, engagement, dépenses média au coût réel, plus les prospects ou les ventes quand le suivi existe. Entre deux rapports, votre responsable de compte dédié reste joignable pour toute question.',
  },
];
---

<PageLayout
  title="Agence WeChat à Shanghai et Hong Kong | TheRedScroll"
  description="Compte Officiel, contenus, publicité, Mini Programs et CRM WeCom, pilotés depuis Shanghai et Hong Kong. Périmètre écrit, prix ferme, en ligne en quatre semaines."
  lang="fr"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      微信
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">微</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Agence WeChat</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            L’agence WeChat des marques qui veulent compter en Chine
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Compte Officiel, contenus, publicité, Mini Programs, CRM. Une équipe aux commandes chaque jour, depuis Shanghai et Hong Kong. Périmètre écrit. Prix ferme.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
            <Button variant="secondary-dark" href="#results">Voir nos résultats</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Trente minutes au téléphone. Aucun argumentaire commercial.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/wechat-agency/hero-phones-blend.webp"
            alt="Deux téléphones montrent WeChat en usage réel : une publicité de marque dans le fil Moments et un paiement WeChat Pay confirmé"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Pourquoi commencer par WeChat
          </p>
          <p class="manifesto" data-manifesto>
            En Chine, WeChat n’est pas une appli parmi d’autres. C’est l’internet tout entier. On y discute, on y lit, on y achète, on y paie, sans jamais en sortir. Une marque qui n’y figure pas reste <span class="manifesto-hl">invisible</span>.
          </p>
        </div>
        <div>
          <img
            src="/images/wechat-agency/ecosystem-banner-tight.webp"
            alt="Trois téléphones côte à côte résument WeChat : le fil Moments, un article de Compte Officiel et un paiement WeChat Pay confirmé"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Une seule appli pour le fil social, la publication et le paiement.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Tout WeChat, une seule agence
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Une agence WeChat crée votre compte, écrit vos contenus, achète vos publicités et développe votre Mini Program. Tout faire en interne, c’est recruter des natifs, apprendre les règles de Tencent et ouvrir un compte publicitaire chinois.
            </p>
            <p>
              Avec un spécialiste, la plupart des marques avancent plus vite et plus loin. C’est notre métier. Nous publions chaque jour sur <a href="/fr/platforms/wechat/" class="text-[#CC3333] hover:underline">WeChat</a>, depuis la Chine.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Le périmètre, en bref
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Nos prestations WeChat</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Cinq prestations, des livrables précis pour chacune
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Tout est écrit dans le périmètre avant signature. Aucune ligne floue.
              </p>
            </div>
            <div class="svc-frame relative max-[900px]:hidden">
              <div class="relative w-full aspect-[1344/570] rounded-[10px] overflow-hidden bg-[#FFFFFF]">
                {services.map((service, i) => (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="1344"
                    height="570"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class:list={['svc-img absolute inset-0 w-full h-full object-cover', i === 0 && 'is-active']}
                    data-svc-img={i}
                  />
                ))}
              </div>
            </div>
            <div class="flex items-center gap-[16px] mt-[24px] max-[900px]:hidden">
              <div class="flex gap-[6px] grow" aria-hidden="true">
                {services.map((_, i) => (
                  <span class:list={['svc-tick', i === 0 && 'is-active']} data-svc-tick={i}></span>
                ))}
              </div>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-none m-0 shrink-0" data-svc-caption aria-hidden="true">{services[0].title}</p>
            </div>
          </div>
        </div>

        <!-- Scrolling step cards -->
        <div class="flex flex-col gap-[16px]">
          {services.map((service, i) => (
            <div class:list={['svc-step bg-[#FFFFFF] rounded-[10px] p-[32px] max-[640px]:p-[20px]', i === 0 && 'is-active']} data-svc-step={i}>
              <div class="flex items-center gap-[12px] mb-[16px]">
                <span class="svc-seal" aria-hidden="true">{service.glyph}</span>
                <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">{service.tag}</span>
              </div>
              <h3 class="text-[22px] max-[640px]:text-[19px] font-medium leading-[1.25] text-[#1A1A1A] mb-[10px]">{service.title}</h3>
