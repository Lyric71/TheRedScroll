---
import { getCollection } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import EditorialArticle from '../../../components/pages/EditorialArticle.astro';
import { faqPageSchema, articleSchema } from '../../../lib/schema';
import { missingEditorialLocales } from '../../../lib/editorialLocales';

export async function getStaticPaths() {
  const pages = await getCollection('tools-fr');
  return pages.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const omitLocales = await missingEditorialLocales('tools', post.id);

const publishedIso = new Date(post.data.publishDate).toISOString();
const modifiedIso = new Date(post.data.updatedDate ?? post.data.publishDate).toISOString();
const url = `/fr/outils/${post.id}/`;

const schema: Record<string, unknown>[] = [
  articleSchema({
    type: 'Article',
    headline: post.data.title,
    description: post.data.metaDescription,
    url,
    image: post.data.featuredImage,
    datePublished: publishedIso,
    dateModified: modifiedIso,
    authorName: post.data.author,
    inLanguage: 'fr',
  }),
];
if (post.data.faqs && post.data.faqs.length > 0) {
  schema.push(faqPageSchema(post.data.faqs));
}
---

<BlogLayout
  title={`${post.data.metaTitle} | TheRedScroll`}
  description={post.data.metaDescription}
  ogImage={post.data.featuredImage}
  lang="fr"
  schema={schema}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  omitLocales={omitLocales}
>
  <EditorialArticle
    post={post}
    lang="fr"
    backHref="/fr/outils/"
    backLabel={"Tous les outils"}
    ctaText={"Vous voulez que nous fassions ces calculs pour votre marque ?"}
    tocLabel={"Sur cette page"}
    faqSubtitle={"Les questions qui reviennent le plus souvent sur le sujet."}
  />
</BlogLayout>
