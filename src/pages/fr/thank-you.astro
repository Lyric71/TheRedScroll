---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Merci | TheRedScroll"
  description="Votre message est bien arrivé. Nous vous répondons sous un jour ouvré."
  hideFooterCta={true}
  lang="fr"
>
  <main class="pt-[60px] max-[640px]:pt-[52px]">

    <section class="relative w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] min-h-[calc(100vh-60px)] flex items-center overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/hero/thank-you-bg.png')" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.7]" aria-hidden="true"></div>
      <div class="relative z-[1] max-w-[600px] mx-auto text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">Message envoyé</p>
        <h1 class="text-[#FFFFFF] text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] mb-[16px]">
          Votre message vient d'atterrir à Shanghai.
        </h1>
        <p class="text-[rgba(255,255,255,0.6)] text-[16px] font-normal leading-[1.6] mb-[32px]">
          Nous vous répondons sous un jour ouvré.
        </p>
        <a href="/fr/" class="inline-flex items-center justify-center h-[44px] px-[28px] text-[14px] font-medium leading-none text-[#FFFFFF] bg-[#CC3333] rounded-[6px] cursor-pointer transition-[background] duration-150 hover:bg-[#B02D2D] active:scale-[0.98]">
          Retour à l'accueil
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
