---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import SectionBar from '../../components/ui/SectionBar.astro';

const packages = [
  {
    name: 'Launch',
    price: '3 750 €',
    description: 'L\'essentiel pour se lancer sur les grandes plateformes chinoises, avec un calendrier de publication ciblé.',
    highlighted: false,
    strategy: {
      competitor: 'Mois 1',
      contentStrategy: true,
      editorialCalendar: true,
      accountOpening: 'Selon besoin',
    },
    content: {
      wechat: '1 article/sem.',
      weibo: '1 publi./sem.',
      rednote: '1 publi./sem.',
      douyinClient: '1 vidéo/sem.',
      douyinAi: false,
      douyinTotal: '1/sem.',
    },
    ai: false,
    socialListening: false,
    support: {
      accountManager: true,
      chatSupport: true,
      monthlyReport: true,
      strategyCalls: '1 fois/mois',
    },
  },
  {
    name: 'Scale',
    price: '5 500 €',
    description: 'Trois fois plus de contenu grâce à la vidéo IA, avec un rythme de publication renforcé.',
    highlighted: true,
    strategy: {
      competitor: 'Mois 1',
      contentStrategy: true,
      editorialCalendar: true,
      accountOpening: 'Selon besoin',
    },
    content: {
      wechat: '1 article/sem.',
      weibo: '3 publi./sem.',
      rednote: '3 publi./sem.',
      douyinClient: '1 vidéo/sem.',
      douyinAi: '1 vidéo/sem.',
      douyinTotal: '2/sem.',
    },
    ai: true,
    socialListening: false,
    support: {
      accountManager: true,
      chatSupport: true,
      monthlyReport: true,
      strategyCalls: 'Chaque semaine',
    },
  },
  {
    name: 'Command',
    price: '6 750 €',
    description: 'Couverture totale. Publications au quotidien. Veille des conversations. Disponibilité sans restriction.',
    highlighted: false,
    strategy: {
      competitor: 'Mois 1',
      contentStrategy: true,
      editorialCalendar: true,
      accountOpening: 'Selon besoin',
    },
    content: {
      wechat: '1 article/sem.',
      weibo: '7 publi./sem.',
      rednote: '5 publi./sem.',
      douyinClient: '2 vidéos/sem.',
      douyinAi: '2 vidéos/sem.',
      douyinTotal: '4/sem.',
    },
    ai: true,
    socialListening: true,
    support: {
      accountManager: true,
      chatSupport: true,
      monthlyReport: true,
      strategyCalls: 'Sur demande',
    },
  },
];

const addOnPlatforms = [
{ category: 'Plateformes rédactionnelles', items: [
    { name: 'Zhihu (article de fond)', price: '90 €/article' },
    { name: 'Zhihu (réponse courte)', price: '45 €/article' },
    { name: 'Toutiao (article d\'actualité)', price: '65 €/article' },
    { name: 'Baidu Tieba (publication forum)', price: '40 €/publi.' },
  ]},
  { category: 'Commerce et art de vivre', items: [
    { name: 'Meituan / Dianping', price: '100 €/mois' },
    { name: 'Pinduoduo (fiche produit)', price: '75 €/publi.' },
    { name: 'Lemon8 (publication art de vivre)', price: '50 €/publi.' },
    { name: 'QQ (publication communautaire)', price: '35 €/publi.' },
  ]},
];
---

<BaseLayout
  title="Tarifs | TheRedScroll"
  description="Formules claires, tarifs fixes pour le marketing sur les réseaux sociaux chinois. WeChat, Douyin, RedNote, Weibo. A partir de 3 750 €/mois."
  lang="fr"
>
  <main class="pt-[60px] max-[640px]:pt-[52px]">

    <!-- Hero -->
    <section class="relative w-full bg-[#1A1A1A] rounded-none overflow-hidden py-[80px] max-[640px]:py-[48px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/pricing-bg.png')" aria-hidden="true"></div>
      <div class="relative z-[1] max-w-[800px] mx-auto text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">Tarifs</p>
        <h1 class="text-[#FFFFFF] text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] mb-[8px]">
          Cadrage net. Tarif fixe. Zéro surprise.
        </h1>
        <p class="text-[rgba(255,255,255,0.6)] text-[16px] font-normal leading-[1.6]">
          Tarifs en euros, hors taxes. Engagement de 6 mois sur l'ensemble des formules.
        </p>
      </div>
    </section>

    <!-- Core Packages Comparison Table -->
    <section class="mt-[96px] max-[640px]:mt-[64px]">
      <Container>
        <div class="text-center mb-[48px]">
          <div class="flex justify-center mb-[12px]"><SectionBar /></div>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A]">Nos formules</h2>
        </div>

        <!-- Desktop comparison table -->
        <div class="max-[640px]:hidden overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="w-[280px] p-[16px] align-bottom"></th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tl-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Launch</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">3 750 €<span class="text-[14px] text-[#5C5C5C] font-normal">/mois</span></p>
                  <Button variant="secondary" href="/fr/contact" class="mt-[16px] w-full justify-center text-[13px]">Démarrer</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] relative border-x-[3px] border-[#CC3333]">
                  <div class="absolute top-0 left-[-3px] right-[-3px] h-[3px] bg-[#CC3333]"></div>
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">Le plus choisi</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">5 500 €<span class="text-[14px] text-[#5C5C5C] font-normal">/mois</span></p>
                  <Button variant="primary" href="/fr/contact" class="mt-[16px] w-full justify-center text-[13px]">Démarrer</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tr-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Command</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">6 750 €<span class="text-[14px] text-[#5C5C5C] font-normal">/mois</span></p>
                  <Button variant="secondary" href="/fr/contact" class="mt-[16px] w-full justify-center text-[13px]">Démarrer</Button>
                </th>
              </tr>
            </thead>
            <tbody>
              <!-- Section: Strategy & Setup -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Stratégie et déploiement</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Analyse concurrentielle</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Mois 1</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">Mois 1</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Mois 1</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Stratégie éditoriale et axes de contenu</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Calendrier éditorial mensuel</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Création et configuration des comptes</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Selon besoin</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">Selon besoin</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Selon besoin</td>
              </tr>

              <!-- Section: Content -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Contenu</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">WeChat</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 article/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1 article/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 article/sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Weibo</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 publi./sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3 publi./sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">7 publi./sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">RedNote (Xiaohongshu)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 publi./sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3 publi./sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">5 publi./sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin (vidéo fournie par le client)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 vidéo/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1 vidéo/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2 vidéos/sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin (vidéo IA, 15 sec. max)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">1 vidéo/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2 vidéos/sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)] bg-[#F0F1F4]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium">Total Douyin</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center">1/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">2/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">4/sem.</td>
              </tr>

              <!-- Section: AI Production -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Production IA</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Vidéo générée par IA via HubStudio.ai</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Validation du brief avant tournage</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Social Listening -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Écoute des réseaux</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Suivi des mentions de la marque</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Suivi de l'activité concurrentielle</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Bilan mensuel de la perception</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">—</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Support & Reporting -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Suivi et accompagnement</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Un interlocuteur dédié</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Assistance par messagerie (lun.-ven.)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Rapport mensuel de performance</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Points stratégiques</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 fois/mois</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">Chaque semaine</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">Sur demande</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Mobile: stacked cards with full features (shown only on mobile) -->
        <div class="hidden max-[640px]:flex flex-col gap-[16px]">
          {packages.map((pkg) => {
            const dark = pkg.highlighted;
            const textPrimary = dark ? 'text-[#FFFFFF]' : 'text-[#1A1A1A]';
            const textSecondary = dark ? 'text-[rgba(255,255,255,0.6)]' : 'text-[#5C5C5C]';
            const borderColor = dark ? 'border-[rgba(255,255,255,0.1)]' : 'border-[rgba(0,0,0,0.06)]';

            const features = [
              { section: 'Stratégie et déploiement', items: [
                { label: 'Analyse concurrentielle', value: pkg.strategy.competitor },
                { label: 'Stratégie éditoriale et axes de contenu', value: pkg.strategy.contentStrategy },
                { label: 'Calendrier éditorial mensuel', value: pkg.strategy.editorialCalendar },
                { label: 'Création et configuration des comptes', value: pkg.strategy.accountOpening },
              ]},
              { section: 'Contenu', items: [
                { label: 'WeChat', value: pkg.content.wechat },
                { label: 'Weibo', value: pkg.content.weibo },
                { label: 'RedNote (Xiaohongshu)', value: pkg.content.rednote },
                { label: 'Douyin (vidéo client)', value: pkg.content.douyinClient },
                { label: 'Douyin (vidéo IA)', value: pkg.content.douyinAi },
                { label: 'Total Douyin', value: pkg.content.douyinTotal },
              ]},
              { section: 'Production IA', items: [
                { label: 'Vidéo générée par IA via HubStudio.ai', value: pkg.ai },
                { label: 'Validation du brief avant tournage', value: pkg.ai },
              ]},
              { section: 'Écoute des réseaux', items: [
                { label: 'Suivi des mentions de la marque', value: pkg.socialListening },
                { label: 'Suivi de l\'activité concurrentielle', value: pkg.socialListening },
                { label: 'Bilan mensuel de la perception', value: pkg.socialListening },
              ]},
              { section: 'Suivi et accompagnement', items: [
                { label: 'Un interlocuteur dédié', value: pkg.support.accountManager },
                { label: 'Assistance par messagerie (lun.-ven.)', value: pkg.support.chatSupport },
                { label: 'Rapport mensuel de performance', value: pkg.support.monthlyReport },
                { label: 'Points stratégiques', value: pkg.support.strategyCalls },
              ]},
            ];

            return (
              <div class:list={[
                'rounded-[12px] p-[24px]',
                dark ? 'bg-[#1A1A1A]' : 'bg-[#F0F1F4]'
              ]}>
                <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">
                  {dark ? 'Le plus choisi' : pkg.name}
                </p>
                {dark && <p class="text-[14px] font-medium text-[#FFFFFF] mb-[2px]">{pkg.name}</p>}
                <p class:list={['text-[28px] font-medium leading-[1.2] mb-[4px]', textPrimary]}>
                  {pkg.price}<span class:list={['text-[14px] font-normal', textSecondary]}>/mois</span>
                </p>
                <p class:list={['text-[13px] font-normal leading-[1.5] mb-[20px]', textSecondary]}>
                  {pkg.description}
                </p>

                <Button variant={dark ? 'primary' : 'secondary'} href="/fr/contact" class="w-full justify-center">Démarrer</Button>

                <div class="mt-[24px] flex flex-col gap-[20px]">
                  {features.map((group) => (
                    <div>
                      <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[8px]">{group.section}</p>
                      <div class="flex flex-col">
                        {group.items.map((item) => (
                          <div class:list={['flex justify-between items-center py-[8px] border-b', borderColor]}>
                            <span class:list={['text-[13px] font-normal', textPrimary]}>{item.label}</span>
                            <span class:list={['text-[13px] font-medium shrink-0 ml-[12px]',
                              item.value === true ? 'text-[#CC3333]' :
                              item.value === false ? textSecondary :
                              textPrimary
                            ]}>
                              {item.value === true ? '\u2713' : item.value === false ? '\u2014' : item.value}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
