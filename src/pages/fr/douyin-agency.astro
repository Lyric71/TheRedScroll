---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 750, decimals: 0, suffix: 'M', label: 'utilisateurs actifs chaque jour' },
  { value: 120, decimals: 0, suffix: ' min', label: 'passées chaque jour dans l’appli, en moyenne' },
  { value: 3.5, decimals: 1, suffix: 'T', label: 'de RMB de ventes e-commerce chaque année' },
  { value: 2, decimals: 0, suffix: ' semaines', label: 'entre la signature et la première publication' },
];

const scopeItems = [
  { label: 'Ouverture de compte et certification Blue V', href: '/fr/platforms/douyin/' },
  { label: 'Vidéos courtes en mandarin natif', href: '/fr/services/content-production/' },
  { label: 'Campagnes KOL et KOC via Xingtu', href: '/fr/services/influencer-marketing/' },
  { label: 'Publicité sur Ocean Engine', href: '/fr/services/advertising/' },
  { label: 'Live marchand et Douyin Shop', href: '/fr/platforms/douyin/' },
];

const services = [
  {
    glyph: '号',
    title: 'Ouverture et certification du compte',
    tag: 'Compte certifié, prêt à publier',
    description:
      'Nous ouvrons votre compte entreprise et obtenons la certification Blue V. Une marque étrangère doit présenter une licence commerciale chinoise ou passer par une agence habilitée. Nous maîtrisons les deux voies. Vous démarrez sans entité locale.',
    deliverables: ['Compte entreprise', 'Certification Blue V', 'Conseil sur la licence', 'Remise du compte'],
    image: '/images/platforms/douyin-services/setup-strategy.webp',
    imageAlt: 'Profil de compte entreprise Douyin certifié affiché sur un téléphone, posé près de documents d’immatriculation',
  },
  {
    glyph: '视',
    title: 'Stratégie éditoriale et production vidéo',
    tag: 'Des vidéos écrites en mandarin',
    description:
      'Des vidéos courtes conçues pour Douyin et tournées par notre équipe en Chine. Démos produit, tutoriels, formats de tendance, mini-dramas. HubStudio.ai accélère la production. Des rédacteurs et monteurs de langue maternelle signent chaque vidéo.',
    deliverables: ['Stratégie éditoriale', 'Vidéos courtes', 'Formats de tendance', 'Mini-dramas'],
    image: '/images/platforms/douyin-services/content-production.webp',
    imageAlt: 'Poste de montage avec une vidéo verticale Douyin en cours de finalisation sur un téléphone',
  },
  {
    glyph: '达',
    title: 'Campagnes KOL et KOC',
    tag: 'Des créateurs audités via Xingtu',
    description:
      'Nous réservons les KOL (Key Opinion Leader) et KOC (Key Opinion Consumer) via Xingtu, la place de marché officielle des créateurs Douyin. Notre propre réseau complète la sélection. Chaque profil est ausculté : faux abonnés, affinité d’audience. Vous validez la liste finale.',
    deliverables: ['Sourcing des KOL', 'Seeding KOC', 'Détection des faux abonnés', 'Bilan de campagne'],
    image: '/images/platforms/douyin-services/kol-campaigns.webp',
    imageAlt: 'Créatrice filmant une démonstration produit pour une campagne KOL sur Douyin',
  },
  {
    glyph: '广',
    title: 'Publicité payante via Ocean Engine',
    tag: 'Budget média refacturé au coût réel',
    description:
      'Ocean Engine (巨量引擎) est la régie publicitaire de ByteDance pour Douyin. TopView pour les grands lancements. In-Feed Ads pour le trafic quotidien. Search Ads pour les acheteurs en intention. DOU+ pour tester chaque contenu. Le budget média est refacturé au coût réel, sans marge.',
    deliverables: ['TopView', 'In-Feed Ads', 'Search Ads', 'Boosts DOU+'],
    image: '/images/platforms/douyin-services/advertising.webp',
    imageAlt: 'Publicité sponsorisée d’une marque insérée dans le fil vidéo Douyin, à l’écran d’un téléphone',
  },
  {
    glyph: '播',
    title: 'Live et Douyin Shop',
    tag: 'Vendre en direct, dans l’appli',
    description:
      'Le live marchand fait partie de l’ADN de Douyin. Nous préparons et animons vos sessions de vente en direct : choix de l’animateur, conducteur produit, interaction avec les spectateurs. Nous installons et optimisons aussi votre boutique Douyin Shop (抖音小店).',
    deliverables: ['Préparation des lives', 'Choix de l’animateur', 'Conducteur produit', 'Installation de Douyin Shop'],
    image: '/images/platforms/douyin-services/live-commerce.webp',
    imageAlt: 'Animatrice présentant des produits face caméra pendant un live marchand sur Douyin',
  },
  {
    glyph: '数',
    title: 'Analyse, reporting et optimisation',
    tag: 'Un bilan chiffré chaque mois',
    description:
      'Chaque mois, un rapport aux chiffres nets. Croissance des abonnés, vues, engagement, performance publicitaire, GMV et ROAS dès que vous vendez dans l’appli. Ce qui a fonctionné, ce qui a échoué, ce qui change le mois suivant.',
    deliverables: ['Croissance des abonnés', 'Taux d’engagement', 'GMV et ROAS', 'Plan du mois suivant'],
    image: '/images/blog/douyin-control-room.webp',
    imageAlt: 'Écrans de contrôle suivant les abonnés, l’engagement et les ventes d’un compte Douyin',
  },
];

const segments = [
  {
    title: 'Beauté et mode',
    description: 'Le secteur roi de Douyin. Démos express, tutoriels et avis de créateurs nourrissent la découverte, et l’achat se conclut dans l’appli.',
    icon: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  },
  {
    title: 'Alimentation et boissons',
    description: 'Dégustations, recettes minute, coulisses de fabrication. Ces formats transforment les curieux en premiers acheteurs, dans le fil comme en live.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Électronique grand public et maison',
    description: 'Une démonstration produit convainc en quelques secondes. C’est précisément le type de vidéo que l’algorithme met en avant.',
    icon: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  },
  {
    title: 'Hôtellerie, automobile et B2B',
    description: 'Hôtellerie, automobile, santé, B2B : chacun y trouve son public. Ville de premier ou de cinquième rang, 22 ou 52 ans, vos clients chinois y sont déjà.',
    icon: '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>',
  },
];

const pillars = [
  {
    title: 'Une équipe sur place',
    description: 'Shanghai et Hong Kong. Des natifs du mandarin qui publient sur Douyin tous les jours, pas des consultants qui suivent le sujet de loin.',
  },
  {
    title: 'Périmètre ferme, prix ferme',
    description: 'En avril 2026, nous avons passé 37 agences au banc d’essai. 0 sur 37 affiche des formules à prix ferme. Nous, si. Chaque livrable est écrit noir sur blanc.',
  },
  {
    title: 'Un interlocuteur en anglais',
    description: 'Un responsable de compte dédié, qui connaît votre marque. Les échanges se font en anglais, les contenus s’écrivent en mandarin.',
  },
  {
    title: 'La conformité prise en charge',
    description: 'Licences, certification du compte, règles éditoriales, validation des publicités. Nous absorbons la paperasse pour que vos campagnes avancent sans à-coups.',
  },
];

const steps = [
  {
    title: 'Audit',
    description:
      'Nous radiographions votre catégorie sur Douyin. Concurrents, formats, niveaux de prix et ce que l’algorithme favorise dans votre secteur en ce moment.',
  },
  {
    title: 'Stratégie',
    description:
      'Piliers éditoriaux, calendrier de publication, présélection des KOL, plan média, objectifs chiffrés. Le tout consigné dans un SOW précis, à prix ferme.',
  },
  {
    title: 'Localisation',
    description:
      'Rien n’est traduit. Notre équipe de langue maternelle crée chaque contenu de zéro, pour un public chinois. Sur Douyin, les vidéos traduites plafonnent vite.',
  },
  {
    title: 'Lancement',
    description:
      'Compte certifié et première publication en ligne dans les deux semaines qui suivent la signature. Votre responsable de compte échange avec vous en anglais. Aucun sinophone requis chez vous.',
  },
  {
    title: 'Montée en puissance',
    description:
      'Nous renforçons ce qui marche. Les formats gagnants reçoivent plus de budget via DOU+ et Ocean Engine, les autres sortent du plan. Le rapport mensuel trace chaque décision.',
  },
];

const caseStudies = [
  {
    client: "AGE 20's",
    image: '/images/clients/Age20/Age20-Picture1-scaled.jpg',
    imageAlt: 'Visuel de la campagne AGE 20’s pour le lancement de son fond de teint en Chine',
    metric: '3.87M',
    metricLabel: 'impressions sur Douyin, objectif fixé à 1 M',
    summary: 'Marque de beauté coréenne, lancement d’un fond de teint en Chine. La campagne a atteint 3,87 millions d’impressions sur Douyin, pour un objectif fixé à 1 million. Le surnom du produit s’est installé de lui-même.',
    href: '/fr/work/age20s/',
  },
  {
    client: 'Langnese',
    image: '/images/clients/Langnese/Langnese-Douyin-Livestream.jpg',
    imageAlt: 'Miel Langnese présenté pendant un live marchand sur Douyin',
    metric: 'Live',
    metricLabel: 'le direct au service d’une marque patrimoniale',
    summary: 'Marque de miel allemande repositionnée pour le consommateur chinois. Lives Douyin et démonstrations express ont déplacé les usages du produit, en appui des ventes sur Tmall.',
    href: '/fr/work/langnese/',
  },
];

const faqs = [
  {
    q: 'Une marque étrangère peut-elle faire de la publicité sur Douyin ?',
    a: 'Oui. Les marques étrangères diffusent leurs publicités sur Douyin via une agence habilitée comme TheRedScroll. Nous ouvrons le compte, pilotons les campagnes dans Ocean Engine et refacturons le budget média au coût réel. Aucune immatriculation locale n’est exigée.',
  },
  {
    q: 'Faut-il une licence commerciale chinoise ou une WFOE ?',
    a: 'Pas pour commencer. Un compte entreprise exige une licence commerciale chinoise ou le passage par une agence habilitée, et nous couvrons cette seconde voie. Pour vendre sur Douyin Shop, des dispositifs transfrontaliers existent sans entité chinoise. Nous recommandons le bon montage dès le premier échange.',
  },
  {
    q: 'Combien coûte une agence Douyin ?',
    a: 'La plupart des agences pratiquent le devis sur mesure, aux livrables flous. Nous travaillons en formules à prix ferme, chaque livrable listé d’emblée. Le budget média Ocean Engine est facturé à part, au coût réel, sans marge. Prenez rendez-vous, nous vous orienterons vers la formule adaptée à votre budget.',
  },
  {
    q: 'Qu’est-ce qui distingue Douyin de TikTok pour un annonceur ?',
    a: 'Deux applis distinctes, toutes deux exploitées par ByteDance, sans aucun contenu commun. Douyin couvre la Chine continentale et s’achète via Ocean Engine, sa propre régie. Le commerce intégré y est bien plus abouti : boutiques, vente en direct, paiement sans quitter l’appli. Une stratégie TikTok ne se transpose pas.',
  },
  {
    q: 'Combien de temps avant les premiers résultats ?',
    a: 'Une campagne payante peut produire des résultats en quelques jours. L’organique demande en général 8 à 12 semaines de publication régulière. L’algorithme récompense le visionnage complet et la constance : 3 à 5 publications par semaine, c’est le plancher que nous tenons.',
  },
  {
    q: 'Peut-on réutiliser nos vidéos TikTok sur Douyin ?',
    a: 'Rarement telles quelles. Douyin détecte les vidéos réimportées avec filigrane et bride leur diffusion. Le public attend du mandarin, des références locales et des formats propres à la plateforme. Nous reprenons parfois un concept solide, mais la vidéo est refaite entièrement, en Chine, pour un public chinois.',
  },
  {
    q: 'Comment fonctionnent les campagnes KOL sur Douyin ?',
    a: 'Les créateurs sont réservés via Xingtu, la place de marché officielle de ByteDance, avec des données d’audience et d’engagement vérifiées à chaque réservation. La sélection se joue sur l’affinité et la performance, pas sur le compteur d’abonnés. Brief, contrats, paiements et droits d’usage passent par nous. Et un maillage de petits KOC bat souvent une grosse signature.',
  },
  {
    q: 'Comment Douyin Shop fonctionne-t-il pour les marques étrangères ?',
    a: 'Douyin dispose d’un programme transfrontalier pour les marques sans entité chinoise. La vente passe par une boutique dédiée, avec expédition depuis un entrepôt sous douane ou depuis l’étranger. Catégories admises, cautions et justificatifs varient : nous vérifions l’éligibilité avant d’ouvrir quoi que ce soit. Directs et vidéos courtes mènent ensuite droit au paiement.',
  },
  {
    q: 'Faut-il des sinophones dans notre équipe ?',
    a: 'Non. Votre interlocuteur travaille en anglais : stratégie, validations, rapports. Tout le versant chinois, des scripts et sous-titres aux réponses en commentaires, revient à notre équipe de langue maternelle. Vous validez des synthèses en anglais, jamais des documents bruts en chinois.',
  },
  {
    q: 'Comment mesurez-vous le succès d’une campagne Douyin ?',
    a: 'À l’aune des objectifs inscrits dans votre périmètre de travail. Le rapport mensuel détaille vues, taux de visionnage complet, croissance d’abonnés, engagement, performance publicitaire sur Ocean Engine et, le cas échéant, ventes en direct. Chaque rapport se clôt sur des recommandations pour le mois suivant. Les formats qui déçoivent sont retirés, pas défendus.',
  },
];
---

<PageLayout
  title="Agence Douyin pour marques internationales | TheRedScroll"
  description="Agence Douyin : ouverture de compte, vidéos en mandarin, campagnes KOL, publicité Ocean Engine, live marchand. Équipe à Shanghai et Hong Kong. Prix fermes."
  lang="fr"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      抖音
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">抖</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Agence Douyin</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            Agence Douyin : installez votre marque sur la première plateforme de vidéo courte de Chine
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Ouverture de compte, vidéos, campagnes KOL, publicité Ocean Engine et live marchand. Le tout piloté depuis Shanghai et Hong Kong. Périmètre ferme, prix ferme.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/fr/contact/">Prendre rendez-vous</Button>
            <Button variant="secondary-dark" href="#results">Voir les résultats</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Trente minutes d’échange, sans argumentaire commercial.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/douyin-agency/hero-phones-blend.webp"
            alt="Deux téléphones affichant de vrais écrans Douyin : un fil de vidéos verticales avec fiche produit et un live marchand"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Pourquoi Douyin compte
          </p>
          <p class="manifesto" data-manifesto>
            Douyin n’est pas TikTok. C’est l’économie chinoise de la vidéo courte. 750 millions de personnes y regardent, y achètent et y paient sans jamais sortir de l’appli. Si votre marque n’occupe pas le fil, votre <span class="manifesto-hl">concurrent</span> s’en charge.
          </p>
        </div>
        <div>
          <img
            src="/images/douyin-agency/ecosystem-banner-tight.webp"
            alt="Trois téléphones montrant les trois visages de Douyin : le fil vidéo, un live marchand et une page produit Douyin Shop"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Une seule appli, trois métiers : divertir, vendre en direct, encaisser.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Ce qu’une agence Douyin apporte aux marques qui entrent en Chine
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Douyin (抖音) réunit chaque jour 750 millions de personnes en Chine. Vos clients y sont. Vos concurrents, sans doute déjà aussi.
            </p>
            <p>
              TheRedScroll est une agence de réseaux sociaux implantée en Chine. Nous ouvrons les comptes Douyin des marques étrangères et produisons leurs vidéos en mandarin natif. Nous menons aussi les campagnes KOL, achetons la publicité via Ocean Engine et vendons en direct et sur Douyin Shop.
            </p>
            <p>
              Chaque mission repose sur un SOW, le périmètre de travail, et sur un prix ferme. Vous savez ce que vous recevez, et à quel prix, avant de signer.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Le périmètre d’un coup d’œil
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Nos prestations d’agence Douyin</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Six prestations, chacune assortie de livrables précis
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Tout est consigné dans votre périmètre de travail avant signature. Aucun forfait flou.
              </p>
            </div>
            <div class="svc-frame relative max-[900px]:hidden">
              <div class="relative w-full aspect-[1344/570] rounded-[10px] overflow-hidden bg-[#FFFFFF]">
                {services.map((service, i) => (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="1344"
                    height="570"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class:list={['svc-img absolute inset-0 w-full h-full object-cover', i === 0 && 'is-active']}
                    data-svc-img={i}
                  />
                ))}
