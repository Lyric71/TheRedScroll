---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="L'IA a tout changé | TheRedScroll"
  description="L'intelligence artificielle est intégrée à chacun de nos services, sur chaque plateforme, pour chaque client. La stratégie demeure humaine. La direction créative aussi. L'IA, elle, prend en charge tout le reste."
  lang="fr"
>

  <!-- Hero — same pattern as about page: background image + dark overlay -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[500px] overflow-hidden">
    <img
      src="/images/ai/ai-hero.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.82]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Notre IA
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        L'IA a tout déplacé. Nous l'avons intégrée à notre quotidien.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Dans chacun de nos métiers. Sur chaque plateforme. Pour chaque client.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/fr/contact">Prendre rendez-vous</Button>
        <Button variant="secondary-dark" href="#how-it-works">Voir le mode opératoire</Button>
      </div>
    </div>
  </section>

  <!-- Intro — two-column, same as "Why we exist" on about page -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <!-- Left -->
        <div>
          <SectionBar />
          <SectionHeading overline="Pourquoi l'IA">Chez nous, l'IA n'est pas un discours. C'est une méthode de travail.</SectionHeading>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Études de marché, veille conversationnelle, reporting, analyse de performance, gestion de projet, rédaction, production d'images et de vidéos. Pour chaque mission, pour chaque client, au quotidien.
          </p>
        </div>
        <!-- Right -->
        <div class="flex flex-col pt-[48px] max-[640px]:pt-[0px]">
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] w-full">
            <p>
              Aucune intention de remplacer qui que ce soit. L'enjeu reste de mieux travailler. L'IA absorbe les tâches répétitives ; notre équipe se concentre sur l'essentiel : stratégie, création, relation client.
            </p>
            <p>
              La distinction se fait là : entre ceux qui parlent de l'IA et ceux qui s'en servent quotidiennement.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- AI does the work — two-column with SVG illustration (same as "Our mission" on about) -->
  <section id="how-it-works" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="L'IA renforce chaque étape du flux de travail">
          <svg viewBox="0 0 440 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Title -->
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">FLUX DE TRAVAIL ASSISTÉ PAR L'IA</text>

            <!-- Step 1: Research -->
            <rect x="20" y="48" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="48" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="68" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">01</text>
            <text x="60" y="68" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">Recherche</text>
            <text x="40" y="86" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">L'IA passe au crible des milliers de posts et de comptes concurrents</text>
            <rect x="340" y="58" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="73" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">En heures, pas en semaines</text>

            <!-- Arrow -->
            <line x1="220" y1="100" x2="220" y2="116" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,114 220,122 225,114" fill="#E8E0D8" />

            <!-- Step 2: Content -->
            <rect x="20" y="124" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="124" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="144" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">02</text>
            <text x="60" y="144" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">Production de contenu</text>
            <text x="40" y="162" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">L'IA rédige les textes, produit les visuels via HubStudio.ai</text>
            <rect x="340" y="134" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="149" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">80 % plus rapide</text>

            <!-- Arrow -->
            <line x1="220" y1="176" x2="220" y2="192" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,190 220,198 225,190" fill="#E8E0D8" />

            <!-- Step 3: Review (human) -->
            <rect x="20" y="200" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#1A1A1A" stroke-width="1" />
            <rect x="20" y="200" width="4" height="52" rx="2" fill="#1A1A1A" />
            <text x="40" y="220" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif">03</text>
            <text x="60" y="220" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">Relecture humaine</text>
            <text x="40" y="238" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Les rédacteurs natifs retravaillent. L'équipe créative valide.</text>
            <rect x="340" y="210" width="68" height="22" rx="4" fill="#1A1A1A" opacity="0.08" stroke="#1A1A1A" stroke-width="0.5" />
            <text x="374" y="225" text-anchor="middle" fill="#1A1A1A" font-size="7" font-weight="500" font-family="Inter, sans-serif">100 % humain</text>

            <!-- Arrow -->
            <line x1="220" y1="252" x2="220" y2="268" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,266 220,274 225,266" fill="#E8E0D8" />

            <!-- Step 4: Reporting -->
            <rect x="20" y="276" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="276" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="296" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">04</text>
            <text x="60" y="296" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">Reporting</text>
            <text x="40" y="314" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">L'IA rassemble les données. Les stratèges les interprètent.</text>
            <rect x="340" y="286" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="301" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">Données en temps réel</text>

            <!-- Bottom stats -->
            <line x1="20" y1="348" x2="420" y2="348" stroke="#E8E0D8" stroke-width="0.5" />

            <g transform="translate(20, 364)">
              <text x="0" y="12" fill="#CC3333" font-size="18" font-weight="500" font-family="Inter, sans-serif">IA</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">absorbe le volume</text>
            </g>
            <g transform="translate(150, 364)">
              <text x="0" y="12" fill="#1A1A1A" font-size="18" font-weight="500" font-family="Inter, sans-serif">Humains</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">gardent la main sur la réflexion</text>
            </g>
            <g transform="translate(310, 364)">
              <text x="0" y="12" fill="#1A1A1A" font-size="18" font-weight="500" font-family="Inter, sans-serif">100 %</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">relu par des humains</text>
            </g>
          </svg>
        </div>
        <div>
          <SectionBar />
          <SectionHeading overline="Comment ça fonctionne">À l'IA la production. À nous la réflexion.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Nos responsables réseaux sociaux travaillent main dans la main avec l'IA. Les tâches répétitives, celles qui mangent du temps sans apporter de valeur, s'effacent. Il ne reste que le travail qui compte vraiment.
            </p>
            <p>
              La stratégie reste humaine. La direction créative aussi. La relation client également. L'IA ne fait qu'en amplifier la portée, en débarrassant le chemin de tout ce qui encombre.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- AI vs Human table — two-column with SVG on right (same as "Our vision" on about, reversed) -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Qui fait quoi">À l'IA le volume. À l'humain le jugement.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              L'IA rédige en chinois comme en anglais. Notre équipe, elle, pose les fondations : voix de marque, piliers éditoriaux. L'IA produit les visuels et les vidéos ; notre équipe arbitre la direction créative et valide chaque élément avant publication.
            </p>
            <p>
              L'IA consolide les données de performance dans des rapports structurés. Nos stratèges les décryptent et réorientent votre stratégie en conséquence. L'IA passe au crible des milliers de profils KOL (Key Opinion Leaders) et démasque les faux abonnés. Notre équipe choisit les bons influenceurs et négocie les contrats.
            </p>
          </div>
          <!-- Callout — same pattern as about page "Our vision" callout -->
          <div class="bg-[#F0F1F4] border-l-[3px] border-[#CC3333] rounded-none p-[20px] mt-[24px]">
            <p class="text-[16px] font-normal text-[#1A1A1A] leading-[1.6] m-0">
              Chaque contenu est relu par un humain avant publication. Sans exception.
            </p>
          </div>
        </div>
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="Répartition des responsabilités entre l'IA et l'humain">
          <svg viewBox="0 0 440 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Title -->
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">QUI FAIT QUOI</text>

            <!-- Column headers -->
            <rect x="20" y="44" width="196" height="28" rx="4" fill="#CC3333" opacity="0.1" />
            <text x="118" y="62" text-anchor="middle" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">L'IA S'EN CHARGE</text>
            <rect x="224" y="44" width="196" height="28" rx="4" fill="#1A1A1A" opacity="0.06" />
            <text x="322" y="62" text-anchor="middle" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">NOTRE ÉQUIPE S'EN CHARGE</text>

            <!-- Row 1 -->
            <line x1="20" y1="84" x2="420" y2="84" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="102" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Rédige en chinois et en anglais</text>
            <text x="232" y="102" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Pose la voix de marque et les piliers éditoriaux</text>

            <!-- Row 2 -->
            <line x1="20" y1="116" x2="420" y2="116" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="134" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Produit les visuels et les vidéos</text>
            <text x="232" y="134" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Tranche sur la direction créative, valide chaque élément</text>

            <!-- Row 3 -->
            <line x1="20" y1="148" x2="420" y2="148" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="166" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Rassemble les données de performance</text>
            <text x="232" y="166" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Décortique les chiffres et ajuste la stratégie</text>

            <!-- Row 4 -->
            <line x1="20" y1="180" x2="420" y2="180" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="198" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Surveille les mentions et repère les tendances</text>
            <text x="232" y="198" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Décide ce qu'il faut exploiter, et comment</text>

            <!-- Row 5 -->
            <line x1="20" y1="212" x2="420" y2="212" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="230" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Suit les délais et les validations</text>
            <text x="232" y="230" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Anime les ateliers, pose les questions qui comptent</text>

            <!-- Row 6 -->
            <line x1="20" y1="244" x2="420" y2="244" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="262" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Passe au crible des milliers de posts concurrents</text>
            <text x="232" y="262" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Choisit les plateformes adaptées à votre cible</text>

            <!-- Row 7 -->
            <line x1="20" y1="276" x2="420" y2="276" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="294" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Rédige les premières versions des rapports mensuels</text>
            <text x="232" y="294" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Formule les recommandations stratégiques</text>

            <!-- Row 8 -->
            <line x1="20" y1="308" x2="420" y2="308" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="326" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Filtre les profils KOL, repère les faux abonnés</text>
            <text x="232" y="326" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Sélectionne les influenceurs, négocie les contrats</text>
            <line x1="20" y1="340" x2="420" y2="340" stroke="#E8E0D8" stroke-width="0.5" />

            <!-- Bottom summary -->
            <g transform="translate(20, 360)">
              <rect x="0" y="0" width="196" height="40" rx="6" fill="#CC3333" opacity="0.08" />
              <text x="98" y="17" text-anchor="middle" fill="#CC3333" font-size="14" font-weight="500" font-family="Inter, sans-serif">Rapidité et volume</text>
              <text x="98" y="32" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Volume, données, premières versions</text>
            </g>
            <g transform="translate(224, 360)">
              <rect x="0" y="0" width="196" height="40" rx="6" fill="#1A1A1A" opacity="0.06" />
              <text x="98" y="17" text-anchor="middle" fill="#1A1A1A" font-size="14" font-weight="500" font-family="Inter, sans-serif">Jugement et sensibilité</text>
              <text x="98" y="32" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Stratégie, nuances, relations</text>
            </g>
          </svg>
        </div>
      </div>
    </Container>
  </section>

  <!-- Better content — rice paper card, same as about page "clients who trust" stats section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#F0F1F4] rounded-[10px] p-[48px] max-[1024px]:p-[32px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[24px] text-center">Du contenu de qualité. Jamais de contenu au rabais.</p>
        <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[32px] max-[640px]:gap-[24px] text-center">
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]">0</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">Contenus IA génériques publiés</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]">100 %</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">Contenus relus par un humain</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#CC3333] mb-[4px]">Chaque texte</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">Retravaillé par des rédacteurs chinois natifs</p>
          </div>
        </div>
        <div class="max-w-[680px] mx-auto mt-[32px] flex flex-col gap-[24px] text-center">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Nous ne publions jamais de contenu IA au rabais. Pas de posts génériques, pas de légendes mécaniques, pas d'images artificielles déversées dans un fil d'actualité. Sur les plateformes chinoises, c'est le moyen le plus sûr de perdre ses abonnés et toute forme de crédibilité.
          </p>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">
            L'IA écrit ; des rédacteurs chinois natifs reprennent chaque texte. L'IA génère les visuels via HubStudio.ai ; notre équipe créative contrôle chaque image. L'IA extrait les données ; nos stratèges les analysent et en tirent des enseignements clairs.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Where AI shows up — numbered cards, same as about page "Our values" grid -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Applications">Là où l'IA intervient, concrètement</SectionHeading>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-market-research.svg" alt="Illustration études de marché" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Études de marché</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">L'IA épluche des milliers de publications, commentaires et comptes concurrents en quelques heures. Là où il en fallait plusieurs semaines.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-social-listening.svg" alt="Illustration veille sociale" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Veille sociale</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Une surveillance continue sur WeChat, Douyin, RedNote, Weibo et quatorze autres plateformes. L'IA repère les signaux faibles, capte les variations de sentiment et traque les mentions de marque, en temps réel.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-content-writing.svg" alt="Illustration rédaction de contenu" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Rédaction</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">L'IA produit les premières versions, en chinois comme en anglais. Des rédacteurs natifs retravaillent ensuite le ton, les références culturelles et les codes propres à chaque plateforme.</p>
