---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { faqPageSchema, serviceSchema } from '../lib/schema';

const heroStats = [
  { value: 1.4, decimals: 1, suffix: 'B', label: 'monthly active users' },
  { value: 945, decimals: 0, suffix: 'M', label: 'Mini Program users' },
  { value: 18, decimals: 0, suffix: '', label: 'Chinese platforms covered' },
  { value: 4, decimals: 0, suffix: ' weeks', label: 'from contract to first post' },
];

const scopeItems = [
  { label: 'Official Account setup and verification', href: '/platforms/wechat/' },
  { label: 'Content written by native Chinese speakers', href: '/services/content-production/' },
  { label: 'Moments Ads, Official Account Ads, Mini Program Ads', href: '/services/advertising/' },
  { label: 'Mini Programs and WeChat e-commerce', href: '/platforms/wechat/' },
  { label: 'WeCom CRM and private domain traffic', href: '/services/crm-private-domain/' },
];

const services = [
  {
    glyph: '号',
    title: 'Official Account setup and verification',
    tag: 'Live in 1 to 2 weeks',
    description:
      'We register your Service Account, prepare Tencent\'s paperwork, and push it through verification. Menus, auto-replies, and brand assets included. Most accounts go live within 1 to 2 weeks.',
    deliverables: ['Registration', 'Tencent verification', 'Menus and auto-replies', 'Brand assets'],
    image: '/images/wechat-agency/service-setup.webp',
    imageAlt: 'Phone on a desk next to business registration documents, showing a verified WeChat Official Account brand profile',
  },
  {
    glyph: '文',
    title: 'Content and CRM',
    tag: 'Native Chinese copywriters',
    description:
      'Content pillars, editorial calendar, articles, graphics, and video. Native Chinese copywriters, not translators. Every follower flows into WeCom so you build a customer list no platform can take from you.',
    deliverables: ['Editorial calendar', 'Articles', 'Graphics and video', 'WeCom setup'],
    image: '/images/wechat-agency/service-content.webp',
    imageAlt: 'Editorial desk with a phone showing a branded WeChat Official Account article being scrolled',
  },
  {
    glyph: '广',
    title: 'WeChat advertising',
    tag: 'Ad spend at cost, no markup',
    description:
      'Media planning, creative, A/B tests, and bid work across Moments Ads, Official Account Ads, and Mini Program Ads. Ad spend is billed at cost. No markup, ever.',
    deliverables: ['Media plan', 'Ad creative', 'A/B tests', 'Bid management'],
    image: '/images/wechat-agency/service-ads.webp',
    imageAlt: 'Hand holding a phone in a cafe, showing a sponsored brand ad inside the WeChat Moments feed',
  },
  {
    glyph: '店',
    title: 'Mini Programs and e-commerce',
    tag: '945M monthly users',
    description:
      'Stores, lead capture, bookings, and loyalty programs built inside WeChat and connected to WeChat Pay. 945M people use Mini Programs every month. Your readers get a next step that converts.',
    deliverables: ['Storefront', 'WeChat Pay', 'Lead capture', 'Loyalty programs'],
    image: '/images/wechat-agency/service-miniprogram.webp',
    imageAlt: 'Two phones side by side showing a WeChat Mini Program storefront and a WeChat Pay payment success screen',
  },
  {
    glyph: '播',
    title: 'KOL and cross-promotion campaigns',
    tag: 'Verified engagement data only',
    description:
      'Key Opinion Leader (KOL) sourcing, vetting, briefs, and reporting. We only work with verified engagement data. If a follower count looks inflated, we pass.',
    deliverables: ['KOL sourcing', 'Vetting', 'Campaign briefs', 'Reporting'],
    image: '/images/wechat-agency/service-kol.webp',
    imageAlt: 'Content creator filming a product video, with a phone showing a WeChat Channels live stream',
  },
];

const segments = [
  {
    title: 'B2C retail and luxury',
    description: 'Chinese consumers check WeChat before they buy. We build the Official Account, content, and Mini Program store that close that loop.',
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  },
  {
    title: 'B2B and industrial',
    description: 'Long sales cycles need a follow-up channel. WeChat articles plus WeCom outreach turn trade-show contacts into pipeline.',
    icon: '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
  },
  {
    title: 'Tourism and education',
    description: 'Chinese travelers and students research on WeChat months before they commit. We keep your brand in that conversation.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'Cross-border e-commerce',
    description: 'Sell to China without a Chinese entity. Mini Program storefronts and cross-border WeChat Pay make it possible.',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  },
];

const pillars = [
  {
    title: 'Clear SOW',
    description: 'Every deliverable is defined upfront. Articles, videos, campaigns, reports. You know exactly what you get each month.',
  },
  {
    title: 'Fixed price, no surprises',
    description: 'One price per package. No hourly rates, no scope creep charges, no invoices you weren\'t expecting.',
  },
  {
    title: 'AI-powered content production',
    description: 'Visuals and video powered by HubStudio.ai, which keeps costs down and output fast. Strategy is 100% human-led.',
  },
  {
    title: 'Team on the ground',
    description: 'Shanghai and Hong Kong. Native speakers who use WeChat every day, with direct KOL relationships and real-time platform access.',
  },
];

const steps = [
  {
    title: 'Discovery call',
    description: '30 minutes. Tell us about your brand, your goals, and where you stand with China right now. No pitch deck.',
  },
  {
    title: 'Proposal',
    description: 'Clear SOW. Fixed price. Every deliverable listed out. You see what you\'re getting and what it costs before you commit.',
  },
  {
    title: 'Live in 4 weeks',
    description: 'Onboarding, account setup, verification, and first content published. Four weeks from signed contract to first post.',
  },
];

const caseStudies = [
  {
    client: 'JAC Motors',
    image: '/images/clients/JAC/JAC-Wechat-4.webp',
    imageAlt: 'JAC Motors WeChat content produced by TheRedScroll',
    metric: '10M',
    metricLabel: 'vehicles sold, community rebuilt',
    summary: 'A Chinese auto giant with 10 million vehicles sold and a quiet social presence. We rebuilt the community across WeChat, RedNote, and Weibo with AI-powered content.',
    href: '/work/jac-motors/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Mission Foods campaign visual for the China launch',
    metric: 'Gen Z',
    metricLabel: 'campaigns for a new food category',
    summary: 'Launching corn chips, an unfamiliar food category, in China. Gen Z campaigns and food pairing content across WeChat, RedNote, and Weibo.',
    href: '/work/mission-foods/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Camper footwear campaign visual for China social media',
    metric: '187K',
    metricLabel: 'followers, up from 43K in 18 months',
    summary: 'A European footwear brand that grew from 43K to 187K followers in 18 months, with engagement up from 1.2% to 4.7% and same-store sales up 31% year over year.',
    href: '/work/camper/',
  },
];

const faqs = [
  {
    q: 'Do I need a China business license to open a WeChat Official Account?',
    a: 'No. Foreign companies can register a WeChat Service Account with an overseas business license. You need company registration documents, a legal representative\'s ID, and proof of brand ownership. A Chinese entity only becomes necessary for Subscription accounts, domestic WeChat Pay merchant status, and some ad formats.',
  },
  {
    q: 'What is the difference between a Subscription and a Service account?',
    a: 'Subscription accounts publish daily but sit in a folded inbox and are only available to Chinese entities. Service Accounts publish 4 times per month, land directly in the chat list, and support custom menus, WeChat Pay, and CRM tools. Service Accounts are the only type foreign companies can register on their own, and for most brands they are the better choice anyway.',
  },
  {
    q: 'How much does WeChat marketing cost?',
    a: 'Two budgets matter. Agency work: we quote a fixed monthly price against a clear scope of work, so you know every deliverable and the full cost before you sign. Ad spend: Moments Ads run on auction bidding with entry budgets around RMB 1,000 per day, while premium scheduled placements start near RMB 50,000 per campaign. Ad spend is always billed separately at cost, with no markup.',
  },
  {
    q: 'How long does account setup and verification take?',
    a: 'With complete documents, registration and Tencent verification take 1 to 2 weeks. Missing or inconsistent paperwork is the most common cause of delays, so we review everything before submission. If you already have a verified account, we can start publishing within days.',
  },
  {
    q: 'Can you run WeChat if I have no team in China?',
    a: 'Yes. That is the most common setup for our clients. Our team in Shanghai and Hong Kong runs your account day to day: strategy, content, publishing, community replies, ads, and monthly reporting in plain English. You get a dedicated account manager and full visibility, without hiring anyone in China.',
  },
  {
    q: 'Who owns the WeChat account and its followers?',
    a: 'You do. The account is registered under your company name with your own documents. We operate it on your behalf. If we ever part ways, you keep the account, the followers, and the full content archive.',
  },
  {
    q: 'Can you take over an existing WeChat account?',
    a: 'Yes. We start with an audit: verification status, follower quality, content history, and compliance risks. Then we fix what needs fixing and take over publishing. Most handovers are complete within a week, with no downtime for your followers.',
  },
  {
    q: 'Should I start with WeChat or with RedNote and Douyin?',
    a: 'It depends on your goal. WeChat is where Chinese consumers read, ask questions, and buy, so it works as your home base. RedNote and Douyin are discovery platforms that bring new audiences in. Most of our clients run WeChat as the hub and add discovery platforms around it.',
  },
  {
    q: 'What is private domain traffic and why does it matter?',
    a: 'Private domain traffic means followers you can reach directly, without paying for ads each time. In practice, it means moving WeChat followers into WeCom groups and 1-to-1 chats. You own that list. An algorithm change can never take it away from you.',
  },
  {
    q: 'How do you report performance?',
    a: 'One monthly report in plain English. It covers follower growth, article reads, engagement, ad spend at cost, and leads or sales where tracking allows. You also get a dedicated account manager you can message any time with questions.',
  },
];

const pageSchemas = [
  serviceSchema({
    name: 'WeChat Agency Services',
    description:
      'Full-service WeChat agency for international brands: Official Account setup and verification, content, advertising, Mini Programs, and WeCom CRM.',
    url: '/wechat-agency',
    serviceType: 'Social Media Marketing',
  }),
  faqPageSchema(faqs),
];
---

<PageLayout
  title="WeChat Agency for Brands Growing in China | TheRedScroll"
  description="A full-service WeChat agency in Shanghai and Hong Kong. Official Account setup, content, ads, Mini Programs, and CRM. Fixed scope, fixed price."
  schema={pageSchemas}
  omitLocales={['fr', 'zh', 'de', 'es']}
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      微信
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">微</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">WeChat agency</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            The WeChat agency for brands growing in China
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Official Account setup, content, advertising, Mini Programs, and CRM. Run from Shanghai and Hong Kong, every day. Fixed scope. Fixed price.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/contact/">Book a call</Button>
            <Button variant="secondary-dark" href="#results">See the results</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            A 30-minute call. No pitch deck.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/wechat-agency/hero-phones-blend.webp"
            alt="Two phones showing real WeChat screens: the Moments feed with a sponsored brand ad, and a WeChat Pay payment success screen"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Why WeChat comes first
          </p>
          <p class="manifesto" data-manifesto>
            In China, WeChat is not an app. It is the internet. Your customers chat, read, shop, and pay without ever leaving it. A brand that is not on WeChat is <span class="manifesto-hl">invisible</span> to them.
          </p>
        </div>
        <div>
          <img
            src="/images/wechat-agency/ecosystem-banner-tight.webp"
            alt="Three phones side by side showing the three sides of WeChat: the Moments feed, an Official Account article, and a WeChat Pay payment success screen"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            One app, three jobs: social feed, publishing channel, and payment.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            One agency for the whole WeChat ecosystem
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              A WeChat agency registers your account, produces your content, runs your ads, and builds your Mini Program. Doing this in-house means hiring native speakers, learning Tencent's rules, and buying ads through a Chinese account.
            </p>
            <p>
              Most brands get further, faster, with a specialist. We're that specialist. We post on <a href="/platforms/wechat/" class="text-[#CC3333] hover:underline">WeChat</a> every day, from inside China.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Scope at a glance
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Our WeChat marketing services</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Five services. Each with a clear deliverable.
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Everything is listed in your scope of work before you sign. No vague retainers.
              </p>
            </div>
            <div class="svc-frame relative max-[900px]:hidden">
              <div class="relative w-full aspect-[1344/570] rounded-[10px] overflow-hidden bg-[#FFFFFF]">
                {services.map((service, i) => (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="1344"
                    height="570"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class:list={['svc-img absolute inset-0 w-full h-full object-cover', i === 0 && 'is-active']}
                    data-svc-img={i}
                  />
                ))}
              </div>
            </div>
            <div class="flex items-center gap-[16px] mt-[24px] max-[900px]:hidden">
              <div class="flex gap-[6px] grow" aria-hidden="true">
                {services.map((_, i) => (
                  <span class:list={['svc-tick', i === 0 && 'is-active']} data-svc-tick={i}></span>
                ))}
              </div>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-none m-0 shrink-0" data-svc-caption aria-hidden="true">{services[0].title}</p>
            </div>
          </div>
        </div>

        <!-- Scrolling step cards -->
        <div class="flex flex-col gap-[16px]">
          {services.map((service, i) => (
            <div class:list={['svc-step bg-[#FFFFFF] rounded-[10px] p-[32px] max-[640px]:p-[20px]', i === 0 && 'is-active']} data-svc-step={i}>
              <div class="flex items-center gap-[12px] mb-[16px]">
                <span class="svc-seal" aria-hidden="true">{service.glyph}</span>
                <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">{service.tag}</span>
              </div>
              <h3 class="text-[22px] max-[640px]:text-[19px] font-medium leading-[1.25] text-[#1A1A1A] mb-[10px]">{service.title}</h3>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.65] max-w-[480px] mb-[16px]">{service.description}</p>
              <ul class="flex flex-wrap gap-[8px] list-none m-0 p-0" aria-label={`${service.title}: deliverables`}>
                {service.deliverables.map((d) => (
                  <li class="text-[12px] font-normal leading-none text-[#1A1A1A] bg-[#F7F2EE] border-[0.5px] border-[#E8E0D8] rounded-[6px] px-[10px] py-[7px]">{d}</li>
                ))}
              </ul>
              <img
                src={service.image}
                alt={service.imageAlt}
                width="1344"
                height="570"
                loading="lazy"
                class="hidden max-[900px]:block w-full h-auto rounded-[8px] mt-[16px]"
              />
            </div>
          ))}
          <div class="py-[16px] flex items-center justify-between gap-[16px] flex-wrap" data-reveal>
            <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] m-0 max-w-[420px]">
              <span class="text-[#1A1A1A] font-medium">Need more than WeChat?</span> We also grow brands on RedNote, Douyin, Weibo, and 14 more platforms.
            </p>
            <a href="/platforms/others/" class="text-[14px] text-[#CC3333] font-medium shrink-0 hover:underline">All platforms &rarr;</a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ CASE STUDIES ============ -->
  <section id="results" class="mt-[128px] max-[640px]:mt-[72px] scroll-mt-[80px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[40px] max-[640px]:mb-[24px]" data-reveal>
        <div class="max-w-[560px]">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Case studies</p>
          <h2 class="text-[36px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[8px]">
            Results from the ground
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            Real clients, real numbers, all verifiable in the full case studies.
          </p>
        </div>
        <a href="/work/" class="text-[14px] text-[#CC3333] font-medium shrink-0 hover:underline">All case studies &rarr;</a>
      </div>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[24px] max-[640px]:gap-[16px]">
        {caseStudies.map((cs, i) => (
          <a href={cs.href} class="cs-card group bg-[#FFFFFF] border-[0.5px] border-[rgba(0,0,0,0.08)] rounded-[8px] overflow-hidden flex flex-col no-underline" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="overflow-hidden relative">
              <img
                src={cs.image}
                alt={cs.imageAlt}
                width="800"
                height="450"
                loading="lazy"
                class="cs-img w-full h-[200px] max-[640px]:h-[180px] object-cover block"
              />
            </div>
            <div class="p-[28px] max-[640px]:p-[20px] flex flex-col grow">
              <p class="text-[40px] max-[640px]:text-[32px] font-medium leading-none text-[#1A1A1A] mb-[4px] tabular-nums">{cs.metric}</p>
