---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { faqPageSchema, serviceSchema } from '../lib/schema';

const heroStats = [
  { value: 350, decimals: 0, suffix: 'M+', label: 'monthly active users' },
  { value: 1, decimals: 0, suffix: 'B+', label: 'searches every month' },
  { value: 70, decimals: 0, suffix: '%', label: 'of users aged 18 to 35' },
  { value: 2, decimals: 0, suffix: ' weeks', label: 'from signing to first note live' },
];

const platformNames = [
  { name: '小红书 (Xiǎohóngshū)', detail: 'The official Chinese name. Romanized as Xiaohongshu or Xiao Hong Shu.' },
  { name: 'Little Red Book', detail: 'The literal English translation of 小红书.' },
  { name: 'RED', detail: 'The platform\'s earlier international brand name. Still used in press coverage.' },
  { name: 'RedNote', detail: 'The official English name since January 2025. This is the name we use.' },
];

const services = [
  {
    glyph: '号',
    title: 'Account setup and verification',
    tag: 'Live within 2 weeks',
    description:
      'We register your Professional Account (企业号, Blue V), translate your overseas business license, prepare trademark documents, and push everything through platform review. Most accounts are live within 2 weeks.',
    deliverables: ['Professional Account', 'Blue V verification', 'License translation', 'Platform review'],
    image: '/images/platforms/rednote-services/account-setup.webp',
    imageAlt: 'Phone showing a verified RedNote Professional Account profile with a Blue V badge, next to business registration documents',
  },
  {
    glyph: '达',
    title: 'KOL and KOC campaigns',
    tag: 'Verified creators via Pugongying',
    description:
      'Key Opinion Leader (KOL) and Key Opinion Consumer (KOC) campaigns run through Pugongying, the platform\'s official influencer marketplace. Over 100,000 verified creators, with fake follower detection on every shortlist.',
    deliverables: ['KOL shortlists', 'KOC seeding', 'Fake-follower checks', 'Campaign reporting'],
    image: '/images/platforms/rednote-services/kol-koc.webp',
    imageAlt: 'Content creator filming a product review note for a RedNote KOL campaign',
  },
  {
    glyph: '记',
    title: 'Content creation and localization',
    tag: 'Native Mandarin, not translation',
    description:
      'Notes (笔记), video, and imagery written in native Mandarin, not translated from English. AIGC visuals powered by HubStudio.ai. Real-life shoots in China. Content built for grass-planting (种草), the platform\'s word-of-mouth culture.',
    deliverables: ['Notes and video', 'AIGC visuals', 'Real-life shoots', 'Grass-planting content'],
    image: '/images/platforms/rednote-services/content-strategy.webp',
    imageAlt: 'Editorial desk with a phone showing a RedNote note being drafted in Mandarin',
  },
  {
    glyph: '广',
    title: 'Paid advertising',
    tag: 'Ad spend at cost, no markup',
    description:
      'In-Feed Ads (信息流广告), Search Ads, and Brand Ads through the Juguang ad platform. Creative testing, bid work, and real-time adjustments. Ad spend is billed at cost. No markup, ever.',
    deliverables: ['In-Feed Ads', 'Search Ads', 'Brand Ads', 'Creative testing'],
    image: '/images/platforms/rednote-services/paid-advertising.webp',
    imageAlt: 'Phone showing a sponsored In-Feed ad inside the RedNote discovery grid',
  },
  {
    glyph: '店',
    title: 'E-commerce and store integration',
    tag: 'Live commerce built in',
    description:
      'In-app store setup, shoppable notes, and live commerce production. Live sessions drive 90% of the platform\'s in-app sales, so content leads straight to purchase without leaving the app.',
    deliverables: ['In-app store', 'Shoppable notes', 'Live sessions', 'Cross-border setup'],
    image: '/images/platforms/rednote-services/ecommerce-live.webp',
    imageAlt: 'Phone showing a RedNote live commerce session next to an in-app product store',
  },
  {
    glyph: '数',
    title: 'Reporting and analytics',
    tag: 'Plain-English reporting',
    description:
      'Follower growth, engagement, search rankings, and campaign ROI in one monthly report, in plain English. Social listening covers brand mentions, sentiment, and competitor moves.',
    deliverables: ['Growth and engagement', 'Search rankings', 'Campaign ROI', 'Social listening'],
    image: '/images/platforms/rednote-services/analytics-listening.webp',
    imageAlt: 'Laptop dashboard showing RedNote follower growth, engagement, and search ranking analytics',
  },
];

const industries = [
  {
    title: 'Beauty and cosmetics',
    description: 'The platform\'s biggest category. Reviews, tutorials, and ingredient breakdowns.',
    icon: '<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>',
  },
  {
    title: 'Fashion and apparel',
    description: 'Styling content, seasonal lookbooks, and KOC seeding.',
    icon: '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>',
  },
  {
    title: 'Food and beverage',
    description: 'Restaurant reviews, recipes, and product tastings.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Travel and tourism',
    description: 'Destination guides and hotel reviews. 64% of Chinese travelers use RedNote for trip planning.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'Luxury',
    description: 'Storytelling-led content for a high-intent, affluent audience.',
    icon: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
  },
  {
    title: 'Health and wellness',
    description: 'Fitness, supplements, and wellness tips. A fast-growing vertical.',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
  },
];

const pillars = [
  {
    title: 'Clear SOW',
    description: 'Every deliverable is defined upfront. Notes, videos, KOL activations, campaigns, reports. You know exactly what you get each month.',
  },
  {
    title: 'Fixed price, no surprises',
    description: 'One price per package. No hourly rates, no scope creep charges, no invoices you weren\'t expecting.',
  },
  {
    title: 'AI-powered content production',
    description: 'Visuals and video powered by HubStudio.ai, which keeps costs down and output fast. Strategy is 100% human-led.',
  },
  {
    title: 'Team on the ground',
    description: 'Shanghai and Hong Kong. Bilingual native speakers who post on RedNote every day, with direct KOL relationships and real-time platform access.',
  },
];

const steps = [
  {
    title: 'Audit and strategy',
    description:
      'A 30-minute discovery call, then a category audit: search keywords, competitor accounts, and content gaps. You get a fixed-price proposal with every deliverable listed.',
  },
  {
    title: 'Account and content setup',
    description:
      'We handle the Professional Account paperwork, define your content pillars, and produce the first batch of notes. Live within 2 weeks of signing.',
  },
  {
    title: 'Launch and KOL activation',
    description:
      'A steady publishing cadence trains the algorithm on your category. KOC seeding and paid boosts bring traffic while the organic side ramps up.',
  },
  {
    title: 'Optimize and scale',
    description:
      'We track CES engagement data and search rankings, cut what stalls, and double down on the formats and keywords that convert.',
  },
];

const caseStudies = [
  {
    client: 'AGE 20\'s',
    image: '/images/clients/Age20/Age20-Picture11.webp',
    imageAlt: 'AGE 20\'s Little Milk Brick foundation campaign visual for RedNote',
    metric: '750K',
    metricLabel: 'impressions against a 300K target',
    summary: 'A Korean beauty brand launching its Little Milk Brick foundation in China. The RedNote campaign hit 750K impressions against a 300K target, and the product nickname went organic.',
    href: '/work/age20s/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Camper footwear campaign visual for China social media',
    metric: '38%',
    metricLabel: 'of e-commerce traffic from the smallest audience',
    summary: 'A European footwear brand that grew from 43K to 187K followers in 18 months. RedNote had the smallest audience but drove 38% of all e-commerce traffic.',
    href: '/work/camper/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Mission Foods campaign visual for the China launch',
    metric: 'Gen Z',
    metricLabel: 'campaigns for a new food category',
    summary: 'Launching corn chips, an unfamiliar category, in China. RedNote KOLs showed the product in real life, and food pairing content made it feel local.',
    href: '/work/mission-foods/',
  },
];

const faqs = [
  {
    q: 'Is Xiaohongshu the same as RedNote and Little Red Book?',
    a: 'Yes. Xiaohongshu (小红书) is the official Chinese name, and Little Red Book is its literal translation. The company branded itself internationally as RED for years, then adopted RedNote as its official English name in January 2025. Xiao Hong Shu is just the pinyin spelling written as three words. One app, one algorithm, one audience.',
  },
  {
    q: 'Can foreign or overseas brands sell on Xiaohongshu?',
    a: 'Yes. Overseas businesses can open a Professional Account (Blue V) with a translated business license and trademark documents, no Chinese entity required. The platform\'s cross-border e-commerce program also lets overseas brands run an in-app store and ship internationally. We handle the paperwork, the store setup, and the platform review process.',
  },
  {
    q: 'How much does Xiaohongshu marketing cost?',
    a: 'Three budgets matter. Agency work: we quote one fixed monthly price against a clear scope of work, so you see every deliverable and the full cost before you sign. Ad spend: billed separately at cost through the Juguang platform, with no markup. KOL fees: they vary widely by follower tier and category, and we pass them through transparently with verified engagement data behind every booking.',
  },
  {
    q: 'How long until we see results?',
    a: 'The platform doesn\'t reward impatience. New accounts go through an algorithm observation window, so the first 2 to 3 months build your content library and train the algorithm on your category. Paid ads and KOL campaigns can bring traffic from week one while the organic side catches up. Our minimum engagement is 3 months for exactly this reason.',
  },
  {
    q: 'Do we need a Chinese business license or entity?',
    a: 'Not for the account. A translated overseas business license is enough for a Professional Account. Paid advertising is the exception: the Juguang ad platform requires a Chinese entity to open an ad account. We run ad accounts on behalf of overseas clients through our local structure, with weekly spend reports and full visibility.',
  },
  {
    q: 'Who uses RedNote, and what do they use it for?',
    a: 'Around 350 million people use RedNote every month. The core audience is young, urban, and roughly 70 percent female, with strong spending power. They treat it as a search engine for real product experiences: what to buy, where to travel, what actually works. That purchase intent is why conversion-focused brands start here.',
  },
  {
    q: 'RedNote or Douyin: which is right for my brand?',
    a: 'They do different jobs. Douyin is entertainment video with a fast algorithmic feed, built for reach and impulse buys. RedNote is slower and search-driven: people research before they buy, and a good note keeps bringing traffic for months. High-consideration categories like beauty, fashion, and travel usually start on RedNote. Many brands end up running both.',
  },
  {
    q: 'How do KOL and KOC campaigns work on RedNote?',
    a: 'Paid creator work runs through Pugongying, the platform\'s official influencer marketplace. Bookings made outside it risk content takedowns. We shortlist creators with verified audience data, then handle briefs, contracts, payments, and per-post reporting. On RedNote, dozens of small KOC reviews often beat one celebrity post.',
  },
  {
    q: 'Can our content be in English?',
    a: 'Chinese users search in Chinese, so English notes barely surface. Everything we publish is written natively in Mandarin by our Shanghai team, not translated. English only reaches the small overseas audience that joined in early 2025. For selling in China, it stays a Mandarin platform.',
  },
  {
    q: 'What makes a note perform on RedNote?',
    a: 'Search keywords in the title, a strong cover image, and a first-person voice that reads like a real recommendation. Hard-sell copy gets muted by the algorithm, and undeclared ads risk takedowns, so we declare commercial notes properly through the platform. Every note we publish is built around a keyword plan, and we track which ones rank.',
  },
];

const pageSchemas = [
  serviceSchema({
    name: 'RedNote (Xiaohongshu / Little Red Book) Agency Services',
    description:
      'Full-service RedNote agency for Western brands: Professional Account setup, KOL and KOC campaigns, content localization, paid advertising, and social commerce.',
    url: '/rednote-agency',
    serviceType: 'Social Media Marketing',
  }),
  faqPageSchema(faqs),
];
---

<PageLayout
  title="RedNote Agency | Xiaohongshu (Little Red Book) Marketing"
  description="Grow your brand on RedNote (Xiaohongshu / Little Red Book). We run KOL, content, and ad campaigns from Shanghai. Fixed scope, fixed price. Book a call."
  schema={pageSchemas}
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">红</span>
            <img src="/images/platforms/rednote-logo.svg" alt="" width="22" height="22" class="block" aria-hidden="true" />
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">RedNote agency</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            RedNote (Xiaohongshu / Little Red Book) marketing agency
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            One platform, four names, 350M+ monthly users. We run KOL campaigns, content, ads, and social commerce on RedNote for Western brands. From Shanghai, every day. Fixed scope. Fixed price.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/contact/">Book a call</Button>
            <Button variant="secondary-dark" href="#results">See the results</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            A 30-minute call. No pitch deck.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/rednote-agency/hero-phones-blend.webp"
            alt="Two phones showing the real RedNote app: the note discovery grid and a single product review note"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Why RedNote comes first for discovery
          </p>
          <p class="manifesto" data-manifesto>
            In China, buying starts with a search on RedNote. 350 million people check real reviews before they spend. Ads do not win here. <span class="manifesto-hl">Trust</span> does. We build the notes, reviews, and creator voices that earn it.
          </p>
        </div>
        <div>
          <img
            src="/images/rednote-agency/ecosystem-banner-tight.webp"
            alt="Three phones showing the RedNote journey: the discovery grid, a product review note, and search results"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            One app, three jobs: discovery feed, honest reviews, and search.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">
            What is RedNote
          </p>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Xiaohongshu, Little Red Book, RED, and RedNote explained
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              RedNote (小红书 / Xiaohongshu) is China's product discovery platform. 350M+ monthly active users, 1B+ searches per month, and 90% of content created by users, not brands (May 2026).
            </p>
            <p>
              70% of users are aged 18 to 35, mostly women in tier-1 and tier-2 cities with above-average spending power. They come to research products before they buy. Reviews, tutorials, and honest recommendations carry more weight here than on any other Chinese platform.
            </p>
            <p>
              Think of it this way: Douyin is where Chinese consumers get entertained, WeChat is where brands keep customers, and <a href="/platforms/rednote/" class="text-[#CC3333] hover:underline">RedNote</a> is where buying decisions get made.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Why the platform has so many names
          </p>
          <ul class="flex flex-col gap-[14px] list-none m-0 p-0">
            {platformNames.map((item) => (
              <li>
                <p class="text-[14px] font-medium leading-[1.4] text-[#1A1A1A] m-0">{item.name}</p>
                <p class="text-[13px] font-normal leading-[1.5] text-[#5C5C5C] m-0 mt-[2px]">{item.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Our RedNote marketing services</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Six services. Each with a clear deliverable.
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Everything is listed in your scope of work before you sign. No vague retainers.
              </p>
            </div>
            <div class="svc-frame relative max-[900px]:hidden">
              <div class="relative w-full aspect-[1344/570] rounded-[10px] overflow-hidden bg-[#FFFFFF]">
                {services.map((service, i) => (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="1344"
                    height="570"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class:list={['svc-img absolute inset-0 w-full h-full object-cover', i === 0 && 'is-active']}
                    data-svc-img={i}
                  />
                ))}
              </div>
            </div>
            <div class="flex items-center gap-[16px] mt-[24px] max-[900px]:hidden">
              <div class="flex gap-[6px] grow" aria-hidden="true">
                {services.map((_, i) => (
                  <span class:list={['svc-tick', i === 0 && 'is-active']} data-svc-tick={i}></span>
                ))}
              </div>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-none m-0 shrink-0" data-svc-caption aria-hidden="true">{services[0].title}</p>
            </div>
          </div>
        </div>

        <!-- Scrolling step cards -->
        <div class="flex flex-col gap-[16px]">
          {services.map((service, i) => (
            <div class:list={['svc-step bg-[#FFFFFF] rounded-[10px] p-[32px] max-[640px]:p-[20px]', i === 0 && 'is-active']} data-svc-step={i}>
              <div class="flex items-center gap-[12px] mb-[16px]">
                <span class="svc-seal" aria-hidden="true">{service.glyph}</span>
                <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">{service.tag}</span>
              </div>
              <h3 class="text-[22px] max-[640px]:text-[19px] font-medium leading-[1.25] text-[#1A1A1A] mb-[10px]">{service.title}</h3>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.65] max-w-[480px] mb-[16px]">{service.description}</p>
              <ul class="flex flex-wrap gap-[8px] list-none m-0 p-0" aria-label={`${service.title}: deliverables`}>
                {service.deliverables.map((d) => (
                  <li class="text-[12px] font-normal leading-none text-[#1A1A1A] bg-[#F7F2EE] border-[0.5px] border-[#E8E0D8] rounded-[6px] px-[10px] py-[7px]">{d}</li>
                ))}
              </ul>
              <img
                src={service.image}
                alt={service.imageAlt}
                width="1344"
                height="570"
                loading="lazy"
