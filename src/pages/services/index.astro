---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import Button from '../../components/ui/Button.astro';
import GettingStarted from '../../components/sections/GettingStarted.astro';

const SITE_URL = 'https://www.theredscroll.com';

const services = [
  {
    title: 'Strategy, Campaigns & Analytics',
    description: 'We research your market, build your plan, run your campaigns, and measure what matters. From platform selection to monthly reporting.',
    href: '/services/strategy-campaigns',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
  },
  {
    title: 'Advertising',
    description: 'Paid media across WeChat, Douyin, RedNote, Weibo, and more. We handle planning, buying, creative, and optimization.',
    href: '/services/advertising',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
  },
  {
    title: 'Content Production',
    description: 'Native-quality visuals, video, and copy for every Chinese platform. AI-assisted production with human creative direction.',
    href: '/services/content-production',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
  },
  {
    title: 'Influencer Marketing',
    description: 'KOL and KOC campaigns on Douyin, RedNote, Weibo, and Bilibili. Sourcing, negotiation, briefing, and performance tracking.',
    href: '/services/influencer-marketing',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    title: 'China Market Entry',
    description: 'Account registration, platform setup, ICP filing, and localization. Everything you need to go live on Chinese social platforms.',
    href: '/services/market-entry',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  },
  {
    title: 'CRM & Private Domain Traffic',
    description: 'WeCom setup, group management, loyalty programs, and retention flows. Turn followers into repeat customers.',
    href: '/services/crm-private-domain',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    title: 'Training & Consulting',
    description: 'Masterclasses, team coaching, and platform audits. For brands that want to build internal capability alongside external support.',
    href: '/services/training-consulting',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  },
];

const servicesCollectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/services/#collectionpage`,
  name: 'Services for brands in China',
  url: `${SITE_URL}/services/`,
  description: 'Strategy, content, advertising, influencer marketing, market entry, CRM, and training services for brands operating in China.',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}${s.href}/`,
      name: s.title,
    })),
  },
};

const gettingStartedSteps = [
  {
    title: 'Discovery call.',
    description: 'Your brand, your goals, your China readiness. No pitch deck. Just the right questions.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Proposal.',
    description: 'Clear scope. Fixed price. Every deliverable listed out. You see what you are getting before you commit.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'Live in 2 weeks.',
    description: 'Strategy delivered, campaigns configured, first content published. Two weeks from signed contract.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="Services | TheRedScroll"
  description="Social media services for brands in China. Strategy, content, advertising, influencer marketing, market entry, CRM, and training. Fixed scope, fixed price."
  schema={servicesCollectionSchema}
>

  <!-- Hero — Dark banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.12]" style="background-image: url('/images/hero/services-hero.webp')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Our services
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Everything your brand needs to grow in China.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Seven services. One team. Fixed scope, fixed price, and a team on the ground in Shanghai.
      </p>
      <div class="flex flex-wrap justify-center gap-[12px]">
        <Button href="/pricing/" variant="primary">See pricing</Button>
        <Button href="#all-services" variant="secondary-dark">Browse services</Button>
      </div>
    </div>
  </section>

  <!-- Service cards grid -->
  <section id="all-services" class="py-[96px] max-[640px]:py-[64px]">
    <Container>
      <div class="max-w-[680px] mb-[48px]">
        <SectionBar />
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">
          What we do
        </p>
        <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[12px]">
          Services built for China's social platforms.
        </h2>
        <p class="text-[16px] font-normal leading-[1.5] text-[var(--color-stone)]">
          Each service can run on its own or work alongside the others. Pick what you need.
        </p>
      </div>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[24px]">
        {services.map((service) => (
          <a
            href={service.href}
            class="group block bg-[var(--color-rice-paper)] rounded-[12px] p-[32px] max-[640px]:p-[24px] transition-colors duration-[0.15s] hover:bg-[#F0EAE4]"
          >
            <div class="w-[56px] h-[56px] rounded-[12px] bg-[var(--color-ink)] flex items-center justify-center text-[#FFFFFF] mb-[20px]">
              <Fragment set:html={service.icon} />
            </div>
            <h3 class="text-[20px] max-[640px]:text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">
              {service.title}
            </h3>
            <p class="text-[15px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[16px]">
              {service.description}
            </p>
            <span class="inline-flex items-center gap-[6px] text-[14px] font-medium text-[var(--color-vermillion)]">
              Learn more
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-[0.15s] group-hover:translate-x-[4px]">
                <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Getting started -->
  <GettingStarted
    heading="From first call to live campaigns in two weeks."
    steps={gettingStartedSteps}
    backgroundImage="/images/team/china-office.webp"
  />

</PageLayout>
