---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import FaqAccordion from '../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../components/sections/GettingStarted.astro';
import { faqPageSchema, serviceSchema } from '../../lib/schema';


const faqs = [
  { q: 'Can AI really produce content that looks good enough for premium brands?', a: 'Yes, if you train the model properly. Generic AI output looks generic. We train custom models on your brand\'s visual identity, color palette, packaging, and product photography style. The output matches your brand. Not someone else\'s.' },
  { q: 'What percentage of content is AI vs. real-life?', a: 'Depends on the brand and the platform. For most clients, AIGC handles 60 to 70% of visual production (product images, social graphics, simple video). Real-life production covers the remaining 30 to 40% (hero videos, lifestyle content, KOL shoots).' },
  { q: 'Do you write in Chinese or adapt from English?', a: 'We write in Chinese. Not translate. Big difference. Our copywriters are native Mandarin speakers based in Shanghai. If you provide English brand guidelines, we use those as a starting point, but the output is written for Chinese platforms from scratch.' },
  { q: 'How do you keep up with trends?', a: 'Our social media managers are on the platforms every day. They track trending hashtags, viral formats, seasonal moments, and competitor activity. When something relevant appears, we can produce and publish a response within 24 to 48 hours.' },
  { q: 'What if we already have global creative assets?', a: 'We can adapt them, but adaptation usually doesn\'t perform as well as locally produced content. We\'ll use your global assets where they make sense and supplement with locally produced AIGC and real-life content for the day-to-day posts.' },
  { q: 'How many posts per month do we need?', a: 'Minimum viable presence: 8 to 12 posts per platform per month. Competitive presence: 20 to 30. That\'s just organic. Ad creatives are on top. We build a content calendar that matches your budget and goals.' },
  { q: 'Can you produce content for multiple platforms at once?', a: 'That\'s basically the default. Most clients run two to four platforms. Each one gets its own content calendar, its own tone, and its own formats. We don\'t recycle the same post across platforms. That doesn\'t work.' },
  { q: 'How is pricing structured?', a: 'Fixed scope, fixed price. You know the number of posts, videos, articles, and shoots included each month. Ad spend and real-life production add-ons are quoted separately and transparently.' },
  { q: 'Who owns the content you produce?', a: 'You do. Every asset we produce, whether AIGC or real-life, belongs to your brand. Full usage rights, no licensing restrictions, no expiration dates. You can repurpose it anywhere.' },
  { q: 'How fast can you turn around content?', a: 'AIGC assets: 2 to 3 business days from brief to delivery. Real-life shoots need 1 to 2 weeks for planning, shooting, and post-production. Trend-reactive content can go from concept to published in 24 to 48 hours when needed.' },
];

const gettingStartedSteps = [
  {
    title: 'Discovery call.',
    description: 'Tell us about your brand, your platforms, and where content is falling short.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Content plan.',
    description: 'Format recommendations, production approach, AIGC vs. real-life split, and pricing. Clear scope.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'Live in 2 weeks.',
    description: 'Content strategy, asset production, and first posts published. Fourteen days from signed contract.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="China Social Media Content Production | TheRedScroll"
  description="AIGC images, video production, copywriting, and localization for WeChat, Douyin, and RedNote. Fixed scope. AI-powered speed. Team in Shanghai."
  schema={[
    serviceSchema({
      name: 'China Social Media Content Production',
      description: 'AIGC images, video production, native Chinese copywriting, and content localization for WeChat, Douyin, RedNote, and Weibo via HubStudio.ai.',
      url: '/services/content-production',
      serviceType: 'Content Production',
    }),
    faqPageSchema(faqs),
  ]}
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/content-production-hero.webp')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Content production
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        What you say matters more than how cheaply you can produce it.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Strategy, creative direction, AIGC, real-life shoots, copywriting, and localization. From Shanghai and Hong Kong.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact/">Book a call</Button>
        <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
      </div>
    </div>
  </section>

  <!-- Why content production has changed -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">The shift</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Why content production has changed</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">AI can now produce visuals and copy in minutes. When everyone can create cheaply, the thinking behind the content becomes the real differentiator.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
          </div>
        </div>
        <div class="bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Tone is platform-specific</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">RedNote rewards casual, almost diary-like content. Weibo demands punchy headlines. WeChat needs depth. Douyin lives on hooks and pacing. Same voice across all four won't work.</p>
        </div>
        <div class="bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Trends move fast</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">A hashtag trending on Douyin today might be dead by next week. Your content team needs to be on the platforms daily, spotting opportunities in real time.</p>
        </div>
        <div class="bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Volume is massive</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">Run three or four platforms and you're looking at 30 to 50 pieces per month, plus ad creatives. No team can sustain that with traditional production alone.</p>
        </div>
        <div class="bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">AI is the only way to keep up</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">AIGC handles the production volume. Your team handles creative direction. The thinking is human. The output speed isn't.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do — Content structure & AIGC -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="What we do">Content structure and strategy</SectionHeading>

      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img src="/images/what-we-do/content-production.webp" alt="TheRedScroll team directing a content production shoot" class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Content strategy</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Content pillars, messaging framework, editorial voice, and platform-specific formats. 100% human-led. AI can't decide if your brand should ride a trending topic or stay quiet.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">AIGC images and video</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">AI-generated product visuals, lifestyle imagery, and short-form video. Custom models trained on your brand identity so output looks like yours. Roughly 80% faster than traditional production.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Real-life production</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Shot on location in China. Behind-the-scenes footage, product unboxings, brand films, KOL collaboration shoots. AI can't replicate a real person using your product.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Copywriting & Indicative pricing — dark section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[1024px]:p-[32px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Copywriting and localization</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">This is not translation.</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            A WeChat article has structure and depth. A RedNote caption reads like a friend sharing a tip. A Douyin overlay needs to hook in two seconds. The copy is different for each platform, even when the product is the same.
          </p>
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            AI drafts. Native Chinese speakers proofread and culturally adapt. For brands entering the market, we also handle brand naming, tagline localization, and messaging adaptation.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">AIGC indicative pricing</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              10 AIGC product images: ¥2,000 to ¥5,000. 5 short social videos (15-30 sec): ¥5,000 to ¥12,000. Compare that to traditional: a product photo shoot in Shanghai runs ¥8,000 to ¥25,000/day. A 30-second video starts at ¥15,000 to ¥50,000.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Real-life indicative pricing</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Half-day photo shoot (Shanghai): ¥8,000 to ¥15,000. Full-day video production with crew and editing: ¥20,000 to ¥60,000. Depends on scope, location, talent, and post-production.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Content formats by platform -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Platform formats">Douyin</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Short video (15-60 sec)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">The dominant format. Product demos, tutorials, lifestyle clips, trend-riding content. Vertical 9:16. Hook must land in the first 2 seconds. Music and subtitles are essential.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Live streaming</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Product demos, Q&A, flash sales. Can run 1 to 4 hours. Drives direct sales through Douyin Shop. Requires a trained host, real-time chat, and product display coordination.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Douyin carousel</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Up to 20 images in a swipeable format. Good for educational content, step-by-step guides, product comparisons. Growing in popularity for beauty and skincare brands.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- RedNote formats -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Platform formats">RedNote / Xiaohongshu</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Photo notes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">1 to 9 images with caption. The native format. Lifestyle photography, flat lays, before-and-after shots. Tone needs to feel personal and genuine. Think diary entry, not press release.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Video notes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">1 to 5 minutes. More space for storytelling than Douyin. Product reviews, routine videos, how-tos. Works best when it feels like a real person sharing an honest experience.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Search-optimized notes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Content created to rank for keywords RedNote users search for. Think of it as SEO for social media. Requires keyword research within RedNote's own search ecosystem.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- WeChat formats -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Platform formats">WeChat</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Official Account articles</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Long-form content. 800 to 2,500 words with images, embedded video, and links to Mini Programs or stores. Good for brand storytelling, product education, and thought leadership.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Channels videos</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Short vertical video within WeChat's video feed. 1 to 3 minutes. Growing fast. More intimate audience since it's shared within WeChat's social graph.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Mini Program content</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Product catalogs, interactive experiences, event pages, loyalty programs. Content lives inside the Mini Program and gets distributed through articles, ads, and QR codes.</p>
        </div>
