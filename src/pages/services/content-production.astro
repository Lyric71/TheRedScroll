---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="China Social Media Content Production | TheRedScroll"
  description="AIGC images, video production, copywriting, and localization for WeChat, Douyin, and RedNote. Fixed scope. AI-powered speed. Team in Shanghai."
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Content production
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        What you say matters more than how cheaply you can produce it.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Strategy, creative direction, AIGC, real-life shoots, copywriting, and localization. From Shanghai and Hong Kong.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
      </div>
    </div>
  </section>

  <!-- Why content production has changed -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[680px]">
        <SectionBar />
        <SectionHeading overline="The shift">Why content production has changed</SectionHeading>
        <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
          <p>
            AI tools can now generate visuals, draft copy, and cut video edits in minutes. For standard assets like product shots and simple motion graphics, production costs are approaching zero.
          </p>
          <p>
            But when everyone can produce content cheaply, content alone stops being the differentiator. What matters now is the thinking behind it. What topic to cover. What angle to lead with. Which trend to ride and which to skip.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] mt-[32px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Tone is platform-specific</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">RedNote rewards casual, almost diary-like content. Weibo demands punchy headlines. WeChat needs depth. Douyin lives on hooks and pacing. Same voice across all four won't work.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Trends move fast</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">A hashtag trending on Douyin today might be dead by next week. Your content team needs to be on the platforms daily, spotting opportunities in real time.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Volume is massive</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Run three or four platforms and you're looking at 30 to 50 pieces per month, plus ad creatives. No team can sustain that with traditional production alone.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">AI is the only way to keep up</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">AIGC (AI-Generated Content) handles the production volume. Your team handles creative direction. The thinking is human. The output speed isn't.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do — Content structure & AIGC -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="What we do">Content structure and strategy</SectionHeading>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] max-w-[680px]">
          <p>
            The most important layer. We define content pillars, messaging framework, editorial voice, and platform-specific formats before any asset gets produced.
          </p>
          <p>
            This part is 100% human-led. AI can't read a trending topic on RedNote and decide whether your brand should ride it or stay quiet. That judgment call is ours.
          </p>
        </div>
        <div class="flex flex-col gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">AIGC images and video</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">
              Powered by HubStudio.ai. AI-generated product visuals, lifestyle imagery, and short-form video. We train custom AI models on your brand identity so the output looks like yours, not generic stock. Roughly 80% faster than traditional production.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Real-life production</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">
              Shot on location. In China. Behind-the-scenes footage, product unboxings with actual people, brand films, KOL (Key Opinion Leader) collaboration shoots. AI can't replicate the feel of a real person using your product in a real environment.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Copywriting & Indicative pricing — dark section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Copywriting and localization</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">This is not translation.</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            A WeChat article has structure and depth. A RedNote caption reads like a friend sharing a tip. A Douyin overlay needs to hook in two seconds. The copy is different for each platform, even when the product is the same.
          </p>
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            AI drafts. Native Chinese speakers proofread and culturally adapt. For brands entering the market, we also handle brand naming, tagline localization, and messaging adaptation.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">AIGC indicative pricing</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              10 AIGC product images: ¥2,000 to ¥5,000. 5 short social videos (15-30 sec): ¥5,000 to ¥12,000. Compare that to traditional: a product photo shoot in Shanghai runs ¥8,000 to ¥25,000/day. A 30-second video starts at ¥15,000 to ¥50,000.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Real-life indicative pricing</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Half-day photo shoot (Shanghai): ¥8,000 to ¥15,000. Full-day video production with crew and editing: ¥20,000 to ¥60,000. Depends on scope, location, talent, and post-production.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Content formats by platform -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Platform formats">Douyin</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Short video (15-60 sec)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">The dominant format. Product demos, tutorials, lifestyle clips, trend-riding content. Vertical 9:16. Hook must land in the first 2 seconds. Music and subtitles are essential.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Live streaming</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Product demos, Q&A, flash sales. Can run 1 to 4 hours. Drives direct sales through Douyin Shop. Requires a trained host, real-time chat, and product display coordination.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Douyin carousel</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Up to 20 images in a swipeable format. Good for educational content, step-by-step guides, product comparisons. Growing in popularity for beauty and skincare brands.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- RedNote formats -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Platform formats">RedNote / Xiaohongshu</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Photo notes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">1 to 9 images with caption. The native format. Lifestyle photography, flat lays, before-and-after shots. Tone needs to feel personal and genuine. Think diary entry, not press release.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Video notes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">1 to 5 minutes. More space for storytelling than Douyin. Product reviews, routine videos, how-tos. Works best when it feels like a real person sharing an honest experience.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Search-optimized notes</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Content created to rank for keywords RedNote users search for. Think of it as SEO for social media. Requires keyword research within RedNote's own search ecosystem.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- WeChat formats -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Platform formats">WeChat</SectionHeading>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Official Account articles</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Long-form content. 800 to 2,500 words with images, embedded video, and links to Mini Programs or stores. Good for brand storytelling, product education, and thought leadership.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Channels videos</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Short vertical video within WeChat's video feed. 1 to 3 minutes. Growing fast. More intimate audience since it's shared within WeChat's social graph.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Mini Program content</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Product catalogs, interactive experiences, event pages, loyalty programs. Content lives inside the Mini Program and gets distributed through articles, ads, and QR codes.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Case study</p>
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[var(--color-ink)] mb-[24px]">AIGC + real-life production for a Japanese skincare brand</h2>

        <div class="max-w-[680px] flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
          <p>
            A Japanese skincare brand was active on RedNote and WeChat but producing only 6 posts per month across both platforms. Content was shot in Tokyo, shipped as global assets, and barely adapted for the Chinese market. Engagement was below category average. The content looked expensive but felt foreign.
          </p>
          <p class="text-[var(--color-stone)]">
            The brand needed to triple their content volume without tripling their budget. They also needed content that felt native, not like translated global campaigns.
          </p>
          <p>
            We split production into two tracks. Track one: AIGC. We trained a custom model on the brand's visual identity using HubStudio.ai. Within two weeks, the model could generate on-brand product imagery, lifestyle flats, and ingredient detail shots. 30+ assets per month at roughly 20% of what the brand was spending on shoots in Tokyo.
          </p>
          <p>
            Track two: real-life shoots. One half-day shoot per month in Shanghai. Real people, real skincare routines, real bathrooms and vanity tables. These clips became the hero content for RedNote video notes and WeChat Channels.
          </p>
        </div>

        <!-- Results grid -->
        <div class="grid grid-cols-4 max-[640px]:grid-cols-2 gap-[24px] mt-[32px] pt-[32px] border-t border-[rgba(0,0,0,0.08)]">
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">22</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Posts per month, up from 6. Across RedNote and WeChat.</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">-35%</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Production cost decrease despite nearly 4x the output.</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">5.8%</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">RedNote engagement rate, up from 2.1%.</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">+40%</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">WeChat article read-through rate improvement.</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- How to get started -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Get started">Ready to scale your content?</SectionHeading>

      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">01</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Book a 30-minute discovery call</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Tell us about your brand, your platforms, and where content is falling short.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">02</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Get a content plan</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Format recommendations, production approach, AIGC vs. real-life split, and pricing. Clear scope.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">03</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">First content live within two weeks</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Content strategy, asset production, and first posts published.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="FAQ">Frequently asked questions</SectionHeading>

      <div class="max-w-[680px] flex flex-col gap-[32px] mt-[24px]">
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Can AI really produce content that looks good enough for premium brands?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Yes, if you train the model properly. Generic AI output looks generic. We train custom models on your brand's visual identity, color palette, packaging, and product photography style. The output matches your brand. Not someone else's.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">What percentage of content is AI vs. real-life?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Depends on the brand and the platform. For most clients, AIGC handles 60 to 70% of visual production (product images, social graphics, simple video). Real-life production covers the remaining 30 to 40% (hero videos, lifestyle content, KOL shoots).</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Do you write in Chinese or adapt from English?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">We write in Chinese. Not translate. Big difference. Our copywriters are native Mandarin speakers based in Shanghai. If you provide English brand guidelines, we use those as a starting point, but the output is written for Chinese platforms from scratch.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How do you keep up with trends?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Our social media managers are on the platforms every day. They track trending hashtags, viral formats, seasonal moments, and competitor activity. When something relevant appears, we can produce and publish a response within 24 to 48 hours.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">What if we already have global creative assets?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">We can adapt them, but adaptation usually doesn't perform as well as locally produced content. We'll use your global assets where they make sense and supplement with locally produced AIGC and real-life content for the day-to-day posts.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How many posts per month do we need?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Minimum viable presence: 8 to 12 posts per platform per month. Competitive presence: 20 to 30. That's just organic. Ad creatives are on top. We build a content calendar that matches your budget and goals.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Can you produce content for multiple platforms at once?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">That's basically the default. Most clients run two to four platforms. Each one gets its own content calendar, its own tone, and its own formats. We don't recycle the same post across platforms. That doesn't work.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How is pricing structured?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Fixed scope, fixed price. You know the number of posts, videos, articles, and shoots included each month. Ad spend and real-life production add-ons are quoted separately and transparently.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Who owns the content you produce?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">You do. Every asset we produce, whether AIGC or real-life, belongs to your brand. Full usage rights, no licensing restrictions, no expiration dates. You can repurpose it anywhere.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How fast can you turn around content?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">AIGC assets: 2 to 3 business days from brief to delivery. Real-life shoots need 1 to 2 weeks for planning, shooting, and post-production. Trend-reactive content can go from concept to published in 24 to 48 hours when needed.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="mt-[96px] max-[640px]:mt-[64px] mb-[0px]">
    <div class="w-full bg-[var(--color-rice-paper)] py-[64px] max-[640px]:py-[48px] px-[48px] max-[640px]:px-[20px]">
      <div class="max-w-[600px] mx-auto text-center">
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[var(--color-ink)] mb-[8px]">
          Want to talk about your content needs?
        </h2>
        <p class="text-[14px] text-[var(--color-stone)] font-normal leading-[1.6] mb-[24px]">
