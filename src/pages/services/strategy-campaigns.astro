---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="China Social Media Strategy & Campaigns | TheRedScroll"
  description="Social media strategy, campaign management, and analytics for brands in China. Fixed scope, fixed price. Team on the ground in Shanghai."
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Strategy, campaigns and analytics
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        The right plan. The right platforms. The right numbers.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        We research your market, build your plan, run your campaigns, and measure what matters. From Shanghai and Hong Kong.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
      </div>
    </div>
  </section>

  <!-- Problem intro -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="The problem">Most brands post content without a plan.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              They pick platforms based on gut feeling, publish when they have time, and check numbers once a quarter. Maybe less.
            </p>
            <p>
              A real strategy starts somewhere else entirely. Which platforms fit your industry. What your competitors are doing and where they're falling short. What content formats drive results. And how you'll know if any of it is working.
            </p>
            <p>
              We build strategies from the ground up. Real market data. Real competitor analysis. Real platform knowledge. Then we run the campaigns ourselves, every day.
            </p>
          </div>
        </div>
        <div>
          <img src="/images/hero/hero-phones-shanghai.png" alt="Social media strategy on Chinese platforms" class="w-full rounded-[12px]" loading="lazy" />
        </div>
      </div>
    </Container>
  </section>

  <!-- Why you need a platform-specific strategy — numbered cards -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Why it matters">Why you need a platform-specific strategy</SectionHeading>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Each platform has its own rules</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">WeChat, Douyin, RedNote, and Weibo have different content formats, ad systems, and user expectations. Wrong platform, wasted budget.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">The audience moves across platforms</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Consumers research on RedNote, follow brands on WeChat, watch product demos on Douyin, and check opinions on Weibo. Your strategy needs to account for every step.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">The competition is already there</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Your competitors are posting daily, running influencer campaigns, and buying ads. Without a clear strategy, you're basically just spending.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Things move quickly</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Algorithms get updated without warning. New ad formats appear every few months. Regulations shift on their own timeline. A strategy that worked in January might not work in April.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do — Market & Competitor Research -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="What we do">Market and competitor research</SectionHeading>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] max-w-[680px]">
          <p>
            Before we touch a platform, we study your market.
          </p>
          <p>
            We look at your vertical: who the key players are, what content they post, how they engage their audience, where the gaps are. We map competitors' social accounts across every major platform. Follower counts, posting frequency, engagement rates, content themes, ad strategies. The works.
          </p>
          <p>
            This isn't a template report. It's a custom analysis built by a team that reads Chinese, uses the platforms daily, and can tell the difference between real engagement and paid-for followers.
          </p>
        </div>
        <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Platform selection and prioritization</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">
              Not every brand needs to be on every platform. A beauty brand should probably start on RedNote. A B2B industrial company needs WeChat and Zhihu. Fashion brands tend to get the most reach from Douyin. Hospitality builds reputation on Dianping and Weibo.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Content strategy and calendar</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">
              We define your content pillars, messaging framework, and editorial voice for each platform. Topics, formats, posting schedule, frequency. Each platform gets its own calendar. Updated monthly based on performance data and what's trending.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Creative & Planning — dark section (1 per page) -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Creative and planning</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">The part that actually matters most.</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            AI has changed content production. Visuals, video edits, copy drafts, all of it can be produced faster and cheaper than it could even a year ago. Production costs are heading toward zero.
          </p>
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            That shift makes creative planning more important. Not less. When anyone can produce content at scale, the brands that win are the ones with better ideas and sharper creative direction. The asset is no longer the hard part. Knowing what to make, why it matters, and how it all fits together? That's the hard part. And it's still a human job.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Creative direction</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              We develop creative briefs for every campaign. Visual direction, tone of voice, format specs, platform-native references. Each brief is built around what actually performs on the target platform. We study top-performing content in your category, pull references from trending posts, and look at what KOL (Key Opinion Leader) content is driving engagement right now.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Campaign orchestration</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              A campaign is not a collection of posts. It's a coordinated push across content, influencers, paid media, and community engagement. Our social media managers coordinate KOL posting schedules with brand content drops, align paid media with organic momentum, and shift resources mid-campaign when something takes off or falls flat.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Day-to-day + KPI + Analytics — service cards -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Execution">Day-to-day operations and reporting</SectionHeading>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">01</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Account management</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">We handle the daily work across WeChat, Douyin, RedNote, Weibo, and 14 more platforms. Content publishing, community engagement, comment management, trend monitoring. So you don't need to hire a local team.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">02</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Campaigns and activations</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Seasonal campaigns, product launches, holiday activations, and cross-platform pushes. Clear brief, defined KPIs, timeline, post-campaign report.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">03</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">KPI framework and goal setting</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Measurable targets from day one. Follower growth, engagement rate, video views, click-through rate, conversions. KPIs are tied to business outcomes. Not vanity metrics. Reviewed monthly, recalibrated quarterly.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">04</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Analytics and reporting</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Monthly reports cover follower growth, engagement rates, content performance, ad spend efficiency, and competitive benchmarking. Cross-platform performance tracking, content-level engagement data, and recommendations. Not just charts.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study — callout box style -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Case study</p>
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[var(--color-ink)] mb-[24px]">European natural skincare brand launches on RedNote</h2>

        <div class="max-w-[680px] flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
          <p>
            A European natural skincare brand with a strong following in France and Germany wanted to test the market before committing to a full launch. No social accounts, no local team, and no clear idea which platform to start with.
          </p>
          <p class="text-[var(--color-stone)]">
            The brand's global agency recommended reposting existing product content on WeChat. That would have been a mistake. Generic product flat lays don't perform on WeChat. And more importantly, WeChat is not a discovery platform for brands nobody has heard of yet.
          </p>
          <p>
            Four-week market and competitor analysis. We mapped the natural skincare category across RedNote, Douyin, and WeChat. RedNote had the highest organic reach for new skincare brands, the most relevant audience (women 22 to 35, Tier 1 and 2 cities), and the strongest product discovery behavior.
          </p>
          <p>
            One platform. Full focus. No spreading the budget thin. Content strategy built around three pillars: ingredient education, before-and-after results, and daily routine content.
          </p>
        </div>

        <!-- Results grid -->
        <div class="grid grid-cols-4 max-[640px]:grid-cols-2 gap-[24px] mt-[32px] pt-[32px] border-t border-[rgba(0,0,0,0.08)]">
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">8,400</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Followers from zero in 90 days. No paid advertising.</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">6.2%</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Average engagement rate. Roughly three times the category benchmark.</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">12</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Organic KOC (Key Opinion Consumer) product mentions. All unpaid.</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">6 mo</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Growth package signed. Added Douyin in month four.</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- How to get started — numbered steps -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Get started">Ready to build your strategy?</SectionHeading>

      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">01</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Book a 30-minute discovery call</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Tell us about your brand, your goals, and your market. We'll ask the right questions.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">02</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Get a tailored proposal</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Clear scope and fixed pricing. No surprises. You'll know exactly what you're getting.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">03</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Strategy, setup, and first content</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Account setup and first content within two weeks of signing.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="FAQ">Frequently asked questions</SectionHeading>

      <div class="max-w-[680px] flex flex-col gap-[32px] mt-[24px]">
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How long does the strategy phase take?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Depends on the scope, but usually two to four weeks. Our team does this daily so things move fast.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Do you only work with brands new to the market?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">No. Brands entering the market, brands already active that want better results, and domestic brands growing their social presence. Three different starting points, same level of rigor.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Can we start with just one platform?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Yes, and honestly we often recommend it. Focus your budget, learn what works, build traction before expanding.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">What platforms do you cover?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">WeChat, Douyin, RedNote, and Weibo in all packages. Bilibili, Zhihu, Kuaishou, Toutiao, Meituan, Dianping, and nine more as add-ons.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How is pricing structured?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Fixed scope, fixed price. Clear list of deliverables and one monthly fee. Ad spend billed separately. No hidden markups, no surprises.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">What makes your analytics different from a regular platform dashboard?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Cross-platform performance tracking, competitive benchmarks, content-level engagement data. And we turn all of that into recommendations, not just charts.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Do you handle content creation too, or just strategy?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Strategy and campaigns live under this service. Content production (visuals, video, copywriting) is separate, but the two work hand in hand. Your strategy defines what gets made.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How often do you update the strategy?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Monthly at minimum. Every quarter, we go deeper with KPI recalibration, competitor re-benchmarking, and a platform mix review.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Can you work alongside our internal team or existing agency?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Some clients want us to lead everything. Others want the strategy from us and handle execution with their own people. Whatever setup makes sense, we can make it work.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">What if our social accounts already exist but aren't performing?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">We start with an audit. Current accounts, content, engagement, competitive position. Then we build a revised strategy based on what the data actually shows. Sometimes the fix is the platform mix. Sometimes it's the content itself, or the posting frequency, or the timing. We figure out where the gap is before changing anything.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="mt-[96px] max-[640px]:mt-[64px] mb-[0px]">
    <div class="w-full bg-[var(--color-rice-paper)] py-[64px] max-[640px]:py-[48px] px-[48px] max-[640px]:px-[20px]">
      <div class="max-w-[600px] mx-auto text-center">
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[var(--color-ink)] mb-[8px]">
          Want to talk strategy?
        </h2>
        <p class="text-[14px] text-[var(--color-stone)] font-normal leading-[1.6] mb-[24px]">
          30-minute discovery call. Tailored proposal with clear scope and fixed pricing. First content within two weeks.
        </p>
        <div class="flex items-center justify-center gap-[12px] flex-wrap">
          <Button variant="primary" href="/contact">Book a call</Button>
          <Button variant="secondary" href="/pricing">See pricing</Button>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
