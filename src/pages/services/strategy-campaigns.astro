---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import FaqAccordion from '../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'How long does the strategy phase take?', a: 'Depends on the scope, but usually two to four weeks. Our team does this daily so things move fast.' },
  { q: 'Do you only work with brands new to the market?', a: 'No. Brands entering the market, brands already active that want better results, and domestic brands growing their social presence. Three different starting points, same level of rigor.' },
  { q: 'Can we start with just one platform?', a: 'Yes, and honestly we often recommend it. Focus your budget, learn what works, build traction before expanding.' },
  { q: 'What platforms do you cover?', a: 'WeChat, Douyin, RedNote, and Weibo in all packages. Bilibili, Zhihu, Kuaishou, Toutiao, Meituan, Dianping, and nine more as add-ons.' },
  { q: 'How is pricing structured?', a: 'Fixed scope, fixed price. Clear list of deliverables and one monthly fee. Ad spend billed separately. No hidden markups, no surprises.' },
  { q: 'What makes your analytics different from a regular platform dashboard?', a: 'Cross-platform performance tracking, competitive benchmarks, content-level engagement data. And we turn all of that into recommendations, not just charts.' },
  { q: 'Do you handle content creation too, or just strategy?', a: 'Strategy and campaigns live under this service. Content production (visuals, video, copywriting) is separate, but the two work hand in hand. Your strategy defines what gets made.' },
  { q: 'How often do you update the strategy?', a: 'Monthly at minimum. Every quarter, we go deeper with KPI recalibration, competitor re-benchmarking, and a platform mix review.' },
  { q: 'Can you work alongside our internal team or existing agency?', a: 'Some clients want us to lead everything. Others want the strategy from us and handle execution with their own people. Whatever setup makes sense, we can make it work.' },
  { q: 'What if our social accounts already exist but aren\'t performing?', a: 'We start with an audit. Current accounts, content, engagement, competitive position. Then we build a revised strategy based on what the data actually shows. Sometimes the fix is the platform mix. Sometimes it\'s the content itself, or the posting frequency, or the timing. We figure out where the gap is before changing anything.' },
];

const gettingStartedSteps = [
  {
    title: 'Discovery call.',
    description: 'Your brand, your goals, your China readiness. No pitch deck. Just the right questions.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Proposal.',
    description: 'Clear scope. Fixed price. Every deliverable listed out. You see what you\'re getting before you commit.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'Live in 2 weeks.',
    description: 'Strategy delivered, campaigns configured, first content published. Two weeks from signed contract.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="China Social Media Strategy & Campaigns | TheRedScroll"
  description="Social media strategy, campaign management, and analytics for brands in China. Fixed scope, fixed price. Team on the ground in Shanghai."
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/strategy-campaigns-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Strategy, campaigns and analytics
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        The right plan. The right platforms. The right numbers.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        We research your market, build your plan, run your campaigns, and measure what matters. From Shanghai and Hong Kong.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
      </div>
    </div>
  </section>

  <!-- Problem intro -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="The problem">Most brands post content without a plan.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              They pick platforms based on gut feeling, publish when they have time, and check numbers once a quarter. Maybe less.
            </p>
            <p>
              A real strategy starts somewhere else entirely. Which platforms fit your industry. What your competitors are doing and where they're falling short. What content formats drive results. And how you'll know if any of it is working.
            </p>
            <p>
              We build strategies from the ground up. Real market data. Real competitor analysis. Real platform knowledge. Then we run the campaigns ourselves, every day.
            </p>
          </div>
        </div>
        <div class="flex items-center justify-center">
          <img src="/images/strategy-compass.svg" alt="Compass without a needle — strategy without direction" class="w-full max-w-[320px]" loading="lazy" />
        </div>
      </div>
    </Container>
  </section>

  <!-- Why you need a platform-specific strategy -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <!-- Hero card: 2 cols, 2 rows -->
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/><circle cx="7" cy="16" r="1.5"/><circle cx="11" cy="8" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="21" cy="4" r="1.5"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Why it matters</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Why you need a platform-specific strategy</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">Each platform has its own audience, format, and algorithm. A single approach across all of them wastes budget and misses opportunities.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
          </div>
        </div>
        <!-- Cards -->
        <div class="bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="8" height="8" rx="1"/><rect x="14" y="3" width="8" height="8" rx="1"/><rect x="2" y="13" width="8" height="8" rx="1"/><rect x="14" y="13" width="8" height="8" rx="1"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Each platform has its own rules</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">WeChat, Douyin, RedNote, and Weibo have different content formats, ad systems, and user expectations. Wrong platform, wasted budget.</p>
        </div>
        <div class="bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M7 7l3.5 9M17 7l-3.5 9"/><path d="M7 6h10"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">The audience moves across platforms</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">Consumers research on RedNote, follow brands on WeChat, watch product demos on Douyin, and check opinions on Weibo.</p>
        </div>
        <div class="bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">The competition is already there</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">Your competitors are posting daily, running influencer campaigns, and buying ads. Without a clear strategy, you're just spending.</p>
        </div>
        <div class="bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Things move quickly</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Algorithms get updated without warning. New ad formats appear every few months. A strategy that worked in January might not work in April.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do — Market & Competitor Research -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="What we do">Market and competitor research</SectionHeading>

      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img src="/images/what-we-do/strategy-campaigns.png" alt="TheRedScroll team reviewing strategy and competitor data" class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Competitor research</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">We map competitors' social accounts across every major platform. Follower counts, posting frequency, engagement rates, content themes, ad strategies. Custom analysis, not a template report.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Platform selection</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Not every brand needs every platform. Beauty starts on RedNote. B2B needs WeChat and Zhihu. Fashion gets reach from Douyin. We pick the right ones for your category.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Content strategy and calendar</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Content pillars, messaging framework, editorial voice for each platform. Topics, formats, posting schedule. Each platform gets its own calendar, updated monthly on performance.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Creative & Planning — dark section (1 per page) -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[1024px]:p-[32px] max-[640px]:p-[32px_20px]">
        <div class="grid grid-cols-[1fr_1px_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px]">
          <!-- Col 1: heading + intro -->
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Creative and planning</p>
            <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[24px]">The part that actually matters most.</h2>
            <div class="flex flex-col gap-[24px]">
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                AI has changed content production. Visuals, video edits, copy drafts, all of it can be produced faster and cheaper than it could even a year ago. Production costs are heading toward zero.
              </p>
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                That shift makes creative planning more important. Not less. When anyone can produce content at scale, the brands that win are the ones with better ideas and sharper creative direction. The asset is no longer the hard part. Knowing what to make, why it matters, and how it all fits together? That's the hard part. And it's still a human job.
              </p>
            </div>
          </div>
          <!-- Vertical separator -->
          <div class="flex items-center max-[640px]:hidden">
            <div class="w-[1px] h-[60%] bg-[var(--color-vermillion)]"></div>
          </div>
          <!-- Col 2: service details -->
          <div class="flex flex-col gap-[32px]">
            <div>
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Creative direction</h3>
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                We develop creative briefs for every campaign. Visual direction, tone of voice, format specs, platform-native references. Each brief is built around what actually performs on the target platform. We study top-performing content in your category, pull references from trending posts, and look at what KOL (Key Opinion Leader) content is driving engagement right now.
              </p>
            </div>
            <div>
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Campaign orchestration</h3>
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                A campaign is not a collection of posts. It's a coordinated push across content, influencers, paid media, and community engagement. Our social media managers coordinate KOL posting schedules with brand content drops, align paid media with organic momentum, and shift resources mid-campaign when something takes off or falls flat.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Day-to-day + KPI + Analytics — service cards -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Execution">Day-to-day operations and reporting</SectionHeading>

      <!-- Horizontal column accordion -->
      <div class="flex gap-[2px] mt-[24px] h-[400px] max-[640px]:flex-col max-[640px]:h-auto" data-col-accordion>

        <div class="col-panel is-active rounded-l-[10px] max-[640px]:rounded-l-none max-[640px]:rounded-t-[10px]" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Account management</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Account management</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">We handle the daily work across WeChat, Douyin, RedNote, Weibo, and 14 more platforms. Content publishing, community engagement, comment management, trend monitoring. So you don't need to hire a local team.</p>
          </div>
        </div>

        <div class="col-panel" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Campaigns and activations</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Campaigns and activations</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Seasonal campaigns, product launches, holiday activations, and cross-platform pushes. Clear brief, defined KPIs, timeline, post-campaign report.</p>
          </div>
        </div>

        <div class="col-panel" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">KPI framework and goal setting</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">KPI framework and goal setting</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Measurable targets from day one. Follower growth, engagement rate, video views, click-through rate, conversions. KPIs are tied to business outcomes. Not vanity metrics. Reviewed monthly, recalibrated quarterly.</p>
          </div>
        </div>

        <div class="col-panel rounded-r-[10px] max-[640px]:rounded-r-none max-[640px]:rounded-b-[10px]" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Analytics and reporting</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Analytics and reporting</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Monthly reports cover follower growth, engagement rates, content performance, ad spend efficiency, and competitive benchmarking. Cross-platform performance tracking, content-level engagement data, and recommendations. Not just charts.</p>
          </div>
        </div>

      </div>

      <style>
        .col-panel {
          position: relative;
          flex: 0 0 56px;
          background: var(--color-rice-paper);
          cursor: pointer;
          overflow: hidden;
          transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .col-panel.is-active {
          flex: 1 1 0%;
          cursor: default;
        }

        /* Vertical rotated label — visible when collapsed */
        .col-label {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 1;
          transition: opacity 0.3s ease;
        }
        .col-panel.is-active .col-label {
          opacity: 0;
          pointer-events: none;
        }
        .col-label-text {
          writing-mode: vertical-rl;
          text-orientation: mixed;
          transform: rotate(180deg);
          font-size: 14px;
          font-weight: 500;
          color: var(--color-ink);
          white-space: nowrap;
          letter-spacing: 0.02em;
        }

        /* Expanded content */
        .col-content {
          position: absolute;
          inset: 0;
          padding: 32px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          opacity: 0;
          transition: opacity 0.35s ease 0.15s;
        }
        .col-panel.is-active .col-content {
          opacity: 1;
        }

        /* Vermillion left accent on active panel */
        .col-panel.is-active::before {
          content: '';
          position: absolute;
          left: 0;
          top: 15%;
          bottom: 15%;
          width: 3px;
          background: var(--color-vermillion);
          border-radius: 0 2px 2px 0;
        }

        /* Hover state for collapsed panels */
        .col-panel:not(.is-active):hover {
          background: var(--color-warm-gray);
        }

        /* Mobile: stack vertically */
        @media (max-width: 640px) {
          .col-panel {
            flex: 0 0 48px;
          }
          .col-panel.is-active {
            flex: 0 0 auto;
            min-height: 200px;
          }
          .col-label-text {
            writing-mode: horizontal-tb;
            transform: none;
            font-size: 13px;
          }
          .col-content {
            position: relative;
            padding: 20px;
          }
          .col-panel.is-active::before {
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            height: auto;
          }
        }
      </style>

      <script>
        document.querySelectorAll('[data-col-accordion]').forEach((accordion) => {
          const panels = accordion.querySelectorAll('[data-col-panel]');
          panels.forEach((panel) => {
            panel.addEventListener('click', () => {
              if (panel.classList.contains('is-active')) return;
              panels.forEach((p) => p.classList.remove('is-active'));
              panel.classList.add('is-active');
            });
          });
        });
      </script>
    </Container>
  </section>

