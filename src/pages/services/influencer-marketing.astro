---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import FaqAccordion from '../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'How do you detect fake followers?', a: 'We cross-reference follower counts against engagement metrics, comment quality, and audience demographics. A creator with 200,000 followers and 50 comments per post, mostly generic emoji, that\'s a red flag. Platform tools like Xingtu and Pugongying also provide authenticated data. After a few hundred campaigns you recognize the patterns quickly.' },
  { q: 'How many KOLs do we need?', a: 'Depends on what you\'re trying to do. Seeding campaign: 20 to 50 KOCs. Brand awareness push: 3 to 5 mid-tier KOLs. Hero product launch: one top-tier creator supported by 10 to 15 KOCs. We build the mix around your budget and goals.' },
  { q: 'Can we approve content before it goes live?', a: 'Generally yes. We share drafts or preview content before publication. Some creators resist heavy editing because it kills authenticity, and they\'re usually right. But key messages, compliance labels, and brand guidelines always get checked.' },
  { q: 'What\'s the difference between KOL and KOC?', a: 'KOLs are professional creators with large followings and polished content. KOCs (Key Opinion Consumers) are everyday users with smaller audiences who share genuine product experiences. KOLs drive awareness. KOCs build trust and search presence. Most campaigns need both.' },
  { q: 'How long to launch a campaign?', a: 'Two to four weeks from brief to first post. That covers creator identification, outreach, negotiation, briefing, content production, and review. Seeding campaigns with KOCs move faster, sometimes one to two weeks.' },
  { q: 'Can influencer content be reused as ad creative?', a: 'Sometimes. Usage rights have to be negotiated upfront. Some creators include ad usage in their fee. Others want a separate licensing payment, which can add 30 to 50% on top. We sort this out during contracting so nobody gets surprised later.' },
  { q: 'What industries work best?', a: 'Beauty, skincare, and fashion see the strongest results because the creator ecosystem is the most developed. F&B, health and wellness, hospitality, and consumer electronics are close behind. B2B brands can also make it work, especially on WeChat and Zhihu, but the pool of relevant creators is smaller.' },
  { q: 'Do you handle payments to creators?', a: 'The whole flow. Negotiation, contracting, payment, tax documentation. You pay us. We sort out the rest with the creators and their MCNs.' },
];

const gettingStartedSteps = [
  {
    title: 'Discovery call.',
    description: 'Your brand, your goals, and the type of creators you want to work with.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'KOL shortlist.',
    description: 'Vetted creators matched to your brand, niche, and budget. Every engagement number verified.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'First posts in 2-4 weeks.',
    description: 'Creator outreach, briefing, content production, review, and publication.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="China KOL & KOC Influencer Agency | TheRedScroll"
  description="KOL and KOC campaigns on Douyin, RedNote, WeChat. Creator vetting, live commerce, campaign management. Fixed scope. Team in Shanghai."
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/influencer-marketing-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Influencer marketing
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        The right creator talking about your brand is worth more than any ad.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        We find the right KOLs and KOCs, vet them, brief them, manage the relationship, and track what actually came back. From Shanghai and Hong Kong.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
      </div>
    </div>
  </section>

  <!-- Why influencer marketing is essential -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[24px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><path d="M20.84 4.61a5.5 5.5 0 0 1-8.69 4.28"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">The case for creators</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Why influencer marketing is essential</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">Advertising puts your message in front of people. Influencer marketing puts your product in the hands of someone they already trust.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
          </div>
        </div>
        <div class="relative overflow-hidden bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">It reaches communities, not demographics</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">A KOL's followers share interests, taste, and trust. When that person recommends a product, the audience responds in ways they wouldn't for a paid ad.</p>
        </div>
        <div class="relative overflow-hidden bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Conversion rates tend to be higher</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">Brands using KOL collaborations on RedNote report conversion rates roughly 2.3x higher than traditional ad channels.</p>
        </div>
        <div class="relative overflow-hidden bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">The market is growing fast</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">The influencer economy is forecast to hit RMB 117 billion by the end of 2025. Over half of advertisers already use influencer content.</p>
        </div>
        <div class="relative overflow-hidden bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">But it's incredibly time-consuming</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Finding creators, verifying followers, negotiating fees, reviewing content, tracking results. A single campaign with 15 creators can eat up 100+ hours.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="What we do">KOL and KOC identification</SectionHeading>

      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img src="/images/what-we-do/influencer-kol-douyin.png" alt="Phone showing Douyin KOL video feed with Chinese influencer content" class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[24px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Creator identification</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Database of creators across Douyin, RedNote, WeChat, Weibo, Bilibili, and Kuaishou. Every creator checked for engagement authenticity, audience quality, content style, and brand fit.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[24px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Campaign planning and briefing</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Every campaign gets a brief. Objectives, key messages, content format, posting schedule, platform rules. KOL schedules coordinated with your content calendar and paid media.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[24px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Negotiation and contracting</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">We negotiate rates, usage rights, exclusivity terms, and deliverables. Listed rates and what brands actually pay can differ by 15% or more. We know what things should cost.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Live commerce, compliance, reporting — dark section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Full service</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">From live commerce to compliance to reporting</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            Live streaming is a serious sales channel. A single session on Douyin or Taobao Live can move thousands of orders in a couple of hours. We coordinate host selection, product briefing, script development, real-time chat moderation, and post-session reporting.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Compliance and disclosure</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Sponsored content on Chinese platforms is subject to advertising regulations. RedNote requires clear disclosure labels. Douyin flags undisclosed promotions. We make sure every piece of KOL content meets platform requirements and complies with relevant advertising rules.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Performance tracking</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Every campaign is measured. Impressions, engagement rate, click-throughs, conversions, cost per result. Post-campaign reports include who to keep working with, who to drop, and who's worth testing next time. We refine the creator mix based on data, not gut feeling.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Live commerce</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              For brands with a Douyin Shop, we run sessions linked directly to your product pages. Host selection, product briefing, real-time chat, and post-session reporting. The commission model means your risk is partially shared with the host.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Payment handling</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Negotiation, contracting, payment, tax documentation. You pay us. We sort out the rest with the creators and their MCNs. Flat fee, commission on sales, product exchange, or hybrid structures depending on the campaign.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- What is an MCN -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Industry context">What is an MCN?</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              MCN stands for Multi-Channel Network. In practice, it's a talent management company for creators. MCNs sign contracts with KOLs and KOCs, then manage their content production, brand deals, and monetization.
            </p>
            <p>
              As of 2025, there are roughly 29,000 registered MCN organizations operating across the market. Chinese MCNs train creators, produce their content, manage supply chains for live commerce, and handle platform compliance. A lot of the biggest names on Douyin and RedNote were incubated by MCNs.
            </p>
            <p>
              When you want to work with a mid-tier or top-tier KOL, you're almost always negotiating with their MCN. We work with major MCNs across Douyin, RedNote, and WeChat. Those relationships mean faster response times, priority access to creators who are usually booked out, and pricing that's hard to get if you're reaching out cold.
            </p>
          </div>
        </div>
        <div class="flex items-center justify-center">
          <img src="/images/ecosystem/influencers.png" alt="MCN and influencer network in China" class="w-full max-w-[320px]" loading="lazy" />
        </div>
      </div>
    </Container>
  </section>

  <!-- KOL/KOC pricing — RedNote -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center mb-[48px] max-[640px]:mb-[32px]">
        <div>
          <SectionBar />
          <SectionHeading overline="Indicative pricing">RedNote / Xiaohongshu</SectionHeading>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">
            Rates depend on follower count, engagement rate, content format, niche, and exclusivity. These ranges reflect Q1 2026 benchmarks. Not quotes.
          </p>
        </div>
        <div class="flex items-center justify-center">
          <img src="/images/platforms/rednote-services/kol-koc.png" alt="KOL and KOC creators on RedNote" class="w-full max-w-[420px] rounded-[10px]" loading="lazy" decoding="async" />
        </div>
      </div>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Nano-KOCs (under 5K)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">¥100 to ¥500/post, or product exchange only. Best for seeding campaigns that build search presence through volume.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Micro-KOCs (5K to 20K)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">¥500 to ¥3,000/post. High engagement rates. Great for authentic product reviews and organic buzz.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Mid-tier KOLs (20K to 100K)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">¥3,000 to ¥15,000/post. The sweet spot for most campaigns. Good reach, real credibility, and the cost per engagement usually makes sense.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Top-tier KOLs (100K+)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">¥15,000 to ¥80,000+/post. Beauty and luxury KOLs command roughly 50% more than other categories. Video notes cost 20 to 30% more than photo notes.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Douyin pricing -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center mb-[48px] max-[640px]:mb-[32px]">
        <div>
          <SectionBar />
          <SectionHeading overline="Indicative pricing">Douyin</SectionHeading>
        </div>
        <div class="flex items-center justify-center">
          <img src="/images/platforms/douyin-services/kol-campaigns.png" alt="KOL campaign creators on Douyin" class="w-full max-w-[420px] rounded-[10px]" loading="lazy" decoding="async" />
        </div>
      </div>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Micro-creators (under 50K)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">¥1,000 to ¥5,000/video. Good for product demos and tutorials.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Mid-tier KOLs (50K to 500K)</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">¥5,000 to ¥30,000/video. Effective for brand awareness and driving Douyin Shop traffic.</p>
