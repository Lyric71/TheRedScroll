        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/douyin-hashtag-challenge.svg" alt="Douyin hashtag challenge page" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
