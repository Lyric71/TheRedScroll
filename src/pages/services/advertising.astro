---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import FaqAccordion from '../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'How much budget do I need to start?', a: 'Depends on the platform. RedNote from ¥5,000. Douyin in-feed from ¥1,000/day. WeChat Moments ¥1,000/day minimum. We recommend ¥15,000 to ¥30,000/month to collect enough data for real optimization.' },
  { q: 'Do you manage ad spend directly?', a: 'Yes. Spend goes to the platform. We don\'t mark it up. Our fee covers strategy, setup, creative, and reporting.' },
  { q: 'How fast can we see results?', a: 'Traffic campaigns: first week. Conversions: two to three weeks of optimization. Brand awareness: 30 to 60 days.' },
  { q: 'What if our current ads aren\'t performing?', a: 'We audit first. Campaigns, targeting, creatives, spend allocation. Then rebuild what\'s broken. Common issues: wrong format, stale creatives, targeting too broad, nobody optimizing day to day.' },
  { q: 'Do you produce the creatives?', a: 'Yes. Video, image, copy for each platform. Creative direction is human-led. Production gets an AI boost through HubStudio.ai.' },
  { q: 'Boosting a post vs. running a campaign?', a: 'Boosting is simple but limited. A campaign gives you precise targeting, creative testing, conversion goals, bid optimization, and ROAS tracking. The gap in results is usually significant.' },
  { q: 'Is ROAS always the right metric?', a: 'For e-commerce and direct-response, pretty much always. For brand awareness, we switch to CPM and reach. The point is: we define what success looks like before launch, not after.' },
  { q: 'Can we run ads on multiple platforms?', a: 'Yes, and in most cases you should. Douyin + RedNote covers awareness and discovery. WeChat retargets people who engaged elsewhere. We figure out the mix based on your goals and what you can spend.' },
  { q: 'What about account verification?', a: 'Most platforms won\'t let you into the ad manager without it. We handle the process. Takes one to three weeks.' },
  { q: 'How is your pricing structured?', a: 'Fixed fee for creative work. Ad spend is separate and goes straight to the platforms. No confusion there.' },
];

const gettingStartedSteps = [
  {
    title: 'Discovery call.',
    description: 'Your brand, your goals, and what you\'re looking to spend. We\'ll figure out the right approach.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Media plan.',
    description: 'Platform recommendations, budget allocation, and projected KPIs. Clear scope. Fixed management fee.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'Ads live in 2 weeks.',
    description: 'Account setup, creative production, and campaign launch. Daily optimization from day one.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="China Social Media Ads | TheRedScroll Agency"
  description="Ad planning, buying, and daily optimization across WeChat, Douyin, and RedNote. Fixed management fee. Transparent ad spend. Team in Shanghai."
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/advertising-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Advertising planning and buying
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Reach the right people. Not just more people.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        We plan, buy, and optimize ad campaigns across WeChat, Douyin, RedNote, and Weibo. Fixed management fee. Transparent ad spend.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
      </div>
    </div>
  </section>

  <!-- Why advertising is (almost) mandatory -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">The case for paid</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Why advertising is almost mandatory</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">Organic reach builds a following over time. But it can't target women aged 25 to 34 in Shanghai who searched for "natural skincare" last week. Advertising can.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
          </div>
        </div>
        <div class="relative overflow-hidden bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">It's faster</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Organic takes months. A well-targeted campaign can drive conversions within days.</p>
        </div>
        <div class="relative overflow-hidden bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">It's precise</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">Target by age, gender, city tier, interests, device, purchase behavior, and content interaction history. Ads go where you point them.</p>
        </div>
        <div class="relative overflow-hidden bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">It scales</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">Test with ¥5,000 on Monday and scale to ¥50,000 by Friday if the numbers work. Try doing that with organic content.</p>
        </div>
        <div class="relative overflow-hidden bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">But it's not free</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">A poorly planned campaign burns budget faster than no campaign at all. Media planning, daily optimization, and clear KPIs matter just as much as the ads themselves.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="What we do">Media planning</SectionHeading>

      <!-- Hero image -->
      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img
          src="/images/what-we-do/advertising.png"
          alt="TheRedScroll team analyzing ad campaign performance"
          class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Overlapping cards -->
      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Media planning</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Before we spend a single yuan, we build the plan. Which platforms, which formats, which audience segments, how much per channel, and what the expected cost per result looks like.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Campaign setup and optimization</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Full cycle. Account setup, creative upload, audience targeting, bid strategy, A/B testing. Optimized daily. A creative that worked Monday can fatigue by Thursday.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Platform coverage</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">We run campaigns on Ocean Engine (Douyin), Tencent Ads (WeChat), Juguang (RedNote), and Weibo Fan Tong. We know where the settings that matter are buried.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Ad creative + Retargeting + Compliance + Reporting — dark section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[1024px]:p-[32px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Full service</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">From creative to compliance to reporting</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            An ad that looks like an ad gets skipped. An ad that looks like content gets watched. We produce creatives for each platform's format and swap them out before performance drops. AI handles production volume. Our team handles creative direction.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Retargeting and custom audiences</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Someone watched 50% of your Douyin video but didn't click? Retarget them with a different angle. A user visited your Mini Program but left without buying? Show them a follow-up. On RedNote, you can build audiences from users who engaged with specific notes or searched specific keywords. Often where the best ROAS comes from.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Compliance and ad approval</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Every platform has its own ad review process. Some industries face restrictions or outright bans. We handle content compliance pre-checks, the approval workflow, and flag industry-specific restrictions before you commit any budget.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Performance reporting</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              ROAS (Return on Ad Spend) is the number we organize everything around. We also track CPC, CPM, CTR, CPA, conversion rate, and frequency. Weekly reports during active campaigns. Monthly summaries. For larger budgets, real-time dashboard access.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Transparent spend</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Ad spend is billed separately. No markups. No hidden agency fees on media. You see exactly where every yuan goes.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Ad formats & indicative pricing — WeChat -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Ad formats and pricing">WeChat (via Tencent Ads)</SectionHeading>
      <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[24px] max-w-[680px]">
        Prices below are based on Q1 2026 data and our own benchmarks. They'll help you plan. They're not quotes.
      </p>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-moments-ad.svg" alt="WeChat Moments ad example" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Moments ads</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Native ads in users' social feed. Carousel (up to six cards), autoplay video (6-15 sec), or canvas (full-screen on tap). 122 interest sub-categories. Auction from ¥1,000/day. CPM ¥50 to ¥180 by city tier.</p>
          </div>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-banner-ad.svg" alt="WeChat banner ad in Official Account article" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Banner ads</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Bottom or middle of Official Account articles. CPC from ¥0.5. CPM ¥15 to ¥25. Cost per new follower: ¥8 to ¥20. Most affordable format.</p>
          </div>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-channels-ad.svg" alt="WeChat Channels video ad" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Channels ads</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Video ads in WeChat's short-video feed. CPM ¥2 to ¥13. Less saturated than Moments.</p>
          </div>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-search-ad.svg" alt="WeChat Search ad in search results" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Search ads (搜一搜)</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Keyword-based in WeChat search results. CPC model. Growing format, still underused.</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Douyin -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Ad formats and pricing">Douyin (via Ocean Engine)</SectionHeading>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/douyin-in-feed.svg" alt="Douyin in-feed ad in For You scroll" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">In-feed ads</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Up to 60-second video in the "For You" scroll. CPC from ¥0.2. CPM ¥10 to ¥50. Supports e-commerce links, lead forms, Douyin Shop. The main performance format.</p>
          </div>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/douyin-topview.svg" alt="Douyin TopView full-screen ad at app open" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
