---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="WeChat CRM & Private Domain Traffic | TheRedScroll"
  description="WeChat CRM, WeCom setup, private domain strategy for China. Community management, Mini Program CRM, customer activation. Shanghai team."
>

  <!-- Hero — Dark hero banner -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        CRM and private domain traffic
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Your followers are your most valuable asset. Own the relationship.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Build direct, repeatable customer relationships inside WeChat. No platform fees. No algorithm deciding who sees what.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact">Book a call</Button>
        <Button variant="secondary-dark" href="#what-we-do">See what we do</Button>
      </div>
    </div>
  </section>

  <!-- Why private domain matters -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <div>
          <SectionBar />
          <SectionHeading overline="Why it matters">On Douyin and RedNote, you rent the audience. The platform owns it.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              The algorithm decides who sees your content. Ad costs go up 30% next quarter? Your reach shrinks and there's nothing you can do about it.
            </p>
            <p>
              Private domain puts the brand back in control. Your WeChat Official Account followers, WeCom contacts, group members, Mini Program users. These people opted in. You reach them directly, as often as you want, without paying a platform toll every time.
            </p>
          </div>
        </div>
        <div class="flex flex-col pt-[48px] max-[640px]:pt-[0px]">
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Conversion rates in private domain consistently beat public traffic. Some brands report that private domain customers drive over 85% of repeat sales. Once the community hits a certain size, the unit economics outperform everything else.
            </p>
            <p class="text-[var(--color-stone)]">
              Flash sales in WeChat groups. One-on-one product advice through WeCom. VIP early access. Personalized recommendations pulled from CRM data. Private domain audiences are smaller than Douyin. But the per-person value is dramatically higher.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- WeChat vs WeCom — dark section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Platform basics</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[32px]">WeChat vs. WeCom: what's the difference</h2>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px] mb-[32px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">WeChat (微信)</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              The consumer app. 1.3 billion users. Messaging, Moments, Official Accounts, Mini Programs, WeChat Pay, Channels. It's where your customers live.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">WeCom (企业微信)</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              The enterprise counterpart. Separate app, built for businesses to communicate with customers and manage teams. Connects 14 million organizations to 750 million WeChat users.
            </p>
          </div>
        </div>
        <div class="max-w-[680px] flex flex-col gap-[24px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            Your team messages customers directly inside their personal WeChat. The message lands in the customer's regular chat list. Feels personal. Doesn't feel like a marketing blast.
          </p>
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            Associates stop swapping personal WeChat contacts the company can't see or track. They use WeCom IDs owned by the business instead. Conversations get logged. Data feeds the CRM. When somebody on the team leaves, client relationships stay with the company.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="What we do">WeCom setup and CRM integration</SectionHeading>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] max-w-[680px]">
          <p>
            Starting point is getting WeCom operational and plugged into everything else. Account setup, team roles, integration with Official Account, Mini Program, CRM. The goal: customer data from every touchpoint ends up in one place. Not on somebody's personal phone. Not in a spreadsheet that nobody updates.
          </p>
          <p>
            Brands already running Salesforce, HubSpot, or another global CRM get an integration layer that syncs WeCom data with what's already there. Those starting from scratch are usually better served by Chinese platforms like Tencent Qidian or Fxiaoke. Both connect natively to WeCom.
          </p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">WeChat CRM and Mini Program CRM</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[24px]">
            The CRM layer sits inside WeChat itself. A Mini Program can house the full system: customer profiles, purchase history, loyalty tiers, coupon distribution, personalized messaging, automated follow-ups. It all lives in the app your customers use daily.
          </p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Private domain strategy</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">
            Architecture depends on the brand. A luxury house with 200 VIP clients needs a fundamentally different setup than a skincare company managing 15,000 followers. Strategy means channel selection, the path from public traffic into private channels, content and offer cadence by segment, and a measurement framework. PIPL compliance gets baked in from day one.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Community building -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Community">Community building and management</SectionHeading>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Group segmentation</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Groups get segmented by customer type, interest, geography, purchase history. Each one has a content cadence, a community manager, and regular activations.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Activations</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Exclusive early access, group-only pricing, Q&A sessions with brand founders, user-generated content challenges, feedback polls that actually lead somewhere. These aren't broadcast blasts. They're interactions that build something real.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Brand personas</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Some brands take it further with fictional brand personas as group hosts. A character with a name, a voice, a backstory who makes the group feel less corporate and more like a friend's recommendation. When done well, it's one of the most effective community tools we've seen.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">CRM automation</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Push a personalized offer to 500 VIPs about an exclusive drop. Run a flash sale and watch conversions in real time. Send a re-engagement message to customers who haven't bought in 90 days. Once set up, most of this runs without anyone touching it.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Case study -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[48px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Case study</p>
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[var(--color-ink)] mb-[24px]">French luxury accessories brand builds private domain</h2>

        <div class="max-w-[680px] flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
          <p>
            A French luxury accessories brand with four stores in Tier 1 Chinese cities had around 12,000 WeChat followers but no real system for converting them into repeat customers. Sales associates were adding clients on personal WeChat. The company had zero visibility into those relationships.
          </p>
          <p class="text-[var(--color-stone)]">
            Whenever reps left, the client list walked out the door with them. The follower base wasn't doing much beyond receiving a monthly article most people probably skimmed.
          </p>
          <p>
            Three workstreams ran at the same time. WeCom went live across four stores. Eighteen associates came onboard. Client contacts shifted from personal WeChat to company WeCom IDs. A lightweight CRM went inside the existing Mini Program, linked to purchase data from the offline POS system. Four VIP WeChat groups launched, one per store, capped at 200 members.
          </p>
          <p>
            Weekly content included product stories, styling tips, early-access offers. Monthly, a virtual Q&A with the creative director. That format generated more engagement than anything else we tried, by a wide margin.
          </p>
        </div>

        <!-- Results grid -->
        <div class="grid grid-cols-4 max-[640px]:grid-cols-2 gap-[24px] mt-[32px] pt-[32px] border-t border-[rgba(0,0,0,0.08)]">
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">680</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Contacts migrated from personal WeChat to WeCom.</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">3.2x</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Repurchase rate for VIP group members vs. non-group followers.</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">22%</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Of total online revenue from CRM-triggered Mini Program orders.</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">-30%</p>
            <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Moments ad spend. Total sales still went up.</p>
          </div>
        </div>

        <!-- Callout -->
        <div class="bg-white border-l-[3px] border-[#CC3333] rounded-none p-[20px] mt-[32px]">
          <p class="text-[16px] font-normal text-[#1A1A1A] leading-[1.6] m-0">
            WeChat stopped being a content broadcast tool and became a relationship system. WeCom gave associates better tools without piling on busywork. The groups gave VIP customers a reason to come back between purchases.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- How to get started -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Get started">Ready to build your private domain?</SectionHeading>

      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">01</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Book a 30-minute discovery call</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Tell us about your WeChat setup, team, and customer base.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">02</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Get a private domain proposal</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">WeChat ecosystem assessment and proposed architecture with fixed pricing.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <p class="text-[12px] font-medium text-[var(--color-vermillion)] leading-none mb-[8px]">03</p>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">WeCom, CRM, and community launch</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Setup, integration, and community launch within 60 days.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="FAQ">Frequently asked questions</SectionHeading>

      <div class="max-w-[680px] flex flex-col gap-[32px] mt-[24px]">
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Do we need WeCom if we don't have stores?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">If anyone on your team communicates with customers directly then yes. Account managers, reps, service staff. If your model is pure e-commerce with no human touchpoint, you can skip WeCom and focus on Mini Program CRM and community groups. But most brands that start thinking they don't need it end up wanting it once they see it working.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How big does our audience need to be?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Around 2,000 to 3,000 engaged followers is where the economics start clicking. Below that, the effort of building automation and running groups is tough to justify. Above that, returns compound fast.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Can private domain replace advertising?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">It reduces what you spend, but won't eliminate ads entirely. Public traffic still brings new people in. Private domain is where you keep them and get them buying again. The brands doing this well run both channels and watch their ad dependency drop over time.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">What CRM tools do you use?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Tencent Qidian or Fxiaoke for WeChat-native work. For brands on Salesforce, HubSpot, or Dynamics, a connector layer keeps everything in sync. Right answer depends on what you're already running.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How is a WeChat group different from a loyalty program?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">A loyalty program tracks points. A WeChat group is a conversation. Members talk to each other, share experiences, react to content, join activations. The strongest setups combine both: CRM handles data and automation, groups handle the human part.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">What happens if a sales associate leaves?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">On personal WeChat, contacts walk out the door with the employee. On WeCom, they stay with the company. Clients get reassigned with the full conversation history. No awkward re-introductions.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">How do you measure success?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Retention rate, repurchase rate, customer lifetime value, group engagement, CRM-triggered conversion rate, private domain share of total revenue. All tracked, reported monthly.</p>
        </div>
        <div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Is this only for WeChat?</h3>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">Mostly. WeChat is the only platform with the full closed loop: Official Accounts, Mini Programs, WeCom, Groups, Channels, Pay. Some brands run lighter private domain efforts through Douyin fan groups or RedNote communities, but those tools are limited by comparison. A serious private domain strategy starts on WeChat.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="mt-[96px] max-[640px]:mt-[64px] mb-[0px]">
    <div class="w-full bg-[var(--color-rice-paper)] py-[64px] max-[640px]:py-[48px] px-[48px] max-[640px]:px-[20px]">
      <div class="max-w-[600px] mx-auto text-center">
        <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[var(--color-ink)] mb-[8px]">
          Ready to build your private domain?
        </h2>
        <p class="text-[14px] text-[var(--color-stone)] font-normal leading-[1.6] mb-[24px]">
          30-minute discovery call. Private domain proposal with fixed pricing. WeCom, CRM, and community launch within 60 days.
        </p>
        <div class="flex items-center justify-center gap-[12px] flex-wrap">
          <Button variant="primary" href="/contact">Book a call</Button>
          <Button variant="secondary" href="/pricing">See pricing</Button>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
