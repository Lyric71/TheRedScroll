const pillars = [
  {
    title: 'Klarer SOW',
    description: 'Jede Leistung ist vorab definiert. Beiträge, Videos, Kampagnen, Berichte. Sie wissen genau, was Sie jeden Monat bekommen.',
  },
  {
    title: 'Festpreis, keine Überraschungen',
    description: 'Ein Preis pro Paket. Keine Stundensätze, keine Nachforderungen, keine Rechnungen, mit denen Sie nicht gerechnet haben.',
  },
  {
    title: 'Content-Produktion mit KI',
    description: 'Visuals und Video entstehen mit HubStudio.ai, das senkt Kosten und beschleunigt die Produktion. Die Strategie bleibt vollständig in menschlicher Hand.',
  },
