    deliverables: ['Kommentar-Antworten', 'Direktnachrichten', 'Erwähnungs-Monitoring', 'Stimmungs-Alerts'],
    image: '/images/platforms/weibo-ecosystem/community.webp',
    imageAlt: 'Telefon mit einer lebhaften Weibo-Kommentarspalte unter einem Markenbeitrag, mit Antworten des verifizierten Kontos',
  },
