];

const caseStudies = [
  {
    client: 'JAC Motors',
    image: '/images/clients/JAC/JAC-Wechat-4.webp',
    imageAlt: 'Social-Media-Content von TheRedScroll für JAC Motors',
    metric: '10M',
    metricLabel: 'verkaufte Fahrzeuge, Community neu aufgebaut',
    summary: 'Ein chinesischer Autokonzern mit zehn Millionen verkauften Fahrzeugen und einer stillen Social-Media-Präsenz. Wir haben die Community auf Weibo, WeChat und RedNote mit KI-gestütztem Content neu aufgebaut.',
    href: '/de/work/jac-motors/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Kampagnenmotiv von Mission Foods für den Marktstart in China',
    metric: 'Gen Z',
    metricLabel: 'Kampagnen für eine neue Produktkategorie',
    summary: 'Corn Chips, eine in China unbekannte Kategorie, zum Marktstart bringen. Gen-Z-Kampagnen und Food-Pairing-Content auf Weibo, WeChat und RedNote.',
    href: '/de/work/mission-foods/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Kampagnenmotiv von Camper für chinesische soziale Netzwerke',
    metric: '187K',
    metricLabel: 'Follower, von 43.000 in 18 Monaten',
    summary: 'Eine europäische Schuhmarke, die in 18 Monaten von 43.000 auf 187.000 Follower wuchs, mit Engagement von 1,2 auf 4,7 Prozent und einem flächenbereinigten Umsatzplus von 31 Prozent.',
    href: '/de/work/camper/',
  },
];

const faqs = [
  {
    q: 'Was kostet eine Weibo-Agentur?',
    a: 'Zwei Budgets zählen. Die Agenturleistung: ein fester Monatspreis gegen einen klaren Leistungsumfang, jede Leistung und die Gesamtkosten stehen vor der Unterschrift fest. Im April 2026 haben wir 37 China-Marketing-Agenturen analysiert, 0 von 37 bieten Festpreispakete. Wir schon. Das Mediabudget: geht separat an Weibo und wird zum echten Preis abgerechnet, ohne Marge. Fan Headlines sind der günstige Einstieg, Hot-Search-Platzierungen liegen am oberen Ende.',
  },
  {
    q: 'Kann ein ausländisches Unternehmen ein Weibo-Konto eröffnen?',
    a: 'Ja, und wir tun das regelmäßig. Ausländische Unternehmen erhalten ein verifiziertes Unternehmenskonto mit Blue-V-Abzeichen. Nötig sind ins Chinesische übersetzte Registrierungsunterlagen und eine einmalige Verifizierungsgebühr von 1.000 US-Dollar an Weibo. Wir bereiten die Unterlagen vor, übernehmen die Übersetzung und klären alles mit dem Verifizierungsteam von Weibo, damit Sie sich darum nicht kümmern müssen.',
  },
  {
    q: 'Wie lange dauert die Weibo-Verifizierung?',
    a: 'Mit vollständigen Unterlagen etwa zwei bis vier Wochen. Fehlende oder widersprüchliche Papiere sind der häufigste Grund für Verzögerungen, deshalb prüfen wir alles vor der Einreichung. Untätig warten wir auch nicht. Profilaufbau und Content-Produktion starten, während das Blue-V-Abzeichen in Bearbeitung ist.',
  },
  {
    q: 'Brauche ich eine chinesische Geschäftslizenz für Weibo?',
    a: 'Nein. Eine ausländische Handelsregistrierung genügt für ein verifiziertes Unternehmenskonto. Sie brauchen weder eine chinesische Gesellschaft noch ein chinesisches Bankkonto noch eine ICP-Lizenz, um ein Weibo-Konto zu führen. Eine chinesische Gesellschaft wird erst später relevant, etwa für heimische eCommerce-Anbindungen. Unser Markteintritts-Service für China deckt diesen Weg ab, sobald Sie so weit sind.',
  },
  {
    q: 'Weibo oder WeChat: Womit sollten wir beginnen?',
    a: 'Das hängt vom Ziel ab. Weibo ist Chinas offener Marktplatz der Meinungen: 567 Millionen Nutzer pro Monat, Trendthemen und Beiträge, die jeder sehen kann. Bekanntheit wächst dort schnell. WeChat ist geschlossen: Inhalte zirkulieren in privaten Kreisen, das macht es stärker für Bindung und CRM. Marken auf dem Weg nach China beginnen meist mit Weibo für Reichweite und nehmen WeChat hinzu, sobald ein Publikum da ist, das es zu halten gilt. Die meisten unserer Kunden betreiben beides.',
  },
  {
    q: 'Wie messen Sie den Erfolg von Weibo-Kampagnen?',
    a: 'An den Zielen aus Ihrem Leistungsumfang. Die Monatsberichte umfassen Follower-Wachstum, Engagement-Raten, Content-Performance nach Format, Werbeergebnisse (CPM, CPC, CPA, ROAS), KOL-Erträge und Wettbewerbsvergleiche. Jeder Bericht endet mit konkreten Empfehlungen für den Folgemonat. Bei laufenden Kampagnen kommt ein Zwischenstand zur Monatsmitte hinzu.',
  },
];
---

<PageLayout
  title="Weibo-Agentur für Marken auf dem Weg nach China | TheRedScroll"
  description="Full-Service-Weibo-Agentur in Shanghai und Hongkong. Blue-V-Einrichtung, Content, Werbung und KOL-Kampagnen. Klarer Leistungsumfang, Festpreis."
  lang="de"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      微博
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">博</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Weibo-Agentur</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            Die Weibo-Agentur für Marken auf dem Weg nach China
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Konteneinrichtung, Blue-V-Verifizierung, Content, Werbung und KOL-Kampagnen. Gesteuert aus Shanghai und Hongkong, jeden Tag. Klarer Leistungsumfang. Festpreis.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
            <Button variant="secondary-dark" href="#results">Ergebnisse ansehen</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Ein Gespräch von 30 Minuten. Ohne Verkaufsfolien.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/weibo-agency/hero-phones-blend.webp"
            alt="Zwei Telefone mit der echten Weibo-App: der öffentliche Feed und die Hot-Search-Trendliste"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Warum Weibo zählt
          </p>
          <p class="manifesto" data-manifesto>
            Weibo ist Chinas öffentlicher Marktplatz. 567 Millionen Menschen verfolgen dort jeden Monat, was Thema wird. Reputationen entstehen in Stunden. Fehlt Ihre Marke im Gespräch, dann <span class="manifesto-hl">führt es</span> ein anderer für Sie.
          </p>
        </div>
        <div>
          <img
            src="/images/weibo-agency/ecosystem-banner-tight.webp"
            alt="Drei Telefone mit den drei Seiten von Weibo: der öffentliche Feed, die Hot-Search-Liste und ein verifiziertes Markenprofil"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Eine App, drei Aufgaben: öffentlicher Feed, Trendthemen und Markenreputation.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Eine Agentur für das gesamte Weibo-Repertoire
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Weibo zählt 567 Millionen monatlich aktive und 252 Millionen täglich aktive Nutzer (Mai 2026). Hier beginnen Trends, hier tauchen Nachrichten zuerst auf, hier recherchieren chinesische Konsumenten Marken vor dem Kauf.
            </p>
            <p>
              Eine Weibo-Agentur registriert und verifiziert Ihr Unternehmenskonto, schreibt Ihre Inhalte auf Chinesisch, kauft Ihre Anzeigen und steuert Ihre KOL-Kampagnen. Wer das selbst stemmen will, muss Muttersprachler einstellen, den Rhythmus der Hot Search lernen und sich durch die Verifizierung arbeiten. Die meisten Marken kommen mit einem Spezialisten schneller weiter.
            </p>
            <p>
              Dieser Spezialist sind wir. Wir veröffentlichen jeden Tag auf <a href="/de/platforms/weibo/" class="text-[#CC3333] hover:underline">Weibo</a>, aus China heraus.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Leistungsumfang im Überblick
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
