---

<BaseLayout
  title="Festpreis-Pakete für China-Social-Media | TheRedScroll"
  description="Klare Pakete und feste Preise für Social-Media-Marketing in China: WeChat, Douyin, RedNote, Weibo. Ab 3.750 € pro Monat."
  lang="de"
>
  <main class="pt-[60px] max-[640px]:pt-[52px]">

    <!-- Hero -->
    <section class="relative w-full bg-[#1A1A1A] rounded-none overflow-hidden py-[80px] max-[1024px]:py-[64px] max-[640px]:py-[48px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/pricing-bg.webp')" aria-hidden="true"></div>
      <div class="relative z-[1] max-w-[800px] mx-auto text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">Preise</p>
        <h1 class="text-[#FFFFFF] text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] mb-[8px]">
          Klarer Leistungsumfang. Fester Preis. Keine Nachforderungen.
        </h1>
        <p class="text-[rgba(255,255,255,0.6)] text-[16px] font-normal leading-[1.6]">
          Preise in Euro netto. Sechs Monate Mindestlaufzeit für alle Pakete.
        </p>
      </div>
    </section>

    <!-- Core Packages Comparison Table -->
    <section class="mt-[96px] max-[640px]:mt-[64px]">
      <Container>
        <div class="text-center mb-[48px]">
          <div class="flex justify-center mb-[12px]"><SectionBar /></div>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A]">Unsere Pakete</h2>
        </div>

        <!-- Desktop comparison table -->
        <div class="max-[1024px]:hidden overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="w-[280px] p-[16px] align-bottom"></th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tl-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Start</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">3.750 €<span class="text-[14px] text-[#5C5C5C] font-normal">/Monat</span></p>
                  <Button variant="secondary" href="/de/contact/" class="mt-[16px] w-full justify-center text-[13px]">Starten</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] relative border-x-[3px] border-[#CC3333]">
                  <div class="absolute top-0 left-[-3px] right-[-3px] h-[3px] bg-[#CC3333]"></div>
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">Grow</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">5.500 €<span class="text-[14px] text-[#5C5C5C] font-normal">/Monat</span></p>
                  <Button variant="primary" href="/de/contact/" class="mt-[16px] w-full justify-center text-[13px]">Starten</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tr-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Lead</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">6.750 €<span class="text-[14px] text-[#5C5C5C] font-normal">/Monat</span></p>
                  <Button variant="secondary" href="/de/contact/" class="mt-[16px] w-full justify-center text-[13px]">Starten</Button>
                </th>
              </tr>
            </thead>
            <tbody>
              <!-- Section: Strategy & Setup -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Strategie und Aufbau</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Wettbewerbsanalyse</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Monat 1</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">Monat 1</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Monat 1</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Redaktionsstrategie und Content-Themen</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Monatlicher Redaktionsplan</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Kontoeröffnung und Einrichtung</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Nach Bedarf</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">Nach Bedarf</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Nach Bedarf</td>
              </tr>

              <!-- Section: Content -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Content</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">WeChat</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 Artikel/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1 Artikel/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 Artikel/Wo.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Weibo</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 Beitrag/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3 Beiträge/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">7 Beiträge/Wo.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">RedNote (Xiaohongshu)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 Beitrag/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3 Beiträge/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">5 Beiträge/Wo.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin (Kunden-Video)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 Video/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1 Video/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2 Videos/Wo.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin (KI-Video, max. 15 Sek.)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="Nicht enthalten">Nein</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">1 Video/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2 Videos/Wo.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)] bg-[#F0F1F4]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium">Douyin gesamt</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center">1/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">2/Wo.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">4/Wo.</td>
              </tr>

              <!-- Section: AI Production -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">KI-Produktion</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">KI-generiertes Video über HubStudio.ai</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="Nicht enthalten">Nein</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Briefing-Freigabe vor der Produktion</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="Nicht enthalten">Nein</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Social Listening -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Social Listening</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Monitoring Markennennungen</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="Nicht enthalten">Nein</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]"><span aria-label="Nicht enthalten">Nein</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Wettbewerbsmonitoring</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="Nicht enthalten">Nein</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]"><span aria-label="Nicht enthalten">Nein</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Monatlicher Markenbericht</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="Nicht enthalten">Nein</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]"><span aria-label="Nicht enthalten">Nein</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <!-- Section: Support & Reporting -->
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Betreuung und Reporting</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Fester Ansprechpartner</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Chat-Support (Mo. bis Fr.)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Monatlicher Performance-Report</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Strategie-Termine</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1x pro Monat</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">Wöchentlich</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">Auf Anfrage</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Mobile: stacked cards with full features (shown only on mobile) -->
        <div class="hidden max-[1024px]:flex flex-col gap-[16px]">
          {packages.map((pkg) => {
            const dark = pkg.highlighted;
            const textPrimary = dark ? 'text-[#FFFFFF]' : 'text-[#1A1A1A]';
            const textSecondary = dark ? 'text-[rgba(255,255,255,0.6)]' : 'text-[#5C5C5C]';
            const borderColor = dark ? 'border-[rgba(255,255,255,0.1)]' : 'border-[rgba(0,0,0,0.06)]';

            const features = [
              { section: 'Strategie und Aufbau', items: [
                { label: 'Wettbewerbsanalyse', value: pkg.strategy.competitor },
                { label: 'Redaktionsstrategie und Content-Themen', value: pkg.strategy.contentStrategy },
                { label: 'Monatlicher Redaktionsplan', value: pkg.strategy.editorialCalendar },
                { label: 'Kontoeröffnung und Einrichtung', value: pkg.strategy.accountOpening },
              ]},
              { section: 'Content', items: [
                { label: 'WeChat', value: pkg.content.wechat },
                { label: 'Weibo', value: pkg.content.weibo },
                { label: 'RedNote (Xiaohongshu)', value: pkg.content.rednote },
                { label: 'Douyin (Kunden-Video)', value: pkg.content.douyinClient },
                { label: 'Douyin (KI-Video)', value: pkg.content.douyinAi },
                { label: 'Douyin gesamt', value: pkg.content.douyinTotal },
              ]},
              { section: 'KI-Produktion', items: [
                { label: 'KI-generiertes Video über HubStudio.ai', value: pkg.ai },
                { label: 'Briefing-Freigabe vor der Produktion', value: pkg.ai },
              ]},
              { section: 'Social Listening', items: [
                { label: 'Monitoring Markennennungen', value: pkg.socialListening },
                { label: 'Wettbewerbsmonitoring', value: pkg.socialListening },
                { label: 'Monatlicher Markenbericht', value: pkg.socialListening },
              ]},
              { section: 'Betreuung und Reporting', items: [
                { label: 'Fester Ansprechpartner', value: pkg.support.accountManager },
                { label: 'Chat-Support (Mo. bis Fr.)', value: pkg.support.chatSupport },
                { label: 'Monatlicher Performance-Report', value: pkg.support.monthlyReport },
                { label: 'Strategie-Termine', value: pkg.support.strategyCalls },
              ]},
            ];

            return (
              <div class:list={[
                'rounded-[12px] p-[24px]',
                dark ? 'bg-[#1A1A1A]' : 'bg-[#F0F1F4]'
              ]}>
                <p class:list={['text-[11px] font-medium uppercase tracking-[0.05em] mb-[4px]', dark ? 'text-[#FFFFFF]' : 'text-[#CC3333]']}>
                  {pkg.name}
                </p>
                <p class:list={['text-[28px] font-medium leading-[1.2] mb-[4px]', textPrimary]}>
                  {pkg.price}<span class:list={['text-[14px] font-normal', textSecondary]}>/Monat</span>
                </p>
                <p class:list={['text-[13px] font-normal leading-[1.5] mb-[20px]', textSecondary]}>
                  {pkg.description}
                </p>

                <Button variant={dark ? 'primary' : 'secondary'} href="/de/contact/" class="w-full justify-center">Starten</Button>

                <div class="mt-[24px] flex flex-col gap-[20px]">
                  {features.map((group) => (
                    <div>
                      <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[8px]">{group.section}</p>
                      <div class="flex flex-col">
                        {group.items.map((item) => (
                          <div class:list={['flex justify-between items-center py-[8px] border-b', borderColor]}>
                            <span class:list={['text-[13px] font-normal', textPrimary]}>{item.label}</span>
                            <span class:list={['text-[13px] font-medium shrink-0 ml-[12px]',
                              item.value === true ? 'text-[#CC3333]' :
                              item.value === false ? textSecondary :
                              textPrimary
                            ]}>
                              {item.value === true ? '✓' : item.value === false ? 'Nein' : item.value}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Content specs -->
        <div class="mt-[48px] max-w-[680px]">
          <h3 class="text-[18px] text-[#1A1A1A] font-medium leading-[1.3] mb-[16px]">Format-Details</h3>
          <div class="text-[14px] text-[#5C5C5C] font-normal leading-[1.8]">
