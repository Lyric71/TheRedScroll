---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="Über uns | TheRedScroll"
  description="TheRedScroll ist eine Social-Media-Agentur mit Sitz in China. Klarer Leistungsumfang, Festpreis, Team vor Ort. Zwischen Shanghai und Hongkong, Tag für Tag."
  lang="de"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[500px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/team/team-photo.webp')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.82]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Über uns
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Die Menschen, die Ihre Marke in China tragen.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Fünfundzwanzig Jahre Markterfahrung. Ein eingespieltes Team. Keine Subunternehmer.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
        <Button variant="secondary-dark" href="#leadership">Das Team kennenlernen</Button>
      </div>
    </div>
  </section>

  <!-- Why we exist -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <div>
          <SectionBar />
          <SectionHeading overline="Warum es uns gibt">Die meisten Agenturen verkaufen Strategie. Die Umsetzung landet dann bei Teams, die Douyin noch nie geöffnet haben.</SectionHeading>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Eine glanzvolle Präsentation, ein paar Sätze, die gut klingen. Dahinter ein Junior-Team, das die Codes von RedNote nicht kennt und denselben Inhalt auf jede Plattform kippt. Sechs Monate später kann niemand mehr sagen, wo das Budget hingewandert ist.
          </p>
        </div>
        <div class="flex flex-col items-end pt-[48px] max-[640px]:pt-[0px]">
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] mb-[32px] w-full">
            <p>
              TheRedScroll haben wir gegründet, um mit diesem Muster zu brechen. Bei uns veröffentlichen jene, die die Strategie entwickeln, auch die Inhalte. Der Preis steht fest, die Ergebnisse sind messbar.
            </p>
            <p>
              Konkrete Arbeit, sichtbar auf den Plattformen, jeden Tag, aus China heraus.
            </p>
          </div>
          <div class="flex items-center gap-[16px]">
            <img
              src="/images/team/Cyril-Drouin-Signature-Transparent.webp"
              alt="Unterschrift von Cyril Drouin"
              width="100"
              height="60"
              class="shrink-0"
              style="width: 100px; height: auto; filter: brightness(0) saturate(100%) invert(23%) sepia(95%) saturate(2068%) hue-rotate(346deg) brightness(89%) contrast(89%);"
              loading="lazy"
              decoding="async"
            />
            <div>
              <p class="text-[14px] font-medium text-[var(--color-ink)] leading-[1.4]">Cyril Drouin</p>
              <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Gründer und CEO, TheRedScroll</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our mission -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="Telefon-Bildschirme mit Wachstum in chinesischen sozialen Netzwerken">
          <svg viewBox="0 0 480 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <g transform="translate(20, 40)">
              <rect x="0" y="0" width="130" height="240" rx="16" fill="#1A1A1A" />
              <rect x="4" y="4" width="122" height="232" rx="14" fill="#FFFFFF" />
              <rect x="4" y="4" width="122" height="28" rx="14" fill="#1A1A1A" />
              <circle cx="65" cy="18" r="4" fill="#333" />
              <text x="65" y="50" text-anchor="middle" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif">Douyin</text>
              <rect x="14" y="60" width="102" height="70" rx="6" fill="#F7F2EE" />
              <text x="14" y="150" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Follower</text>
              <text x="14" y="163" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">127,4K</text>
              <polyline points="14,210 34,200 54,195 74,185 94,175 116,160" stroke="#CC3333" stroke-width="2" fill="none" stroke-linecap="round" />
              <circle cx="116" cy="160" r="3" fill="#CC3333" />
              <text x="80" y="224" fill="#CC3333" font-size="8" font-weight="500" font-family="Inter, sans-serif">+34%</text>
            </g>

            <g transform="translate(175, 10)">
              <rect x="0" y="0" width="130" height="260" rx="16" fill="#1A1A1A" />
              <rect x="4" y="4" width="122" height="252" rx="14" fill="#FFFFFF" />
              <rect x="4" y="4" width="122" height="28" rx="14" fill="#07C160" />
              <text x="65" y="22" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">WeChat</text>
              <rect x="14" y="42" width="102" height="50" rx="6" fill="#F7F2EE" />
              <rect x="14" y="100" width="102" height="50" rx="6" fill="#F7F2EE" />
              <text x="14" y="172" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Artikelaufrufe</text>
              <text x="14" y="185" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">89,2K</text>
              <text x="14" y="205" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Engagement</text>
              <text x="14" y="218" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">12,8%</text>
              <polyline points="14,248 34,244 54,238 74,230 94,220 116,208" stroke="#07C160" stroke-width="2" fill="none" stroke-linecap="round" />
              <circle cx="116" cy="208" r="3" fill="#07C160" />
            </g>

            <g transform="translate(330, 50)">
              <rect x="0" y="0" width="130" height="240" rx="16" fill="#1A1A1A" />
              <rect x="4" y="4" width="122" height="232" rx="14" fill="#FFFFFF" />
              <rect x="4" y="4" width="122" height="28" rx="14" fill="#FF2442" />
              <text x="65" y="22" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">RedNote</text>
              <rect x="14" y="40" width="48" height="48" rx="4" fill="#F7F2EE" />
              <rect x="68" y="40" width="48" height="48" rx="4" fill="#F7F2EE" />
              <rect x="14" y="94" width="48" height="48" rx="4" fill="#F7F2EE" />
              <rect x="68" y="94" width="48" height="48" rx="4" fill="#F7F2EE" />
              <text x="14" y="162" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Follower</text>
              <text x="14" y="175" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">56,1K</text>
              <polyline points="14,220 34,215 54,208 74,198 94,188 116,172" stroke="#FF2442" stroke-width="2" fill="none" stroke-linecap="round" />
              <circle cx="116" cy="172" r="3" fill="#FF2442" />
              <text x="80" y="230" fill="#FF2442" font-size="8" font-weight="500" font-family="Inter, sans-serif">+52%</text>
            </g>

            <g class="mission-badge mission-badge-1">
              <rect x="145" y="290" width="90" height="28" rx="6" fill="#1A1A1A" />
              <text x="190" y="308" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">+2,4K heute</text>
            </g>
            <g class="mission-badge mission-badge-2">
              <rect x="260" y="300" width="100" height="28" rx="6" fill="#CC3333" />
              <text x="310" y="318" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">Abschlüsse +41%</text>
            </g>
            <g class="mission-badge mission-badge-3">
              <rect x="50" y="310" width="84" height="28" rx="6" fill="#07C160" />
              <text x="92" y="328" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">89,2K Aufrufe</text>
            </g>
          </svg>
        </div>
        <div>
          <SectionBar />
          <SectionHeading overline="Unsere Mission">Marken in Chinas sozialen Netzwerken zum Wachsen bringen.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Greifbare Ergebnisse statt der nächsten schönen Folie: Follower, Interaktion, Abschlüsse.
            </p>
            <p>
              Chinas Plattformen sind übersättigt und teuer. Einheimische Marken beherrschen die Codes bis in jede Nuance. Diesen Vorsprung aus dem Ausland aufzuholen, ist die eigentliche Aufgabe. Wir nehmen sie an: mit klar definiertem Leistungsumfang, Festpreis und einem Team, das jeden Tag auf diesen Plattformen lebt.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our vision -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Unsere Vision">Ein guter Social-Media-Verantwortlicher, gestützt auf KI, schlägt das alte Agenturmodell.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Das klassische Modell stapelt Rollen aufeinander: Strategen, Texter, Grafiker, Projektleiter. Jede Stunde wird verrechnet. Gut die Hälfte hat noch nie etwas auf Douyin veröffentlicht.
            </p>
            <p>
              Wir stützen uns auf HubStudio.ai für Content-Produktion, Bildwelten und erste Textfassungen. Was früher eine Woche dauerte, ist an einem Tag erledigt. Strategie und kulturelle Lesart bleiben aber vollständig in der Hand unseres Teams. Daran wird auch die nächste Werkzeug-Generation nichts ändern.
            </p>
          </div>
          <div class="bg-[#F0F1F4] border-l-[3px] border-[#CC3333] rounded-none p-[20px] mt-[24px]">
            <p class="text-[16px] font-normal text-[#1A1A1A] leading-[1.6] m-0">
              2025 hat der chinesische AIGC-Markt die Marke von 25,7 Milliarden Yuan überschritten, bei einem jährlichen Wachstum von 60 Prozent. Mehr als jeder zweite chinesische Werbetreibende setzt heute KI in der kreativen Produktion ein. Quelle: Marktdaten 2025.
            </p>
          </div>
        </div>
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="Vergleich der Durchlaufzeit: altes Agenturmodell gegen TheRedScroll mit KI">
          <svg viewBox="0 0 440 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">DURCHLAUFZEIT</text>

            <text x="20" y="62" fill="#5C5C5C" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">ALTES AGENTURMODELL</text>

            <rect x="20" y="74" width="400" height="36" rx="6" fill="#E8E0D8" />

            <line x1="100" y1="74" x2="100" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />
            <line x1="180" y1="74" x2="180" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />
            <line x1="260" y1="74" x2="260" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />
            <line x1="340" y1="74" x2="340" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />

            <text x="60" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Wo. 1</text>
            <text x="140" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Wo. 2</text>
            <text x="220" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Wo. 3</text>
            <text x="300" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Wo. 4</text>
            <text x="380" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Wo. 5</text>

            <g transform="translate(20, 122)">
              <rect x="0" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="38" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Planner</text>

              <rect x="82" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="120" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Texter</text>

              <rect x="164" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="202" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Designer</text>

              <rect x="246" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="284" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Projektleiter</text>

              <rect x="328" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="366" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Account-Lead</text>
            </g>

            <line x1="20" y1="168" x2="420" y2="168" stroke="#E8E0D8" stroke-width="0.5" />

            <text x="20" y="198" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">THEREDSCROLL + KI</text>

            <rect x="20" y="210" width="80" height="36" rx="6" fill="#CC3333" class="vision-bar" />
            <rect x="100" y="210" width="320" height="36" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" stroke-dasharray="4 4" />

            <text x="60" y="232" text-anchor="middle" fill="#FFFFFF" font-size="9" font-weight="500" font-family="Inter, sans-serif">1 Tag</text>

            <text x="260" y="232" text-anchor="middle" fill="#E8E0D8" font-size="9" font-family="Inter, sans-serif">Gewonnene Zeit</text>

            <g transform="translate(20, 258)">
              <rect x="0" y="0" width="110" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
              <text x="55" y="14" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">Stratege vor Ort</text>

              <rect x="118" y="0" width="80" height="22" rx="4" fill="#1A1A1A" opacity="0.05" stroke="#1A1A1A" stroke-width="0.5" />
              <text x="158" y="14" text-anchor="middle" fill="#1A1A1A" font-size="7" font-weight="500" font-family="Inter, sans-serif">HubStudio.ai</text>
            </g>

            <line x1="20" y1="304" x2="420" y2="304" stroke="#E8E0D8" stroke-width="0.5" />

            <g transform="translate(20, 320)">
              <text x="0" y="12" fill="#1A1A1A" font-size="20" font-weight="500" font-family="Inter, sans-serif">5x</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">schneller</text>
            </g>
            <g transform="translate(140, 320)">
              <text x="0" y="12" fill="#1A1A1A" font-size="20" font-weight="500" font-family="Inter, sans-serif">80%</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">weniger abrechenbare Rollen</text>
            </g>
            <g transform="translate(290, 320)">
              <text x="0" y="12" fill="#CC3333" font-size="20" font-weight="500" font-family="Inter, sans-serif">100%</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Strategie menschlich getragen</text>
            </g>
          </svg>
        </div>
      </div>
    </Container>
  </section>

  <!-- Leadership -->
  <section id="leadership" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Leitung">Die Gesichter hinter TheRedScroll.</SectionHeading>
      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="leader-card bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/team/Cyil-Drouin.jpg" alt="Cyril Drouin" class="w-full aspect-[3/4] object-cover object-top" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">Cyril Drouin</h3>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5] mb-[12px]">Gründer und CEO</p>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5]">
              Fünfundzwanzig Jahre in Digital, Werbung und Handel. Zuvor CEO von Publicis Commerce and Performance Marketing für China und Nordasien.
            </p>
          </div>
        </div>
        <div class="leader-card bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/team/Echo-peng.jpg" alt="Echo Peng" class="w-full aspect-[3/4] object-cover object-top" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">Echo Peng</h3>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5] mb-[12px]">Senior-Direktorin</p>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5]">
              Achtzehn Jahre im Online-Handel und Digitalgeschäft in China. Zuvor Operations Director bei Publicis China.
            </p>
          </div>
        </div>
        <div class="leader-card bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/team/Liyan-Ye.jpg" alt="Liyan Ye" class="w-full aspect-[3/4] object-cover object-top" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">Liyan Ye</h3>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5] mb-[12px]">Senior-Direktorin</p>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5]">
              Zwanzig Jahre Marketing-Erfahrung bei Fortune-500-Unternehmen in China.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our team -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Unser Team">Ehemalige Führungskräfte internationaler Agenturen, Plattform-Strategen, die täglich veröffentlichen.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Strategen, die jeden Tag auf WeChat, Douyin, RedNote und Weibo posten. Content-Verantwortliche, die die Redaktionspläne Dutzender Marken in China gesteuert haben. Die meisten machen das seit mehr als zehn Jahren.
            </p>
            <p>
              Wer den Redaktionsplan entwirft, sorgt auch dafür, dass die Inhalte erscheinen und Wirkung zeigen. Keine Lücke zwischen Papier und Plattform.
            </p>
            <p>
              Wir haben Beauty-Marken auf RedNote gestartet, Food-Communities auf WeChat aufgebaut und Auto-Communities auf Douyin Struktur gegeben.
            </p>
          </div>
        </div>
        <img
          src="/images/team/china-office.webp"
          alt="TheRedScroll-Büro in China"
          class="w-full rounded-[8px] object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </Container>
  </section>

  <!-- Clients who trust our expertise -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#F0F1F4] rounded-[10px] p-[48px] max-[1024px]:p-[32px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[24px] text-center">Sie vertrauen uns</p>
