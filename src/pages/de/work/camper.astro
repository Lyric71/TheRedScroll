---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Kampagne', 'Content-Produktion', 'Influencer / KOL', 'Social'];
const platforms = ['WeChat', 'RedNote', 'Weibo'];

const stats = [
  { value: '43K → 187K', label: 'Follower in 18 Monaten' },
  { value: '4,7 %', label: 'Engagement-Rate (vorher 1,2 %)' },
  { value: '38 %', label: 'eCommerce-Traffic über RedNote' },
  { value: '+31 %', label: 'Ladenumsatz im Jahresvergleich' },
];
---

<PageLayout
  title="Camper: Social-Media-Case-Study China | TheRedScroll"
  description="Wie Camper auf WeChat, RedNote und Weibo von 43.000 auf 187.000 Follower wuchs. Eine Strategie für soziale Netzwerke, die den Ladenumsatz in Chinas Großstädten um 31 Prozent steigerte."
  ogImage="/images/clients/Camper/Camper-Case-Study-Hero.jpg"
  lang="de"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/clients/Camper/Camper-Case-Study-Hero.jpg')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Fallstudie
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Camper: eine Designmarke in Chinas sozialen Netzwerken verankern.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Camper wollte in Chinas sozialen Netzwerken wachsen, ohne ein Stück seiner Designhandschrift preiszugeben. Wir vervierfachten die Community und steigerten den Ladenumsatz in achtzehn Monaten um 31 Prozent.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
        <Button variant="secondary-dark" href="#case-study">Fallstudie lesen</Button>
      </div>
    </div>
  </section>

  <!-- Meta bar -->
  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Kunde</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Camper</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Branche</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Mode / Schuhe</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Leistungen</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Plattformen</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Kunde">Schuhe aus Mallorca seit 1975. In China liefen die Kanäle ins Leere.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Camper fertigt seit 1975 auf Mallorca Schuhe. Eigenständiges Design, mediterranes Handwerk, Tragekomfort vor Mode.
            </p>
            <p>
              In China kamen WeChat, Weibo und RedNote zusammen auf 43.000 Follower und 1,2 Prozent Engagement. Filialen in den großen Städten, doch die Auftritte in den Netzwerken lockten niemanden hinein. Camper wollte wachsen, ohne das Wesentliche preiszugeben: Die Designhandschrift sollte jeden Beitrag tragen, ohne aufdringliche Werbung, ohne beliebige Lifestyle-Beiträge.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Social screenshots -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img src="/images/clients/Camper/2e9bc97593dbe520397f52be0fb8e584.jpg" alt="Camper-RedNote-Account mit 19,3K Followern" class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
      <img src="/images/clients/Camper/3721890f3b2783008e73034b5b06b315.jpg" alt="Camper-WeChat-Account mit Artikeln und Content" class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
      <img src="/images/clients/Camper/4bccf3f158a489f020e0a273f13c19ab.jpg" alt="WeChat-Artikel zur Kollaboration Camper x Issey Miyake" class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
      <img src="/images/clients/Camper/b2a4eecb0f6665ce6c27c35983d5e7fb.jpg" alt="Camper-Pix-London-Kampagne auf RedNote mit KOL-Content" class="w-[240px] max-[640px]:w-[200px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Campers Auftritte auf RedNote und WeChat: KOL-Kooperationen, Markenerzählung und Allianzen mit Designern.
      </p>
    </Container>
  </section>

  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Was wir gemacht haben">Inhalte über das, was Camper überhaupt folgenswert macht.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Campers Publikum in China: design-affine Berufstätige zwischen 28 und 45. Menschen, die vor plumpen Verkaufsbotschaften zurückschrecken. Also bauten wir die Inhalte um das, was Camper folgenswert macht: Designgeschichten, Kooperationen mit Künstlern, Bilder davon, wie diese Schuhe in Chinas Städten tatsächlich getragen werden.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">RedNote: unser Hauptspielfeld</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Wir arbeiteten mit Mikro-Influencern aus Architektur, Innenarchitektur und kreativen Berufen. Die Beiträge gingen jedem Modell auf den Grund: Material, Konstruktion, gestalterische Absicht. Ein engeres Publikum als bei einer klassischen Mode-Kampagne, dafür mit deutlich höherem Engagement.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">WeChat: die langen Erzählungen</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Kurze Dokumentationen aus den Werkstätten auf Mallorca. Einblicke in Entwurf und Fertigung. Stoff, der ein dauerhaftes Abonnement rechtfertigt.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Weibo: der Ort der Konversation</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Eine Debatte über die alte Streitfrage (Schuhe für den Komfort oder fürs Auge) hielt drei Tage an und brachte Tausende Kommentare.
            </p>
          </div>
        </div>

        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Unser Team steuerte alles aus China. Muttersprachler, plattformgerechte Inhalte, Woche für Woche die Entscheidung, was wirklich Ergebnisse bringt.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- Stats -->
  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {stats.map((stat) => (
          <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">{stat.value}</p>
            <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Ergebnisse">Erst ein stetiger Aufbau, dann die Beschleunigung.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              In achtzehn Monaten wuchs die Followerschaft von 43.000 auf 187.000. Das Engagement kletterte von 1,2 auf 4,7 Prozent, weit über dem Branchenschnitt für Schuhe.
            </p>
            <p>
              Die eigentliche Überraschung ist RedNote. Mit der kleinsten Followerschaft bringt die Plattform 38 Prozent des gesamten eCommerce-Traffics. Engeres Publikum, stärkere Kaufabsicht.
            </p>
            <p>
              Der Effekt reichte bis in die Läden. Der flächenbereinigte Umsatz stieg im Jahresvergleich um 31 Prozent. Die Kundenbindung legte 22 Prozent zu. Die Kauffrequenz stieg von 1,3 auf 2,1 pro Kunde und Jahr.
            </p>
          </div>
        </div>

        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Drei RedNote-Creator posteten auch nach dem Ende der bezahlten Kampagnen weiter über Camper. Ohne Vertrag, ohne Briefing. Die Schuhe gefielen ihnen einfach. So ein Nachhall lässt sich nicht bestellen.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="Sie sind dran">Sie möchten eine Premium-Marke in Chinas sozialen Netzwerken wachsen lassen?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Klarer Leistungsumfang. Fester Preis. Team vor Ort.
        </p>
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
