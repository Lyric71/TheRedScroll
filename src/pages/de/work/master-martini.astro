---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Kampagne', 'Design', 'Influencer / KOL', 'Medien', 'Social'];
const platforms = ['Instagram', 'Facebook'];
---

<PageLayout
  title="Master Martini Social Media in Asien | TheRedScroll"
  description="Wie Master Martini auf Instagram und Facebook über fünf asiatische Märkte eine Community aus Profiköchen aufbaute. Rezepte, Live-Vorführungen und nutzergenerierte Inhalte."
  ogImage="/images/clients/MasterMartini/mastermartini-og.jpg"
  lang="de"
>

  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll" style="background-image: url('/images/clients/MasterMartini/MasterMartini1.webp')" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">Fallstudie</p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Master Martini: über die sozialen Netzwerke eine asienweite Community aus Profiköchen bilden.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Master Martini musste Profiköche auf fünf asiatischen Märkten erreichen. Wir machten aus seinen Konten in den sozialen Netzwerken eine Community, die den Absatz beschleunigte.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
        <Button variant="secondary-dark" href="#case-study">Fallstudie lesen</Button>
      </div>
    </div>
  </section>

  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Kunde</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Master Martini</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Branche</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Food / B2B-Zutaten</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Leistungen</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (<span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Plattformen</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (<span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Märkte</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Malaysia, Hongkong, Singapur, Indonesien, Thailand</p>
        </div>
      </div>
    </Container>
  </section>

  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Kunde">Zutaten für professionelle Konditoren. Fünf Märkte. Eine ganz eigene Aufgabe in den sozialen Netzwerken.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Master Martini beliefert seit 1982 professionelle Bäcker und Konditoren. Zutaten, Halbfertigprodukte, Fertigprodukte. Eine feste Größe in Profiküchen, niemals im Supermarkt.
            </p>
            <p>
              Die Marke hatte bereits Konten auf fünf Märkten: Malaysia, Hongkong, Singapur, Indonesien und Thailand. In den sozialen Netzwerken ein Publikum für B2B-Konditoreizutaten aufzubauen, ist eine Kunst für sich. Profiköche verbringen ihre Tage nicht damit, in den sozialen Netzwerken nach Zutatenmarken zu suchen. Und wenn sie einer folgen, erwarten sie Substanz, erprobte Technik, niemals hübsch verpackte Werbung.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img src="/images/clients/MasterMartini/MasterMartini1.webp" alt="Master-Martini-Konditor-Inhalte auf Instagram" class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
      <img src="/images/clients/MasterMartini/masterMartini2.jpg" alt="Master-Martini-Rezepte und Koch-Vorführungen auf asiatischen Märkten" class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
      <img src="/images/clients/MasterMartini/Mastermartini3.webp" alt="Master-Martini-Kampagne mit nutzergenerierten Inhalten und Profiköchen" class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Master-Martini-Inhalte auf fünf asiatischen Märkten. Rezeptfotos, Vorführungen der Köche und Kampagnen mit nutzergenerierten Inhalten.
      </p>
    </Container>
  </section>

  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Was wir gemacht haben">Inhalte, denen Köche tatsächlich folgen wollten.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Wir steuerten die Instagram- und Facebook-Konten von Master Martini auf den fünf Märkten. Der Ansatz verband Rezepte, Live-Vorführungen, Workshops und Kampagnen mit nutzergenerierten Inhalten.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Rezepte als redaktioneller Sockel</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Klare Schritt-für-Schritt-Anleitungen, sorgfältige Fotos und Videos. Ein Niveau, das der Branche würdig ist und dem Konditor das Gefühl gibt, er könne es am nächsten Tag in der Küche umsetzen.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Live-Vorführungen mit anerkannten Konditoren stiften Vertrauen</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Die Köche zeigten Techniken mit Master-Martini-Zutaten, beantworteten Fragen der Zuschauer und gingen auf das ein, was beim Profi wirklich zählt: Mengenverhältnisse, Temperaturen, entscheidende Momente.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Wettbewerbe machten Kunden zu Urhebern eigener Inhalte</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Die Köche reichten Gerichte ein, die mit Master-Martini-Produkten entstanden waren, versehen mit einem Marken-Hashtag. Echte Profis, echte Küchen, nachprüfbare Ergebnisse. Solche Inhalte zählen unter Kollegen am meisten.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Workshops, um weiter in die Tiefe zu gehen</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Neue Patisserie-Techniken, aufkommende Trends, konkrete Anwendungen. Die Workshops zogen Köche an, die etwas Neues suchten. Viele probierten am Ende Produkte aus, von deren Existenz sie zuvor nichts wussten.
            </p>
          </div>
        </div>

        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Fünf Märkte, fünf Ansätze. Die Inhalte für Indonesien hatten mit denen für Hongkong nichts gemeinsam. Eigene Sprachen, eigene kulinarische Traditionen, jeweils andere lokale Köche im Rampenlicht. Kein duplizierter Feed über die fünf Konten.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Ergebnisse">Aus reinen Marketingkonten ein Ort, an dem Köche lernen und teilen.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Die Markenbekanntheit zog auf allen fünf Märkten an. Die Followerzahlen stiegen auf beiden Plattformen. Vor allem aber folgten Anfragen und Bestellungen: aus Mitlesern wurden Käufer.
            </p>
            <p>
              Die Inhalte liefen auch über die fünf Ursprungsmärkte hinaus. Köche teilten Beiträge mit Kollegen in Nachbarländern, und die Reichweite von Master Martini erreichte Regionen, in denen die Marke kaum vertrieben war.
            </p>
            <p>
              Mit der Zeit waren die Konten keine bloßen Marketingkanäle mehr, sondern ein Ort, an den Bäcker und Konditoren Asiens kamen, um zu lernen, ihre Arbeit zu zeigen und sich unter Kollegen auszutauschen. Master Martini setzte sich ins Zentrum dieser Community.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="Sie sind dran">Sie wollen eine Profi-Community in Asien rund um Ihre Marke aufbauen?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Klarer Leistungsumfang. Fester Preis. Team vor Ort.
        </p>
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
