---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Kampagne', 'eCommerce', 'Influencer / KOL', 'Livestream', 'Medien', 'Social'];
const platforms = ['WeChat', 'RedNote', 'Weibo'];
---

<PageLayout
  title="Mission Foods: Social-Media-Case-Study China | TheRedScroll"
  description="Wie Mission Foods Maistortilla-Chips in China über WeChat, RedNote und Weibo eingeführt hat. Gen-Z-Social-Kampagnen, Food-Pairing-Content und Community-Wachstum."
  ogImage="/images/clients/MissionFoods/head-pic.jpg"
  lang="de"
>

  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll" style="background-image: url('/images/clients/MissionFoods/head-pic.jpg')" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">Fallstudie</p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Mission Foods: Maistortilla-Chips in China über die sozialen Netzwerke einführen.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Mission Foods musste chinesischen Konsumenten Maistortilla-Chips schmackhaft machen, die noch nie davon gekostet hatten. Wir haben eine Social-Media-Strategie gebaut, die eine neue Snack-Kategorie aus dem Boden gehoben hat.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
        <Button variant="secondary-dark" href="#case-study">Fallstudie lesen</Button>
      </div>
    </div>
  </section>

  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Kunde</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Mission Foods</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Branche</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Food / Konsumgüter</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Leistungen</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (<span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Plattformen</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (<span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section id="case-study" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Kunde">Eine globale Marke führt eine in China unbekannte Snack-Kategorie ein.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Mission Foods, globale Marke der mexikanischen Küche, zählt zu den größten Tortilla-Produzenten der Welt. In China brachte das Unternehmen Maistortilla-Chips auf den Markt. International eine feste Referenz, im lokalen Essalltag schlicht nicht vorhanden.
            </p>
            <p>
              Die meisten Konsumenten hatten sie nie probiert. Viele nie davon gehört. Und die Zielgruppe war die Gen Z.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img src="/images/clients/MissionFoods/1-1.jpg" alt="Mission-Foods-Social-Content mit Food-Pairings rund um Maistortilla-Chips auf chinesischen Plattformen" class="w-[340px] max-[640px]:w-[280px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
      <img src="/images/clients/MissionFoods/1-2.jpg" alt="Mission-Foods-Gen-Z-Snacking-Kampagnen-Content auf RedNote und WeChat" class="w-[340px] max-[640px]:w-[280px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        Mission-Foods-Social-Content auf WeChat, Weibo und RedNote. Food-Pairing-Kampagnen und Gen-Z-Snacking-Momente.
      </p>
    </Container>
  </section>

  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Was wir gemacht haben">Maistortilla-Chips vertraut machen, nicht exotisch.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Wir haben Social-Kampagnen und einen stetigen redaktionellen Fluss auf WeChat, Weibo und RedNote gefahren. Eine Intuition trug die ganze Strategie: in China würden Maistortilla-Chips nur dann durchbrechen, wenn sie aufhörten, fremd zu wirken.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Food-Pairings als Antwort auf die echte Frage</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Wir haben Maistortilla-Chips zu chinesischen Gerichten kombiniert: Dips, Begleiter zum Hotpot, Rezepte, in denen das Knusprige auf vertraute Aromen trifft. Eine Antwort auf die Frage, die sich jeder Konsument stellte: Wie isst man das eigentlich?
            </p>
            <p>
              Die Pairings wirkten natürlich und respektierten die hiesige Esskultur. Genau das hat sie wirksam gemacht.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Rund um die Snacking-Momente der Gen Z gedacht</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Abende mit Freunden, kleiner Hunger am späten Tag, gemeinsames Teilen. Spielerisch, schnell, bildstark. Der Typ Content, den man speichert und in Gruppenchats weiterreicht. Auf den Snack zentriert, nie auf die Marke.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">RedNote-KOLs haben das Produkt in den Alltag gebracht</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Echte Küchen, echte Snacking-Momente, spontane Reaktionen. Der KOC-Content brachte das organische Volumen und etablierte Maistortilla-Chips als Produkt, das Konsumenten wirklich kaufen.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Halloween, Höhepunkt des Dispositivs</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Themen-Content, der Maistortilla-Chips als Party-Snack schlechthin verankerte. Kostüm-Visuals, Apero-Bretter, Feier-Szenen. Das Timing passte: Halloween zieht in Chinas Gen Z rasch an, und das Produkt fügte sich mühelos ein.
            </p>
            <p>
              Die Kampagne löste einen deutlichen Schub bei Follower- und Engagement-Zahlen auf allen drei Plattformen aus.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">WeChat hielt die Brücke zwischen den Kampagnen</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Rezepte, Produktneuheiten, saisonale Aktionen. Ein stetiger Takt, der die Zielgruppe auch dann bei der Stange hält, wenn keine große Kampagne läuft.
            </p>
          </div>
        </div>

        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Alles produziert in China von unserem Team: Muttersprachler, kulturell gedachter Content, wöchentliche Performance-Sicht.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Ergebnisse">Die Höhepunkte zählten. Die Arbeit zwischen den Höhepunkten zählte mehr.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Die Halloween-Kampagne lieferte die stärksten Zahlen: Follower-Wachstum und Engagement über den bisherigen Referenzen.
            </p>
            <p>
              Das Wesentliche entschied sich aber zwischen den Spitzen. Der laufende Content brachte die Zielgruppe Woche für Woche nach oben: Rezepte, Angebote, Snacking-Ideen. Die Abos liefen weiter, die Reaktionen ebenfalls.
            </p>
            <p>
              Mission Foods wechselte vom Launch eines unbekannten Produkts zum Aufbau einer echten Community drumherum. So sieht es aus, wenn Social-Content den Markt wirklich trifft.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="Sie sind dran">Sie wollen ein Produkt auf Chinas sozialen Netzwerken launchen?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Klarer Leistungsumfang. Fester Preis. Team vor Ort.
        </p>
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
