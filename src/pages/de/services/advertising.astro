---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import FaqAccordion from '../../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'Welches Startbudget sollte ich einplanen?', a: 'Das hängt von der Plattform ab. RedNote startet ab 5.000 €. Auf Douyin sollten Sie für In-Feed-Anzeigen mindestens 1.000 € pro Tag rechnen. Auf WeChat Moments dieselbe Untergrenze: 1.000 € pro Tag. In der Praxis empfehlen wir eher 15.000 bis 30.000 € pro Monat, damit genug Daten zusammenkommen, um die Kampagnen wirklich zu schärfen.' },
  { q: 'Verwalten Sie die Mediabudgets selbst?', a: 'Ja. Das Investment fließt direkt an die Plattformen. Wir behalten keine Provision ein. Unser Honorar deckt Strategie, Setup, Anzeigengestaltung und Reporting.' },
  { q: 'Nach wie langer Zeit zeigen sich Ergebnisse?', a: 'Für Traffic in der Regel ab der ersten Woche. Abschlüsse brauchen zwei bis drei Wochen Feintuning. Für Markenbekanntheit sind 30 bis 60 Tage realistisch.' },
  { q: 'Unsere bestehenden Anzeigen liefern nichts. Was tun?', a: 'Wir starten grundsätzlich mit einem Audit: Kampagnen, Targeting, Visuals, Budget-Aufteilung. Was nicht funktioniert, überarbeiten wir. Häufigste Ursachen: falsches Format, zu lange laufende Visuals, zu breites Targeting und vor allem fehlende tägliche Optimierung.' },
  { q: 'Produzieren Sie auch die Visuals und Videos?', a: 'Ja. Video, Bild, Copy: alles auf die jeweilige Plattform abgestimmt. Die Kreativrichtung steuert unser Team. Die Produktion wird über HubStudio.ai von KI beschleunigt.' },
  { q: 'Beitrag boosten oder echte Kampagne?', a: 'Einen einzelnen Post zu pushen geht schnell, stößt aber rasch an Grenzen. Eine strukturierte Kampagne erlaubt feines Targeting, Kreativ-Tests, Conversion-Ziele, eine echte Gebotsstrategie und das Tracking des ROAS. Der Ergebnisunterschied ist meist erheblich.' },
  { q: 'Ist ROAS immer die richtige Kennzahl?', a: 'Für Online-Verkauf und Direct Response in neun von zehn Fällen ja. Bei Markenbekanntheit wechseln wir zu CPM und Reichweite. Entscheidend ist, sich vorab auf eine Definition von Erfolg zu einigen, nicht erst nach dem Start.' },
  { q: 'Können wir parallel auf mehreren Plattformen ausspielen?', a: 'Ja. Oft ist genau das die bessere Wahl. Douyin und RedNote decken Entdeckung und Awareness. WeChat erlaubt Retargeting derjenigen, die anderswo bereits interagiert haben. Die richtige Kombination richten wir an Zielen und Budget aus.' },
  { q: 'Und die Verifizierung der Werbekonten?', a: 'Die meisten Plattformen sperren den Zugriff auf den Ad-Manager, solange das Konto nicht verifiziert ist. Wir übernehmen den gesamten Prozess. Dauer: ein bis drei Wochen.' },
  { q: 'Wie sind Ihre Honorare aufgebaut?', a: 'Fester Betrag für Gestaltung und Steuerung. Das Mediabudget ist getrennt und geht direkt an die Plattformen. Keine Grauzone.' },
];

const gettingStartedSteps = [
  {
    title: 'Erstgespräch.',
    description: 'Ihre Marke, Ihre Ziele, das Budget, das Ihnen vorschwebt. Gemeinsam legen wir den richtigen Ansatz fest.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Mediaplan.',
    description: 'Plattformauswahl, Budget-Aufteilung, Zielkennzahlen. Klarer Umfang, fester Steuerungs-Honorar.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'In zwei Wochen on air.',
    description: 'Kontenfreischaltung, Visual-Produktion, Launch. Die Optimierung läuft ab Tag eins.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="Werbung auf Chinas sozialen Netzwerken | TheRedScroll"
  description="Mediaeinkauf und Werbeoptimierung auf WeChat, Douyin und RedNote. Feste Honorare, transparentes Mediabudget. Team in Shanghai."
  lang="de"
>

  <!-- Hero -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/advertising-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Mediaeinkauf und Werbung
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Die richtigen Zielgruppen erreichen, nicht einfach mehr Zielgruppen.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Wir planen, kaufen und optimieren Ihre Kampagnen auf WeChat, Douyin, RedNote und Weibo. Feste Steuerungshonorare, vollständig transparentes Mediainvestment.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/de/contact">Gespräch vereinbaren</Button>
        <Button variant="secondary-dark" href="#what-we-do">Unsere Leistungen</Button>
      </div>
    </div>
  </section>

  <!-- Why advertising is (almost) mandatory -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Warum bezahlen</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Werbung ist nahezu kein Optional mehr</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">Organische Reichweite baut Zielgruppen langfristig auf. Sie erreicht aber nicht die 25- bis 34-jährigen Shanghaierinnen, die letzte Woche nach „Naturkosmetik" gesucht haben. Werbung schon.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">Unsere Leistungen</Button>
          </div>
        </div>
        <div class="relative overflow-hidden bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Tempo</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Organischer Content braucht Monate, bis er trägt. Eine sauber kalibrierte Kampagne löst Verkäufe binnen Tagen aus.</p>
        </div>
        <div class="relative overflow-hidden bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Präzision</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">Wir steuern nach Alter, Geschlecht, Stadtkategorie, Interessen, Gerätetyp, Kaufverhalten und Surfverlauf. Ihre Anzeigen erscheinen genau dort, wo Sie es festlegen.</p>
        </div>
        <div class="relative overflow-hidden bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Skalierbarkeit</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">5.000 € am Montag investiert. Trägt die Performance, springt die Schwelle bis Freitag auf 50.000 €. Keine organische Strategie liefert diese Elastizität.</p>
        </div>
        <div class="relative overflow-hidden bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Aber der Preis ist real</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Eine schlecht durchdachte Kampagne verbrennt Budget schneller als gar keine Kampagne. Mediaplanung, tägliche Optimierung und klare Kennzahlen zählen so viel wie die Anzeigen selbst.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Unsere Leistungen">Mediaplanung</SectionHeading>

      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img
          src="/images/what-we-do/advertising.png"
          alt="Das TheRedScroll-Team bei der Auswertung von Kampagnenergebnissen"
          class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Mediaplanung</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Bevor ein Euro ausgegeben wird, setzen wir den Rahmen. Welche Plattformen, welche Formate, welche Zielgruppenprofile, wie viel je Kanal und welchen Kosten-pro-Ergebnis Sie realistisch anpeilen können.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Kampagnen aufsetzen und optimieren</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">End-to-End. Kontenfreischaltung, Asset-Upload, Targeting, Bid-Strategie, A/B-Tests. Tägliche Optimierung. Ein Visual, das am Montag liefert, kann am Donnerstag bereits einbrechen.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Alle Plattformen abgedeckt</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Wir steuern Kampagnen auf Ocean Engine (Douyin), Tencent Ads (WeChat), Juguang (RedNote) und Weibo Fan Tong. Die Advanced-Settings, die den Unterschied machen, kennen wir.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Ad creative + Retargeting + Compliance + Reporting -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[1024px]:p-[32px] max-[640px]:p-[32px_20px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Komplette Betreuung</p>
        <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[16px]">Von der Kreation bis zum Monitoring, inklusive Compliance</h2>
        <div class="max-w-[680px] flex flex-col gap-[24px] mb-[32px]">
          <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
            Werbung, die nach Werbung aussieht, sieht sich niemand an. Werbung, die wie nativer Content wirkt, behält die Aufmerksamkeit. Wir gestalten Visuals plattformgerecht und tauschen sie aus, bevor die Performance einbricht. KI fängt das Produktionsvolumen ab. Die Kreativrichtung bleibt in unseren Händen.
          </p>
        </div>
        <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[24px]">
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Retargeting und Custom Zielgruppen</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Jemand hat Ihr Douyin-Video zur Hälfte gesehen, aber nicht geklickt? Wir sprechen ihn unter einem anderen Winkel erneut an. Ein Besucher war auf Ihrem Mini Program und hat nichts gekauft? Wir holen ihn mit einem neuen Aufhänger zurück. Auf RedNote bauen wir Zielgruppen aus Nutzern auf, die mit bestimmten Notes interagiert oder bestimmte Keywords gesucht haben. Hier ist der ROI oft am höchsten.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Compliance und Anzeigenfreigabe</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Jede Plattform setzt eigene Freigaberegeln. Manche Branchen unterliegen Einschränkungen, andere sind ganz untersagt. Wir übernehmen die Compliance-Prüfung vorab, den Freigabeprozess und weisen branchenspezifische Restriktionen aus, bevor Sie auch nur einen Euro investieren.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Performance-Reports</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              ROAS ist der Kompass. Daneben verfolgen wir CPC, CPM, CTR, CPA, Conversion-Rate und Frequenz. Wochenreport während die Kampagnen laufen. Monatsbilanz. Bei größeren Budgets ein Echtzeit-Dashboard.
            </p>
          </div>
          <div>
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Transparentes Budget</h3>
            <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
              Das Mediabudget wird separat abgerechnet. Keine Provision. Keine versteckten Aufschläge auf den Mediaeinkauf. Sie sehen genau, wohin jeder Euro fließt.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Ad formats & indicative pricing — WeChat -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Formate und Richtpreise">WeChat (über Tencent Ads)</SectionHeading>
      <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[24px] max-w-[680px]">
        Die folgenden Preise stützen sich auf Daten aus dem ersten Quartal 2026 und unsere eigenen Referenzen. Sie dienen der Budget-Orientierung. Es sind keine Angebote.
      </p>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-moments-ad.svg" alt="Beispielanzeige WeChat Moments" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Moments-Anzeigen</h3>
            <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Native Anzeigen im sozialen Feed. Karussell mit bis zu sechs Karten, Auto-Play-Video (6 bis 15 Sek.) oder Vollbild nach Tap. 122 Interessen-Unterkategorien. Gebote ab 1.000 € pro Tag. CPM zwischen 50 und 180 €, je nach Stadtkategorie.</p>
          </div>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/ad-formats/wechat-banner-ad.svg" alt="Banner in einem Official-Account-Artikel auf WeChat" class="w-full aspect-[16/10] object-cover" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Banner</h3>
