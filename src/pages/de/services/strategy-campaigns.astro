---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import FaqAccordion from '../../../components/sections/FaqAccordion.astro';
import GettingStarted from '../../../components/sections/GettingStarted.astro';


const faqs = [
  { q: 'Wie lange dauert die Strategiephase?', a: 'Das hängt vom Umfang ab, in der Regel zwischen zwei und vier Wochen. Diese Arbeit ist seit Jahren unser Alltag, der Ablauf läuft entsprechend zügig.' },
  { q: 'Arbeiten Sie nur mit Marken, die gerade in den Markt eintreten?', a: 'Nein. Drei Profile sprechen uns an: Marken, die nach China kommen, bereits ansässige Marken mit höheren Ansprüchen an die Performance, und lokale Marken, die in den sozialen Netzwerken zulegen wollen. Drei Ausgangslagen, derselbe Anspruch.' },
  { q: 'Kann man mit einer einzigen Plattform starten?', a: 'Ja, und oft empfehlen wir genau das. Die Mittel bündeln, prüfen, was Ergebnisse bringt, eine Dynamik aufbauen und das Dispositiv dann erweitern.' },
  { q: 'Welche Plattformen decken Sie ab?', a: 'WeChat, Douyin, RedNote und Weibo sind Bestandteil aller Pakete. Bilibili, Zhihu, Kuaishou, Toutiao, Meituan, Dianping und neun weitere Plattformen kommen optional hinzu.' },
  { q: 'Wie sind Ihre Preise strukturiert?', a: 'Klarer Leistungsumfang, Festpreis. Eine präzise Liste der Leistungen und ein einheitlicher Monatsbetrag. Werbeausgaben werden separat abgerechnet. Keine versteckten Kosten, kein Scope-Creep während der Laufzeit.' },
  { q: 'Was unterscheidet Ihre Analysen von einem klassischen Dashboard?', a: 'Multiplattform-Performance-Tracking, detaillierte Wettbewerbsvergleiche, Engagement-Daten Beitrag für Beitrag. Vor allem übersetzen wir die Zahlen in umsetzbare Empfehlungen. Keine bloßen Kurven.' },
  { q: 'Übernehmen Sie auch die Content-Produktion oder nur die Strategie?', a: 'Strategie und Kampagnen gehören zu dieser Leistung. Die Produktion (Visuals, Videos, Texte) ist ein eigenes Mandat, aber beide laufen Hand in Hand: die Strategie bestimmt, was produziert wird.' },
  { q: 'Wie oft wird die Strategie überprüft?', a: 'Mindestens monatlich. Quartalsweise gehen wir tiefer: Neueichung der Kennzahlen, Aktualisierung des Wettbewerbsvergleichs, erneuter Blick auf den Plattformmix.' },
  { q: 'Können Sie parallel zu unserem internen Team oder unserer aktuellen Agentur arbeiten?', a: 'Manche Kunden geben uns die gesamte Steuerung. Andere lassen uns nur die Strategie entwickeln und behalten die Umsetzung intern. Wir passen uns dem Setup an, das für Sie funktioniert.' },
  { q: 'Was, wenn unsere Konten bereits bestehen, aber keine Ergebnisse liefern?', a: 'Wir beginnen mit einem Audit: bestehende Konten, veröffentlichte Inhalte, Engagement, Wettbewerbspositionierung. Daraus entsteht eine überarbeitete Strategie, gestützt auf das, was die Daten sagen. Manchmal liegt das Problem beim Plattformmix. Manchmal beim Inhalt selbst, am Takt oder am Redaktionsplan. Wir benennen die Schwachstelle, bevor wir eingreifen.' },
];

const gettingStartedSteps = [
  {
    title: 'Erstgespräch.',
    description: 'Ihre Marke, Ihre Ziele, Ihr Reifegrad für den chinesischen Markt. Kein Verkaufspitch, nur die richtigen Fragen.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Angebot.',
    description: 'Klarer Leistungsumfang, Festpreis, jede Leistung beschrieben. Sie wissen genau, was Sie bekommen, bevor Sie unterschreiben.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'In zwei Wochen live.',
    description: 'Strategie übergeben, Kampagnen aufgesetzt, erste Inhalte veröffentlicht. Zwei Wochen nach Vertragsschluss.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="Social-Media-Strategie und Kampagnen in China | TheRedScroll"
  description="Social-Media-Strategie, Kampagnensteuerung und Reporting für Marken in China. Klarer Leistungsumfang, Festpreis. Team in Shanghai."
  lang="de"
>

  <!-- Hero -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/strategy-campaigns-hero.webp')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Strategie, Kampagnen und Reporting
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Die richtige Strategie. Die richtigen Plattformen. Die richtigen Zahlen.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Wir analysieren Ihren Markt, bauen Ihren Plan, orchestrieren Ihre Kampagnen und messen das, was wirklich zählt. Aus Shanghai und Hongkong.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
        <Button variant="secondary-dark" href="#what-we-do">Unsere Leistungen</Button>
      </div>
    </div>
  </section>

  <!-- Problem intro -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Der Befund">Die meisten Marken veröffentlichen ohne Gesamtplan.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Plattformen wählt man aus dem Bauch, gepostet wird, wenn ein Slot frei wird, die Zahlen schaut man sich einmal im Quartal an. Manchmal seltener.
            </p>
            <p>
              Eine ernst gemeinte Strategie geht anders los: Welche Plattformen passen zu Ihrer Branche, was machen Ihre Wettbewerber und wo stecken sie fest, welche Formate liefern Ergebnisse, wie lässt sich anhand der Zahlen belegen, dass die Mechanik trägt.
            </p>
            <p>
              Wir entwickeln jede Strategie auf einem weißen Blatt. Echte Marktdaten, fundierte Wettbewerbsanalyse, alltägliche Plattformkenntnis. Anschließend steuern wir die Kampagnen selbst, ohne Zwischenstation.
            </p>
          </div>
        </div>
        <div class="flex items-center justify-center">
          <img src="/images/strategy-compass.svg" alt="Kompass ohne Nadel, Strategie ohne Richtung" class="w-full max-w-[320px]" loading="lazy" />
        </div>
      </div>
    </Container>
  </section>

  <!-- Why you need a platform-specific strategy -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="relative col-span-2 row-span-2 max-[640px]:col-span-1 max-[640px]:row-span-1 bg-[#1A1A1A] rounded-[12px] p-[32px] max-[640px]:p-[20px] flex flex-col justify-between min-h-[320px] max-[640px]:min-h-0 overflow-hidden">
          <svg class="absolute bottom-[-20px] right-[-20px] w-[260px] h-[260px] opacity-[0.06]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/><circle cx="7" cy="16" r="1.5"/><circle cx="11" cy="8" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="21" cy="4" r="1.5"/></svg>
          <div class="relative z-[1]">
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Warum es zählt</p>
            <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#FFFFFF] mb-[16px]">Warum jede Plattform ihre eigene Strategie braucht</h2>
            <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[400px]">Jede Plattform hat ihre eigene Zielgruppe, ihre eigenen Formate und ihren eigenen Algorithmus. Dieselbe Rezeptur überall anzuwenden, verbrennt Budget und lässt die echten Chancen vorbeiziehen.</p>
          </div>
          <div class="relative z-[1] mt-[24px]">
            <Button variant="secondary-dark" href="#what-we-do">Unsere Leistungen</Button>
          </div>
        </div>
        <div class="bg-[#F0F1F4] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="8" height="8" rx="1"/><rect x="14" y="3" width="8" height="8" rx="1"/><rect x="2" y="13" width="8" height="8" rx="1"/><rect x="14" y="13" width="8" height="8" rx="1"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Jede Plattform diktiert eigene Regeln</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">WeChat, Douyin, RedNote und Weibo teilen sich weder Formate noch Werbesysteme noch Nutzererwartungen. Die falsche Plattform zu wählen, heißt Budget verbrennen.</p>
        </div>
        <div class="bg-[#1A1A1A] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M7 7l3.5 9M17 7l-3.5 9"/><path d="M7 6h10"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Zielgruppen wandern von Plattform zu Plattform</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.6)]">Konsumenten recherchieren auf RedNote, folgen Marken auf WeChat, sehen Produktdemos auf Douyin und lesen Bewertungen auf Weibo.</p>
        </div>
        <div class="bg-[#CC3333] rounded-[12px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.1]" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Der Wettbewerb hat seine Positionen bezogen</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[rgba(255,255,255,0.8)]">Ihre Wettbewerber veröffentlichen täglich, fahren Influencer-Kampagnen und investieren in Media. Ohne klaren Plan geben Sie blind aus.</p>
        </div>
        <div class="bg-[#E8E0D8] rounded-[10px] p-[24px] max-[640px]:p-[20px] relative overflow-hidden">
          <svg class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120px] h-[120px] opacity-[0.07]" viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <h3 class="relative z-[1] text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Das Spielfeld verschiebt sich laufend</h3>
          <p class="text-[13px] font-normal leading-[1.5] text-[var(--color-stone)]">Algorithmen ändern sich ohne Vorwarnung. Neue Werbeformate tauchen alle zwei bis drei Monate auf. Eine Strategie, die im Januar funktioniert, kann im April längst nicht mehr passen.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- What we do — Market & Competitor Research -->
  <section id="what-we-do" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Was wir tun">Marktanalyse und Wettbewerbsrecherche</SectionHeading>

      <div class="rounded-[12px] overflow-hidden mt-[24px]">
        <img src="/images/what-we-do/strategy-campaigns.webp" alt="Das TheRedScroll-Team bei der Auswertung strategischer und wettbewerblicher Daten" class="w-full aspect-[5/2] max-[640px]:aspect-[16/10] object-cover" loading="lazy" decoding="async" />
      </div>

      <div class="grid grid-cols-3 max-[768px]:grid-cols-1 gap-[24px] -mt-[72px] max-[768px]:-mt-[32px] px-[32px] max-[768px]:px-[0px] relative z-[1]">
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Wettbewerbsanalyse</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Wir kartieren die Konten Ihrer Wettbewerber auf jeder großen Plattform. Follower, Veröffentlichungstakt, Engagement-Rate, Themenfelder, Werbeinvestitionen. Eine Analyse, zugeschnitten auf Ihre Marke, kein vorgefertigter Report.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Plattformauswahl</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Keine Marke braucht alle Plattformen gleichzeitig. Beauty spielt auf RedNote. B2B läuft über WeChat und Zhihu. Mode entwickelt sich auf Douyin. Wir wählen aus, was zu Ihrer Branche passt, und nur das.</p>
        </div>
        <div class="bg-white rounded-[10px] p-[32px] max-[640px]:p-[20px] border border-[rgba(0,0,0,0.08)]">
          <div class="w-[48px] h-[48px] rounded-full bg-[var(--color-warm-gray)] flex items-center justify-center mb-[16px]">
            <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Redaktionsstrategie und Kalender</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Content-Säulen, inhaltliche Leitlinien, Tonalität pro Plattform. Themen, Formate, Veröffentlichungstakt. Jede Plattform hat ihren eigenen Kalender, monatlich nachjustiert am Ergebnis.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Creative & Planning -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#1A1A1A] rounded-[12px] p-[48px] max-[640px]:p-[32px_20px]">
        <div class="grid grid-cols-[1fr_1px_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px]">
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">Kreation und Planung</p>
            <h2 class="text-[#FFFFFF] text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] mb-[24px]">Das Feld, auf dem alles entschieden wird.</h2>
            <div class="flex flex-col gap-[24px]">
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                KI hat die Karten die Inhalte-Produktion neu gemischt. Visuals, Videoschnitt, erste Textversionen entstehen schneller und zu Kosten, die mit denen des Vorjahres nicht mehr vergleichbar sind. Die Produktionskosten gehen gegen null.
              </p>
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                Diese Verschiebung macht die kreative Planung wichtiger, nicht unwichtiger. Wenn alle in Serie produzieren können, heben sich jene Marken ab, die die besseren Ideen und die feinere kreative Führung haben. Das Leistung ist nicht mehr das Hindernis. Die eigentliche Frage bleibt: Was produzieren, warum, und wie greift das Ganze ineinander. Das war und bleibt eine menschliche Aufgabe.
              </p>
            </div>
          </div>
          <div class="flex items-center max-[640px]:hidden">
            <div class="w-[1px] h-[60%] bg-[var(--color-vermillion)]"></div>
          </div>
          <div class="flex flex-col gap-[32px]">
            <div>
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Kreativrichtung</h3>
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                Für jede Kampagne schreiben wir ein Kreativ-Briefing. Visuelle Richtung, Tonalität, Format-Vorgaben, plattformspezifische Referenzen. Jedes Briefing stützt sich auf das, was auf der Zielplattform tatsächlich funktioniert. Wir analysieren die top-platzierten Inhalte Ihrer Kategorie, ziehen Referenzen aus den performantesten Beiträgen und identifizieren die KOL-Inhalte (Key Opinion Leader), die im Moment des Briefings Aufmerksamkeit binden.
              </p>
            </div>
            <div>
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#FFFFFF] mb-[8px]">Kampagnen-Orchestrierung</h3>
              <p class="text-[14px] font-normal text-[rgba(255,255,255,0.6)] leading-[1.5]">
                Eine Kampagne ist keine Aneinanderreihung von Posts. Sie gleicht einer Partitur, die Content, Influencer, Mediaeinkauf und Community-Arbeit zusammenführt. Unsere Social-Media-Verantwortlichen synchronisieren KOL-Kalender mit den Marken-Releases, stimmen den Mediaeinkauf auf die organische Dynamik ab und verlagern Budgets unterwegs, sobald ein Inhalt durch die Decke geht oder einbricht.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Day-to-day + KPI + Analytics -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Umsetzung">Tagesgeschäft und Reporting</SectionHeading>

      <div class="flex gap-[2px] mt-[24px] h-[400px] max-[640px]:flex-col max-[640px]:h-auto" data-col-accordion>

        <div class="col-panel is-active rounded-l-[10px] max-[640px]:rounded-l-none max-[640px]:rounded-t-[10px]" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Kontenbetreuung</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Kontenbetreuung</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Wir übernehmen den täglichen Betrieb auf WeChat, Douyin, RedNote, Weibo und vierzehn weiteren Plattformen. Veröffentlichung, Community-Arbeit, Kommentar-Moderation, Trendbeobachtung. Den Aufbau eines lokalen Teams sparen Sie sich.</p>
          </div>
        </div>

        <div class="col-panel" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Kampagnen und Sonderaktionen</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Kampagnen und Sonderaktionen</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Saisonkampagnen, Produkt-Launches, Event-Aktionen, plattformübergreifende Pushes. Präzises Briefing, festgelegte Kennzahlen, Rückwärtsplanung, ausführliche Abschlussauswertung.</p>
          </div>
        </div>

        <div class="col-panel" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Kennzahlen und Ziele</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Kennzahlen und Ziele</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Messbare Ziele vom ersten Tag an. Follower-Wachstum, Engagement-Rate, Video-Views, Klickrate, Abschlüsse. Die Kennzahlen sind an konkrete Ergebnisse gebunden, nicht an Schaufenster-Zahlen. Monatlicher Review, quartalsweises Nachjustieren.</p>
          </div>
        </div>

        <div class="col-panel rounded-r-[10px] max-[640px]:rounded-r-none max-[640px]:rounded-b-[10px]" data-col-panel>
          <div class="col-label">
            <span class="col-label-text">Analyse und Reporting</span>
          </div>
          <div class="col-content">
            <h3 class="text-[20px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">Analyse und Reporting</h3>
            <p class="text-[14px] font-normal leading-[1.6] text-[var(--color-stone)]">Die monatlichen Reports decken Follower-Wachstum, Engagement-Raten, Content-Performance, Werbe-ROI und Wettbewerbsvergleich ab. Multiplattform-Tracking, detaillierte Engagement-Daten, Empfehlungen direkt mitgeliefert. Keine bloßen Grafiken.</p>
          </div>
        </div>

      </div>

      <style>
        .col-panel {
          position: relative;
          flex: 0 0 56px;
          background: var(--color-rice-paper);
          cursor: pointer;
          overflow: hidden;
          transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .col-panel.is-active {
          flex: 1 1 0%;
          cursor: default;
        }

        .col-label {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 1;
          transition: opacity 0.3s ease;
        }
        .col-panel.is-active .col-label {
          opacity: 0;
          pointer-events: none;
        }
        .col-label-text {
          writing-mode: vertical-rl;
          text-orientation: mixed;
          transform: rotate(180deg);
          font-size: 14px;
          font-weight: 500;
          color: var(--color-ink);
          white-space: nowrap;
          letter-spacing: 0.02em;
        }

        .col-content {
          position: absolute;
          inset: 0;
          padding: 32px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          opacity: 0;
          transition: opacity 0.35s ease 0.15s;
        }
        .col-panel.is-active .col-content {
          opacity: 1;
        }

        .col-panel.is-active::before {
          content: '';
          position: absolute;
          left: 0;
          top: 15%;
          bottom: 15%;
          width: 3px;
          background: var(--color-vermillion);
          border-radius: 0 2px 2px 0;
        }

        .col-panel:not(.is-active):hover {
          background: var(--color-warm-gray);
        }

        @media (max-width: 640px) {
          .col-panel {
            flex: 0 0 48px;
          }
          .col-panel.is-active {
            flex: 0 0 auto;
            min-height: 200px;
          }
          .col-label-text {
            writing-mode: horizontal-tb;
            transform: none;
            font-size: 13px;
          }
          .col-content {
            position: relative;
            padding: 20px;
          }
          .col-panel.is-active::before {
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            height: auto;
          }
        }
      </style>

      <script>
        document.querySelectorAll('[data-col-accordion]').forEach((accordion) => {
          const panels = accordion.querySelectorAll('[data-col-panel]');
          panels.forEach((panel) => {
            panel.addEventListener('click', () => {
              if (panel.classList.contains('is-active')) return;
              panels.forEach((p) => p.classList.remove('is-active'));
              panel.classList.add('is-active');
            });
          });
        });
      </script>
    </Container>
  </section>

