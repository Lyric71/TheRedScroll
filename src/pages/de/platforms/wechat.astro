---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import UpdatedDate from '../../../components/ui/UpdatedDate.astro';

const stats = [
  { label: 'Monatlich aktiv', value: '1.4B+', image: '/images/platforms/wechat-stats/monthly-active-users.png' },
  { label: 'In Festlandchina', value: '810M+', image: '/images/platforms/wechat-stats/users-in-china.png' },
  { label: 'Nutzungszeit pro Person und Tag', value: '82 min', image: '/images/platforms/wechat-stats/daily-time-per-user.png' },
  { label: 'Nutzen Mini Programs monatlich', value: '945M', image: '/images/platforms/wechat-stats/mini-program-users.png' },
  { label: 'Zahlen über WeChat Pay', value: '935M+', image: '/images/platforms/wechat-stats/wechat-pay-users.png' },
  { label: 'Nachrichten pro Tag', value: '45B', image: '/images/platforms/wechat-stats/messages-sent-daily.png' },
  { label: 'Aktive Official Accounts', value: '3.5M+', image: '/images/platforms/wechat-stats/official-accounts.png' },
  { label: 'Öffnen die App mehr als zehnmal täglich', value: '60%+', image: '/images/platforms/wechat-stats/daily-opens.png' },
];

const ecosystem = [
  {
    name: 'Service Account',
    chineseName: '服务号',
    description: 'Ihre offizielle Vitrine in China. Maßgeschneiderte Menüs, integrierte Zahlung, CRM-Tools. Vier Aussendungen pro Monat, bis zu 32 Artikel insgesamt. Der einzige Kontotyp, den ein ausländisches Unternehmen ohne lokale Gesellschaft eröffnen kann.',
    image: '/images/platforms/wechat-ecosystem/service-account.png',
    bg: '#F7F2EE',
    iconBg: '#E8E0D8',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
  },
  {
    name: 'Mini Programs',
    chineseName: '小程序',
    description: 'Apps innerhalb von WeChat. Nichts herunterzuladen. eCommerce, Buchung, Loyalty, Spiele. 945 Millionen Nutzer pro Monat. Direkt an WeChat Pay angedockt.',
    image: '/images/platforms/wechat-ecosystem/mini-programs.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
  },
  {
    name: 'WeChat Channels',
    chineseName: '视频号',
    description: 'Kurzvideo und Livestream. An Ihren Official Account und Ihr Mini Program angeschlossen. Sehen, tippen, kaufen: alles läuft innerhalb von WeChat.',
    image: '/images/platforms/wechat-ecosystem/wechat-channels.png',
    bg: '#CC3333',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
  },
  {
    name: 'WeChat Pay',
    chineseName: '微信支付',
    description: 'Mobile Zahlung ohne Vergleich. Über 935 Millionen aktive Nutzer. Vom Straßenhändler bis zum Luxushaus: der Weg über WeChat Pay ist verpflichtend. In China ohne dieses Tool zu verkaufen ist nicht denkbar.',
    image: '/images/platforms/wechat-ecosystem/wechat-pay.png',
    bg: '#E8E0D8',
    iconBg: '#FFFFFF',
    textColor: '#1A1A1A',
    descColor: '#5C5C5C',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  },
  {
    name: 'WeCom',
    chineseName: '企业微信',
    description: 'Das CRM aus dem Hause Tencent. Direkte Messaging, präzise Segmentierung, automatisierte Reminder. 750 Millionen WeChat-Nutzer in Reichweite. Marken, die hier zögern, bereuen es.',
    image: '/images/platforms/wechat-ecosystem/wecom.png',
    bg: '#1A1A1A',
    iconBg: 'rgba(255,255,255,0.1)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.6)',
    linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    name: 'Moments',
    chineseName: '朋友圈',
    description: 'Der Feed, in dem Chinesen ihren Alltag erzählen. Marken klinken sich über native Anzeigen mitten im Strom ein. Der vermutlich stärkste Hebel, um Bekanntheit zu verankern.',
    image: '/images/platforms/wechat-ecosystem/moments.png',
    bg: '#B02D2D',
    iconBg: 'rgba(255,255,255,0.2)',
    textColor: '#FFFFFF',
    descColor: 'rgba(255,255,255,0.8)',
    linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];

const services = [
  { title: 'Konteneröffnung und Verifizierung', description: 'Service-Account-Anmeldung, Verifizierungsverfahren, Einrichtung von Menüs, Auto-Antworten und Corporate Design. Wir übernehmen sämtliche Formalitäten und ersparen Ihnen mehrere Wochen Wartezeit.', result: 'Ein verifiziertes, einsatzfähiges WeChat-Konto, publikationsbereit.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`, image: '/images/platforms/wechat-services/account-setup.png' },
  { title: 'Strategie und Content-Produktion', description: 'Redaktionelle Säulen, Veröffentlichungsplan, Artikel, Visuals, Kurzvideos. Geschrieben wird von chinesischen Muttersprachlern. HubStudio.ai hält den Takt.', result: 'Inhalte, gedacht für China, gemacht, um bis zum Ende gelesen zu werden.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`, image: '/images/platforms/wechat-services/content-strategy.png' },
  { title: 'Mini-Program-Entwicklung', description: 'Online-Shops, Kontaktformulare, Loyalty-Programme, Reservierungstools. In WeChat gebaut, an WeChat Pay angeschlossen.', result: 'Eine Vitrine, die Leser in Käufer verwandelt, ohne die App zu verlassen.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`, image: '/images/platforms/wechat-services/mini-program.png' },
  { title: 'WeChat-Werbung', description: 'Mediaplanung, Kreationen, A/B-Tests, Bid-Steuerung, Reporting. Moments Ads, Banner Ads, Mini-Program Ads. Mediabudgets zum echten Preis weiterberechnet, ohne versteckte Marge.', result: 'Kampagnen, die die richtige Audience treffen, mit lückenlosem Reporting.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`, image: '/images/platforms/wechat-services/advertising.png' },
  { title: 'WeCom und CRM', description: 'Die Private Domain baut sich vom ersten Tag an auf. Segmentierung, Willkommensstrecken, personalisierte Reminder, Gruppen-Aktivierung. Der Baustein, den die meisten Agenturen vernachlässigen.', result: 'Eine Kundenbasis, die Ihnen gehört, und die Ihnen keine Plattform wegnehmen kann.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`, image: '/images/platforms/wechat-services/wecom-crm.png' },
  { title: 'WeChat Channels und KOL-Kampagnen', description: 'Kurzvideo-Produktion, Channels-Lives, Sourcing und Steuerung von KOL-Kampagnen. Nur verifizierte Engagement-Werte werden berücksichtigt.', result: 'Video-Content und Influencer-Kampagnen, verzahnt mit Ihrem Official Account und Ihrem Mini Program.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`, image: '/images/platforms/wechat-services/channels-kol.png' },
];

const bestPractices = [
  { title: 'Qualität vor Frequenz.', description: 'Ein Service Account hat Anrecht auf vier Aussendungen pro Monat. Ein Artikel, der weit zirkuliert, schlägt vier Texte, die bei dreißig Öffnungen stehenbleiben.' },
  { title: 'Nicht übersetzen, neu schreiben.', description: 'Einen englischen Text durch einen Übersetzer zu schicken, führt nirgendwohin. Beginnen Sie mit einem Briefing auf Chinesisch, von jemandem, der die Plattform von innen kennt.' },
  { title: 'Mini Program ohne Verzögerung starten.', description: 'Sie müssen nicht ab Tag eins verkaufen. Ein Produktkatalog, ein Marken-Quiz, ein Anmeldeformular reichen. Der Kern: dem Leser nach dem Artikel einen nächsten Schritt anbieten.' },
  { title: 'WeCom ab Tag eins anschließen.', description: 'Jeder neue Follower sollte zu einem WeCom-Kontakt werden. Sechs Monate später spielen Marken, die eine solide Private Domain aufgebaut haben, in einer anderen Liga.' },
  { title: 'Paid und Organic laufen zusammen.', description: 'Moments Ads pumpen die Follower-Basis schnell hoch. Fehlt solider Content bei deren Ankunft, abonnieren diese Neuzugänge innerhalb weniger Wochen wieder ab.' },
  { title: 'System denken, nicht Kanäle.', description: 'Der Official Account drückt zum Mini Program. WeCom übernimmt die Bindung. Channels speist die Entdeckung. Jeder Baustein nährt die anderen.' },
];

const steps = [
  { number: '01', title: 'Erstgespräch.', description: 'Erzählen Sie uns von Ihrer Marke, Ihren Zielen, Ihrer aktuellen Lage in China. Kein Verkaufspitch, nur die Fragen, die zählen.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>` },
  { number: '02', title: 'Angebot.', description: 'Klarer Umfang, fester Preis, jedes Deliverable schwarz auf weiß. Sie wissen vor der Unterschrift genau, was Sie bekommen und was es kostet.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>` },
  { number: '03', title: 'In zwei Wochen live.', description: 'Übernahme, Konteneröffnung, erste Veröffentlichung. Fünfzehn Tage zwischen Unterschrift und Erscheinen des ersten Artikels.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>` },
];

const faqs = [
  { q: 'Wer steuert unser WeChat-Konto konkret?', a: 'Unser Team in Shanghai und Hongkong. Chinesen, die die Plattform jeden Tag leben. Sie haben einen dedizierten Account-Verantwortlichen, gestützt auf ein komplettes Team: Redakteure, Designer, Videografen, Strategen. Alle in China. Keine zugekauften Freelancer, keine Steuerung aus einem anderen Kontinent.' },
  { q: 'Können Sie einen WeChat Official Account für ein ausländisches Unternehmen eröffnen?', a: 'Ja. Eine ausländische Gesellschaft kann mit einer ausländischen Geschäftslizenz einen Service Account eröffnen. Rechnen Sie mit ein bis zwei Wochen. Wir übernehmen den gesamten Prozess: Anmeldung, Verifizierung, Setup. Sie müssen sich nicht in die Tencent-Administration einarbeiten.' },
  { q: 'Braucht es eine juristische Einheit in China?', a: 'Kurze Antwort: nein, nicht für den Start. Ausländische Gesellschaften können direkt einen Service Account eröffnen. Bestimmte Funktionen entfalten ihre volle Kraft jedoch erst mit einer chinesischen Einheit, insbesondere die WeChat-Pay-Abwicklung und einige Werbeformate. Wir prüfen vor dem Start, was Ihre derzeitige Struktur erlaubt und was nicht.' },
  { q: 'Wie funktioniert die Preisgestaltung?', a: 'Klarer Umfang, fester Preis. Vor dem Start spezifizieren wir jedes Deliverable: Artikel, Videos, Kampagnen, Reports. Sie zahlen eine monatliche Pauschale. Kein Stundensatz, keine versteckten Kosten. Mediabudgets werden stets separat zum echten Preis abgerechnet, ohne Marge.' },
  { q: 'Wir haben bereits ein WeChat-Konto, aber es stagniert. Können Sie übernehmen?', a: 'Sehr häufiger Fall. Wir starten mit einem Audit, identifizieren, was läuft und was hakt, und bauen dann neu. Der Content trifft manchmal sein Ziel nicht. Manchmal schließen Follower mangels Mini Program den Artikel ohne nächsten Schritt. Wir stellen die Diagnose und korrigieren.' },
  { q: 'Wie schnell sind wir betriebsbereit?', a: 'Die meisten unserer Kunden kommen in weniger als zwei Wochen von Null zu einem aktiven, publizierenden WeChat-Konto. Anmeldung, Verifizierung, Setup, erster Content: alles enthalten. Ist Ihr Konto bereits verifiziert, können wir die Produktion in wenigen Tagen anwerfen.' },
  { q: 'Arbeiten Sie nur mit internationalen Marken?', a: 'Nein. Drei Kundenprofile sprechen uns an: internationale Marken, die nach China kommen, jene, die bereits vor Ort sind, und chinesische Marken, die ihre Social-Präsenz verstärken wollen. Die Leistungen sind dieselben. Die Strategie justiert sich auf Ihre Lage und Ziele.' },
  { q: 'Was unterscheidet Ihre Content-Produktion von anderen Agenturen?', a: 'Unsere Redakteure sind chinesische Muttersprachler, die für WeChat schreiben, keine Übersetzer, die ein englisches Dokument übernehmen. Auf der Produktionsseite beschleunigt HubStudio.ai Visuals und Video und senkt die Kosten. Die Kreativrichtung und die Strategie bleiben aber in menschlicher Hand.' },
  { q: 'Wie steuern Sie KOL-Kampagnen auf WeChat?', a: 'Wir übernehmen das Dossier vom Sourcing bis zum Reporting. Identifikation der richtigen Key Opinion Leaders, Briefing-Verfassung, Co-Kreation des Contents, Koordination der Veröffentlichungen, Wirkungsverfolgung. Ausschließlich verifizierte Engagement-Werte. Riecht die Follower-Zahl eines KOL nach Kauf, ziehen wir weiter.' },
  { q: 'Wie berichten Sie Ergebnisse?', a: 'Monatliches Reporting. Follower-Wachstum, Öffnungsraten der Artikel, Mini-Program-Traffic, Werbe-Performance, Conversions. Konkrete Zahlen, klare Sprache. Performt ein Hebel nicht, sagen wir, wo es klemmt und was wir ändern.' },
];
---

<PageLayout
  title="WeChat-Marketing für internationale Marken | TheRedScroll"
  description="Wir steuern WeChat-Konten aus Shanghai und Hongkong. Official Accounts, Mini Programs, WeCom, Channels und Werbung. Klarer Umfang, fester Preis."
  lang="de"
>
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/wechat-hero.png')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">微信</span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/de/platforms/others" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">&larr; Alle Plattformen</a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">WeChat-Marketing</p>
        <UpdatedDate lang="de" date="Mai 2026" variant="light" class="mb-[8px]" />
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">WeChat: 1,4 Milliarden Menschen schreiben, zahlen, kaufen und folgen dort ihren Marken.</h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">Wir steuern WeChat-Konten täglich aus Shanghai und Hongkong, für Marken, die mehr Follower, mehr Engagement und mehr Conversions in China wollen.</p>
        <Button variant="primary" href="/de/contact">Gespräch vereinbaren</Button>
      </div>
    </Container>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">Keine Zahlen zum Beeindrucken. Ihre chinesische Audience lebt bereits hier.</h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">WeChat in einigen Kennzahlen.</p>
        </div>
        <Button variant="primary" href="/de/contact" class="shrink-0">Gespräch vereinbaren</Button>
      </div>
    </Container>
    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>
      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none" data-stat-index={i}>
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]"><SectionBar /></div>
        <SectionHeading overline="Warum WeChat zuerst kommt">Ihre Website, Ihre E-Mail-Liste, Ihr CRM und Ihre Zahlungsseite. Alles in einer App.</SectionHeading>
      </div>
      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden"><img src="/images/platforms/wechat-why/own-audience.png" alt="Nutzer betrachtet seine WeChat-Follower am Telefon" class="w-full h-full object-cover" loading="lazy" decoding="async" /></div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Die Audience gehört Ihnen</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">Douyin und RedNote gehorchen dem Algorithmus. WeChat spielt nach anderen Regeln. Ihre Follower gehören Ihnen. Sie schreiben sie an, segmentieren nach Verhalten, pflegen die Beziehung Monat für Monat. In China heißt das Private Domain: eine Kundenbasis, die keine Plattform konfiszieren kann.</p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden"><img src="/images/platforms/wechat-why/full-journey.png" alt="Kunde schließt einen Kauf über ein WeChat-Mini-Program ab" class="w-full h-full object-cover" loading="lazy" decoding="async" /></div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Die gesamte Reise in einer App</h3>
