---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import UpdatedDate from '../../../components/ui/UpdatedDate.astro';

const stats = [
  { label: 'Täglich aktiv', value: '750M+', image: '/images/platforms/douyin-stats/daily-active-users.webp' },
  { label: 'Monatlich aktiv', value: '1B+', image: '/images/platforms/douyin-stats/monthly-active-users.webp' },
  { label: 'Minuten pro Person und Tag', value: '120 min', image: '/images/platforms/douyin-stats/daily-time.webp' },
  { label: 'eCommerce-Volumen 2024', value: '€3.5T', image: '/images/platforms/douyin-stats/ecommerce-sales.webp' },
  { label: 'Umsatzwachstum im Jahresvergleich', value: '34%', image: '/images/platforms/douyin-stats/yoy-growth.webp' },
  { label: 'Verkaufs-Livestreams pro Tag', value: '30M+', image: '/images/platforms/douyin-stats/live-commerce.webp' },
  { label: 'Content-Kategorien', value: '100+', image: '/images/platforms/douyin-stats/content-variety.webp' },
  { label: 'Aktive Creator', value: '15M+', image: '/images/platforms/douyin-stats/creator-economy.webp' },
];

const ecosystem = [
  { name: 'For You Feed', chineseName: '推荐页', description: 'Der algorithmusgetriebene Feed. Follower-Zahlen spielen kaum eine Rolle. Ein gestern gestartetes Konto kann mit dem richtigen Video die Million Views knacken.', image: '/images/platforms/douyin-ecosystem/for-you-feed.webp', bg: '#1A1A1A', iconBg: 'rgba(255,255,255,0.1)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.6)', linkColor: '#CC3333', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>` },
  { name: 'Live Commerce', chineseName: '直播电商', description: 'Verkauf live, nativ in der App. Host, Produkt-Skript, Echtzeit-Interaktion mit den Zuschauern. Manche Marken bringen mehrere Millionen Menschen in einen einzigen Stream.', image: '/images/platforms/douyin-ecosystem/live-commerce.webp', bg: '#CC3333', iconBg: 'rgba(255,255,255,0.2)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.8)', linkColor: '#FFFFFF', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>` },
  { name: 'Douyin Shop', chineseName: '抖音商城', description: 'Der native Shop in der App. Nutzer suchen, vergleichen und kaufen, ohne Douyin zu verlassen. Jedes Video und jeder Livestream verlinkt direkt zur Produktseite.', image: '/images/platforms/douyin-ecosystem/douyin-shop.webp', bg: '#F7F2EE', iconBg: '#E8E0D8', textColor: '#1A1A1A', descColor: '#5C5C5C', linkColor: '#CC3333', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>` },
  { name: 'Ocean Engine', chineseName: '巨量引擎', description: 'ByteDances Werbeplattform. TopView für große Launches, In-Feed Ads für täglichen Traffic, Search Ads für kaufbereite Nutzer, DOU+ zum Validieren von Inhalten. Budget zum echten Preis durchgereicht, ohne versteckte Marge.', image: '/images/platforms/douyin-ecosystem/ocean-engine.webp', bg: '#1A1A1A', iconBg: 'rgba(255,255,255,0.1)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.6)', linkColor: '#CC3333', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>` },
  { name: 'Xingtu', chineseName: '星图', description: 'Der offizielle Creator-Marktplatz auf Douyin. Wir identifizieren passende Profile, jagen Fake-Follower, prüfen frühere Kampagnen. Sie geben die Auswahl frei, bevor irgendetwas anläuft.', image: '/images/platforms/douyin-ecosystem/xingtu.webp', bg: '#E8E0D8', iconBg: '#FFFFFF', textColor: '#1A1A1A', descColor: '#5C5C5C', linkColor: '#CC3333', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>` },
  { name: 'DOU+', chineseName: '抖加', description: 'Das native Tool, um ein Video auf einer breiteren Zielgruppe zu testen. Ein kleines Budget genügt für die ersten Signale. Zieht die Reaktion an, beschleunigen wir; sonst wechseln wir das Asset.', image: '/images/platforms/douyin-ecosystem/dou-plus.webp', bg: '#B02D2D', iconBg: 'rgba(255,255,255,0.2)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.8)', linkColor: '#FFFFFF', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>` },
];

const services = [
  { title: 'Konteneröffnung und Strategie', description: 'Wir eröffnen und zertifizieren Ihr Unternehmenskonto, regeln die Compliance-Formalitäten und bauen Ihre Redaktionsstrategie. Content-Säulen, Kalender, Wochentakt, Zielwerte.', result: 'Ein zertifiziertes, einsatzbereites Douyin-Konto mit präzisem Fahrplan.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`, image: '/images/platforms/douyin-services/setup-strategy.webp' },
  { title: 'Content-Produktion', description: 'Für Douyin gemachte Videos, gedreht von unserem Team in China. Produktdemos, Lifestyle-Sequenzen, Tutorials, Backstage, Mini-Dramas. HubStudio.ai übernimmt Visuals und erste Drafts. Unsere Muttersprachler gehen jeden Output gegen.', result: 'Kurzvideos, lokal gedacht, auf Douyin zugeschnitten.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`, image: '/images/platforms/douyin-services/content-production.webp' },
  { title: 'Live Commerce', description: 'Wir bereiten Ihre Verkaufs-Livestreams vor und moderieren sie. Host-Auswahl, Produkt-Skript, Echtzeit-Interaktion mit der Zielgruppe, gezielte Auswertung nach jedem Stream. Gedacht für Launches, Höhepunkte und wiederkehrende Verkäufe.', result: 'Livestreams, die Zuschauer in Käufer verwandeln.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>`, image: '/images/platforms/douyin-services/live-commerce.webp' },
  { title: 'KOL- und KOC-Kampagnen', description: 'Wir identifizieren Creator über Xingtu und unser über die Jahre gepflegtes Feldnetzwerk. Jedes Profil wird durchleuchtet: Fake-Follower, Kampagnenhistorie, Markenpassung. Sie geben die Auswahl frei, bevor wir starten.', result: 'Influencer-Kampagnen mit echtem Engagement und messbaren Ergebnissen.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`, image: '/images/platforms/douyin-services/kol-campaigns.webp' },
  { title: 'Werbung', description: 'Werbung über Ocean Engine, ByteDances Plattform. TopView für große Launches, In-Feed Ads für täglichen Traffic, Search Ads für kaufbereite Nutzer, DOU+ zum Testen, Branded Effects zur Community-Aktivierung. Budget zum echten Preis weitergegeben.', result: 'Zielgerichtete Kampagnen mit transparentem Zeilen-Reporting.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`, image: '/images/platforms/douyin-services/advertising.webp' },
  { title: 'Douyin Shop', description: 'Ihr Shop in der App, mit allem anderen verbunden. Wir übernehmen Setup, Produktseiten, Pricing und laufende Optimierung. Jedes Video und jeder Livestream, den wir produzieren, führt direkt zu Ihren Produkten.', result: 'Ein Shop, der Zuschauer reibungslos zu Kunden macht.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`, image: '/images/platforms/douyin-services/douyin-shop.webp' },
];

const bestPractices = [
  { title: 'Alles entscheidet sich in der ersten Sekunde.', description: 'Öffnen Sie mit Bewegung, einer Frage, einem Visual, das den Blick hält. Niemals mit einem Logo. Der Zuschauer steigt aus, bevor er die Botschaft erfasst hat.' },
  { title: 'Vertikal, ohne Ausnahme. Format 9:16.', description: 'Ein Video, das nach recyceltem TV-Spot aussieht, findet kein Publikum. Douyin wird vertikal konsumiert, ohne Diskussion.' },
  { title: 'Drei bis fünf Veröffentlichungen pro Woche, mindestens.', description: 'Der Algorithmus belohnt Konstanz. Eine Woche Pause und die Reichweite bricht spürbar ein.' },
  { title: 'Die vollständige Ansicht bleibt das entscheidende Signal.', description: 'Der Algorithmus misst zuerst den Anteil der Zuschauer, die bis zum Ende dranbleiben. Jede Sekunde, die die nächste nicht verdient, gehört geschnitten.' },
  { title: 'Trends halten nur einen Moment.', description: 'Wir verfolgen jeden Morgen aufkommende Sounds, Hashtags und Formate. Einen Trend zu Beginn zu erwischen, vervielfacht die Reichweite manchmal um das Zehn-, manchmal Hundertfache.' },
  { title: 'Das Produkt kommt nach dem Interesse, nie davor.', description: 'Frontaler Verkauf funktioniert auf Douyin nicht. Was zieht, informiert zuerst, unterhält manchmal. Das Produkt folgt, in dieser Reihenfolge.' },
  { title: 'Der Ton wiegt so schwer wie das Bild.', description: 'Douyin wird nicht stumm geschaut. Musik, Voice-over, klangliche Signatur: alles ebenso entscheidend wie das, was auf dem Bildschirm läuft.' },
  { title: 'Auf Mandarin verfasst, niemals übersetzt.', description: 'Aus dem Englischen übersetzter Content hebt nicht ab. Unsere Muttersprachler schreiben direkt auf Mandarin, in einem Register, das stimmt.' },
];

const steps = [
  { number: '01', title: 'Erstgespräch.', description: 'Sie stellen uns Ihre Marke, Ihre Ziele und Ihre aktuelle Lage in China vor. Kein Verkaufspitch, nur die richtigen Fragen.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>` },
  { number: '02', title: 'Angebot.', description: 'Präziser Umfang, fester Preis. Jedes Leistung schriftlich detailliert. Sie wissen, was Sie bekommen, bevor Sie unterschreiben.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>` },
  { number: '03', title: 'In zwei Wochen live.', description: 'Konten konfiguriert, erstes Video veröffentlicht. Fünfzehn Tage zwischen Unterschrift und Go-Live.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>` },
];

const faqs = [
  { q: 'Wer steuert unser Konto im Alltag?', a: 'Unser Team in China. Muttersprachliche Redakteure, die jeden Tag Content auf Douyin produzieren und Kampagnen steuern. Ein dedizierter Account-Lead kennt Ihre Marke in der Tiefe.' },
  { q: 'Braucht es eine chinesische Geschäftslizenz?', a: 'Für ein Unternehmenskonto braucht es entweder eine chinesische Lizenz oder den Weg über eine autorisierte Agentur. Wir decken beide Fälle ab. Sie können posten und Werbung ausspielen, ohne eine lokale Einheit zu gründen.' },
  { q: 'Was unterscheidet TheRedScroll?', a: 'Klarer Leistungsumfang, Festpreis. Team vor Ort in China. KI-gestützte Produktion, gegengelesen von Muttersprachlern. Wir haben 37 Agenturen der Branche analysiert: keine bietet Festpreis-Pakete.' },
  { q: 'Wie lange bis zu Ergebnissen?', a: 'Die meisten Marken sehen erste Traktion zwischen acht und zwölf Wochen. Paid-Kampagnen können in wenigen Tagen liefern. Hängt von Kategorie und Ambitionsniveau ab.' },
  { q: 'Was kostet es?', a: 'Festpreis-Pakete mit aufgeschlüsselten Leistungen. Mediabudget wird separat zum echten Preis abgerechnet. Keine versteckte Marge. Vereinbaren Sie ein Gespräch, wir lotsen Sie zum passenden Modell.' },
  { q: 'Können wir ohne Einheit in China werben?', a: 'Ja. Internationale Marken werben über unsere Struktur, als autorisierte Agentur. Keine lokale Einheit erforderlich.' },
  { q: 'Welche Content-Formate produzieren Sie?', a: 'Produktdemos, Lifestyle-Videos, Tutorials, Mini-Dramas, KOL-Kooperationen, Verkaufs-Livestreams. Alles auf Mandarin, von unserem Team in China. KI hält den Takt, ein menschliches Auge gibt jede Leistung frei.' },
  { q: 'Wie wählen Sie die KOLs aus?', a: 'Über Xingtu und unser eigenes Netzwerk. Jeder Creator wird durchleuchtet: Fake-Follower, Engagement-Qualität, demografische Daten, Markenpassung. Sie geben die finale Liste frei. Nichts läuft ohne Ihre Zustimmung.' },
  { q: 'Können Sie einen Douyin Shop aufsetzen?', a: 'Ja. Einrichtung, Produktseiten, Pricing, laufende Optimierung. Alles verzahnt mit Ihrer Content-Strategie, damit jedes Video zu Ihren Produkten führt.' },
  { q: 'Wie sehen Ihre Berichte aus?', a: 'Monatlich. Klare Zahlen. Follower, Views, Engagement, ROAS, Abschlüsse. Was funktioniert hat, was nicht, was wir im nächsten Monat justieren.' },
];
---

<PageLayout
  title="Douyin-Marketing aus Shanghai gesteuert | TheRedScroll"
  description="Douyin-Marketing aus Shanghai gesteuert. Konteneröffnung, Content, Werbung, Live Commerce, KOL-Kampagnen. Klarer Leistungsumfang, Festpreis. 750 Millionen täglich aktive Nutzer."
  lang="de"
>
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/douyin-hero.webp')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">抖音</span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/de/platforms/others/" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">&larr; Alle Plattformen</a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">Douyin-Marketing</p>
        <UpdatedDate lang="de" date="Mai 2026" variant="light" class="mb-[8px]" />
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">750 Millionen tägliche Nutzer. Eine Plattform. Wir posten dort jeden Tag.</h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">Douyin-Marketing aus Shanghai gesteuert. Konteneröffnung, Content, Werbung, Live Commerce, KOL-Kampagnen. Klarer Leistungsumfang, Festpreis, Team vor Ort.</p>
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
      </div>
    </Container>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">Mehr als eine Kurzvideo-App. Chinas wichtigster eCommerce-Kanal.</h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">Douyin in Zahlen.</p>
        </div>
        <Button variant="primary" href="/de/contact/" class="shrink-0">Gespräch vereinbaren</Button>
      </div>
    </Container>
    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>
      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none" data-stat-index={i}>
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]"><SectionBar /></div>
        <SectionHeading overline="Warum Douyin zählt">Algorithmus, Content, Commerce. Auf Douyin spielt alles zusammen.</SectionHeading>
      </div>
      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden"><img src="/images/platforms/douyin-why/algorithm.webp" alt="Douyin-For-You-Feed-Algorithmus" class="w-full h-full object-cover" loading="lazy" decoding="async" /></div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Der schnellste Algorithmus Chinas</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">Die Follower-Zahl spielt kaum eine Rolle. Ein gestern gestartetes Konto kann morgen Millionen Views haben. Der Algorithmus zeigt Inhalte den Nutzern, die sie sehen wollen, nicht denen, die der Marke folgen.</p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden"><img src="/images/platforms/douyin-why/commerce.webp" alt="In-App-Commerce auf Douyin mit Produktverkäufen via Livestream" class="w-full h-full object-cover" loading="lazy" decoding="async" /></div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Commerce in die App eingebaut</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">Vom Video zum Kauf in unter 30 Sekunden. Douyin Shop, Live Commerce, Produktkarten in Videos. Konsumenten verlassen die App nicht, um zu kaufen.</p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
          <div class="w-full aspect-[16/9] overflow-hidden"><img src="/images/platforms/douyin-why/creator.webp" alt="Creator und Trends auf Douyin" class="w-full h-full object-cover" loading="lazy" decoding="async" /></div>
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">Creator und Trends im Sekundentakt</h3>
            <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">15 Millionen aktive Creator. Trends, die in Stunden hochkommen. Marken, die mit dem richtigen Sound oder Format einsteigen, multiplizieren die Reichweite ohne Mehrkosten.</p>
          </div>
        </div>
      </div>
