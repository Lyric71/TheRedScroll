---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import UpdatedDate from '../../../components/ui/UpdatedDate.astro';

const stats = [
  { label: 'Monatlich aktive Nutzer', value: '350M+', image: '/images/platforms/rednote-stats/monthly-active-users.webp' },
  { label: 'Note-Views pro Tag', value: '9.12B', image: '/images/platforms/rednote-stats/daily-post-views.webp' },
  { label: 'Suchanfragen pro Monat', value: '1B+', image: '/images/platforms/rednote-stats/monthly-search-queries.webp' },
  { label: 'Der Nutzer sind 18 bis 35 Jahre alt', value: '70%', image: '/images/platforms/rednote-stats/users-aged-18-35.webp' },
  { label: 'Content von den Nutzern selbst', value: '90%', image: '/images/platforms/rednote-stats/user-generated-content.webp' },
  { label: 'Conversion-Rate für ausländische Marken', value: '21.4%', image: '/images/platforms/rednote-stats/conversion-rate.webp' },
  { label: 'Minuten auf der Plattform pro Tag', value: '55 min', image: '/images/platforms/rednote-stats/daily-time-per-user.webp' },
  { label: 'Nutzer, die monatlich Kaufberatung suchen', value: '200M+', image: '/images/platforms/rednote-stats/purchase-advice-users.webp' },
];

const whyEssential = [
  { title: 'Hier fallen in China die Kaufentscheidungen', description: 'Über 60 % der Nutzer öffnen zuerst die Suchleiste. Sie suchen Reviews, Erfahrungsberichte. RedNote ist ihr erster Reflex vor dem Kauf.', image: '/images/platforms/rednote-why/purchase-decision.webp' },
  { title: 'Vertrauen vor allem anderen', description: 'Der Algorithmus belohnt Authentizität und bestraft getarnte Werbung. Ein Speichern oder ein Kommentar wiegt unendlich schwerer als ein bloßer „Gefällt mir".', image: '/images/platforms/rednote-why/trust-distribution.webp' },
  { title: 'Eine Zielgruppe mit Kaufkraft', description: 'Jung, urban, wohlhabend. Konzentriert in Tier-1- und Tier-2-Städten. Sie weiß, was sie will, und hat die Mittel dafür.', image: '/images/platforms/rednote-why/spending-power.webp' },
  { title: 'Vom Content zum Kauf, ohne die App zu verlassen', description: 'Entdecken, vergleichen, testen, kaufen. Der gesamte Weg läuft drinnen. Keine Umleitung, keine Friktion.', image: '/images/platforms/rednote-why/social-commerce.webp' },
];

const algorithm = [
  { title: 'Verbreitung in Stufen', description: 'Jede neue Note wird zunächst 100 bis 500 Nutzern ausgespielt. Springt das Engagement in den ersten 24 Stunden an, erweitert die Plattform die Verbreitung in aufeinanderfolgenden Wellen, bis zu hunderttausenden Views.', image: '/images/platforms/rednote-algorithm/staged-distribution.webp', bg: '#F7F2EE', iconBg: '#E8E0D8', textColor: '#1A1A1A', descColor: '#5C5C5C', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>` },
  { title: 'Der CES-Score', description: 'Ein Abo zählt 8 Punkte. Ein Kommentar oder ein Share, 4. Ein „Gefällt mir" oder ein Speichern, 1. Was zählt, ist das tiefe Engagement. „Gefällt mir" anzuhäufen führt nirgendwohin.', image: '/images/platforms/rednote-algorithm/ces-scoring.webp', bg: '#1A1A1A', iconBg: 'rgba(255,255,255,0.1)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.6)', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>` },
  { title: 'Authentizität als Spielregel', description: 'Zu kommerzieller Content, gefälschte Reviews, Automatisierung: die Plattform sanktioniert ohne Vorwarnung. Die einzig dauerhafte Sichtbarkeit baut sich Note für Note auf, mit Disziplin.', image: '/images/platforms/rednote-algorithm/authenticity-enforced.webp', bg: '#CC3333', iconBg: 'rgba(255,255,255,0.2)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.8)', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>` },
  { title: 'Zwei Motoren, eine Strategie', description: 'Jede Note arbeitet an zwei Fronten: der Explore-Feed, der empfiehlt, und die Suche, die Kaufabsicht abfängt. Eines speist das andere. Man entscheidet sich nicht zwischen beiden.', image: '/images/platforms/rednote-algorithm/dual-engine.webp', bg: '#E8E0D8', iconBg: '#FFFFFF', textColor: '#1A1A1A', descColor: '#5C5C5C', icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>` },
];

const services = [
  { title: 'Konteneröffnung und Verifizierung', description: 'Anmeldung des Professional Account (Blue V), Übersetzung der Geschäftslizenz, Aufbau der Markenakte, Compliance. Wir übernehmen sämtliche Formalitäten und ersparen Ihnen mehrere Monate Wartezeit.', result: 'Ein verifiziertes, aktives RedNote-Konto, publikationsbereit.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`, image: '/images/platforms/rednote-services/account-setup.webp' },
  { title: 'Strategie und redaktionelle Produktion', description: 'Redaktionelle Säulen, Veröffentlichungskalender, Formate, gemacht für die Plattform. Visuals produziert mit HubStudio.ai. Drehs in China. Mandarin-Texte von Muttersprachlern, mit echter kultureller Anpassung.', result: 'Content, gedacht für die RedNote-Mechanik, nicht für Instagram.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`, image: '/images/platforms/rednote-services/content-strategy.webp' },
  { title: 'KOL- und KOC-Kampagnen', description: 'Vollsteuerung über Pugongying, die offizielle RedNote-Plattform. Creator-Auswahl, Fake-Follower-Erkennung, Co-Kreation des Contents, präzises ROI-Reporting.', result: 'Kooperationen mit verifizierten Creatorn und Ergebnissen ohne Grauzonen.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`, image: '/images/platforms/rednote-services/kol-koc.webp' },
  { title: 'Bezahlte Werbung', description: 'In-Feed Ads, Search Ads, Vollsteuerung von Juguang, Juguang Lite und Chengfeng auf der eCommerce-Seite. Kreativ-Tests, Gebotsjustierung, Echtzeit-Entscheidungen. Mediabudget wird separat zum echten Preis abgerechnet.', result: 'Zielgerichtete Kampagnen mit Ausgaben-Reporting, das nichts verbirgt.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`, image: '/images/platforms/rednote-services/paid-advertising.webp' },
  { title: 'eCommerce und Live Commerce', description: 'Aufsetzen des In-App-Shops, interaktive Notes mit Kauf-Links, Produktion der Live-Sessions. Live Commerce trägt 90 % der innerhalb von RedNote abgeschlossenen Verkäufe.', result: 'Ein in RedNote integrierter Shop, in dem jede Note den Nutzer bis zum Warenkorb führt.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`, image: '/images/platforms/rednote-services/ecommerce-live.webp' },
  { title: 'Analytics und Listening', description: 'Dashboards zu Wachstum, Engagement, Suchpositionen und Kampagnen-ROI. Markenbeobachtung, Sentiment-Analyse, Trend-Erkennung, Wettbewerbsbeobachtung.', result: 'Klare Reports darüber, was funktioniert und was zu korrigieren ist.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`, image: '/images/platforms/rednote-services/analytics-listening.webp' },
];

const bestPractices = [
  { title: 'Schreiben Sie für RedNote, nicht für Instagram.', description: 'Dichte, nützliche, im Alltag verankerte Notes stechen hervor. Tutorials, ehrliche Reviews und Praxisleitfäden schlagen zu glatte Markenkampagnen.' },
  { title: 'Cover und Titel mit Sorgfalt.', description: 'Alles entscheidet sich in den ersten Sekunden. Klarer Titel, nutzen-orientiert, mit den Keywords, die zählen. Sauberes Visual, gut lesbarer Overlay-Text.' },
  { title: 'Denken Sie wie eine Suchmaschine.', description: 'RedNote verhält sich beim Einkauf wie Google. Identifizieren Sie aufkommende Keywords, richten Sie Ihre Titel an echten Anfragen aus, nutzen Sie das native Hashtag-Vorschlagstool.' },
  { title: 'Lösen Sie Speichern und Kommentare aus.', description: 'Beenden Sie jede Note mit einer Frage oder einem Grund, sie zu favorisieren. Beide Aktionen füttern den CES-Score, der die Verbreitung steuert.' },
  { title: 'Bleiben Sie in der App.', description: 'RedNote bestraft ausgehende Links. Halten Sie den Nutzer drinnen. Ein In-App-Shop konvertiert besser als eine Weiterleitung auf eine externe Website.' },
  { title: 'Halten Sie den Takt.', description: 'Über 180 Tage kontinuierlicher Aktivität gewährt die Plattform einen Sichtbarkeits-Bonus. Definieren Sie Ihre Säulen, dann veröffentlichen Sie ohne Unterbrechung.' },
];

const industries = [
  { title: 'Beauty und Kosmetik', description: 'Die dominierende Kategorie der Plattform. Produkt-Reviews, Make-up-Tutorials, Inhaltsstoff-Analysen.' },
  { title: 'Mode und Bekleidung', description: 'Styling-Tipps, aktuelle Trends, saisonale Lookbooks, KOC-Seeding-Kampagnen.' },
  { title: 'Luxus', description: 'Markenerzählungen, geschliffen für eine wohlhabende Zielgruppe, die oft kurz vor dem Kauf steht.' },
  { title: 'Food und Getränke', description: 'Restaurant-Kritiken, Rezepte, Live-Tastings.' },
  { title: 'Reise und Hotellerie', description: 'Destinationsguides, Hotelbewertungen. 64 % der chinesischen Reisenden bereiten ihren Aufenthalt auf RedNote vor.' },
  { title: 'Gesundheit und Wellness', description: 'Fitness, Nahrungsergänzung, Gesundheitsratgeber. Eine der am schnellsten wachsenden Kategorien.' },
  { title: 'B2B', description: 'Über 100 Berufsbranchen auf RedNote vertreten. Entscheider nutzen sie, um Lieferanten und Dienstleister zu identifizieren.' },
];

const steps = [
  { number: '01', title: 'Erstgespräch.', description: 'Wir sprechen über Ihre Marke, Ihre Ziele, Ihren Reifegrad für den chinesischen Markt. Kein Verkaufspitch, nur die Fragen, die zählen.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>` },
  { number: '02', title: 'Angebot.', description: 'Klarer Leistungsumfang, Festpreis, jede Leistung schwarz auf weiß. Vor der Unterschrift wissen Sie genau, was Sie bekommen und was es kostet.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>` },
  { number: '03', title: 'In zwei Wochen live.', description: 'Konto eröffnet, Strategie steht, erste Notes veröffentlicht. Fünfzehn Tage trennen die Unterschrift von Ihrer ersten Veröffentlichung.', icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>` },
];

const faqs = [
  { q: 'Wo befindet sich Ihr Team?', a: 'In Shanghai und Hongkong. Muttersprachliche chinesische Redakteure, permanent in die großen Plattformen eingeloggt. Wir veröffentlichen jeden Tag auf RedNote, steuern die Werbekonten von innen und arbeiten direkt mit KOLs überall in China. Das ist keine Fernberatung.' },
  { q: 'Kann man ohne juristische Einheit in China auf RedNote präsent sein?', a: 'Ja. RedNote erlaubt ausländischen Unternehmen, einen Professional Account (Blue V) auf Basis einer übersetzten Geschäftslizenz und einer Markenakte zu eröffnen. Wir übernehmen Formalitäten, Einreichung und Austausch mit dem Validierungsteam von RedNote. Die meisten Konten sind in weniger als zwei Wochen aktiv.' },
  { q: 'Wann zeigen sich Ergebnisse?', a: 'RedNote belohnt keine Hektik. Jedes neue Konto durchläuft zuerst eine algorithmische Beobachtungsphase. Die ersten zwei bis drei Monate dienen dem Aufbau Ihres Content-Katalogs und dem Lernprozess der Plattform über Ihre Marke. Paid-Werbung und KOL-Kampagnen können dagegen ab der ersten Woche Traffic erzeugen, bis das organische Wachstum übernimmt.' },
  { q: 'Was bekommen wir konkret jeden Monat?', a: 'Alles wird vor der Unterschrift vertraglich festgehalten. Notes, Videos, Werbekampagnen, KOL-Aktivierungen, Monatsberichte. Sie lesen und geben jeden Inhalt vor dem Live-Gang frei. Keine Grauzone. Keine Überraschung am Monatsende.' },
  { q: 'Wie funktioniert die Preisgestaltung?', a: 'Eine feste Monatspauschale deckt den vereinbarten Umfang. Das Mediabudget wird separat zum echten Preis abgerechnet, jede Ausgabe sichtbar. Wir behalten keine Provision auf den Mediaeinkauf. Der Angebotsbetrag ist der Betrag, den Sie zahlen.' },
  { q: 'Wer produziert die Inhalte, und wer übernimmt die Kontrolle?', a: 'Strategie und Redaktion liegen bei unserem Team in Shanghai. KI-Visuals laufen über HubStudio.ai, trainiert auf Ihren Markenrichtlinien. Foto- und Videodrehs erfolgen in China. Vor jeder Veröffentlichung prüft ein muttersprachlicher Editor: Ton, kulturelle Relevanz, Plattform-Compliance.' },
  { q: 'Wie wählen Sie KOLs für unsere Marke aus?', a: 'Über Pugongying, die offizielle RedNote-Plattform, mit über 100.000 verifizierten Creatorn. Jeder vorselektierte KOL wird auf Zielgruppe verifiziert, auf Fake-Follower geprüft und nach Engagement-Qualität bewertet. Anschließend gleichen wir Nische, Tonalität und Budget ab.' },
  { q: 'Können Sie RedNote-Werbung für ein Unternehmen außerhalb Chinas schalten?', a: 'Ja, unter einer Bedingung. Die RedNote-Plattform Juguang verlangt eine chinesische Rechtseinheit für die Eröffnung eines Werbekontos. Wir eröffnen und steuern diese Konten für unsere ausländischen Kunden über unsere lokale Struktur. Sie erhalten einen Wochenreport und vollständige Sicht auf die Performance.' },
  { q: 'Was ist die Mindestlaufzeit?', a: 'Drei Monate. Diese Zeit braucht es, um die Algorithmus-Einlaufphase zu durchlaufen und genug Daten zu sammeln, um zu verstehen, was funktioniert. Die meisten Kunden verlängern, sobald die ersten Kurven sich bewegen.' },
  { q: 'Wir sprechen kein Chinesisch. Ein Problem?', a: 'Nein. Die gesamte Kundenbeziehung läuft auf Englisch: Strategie-Calls, Monatsberichte, Content-Freigaben. Das Team ist vollständig zweisprachig. Sie konzentrieren sich auf Ihre Marke, wir kümmern uns um die Plattform.' },
];
---

<PageLayout
  title="RedNote/Xiaohongshu-Marketing-Agentur | TheRedScroll"
  description="TheRedScroll steuert RedNote-Konten aus Shanghai. Redaktionsstrategie, KOL-Kampagnen, bezahlte Werbung, eCommerce, Analytics. Klarer Leistungsumfang, Festpreis."
  lang="de"
>
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/rednote-hero.webp')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">小红书</span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/de/platforms/others/" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">&larr; Alle Plattformen</a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">RedNote-Marketing</p>
        <UpdatedDate lang="de" date="Mai 2026" variant="light" class="mb-[8px]" />
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">Die chinesische Plattform der Produktentdeckung. 350 Millionen Nutzer. Der erste Reflex vor jedem Kauf.</h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.85)] font-normal leading-[1.6] mb-[12px]">RedNote, auf Chinesisch bekannt als Xiaohongshu (小红书 / Little Red Book), ist die Social-Commerce-Plattform, auf der sich chinesische Konsumenten vor dem Kauf informieren. 70 % der Nutzer sind zwischen 18 und 35, leben in Tier-1- und Tier-2-Städten und verfügen über überdurchschnittliche Kaufkraft.</p>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">Wir betrachten RedNote nicht von außen. Wir posten dort jeden Tag, aus Shanghai.</p>
        <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
      </div>
    </Container>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">Keine Zahlen zum Beeindrucken. Hier werden die Kaufentscheidungen getroffen.</h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">RedNote in Zahlen.</p>
        </div>
        <Button variant="primary" href="/de/contact/" class="shrink-0">Gespräch vereinbaren</Button>
      </div>
    </Container>
    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>
      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none" data-stat-index={i}>
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]"><SectionBar /></div>
        <SectionHeading overline="Warum RedNote unumgänglich ist">Ohne Präsenz auf RedNote fehlt Ihre Marke genau dort, wo der chinesische Konsument entscheidet, was er kaufen wird.</SectionHeading>
      </div>
      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {whyEssential.map((item) => (
          <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
            <div class="w-full aspect-[16/9] overflow-hidden"><img src={item.image} alt={item.title} class="w-full h-full object-cover" loading="lazy" decoding="async" /></div>
            <div class="p-[24px] max-[640px]:p-[20px]">
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">{item.title}</h3>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.5] mt-[24px] text-center max-w-[680px] mx-auto">RedNote, oder Xiaohongshu, ist der Ort, an dem sich chinesische Konsumenten informieren, vergleichen und entscheiden. Community-Content, Peer-Vertrauen, In-App-Commerce: alles auf einer Plattform.</p>
    </Container>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]"><SectionBar /></div>
        <SectionHeading overline="So funktioniert der Algorithmus">Wie entscheidet der RedNote-Algorithmus, was er ausspielt?</SectionHeading>
