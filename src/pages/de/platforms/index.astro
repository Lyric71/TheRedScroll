---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import Button from '../../../components/ui/Button.astro';
import GettingStarted from '../../../components/sections/GettingStarted.astro';

const platforms = [
  {
    title: 'WeChat',
    stat: '1,4 Milliarden Nutzer pro Monat',
    description: 'Official Accounts, Mini Programs, Channels, WeCom, WeChat Pay. Die Super-App, die Chinas Alltag taktet, vom ersten Kaffee bis zur letzten Nachricht am Abend.',
    href: '/de/platforms/wechat',
    logo: '/images/platforms/wechat-logo.svg',
  },
  {
    title: 'RedNote / Xiaohongshu',
    stat: '300 Millionen Nutzer pro Monat',
    description: 'Die Mundpropaganda junger Städterinnen. Reviews, Tutorials, shoppbare Notes: hier wird vor jedem Kauf nachgesehen.',
    href: '/de/platforms/rednote',
    logo: '/images/platforms/rednote-logo.svg',
  },
  {
    title: 'Douyin',
    stat: '800 Millionen Nutzer pro Tag',
    description: 'Kurzvideo, Live-Verkauf, In-Feed-Werbung. Der kürzeste Weg zwischen dem Erscheinen eines Produkts auf dem Bildschirm und seiner Bezahlung.',
    href: '/de/platforms/douyin',
    logo: '/images/platforms/douyin-logo.svg',
  },
  {
    title: 'Weibo',
    stat: '605 Millionen Nutzer pro Monat',
    description: 'Der öffentliche Platz des Landes. PR, Trendthemen, Influencer-Kampagnen: die großen Markenmomente spielen sich hier ab.',
    href: '/de/platforms/weibo',
    logo: '/images/platforms/weibo-logo.svg',
  },
  {
    title: 'Weitere Plattformen',
    stat: '14 ergänzende Plattformen',
    description: 'Bilibili, Kuaishou, Zhihu, Toutiao, Meituan, Dianping, Pinduoduo, QQ und einige andere. Unsere Abdeckung lässt keinen blinden Fleck.',
    href: '/de/platforms/others',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
  },
];

const gettingStartedSteps = [
  {
    title: 'Erstgespräch.',
    description: 'Ihre Marke, Ihre Ziele, Ihr Reifegrad für den chinesischen Markt. Kein Verkaufspitch, nur die richtigen Fragen.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  },
  {
    title: 'Angebot.',
    description: 'Klarer Umfang. Fester Preis. Jedes Deliverable schwarz auf weiß. Sie wissen genau, worauf Sie sich einlassen, bevor Sie unterschreiben.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  },
  {
    title: 'In zwei Wochen live.',
    description: 'Strategie übergeben, Kampagnen aufgesetzt, erste Inhalte veröffentlicht. Vierzehn Tage nach Vertragsschluss läuft die Maschine.',
    icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
];
---

<PageLayout
  title="Chinas soziale Plattformen | TheRedScroll"
  description="WeChat, RedNote, Douyin, Weibo und vierzehn weitere chinesische Plattformen. Praxis-Guides, Audience-Zahlen, Feldberichte für internationale Marken."
  lang="de"
>

  <!-- Hero -->
  <section class="relative w-full overflow-hidden bg-[var(--color-ink)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/platforms-hero.png')" aria-hidden="true"></div>
    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Plattformen
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Die Plattformen, auf denen Ihre Audience längst zu Hause ist.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Vier Leitplattformen, vierzehn flankierende. Jede mit eigenen Codes, eigenem Publikum, eigenen Spielregeln. Wir bewegen uns auf allen täglich.
      </p>
      <div class="flex flex-wrap justify-center gap-[12px]">
        <Button href="/de/pricing" variant="primary">Preise ansehen</Button>
        <Button href="#all-platforms" variant="secondary-dark">Plattformen durchsehen</Button>
      </div>
    </div>
  </section>

  <!-- Platform cards grid -->
  <section id="all-platforms" class="py-[96px] max-[640px]:py-[64px]">
    <Container>
      <div class="max-w-[680px] mb-[48px]">
        <SectionBar />
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">
          Unser Aktionsradius
        </p>
        <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[12px]">
          Alle Plattformen, die für eine Marke in China zählen.
        </h2>
        <p class="text-[16px] font-normal leading-[1.5] text-[var(--color-stone)]">
          Verschiedene Publika, eigene Formate je Plattform, Regeln, die sich von App zu App nicht ähneln. Wir steuern Kampagnen auf jeder einzelnen, Tag für Tag.
        </p>
      </div>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[24px]">
        {platforms.map((platform) => (
          <a
            href={platform.href}
            class="group block bg-[var(--color-rice-paper)] rounded-[12px] p-[32px] max-[640px]:p-[24px] transition-colors duration-[0.15s] hover:bg-[#F0EAE4]"
          >
            <div class="w-[56px] h-[56px] rounded-[12px] bg-[var(--color-ink)] flex items-center justify-center mb-[20px]">
              {platform.logo ? (
                <img src={platform.logo} alt={platform.title} width="28" height="28" style="filter: brightness(0) invert(1);" />
              ) : (
                <span class="text-[#FFFFFF]"><Fragment set:html={platform.icon} /></span>
              )}
            </div>
            <h3 class="text-[20px] max-[640px]:text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">
              {platform.title}
            </h3>
            <p class="text-[13px] font-medium text-[var(--color-vermillion)] mb-[8px]">
              {platform.stat}
            </p>
            <p class="text-[15px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[16px]">
              {platform.description}
            </p>
            <span class="inline-flex items-center gap-[6px] text-[14px] font-medium text-[var(--color-vermillion)]">
              Plattform-Steckbrief
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-[0.15s] group-hover:translate-x-[4px]">
                <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Getting started -->
  <GettingStarted
    lang="de"
    heading="Vom ersten Anruf bis zu den ersten Live-Kampagnen vergehen zwei Wochen."
    steps={gettingStartedSteps}
    backgroundImage="/images/team/china-office.png"
  />

</PageLayout>
