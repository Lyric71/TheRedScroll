---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 1.4, decimals: 1, suffix: ' Mrd.', label: 'aktive Nutzer pro Monat' },
  { value: 945, decimals: 0, suffix: ' Mio.', label: 'Menschen nutzen monatlich Mini Programs' },
  { value: 18, decimals: 0, suffix: '', label: 'chinesische Plattformen, die wir betreuen' },
  { value: 4, decimals: 0, suffix: ' Wochen', label: 'von der Unterschrift bis zum ersten Beitrag' },
];

const scopeItems = [
  { label: 'Official Account eröffnen und verifizieren', href: '/de/platforms/wechat/' },
  { label: 'Content von chinesischen Muttersprachlern', href: '/de/services/content-production/' },
  { label: 'Moments Ads, Official Account Ads, Mini-Program Ads', href: '/de/services/advertising/' },
  { label: 'Mini Programs und eCommerce in WeChat', href: '/de/platforms/wechat/' },
  { label: 'WeCom-CRM und Private-Domain-Traffic', href: '/de/services/crm-private-domain/' },
];

const services = [
  {
    glyph: '号',
    title: 'Official Account eröffnen und verifizieren',
    tag: 'Live in ein bis zwei Wochen',
    description:
      'Wir melden Ihren Service Account an, stellen die Unterlagen für Tencent zusammen und begleiten die Verifizierung bis zur Freigabe. Menüs, automatische Antworten und Markenauftritt richten wir direkt mit ein. Die meisten Konten sind nach ein bis zwei Wochen live.',
    deliverables: ['Registrierung', 'Tencent-Verifizierung', 'Menüs und automatische Antworten', 'Markenauftritt'],
    image: '/images/wechat-agency/service-setup.webp',
    imageAlt: 'Smartphone neben Registrierungsunterlagen auf einem Schreibtisch, im Display das verifizierte Markenprofil eines WeChat Official Account',
  },
  {
    glyph: '文',
    title: 'Content und CRM',
    tag: 'Getextet von chinesischen Muttersprachlern',
    description:
      'Redaktionelle Säulen, Themenplan, Artikel, Grafiken und Video, geschrieben von chinesischen Muttersprachlern statt von Übersetzern. Jeden neuen Follower führen wir in WeCom weiter. So wächst eine Kundenliste, die Ihnen keine Plattform mehr nehmen kann.',
    deliverables: ['Redaktionsplan', 'Artikel', 'Grafik und Video', 'WeCom-Einrichtung'],
    image: '/images/wechat-agency/service-content.webp',
    imageAlt: 'Redaktionsarbeitsplatz mit einem Smartphone, auf dem ein Markenartikel eines WeChat Official Account durchgescrollt wird',
  },
  {
    glyph: '广',
    title: 'WeChat-Werbung',
    tag: 'Mediabudget zum Einkaufspreis, ohne Marge',
    description:
      'Mediaplanung, Werbemittel, A/B-Tests und Gebotssteuerung über Moments Ads, Official Account Ads und Mini-Program Ads. Das Mediabudget reichen wir zum Einkaufspreis durch. Ohne Marge, ohne Ausnahme.',
    deliverables: ['Mediaplan', 'Werbemittel', 'A/B-Tests', 'Gebotssteuerung'],
    image: '/images/wechat-agency/service-ads.webp',
    imageAlt: 'Hand hält ein Smartphone in einem Café, im WeChat-Moments-Feed erscheint eine gesponserte Markenanzeige',
  },
  {
    glyph: '店',
    title: 'Mini Programs und eCommerce',
    tag: '945 Mio. Nutzer im Monat',
    description:
      'Shops, Lead-Formulare, Buchungen und Loyalitätsprogramme, direkt in WeChat gebaut und an WeChat Pay angebunden. 945 Millionen Menschen öffnen Mini Programs jeden Monat. Wer Ihre Artikel liest, findet dort den direkten Weg zum Kauf.',
    deliverables: ['Shop', 'WeChat Pay', 'Lead-Erfassung', 'Loyalitätsprogramme'],
    image: '/images/wechat-agency/service-miniprogram.webp',
    imageAlt: 'Zwei Smartphones nebeneinander, links ein Shop in einem WeChat Mini Program, rechts die Zahlungsbestätigung von WeChat Pay',
  },
  {
    glyph: '播',
    title: 'KOL- und Cross-Promotion-Kampagnen',
    tag: 'Ausschließlich verifizierte Engagement-Werte',
    description:
      'Wir wählen Key Opinion Leaders (KOL) aus, prüfen ihre Zahlen, briefen die Kampagnen und liefern das Reporting. Gezählt wird nur verifiziertes Engagement. Wirkt eine Follower-Zahl gekauft, lassen wir die Finger davon.',
    deliverables: ['KOL-Auswahl', 'Prüfung', 'Kampagnen-Briefings', 'Reporting'],
    image: '/images/wechat-agency/service-kol.webp',
    imageAlt: 'Content-Creator filmt ein Produktvideo, daneben zeigt ein Smartphone einen Livestream in WeChat Channels',
  },
];

const segments = [
  {
    title: 'B2C-Handel und Luxus',
    description: 'Wer in China kauft, prüft die Marke vorher auf WeChat. Wir bauen Official Account, Content und Mini-Program-Shop so, dass diese Prüfung zum Kauf führt.',
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  },
  {
    title: 'B2B und Industrie',
    description: 'Lange Vertriebszyklen verlangen einen Kanal, der Kontakte warmhält. WeChat-Artikel und WeCom-Ansprache machen aus Messekontakten eine Pipeline.',
    icon: '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
  },
  {
    title: 'Tourismus und Bildung',
    description: 'Reisende und Studierende aus China recherchieren Monate vor der Entscheidung auf WeChat. Wir halten Ihre Marke in dieser Phase im Gespräch.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'Cross-Border-eCommerce',
    description: 'Nach China verkaufen, ohne dort eine Gesellschaft zu gründen. Mini-Program-Shops und grenzüberschreitendes WeChat Pay machen genau das möglich.',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  },
];

const pillars = [
  {
    title: 'Klarer SOW',
    description: 'Jede Leistung steht vorab fest: Artikel, Videos, Kampagnen, Berichte. Sie wissen jeden Monat genau, was Sie bekommen.',
  },
  {
    title: 'Festpreis ohne Überraschungen',
    description: 'Ein Preis pro Paket. Keine Stundensätze, keine Nachträge, keine Rechnung, die Sie überrascht.',
  },
  {
    title: 'Content-Produktion mit KI',
    description: 'Visuals und Videos entstehen mit HubStudio.ai. Das senkt die Kosten und verkürzt die Produktion. Die Strategie bleibt Sache von Menschen.',
  },
  {
    title: 'Team vor Ort',
    description: 'Shanghai und Hongkong. Muttersprachler, die WeChat täglich nutzen, mit direktem Draht zu KOL und ständigem Zugriff auf die Plattform.',
  },
];

const steps = [
  {
    title: 'Erstgespräch',
    description: '30 Minuten. Sie schildern Marke, Ziele und Ihren aktuellen Stand in China. Ohne Verkaufsfolien.',
  },
  {
    title: 'Angebot',
    description: 'Klarer SOW, fester Preis, jede Position schwarz auf weiß. Vor der Unterschrift wissen Sie, was Sie bekommen und was es kostet.',
  },
  {
    title: 'In vier Wochen live',
    description: 'Übernahme, Kontoeröffnung, Verifizierung, erste Veröffentlichung. Zwischen Unterschrift und erstem Beitrag liegen vier Wochen.',
  },
];

const caseStudies = [
  {
    client: 'JAC Motors',
    image: '/images/clients/JAC/JAC-Wechat-4.webp',
    imageAlt: 'WeChat-Beiträge von TheRedScroll für JAC Motors',
    metric: '10M',
    metricLabel: 'verkaufte Fahrzeuge, Community von Grund auf erneuert',
    summary: 'Ein chinesischer Autobauer mit zehn Millionen verkauften Fahrzeugen, aber verstummten Kanälen. Wir haben die Community auf WeChat, RedNote und Weibo mit KI-gestütztem Content neu aufgebaut.',
    href: '/de/work/jac-motors/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Kampagnenmotiv von Mission Foods zum Marktstart in China',
    metric: 'Gen Z',
    metricLabel: 'Kampagnen für eine in China neue Kategorie',
    summary: 'Corn Chips kannte in China kaum jemand. Zum Marktstart liefen Gen-Z-Kampagnen und Food-Pairing-Content auf WeChat, RedNote und Weibo.',
    href: '/de/work/mission-foods/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Kampagnenmotiv von Camper für chinesische soziale Netzwerke',
    metric: '187K',
    metricLabel: 'Follower nach 18 Monaten, gestartet bei 43.000',
    summary: 'Die europäische Schuhmarke wuchs in 18 Monaten von 43.000 auf 187.000 Follower. Das Engagement stieg von 1,2 auf 4,7 Prozent, der Umsatz je Filiale um 31 Prozent.',
    href: '/de/work/camper/',
  },
];

const faqs = [
  {
    q: 'Brauche ich für einen WeChat Official Account eine chinesische Geschäftslizenz?',
    a: 'Nein. Ausländische Unternehmen melden einen WeChat Service Account mit ihrer heimischen Geschäftslizenz an. Nötig sind die Registrierungsunterlagen der Firma, der Ausweis des gesetzlichen Vertreters und ein Nachweis der Markenrechte. Eine chinesische Gesellschaft brauchen Sie erst für Subscription Accounts, den heimischen WeChat-Pay-Händlerstatus und einzelne Werbeformate.',
  },
  {
    q: 'Worin unterscheiden sich Subscription Account und Service Account?',
    a: 'Subscription Accounts dürfen täglich senden, verschwinden aber in einem eingeklappten Ordner und stehen nur chinesischen Gesellschaften offen. Service Accounts senden viermal im Monat, erscheinen direkt in der Chatliste und bringen Menüs, WeChat Pay und CRM-Funktionen mit. Ausländische Unternehmen können nur diesen Typ selbst anmelden. Für die meisten Marken ist er ohnehin die richtige Wahl.',
  },
  {
    q: 'Was kostet WeChat-Marketing?',
    a: 'Es gibt zwei Posten. Das Agenturhonorar: ein fester Monatspreis für einen definierten Leistungsumfang, jede Position steht vor der Unterschrift fest. Und das Mediabudget: Moments Ads laufen über Auktionen ab rund 1.000 RMB pro Tag, fest gebuchte Premium-Platzierungen beginnen bei etwa 50.000 RMB pro Kampagne. Das Mediabudget rechnen wir getrennt und zum Einkaufspreis ab, ohne Marge.',
  },
  {
    q: 'Wie lange dauern Kontoeröffnung und Verifizierung?',
    a: 'Mit vollständigen Unterlagen dauern Anmeldung und Tencent-Verifizierung ein bis zwei Wochen. Verzögerungen entstehen fast immer durch fehlende oder widersprüchliche Papiere. Deshalb prüfen wir alles vor der Einreichung. Ein bereits verifiziertes Konto bespielen wir innerhalb weniger Tage.',
  },
  {
    q: 'Können Sie WeChat für uns führen, wenn wir kein Team in China haben?',
    a: 'Ja, das ist bei unseren Kunden der Regelfall. Unser Team in Shanghai und Hongkong führt Ihr Konto im Tagesgeschäft: Strategie, Content, Veröffentlichung, Community-Antworten, Werbung und ein Monatsbericht in klarem Englisch. Sie haben einen festen Ansprechpartner und vollen Einblick, ohne in China jemanden einzustellen.',
  },
  {
    q: 'Wem gehören das WeChat-Konto und seine Follower?',
    a: 'Ihnen. Das Konto läuft auf Ihre Firma und Ihre eigenen Unterlagen, wir führen es in Ihrem Auftrag. Trennen sich die Wege, behalten Sie Konto, Follower und das vollständige Content-Archiv.',
  },
  {
    q: 'Übernehmen Sie auch ein bestehendes WeChat-Konto?',
    a: 'Ja. Am Anfang steht ein Audit: Verifizierungsstatus, Qualität der Follower, Content-Historie, Compliance-Risiken. Danach beheben wir die Schwachstellen und übernehmen die Veröffentlichung. Die meisten Übergaben sind nach einer Woche abgeschlossen, ohne dass Ihre Follower etwas davon merken.',
  },
  {
    q: 'Sollten wir mit WeChat starten oder mit RedNote und Douyin?',
    a: 'Das entscheidet Ihr Ziel. Auf WeChat lesen chinesische Konsumenten nach, stellen Fragen und kaufen, die Plattform taugt als Fundament. RedNote und Douyin sind Entdeckungskanäle, die neue Zielgruppen heranführen. Die meisten unserer Kunden setzen WeChat ins Zentrum und bauen die Entdeckungskanäle darum herum.',
  },
  {
    q: 'Was ist Private-Domain-Traffic, und warum ist er wichtig?',
    a: 'Private-Domain-Traffic sind Follower, die Sie direkt erreichen, ohne für jede Botschaft Anzeigen zu schalten. Konkret: WeChat-Follower wandern in WeCom-Gruppen und Einzelchats. Diese Liste gehört Ihnen. Keine Algorithmusänderung kann sie Ihnen nehmen.',
  },
  {
    q: 'Wie sieht Ihr Reporting aus?',
    a: 'Sie erhalten einen Monatsbericht in klarem Englisch: Follower-Wachstum, Lesezahlen der Artikel, Engagement, Mediabudget zum Einkaufspreis sowie Leads oder Umsätze, wo sich das messen lässt. Dazu kommt ein fester Ansprechpartner, den Sie jederzeit erreichen.',
  },
];
---

<PageLayout
  title="WeChat-Agentur mit Team in Shanghai und Hongkong | TheRedScroll"
  description="WeChat-Agentur in Shanghai und Hongkong: Official Account, Content, Moments Ads, Mini Programs und WeCom-CRM. Fester Leistungsumfang, fester Monatspreis."
  lang="de"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      微信
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">微</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">WeChat-Agentur</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            Die WeChat-Agentur für Marken, die China ernst nehmen
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Official Account, Content, Werbung, Mini Programs und CRM. Geführt aus Shanghai und Hongkong, Tag für Tag. Klarer Leistungsumfang, fester Preis.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
            <Button variant="secondary-dark" href="#results">Zu den Ergebnissen</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            30 Minuten am Telefon. Ohne Verkaufsfolien.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/wechat-agency/hero-phones-blend.webp"
            alt="Zwei Smartphones mit echten WeChat-Ansichten: links der Moments-Feed mit einer gesponserten Markenanzeige, rechts die Zahlungsbestätigung von WeChat Pay"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Warum WeChat an erster Stelle steht
          </p>
          <p class="manifesto" data-manifesto>
            WeChat ist in China keine App, sondern das Internet selbst. Ihre Kunden chatten, lesen, kaufen und bezahlen, ohne die Anwendung zu verlassen. Eine Marke, die dort nicht stattfindet, bleibt <span class="manifesto-hl">unsichtbar</span>.
          </p>
        </div>
        <div>
          <img
            src="/images/wechat-agency/ecosystem-banner-tight.webp"
            alt="Drei Smartphones nebeneinander zeigen die drei Gesichter von WeChat: den Moments-Feed, einen Official-Account-Artikel und die Zahlungsbestätigung von WeChat Pay"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Eine App, drei Rollen: sozialer Feed, Publikationskanal, Bezahlsystem.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Eine Agentur für den kompletten WeChat-Auftritt
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Eine WeChat-Agentur eröffnet Ihr Konto, produziert Ihre Inhalte, steuert Ihre Werbung und baut Ihr Mini Program. Wer das im eigenen Haus aufbauen will, muss Muttersprachler einstellen, die Regeln von Tencent lernen und Werbung über ein chinesisches Konto einkaufen.
            </p>
            <p>
              Mit einem Spezialisten geht es für die meisten Marken schneller. Dieser Spezialist sind wir: Wir veröffentlichen jeden Tag auf <a href="/de/platforms/wechat/" class="text-[#CC3333] hover:underline">WeChat</a>, direkt aus China.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Was wir übernehmen
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Unsere Leistungen im WeChat-Marketing</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Fünf Bausteine, jeder mit klarem Ergebnis
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Jede Position steht vor der Unterschrift im SOW, dem vereinbarten Leistungsumfang. Vage Pauschalverträge gibt es bei uns nicht.
              </p>
            </div>
            <div class="svc-frame relative max-[900px]:hidden">
              <div class="relative w-full aspect-[1344/570] rounded-[10px] overflow-hidden bg-[#FFFFFF]">
                {services.map((service, i) => (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="1344"
                    height="570"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class:list={['svc-img absolute inset-0 w-full h-full object-cover', i === 0 && 'is-active']}
                    data-svc-img={i}
                  />
                ))}
              </div>
            </div>
            <div class="flex items-center gap-[16px] mt-[24px] max-[900px]:hidden">
              <div class="flex gap-[6px] grow" aria-hidden="true">
                {services.map((_, i) => (
                  <span class:list={['svc-tick', i === 0 && 'is-active']} data-svc-tick={i}></span>
                ))}
              </div>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-none m-0 shrink-0" data-svc-caption aria-hidden="true">{services[0].title}</p>
            </div>
          </div>
        </div>

        <!-- Scrolling step cards -->
        <div class="flex flex-col gap-[16px]">
          {services.map((service, i) => (
            <div class:list={['svc-step bg-[#FFFFFF] rounded-[10px] p-[32px] max-[640px]:p-[20px]', i === 0 && 'is-active']} data-svc-step={i}>
              <div class="flex items-center gap-[12px] mb-[16px]">
                <span class="svc-seal" aria-hidden="true">{service.glyph}</span>
