---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 750, decimals: 0, suffix: ' Mio.', label: 'täglich aktive Nutzer' },
  { value: 120, decimals: 0, suffix: ' Min.', label: 'durchschnittliche Nutzungsdauer pro Tag' },
  { value: 3.5, decimals: 1, suffix: ' Bio.', label: 'RMB eCommerce-Umsatz pro Jahr' },
  { value: 2, decimals: 0, suffix: ' Wochen', label: 'von der Unterschrift bis zum ersten Content' },
];

const scopeItems = [
  { label: 'Konteneinrichtung und Blue-V-Verifizierung', href: '/de/platforms/douyin/' },
  { label: 'Kurzvideo-Produktion von Mandarin-Muttersprachlern', href: '/de/services/content-production/' },
  { label: 'KOL- und KOC-Kampagnen über Xingtu', href: '/de/services/influencer-marketing/' },
  { label: 'Werbung über Ocean Engine', href: '/de/services/advertising/' },
  { label: 'Livestream-Commerce und Douyin Shop', href: '/de/platforms/douyin/' },
];

const services = [
  {
    glyph: '号',
    title: 'Konteneinrichtung und Verifizierung',
    tag: 'Live und verifiziert',
    description:
      'Wir registrieren Ihr Unternehmenskonto und führen es durch die Blue-V-Verifizierung. Ausländische Unternehmen brauchen dafür eine chinesische Geschäftslizenz oder eine autorisierte Agentur. Beide Wege decken wir ab. Sie starten ohne eigene Gesellschaft in China.',
    deliverables: ['Unternehmenskonto', 'Blue-V-Verifizierung', 'Beratung zum Lizenzweg', 'Kontenübergabe'],
    image: '/images/platforms/douyin-services/setup-strategy.webp',
    imageAlt: 'Telefon mit dem Profil eines verifizierten Douyin-Unternehmenskontos neben Registrierungsunterlagen',
  },
  {
    glyph: '视',
    title: 'Content-Strategie und Videoproduktion',
    tag: 'Video von Mandarin-Muttersprachlern',
    description:
      'Kurzvideos, wie Douyin sie belohnt, produziert von unserem Team in China. Produktdemos, Tutorials, Trendformate und Mini-Dramen. HubStudio.ai beschleunigt die Produktion. Geschrieben und geschnitten wird jedes Stück von Mandarin-Muttersprachlern.',
    deliverables: ['Content-Strategie', 'Kurzvideo-Produktion', 'Trendformate', 'Mini-Dramen'],
    image: '/images/platforms/douyin-services/content-production.webp',
    imageAlt: 'Schnittplatz mit einem Telefon, auf dem ein vertikales Douyin-Kurzvideo in Produktion ist',
  },
  {
    glyph: '达',
    title: 'KOL- und KOC-Kampagnen',
    tag: 'Verifizierte Creator über Xingtu',
    description:
      'Wir buchen KOL (Key Opinion Leaders) und KOC (Key Opinion Consumers) über Xingtu, den offiziellen Creator-Marktplatz von Douyin, und über unser eigenes Netzwerk. Jeden Creator prüfen wir auf gekaufte Follower und Zielgruppenpassung. Die finale Liste geben Sie frei.',
    deliverables: ['KOL-Auswahl', 'KOC-Seeding', 'Prüfung auf gekaufte Follower', 'Kampagnen-Reporting'],
    image: '/images/platforms/douyin-services/kol-campaigns.webp',
    imageAlt: 'Content-Creator beim Dreh eines Produktvideos für eine Douyin-KOL-Kampagne',
  },
  {
    glyph: '广',
    title: 'Bezahlte Werbung über Ocean Engine',
    tag: 'Mediabudget zum echten Preis, ohne Marge',
    description:
      'Ocean Engine (巨量引擎) ist die Werbeplattform von ByteDance für Douyin. TopView für Markteinführungen. In-Feed Ads für Traffic. Search Ads für kaufbereite Nutzer. DOU+ zum Testen von Inhalten. Das Mediabudget rechnen wir zum echten Preis ab, ohne Aufschläge.',
    deliverables: ['TopView', 'In-Feed Ads', 'Search Ads', 'DOU+-Boosts'],
    image: '/images/platforms/douyin-services/advertising.webp',
    imageAlt: 'Telefon mit einer gesponserten In-Feed-Markenanzeige im Douyin-Video-Feed',
  },
  {
    glyph: '播',
    title: 'Livestream und Douyin Shop',
    tag: 'Live-Commerce fest eingebaut',
    description:
      'Live-Commerce gehört auf Douyin zum Kerngeschäft. Wir planen Live-Verkaufsformate und setzen sie um: Hosts, Produkt-Skripte, Moderation in Echtzeit. Ihren Douyin Shop (抖音小店) richten wir ein und optimieren ihn laufend.',
    deliverables: ['Livestream-Planung', 'Host-Auswahl', 'Produkt-Skripte', 'Douyin-Shop-Einrichtung'],
    image: '/images/platforms/douyin-services/live-commerce.webp',
    imageAlt: 'Host präsentiert Produkte vor der Kamera während eines Douyin-Livestream-Verkaufsformats',
  },
  {
    glyph: '数',
    title: 'Analyse, Reporting und Optimierung',
    tag: 'Ein Bericht pro Monat',
    description:
      'Ein Monatsbericht mit klaren Zahlen: Follower-Wachstum, Aufrufe, Engagement-Rate, Werbeeffizienz, dazu GMV und ROAS, sobald der Verkauf läuft. Was funktioniert hat, was nicht, was sich im Folgemonat ändert.',
    deliverables: ['Follower-Wachstum', 'Engagement-Rate', 'GMV und ROAS', 'Plan für den Folgemonat'],
    image: '/images/blog/douyin-control-room.webp',
    imageAlt: 'Kontrollraum-Bildschirme mit Douyin-Follower-Wachstum, Engagement und Verkaufszahlen',
  },
];

const segments = [
  {
    title: 'Beauty und Mode',
    description: 'Beauty und Mode funktionieren auf Douyin. Kurze Demos, Tutorials und Creator-Reviews wecken die Nachfrage, gekauft wird direkt in der App.',
    icon: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  },
  {
    title: 'Lebensmittel und Getränke',
    description: 'Essen funktioniert auf Douyin. Schnelle Demos und Verkostungsformate machen aus Zuschauern Erstkäufer, im Feed und im Livestream.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Unterhaltungselektronik und Wohnen',
    description: 'Elektronik und Haushaltswaren funktionieren auf Douyin. Produktdemos zeigen den Nutzen in Sekunden, genau das belohnt der Algorithmus.',
    icon: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  },
  {
    title: 'Hotellerie, Automobil und B2B',
    description: 'Hotellerie, Automobil, Gesundheit und B2B funktionieren auf Douyin ebenfalls. Millionenstadt oder Provinz, 22 oder 52 Jahre alt: Ihre chinesische Zielgruppe ist längst dort.',
    icon: '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>',
  },
];

const pillars = [
  {
    title: 'Team vor Ort',
    description: 'Shanghai und Hongkong. Mandarin-Muttersprachler, die täglich auf Douyin veröffentlichen, keine Berater, die die Plattform nur aus Präsentationen kennen.',
  },
  {
    title: 'Klarer Leistungsumfang, Festpreis',
    description: 'Im April 2026 haben wir 37 Agenturen verglichen. 0 von 37 bieten Festpreispakete. Wir schon. Jede Leistung ist vorab definiert.',
  },
  {
    title: 'Kundenbetreuung auf Englisch',
    description: 'Ein fester Ansprechpartner, der Ihre Marke kennt. Klare Kommunikation auf Englisch, Content in muttersprachlichem Mandarin.',
  },
  {
    title: 'Compliance inklusive',
    description: 'Lizenzwege, Kontoverifizierung, Content-Regeln und Anzeigenprüfung. Wir kümmern uns um die Formalitäten, damit Ihre Kampagnen nicht ins Stocken geraten.',
  },
];

const steps = [
  {
    title: 'Audit',
    description:
      'Wir prüfen Ihre Kategorie auf Douyin. Wettbewerber, Content-Formate, Preispunkte und was der Algorithmus in Ihrem Segment gerade belohnt.',
  },
  {
    title: 'Strategie',
    description:
      'Redaktionelle Säulen, Veröffentlichungsplan, KOL-Shortlist, Werbeplan und KPI-Ziele. Alles steht in einem klaren SOW mit Festpreis.',
  },
  {
    title: 'Lokalisierung',
    description:
      'Übersetzt wird nichts. Unser Mandarin-Team entwickelt Ihre Inhalte von Grund auf für chinesische Zuschauer. Übersetzter Content fällt auf Douyin deutlich ab.',
  },
  {
    title: 'Start',
    description:
      'Konto verifiziert, erster Content binnen zwei Wochen nach Unterschrift live. Ihr Ansprechpartner arbeitet mit Ihnen auf Englisch. Chinesischkenntnisse brauchen Sie keine.',
  },
  {
    title: 'Skalierung',
    description:
      'Wir verstärken, was funktioniert. Erfolgreiche Formate bekommen über DOU+ und Ocean Engine mehr Budget. Schwache Formate streichen wir. Monatsberichte halten alles fest.',
  },
];

const caseStudies = [
  {
    client: "AGE 20's",
    image: '/images/clients/Age20/Age20-Picture1-scaled.jpg',
    imageAlt: "Kampagnenmotiv von AGE 20's für den Foundation-Start in China",
    metric: '3.87M',
    metricLabel: 'Douyin-Impressionen bei einem Ziel von 1 Mio.',
    summary: 'Koreanische Beauty-Marke beim Foundation-Start in China. Die Kampagne kam auf 3,87 Millionen Douyin-Impressionen, angepeilt war eine Million. Der Spitzname des Produkts verbreitete sich von allein.',
    href: '/de/work/age20s/',
  },
  {
    client: 'Langnese',
    image: '/images/clients/Langnese/Langnese-Douyin-Livestream.jpg',
    imageAlt: 'Langnese-Honig in einem Douyin-Livestream-Verkaufsformat',
    metric: 'Live',
    metricLabel: 'Livestream-Commerce für eine Traditionsmarke',
    summary: 'Deutsche Honigmarke, für chinesische Konsumenten neu positioniert. Douyin-Livestreams und schnelle Demo-Videos zeigten neue Verwendungen des Produkts, der Verkauf lief über Tmall.',
    href: '/de/work/langnese/',
  },
];

const faqs = [
  {
    q: 'Dürfen ausländische Unternehmen auf Douyin werben?',
    a: 'Ja. Ausländische Marken werben auf Douyin über eine autorisierte Agentur wie TheRedScroll. Wir eröffnen das Konto, steuern die Anzeigen über Ocean Engine und rechnen das Mediabudget zum echten Preis ab. Eine lokale Gesellschaft ist nicht nötig.',
  },
  {
    q: 'Brauchen wir eine chinesische Geschäftslizenz oder eine WFOE?',
    a: 'Für den Start nicht. Unternehmenskonten brauchen eine chinesische Geschäftslizenz oder eine autorisierte Agentur, und den Agenturweg decken wir ab. Für den Verkauf über Douyin Shop gibt es Cross-Border-Optionen für Marken ohne chinesische Gesellschaft. Das passende Setup empfehlen wir im ersten Gespräch.',
  },
  {
    q: 'Was kostet eine Douyin-Agentur?',
    a: 'Die meisten Agenturen nennen individuelle Preise und lassen die Leistungen im Vagen. Wir arbeiten mit Festpreispaketen, die jede Leistung vorab auflisten. Das Mediabudget auf Ocean Engine wird separat abgerechnet, zum echten Preis, ohne Aufschläge. Vereinbaren Sie ein Gespräch, wir empfehlen ein Paket für Ihr Budget.',
  },
  {
    q: 'Worin unterscheidet sich Douyin für Werbetreibende von TikTok?',
    a: 'Es sind zwei getrennte Apps von ByteDance ohne jede inhaltliche Überschneidung. Douyin bedient Festlandchina und läuft über Ocean Engine, die eigene Werbeplattform. Der In-App-Handel reicht auf Douyin deutlich tiefer: Shops, Livestream-Verkauf und Bezahlung, ohne die App zu verlassen. Eine TikTok-Strategie lässt sich nicht übertragen.',
  },
  {
    q: 'Wie schnell sehen wir Ergebnisse?',
    a: 'Bezahlte Kampagnen können binnen Tagen wirken. Organische Reichweite braucht in der Regel acht bis zwölf Wochen konsequenten Publizierens. Der Algorithmus belohnt Sehdauer und Beständigkeit, drei bis fünf Beiträge pro Woche sind daher unser Minimum.',
  },
  {
    q: 'Können wir unsere TikTok-Videos auf Douyin wiederverwenden?',
    a: 'In der Regel nicht. Douyin erkennt Re-Uploads mit Wasserzeichen und drosselt ihre Reichweite. Die Zuschauer erwarten Mandarin, lokale Trends und lokale Formate. Ein starkes Konzept adaptieren wir gelegentlich, das Video selbst entsteht aber neu, eigens für das chinesische Publikum.',
  },
  {
    q: 'Wie laufen KOL-Kampagnen auf Douyin ab?',
    a: 'Wir buchen Creator über Xingtu, die offizielle ByteDance-Plattform, jede Buchung stützt sich also auf verifizierte Audience- und Engagement-Daten. Ausgewählt wird nach Passung und Leistung, nicht nach Followerzahl. Briefing, Verträge, Bezahlung und Nutzungsrechte laufen über uns. Mehrere kleinere KOCs schlagen oft einen einzelnen großen Namen.',
  },
  {
    q: 'Wie funktioniert Douyin Shop für ausländische Marken?',
    a: 'Douyin betreibt ein Cross-Border-Programm für Marken ohne chinesische Gesellschaft. Sie verkaufen über einen Cross-Border-Store und versenden aus einem Zolllager oder aus dem Ausland. Kategorien, Kautionen und geforderte Unterlagen unterscheiden sich, daher klären wir die Voraussetzungen, bevor wir den Shop aufbauen. Livestreams und Kurzvideos führen anschließend direkt zum Checkout.',
  },
  {
    q: 'Brauchen wir Chinesischkenntnisse im Team?',
    a: 'Nein. Ihr fester Ansprechpartner arbeitet mit Ihnen auf Englisch: Strategie, Freigaben, Berichte. Die gesamte Arbeit auf Chinesisch übernimmt unser muttersprachliches Team, von Skripten und Untertiteln bis zu Antworten in den Kommentaren. Sie geben englische Zusammenfassungen frei, keine chinesischen Originaldokumente.',
  },
  {
    q: 'Wie messen Sie den Erfolg einer Douyin-Kampagne?',
    a: 'An den Zielen aus Ihrem Leistungsumfang. Monatsberichte erfassen Aufrufe, Sehdauer, Followerwachstum, Engagement, Anzeigenergebnisse aus Ocean Engine und, wo relevant, Livestream-Verkäufe. Jeder Bericht schließt mit Empfehlungen für den Folgemonat. Formate, die nicht liefern, werden gestrichen, nicht verteidigt.',
  },
];
---

<PageLayout
  title="Douyin-Agentur für internationale Marken | TheRedScroll"
  description="Full-Service-Douyin-Agentur: Konteneinrichtung, Content, KOL-Kampagnen, Ocean-Engine-Werbung und Livestream-Commerce. Klarer Leistungsumfang, Festpreis."
  lang="de"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      抖音
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">抖</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Douyin-Agentur</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            Douyin-Agentur: Ihre Marke auf Chinas größter Kurzvideo-Plattform
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Konteneinrichtung, Content, KOL-Kampagnen, Ocean-Engine-Werbung und Livestream-Commerce. Gesteuert von unserem Team in Shanghai und Hongkong. Klarer Leistungsumfang, Festpreis.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
            <Button variant="secondary-dark" href="#results">Ergebnisse ansehen</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Ein Gespräch von 30 Minuten. Ohne Verkaufsfolien.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/douyin-agency/hero-phones-blend.webp"
            alt="Zwei Telefone mit echten Douyin-Ansichten: ein vertikaler Kurzvideo-Feed mit Produktkarte und ein Livestream-Verkaufsformat"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Warum Douyin zählt
          </p>
          <p class="manifesto" data-manifesto>
            Douyin ist nicht TikTok. Es ist Chinas Kurzvideo-Ökonomie. 750 Millionen Menschen schauen, shoppen und bezahlen, ohne die App je zu verlassen. Steht Ihre Marke nicht im Feed, steht dort Ihr <span class="manifesto-hl">Wettbewerber</span>.
          </p>
        </div>
        <div>
          <img
            src="/images/douyin-agency/ecosystem-banner-tight.webp"
            alt="Drei Telefone mit den drei Seiten von Douyin: der Video-Feed, ein Livestream-Verkaufsformat und eine Douyin-Shop-Produktseite"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Eine App, drei Aufgaben: Unterhaltungs-Feed, Livestream-Kanal und Kasse.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Douyin-Leistungen für Marken auf dem Weg nach China
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Douyin (抖音) erreicht täglich 750 Millionen Menschen in China. Ihre Kunden sind dort. Ihre Wettbewerber womöglich auch schon.
            </p>
            <p>
              TheRedScroll ist eine Social-Media-Agentur mit Sitz in China. Wir eröffnen Douyin-Konten für ausländische Marken und produzieren Videos in muttersprachlichem Mandarin. Dazu kommen KOL-Kampagnen, Werbung über Ocean Engine und der Verkauf über Livestream und Douyin Shop.
            </p>
            <p>
              Jedes Mandat hat einen klaren SOW, den Leistungsumfang, und einen Festpreis. Sie wissen vor der Unterschrift, was Sie bekommen und was es kostet.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Leistungsumfang im Überblick
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Unsere Douyin-Leistungen</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Sechs Leistungen. Jede mit einem klaren Ergebnis.
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
