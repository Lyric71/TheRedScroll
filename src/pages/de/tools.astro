---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import EditorialIndex from '../../components/pages/EditorialIndex.astro';

const SITE_URL = 'https://www.theredscroll.com';

const pages = (await getCollection('tools-de'))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .map((post) => ({
    href: `/de/tools/${post.id}/`,
    title: post.data.title,
    excerpt: post.data.description,
    category: post.data.category,
    featuredImage: post.data.featuredImage,
    readingTime: `${Math.ceil((post.body || '').split(/\s+/).length / 200)} min`,
    date: new Date(post.data.publishDate).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' }),
  }));

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/de/tools/#collectionpage`,
  name: "Tools für die China-Social-Media-Planung",
  url: `${SITE_URL}/de/tools/`,
  description: "Kostenlose Rechner und Checklisten für Budget und Start in China auf WeChat, Xiaohongshu und Douyin.",
  isPartOf: { '@id': `${SITE_URL}/#website` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: 'de',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: pages.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}${p.href}`,
      name: p.title,
    })),
  },
};
---

<PageLayout
  title={"Tools für die China-Social-Media-Planung | TheRedScroll"}
  description={"Kostenlose Rechner und Checklisten für Budget und Start in China auf WeChat, Xiaohongshu und Douyin."}
  lang="de"
  schema={collectionSchema}
>
  <EditorialIndex
    lang="de"
    overline={"Tools"}
    heading={"Erst rechnen, dann ausgeben."}
    intro={"Rechner und Checklisten aus den Budgets, die wir jeden Monat verantworten. Ohne Anmeldung, ohne Formular."}
    items={pages}
    emptyText={"Das erste Tool wird ein Budgetrechner, geplant für dieses Jahr. So lange listet die Preisseite auf, was die monatlichen Pakete abdecken."}
  />
</PageLayout>
