---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 350, decimals: 0, suffix: ' Mio.+', label: 'monatlich aktive Nutzer' },
  { value: 1, decimals: 0, suffix: ' Mrd.+', label: 'Suchanfragen pro Monat' },
  { value: 70, decimals: 0, suffix: ' %', label: 'der Nutzer zwischen 18 und 35' },
  { value: 2, decimals: 0, suffix: ' Wochen', label: 'von der Unterschrift bis zur ersten Notiz' },
];

const platformNames = [
  { name: '小红书 (Xiǎohóngshū)', detail: 'Der offizielle chinesische Name. Romanisiert als Xiaohongshu oder Xiao Hong Shu.' },
  { name: 'Little Red Book', detail: 'Die wörtliche englische Übersetzung von 小红书.' },
  { name: 'RED', detail: 'Der frühere internationale Markenname der Plattform. In der Presse noch verbreitet.' },
  { name: 'RedNote', detail: 'Der offizielle englische Name seit Januar 2025. Diesen Namen verwenden wir.' },
];

const services = [
  {
    glyph: '号',
    title: 'Konteneinrichtung und Verifizierung',
    tag: 'In zwei Wochen live',
    description:
      'Wir registrieren Ihren Professional Account (企业号, Blue V), übersetzen Ihre ausländische Geschäftslizenz, bereiten die Markenunterlagen vor und bringen alles durch die Plattformprüfung. Die meisten Konten sind binnen zwei Wochen live.',
    deliverables: ['Professional Account', 'Blue-V-Verifizierung', 'Lizenzübersetzung', 'Plattformprüfung'],
    image: '/images/platforms/rednote-services/account-setup.webp',
    imageAlt: 'Telefon mit dem Profil eines verifizierten RedNote Professional Accounts mit Blue-V-Abzeichen, daneben Registrierungsunterlagen',
  },
  {
    glyph: '达',
    title: 'KOL- und KOC-Kampagnen',
    tag: 'Verifizierte Creator über Pugongying',
    description:
      'Kampagnen mit KOL (Key Opinion Leaders) und KOC (Key Opinion Consumers) laufen über Pugongying, den offiziellen Influencer-Marktplatz der Plattform. Über 100.000 verifizierte Creator, mit Prüfung auf gekaufte Follower bei jeder Shortlist.',
    deliverables: ['KOL-Shortlists', 'KOC-Seeding', 'Prüfung auf gekaufte Follower', 'Kampagnen-Reporting'],
    image: '/images/platforms/rednote-services/kol-koc.webp',
    imageAlt: 'Content-Creator beim Dreh einer Produkt-Review-Notiz für eine RedNote-KOL-Kampagne',
  },
  {
    glyph: '记',
    title: 'Content-Produktion und Lokalisierung',
    tag: 'Muttersprachliches Mandarin, keine Übersetzung',
    description:
      'Notizen (笔记), Video und Bildwelten, geschrieben in muttersprachlichem Mandarin, nicht aus dem Englischen übersetzt. AIGC-Visuals mit HubStudio.ai. Echte Shootings in China. Inhalte, angelegt auf Grass-Planting (种草), die Empfehlungskultur der Plattform.',
    deliverables: ['Notizen und Video', 'AIGC-Visuals', 'Shootings vor Ort', 'Grass-Planting-Content'],
    image: '/images/platforms/rednote-services/content-strategy.webp',
    imageAlt: 'Redaktionstisch mit einem Telefon, auf dem eine RedNote-Notiz auf Mandarin entworfen wird',
  },
  {
    glyph: '广',
    title: 'Bezahlte Werbung',
    tag: 'Mediabudget zum echten Preis, ohne Marge',
    description:
      'In-Feed Ads (信息流广告), Search Ads und Brand Ads über die Werbeplattform Juguang. Kreativtests, Gebotssteuerung und Anpassungen in Echtzeit. Das Mediabudget rechnen wir zum echten Preis ab. Ohne Marge, ohne Ausnahme.',
    deliverables: ['In-Feed Ads', 'Search Ads', 'Brand Ads', 'Kreativtests'],
    image: '/images/platforms/rednote-services/paid-advertising.webp',
    imageAlt: 'Telefon mit einer gesponserten In-Feed-Anzeige im RedNote-Entdeckungsraster',
  },
  {
    glyph: '店',
    title: 'eCommerce und Store-Integration',
    tag: 'Live-Commerce fest eingebaut',
    description:
      'Einrichtung des In-App-Stores, shoppable Notizen und Live-Commerce-Produktion. Auf Live-Formate entfallen 90 Prozent der In-App-Verkäufe der Plattform. Der Weg vom Inhalt zum Kauf bleibt so in der App.',
    deliverables: ['In-App-Store', 'Shoppable Notizen', 'Live-Formate', 'Cross-Border-Setup'],
    image: '/images/platforms/rednote-services/ecommerce-live.webp',
    imageAlt: 'Telefon mit einem RedNote-Live-Commerce-Format neben einem In-App-Produktstore',
  },
  {
    glyph: '数',
    title: 'Reporting und Analyse',
    tag: 'Reporting in klarem Englisch',
    description:
      'Follower-Wachstum, Engagement, Such-Rankings und Kampagnen-ROI in einem Monatsbericht, in klarem Englisch. Social Listening erfasst Markenerwähnungen, Stimmung und Bewegungen des Wettbewerbs.',
    deliverables: ['Wachstum und Engagement', 'Such-Rankings', 'Kampagnen-ROI', 'Social Listening'],
    image: '/images/platforms/rednote-services/analytics-listening.webp',
    imageAlt: 'Laptop-Dashboard mit RedNote-Analysen zu Follower-Wachstum, Engagement und Such-Rankings',
  },
];

const industries = [
  {
    title: 'Beauty und Kosmetik',
    description: 'Die größte Kategorie der Plattform. Reviews, Tutorials und Inhaltsstoff-Analysen.',
    icon: '<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>',
  },
  {
    title: 'Mode und Bekleidung',
    description: 'Styling-Content, saisonale Lookbooks und KOC-Seeding.',
    icon: '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>',
  },
  {
    title: 'Lebensmittel und Getränke',
    description: 'Restaurantkritiken, Rezepte und Verkostungen.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Reisen und Tourismus',
    description: 'Reiseführer und Hotelbewertungen. 64 Prozent der chinesischen Reisenden planen ihre Reisen mit RedNote.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'Luxus',
    description: 'Markenerzählungen für ein zahlungskräftiges Publikum, das oft kurz vor dem Kauf steht.',
    icon: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
  },
  {
    title: 'Gesundheit und Wellness',
    description: 'Fitness, Nahrungsergänzung und Wellness-Tipps. Ein schnell wachsendes Segment.',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
  },
];

const pillars = [
  {
    title: 'Klarer SOW',
    description: 'Jede Leistung ist vorab definiert. Notizen, Videos, KOL-Aktivierungen, Kampagnen, Berichte. Sie wissen genau, was Sie jeden Monat bekommen.',
  },
  {
    title: 'Festpreis, keine Überraschungen',
    description: 'Ein Preis pro Paket. Keine Stundensätze, keine Nachforderungen, keine Rechnungen, mit denen Sie nicht gerechnet haben.',
  },
  {
    title: 'Content-Produktion mit KI',
    description: 'Visuals und Video entstehen mit HubStudio.ai, das senkt Kosten und beschleunigt die Produktion. Die Strategie bleibt vollständig in menschlicher Hand.',
  },
  {
    title: 'Team vor Ort',
    description: 'Shanghai und Hongkong. Zweisprachige Muttersprachler, die täglich auf RedNote veröffentlichen. Direkter Draht zu KOLs, die Plattform jederzeit im Blick.',
  },
];

const steps = [
  {
    title: 'Audit und Strategie',
    description:
      'Ein Erstgespräch von 30 Minuten, dann ein Kategorie-Audit: Suchbegriffe, Wettbewerbskonten und Content-Lücken. Sie erhalten ein Angebot zum Festpreis mit jeder Leistung im Detail.',
  },
  {
    title: 'Konto- und Content-Aufbau',
    description:
      'Wir erledigen die Formalitäten des Professional Accounts, definieren Ihre redaktionellen Säulen und produzieren die ersten Notizen. Live binnen zwei Wochen nach Unterschrift.',
  },
  {
    title: 'Start und KOL-Aktivierung',
    description:
      'Ein stetiger Veröffentlichungsrhythmus trainiert den Algorithmus auf Ihre Kategorie. KOC-Seeding und bezahlte Verstärkung bringen Traffic, während die organische Seite anläuft.',
  },
  {
    title: 'Optimieren und skalieren',
    description:
      'Wir verfolgen CES-Engagement-Daten und Such-Rankings, streichen, was stockt, und verstärken die Formate und Suchbegriffe, die konvertieren.',
  },
];

const caseStudies = [
  {
    client: 'AGE 20\'s',
    image: '/images/clients/Age20/Age20-Picture11.webp',
    imageAlt: 'Kampagnenmotiv der Little-Milk-Brick-Foundation von AGE 20\'s für RedNote',
    metric: '750K',
    metricLabel: 'Impressionen bei einem Ziel von 300.000',
    summary: 'Eine koreanische Beauty-Marke brachte ihre Little-Milk-Brick-Foundation nach China. Die RedNote-Kampagne erreichte 750.000 Impressionen bei einem Ziel von 300.000, der Produkt-Spitzname verbreitete sich organisch.',
    href: '/de/work/age20s/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Kampagnenmotiv von Camper für chinesische soziale Netzwerke',
    metric: '38%',
    metricLabel: 'des eCommerce-Traffics aus der kleinsten Zielgruppe',
    summary: 'Eine europäische Schuhmarke wuchs in 18 Monaten von 43.000 auf 187.000 Follower. RedNote hatte die kleinste Zielgruppe, lieferte aber 38 Prozent des gesamten eCommerce-Traffics.',
    href: '/de/work/camper/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Kampagnenmotiv von Mission Foods für den Marktstart in China',
    metric: 'Gen Z',
    metricLabel: 'Kampagnen für eine neue Produktkategorie',
    summary: 'Corn Chips auf den chinesischen Markt bringen, eine dort unbekannte Kategorie. RedNote-KOLs zeigten das Produkt im Alltag, Food-Pairing-Content machte es lokal anschlussfähig.',
    href: '/de/work/mission-foods/',
  },
];

const faqs = [
  {
    q: 'Sind Xiaohongshu, RedNote und Little Red Book dasselbe?',
    a: 'Ja. Xiaohongshu (小红书) ist der offizielle chinesische Name, Little Red Book die wörtliche Übersetzung. International firmierte das Unternehmen jahrelang als RED, seit Januar 2025 lautet der offizielle englische Name RedNote. Xiao Hong Shu ist lediglich die Pinyin-Schreibweise in drei Wörtern. Eine App, ein Algorithmus, eine Zielgruppe.',
  },
  {
    q: 'Können ausländische Marken auf Xiaohongshu verkaufen?',
    a: 'Ja. Ausländische Unternehmen können mit übersetzter Geschäftslizenz und Markenunterlagen einen Professional Account (Blue V) eröffnen, ohne chinesische Gesellschaft. Über das Cross-Border-Programm der Plattform betreiben ausländische Marken zudem einen In-App-Store und versenden international. Wir übernehmen Formalitäten, Store-Aufbau und Plattformprüfung.',
  },
  {
    q: 'Was kostet Xiaohongshu-Marketing?',
    a: 'Drei Budgets zählen. Die Agenturleistung: ein fester Monatspreis gegen einen klaren Leistungsumfang, jede Leistung und die Gesamtkosten stehen vor der Unterschrift fest. Das Mediabudget: separat abgerechnet zum echten Preis über die Juguang-Plattform, ohne Marge. Die KOL-Honorare: Sie variieren stark nach Follower-Größe und Kategorie, wir reichen sie transparent durch, mit verifizierten Engagement-Daten hinter jeder Buchung.',
  },
  {
    q: 'Wie schnell sehen wir Ergebnisse?',
    a: 'Die Plattform belohnt keine Ungeduld. Neue Konten durchlaufen eine Beobachtungsphase des Algorithmus, die ersten zwei bis drei Monate bauen daher die Content-Bibliothek auf und trainieren den Algorithmus auf Ihre Kategorie. Bezahlte Anzeigen und KOL-Kampagnen bringen ab der ersten Woche Traffic, während die organische Seite aufholt. Genau deshalb beträgt unsere Mindestlaufzeit drei Monate.',
  },
  {
    q: 'Brauchen wir eine chinesische Geschäftslizenz oder Gesellschaft?',
    a: 'Für das Konto nicht. Eine übersetzte ausländische Geschäftslizenz genügt für den Professional Account. Die Ausnahme ist bezahlte Werbung: Die Juguang-Plattform verlangt für ein Werbekonto eine chinesische Gesellschaft. Wir führen Werbekonten für ausländische Kunden über unsere lokale Struktur, mit wöchentlichen Ausgabenberichten und voller Transparenz.',
  },
  {
    q: 'Wer nutzt RedNote, und wofür?',
    a: 'Rund 350 Millionen Menschen nutzen RedNote jeden Monat. Der Kern ist jung, urban, zu etwa 70 Prozent weiblich und kaufkräftig. Sie behandeln die App wie eine Suchmaschine für echte Produkterfahrungen: was kaufen, wohin reisen, was wirklich funktioniert. Diese Kaufabsicht ist der Grund, warum konversionsorientierte Marken hier starten.',
  },
  {
    q: 'RedNote oder Douyin: Was passt zu meiner Marke?',
    a: 'Die beiden erledigen unterschiedliche Aufgaben. Douyin ist Unterhaltungsvideo mit schnellem algorithmischem Feed, ausgelegt auf Reichweite und Impulskäufe. RedNote ist langsamer und suchgetrieben: Die Nutzer recherchieren vor dem Kauf, und eine gute Notiz bringt monatelang Traffic. Beratungsintensive Kategorien wie Beauty, Mode und Reisen starten meist auf RedNote. Viele Marken bespielen am Ende beide.',
  },
  {
    q: 'Wie laufen KOL- und KOC-Kampagnen auf RedNote ab?',
    a: 'Bezahlte Creator-Arbeit läuft über Pugongying, den offiziellen Marktplatz der Plattform. Buchungen daran vorbei riskieren die Löschung der Inhalte. Wir wählen Creator mit verifizierten Audience-Daten aus und übernehmen Briefings, Verträge, Zahlungen und die Auswertung pro Beitrag. Auf RedNote schlagen Dutzende kleine KOC-Bewertungen oft einen einzelnen Promi-Post.',
  },
  {
    q: 'Kann unser Content auf Englisch sein?',
    a: 'Chinesische Nutzer suchen auf Chinesisch, englische Notizen tauchen kaum auf. Alles, was wir veröffentlichen, schreibt unser Shanghaier Team nativ auf Mandarin, nichts wird übersetzt. Englisch erreicht nur das kleine ausländische Publikum, das Anfang 2025 dazukam. Für den Verkauf in China bleibt es eine Mandarin-Plattform.',
  },
  {
    q: 'Was macht eine Notiz auf RedNote erfolgreich?',
    a: 'Suchbegriffe im Titel, ein starkes Titelbild und eine Ich-Perspektive, die wie eine echte Empfehlung klingt. Werbliche Texte drosselt der Algorithmus, nicht deklarierte Anzeigen riskieren die Löschung, kommerzielle Notizen melden wir daher ordnungsgemäß über die Plattform an. Jede Notiz entsteht entlang eines Keyword-Plans, und wir verfolgen, welche ranken.',
  },
];
---

<PageLayout
  title="RedNote-Agentur | Marketing auf Xiaohongshu (Little Red Book)"
  description="Ihre Marke wächst auf RedNote (Xiaohongshu / Little Red Book). KOL-Kampagnen, Content und Werbung aus Shanghai. Klarer Leistungsumfang, Festpreis."
  lang="de"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">红</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">RedNote-Agentur</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            Marketing-Agentur für RedNote (Xiaohongshu / Little Red Book)
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Eine Plattform, vier Namen, über 350 Millionen Nutzer pro Monat. Wir steuern für westliche Marken KOL-Kampagnen, Content, Werbung und Social Commerce auf RedNote. Aus Shanghai, jeden Tag. Klarer Leistungsumfang. Festpreis.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/de/contact/">Gespräch vereinbaren</Button>
            <Button variant="secondary-dark" href="#results">Ergebnisse ansehen</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Ein Gespräch von 30 Minuten. Ohne Verkaufsfolien.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/rednote-agency/hero-phones-blend.webp"
            alt="Zwei Telefone mit der echten RedNote-App: das Entdeckungsraster und eine einzelne Produkt-Review-Notiz"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Warum die Produktentdeckung auf RedNote beginnt
          </p>
          <p class="manifesto" data-manifesto>
            In China beginnt der Kauf mit einer Suche auf RedNote. 350 Millionen Menschen lesen echte Bewertungen, bevor sie Geld ausgeben. Anzeigen gewinnen hier nicht. <span class="manifesto-hl">Vertrauen</span> gewinnt. Wir schreiben die Notizen, Bewertungen und Creator-Stimmen, die dieses Vertrauen verdienen.
          </p>
        </div>
        <div>
          <img
            src="/images/rednote-agency/ecosystem-banner-tight.webp"
            alt="Drei Telefone mit dem RedNote-Weg: das Entdeckungsraster, eine Produkt-Review-Notiz und Suchergebnisse"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Eine App, drei Aufgaben: Entdeckungs-Feed, ehrliche Bewertungen und Suche.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">
            Was ist RedNote
          </p>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Xiaohongshu, Little Red Book, RED und RedNote erklärt
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              RedNote (小红书 / Xiaohongshu) ist Chinas Plattform für Produktentdeckung. Über 350 Millionen aktive Nutzer pro Monat, mehr als eine Milliarde Suchanfragen monatlich, 90 Prozent der Inhalte stammen von Nutzern, nicht von Marken (Mai 2026).
            </p>
            <p>
              70 Prozent der Nutzer sind zwischen 18 und 35, überwiegend Frauen in Städten der ersten und zweiten Reihe mit überdurchschnittlicher Kaufkraft. Sie recherchieren Produkte vor dem Kauf. Bewertungen, Tutorials und ehrliche Empfehlungen wiegen hier schwerer als auf jeder anderen chinesischen Plattform.
            </p>
            <p>
              Man kann es so fassen: Auf Douyin lassen sich chinesische Konsumenten unterhalten, auf WeChat halten Marken ihre Kunden, und auf <a href="/de/platforms/rednote/" class="text-[#CC3333] hover:underline">RedNote</a> fallen die Kaufentscheidungen.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Warum die Plattform so viele Namen trägt
          </p>
          <ul class="flex flex-col gap-[14px] list-none m-0 p-0">
            {platformNames.map((item) => (
