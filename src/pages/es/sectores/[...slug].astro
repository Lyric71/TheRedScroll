---
import { getCollection } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import EditorialArticle from '../../../components/pages/EditorialArticle.astro';
import { faqPageSchema, serviceSchema, articleSchema } from '../../../lib/schema';
import { missingEditorialLocales } from '../../../lib/editorialLocales';

export async function getStaticPaths() {
  const pages = await getCollection('industries-es');
  return pages.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const omitLocales = await missingEditorialLocales('industries', post.id);

const publishedIso = new Date(post.data.publishDate).toISOString();
const modifiedIso = new Date(post.data.updatedDate ?? post.data.publishDate).toISOString();
const url = `/es/sectores/${post.id}/`;

const schema: Record<string, unknown>[] = [
  serviceSchema({
    name: post.data.title,
    description: post.data.metaDescription,
    url,
    serviceType: post.data.serviceType ?? 'Social Media Marketing',
    inLanguage: 'es',
  }),
  articleSchema({
    type: 'Article',
    headline: post.data.title,
    description: post.data.metaDescription,
    url,
    image: post.data.featuredImage,
    datePublished: publishedIso,
    dateModified: modifiedIso,
    authorName: post.data.author,
    inLanguage: 'es',
  }),
];
if (post.data.faqs && post.data.faqs.length > 0) {
  schema.push(faqPageSchema(post.data.faqs));
}
---

<BlogLayout
  title={`${post.data.metaTitle} | TheRedScroll`}
  description={post.data.metaDescription}
  ogImage={post.data.featuredImage}
  lang="es"
  schema={schema}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  omitLocales={omitLocales}
>
  <EditorialArticle
    post={post}
    lang="es"
    backHref="/es/sectores/"
    backLabel={"Todos los sectores"}
    ctaText={"¿Quiere ver cómo sería esto para su marca?"}
    tocLabel={"En esta página"}
    faqSubtitle={"Respuestas directas a las preguntas que más nos hacen sobre este tema."}
  />
</BlogLayout>
