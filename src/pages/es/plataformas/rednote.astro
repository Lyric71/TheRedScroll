---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import UpdatedDate from '../../../components/ui/UpdatedDate.astro';
import InsightsGuides from '../../../components/sections/InsightsGuides.astro';

const stats = [
  { label: 'Usuarios activos al mes', value: '350M+', image: '/images/platforms/rednote-stats/monthly-active-users.webp' },
  { label: 'Visualizaciones de notas al día', value: '9.12B', image: '/images/platforms/rednote-stats/daily-post-views.webp' },
  { label: 'Búsquedas al mes', value: '1B+', image: '/images/platforms/rednote-stats/monthly-search-queries.webp' },
  { label: 'De usuarios entre 18 y 35 años', value: '70%', image: '/images/platforms/rednote-stats/users-aged-18-35.webp' },
  { label: 'De contenido creado por los propios usuarios', value: '90%', image: '/images/platforms/rednote-stats/user-generated-content.webp' },
  { label: 'Tasa de conversión para marcas extranjeras', value: '21.4%', image: '/images/platforms/rednote-stats/conversion-rate.webp' },
  { label: 'Minutos en la plataforma al día', value: '55 min', image: '/images/platforms/rednote-stats/daily-time-per-user.webp' },
  { label: 'Usuarios buscando consejos de compra al mes', value: '200M+', image: '/images/platforms/rednote-stats/purchase-advice-users.webp' },
];

const whyEssential = [
  {
    title: 'Donde el consumidor chino decide su compra',
    description: 'Más del 60 % de los usuarios abre primero la barra de búsqueda. Buscan reseñas y experiencias reales. RedNote es su primer reflejo antes de comprar.',
    image: '/images/platforms/rednote-why/purchase-decision.webp',
  },
  {
    title: 'La confianza por encima de todo',
    description: 'El algoritmo premia la autenticidad y penaliza la publicidad encubierta. Un guardado o un comentario pesa muchísimo más que un simple «me gusta».',
    image: '/images/platforms/rednote-why/trust-distribution.webp',
  },
  {
    title: 'Una audiencia con poder de gasto',
    description: 'Joven, urbana, con poder adquisitivo. Concentrada en ciudades de primer y segundo nivel. Sabe lo que quiere y tiene con qué pagarlo.',
    image: '/images/platforms/rednote-why/spending-power.webp',
  },
  {
    title: 'Del contenido a la compra, sin salir de la app',
    description: 'Descubrir, comparar, probar y comprar. Todo el recorrido ocurre dentro. Sin redirecciones, sin fricción.',
    image: '/images/platforms/rednote-why/social-commerce.webp',
  },
];

const algorithm = [
  {
    title: 'Distribución por capas',
    description: 'Cada nota nueva se expone primero a 100-500 usuarios. Si la interacción despega en 24 horas, la plataforma amplía la distribución en oleadas, hasta cientos de miles de visualizaciones.',
    image: '/images/platforms/rednote-algorithm/staged-distribution.webp',
    bg: '#F7F2EE', iconBg: '#E8E0D8', textColor: '#1A1A1A', descColor: '#5C5C5C',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
  },
  {
    title: 'La puntuación CES',
    description: 'Un alta de seguidor vale 8 puntos. Un comentario o un compartido, 4. Un «me gusta» o un guardado, 1. Lo que cuenta es la interacción profunda. Acumular «me gusta» no lleva a nada.',
    image: '/images/platforms/rednote-algorithm/ces-scoring.webp',
    bg: '#1A1A1A', iconBg: 'rgba(255,255,255,0.1)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.6)',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
  },
  {
    title: 'La autenticidad como regla del juego',
    description: 'Contenido demasiado comercial, reseñas falsas y automatización: la plataforma sanciona sin avisar. La única visibilidad que aguanta en el tiempo es la que se construye nota a nota, con rigor.',
    image: '/images/platforms/rednote-algorithm/authenticity-enforced.webp',
    bg: '#CC3333', iconBg: 'rgba(255,255,255,0.2)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.8)',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: 'Dos motores, una sola estrategia',
    description: 'Cada nota trabaja en dos frentes: el feed Explorar, que recomienda, y la Búsqueda, que capta la intención de compra. Uno alimenta al otro. No se elige entre los dos.',
    image: '/images/platforms/rednote-algorithm/dual-engine.webp',
    bg: '#E8E0D8', iconBg: '#FFFFFF', textColor: '#1A1A1A', descColor: '#5C5C5C',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
  },
];

const services = [
  {
    title: 'Apertura y verificación de cuenta',
    description: 'Alta de la Cuenta Profesional (Blue V), traducción de la licencia comercial, expediente de marca y cumplimiento. Llevamos todos los trámites y le ahorramos varios meses de gestiones.',
    result: 'Una cuenta RedNote verificada, activa y lista para publicar.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/rednote-services/account-setup.webp',
  },
  {
    title: 'Estrategia y producción editorial',
    description: 'Pilares editoriales, calendario de publicación, formatos diseñados para la plataforma. Visuales producidos con HubStudio.ai. Rodajes en China. Redacción en mandarín por nativos, con adaptación cultural real.',
    result: 'Contenido pensado para la mecánica de RedNote, no para Instagram.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>`,
    image: '/images/platforms/rednote-services/content-strategy.webp',
  },
  {
    title: 'Campañas con KOL y KOC',
    description: 'Gestión completa vía Pugongying, la herramienta oficial de RedNote. Selección de creadores, detección de seguidores falsos, cocreación de contenido e informes precisos del ROI.',
    result: 'Colaboraciones con creadores verificados y resultados sin zonas oscuras.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    image: '/images/platforms/rednote-services/kol-koc.webp',
  },
  {
    title: 'Publicidad de pago',
    description: 'In-Feed Ads, Search Ads y gestión completa de Juguang, Juguang Lite y Chengfeng para e-commerce. Test creativo, ajuste de pujas y decisiones en tiempo real. El presupuesto de medios se factura aparte, a coste real.',
    result: 'Campañas segmentadas con informes de gasto a libro abierto.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/rednote-services/paid-advertising.webp',
  },
  {
    title: 'E-commerce y live commerce',
    description: 'Montaje de la tienda in-app, notas interactivas con enlaces de compra y producción de sesiones en directo. El live commerce representa el 90 % de las ventas hechas sin salir de RedNote.',
    result: 'Una tienda integrada en RedNote, donde cada nota lleva al carrito.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
    image: '/images/platforms/rednote-services/ecommerce-live.webp',
  },
  {
    title: 'Analítica y escucha',
    description: 'Paneles de crecimiento, interacción, posicionamiento en búsquedas y ROI de campaña. Vigilancia de marca, análisis de sentimiento, detección de tendencias y lectura del terreno competitivo.',
    result: 'Informes nítidos sobre lo que funciona y lo que toca corregir.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 6-8"/></svg>`,
    image: '/images/platforms/rednote-services/analytics-listening.webp',
  },
];

const bestPractices = [
  {
    title: 'Escriba para RedNote, no para Instagram.',
    description: 'Las notas densas, útiles, ancladas en la experiencia destacan. Tutoriales, reseñas honestas y guías prácticas barren a la campaña de marca demasiado pulida.',
  },
  {
    title: 'Cuide la portada y el titular.',
    description: 'Todo se juega en los primeros segundos. Titular claro, orientado al beneficio, con las palabras clave que cuentan. Visual limpio, texto superpuesto legible.',
  },
  {
    title: 'Piense como motor de búsqueda.',
    description: 'RedNote se comporta como Google para la compra. Detecte las palabras clave al alza, calque sus titulares a las búsquedas reales y use el sugeridor de hashtags nativo.',
  },
  {
    title: 'Provoque guardados y comentarios.',
    description: 'Termine cada nota con una pregunta o un motivo para guardarla. Las dos acciones alimentan el CES, que decide la distribución.',
  },
  {
    title: 'Quédese dentro de la app.',
    description: 'RedNote penaliza los enlaces salientes. Mantenga al usuario dentro. Una tienda in-app convierte mucho más que una redirección externa.',
  },
  {
    title: 'Mantenga el ritmo.',
    description: 'Más allá de los 180 días de actividad continua, la plataforma concede un plus de visibilidad. Defina sus pilares y publique sin parar.',
  },
];

const industries = [
  { title: 'Belleza y cosmética', description: 'La categoría dominante de la plataforma. Reseñas de producto, tutoriales de maquillaje y lecturas de ingredientes.' },
  { title: 'Moda y prêt-à-porter', description: 'Consejos de estilo, tendencias del momento, lookbooks estacionales y campañas de seeding con KOC.' },
  { title: 'Lujo', description: 'Relatos de marca cuidados para una audiencia acomodada, a menudo a un paso de la compra.' },
  { title: 'Alimentación y bebidas', description: 'Críticas de restaurantes, recetas y catas grabadas en directo.' },
  { title: 'Viajes y hostelería', description: 'Guías de destino y reseñas de hoteles. El 64 % de los viajeros chinos prepara su viaje en RedNote.' },
  { title: 'Salud y bienestar', description: 'Fitness, suplementos y consejos de salud. Uno de los sectores que más crece.' },
  { title: 'B2B', description: 'Más de 100 sectores profesionales en RedNote. Los decisores la usan para identificar proveedores.' },
];

const steps = [
  {
    number: '01',
    title: 'Llamada de encuadre.',
    description: 'Hablamos de su marca, sus objetivos y su nivel de preparación para el mercado chino. Sin discurso comercial, solo las preguntas que cuentan.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Propuesta comercial.',
    description: 'Circuito cerrado, precio fijo, cada entregable por escrito. Antes de firmar sabe con exactitud qué recibe y qué cuesta.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'Al aire en dos semanas.',
    description: 'Cuenta abierta, estrategia montada y primeras notas publicadas. Quince días entre la firma y la primera publicación.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  {
    q: '¿Dónde está su equipo?',
    a: 'En Shanghái y Hong Kong. Redactores chinos nativos permanentemente conectados a las grandes plataformas. Publicamos en RedNote cada día, gestionamos las cuentas publicitarias desde dentro y trabajamos directamente con KOL por toda China. No es consultoría a distancia.',
  },
  {
    q: '¿Se puede estar en RedNote sin entidad jurídica en China?',
    a: 'Sí. RedNote permite a las empresas extranjeras abrir una Cuenta Profesional (Blue V) con una licencia comercial traducida y un expediente de marca. Llevamos los trámites, la presentación en la plataforma y la interlocución con el equipo de validación de RedNote. La mayoría de cuentas están activas en menos de dos semanas.',
  },
  {
    q: '¿En cuánto tiempo llegan los resultados?',
    a: 'RedNote no premia las prisas. Toda cuenta nueva pasa primero por una fase de observación algorítmica. Los dos o tres primeros meses sirven para construir su catálogo de contenidos y enseñar a la plataforma quién es usted. La publicidad de pago y las campañas con KOL pueden generar tráfico desde la primera semana, mientras el crecimiento orgánico toma el relevo.',
  },
  {
    q: '¿Qué recibimos cada mes, en concreto?',
    a: 'Todo se contractualiza antes de la firma. Notas, vídeos, campañas publicitarias, activaciones KOL e informes mensuales. Usted revisa y valida cada contenido antes de la publicación. Sin zonas grises. Sin sorpresas a fin de mes.',
  },
  {
    q: '¿Cómo funciona la tarificación?',
    a: 'Una cuota mensual fija cubre el alcance acordado. El presupuesto de medios se factura aparte, a coste real, con cada línea de gasto visible. No tomamos comisión sobre la compra de medios. El importe de la propuesta es el importe que paga.',
  },
  {
    q: '¿Quién produce el contenido y quién lo controla?',
    a: 'La estrategia y la redacción las lleva nuestro equipo de Shanghái. Las imágenes generadas por IA pasan por HubStudio.ai, entrenado con sus pautas de marca. Las sesiones de foto y vídeo se realizan en China. Antes de cada publicación, un editor nativo revisa el contenido: tono, encaje cultural y conformidad con la plataforma.',
  },
  {
    q: '¿Cómo seleccionan a los KOL para nuestra marca?',
    a: 'Vía Pugongying, la herramienta oficial de RedNote, que indexa a más de 100.000 creadores verificados. Cada KOL preseleccionado pasa por verificación de audiencia, detección de seguidores falsos y evaluación de la calidad de interacción. Luego cruzamos nicho, línea editorial y presupuesto.',
  },
  {
    q: '¿Pueden activar publicidad en RedNote para una empresa fuera de China?',
    a: 'Sí, con una condición. La herramienta Juguang de RedNote exige una entidad china para abrir una cuenta publicitaria. Creamos y operamos esas cuentas en nombre de clientes extranjeros a través de nuestra estructura local. Usted recibe un informe semanal y visibilidad total del rendimiento.',
  },
  {
    q: '¿Cuál es la duración mínima de compromiso?',
    a: 'Tres meses. Es el tiempo necesario para superar la fase de rodaje del algoritmo y acumular datos suficientes para entender qué funciona. La mayoría de clientes prolonga en cuanto las primeras curvas empiezan a moverse.',
  },
  {
    q: 'No hablamos chino. ¿Es un problema?',
    a: 'No. Toda la relación con el cliente se desarrolla en inglés: llamadas estratégicas, informes mensuales, validaciones de contenido. El equipo es íntegramente bilingüe. Usted se centra en su marca, nosotros nos ocupamos de la plataforma.',
  },
];
---

<PageLayout
  title="Agencia de marketing RedNote / Xiaohongshu | TheRedScroll"
  description="Gestionamos cuentas RedNote desde Shanghái: estrategia editorial, campañas con KOL, publicidad de pago, e-commerce y analítica. Circuito cerrado y precio fijo."
  lang="es"
>
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/rednote-hero.webp')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/es/plataformas/otras/" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; Todas las plataformas
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Marketing RedNote
        </p>
        <UpdatedDate lang="es" date="mayo de 2026" variant="light" class="mb-[8px]" />
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          La plataforma china del descubrimiento de producto. 350 millones de usuarios. El primer reflejo antes de cada compra.
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.85)] font-normal leading-[1.6] mb-[12px]">
          RedNote, conocida en China como Xiaohongshu (小红书 / Pequeño libro rojo), es la plataforma de social commerce donde los consumidores chinos investigan productos antes de comprar. El 70 % de los usuarios tiene entre 18 y 35 años, vive en ciudades de primer y segundo nivel y cuenta con un poder adquisitivo superior a la media.
        </p>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          No miramos RedNote desde fuera. Publicamos aquí cada día, desde Shanghái.
        </p>
        <Button variant="primary" href="/es/contacto/">Agendar una llamada</Button>
      </div>
    </Container>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            No son cifras para impresionar. Aquí se toman las decisiones de compra.
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            RedNote en cifras.
          </p>
        </div>
        <Button variant="primary" href="/es/contacto/" class="shrink-0">Agendar una llamada</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>
      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none" data-stat-index={i}>
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Por qué RedNote es imprescindible">
          Sin presencia en RedNote, su marca está ausente justo cuando el consumidor chino decide qué va a comprar.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-4 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {whyEssential.map((item) => (
          <div class="bg-[#F7F2EE] border-none rounded-[10px] overflow-hidden">
            <div class="w-full aspect-[16/9] overflow-hidden">
              <img src={item.image} alt={item.title} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div class="p-[24px] max-[640px]:p-[20px]">
              <h3 class="text-[18px] font-medium leading-[1.3] text-[#1A1A1A] mb-[8px]">{item.title}</h3>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-[1.5]">{item.description}</p>
            </div>
