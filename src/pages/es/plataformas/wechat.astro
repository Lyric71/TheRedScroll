    image: '/images/platforms/wechat-services/content-strategy.png',
  },
  {
    title: 'Desarrollo de Mini Programs',
    description: 'Tiendas online, formularios de contacto, programas de fidelización, herramientas de reserva. Construidos en WeChat, enchufados a WeChat Pay.',
    result: 'Un escaparate que convierte lectores en compradores sin que salgan de la app.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
    image: '/images/platforms/wechat-services/mini-program.png',
  },
  {
    title: 'Publicidad en WeChat',
    description: 'Planificación de medios, creatividades, test A/B, pilotaje de pujas, reporting. Moments Ads, Banner Ads, Mini Program Ads. La inversión de medios se factura a coste real, sin ningún margen oculto.',
    result: 'Campañas que llegan a la audiencia adecuada y un reporting sin zonas oscuras.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/wechat-services/advertising.png',
  },
  {
    title: 'WeCom y CRM',
    description: 'El tráfico privado se construye desde el primer día. Segmentación, secuencias de bienvenida, recordatorios personalizados, dinamización de grupos. El ladrillo que la mayoría de agencias descuida.',
    result: 'Una base de clientes que le pertenece y que ninguna plataforma puede quitarle.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    image: '/images/platforms/wechat-services/wecom-crm.png',
  },
  {
    title: 'WeChat Channels y campañas KOL',
    description: 'Producción de vídeos cortos, lives en Channels, búsqueda y pilotaje de campañas con Key Opinion Leaders. Solo se cuentan las cifras de interacción verificadas.',
    result: 'Contenido en vídeo y campañas de influencia conectadas a su Cuenta Oficial y a su Mini Program.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
    image: '/images/platforms/wechat-services/channels-kol.png',
  },
