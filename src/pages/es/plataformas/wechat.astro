---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import UpdatedDate from '../../../components/ui/UpdatedDate.astro';

const stats = [
  { label: 'Activos cada mes', value: '1.4B+', image: '/images/platforms/wechat-stats/monthly-active-users.png' },
