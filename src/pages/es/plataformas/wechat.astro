const bestPractices = [
  {
    title: 'Calidad antes que frecuencia.',
    description: 'Una Service Account permite cuatro envíos al mes. Un artículo que circula amplio vale más que cuatro publicaciones estancadas en treinta aperturas.',
  },
  {
    title: 'No traducir, reescribir.',
    description: 'Pasar un texto en inglés por un traductor no lleva a ninguna parte. Parta de un brief redactado en chino, por alguien que pisa la plataforma cada día.',
  },
  {
    title: 'Lanzar el Mini Program sin esperar.',
    description: 'No hace falta vender desde el día uno. Un catálogo de producto, un quiz de marca, un formulario de alta bastan. Lo esencial es ofrecer al lector un paso siguiente tras el artículo.',
  },
  {
    title: 'Enchufar WeCom desde el primer día.',
    description: 'Cada nuevo seguidor debe convertirse en un contacto de WeCom. Seis meses después, las marcas que han construido un tráfico privado sólido juegan en otra liga.',
  },
  {
    title: 'Pagado y orgánico avanzan juntos.',
    description: 'Los Moments Ads hinchan la base de seguidores muy rápido. Sin contenido sólido cuando llegan, esos nuevos seguidores se dan de baja en pocas semanas.',
  },
  {
    title: 'Pensar como sistema, no como canales sueltos.',
    description: 'La Cuenta Oficial empuja hacia el Mini Program. WeCom toma el relevo para fidelizar. Channels alimenta el descubrimiento. Cada pieza alimenta a las demás.',
  },
