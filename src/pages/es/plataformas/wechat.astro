const services = [
  {
    title: 'Apertura y verificación de cuenta',
    description: 'Registro de la Service Account, proceso de verificación, configuración de menús, respuestas automáticas e identidad visual. Asumimos todas las gestiones y le ahorramos varias semanas de plazo.',
    result: 'Una cuenta WeChat verificada, operativa, lista para publicar.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/wechat-services/account-setup.png',
  },
