  { label: 'Tiempo diario por usuario', value: '82 min', image: '/images/platforms/wechat-stats/daily-time-per-user.png' },
  { label: 'Usan Mini Programs cada mes', value: '945M', image: '/images/platforms/wechat-stats/mini-program-users.png' },
  { label: 'Pagan con WeChat Pay', value: '935M+', image: '/images/platforms/wechat-stats/wechat-pay-users.png' },
  { label: 'Mensajes al día', value: '45B', image: '/images/platforms/wechat-stats/messages-sent-daily.png' },
  { label: 'Cuentas oficiales activas', value: '3.5M+', image: '/images/platforms/wechat-stats/official-accounts.png' },
