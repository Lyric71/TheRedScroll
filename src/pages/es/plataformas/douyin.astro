---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';
import UpdatedDate from '../../../components/ui/UpdatedDate.astro';

const stats = [
  { label: 'Activos al día', value: '750M+', image: '/images/platforms/douyin-stats/daily-active-users.png' },
  { label: 'Activos al mes', value: '1B+', image: '/images/platforms/douyin-stats/monthly-active-users.png' },
  { label: 'Minutos al día por usuario', value: '120 min', image: '/images/platforms/douyin-stats/daily-time.png' },
  { label: 'Volumen e-commerce 2024', value: '€3.5T', image: '/images/platforms/douyin-stats/ecommerce-sales.png' },
  { label: 'Crecimiento de ventas interanual', value: '34%', image: '/images/platforms/douyin-stats/yoy-growth.png' },
  { label: 'Lives de venta al día', value: '30M+', image: '/images/platforms/douyin-stats/live-commerce.png' },
  { label: 'Categorías de contenido', value: '100+', image: '/images/platforms/douyin-stats/content-variety.png' },
  { label: 'Creadores activos', value: '15M+', image: '/images/platforms/douyin-stats/creator-economy.png' },
];

const ecosystem = [
  {
    name: 'For You Feed',
    chineseName: '推荐页',
    description: 'El feed pilotado por el algoritmo. El número de seguidores casi no cuenta. Una cuenta abierta ayer puede pasar el millón de visualizaciones con el vídeo adecuado.',
    image: '/images/platforms/douyin-ecosystem/for-you-feed.png',
    bg: '#1A1A1A', iconBg: 'rgba(255,255,255,0.1)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.6)', linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
  },
  {
    name: 'Live Commerce',
    chineseName: '直播电商',
    description: 'Live de venta, nativo en la app. Presentador, guion de producto, interacción en directo. Algunas marcas reúnen a millones de espectadores en un solo live.',
    image: '/images/platforms/douyin-ecosystem/live-commerce.png',
    bg: '#CC3333', iconBg: 'rgba(255,255,255,0.2)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.8)', linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>`,
  },
  {
    name: 'Douyin Shop',
    chineseName: '抖音商城',
    description: 'La tienda nativa en la app. El usuario busca, compara y compra sin salir de Douyin. Cada vídeo y cada live remite directamente a la ficha de producto.',
    image: '/images/platforms/douyin-ecosystem/douyin-shop.png',
    bg: '#F7F2EE', iconBg: '#E8E0D8', textColor: '#1A1A1A', descColor: '#5C5C5C', linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  },
  {
    name: 'Ocean Engine',
    chineseName: '巨量引擎',
    description: 'La herramienta publicitaria de ByteDance. TopView para grandes lanzamientos, In-Feed Ads para el tráfico diario, Search Ads para captar al usuario en intención de compra, DOU+ para validar un contenido. Presupuesto a coste real, sin margen oculto.',
    image: '/images/platforms/douyin-ecosystem/ocean-engine.png',
    bg: '#1A1A1A', iconBg: 'rgba(255,255,255,0.1)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.6)', linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
  },
  {
    name: 'Xingtu',
    chineseName: '星图',
    description: 'El marketplace oficial de creadores en Douyin. Identificamos los perfiles relevantes, detectamos seguidores falsos y revisamos sus campañas pasadas. Usted valida antes de cerrar nada.',
    image: '/images/platforms/douyin-ecosystem/xingtu.png',
    bg: '#E8E0D8', iconBg: '#FFFFFF', textColor: '#1A1A1A', descColor: '#5C5C5C', linkColor: '#CC3333',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    name: 'DOU+',
    chineseName: '抖加',
    description: 'La herramienta nativa para testear un vídeo con una audiencia ampliada. Un presupuesto pequeño basta para leer las primeras señales. Si la tracción confirma, se acelera; si no, se cambia de palanca.',
    image: '/images/platforms/douyin-ecosystem/dou-plus.png',
    bg: '#B02D2D', iconBg: 'rgba(255,255,255,0.2)', textColor: '#FFFFFF', descColor: 'rgba(255,255,255,0.8)', linkColor: '#FFFFFF',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const services = [
  {
    title: 'Apertura de cuenta y estrategia',
    description: 'Abrimos y certificamos su cuenta de empresa, tramitamos los pasos de cumplimiento y construimos la estrategia editorial. Pilares de contenido, calendario, cadencia semanal, objetivos medibles.',
    result: 'Una cuenta Douyin certificada, operativa, con una hoja de ruta clara.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/></svg>`,
    image: '/images/platforms/douyin-services/setup-strategy.png',
  },
  {
    title: 'Producción de contenido',
    description: 'Vídeos pensados para Douyin, grabados por nuestro equipo en China. Demos de producto, secuencias lifestyle, tutoriales, detrás de cámaras, miniseries. HubStudio.ai asume visuales y primeras versiones. Redactores nativos revisan cada pieza.',
    result: 'Vídeos cortos, locales, diseñados para Douyin.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
    image: '/images/platforms/douyin-services/content-production.png',
  },
  {
    title: 'Live commerce',
    description: 'Preparamos y operamos sus lives de venta. Elección del presentador, guion de producto, interacción en directo, balance numérico tras cada emisión. Pensado para lanzamientos, hitos comerciales y ventas recurrentes.',
    result: 'Lives que convierten espectadores en compradores.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>`,
    image: '/images/platforms/douyin-services/live-commerce.png',
  },
  {
    title: 'Campañas con KOL y KOC',
    description: 'Identificamos creadores vía Xingtu y nuestra propia red sobre el terreno, construida a largo plazo. Cada perfil pasa por la lupa: seguidores falsos, historial de campañas, encaje con su marca. Usted valida la selección antes del cierre.',
    result: 'Campañas con interacción real y resultados medibles.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    image: '/images/platforms/douyin-services/kol-campaigns.png',
  },
  {
    title: 'Publicidad',
    description: 'Publicidad en Ocean Engine, la herramienta de ByteDance. TopView para grandes lanzamientos, In-Feed Ads para el tráfico diario, Search Ads para el comprador en intención, DOU+ para testear, Branded Effects para activar la comunidad. Presupuesto a coste real.',
    result: 'Campañas segmentadas, con reporting transparente línea a línea.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    image: '/images/platforms/douyin-services/advertising.png',
  },
  {
    title: 'Douyin Shop',
    description: 'Su tienda en la app, conectada con todo lo demás. Nos ocupamos del montaje, las fichas de producto, el pricing y la optimización continua. Cada vídeo y cada live producidos remite directamente a sus productos.',
    result: 'Una tienda que convierte espectadores en clientes, sin fricción.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
    image: '/images/platforms/douyin-services/douyin-shop.png',
  },
];

const bestPractices = [
  { title: 'Todo se decide en el primer segundo.', description: 'Empiece con movimiento, una pregunta, un visual que retenga. Nunca con un logo. El espectador desconecta antes de captar el mensaje.' },
  { title: 'Vertical, sin excepción. Formato 9:16.', description: 'Un vídeo que parezca un anuncio de televisión reciclado no encuentra público. Douyin se consume en vertical, sin discusión.' },
  { title: 'De tres a cinco publicaciones por semana, mínimo.', description: 'El algoritmo premia la regularidad. Una semana de parón y el alcance se contrae de golpe.' },
  { title: 'El visionado completo sigue siendo la señal decisiva.', description: 'El algoritmo mide ante todo la proporción de espectadores que llegan al final. Toda segundo que no se merezca el siguiente hay que cortarlo.' },
  { title: 'Las tendencias aguantan un instante.', description: 'Cada mañana revisamos sonidos, hashtags y formatos emergentes. Coger una tendencia al principio multiplica el alcance por diez, a veces por cien.' },
  { title: 'El producto va detrás del interés, nunca delante.', description: 'La venta frontal no funciona en Douyin. Lo que prende informa primero, divierte a veces. El producto va después, en ese orden.' },
  { title: 'El sonido pesa tanto como la imagen.', description: 'Douyin no se ve en silencio. Música, voz en off, firma sonora: tanto como lo que aparece en pantalla.' },
  { title: 'Escrito en mandarín, nunca traducido.', description: 'Un contenido traducido del inglés no despega. Los redactores nativos escriben directamente en mandarín, en el registro que suena bien.' },
];

const steps = [
  {
    number: '01',
    title: 'Llamada inicial.',
    description: 'Nos presenta su marca, objetivos y posición actual en China. Sin discurso comercial, solo las preguntas adecuadas.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    number: '02',
    title: 'Propuesta.',
    description: 'Alcance preciso, precio fijo. Cada entregable detallado por escrito. Sabe lo que recibe antes de firmar.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    number: '03',
    title: 'Al aire en dos semanas.',
    description: 'Cuentas configuradas, primer vídeo publicado. Quince días entre la firma y el aire.',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC3333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const faqs = [
  { q: '¿Quién opera nuestra cuenta a diario?', a: 'Nuestro equipo en China. Redactores nativos que producen contenido y pilotan campañas en Douyin todos los días. Un responsable de cuenta dedicado conoce su marca a fondo.' },
  { q: '¿Hace falta licencia comercial china?', a: 'Para una cuenta de empresa hace falta licencia china o pasar por una agencia autorizada. Cubrimos ambos casos. Puede publicar y emitir publicidad sin crear entidad local.' },
  { q: '¿Qué distingue a TheRedScroll?', a: 'Alcance claro, precio fijo. Equipo sobre el terreno en China. Producción asistida por IA, revisada por nativos. Hemos analizado 37 agencias del sector: ninguna ofrece paquetes a precio fijo.' },
  { q: '¿Cuánto se tarda en ver resultados?', a: 'La mayoría de marcas ve las primeras tracciones entre ocho y doce semanas. Las campañas de pago pueden dar resultados en días. Depende de la categoría y de las metas.' },
  { q: '¿Cuáles son las tarifas?', a: 'Paquetes a precio fijo, con el detalle de cada entregable. La inversión en medios se factura a coste real, aparte. Sin margen oculto. Reserve una llamada y le orientaremos al paquete adecuado.' },
  { q: '¿Se puede emitir publicidad sin entidad en China?', a: 'Sí. Las marcas internacionales emiten a través de nuestra estructura como agencia autorizada. Sin entidad local.' },
  { q: '¿Qué formatos de contenido producen?', a: 'Demos de producto, vídeos lifestyle, tutoriales, miniseries, colaboraciones con KOL y lives de venta. Todo en mandarín, por nuestro equipo en China. La IA marca el ritmo; un ojo humano valida cada pieza.' },
  { q: '¿Cómo eligen a los KOL?', a: 'Vía Xingtu y nuestra propia red. Cada creador pasa por la lupa: seguidores falsos, calidad de interacción, datos demográficos, encaje con la marca. Usted valida la lista final. Nada sale sin su visto bueno.' },
  { q: '¿Pueden crear un Douyin Shop?', a: 'Sí. Montaje, fichas, pricing, optimización continua. Todo conectado a la estrategia de contenido para que cada vídeo lleve a sus productos.' },
  { q: '¿Cómo son sus informes?', a: 'Mensuales. Cifras nítidas. Seguidores, visualizaciones, interacción, ROAS, conversiones. Lo que funcionó, lo que no, lo que ajustamos al mes siguiente.' },
];
---

<PageLayout
  title="Agencia de marketing Douyin | TheRedScroll"
  description="TheRedScroll pilota cuentas de Douyin desde Shanghái. Producción de vídeo, live commerce, campañas con KOL, publicidad, Douyin Shop. Alcance firme, precio fijo."
  lang="es"
>
  <section class="w-full bg-[#1A1A1A] py-[80px] max-[640px]:py-[48px] relative overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center opacity-[0.2]" style="background-image: url('/images/hero/douyin-hero.png')" aria-hidden="true"></div>
    <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[140px] max-[640px]:text-[80px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap" aria-hidden="true">
      抖音
    </span>
    <Container class="relative z-[1]">
      <div class="max-w-[800px] mx-auto text-center">
        <a href="/es/plataformas/otras/" class="inline-flex items-center gap-[6px] text-[13px] text-[#5C5C5C] mb-[16px] transition-colors duration-150 hover:text-[#FFFFFF]">
          &larr; Todas las plataformas
        </a>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">
          Marketing Douyin
        </p>
        <UpdatedDate lang="es" date="mayo de 2026" variant="light" class="mb-[8px]" />
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[#FFFFFF] mb-[8px]">
          Douyin: 750 millones de personas al día. Vídeo, live commerce y la ruta más corta de la pantalla al carrito.
        </h1>
        <p class="text-[14px] text-[rgba(255,255,255,0.6)] font-normal mb-[24px]">
          Pilotamos cuentas Douyin desde Shanghái, todos los días, para las marcas que quieren convertir visualizaciones en ventas.
        </p>
        <Button variant="primary" href="/es/contacto/">Agendar una llamada</Button>
      </div>
    </Container>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="flex items-end justify-between gap-[32px] max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-[16px] mb-[32px]">
        <div class="max-w-[560px]">
          <SectionBar />
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[8px]">
            Cifras enormes, sí. Pero también el canal donde se decide la compra en cuestión de segundos.
          </h2>
          <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6]">
            Douyin en cifras.
          </p>
        </div>
        <Button variant="primary" href="/es/contacto/" class="shrink-0">Agendar una llamada</Button>
      </div>
    </Container>

    <div class="relative">
      <div class="absolute right-0 top-0 bottom-0 w-[80px] bg-gradient-to-l from-[#FFFFFF] to-transparent z-[1] pointer-events-none" aria-hidden="true"></div>
      <div class="overflow-x-auto scrollbar-hide" id="stats-scroll">
        <div class="flex gap-[16px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pb-[8px]" style="min-width: min-content;">
          {stats.map((stat, i) => (
            <div class="stat-card relative shrink-0 w-[220px] max-[640px]:w-[180px] h-[200px] max-[640px]:h-[170px] rounded-[12px] overflow-hidden flex flex-col justify-end cursor-grab select-none" data-stat-index={i}>
              <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out stat-bg" style={`background-image: url('${stat.image}')`} aria-hidden="true"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(26,26,26,0.9)] via-[rgba(26,26,26,0.4)] to-transparent" aria-hidden="true"></div>
              <div class="relative z-[1] p-[20px]">
                <span class="text-[32px] text-[#FFFFFF] font-medium leading-none stat-counter block mb-[4px]" data-target={stat.value}>0</span>
                <span class="text-[12px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.4]">{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="El ecosistema Douyin">
          ¿Qué herramientas ofrece Douyin para contenido y comercio?
        </SectionHeading>
      </div>

      <div class="grid grid-cols-3 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1 gap-[16px]">
        {ecosystem.map((item) => (
          <div class="eco-card relative border-none overflow-hidden flex flex-col justify-between" style={`border-radius: ${item.bg === '#1A1A1A' || item.bg === '#CC3333' || item.bg === '#B02D2D' ? '12px' : '10px'}`} data-tilt-eco>
            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out eco-bg" style={`background-image: url('${item.image}')`} aria-hidden="true"></div>
            <div class="absolute inset-0" style={`background: ${item.bg}; opacity: 0.72`} aria-hidden="true"></div>
            <div class="relative z-[1] p-[24px] max-[640px]:p-[20px]">
              <div class="w-[40px] h-[40px] rounded-[6px] flex items-center justify-center mb-[16px]" style={`background: ${item.iconBg}`}>
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="text-[18px] font-medium leading-[1.3] mb-[4px]" style={`color: ${item.textColor}`}>{item.name}</h3>
              <span class="text-[12px] font-normal mb-[8px] block" style={`color: ${item.descColor}`}>{item.chineseName}</span>
              <p class="text-[13px] font-normal leading-[1.5]" style={`color: ${item.descColor}`}>{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="text-center mb-[48px] max-[640px]:mb-[32px]">
        <div class="flex justify-center mb-[12px]">
          <SectionBar />
        </div>
        <SectionHeading overline="Lo que hacemos en Douyin">
          Seis servicios. Cada uno con un entregable preciso.
        </SectionHeading>
      </div>

      <div class="grid grid-cols-[340px_1fr] max-[1024px]:grid-cols-[280px_1fr] max-[768px]:hidden gap-[24px] items-stretch">
        <div class="flex flex-col gap-[4px]">
          {services.map((service, i) => (
            <button class:list={['svc-selector flex items-center gap-[12px] px-[16px] py-[14px] rounded-[8px] text-left cursor-pointer border-none transition-all duration-300 relative', i === 0 ? 'svc-selector-active' : '']} data-svc-select={i} style={i === 0 ? 'background: #F7F2EE' : 'background: transparent'}>
