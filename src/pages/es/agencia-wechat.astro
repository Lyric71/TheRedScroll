---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 1.4, decimals: 1, suffix: 'B', label: 'usuarios activos cada mes' },
  { value: 945, decimals: 0, suffix: 'M', label: 'usuarios de Mini Programs al mes' },
  { value: 18, decimals: 0, suffix: '', label: 'plataformas chinas que operamos' },
  { value: 4, decimals: 0, suffix: ' semanas', label: 'de la firma a la primera publicación' },
];

const scopeItems = [
  { label: 'Alta y verificación de la Cuenta Oficial', href: '/es/plataformas/wechat/' },
  { label: 'Contenido firmado por redactores chinos nativos', href: '/es/servicios/produccion-contenido/' },
  { label: 'Moments Ads, Official Account Ads y Mini Program Ads', href: '/es/servicios/publicidad/' },
  { label: 'Mini Programs y comercio electrónico en WeChat', href: '/es/plataformas/wechat/' },
  { label: 'CRM sobre WeCom y tráfico privado', href: '/es/servicios/crm-dominio-privado/' },
];

const services = [
  {
    glyph: '号',
    title: 'Alta y verificación de la Cuenta Oficial',
    tag: 'Operativa en una o dos semanas',
    description:
      'Damos de alta su Service Account, montamos el expediente para Tencent y seguimos el trámite hasta la verificación. Menús, respuestas automáticas e identidad de marca incluidos. Casi todas las cuentas quedan listas en una o dos semanas.',
    deliverables: ['Alta de la cuenta', 'Verificación de Tencent', 'Menús y respuestas automáticas', 'Identidad de marca'],
    image: '/images/wechat-agency/service-setup.webp',
    imageAlt: 'Teléfono sobre una mesa de trabajo, junto a documentos societarios, con el perfil verificado de una Cuenta Oficial de WeChat',
  },
  {
    glyph: '文',
    title: 'Contenido y CRM',
    tag: 'Redactores chinos nativos',
    description:
      'Líneas editoriales, calendario, artículos, piezas gráficas y vídeo. Escriben chinos nativos, no traductores. Cada seguidor nuevo pasa a WeCom. Así se construye una cartera de clientes que ninguna plataforma puede arrebatarle.',
    deliverables: ['Calendario editorial', 'Artículos', 'Piezas gráficas y vídeo', 'Puesta en marcha de WeCom'],
    image: '/images/wechat-agency/service-content.webp',
    imageAlt: 'Mesa de redacción con un teléfono que muestra el artículo de una marca en su Cuenta Oficial de WeChat',
  },
  {
    glyph: '广',
    title: 'Publicidad en WeChat',
    tag: 'Medios a coste real, sin margen',
    description:
      'Plan de medios, creatividades, pruebas A/B y gestión de pujas en Moments Ads, Official Account Ads y Mini Program Ads. La inversión en medios se factura a coste real. Nunca aplicamos margen.',
    deliverables: ['Plan de medios', 'Creatividades', 'Pruebas A/B', 'Gestión de pujas'],
    image: '/images/wechat-agency/service-ads.webp',
    imageAlt: 'Una mano sostiene un teléfono en una cafetería y el feed de Moments de WeChat muestra un anuncio patrocinado de marca',
  },
  {
    glyph: '店',
    title: 'Mini Programs y comercio electrónico',
    tag: '945M de usuarios cada mes',
    description:
      'Tiendas, captación de contactos, reservas y programas de fidelización, construidos dentro de WeChat y conectados a WeChat Pay. Cada mes, 945 millones de personas abren un Mini Program. Sus lectores tienen adónde ir después del artículo.',
    deliverables: ['Tienda en la app', 'WeChat Pay', 'Captación de contactos', 'Fidelización'],
    image: '/images/wechat-agency/service-miniprogram.webp',
    imageAlt: 'Dos teléfonos, lado a lado, con la tienda de un Mini Program de WeChat y un pago completado en WeChat Pay',
  },
  {
    glyph: '播',
    title: 'Campañas con KOL y promoción cruzada',
    tag: 'Solo interacción verificada',
    description:
      'Localizamos Key Opinion Leaders (KOL), comprobamos sus cifras, redactamos los briefs y medimos los resultados. Solo aceptamos datos de interacción verificados. Cuando una cifra de seguidores huele a compra, descartamos el perfil.',
    deliverables: ['Selección de KOL', 'Verificación', 'Briefs de campaña', 'Informes'],
    image: '/images/wechat-agency/service-kol.webp',
    imageAlt: 'Una creadora graba un vídeo de producto junto a un teléfono que emite un directo en WeChat Channels',
  },
];

const segments = [
  {
    title: 'Retail B2C y lujo',
    description: 'El comprador chino consulta WeChat antes de decidirse. Levantamos la Cuenta Oficial, el contenido y la tienda en Mini Program que rematan esa venta.',
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  },
  {
    title: 'B2B e industria',
    description: 'Un ciclo de venta largo exige un canal de seguimiento. Artículos en WeChat y contactos en WeCom convierten las tarjetas de una feria en oportunidades reales.',
    icon: '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
  },
  {
    title: 'Turismo y educación',
    description: 'El viajero y el estudiante chinos se informan en WeChat meses antes de decidir. Mantenemos su marca dentro de esa conversación.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'Comercio transfronterizo',
    description: 'Venda en China sin sociedad local. Las tiendas en Mini Program y el WeChat Pay transfronterizo lo permiten.',
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  },
];

const pillars = [
  {
    title: 'Un alcance de trabajo claro',
    description: 'Cada entregable queda por escrito antes de empezar: artículos, vídeos, campañas, informes. Sabe con exactitud qué recibe cada mes.',
  },
  {
    title: 'Precio fijo, sin sorpresas',
    description: 'Una cuota mensual por paquete. Sin tarifas por hora, sin extras cuando cambia el alcance, sin facturas que nadie esperaba.',
  },
  {
    title: 'Producción de contenido con IA',
    description: 'Imágenes y vídeo con HubStudio.ai: los costes bajan y la producción se acelera. La estrategia es 100% humana.',
  },
  {
    title: 'Equipo sobre el terreno',
    description: 'Shanghái y Hong Kong. Nativos que viven en WeChat a diario, con trato directo con los KOL y acceso a la plataforma en tiempo real.',
  },
];

const steps = [
  {
    title: 'Llamada inicial',
    description: 'Treinta minutos. Háblenos de su marca, de sus objetivos y de dónde está hoy en China. Sin discurso comercial.',
  },
  {
    title: 'Propuesta',
    description: 'Un alcance de trabajo claro. Precio fijo. Cada entregable por escrito. Sabe qué recibe y cuánto paga antes de comprometerse.',
  },
  {
    title: 'En el aire en 4 semanas',
    description: 'Puesta en marcha, alta de la cuenta, verificación y primer contenido publicado. Cuatro semanas entre la firma y la primera publicación.',
  },
];

const caseStudies = [
  {
    client: 'JAC Motors',
    image: '/images/clients/JAC/JAC-Wechat-4.webp',
    imageAlt: 'Publicación de JAC Motors en WeChat producida por TheRedScroll',
    metric: '10M',
    metricLabel: 'vehículos vendidos, comunidad reconstruida',
    summary: 'Un gigante chino del automóvil, con 10 millones de vehículos vendidos y unas redes apagadas. Reconstruimos su comunidad en WeChat, RedNote y Weibo con contenido producido con IA.',
    href: '/es/proyectos/jac-motors/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Imagen de campaña del lanzamiento de Mission Foods en China',
    metric: 'Gen Z',
    metricLabel: 'campañas para estrenar una categoría de alimentación',
    summary: 'Lanzar en China los chips de maíz, una categoría que allí nadie conocía. Campañas para la Generación Z y contenido de maridaje en WeChat, RedNote y Weibo.',
    href: '/es/proyectos/mission-foods/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Imagen de campaña de Camper para las redes sociales chinas',
    metric: '187K',
    metricLabel: 'seguidores, frente a 43K hace 18 meses',
    summary: 'Una marca europea de calzado pasó de 43.000 a 187.000 seguidores en 18 meses. La interacción subió del 1,2% al 4,7% y las ventas comparables crecieron un 31% en un año.',
    href: '/es/proyectos/camper/',
  },
];

const faqs = [
  {
    q: '¿Hace falta una licencia comercial china para abrir una Cuenta Oficial de WeChat?',
    a: 'No. Una empresa extranjera puede dar de alta una Service Account con su licencia comercial de origen. Bastan los documentos de registro de la sociedad, el documento de identidad del representante legal y una prueba de titularidad de la marca. La entidad china solo se exige para las cuentas Subscription, para cobrar como comercio local en WeChat Pay y para ciertos formatos publicitarios.',
  },
  {
    q: '¿En qué se diferencian una cuenta Subscription y una Service?',
    a: 'Las cuentas Subscription publican a diario, pero acaban plegadas en una carpeta y están reservadas a entidades chinas. Las Service Accounts publican cuatro veces al mes, llegan directamente a la lista de chats y admiten menús propios, WeChat Pay y herramientas de CRM. Son el único tipo que una empresa extranjera puede abrir por sí misma. Para la mayoría de las marcas, además, son la mejor opción.',
  },
  {
    q: '¿Cuánto cuesta el marketing en WeChat?',
    a: 'Hay dos presupuestos. El trabajo de agencia: fijamos una cuota mensual sobre un alcance de trabajo detallado, de modo que conoce cada entregable y el coste total antes de firmar. La inversión publicitaria: los Moments Ads funcionan por puja, con presupuestos de entrada en torno a 1.000 RMB al día. Los emplazamientos premium reservados parten de unos 50.000 RMB por campaña. Los medios se facturan siempre aparte, a coste real y sin margen.',
  },
  {
    q: '¿Cuánto tardan el alta y la verificación de la cuenta?',
    a: 'Con el expediente completo, el registro y la verificación de Tencent se resuelven en una o dos semanas. La causa más frecuente de retraso es un papeleo incompleto o incoherente, así que lo revisamos todo antes de presentarlo. Si su cuenta ya está verificada, podemos publicar en cuestión de días.',
  },
  {
    q: '¿Pueden llevar WeChat si no tengo equipo en China?',
    a: 'Sí, es el caso más común entre nuestros clientes. Nuestro equipo de Shanghái y Hong Kong opera su cuenta a diario: estrategia, contenido, publicación, atención a la comunidad, anuncios e informe mensual en lenguaje llano. Dispone de un responsable dedicado y de visibilidad total, sin contratar a nadie en China.',
  },
  {
    q: '¿De quién son la cuenta de WeChat y sus seguidores?',
    a: 'Suyos. La cuenta se registra a nombre de su empresa, con sus propios documentos; nosotros la operamos por usted. Si algún día cada uno sigue su camino, usted se queda con la cuenta, los seguidores y todo el archivo de contenido.',
  },
  {
    q: '¿Aceptan hacerse cargo de una cuenta de WeChat que ya existe?',
    a: 'Sí. Arrancamos con una auditoría: estado de la verificación, calidad de los seguidores, historial de contenido y riesgos de cumplimiento. Corregimos lo necesario y asumimos la publicación. La mayoría de los traspasos queda cerrada en una semana, sin cortes para sus seguidores.',
  },
  {
    q: '¿Conviene empezar por WeChat o por RedNote y Douyin?',
    a: 'Depende del objetivo. En WeChat el consumidor chino lee, pregunta y compra, así que suele hacer de cuartel general. RedNote y Douyin sirven para el descubrimiento y traen público nuevo. La mayoría de nuestros clientes convierte WeChat en su eje y añade alrededor plataformas de descubrimiento.',
  },
  {
    q: '¿Qué es el tráfico privado y por qué importa?',
    a: 'Son los seguidores a los que puede dirigirse sin pagar un anuncio cada vez. En la práctica: llevar a sus seguidores de WeChat a grupos de WeCom y a conversaciones individuales. Esa lista le pertenece. Ningún cambio de algoritmo se la quita.',
  },
  {
    q: '¿Cómo rinden cuentas de los resultados?',
    a: 'Con un informe mensual en lenguaje llano: crecimiento de seguidores, lecturas de los artículos, interacción, inversión publicitaria a coste real y, cuando el seguimiento lo permite, contactos comerciales y ventas. Además dispone de un responsable dedicado al que escribir en cualquier momento.',
  },
];
---

<PageLayout
  title="Agencia WeChat para crecer en China | TheRedScroll"
  description="Agencia WeChat con equipo en Shanghái y Hong Kong. Alta de la Cuenta Oficial, contenido, anuncios, Mini Programs y CRM. Circuito cerrado y precio fijo."
  lang="es"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      微信
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">微</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Agencia WeChat</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            La agencia WeChat de las marcas que crecen en China
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Alta de la Cuenta Oficial, contenido, publicidad, Mini Programs y CRM. Lo operamos todo a diario desde Shanghái y Hong Kong. Circuito cerrado. Precio fijo.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/es/contacto/">Agendar una llamada</Button>
            <Button variant="secondary-dark" href="#results">Ver resultados</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Una llamada de treinta minutos. Sin discurso comercial.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/wechat-agency/hero-phones-blend.webp"
            alt="Dos teléfonos con pantallas reales de WeChat: el feed de Moments con un anuncio patrocinado y un pago completado en WeChat Pay"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Por qué empezar por WeChat
          </p>
          <p class="manifesto" data-manifesto>
            En China, WeChat no es una app: es internet. Sus clientes conversan, leen, compran y pagan sin salir de ella. Para ellos, una marca que no está en WeChat es <span class="manifesto-hl">invisible</span>.
          </p>
        </div>
        <div>
          <img
            src="/images/wechat-agency/ecosystem-banner-tight.webp"
            alt="Tres teléfonos alineados con las tres caras de WeChat: el feed de Moments, un artículo de Cuenta Oficial y un pago completado en WeChat Pay"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Una sola app, tres oficios: red social, canal de publicación y medio de pago.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Una sola agencia para todo lo que ocurre en WeChat
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Una agencia WeChat da de alta su cuenta, produce su contenido, lleva sus anuncios y construye su Mini Program. Hacerlo todo en casa exige contratar nativos, dominar las reglas de Tencent y comprar la publicidad a través de una cuenta china.
            </p>
            <p>
              La mayoría de las marcas llega más lejos, y antes, con un especialista. Ese especialista somos nosotros. Publicamos en <a href="/es/plataformas/wechat/" class="text-[#CC3333] hover:underline">WeChat</a> cada día, desde dentro de China.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Qué cubrimos, de un vistazo
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Nuestros servicios en WeChat</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Cinco servicios, cada uno con entregables concretos
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Todo queda recogido en su alcance de trabajo antes de firmar. Nada de contratos ambiguos.
              </p>
            </div>
            <div class="svc-frame relative max-[900px]:hidden">
              <div class="relative w-full aspect-[1344/570] rounded-[10px] overflow-hidden bg-[#FFFFFF]">
                {services.map((service, i) => (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="1344"
                    height="570"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    class:list={['svc-img absolute inset-0 w-full h-full object-cover', i === 0 && 'is-active']}
                    data-svc-img={i}
                  />
                ))}
              </div>
            </div>
            <div class="flex items-center gap-[16px] mt-[24px] max-[900px]:hidden">
              <div class="flex gap-[6px] grow" aria-hidden="true">
                {services.map((_, i) => (
                  <span class:list={['svc-tick', i === 0 && 'is-active']} data-svc-tick={i}></span>
                ))}
              </div>
              <p class="text-[13px] text-[#5C5C5C] font-normal leading-none m-0 shrink-0" data-svc-caption aria-hidden="true">{services[0].title}</p>
            </div>
          </div>
        </div>

        <!-- Scrolling step cards -->
        <div class="flex flex-col gap-[16px]">
          {services.map((service, i) => (
            <div class:list={['svc-step bg-[#FFFFFF] rounded-[10px] p-[32px] max-[640px]:p-[20px]', i === 0 && 'is-active']} data-svc-step={i}>
              <div class="flex items-center gap-[12px] mb-[16px]">
                <span class="svc-seal" aria-hidden="true">{service.glyph}</span>
                <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">{service.tag}</span>
              </div>
              <h3 class="text-[22px] max-[640px]:text-[19px] font-medium leading-[1.25] text-[#1A1A1A] mb-[10px]">{service.title}</h3>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.65] max-w-[480px] mb-[16px]">{service.description}</p>
