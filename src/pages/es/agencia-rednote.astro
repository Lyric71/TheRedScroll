---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 350, decimals: 0, suffix: 'M+', label: 'usuarios activos al mes' },
  { value: 1, decimals: 0, suffix: 'B+', label: 'búsquedas cada mes' },
  { value: 70, decimals: 0, suffix: '%', label: 'de usuarios de 18 a 35 años' },
  { value: 2, decimals: 0, suffix: ' semanas', label: 'de la firma a la primera nota publicada' },
];

const platformNames = [
  { name: '小红书 (Xiǎohóngshū)', detail: 'El nombre oficial en chino. Romanizado como Xiaohongshu o Xiao Hong Shu.' },
  { name: 'Little Red Book', detail: 'La traducción literal al inglés de 小红书.' },
  { name: 'RED', detail: 'El primer nombre internacional de la plataforma. Aún aparece en la prensa.' },
  { name: 'RedNote', detail: 'El nombre oficial en inglés desde enero de 2025. Es el que usamos.' },
];

const services = [
  {
    glyph: '号',
    title: 'Apertura y verificación de cuenta',
    tag: 'Operativa en 2 semanas',
    description:
      'Registramos su Professional Account (企业号, Blue V), traducimos su licencia comercial extranjera, preparamos los documentos de marca y acompañamos el expediente durante la revisión de la plataforma. La mayoría de las cuentas queda operativa en 2 semanas.',
    deliverables: ['Professional Account', 'Verificación Blue V', 'Traducción de la licencia', 'Revisión de la plataforma'],
    image: '/images/platforms/rednote-services/account-setup.webp',
    imageAlt: 'Teléfono con el perfil verificado de una Professional Account de RedNote con insignia Blue V, junto a documentos de registro mercantil',
  },
  {
    glyph: '达',
    title: 'Campañas KOL y KOC',
    tag: 'Creadores verificados vía Pugongying',
    description:
      'Campañas con Key Opinion Leaders (KOL) y Key Opinion Consumers (KOC) gestionadas a través de Pugongying, el mercado oficial de influencers de la plataforma. Más de 100.000 creadores verificados, con detección de seguidores falsos en cada preselección.',
    deliverables: ['Preselección de KOL', 'Siembra con KOC', 'Control de seguidores falsos', 'Informes de campaña'],
    image: '/images/platforms/rednote-services/kol-koc.webp',
    imageAlt: 'Creadora de contenido grabando una nota de reseña de producto para una campaña KOL en RedNote',
  },
  {
    glyph: '记',
    title: 'Creación de contenido y localización',
    tag: 'Mandarín nativo, no traducción',
    description:
      'Notas (笔记), vídeos e imágenes redactados directamente en mandarín, nunca traducidos del inglés. Visuales AIGC con HubStudio.ai. Rodajes reales en China. Contenido pensado para el 种草, «sembrar el deseo de compra», la cultura de recomendación boca a boca que define la plataforma.',
    deliverables: ['Notas y vídeo', 'Visuales AIGC', 'Rodajes reales', 'Contenido 种草'],
    image: '/images/platforms/rednote-services/content-strategy.webp',
    imageAlt: 'Mesa de redacción con un teléfono que muestra una nota de RedNote redactada en mandarín',
  },
  {
    glyph: '广',
    title: 'Publicidad de pago',
    tag: 'Inversión facturada a coste, sin margen',
    description:
      'In-Feed Ads (信息流广告), Search Ads y Brand Ads a través de la plataforma publicitaria Juguang. Test de creatividades, gestión de pujas y ajustes en tiempo real. La inversión se factura a coste real. Sin margen, nunca.',
    deliverables: ['In-Feed Ads', 'Search Ads', 'Brand Ads', 'Test de creatividades'],
    image: '/images/platforms/rednote-services/paid-advertising.webp',
    imageAlt: 'Teléfono con un anuncio In-Feed patrocinado dentro de la parrilla de descubrimiento de RedNote',
  },
  {
    glyph: '店',
    title: 'E-commerce e integración de tienda',
    tag: 'Comercio en directo integrado',
    description:
      'Montaje de la tienda dentro de la app, notas comprables y producción de comercio en directo. Los directos generan el 90% de las ventas dentro de la app, así que el contenido conduce a la compra sin salir de RedNote.',
    deliverables: ['Tienda en la app', 'Notas comprables', 'Sesiones en directo', 'Montaje transfronterizo'],
    image: '/images/platforms/rednote-services/ecommerce-live.webp',
    imageAlt: 'Teléfono con una sesión de comercio en directo de RedNote junto a una tienda de producto dentro de la app',
  },
  {
    glyph: '数',
    title: 'Informes y analítica',
    tag: 'Informes en lenguaje claro',
    description:
      'Crecimiento de seguidores, interacción, posiciones de búsqueda y ROI de campaña en un informe mensual, en lenguaje claro. La escucha social cubre menciones de marca, sentimiento y movimientos de la competencia.',
    deliverables: ['Crecimiento e interacción', 'Posiciones de búsqueda', 'ROI de campaña', 'Escucha social'],
    image: '/images/platforms/rednote-services/analytics-listening.webp',
    imageAlt: 'Portátil con un panel de analítica de RedNote: crecimiento de seguidores, interacción y posiciones de búsqueda',
  },
];

const industries = [
  {
    title: 'Belleza y cosmética',
    description: 'La mayor categoría de la plataforma. Reseñas, tutoriales y análisis de ingredientes.',
    icon: '<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>',
  },
  {
    title: 'Moda y confección',
    description: 'Contenido de estilismo, lookbooks de temporada y siembra con KOC.',
    icon: '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>',
  },
  {
    title: 'Alimentación y bebidas',
    description: 'Reseñas de restaurantes, recetas y catas de producto.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Viajes y turismo',
    description: 'Guías de destinos y reseñas de hoteles. El 64% de los viajeros chinos usa RedNote para planificar sus viajes.',
    icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  },
  {
    title: 'Lujo',
    description: 'Contenido narrativo para una audiencia pudiente y con alta intención de compra.',
    icon: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
  },
  {
    title: 'Salud y bienestar',
    description: 'Fitness, suplementos y consejos de bienestar. Una vertical en pleno crecimiento.',
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
  },
];

const pillars = [
  {
    title: 'SOW claro',
    description: 'Cada entregable queda definido desde el inicio en el SOW, el «alcance de trabajo». Notas, vídeos, activaciones KOL, campañas, informes. Sabe con exactitud qué recibe cada mes.',
  },
  {
    title: 'Precio fijo, sin sorpresas',
    description: 'Un precio por paquete. Sin tarifas por hora, sin extras por cambios de alcance, sin facturas inesperadas.',
  },
  {
    title: 'Producción de contenido con IA',
    description: 'Imágenes y vídeo con HubStudio.ai, que abarata costes y acelera la producción. La estrategia es 100% humana.',
  },
  {
    title: 'Equipo sobre el terreno',
    description: 'Shanghái y Hong Kong. Nativos bilingües que publican en RedNote cada día, con relación directa con los KOL y acceso a la plataforma en tiempo real.',
  },
];

const steps = [
  {
    title: 'Auditoría y estrategia',
    description:
      'Una llamada inicial de 30 minutos y después una auditoría de categoría: palabras clave de búsqueda, cuentas competidoras y huecos de contenido. Recibirá una propuesta a precio fijo con cada entregable detallado.',
  },
  {
    title: 'Cuenta y contenido',
    description:
      'Nos ocupamos del papeleo de la Professional Account, definimos sus pilares de contenido y producimos el primer lote de notas. Operativo en las 2 semanas siguientes a la firma.',
  },
  {
    title: 'Lanzamiento y activación KOL',
    description:
      'Un ritmo de publicación constante entrena al algoritmo en su categoría. La siembra con KOC y los impulsos de pago traen tráfico mientras la parte orgánica coge velocidad.',
  },
  {
    title: 'Optimización y escalado',
    description:
      'Seguimos los datos de interacción CES y las posiciones de búsqueda, cortamos lo que se estanca y redoblamos la apuesta por los formatos y palabras clave que convierten.',
  },
];

const caseStudies = [
  {
    client: "AGE 20's",
    image: '/images/clients/Age20/Age20-Picture11.webp',
    imageAlt: "Imagen de la campaña de la base Little Milk Brick de AGE 20's para RedNote",
    metric: '750K',
    metricLabel: 'impresiones frente a un objetivo de 300K',
    summary: 'Una marca coreana de belleza que lanzaba su base Little Milk Brick en China. La campaña en RedNote alcanzó 750.000 impresiones frente a un objetivo de 300.000, y el apodo del producto se hizo orgánico.',
    href: '/es/proyectos/age20s/',
  },
  {
    client: 'Camper',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    imageAlt: 'Imagen de la campaña de calzado Camper para las redes sociales chinas',
    metric: '38%',
    metricLabel: 'del tráfico e-commerce desde la audiencia más pequeña',
    summary: 'Una marca europea de calzado que pasó de 43.000 a 187.000 seguidores en 18 meses. RedNote tenía la audiencia más pequeña, pero generó el 38% de todo el tráfico e-commerce.',
    href: '/es/proyectos/camper/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Imagen de la campaña de Mission Foods para su lanzamiento en China',
    metric: 'Gen Z',
    metricLabel: 'campañas para una categoría de alimentación nueva',
    summary: 'Lanzar los chips de maíz, una categoría desconocida, en China. Los KOL de RedNote mostraron el producto en la vida real y el contenido de maridaje lo acercó al paladar local.',
    href: '/es/proyectos/mission-foods/',
  },
];

const faqs = [
  {
    q: '¿Xiaohongshu es lo mismo que RedNote y Little Red Book?',
    a: 'Sí. Xiaohongshu (小红书) es el nombre oficial en chino y Little Red Book, su traducción literal. La compañía se presentó durante años en el extranjero como RED y adoptó RedNote como nombre oficial en inglés en enero de 2025. Xiao Hong Shu es solo la grafía pinyin escrita en tres palabras. Una app, un algoritmo, una audiencia.',
  },
  {
    q: '¿Pueden las marcas extranjeras vender en Xiaohongshu?',
    a: 'Sí. Las empresas extranjeras pueden abrir una Professional Account (Blue V) con una licencia comercial traducida y los documentos de marca, sin entidad china. El programa de e-commerce transfronterizo de la plataforma permite además abrir tienda dentro de la app y enviar desde el extranjero. Nos ocupamos del papeleo, del montaje de la tienda y de la revisión de la plataforma.',
  },
  {
    q: '¿Cuánto cuesta el marketing en Xiaohongshu?',
    a: 'Entran en juego tres presupuestos. El trabajo de agencia: un precio mensual fijo, vinculado a un alcance de trabajo claro. Cada entregable y el coste total quedan a la vista antes de firmar. La inversión publicitaria: facturada aparte, a coste real, a través de la plataforma Juguang, sin margen. Los honorarios de los KOL: varían mucho según el nivel de seguidores y la categoría, y los repercutimos con transparencia, con datos de interacción verificados detrás de cada contratación.',
  },
  {
    q: '¿Cuánto tardan en llegar los resultados?',
    a: 'La plataforma no premia la impaciencia. Las cuentas nuevas pasan por una ventana de observación del algoritmo, así que los primeros 2 o 3 meses construyen su biblioteca de contenido y entrenan al algoritmo en su categoría. Los anuncios y las campañas KOL pueden traer tráfico desde la primera semana mientras la parte orgánica se pone al día. Nuestro compromiso mínimo es de 3 meses justo por esta razón.',
  },
  {
    q: '¿Necesitamos una licencia comercial o una entidad china?',
    a: 'Para la cuenta, no. Una licencia comercial extranjera traducida basta para la Professional Account. La publicidad de pago es la excepción: la plataforma Juguang exige una entidad china para abrir una cuenta publicitaria. Gestionamos cuentas publicitarias en nombre de clientes extranjeros a través de nuestra estructura local, con informes semanales de inversión y visibilidad total.',
  },
  {
    q: '¿Quién usa RedNote y para qué?',
    a: 'Unos 350 millones de personas usan RedNote cada mes. El público central es joven, urbano, femenino en torno al 70 por ciento y con alto poder adquisitivo. La tratan como un buscador de experiencias reales de producto: qué comprar, adónde viajar, qué funciona de verdad. Esa intención de compra explica que las marcas orientadas a conversión empiecen aquí.',
  },
  {
    q: '¿RedNote o Douyin? ¿Cuál conviene a mi marca?',
    a: 'Cumplen funciones distintas. Douyin es vídeo de entretenimiento con un feed algorítmico rápido, hecho para alcance y compra impulsiva. RedNote es más lento y funciona por búsqueda: la gente investiga antes de comprar y una buena nota sigue trayendo tráfico durante meses. Las categorías de alta consideración, como belleza, moda o viajes, suelen empezar en RedNote. Muchas marcas acaban trabajando las dos.',
  },
  {
    q: '¿Cómo funcionan las campañas con KOL y KOC en RedNote?',
    a: 'El trabajo pagado con creadores pasa por Pugongying, el mercado oficial de la plataforma. Contratar por fuera expone el contenido a que la plataforma lo retire. Seleccionamos creadores con datos de audiencia verificados y nos ocupamos de briefs, contratos, pagos e informes por publicación. En RedNote, decenas de reseñas de pequeños KOC suelen pesar más que un solo post de una celebridad.',
  },
  {
    q: '¿Nuestro contenido puede estar en inglés?',
    a: 'Los usuarios chinos buscan en chino, así que las notas en inglés apenas aparecen. Todo lo que publicamos lo escribe en mandarín, de forma nativa, nuestro equipo de Shanghái; nada se traduce. El inglés solo llega a la pequeña audiencia extranjera que se sumó a principios de 2025. Para vender en China sigue siendo una plataforma en mandarín.',
  },
  {
    q: '¿Qué hace que una nota funcione en RedNote?',
    a: 'Palabras clave de búsqueda en el título, una imagen de portada potente y una primera persona que suene a recomendación real. El algoritmo silencia el tono demasiado comercial y la publicidad encubierta se expone a la retirada, así que declaramos las notas comerciales por el cauce oficial de la plataforma. Cada nota se construye sobre un plan de palabras clave y seguimos cuáles posicionan.',
  },
];
---

<PageLayout
  title="Agencia RedNote | Marketing en Xiaohongshu (Little Red Book)"
  description="Haga crecer su marca en RedNote (Xiaohongshu / Little Red Book). Campañas KOL, contenido y anuncios desde Shanghái. Circuito cerrado, precio fijo."
  lang="es"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      小红书
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">红</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Agencia RedNote</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            Agencia de marketing en RedNote (Xiaohongshu / Little Red Book)
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Una plataforma, cuatro nombres, más de 350 millones de usuarios al mes. Gestionamos campañas KOL, contenido, anuncios y comercio social en RedNote para marcas occidentales. Desde Shanghái, cada día. Circuito cerrado. Precio fijo.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/es/contacto/">Agendar una llamada</Button>
            <Button variant="secondary-dark" href="#results">Ver los resultados</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Una llamada de 30 minutos. Sin discurso comercial.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/rednote-agency/hero-phones-blend.webp"
            alt="Dos teléfonos con la app real de RedNote: la parrilla de descubrimiento de notas y una nota de reseña de producto"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Por qué RedNote va primero en el descubrimiento
          </p>
          <p class="manifesto" data-manifesto>
            En China, comprar empieza con una búsqueda en RedNote. 350 millones de personas consultan reseñas reales antes de gastar. Aquí no ganan los anuncios. Gana la <span class="manifesto-hl">confianza</span>. Construimos las notas, reseñas y voces de creadores que la generan.
          </p>
        </div>
        <div>
          <img
            src="/images/rednote-agency/ecosystem-banner-tight.webp"
            alt="Tres teléfonos con el recorrido en RedNote: la parrilla de descubrimiento, una nota de reseña de producto y los resultados de búsqueda"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Una app, tres funciones: feed de descubrimiento, reseñas honestas y búsqueda.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">
            Qué es RedNote
          </p>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Xiaohongshu, Little Red Book, RED y RedNote, explicados
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              RedNote (小红书 / Xiaohongshu) es la plataforma china de descubrimiento de producto. Más de 350 millones de usuarios activos al mes, más de 1.000 millones de búsquedas mensuales y el 90% del contenido creado por usuarios, no por marcas (mayo de 2026).
            </p>
            <p>
              El 70% de los usuarios tiene entre 18 y 35 años, sobre todo mujeres de ciudades de primer y segundo nivel con un poder adquisitivo por encima de la media. Vienen a investigar productos antes de comprar. Las reseñas, los tutoriales y las recomendaciones honestas pesan aquí más que en cualquier otra plataforma china.
            </p>
            <p>
              Véalo así: Douyin es donde el consumidor chino se entretiene, WeChat es donde las marcas retienen a sus clientes y <a href="/es/plataformas/rednote/" class="text-[#CC3333] hover:underline">RedNote</a> es donde se deciden las compras.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Por qué la plataforma tiene tantos nombres
          </p>
          <ul class="flex flex-col gap-[14px] list-none m-0 p-0">
            {platformNames.map((item) => (
              <li>
