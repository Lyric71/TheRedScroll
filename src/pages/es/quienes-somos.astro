---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionBar from '../../components/ui/SectionBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
---

<PageLayout
  title="Quiénes somos | TheRedScroll"
  description="TheRedScroll es una agencia de redes sociales con sede en China. Alcance cerrado, precio fijo, equipo local. Shanghái y Hong Kong, todos los días."
  lang="es"
>

  <!-- Hero -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[500px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll"
      style="background-image: url('/images/team/team-photo.png')"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.82]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Quiénes somos
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Las personas que llevan su marca en China.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Veinticinco años a pie de plataforma. Equipo veterano. Cero subcontratación.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/es/contacto/">Agendar una llamada</Button>
        <Button variant="secondary-dark" href="#equipo">Conocer al equipo</Button>
      </div>
    </div>
  </section>

  <!-- Why we exist -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <div>
          <SectionBar />
          <SectionHeading overline="Por qué existimos">La mayoría de las agencias vende la estrategia. La ejecución acaba en manos de equipos que nunca han abierto Douyin.</SectionHeading>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Una presentación impecable, cuatro frases que suenan bien. Detrás, becarios que ni conocen los códigos de RedNote ni distinguen una plataforma de otra: reciclan el mismo contenido en todas. Seis meses después, nadie sabe explicar dónde se ha ido el presupuesto.
          </p>
        </div>
        <div class="flex flex-col items-end pt-[48px] max-[640px]:pt-[0px]">
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] mb-[32px] w-full">
            <p>
              Fundamos TheRedScroll para romper esa dinámica. Aquí, quien firma la estrategia es quien publica los contenidos. El precio queda cerrado desde el primer día y los resultados se miden con cifras concretas.
            </p>
            <p>
              Trabajo real, visible en las plataformas, día tras día, desde China.
            </p>
          </div>
          <div class="flex items-center gap-[16px]">
            <img
              src="/images/team/Cyril-Drouin-Signature-Transparent.png"
              alt="Firma de Cyril Drouin"
              width="100"
              height="60"
              class="shrink-0"
              style="width: 100px; height: auto; filter: brightness(0) saturate(100%) invert(23%) sepia(95%) saturate(2068%) hue-rotate(346deg) brightness(89%) contrast(89%);"
              loading="lazy"
              decoding="async"
            />
            <div>
              <p class="text-[14px] font-medium text-[var(--color-ink)] leading-[1.4]">Cyril Drouin</p>
              <p class="text-[13px] font-normal text-[var(--color-stone)] leading-[1.4]">Fundador y CEO, TheRedScroll</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our mission -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="Pantallas de teléfono mostrando crecimiento en redes sociales chinas">
          <svg viewBox="0 0 480 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <g transform="translate(20, 40)">
              <rect x="0" y="0" width="130" height="240" rx="16" fill="#1A1A1A" />
              <rect x="4" y="4" width="122" height="232" rx="14" fill="#FFFFFF" />
              <rect x="4" y="4" width="122" height="28" rx="14" fill="#1A1A1A" />
              <circle cx="65" cy="18" r="4" fill="#333" />
              <text x="65" y="50" text-anchor="middle" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif">Douyin</text>
              <rect x="14" y="60" width="102" height="70" rx="6" fill="#F7F2EE" />
              <text x="14" y="150" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Seguidores</text>
              <text x="14" y="163" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">127,4K</text>
              <polyline points="14,210 34,200 54,195 74,185 94,175 116,160" stroke="#CC3333" stroke-width="2" fill="none" stroke-linecap="round" />
              <circle cx="116" cy="160" r="3" fill="#CC3333" />
              <text x="80" y="224" fill="#CC3333" font-size="8" font-weight="500" font-family="Inter, sans-serif">+34%</text>
            </g>

            <g transform="translate(175, 10)">
              <rect x="0" y="0" width="130" height="260" rx="16" fill="#1A1A1A" />
              <rect x="4" y="4" width="122" height="252" rx="14" fill="#FFFFFF" />
              <rect x="4" y="4" width="122" height="28" rx="14" fill="#07C160" />
              <text x="65" y="22" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">WeChat</text>
              <rect x="14" y="42" width="102" height="50" rx="6" fill="#F7F2EE" />
              <rect x="14" y="100" width="102" height="50" rx="6" fill="#F7F2EE" />
              <text x="14" y="172" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Lecturas</text>
              <text x="14" y="185" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">89,2K</text>
              <text x="14" y="205" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Interacción</text>
              <text x="14" y="218" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">12,8%</text>
              <polyline points="14,248 34,244 54,238 74,230 94,220 116,208" stroke="#07C160" stroke-width="2" fill="none" stroke-linecap="round" />
              <circle cx="116" cy="208" r="3" fill="#07C160" />
            </g>

            <g transform="translate(330, 50)">
              <rect x="0" y="0" width="130" height="240" rx="16" fill="#1A1A1A" />
              <rect x="4" y="4" width="122" height="232" rx="14" fill="#FFFFFF" />
              <rect x="4" y="4" width="122" height="28" rx="14" fill="#FF2442" />
              <text x="65" y="22" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">RedNote</text>
              <rect x="14" y="40" width="48" height="48" rx="4" fill="#F7F2EE" />
              <rect x="68" y="40" width="48" height="48" rx="4" fill="#F7F2EE" />
              <rect x="14" y="94" width="48" height="48" rx="4" fill="#F7F2EE" />
              <rect x="68" y="94" width="48" height="48" rx="4" fill="#F7F2EE" />
              <text x="14" y="162" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Seguidores</text>
              <text x="14" y="175" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">56,1K</text>
              <polyline points="14,220 34,215 54,208 74,198 94,188 116,172" stroke="#FF2442" stroke-width="2" fill="none" stroke-linecap="round" />
              <circle cx="116" cy="172" r="3" fill="#FF2442" />
              <text x="80" y="230" fill="#FF2442" font-size="8" font-weight="500" font-family="Inter, sans-serif">+52%</text>
            </g>

            <g class="mission-badge mission-badge-1">
              <rect x="145" y="290" width="90" height="28" rx="6" fill="#1A1A1A" />
              <text x="190" y="308" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">+2,4K hoy</text>
            </g>
            <g class="mission-badge mission-badge-2">
              <rect x="260" y="300" width="100" height="28" rx="6" fill="#CC3333" />
              <text x="310" y="318" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">Conversiones +41%</text>
            </g>
            <g class="mission-badge mission-badge-3">
              <rect x="50" y="310" width="84" height="28" rx="6" fill="#07C160" />
              <text x="92" y="328" text-anchor="middle" fill="#FFFFFF" font-size="8" font-weight="500" font-family="Inter, sans-serif">89,2K lecturas</text>
            </g>
          </svg>
        </div>
        <div>
          <SectionBar />
          <SectionHeading overline="Nuestra misión">Hacer crecer marcas en las redes sociales chinas.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              No para rellenar una diapositiva más, sino para mover cifras: seguidores, interacciones, conversiones.
            </p>
            <p>
              Las plataformas chinas están saturadas y son caras. Las marcas locales conocen cada matiz del juego. Salvar esa distancia desde fuera es el verdadero reto. Lo asumimos con alcance cerrado, precio fijo y un equipo que vive dentro de esas plataformas a diario.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our vision -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Nuestra visión">Un buen responsable de redes con IA en la mochila va más lejos que el viejo modelo de agencia.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              El modelo clásico apila perfiles: planificadores, redactores, diseñadores, jefes de proyecto. Cada uno factura sus horas. La mitad no ha publicado nunca en Douyin.
            </p>
            <p>
              Producimos los visuales y los primeros borradores con HubStudio.ai. Lo que antes llevaba una semana se resuelve en un día. La estrategia y la lectura cultural siguen al cien por cien en manos del equipo humano. Ninguna evolución técnica cambia ese reparto.
            </p>
          </div>
          <div class="bg-[#F0F1F4] border-l-[3px] border-[#CC3333] rounded-none p-[20px] mt-[24px]">
            <p class="text-[16px] font-normal text-[#1A1A1A] leading-[1.6] m-0">
              En 2025 el mercado chino de contenido generado por IA superó los 25.700 millones de euros, con un crecimiento anual del 60 por ciento. Más de uno de cada dos anunciantes chinos ya integra la IA en su producción creativa. Fuente: datos sectoriales, 2025.
            </p>
          </div>
        </div>
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="Comparación de velocidad: modelo de agencia clásico frente a TheRedScroll con IA">
          <svg viewBox="0 0 440 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">TIEMPO DE ENTREGA</text>

            <text x="20" y="62" fill="#5C5C5C" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">AGENCIA TRADICIONAL</text>

            <rect x="20" y="74" width="400" height="36" rx="6" fill="#E8E0D8" />

            <line x1="100" y1="74" x2="100" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />
            <line x1="180" y1="74" x2="180" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />
            <line x1="260" y1="74" x2="260" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />
            <line x1="340" y1="74" x2="340" y2="110" stroke="#FFFFFF" stroke-width="1" opacity="0.6" />

            <text x="60" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 1</text>
            <text x="140" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 2</text>
            <text x="220" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 3</text>
            <text x="300" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 4</text>
            <text x="380" y="96" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Sem. 5</text>

            <g transform="translate(20, 122)">
              <rect x="0" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="38" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Planner</text>

              <rect x="82" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="120" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Redactor</text>

              <rect x="164" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="202" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Diseñador</text>

              <rect x="246" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="284" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Jefe de proyecto</text>

              <rect x="328" y="0" width="76" height="22" rx="4" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
              <text x="366" y="14" text-anchor="middle" fill="#5C5C5C" font-size="7" font-family="Inter, sans-serif">Account</text>
            </g>

            <line x1="20" y1="168" x2="420" y2="168" stroke="#E8E0D8" stroke-width="0.5" />

            <text x="20" y="198" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">THEREDSCROLL + IA</text>

            <rect x="20" y="210" width="80" height="36" rx="6" fill="#CC3333" class="vision-bar" />
            <rect x="100" y="210" width="320" height="36" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" stroke-dasharray="4 4" />

            <text x="60" y="232" text-anchor="middle" fill="#FFFFFF" font-size="9" font-weight="500" font-family="Inter, sans-serif">1 día</text>

            <text x="260" y="232" text-anchor="middle" fill="#E8E0D8" font-size="9" font-family="Inter, sans-serif">Tiempo ganado</text>

            <g transform="translate(20, 258)">
              <rect x="0" y="0" width="110" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
              <text x="55" y="14" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">Estratega local</text>

              <rect x="118" y="0" width="80" height="22" rx="4" fill="#1A1A1A" opacity="0.05" stroke="#1A1A1A" stroke-width="0.5" />
              <text x="158" y="14" text-anchor="middle" fill="#1A1A1A" font-size="7" font-weight="500" font-family="Inter, sans-serif">HubStudio.ai</text>
            </g>

            <line x1="20" y1="304" x2="420" y2="304" stroke="#E8E0D8" stroke-width="0.5" />

            <g transform="translate(20, 320)">
              <text x="0" y="12" fill="#1A1A1A" font-size="20" font-weight="500" font-family="Inter, sans-serif">5x</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">más rápido</text>
            </g>
            <g transform="translate(140, 320)">
              <text x="0" y="12" fill="#1A1A1A" font-size="20" font-weight="500" font-family="Inter, sans-serif">80%</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">menos perfiles facturables</text>
            </g>
            <g transform="translate(290, 320)">
              <text x="0" y="12" fill="#CC3333" font-size="20" font-weight="500" font-family="Inter, sans-serif">100%</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">estrategia humana</text>
            </g>
          </svg>
        </div>
      </div>
    </Container>
  </section>

  <!-- Leadership -->
  <section id="equipo" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Dirección">Quienes sostienen TheRedScroll.</SectionHeading>
      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="leader-card bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/team/Cyil-Drouin.jpg" alt="Cyril Drouin" class="w-full aspect-[3/4] object-cover object-top" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">Cyril Drouin</h3>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5] mb-[12px]">Fundador y CEO</p>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5]">
              Veinticinco años en digital, publicidad y comercio. Ex-CEO de Publicis Commerce and Performance Marketing para China y Asia Norte.
            </p>
          </div>
        </div>
        <div class="leader-card bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/team/Echo-peng.jpg" alt="Echo Peng" class="w-full aspect-[3/4] object-cover object-top" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">Echo Peng</h3>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5] mb-[12px]">Senior Director</p>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5]">
              Dieciocho años en e-commerce y digital en China. Ex-directora de operaciones de Publicis China.
            </p>
          </div>
        </div>
        <div class="leader-card bg-[var(--color-rice-paper)] rounded-[10px] overflow-hidden">
          <img src="/images/team/Liyan-Ye.jpg" alt="Liyan Ye" class="w-full aspect-[3/4] object-cover object-top" loading="lazy" decoding="async" />
          <div class="p-[24px] max-[640px]:p-[20px]">
            <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[4px]">Liyan Ye</h3>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5] mb-[12px]">Senior Director</p>
            <p class="text-[14px] font-normal text-[var(--color-stone)] leading-[1.5]">
              Veinte años de marketing en grupos del Fortune 500 en China.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our team -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Nuestro equipo">Antiguos directivos de agencias internacionales y estrategas de plataforma que publican a diario.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Estrategas que publican a diario en WeChat, Douyin, RedNote y Weibo. Productores de contenido que han llevado calendarios editoriales para decenas de marcas en China. La mayoría suma más de diez años en este oficio.
            </p>
            <p>
              Quien firma la hoja de ruta editorial vigila también que el contenido salga a tiempo y rinda. Cero distancia entre la estrategia sobre el papel y lo que finalmente se publica.
            </p>
            <p>
              Hemos lanzado marcas de belleza en RedNote, levantado comunidades de alimentación en WeChat y articulado audiencias de automoción en Douyin.
            </p>
          </div>
        </div>
        <img
          src="/images/team/china-office.png"
          alt="Oficina de TheRedScroll en China"
          class="w-full rounded-[8px] object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </Container>
  </section>

  <!-- Clients trust stats -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#F0F1F4] rounded-[10px] p-[48px] max-[1024px]:p-[32px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[24px] text-center">Marcas que nos eligen</p>
        <div id="stats-grid" class="grid grid-cols-4 max-[640px]:grid-cols-2 gap-[32px] max-[640px]:gap-[24px] text-center">
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]" data-target="35" data-suffix="+">0</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">Marcas acompañadas</p>
