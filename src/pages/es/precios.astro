---

<BaseLayout
  title="Precios cerrados para social media en China | TheRedScroll"
  description="Paquetes claros y precios cerrados para marketing en redes sociales chinas: WeChat, Douyin, RedNote, Weibo. Desde 3.750 € al mes."
  lang="es"
>
  <main class="pt-[60px] max-[640px]:pt-[52px]">

    <section class="relative w-full bg-[#1A1A1A] rounded-none overflow-hidden py-[80px] max-[1024px]:py-[64px] max-[640px]:py-[48px] px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px]">
      <div class="absolute inset-0 bg-cover bg-center opacity-[0.15]" style="background-image: url('/images/hero/pricing-bg.webp')" aria-hidden="true"></div>
      <div class="relative z-[1] max-w-[800px] mx-auto text-center">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[8px]">Precios</p>
        <h1 class="text-[#FFFFFF] text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] mb-[8px]">
          Alcance cerrado. Precio fijo. Cero extras.
        </h1>
        <p class="text-[rgba(255,255,255,0.6)] text-[16px] font-normal leading-[1.6]">
          Precios en euros, sin impuestos. Compromiso a seis meses en todos los paquetes.
        </p>
      </div>
    </section>

    <section class="mt-[96px] max-[640px]:mt-[64px]">
      <Container>
        <div class="text-center mb-[48px]">
          <div class="flex justify-center mb-[12px]"><SectionBar /></div>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A]">Nuestros paquetes</h2>
        </div>

        <div class="max-[1024px]:hidden overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="w-[280px] p-[16px] align-bottom"></th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tl-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Start</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">3.750 €<span class="text-[14px] text-[#5C5C5C] font-normal">/mes</span></p>
                  <Button variant="secondary" href="/es/contacto/" class="mt-[16px] w-full justify-center text-[13px]">Empezar</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] relative border-x-[3px] border-[#CC3333]">
                  <div class="absolute top-0 left-[-3px] right-[-3px] h-[3px] bg-[#CC3333]"></div>
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333] mb-[4px]">Grow</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">5.500 €<span class="text-[14px] text-[#5C5C5C] font-normal">/mes</span></p>
                  <Button variant="primary" href="/es/contacto/" class="mt-[16px] w-full justify-center text-[13px]">Empezar</Button>
                </th>
                <th class="p-[20px] align-bottom text-center bg-[#F0F1F4] rounded-tr-[10px]">
                  <p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#5C5C5C] mb-[4px]">Lead</p>
                  <p class="text-[28px] text-[#1A1A1A] font-medium leading-[1.2]">6.750 €<span class="text-[14px] text-[#5C5C5C] font-normal">/mes</span></p>
                  <Button variant="secondary" href="/es/contacto/" class="mt-[16px] w-full justify-center text-[13px]">Empezar</Button>
                </th>
              </tr>
            </thead>
            <tbody>
              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Estrategia y puesta en marcha</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Análisis competitivo</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Mes 1</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">Mes 1</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Mes 1</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Estrategia editorial y pilares de contenido</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Calendario editorial mensual</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Apertura y configuración de cuentas</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Según necesidad</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">Según necesidad</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Según necesidad</td>
              </tr>

              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Contenido</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">WeChat</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 artículo/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1 artículo/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 artículo/sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Weibo</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 post/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3 posts/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">7 posts/sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">RedNote (Xiaohongshu)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 post/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">3 posts/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">5 posts/sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin (vídeo aportado por el cliente)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">1 vídeo/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]">1 vídeo/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2 vídeos/sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Douyin (vídeo IA, 15 s máx.)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="No incluido">No</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">1 vídeo/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">2 vídeos/sem.</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)] bg-[#F0F1F4]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium">Total Douyin</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center">1/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">2/sem.</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">4/sem.</td>
              </tr>

              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Producción con IA</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Vídeo generado por IA con HubStudio.ai</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="No incluido">No</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Validación del brief antes de producir</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="No incluido">No</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Escucha social</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Seguimiento de menciones de marca</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="No incluido">No</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]"><span aria-label="No incluido">No</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Vigilancia de la competencia</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="No incluido">No</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]"><span aria-label="No incluido">No</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Balance mensual de imagen</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center"><span aria-label="No incluido">No</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center border-x-[3px] border-[#CC3333]"><span aria-label="No incluido">No</span></td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>

              <tr><td colspan="4" class="pt-[32px] pb-[8px] px-[16px]"><p class="text-[11px] font-medium uppercase tracking-[0.05em] text-[#CC3333]">Acompañamiento e informes</p></td></tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Interlocutor dedicado</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Soporte por chat (lun.-vie.)</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr class="border-b border-[rgba(0,0,0,0.06)]">
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Informe mensual de rendimiento</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center border-x-[3px] border-[#CC3333]">&#10003;</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] text-center">&#10003;</td>
              </tr>
              <tr>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A]">Reuniones estratégicas</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#5C5C5C] text-center">Una al mes</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#1A1A1A] font-medium text-center border-x-[3px] border-[#CC3333]">Cada semana</td>
                <td class="py-[12px] px-[16px] text-[13px] text-[#CC3333] font-medium text-center">A demanda</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="hidden max-[1024px]:flex flex-col gap-[16px]">
          {packages.map((pkg) => {
            const dark = pkg.highlighted;
            const textPrimary = dark ? 'text-[#FFFFFF]' : 'text-[#1A1A1A]';
            const textSecondary = dark ? 'text-[rgba(255,255,255,0.6)]' : 'text-[#5C5C5C]';
            const borderColor = dark ? 'border-[rgba(255,255,255,0.1)]' : 'border-[rgba(0,0,0,0.06)]';

            const features = [
              { section: 'Estrategia y puesta en marcha', items: [
                { label: 'Análisis competitivo', value: pkg.strategy.competitor },
                { label: 'Estrategia editorial y pilares de contenido', value: pkg.strategy.contentStrategy },
                { label: 'Calendario editorial mensual', value: pkg.strategy.editorialCalendar },
                { label: 'Apertura y configuración de cuentas', value: pkg.strategy.accountOpening },
              ]},
              { section: 'Contenido', items: [
                { label: 'WeChat', value: pkg.content.wechat },
                { label: 'Weibo', value: pkg.content.weibo },
                { label: 'RedNote (Xiaohongshu)', value: pkg.content.rednote },
                { label: 'Douyin (vídeo cliente)', value: pkg.content.douyinClient },
                { label: 'Douyin (vídeo IA)', value: pkg.content.douyinAi },
                { label: 'Total Douyin', value: pkg.content.douyinTotal },
              ]},
              { section: 'Producción con IA', items: [
                { label: 'Vídeo generado por IA con HubStudio.ai', value: pkg.ai },
                { label: 'Validación del brief antes de producir', value: pkg.ai },
              ]},
              { section: 'Escucha social', items: [
                { label: 'Seguimiento de menciones de marca', value: pkg.socialListening },
                { label: 'Vigilancia de la competencia', value: pkg.socialListening },
                { label: 'Balance mensual de imagen', value: pkg.socialListening },
              ]},
              { section: 'Acompañamiento e informes', items: [
                { label: 'Interlocutor dedicado', value: pkg.support.accountManager },
                { label: 'Soporte por chat (lun.-vie.)', value: pkg.support.chatSupport },
                { label: 'Informe mensual de rendimiento', value: pkg.support.monthlyReport },
                { label: 'Reuniones estratégicas', value: pkg.support.strategyCalls },
              ]},
            ];

            return (
              <div class:list={[
                'rounded-[12px] p-[24px]',
                dark ? 'bg-[#1A1A1A]' : 'bg-[#F0F1F4]'
              ]}>
                <p class:list={['text-[11px] font-medium uppercase tracking-[0.05em] mb-[4px]', dark ? 'text-[#FFFFFF]' : 'text-[#CC3333]']}>
                  {pkg.name}
                </p>
                <p class:list={['text-[28px] font-medium leading-[1.2] mb-[4px]', textPrimary]}>
                  {pkg.price}<span class:list={['text-[14px] font-normal', textSecondary]}>/mes</span>
                </p>
                <p class:list={['text-[13px] font-normal leading-[1.5] mb-[20px]', textSecondary]}>
                  {pkg.description}
                </p>

                <Button variant={dark ? 'primary' : 'secondary'} href="/es/contacto/" class="w-full justify-center">Empezar</Button>

                <div class="mt-[24px] flex flex-col gap-[20px]">
                  {features.map((group) => (
                    <div>
