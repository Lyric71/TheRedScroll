---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const caseStudies = [
  {
    title: 'Viessmann: cuando las redes sociales empujan el e-commerce en China',
    category: 'eCommerce y Social',
    platforms: ['Douyin', 'RedNote', 'WeCom'],
    result: 'Una facturación online que crece mes a mes',
    image: '/images/clients/Viessmann/Viessman-climate-solution.avif',
    href: '/es/proyectos/viessmann',
  },
  {
    title: 'Jaguar Land Rover: conectar con los compradores jóvenes en las redes sociales chinas',
    category: 'Contenido y UGC',
    platforms: ['Douyin', 'RedNote', 'WeChat'],
    result: 'Una marca reposicionada ante un público de lujo más joven',
    image: '/images/clients/Jaguar/Jaguar-Land-Rover.avif',
    href: '/es/proyectos/jaguar-land-rover',
  },
  {
    title: 'JAC Motors: construir comunidad alrededor de un gigante chino del automóvil',
    category: 'Comunidad y contenido IA',
    platforms: ['WeChat', 'RedNote', 'Weibo'],
    result: 'Una campaña olímpica firmada con IA, viral fuera de China',
    image: '/images/clients/JAC/JAC-Wechat-4.jpg',
    href: '/es/proyectos/jac-motors',
  },
  {
    title: 'iGuzzini: cómo el social levantó una marca de iluminación de alta gama en China',
    category: 'Lujo y eCommerce',
    platforms: ['WeChat', 'RedNote', 'Weibo'],
    result: 'De marca B2B a referente de lujo para el gran público en 24 meses',
    image: '/images/clients/iGuzzini/iguzzini4-1.png',
    href: '/es/proyectos/iguzzini',
  },
  {
    title: 'Camper: hacer crecer una marca de diseño en China',
    category: 'Marca y contenido',
    platforms: ['WeChat', 'RedNote', 'Weibo'],
    result: 'De 43.000 a 187.000 seguidores y un 31 % más de ventas en tienda en 18 meses',
    image: '/images/clients/Camper/Camper-Case-Study-Hero.jpg',
    href: '/es/proyectos/camper',
  },
  {
    title: 'Mission Foods: lanzar los chips de maíz en China gracias a las redes sociales',
    category: 'Campaña y social',
    platforms: ['WeChat', 'RedNote', 'Weibo'],
    result: 'De una categoría desconocida a una comunidad en crecimiento, apoyada en el contenido editorial',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    href: '/es/proyectos/mission-foods',
  },
  {
    title: 'Marriott: un Super Brand Day que generó millones',
    category: 'Campaña y eCommerce',
    platforms: ['WeChat', 'Weibo', 'Tmall'],
    result: 'Ventas millonarias en Tmall y cientos de miles de nuevos socios Bonvoy',
    image: '/images/clients/Marriott/Marriot-campaign-SBD-KV.jpg',
    href: '/es/proyectos/marriott',
  },
  {
    title: 'Master Martini: una comunidad de chefs en toda Asia',
    category: 'Comunidad y social',
    platforms: ['Instagram', 'Facebook'],
    result: 'De marca B2B al punto de encuentro de los chefs profesionales en cinco mercados',
    image: '/images/clients/MasterMartini/MasterMartini1.webp',
    href: '/es/proyectos/master-martini',
  },
  {
    title: 'Blue Insurance: el lanzamiento digital de la primera aseguradora online de Hong Kong',
    category: 'Web y campaña',
    platforms: ['Web', 'Social Media'],
    result: '10.000 seguidores el primer mes y más de 3.000 suscripciones a la newsletter en una semana',
    image: '/images/clients/Blue/Blue Insurance 1.png',
    href: '/es/proyectos/blue-insurance',
  },
  {
    title: 'AGE 20\'s: la campaña Little Milk Brick que conquistó China',
    category: 'Campaña y contenido',
    platforms: ['RedNote', 'Douyin'],
    result: '3,87 millones de impresiones en Douyin (cuatro veces el objetivo) y un apodo viral en orgánico',
    image: '/images/clients/Age20/Age20-Picture1-scaled.jpg',
    href: '/es/proyectos/age20s',
  },
  {
    title: 'Langnese: reposicionar la primera miel de Alemania para crecer en China',
    category: 'Consultoría y estrategia',
    platforms: ['RedNote', 'Douyin', 'WeChat', 'Tmall'],
    result: 'Un reposicionamiento en nueve pilares que abrió nuevos canales y audiencias',
    image: '/images/clients/Langnese/Langnese-Honey.png',
    href: '/es/proyectos/langnese',
  },
];

function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const shuffledStudies = shuffle(caseStudies);

const categories = ['Todo', ...new Set(caseStudies.map((s) => s.category))];
const allPlatforms = ['Todo', ...new Set(caseStudies.flatMap((s) => s.platforms))].sort((a, b) => a === 'Todo' ? -1 : b === 'Todo' ? 1 : a.localeCompare(b));
---

<PageLayout
  title="Proyectos | TheRedScroll"
  description="Casos de éxito de TheRedScroll. Resultados concretos para marcas internacionales en WeChat, RedNote, Douyin, Weibo y muchas plataformas más."
  ogImage="/images/og/work.jpg"
  lang="es"
>

  <section class="pt-[96px] pb-[64px] max-[640px]:pt-[64px] max-[640px]:pb-[40px]">
    <Container>
      <div class="max-w-[680px]">
        <SectionBar />
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">
          Casos de éxito
        </p>
        <h1 class="text-[40px] max-[640px]:text-[28px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[16px]">
          Los resultados hablan por nosotros.
        </h1>
        <p class="text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] text-[var(--color-stone)]">
          Campañas reales. Plataformas reales. Resultados concretos para marcas internacionales que crecen en China.
        </p>
      </div>
    </Container>
  </section>

  <section class="pb-[40px] max-[640px]:pb-[24px]">
    <Container>
      <div class="mb-[16px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-stone)] mb-[10px]">Servicio</p>
        <div class="flex flex-wrap gap-[8px]" id="filter-category">
          {categories.map((cat) => (
            <button
              type="button"
              data-filter-category={cat}
              class:list={[
                'filter-btn text-[13px] font-medium leading-[1] px-[16px] py-[8px] max-[640px]:py-[12px] min-h-[44px] max-[640px]:min-h-0 rounded-[6px] cursor-pointer transition-[background,color,border-color] duration-150',
                cat === 'Todo'
                  ? 'bg-[var(--color-ink)] text-[#FFFFFF] border border-[var(--color-ink)]'
                  : 'bg-transparent text-[var(--color-ink)] border border-[rgba(0,0,0,0.15)] hover:border-[var(--color-ink)]'
              ]}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>
      <div>
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-stone)] mb-[10px]">Plataforma</p>
        <div class="flex flex-wrap gap-[8px]" id="filter-platform">
          {allPlatforms.map((plat) => (
            <button
              type="button"
              data-filter-platform={plat}
              class:list={[
                'filter-btn text-[13px] font-medium leading-[1] px-[16px] py-[8px] max-[640px]:py-[12px] min-h-[44px] max-[640px]:min-h-0 rounded-[6px] cursor-pointer transition-[background,color,border-color] duration-150',
                plat === 'Todo'
                  ? 'bg-[var(--color-ink)] text-[#FFFFFF] border border-[var(--color-ink)]'
                  : 'bg-transparent text-[var(--color-ink)] border border-[rgba(0,0,0,0.15)] hover:border-[var(--color-ink)]'
              ]}
            >
              {plat}
            </button>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[32px] max-[640px]:gap-[24px]" id="case-study-grid">
        {shuffledStudies.map((study) => (
          <a
            href={study.href}
            data-category={study.category}
            data-platforms={study.platforms.join(',')}
            class="case-study-card group block bg-[var(--color-rice-paper)] rounded-[8px] overflow-hidden border border-[rgba(0,0,0,0.08)] transition-[border-color] duration-150 ease-in-out hover:border-[rgba(0,0,0,0.15)]"
          >
            <div class="w-full aspect-[16/10] bg-[var(--color-warm-gray)] flex items-center justify-center overflow-hidden">
              {study.image && study.href !== '#' ? (
                <img src={study.image} alt={study.title} class="w-full h-full object-cover" loading="lazy" decoding="async" />
              ) : (
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(0,0,0,0.15)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21,15 16,10 5,21"/>
                </svg>
              )}
            </div>
            <div class="p-[24px] max-[640px]:p-[20px]">
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[8px]">
                {study.category}
              </p>
              <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">
                {study.title}
              </h3>
              <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)] mb-[16px]">
                {study.result}
              </p>
              <div class="flex flex-wrap gap-[8px]">
                {study.platforms.map((platform) => (
                  <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[rgba(0,0,0,0.04)] px-[10px] py-[4px] rounded-[4px]">
                    {platform}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
      <p id="no-results" class="hidden text-center text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] py-[64px]">
        Ningún caso coincide con estos filtros.
      </p>
    </Container>
  </section>

  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] max-[640px]:p-[32px_20px] text-center">
        <SectionHeading overline="Su turno">Su marca, el próximo caso de éxito.</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Alcance cerrado. Precio fijo. Resultados medibles.
        </p>
        <Button variant="primary" href="/es/contacto/">Agendar una llamada</Button>
      </div>
    </Container>
  </section>

  <script>
    const ACTIVE = 'bg-[var(--color-ink)] text-[#FFFFFF] border border-[var(--color-ink)]';
    const INACTIVE = 'bg-transparent text-[var(--color-ink)] border border-[rgba(0,0,0,0.15)] hover:border-[var(--color-ink)]';

    let activeCategory = 'Todo';
    let activePlatform = 'Todo';

    function setButtonState(btn: HTMLButtonElement, active: boolean) {
      const add = active ? ACTIVE : INACTIVE;
      const remove = active ? INACTIVE : ACTIVE;
      remove.split(' ').forEach((c) => btn.classList.remove(c));
      add.split(' ').forEach((c) => btn.classList.add(c));
    }

    function applyFilters() {
      const cards = document.querySelectorAll<HTMLElement>('.case-study-card');
      let visible = 0;

      cards.forEach((card) => {
        const cat = card.dataset.category ?? '';
        const plats = (card.dataset.platforms ?? '').split(',');

        const matchCat = activeCategory === 'Todo' || cat === activeCategory;
        const matchPlat = activePlatform === 'Todo' || plats.includes(activePlatform);

        if (matchCat && matchPlat) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      const noResults = document.getElementById('no-results');
      if (noResults) {
        noResults.classList.toggle('hidden', visible > 0);
      }
    }

    document.querySelectorAll<HTMLButtonElement>('#filter-category button').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.filterCategory ?? 'Todo';
        document.querySelectorAll<HTMLButtonElement>('#filter-category button').forEach((b) => {
          setButtonState(b, b.dataset.filterCategory === activeCategory);
        });
        applyFilters();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('#filter-platform button').forEach((btn) => {
      btn.addEventListener('click', () => {
        activePlatform = btn.dataset.filterPlatform ?? 'Todo';
        document.querySelectorAll<HTMLButtonElement>('#filter-platform button').forEach((b) => {
          setButtonState(b, b.dataset.filterPlatform === activePlatform);
        });
        applyFilters();
      });
    });
  </script>

</PageLayout>
