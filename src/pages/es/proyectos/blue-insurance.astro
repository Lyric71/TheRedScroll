---
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionBar from '../../../components/ui/SectionBar.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Button from '../../../components/ui/Button.astro';

const services = ['Campaña', 'Diseño', 'Medios', 'Sitio web'];
const platforms = ['Web', 'Redes sociales', 'Publicidad de pago'];
---

<PageLayout
  title="Lanzamiento digital de Blue Insurance en Hong Kong | TheRedScroll"
  description="Cómo Blue Insurance lanzó la primera aseguradora de vida 100 % digital de Hong Kong: un sitio bilingüe, SEO y una campaña que captó 10.000 seguidores en un mes."
  ogImage="/images/clients/Blue/blue-insurance-og.jpg"
  lang="es"
>

  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[480px] overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-fixed max-[640px]:bg-scroll" style="background-image: url('/images/clients/Blue/Blue Insurance 1.webp')" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.72]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">Caso de éxito</p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        Blue Insurance: el lanzamiento web de la primera aseguradora de vida 100 % digital de Hong Kong.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Blue quería un sitio y una campaña de lanzamiento para la primera aseguradora de vida 100 % digital de Hong Kong. Entregamos los dos y captamos 10.000 seguidores en el primer mes.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/es/contacto/">Agendar una llamada</Button>
        <Button variant="secondary-dark" href="#caso">Leer el caso</Button>
      </div>
    </div>
  </section>

  <section class="border-b border-[rgba(0,0,0,0.08)]">
    <Container>
      <div class="flex flex-wrap gap-[32px] max-[640px]:gap-[20px] py-[24px]">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">El cliente</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Blue Insurance</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Sector</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Seguros / Fintech</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Mercado</p>
          <p class="text-[14px] font-medium leading-[1.4] text-[var(--color-ink)]">Hong Kong</p>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Servicios</p>
          <div class="flex flex-wrap gap-[6px]">
            {services.map((s) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{s}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[var(--color-vermillion)] mb-[4px]">Canales</p>
          <div class="flex flex-wrap gap-[6px]">
            {platforms.map((p) => (
              <span class="text-[12px] font-normal leading-[1.4] text-[var(--color-stone)] bg-[var(--color-rice-paper)] px-[10px] py-[4px] rounded-[4px]">{p}</span>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section id="caso" class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="El cliente">La primera aseguradora de vida 100 % digital de Hong Kong. Sin agente, sin papeleo.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Blue es la primera aseguradora de vida 100 % digital de Hong Kong. Sin agente. Unas pocas preguntas en línea bastan para tener cobertura al momento. El principio es claro: saber qué seguro hace falta, sin tener que encadenar reuniones y formularios.
            </p>
            <p>
              Blue llegaba, sin embargo, a un mercado donde las aseguradoras tradicionales ya habían empezado su giro digital. Ser la primera puramente online no bastaba. Hacía falta un sitio claramente más simple que el de la competencia y una campaña capaz de generar leads rápido.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <div class="flex justify-center gap-[16px] overflow-x-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] max-[640px]:justify-start pb-[8px] scrollbar-hide">
      <img src="/images/clients/Blue/Blue Insurance 1.webp" alt="Sitio web de Blue Insurance y campaña de lanzamiento digital en Hong Kong" class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
      <img src="/images/clients/Blue/Blue Insurance 2.webp" alt="Sitio bilingüe de Blue Insurance en escritorio y móvil" class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
      <img src="/images/clients/Blue/Blue Insurance 3.webp" alt="Campaña digital de Blue Insurance generando seguidores y altas" class="w-[280px] max-[640px]:w-[220px] shrink-0 rounded-[8px] border border-[rgba(0,0,0,0.08)]" loading="lazy" decoding="async" />
    </div>
    <Container>
      <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)] mt-[12px] text-center">
        El sitio de Blue Insurance. Bilingüe, pensado mobile-first, diseñado para cotizaciones instantáneas y altas.
      </p>
    </Container>
  </section>

  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Lo que hicimos">Un sitio y una campaña de lanzamiento, pensados para ir rápido.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Llevamos en paralelo la construcción del sitio y la campaña de lanzamiento digital.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">El sitio tenía que estar a la altura del producto</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Blue vende un seguro simple. El sitio tenía que encarnar la misma promesa. Bilingüe chino-inglés, fluido en móvil y en escritorio. Maquetación deliberadamente limpia. Ni un párrafo de jerga aseguradora. Ni una navegación enrevesada. Cada pantalla devuelve al visitante a una cotización o a un alta.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">SEO integrado en la arquitectura, no pegado encima</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Contenido, metadatos y arquitectura se concibieron para que Blue saliera cuando un residente de Hong Kong busca un seguro online o una cobertura de vida digital. Listo para defender su posición en la búsqueda desde el primer día.
            </p>
          </div>
        </div>

        <div class="mb-[48px] max-[640px]:mb-[32px]">
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[12px]">La campaña arrancó esa misma semana</h3>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Redes sociales y publicidad de pago apuntaron a los consumidores cansados del seguro tradicional. El mensaje hablaba de todo lo que Blue quita: citas, formularios y letra pequeña.
            </p>
          </div>
        </div>

        <div class="mb-[64px] max-[640px]:mb-[48px] bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[32px] max-[640px]:p-[20px]">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Sitio, SEO y campaña, todo pilotado por nuestro equipo sobre el terreno en Hong Kong.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <section class="mb-[64px] max-[640px]:mb-[48px]">
    <Container>
      <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[16px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
          <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">10.000</p>
          <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">Nuevos seguidores el primer mes</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
          <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">3.000+</p>
          <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">Altas a la newsletter en una semana</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[24px] text-center">
          <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[var(--color-ink)] mb-[4px]">Bilingüe</p>
          <p class="text-[13px] font-normal leading-[1.4] text-[var(--color-stone)]">Chino e inglés, optimizado en los dos</p>
        </div>
      </div>
    </Container>
  </section>

  <section>
    <Container>
      <div class="max-w-[720px] mx-auto">

        <div class="mb-[64px] max-[640px]:mb-[48px]">
          <SectionBar />
          <SectionHeading overline="Los resultados">10.000 seguidores y 3.000 altas antes de que la mayoría de startups acaben su lanzamiento.</SectionHeading>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              El sitio salió bilingüe, rápido y optimizado en todos los dispositivos. La experiencia móvil competía con la de escritorio. En un mercado donde el seguro se compara desde el teléfono, ese equilibrio cuenta.
            </p>
            <p>
              Los resultados llegaron rápido: 10.000 nuevos seguidores el primer mes y más de 3.000 altas a la newsletter en una semana. Para una aseguradora recién lanzada y sin audiencia previa, las cifras hablan. Los habitantes de Hong Kong esperaban este tipo de oferta.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <section class="pb-[96px] max-[640px]:pb-[64px]">
    <Container>
      <div class="bg-[var(--color-rice-paper)] rounded-[8px] border border-[rgba(0,0,0,0.08)] p-[48px] max-[1024px]:p-[32px] text-center">
        <SectionHeading overline="Su turno">¿Necesita un sitio y una campaña de lanzamiento en Hong Kong?</SectionHeading>
        <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)] max-w-[500px] mx-auto mb-[32px]">
          Alcance cerrado. Precio fijo. Equipo sobre el terreno.
        </p>
        <Button variant="primary" href="/es/contacto/">Agendar una llamada</Button>
      </div>
    </Container>
  </section>

  <style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</PageLayout>
