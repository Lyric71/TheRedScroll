    title: 'Tecnología de consumo y B2B',
    description: 'Lanzamientos de producto, amplificación de relaciones públicas y gestión de reputación. Cuando millones de personas tienen que conocer su nombre en poco tiempo, Weibo es el canal.',
    icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>',
  },
];

const pillars = [
  {
    title: 'SOW claro',
    description: 'Cada entregable queda definido desde el inicio en el SOW, el «alcance de trabajo». Publicaciones, vídeos, campañas, informes. Sabe con exactitud qué recibe cada mes.',
  },
  {
    title: 'Precio fijo, sin sorpresas',
    description: 'Un precio por paquete. Sin tarifas por hora, sin extras por cambios de alcance, sin facturas inesperadas.',
  },
  {
    title: 'Producción de contenido con IA',
    description: 'Imágenes y vídeo con HubStudio.ai, que abarata costes y acelera la producción. La estrategia es 100% humana.',
  },
