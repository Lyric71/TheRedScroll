  {
    title: 'Informe',
    description: 'Mensual. Crecimiento, interacción, resultados publicitarios, retorno de los KOL y comparativas. Más un punto de control a mitad de mes durante las campañas activas.',
  },
];

const caseStudies = [
  {
    client: 'JAC Motors',
    image: '/images/clients/JAC/JAC-Wechat-4.webp',
    imageAlt: 'Contenido de JAC Motors en redes sociales producido por TheRedScroll',
    metric: '10M',
    metricLabel: 'vehículos vendidos, comunidad reconstruida',
    summary: 'Un gigante chino del automóvil con 10 millones de vehículos vendidos y una presencia social apagada. Reconstruimos la comunidad en Weibo, WeChat y RedNote con contenido producido con IA.',
    href: '/es/proyectos/jac-motors/',
  },
  {
    client: 'Mission Foods',
    image: '/images/clients/MissionFoods/head-pic.jpg',
    imageAlt: 'Imagen de la campaña de Mission Foods para su lanzamiento en China',
    metric: 'Gen Z',
    metricLabel: 'campañas para una categoría de alimentación nueva',
    summary: 'Lanzar los chips de maíz, una categoría desconocida, en China. Campañas para la Gen Z y contenido de maridaje en Weibo, WeChat y RedNote.',
