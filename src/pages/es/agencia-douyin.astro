---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';

const heroStats = [
  { value: 750, decimals: 0, suffix: 'M', label: 'usuarios activos al día' },
  { value: 120, decimals: 0, suffix: ' min', label: 'de media diaria en la app' },
  { value: 3.5, decimals: 1, suffix: 'T', label: 'RMB al año en ventas de comercio electrónico' },
  { value: 2, decimals: 0, suffix: ' semanas', label: 'de la firma al primer contenido publicado' },
];

const scopeItems = [
  { label: 'Apertura de cuenta y verificación Blue V', href: '/es/plataformas/douyin/' },
  { label: 'Vídeo corto en mandarín rodado por nativos', href: '/es/servicios/produccion-contenido/' },
  { label: 'Campañas KOL y KOC vía Xingtu', href: '/es/servicios/marketing-influencia/' },
  { label: 'Publicidad en Ocean Engine', href: '/es/servicios/publicidad/' },
  { label: 'Comercio en directo y Douyin Shop', href: '/es/plataformas/douyin/' },
];

const services = [
  {
    glyph: '号',
    title: 'Apertura y verificación de cuenta',
    tag: 'Operativa y verificada',
    description:
      'Registramos y verificamos su cuenta de empresa, incluida la verificación Blue V. Las empresas extranjeras necesitan una licencia comercial china o una agencia autorizada. Cubrimos ambas vías, así puede empezar sin entidad local.',
    deliverables: ['Cuenta de empresa', 'Verificación Blue V', 'Asesoría sobre la licencia', 'Entrega de la cuenta'],
    image: '/images/platforms/douyin-services/setup-strategy.webp',
    imageAlt: 'Teléfono con el perfil verificado de una cuenta de empresa de Douyin junto a documentos de registro',
  },
  {
    glyph: '视',
    title: 'Estrategia de contenido y producción de vídeo',
    tag: 'Vídeo en mandarín nativo',
    description:
      'Vídeo corto pensado para Douyin y producido por nuestro equipo en China. Demostraciones de producto, tutoriales, formatos de tendencia y minidramas. HubStudio.ai acelera la producción. Nativos en mandarín escriben y editan cada pieza.',
    deliverables: ['Estrategia de contenido', 'Producción de vídeo corto', 'Formatos de tendencia', 'Minidramas'],
    image: '/images/platforms/douyin-services/content-production.webp',
    imageAlt: 'Mesa de edición con un teléfono que muestra un vídeo corto vertical de Douyin en producción',
  },
  {
    glyph: '达',
    title: 'Campañas KOL y KOC',
    tag: 'Creadores verificados vía Xingtu',
    description:
      'Campañas con KOL (Key Opinion Leaders) y KOC (Key Opinion Consumers) seleccionados a través de Xingtu, el mercado oficial de creadores de Douyin, más nuestra propia red. Cada creador pasa un control de seguidores falsos y de encaje de audiencia. Usted aprueba la lista final.',
    deliverables: ['Búsqueda de KOL', 'Siembra con KOC', 'Control de seguidores falsos', 'Informes de campaña'],
    image: '/images/platforms/douyin-services/kol-campaigns.webp',
    imageAlt: 'Creador de contenido grabando un vídeo de producto para una campaña KOL en Douyin',
  },
  {
    glyph: '广',
    title: 'Publicidad de pago vía Ocean Engine',
    tag: 'Inversión facturada a coste, sin margen',
    description:
      'Ocean Engine (巨量引擎) es la plataforma publicitaria de ByteDance para Douyin. TopView para lanzamientos. In-Feed Ads para tráfico. Search Ads para compradores con intención alta. DOU+ para probar contenido. La inversión se factura a coste real, sin márgenes.',
    deliverables: ['TopView', 'In-Feed Ads', 'Search Ads', 'Impulsos DOU+'],
    image: '/images/platforms/douyin-services/advertising.webp',
    imageAlt: 'Teléfono con un anuncio de marca patrocinado dentro del feed de vídeo de Douyin',
  },
  {
    glyph: '播',
    title: 'Directos y Douyin Shop',
    tag: 'Comercio en directo integrado',
    description:
      'El comercio en directo forma parte de Douyin. Planificamos y ejecutamos sesiones de venta en directo: selección del presentador, guion de producto e interacción en tiempo real. También montamos y optimizamos su tienda Douyin Shop (抖音小店).',
    deliverables: ['Planificación de directos', 'Selección de presentadores', 'Guiones de producto', 'Montaje de Douyin Shop'],
    image: '/images/platforms/douyin-services/live-commerce.webp',
    imageAlt: 'Presentadora mostrando productos a cámara durante una sesión de venta en directo en Douyin',
  },
  {
    glyph: '数',
    title: 'Analítica, informes y optimización',
    tag: 'Un informe al mes',
    description:
      'Informes mensuales con cifras claras. Crecimiento de seguidores, visualizaciones, tasa de interacción, eficiencia publicitaria, GMV y ROAS cuando el comercio está activo. Qué funcionó, qué no y qué cambia el mes siguiente.',
    deliverables: ['Crecimiento de seguidores', 'Tasa de interacción', 'GMV y ROAS', 'Plan del mes siguiente'],
    image: '/images/blog/douyin-control-room.webp',
    imageAlt: 'Pantallas de una sala de control con el crecimiento de seguidores, la interacción y las ventas en Douyin',
  },
];

const segments = [
  {
    title: 'Belleza y moda',
    description: 'La belleza y la moda rinden en Douyin. Demostraciones breves, tutoriales y reseñas de creadores impulsan el descubrimiento, con el pago integrado en la app.',
    icon: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  },
  {
    title: 'Alimentación y bebidas',
    description: 'La comida funciona en Douyin. Demostraciones rápidas y formatos de cata convierten espectadores en primeros compradores, en el feed y en los directos.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
  {
    title: 'Electrónica de consumo y hogar',
    description: 'La electrónica de consumo y el hogar encajan bien en Douyin. Las demostraciones de producto muestran el valor en segundos, justo lo que premia el algoritmo.',
    icon: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  },
  {
    title: 'Hostelería, automoción y B2B',
    description: 'Hostelería, automoción, salud y B2B también rinden en Douyin. Ciudad de primer nivel o de quinto, 22 años o 52, su audiencia china ya está ahí.',
    icon: '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>',
  },
];

const pillars = [
  {
    title: 'Equipo sobre el terreno',
    description: 'Shanghái y Hong Kong. Nativos en mandarín que publican en Douyin cada día, no consultores que leen sobre la plataforma.',
  },
  {
    title: 'Circuito cerrado, precio fijo',
    description: 'Analizamos 37 agencias en abril de 2026. 0 de 37 ofrecen paquetes a precio fijo. Nosotros sí. Cada entregable queda definido desde el inicio.',
  },
  {
    title: 'Gestión de cuenta en inglés',
    description: 'Un responsable dedicado que conoce su marca. Comunicación clara en inglés y contenido en mandarín nativo.',
  },
  {
    title: 'Cumplimiento resuelto',
    description: 'Vías de licencia comercial, verificación de cuenta, normas de contenido y revisión publicitaria. Nos ocupamos del papeleo para que sus campañas no se atasquen.',
  },
];

const steps = [
  {
    title: 'Auditoría',
    description:
      'Revisamos su categoría en Douyin. Competidores, formatos de contenido, niveles de precio y qué premia el algoritmo en su vertical ahora mismo.',
  },
  {
    title: 'Estrategia',
    description:
      'Pilares de contenido, calendario de publicación, lista corta de KOL, plan de medios y objetivos de KPI. Todo por escrito en un SOW claro con precio fijo.',
  },
  {
    title: 'Localización',
    description:
      'Aquí no se traduce nada. Nuestro equipo nativo en mandarín crea su contenido desde cero para el espectador chino. El contenido traducido rinde muy mal en Douyin.',
  },
  {
    title: 'Lanzamiento',
    description:
      'Cuenta verificada y primer contenido publicado en las 2 semanas siguientes a la firma. Su responsable de cuenta trabaja con usted en inglés. No necesita hablar chino.',
  },
  {
    title: 'Escalado',
    description:
      'Reforzamos lo que funciona. Los formatos ganadores reciben más presupuesto vía DOU+ y Ocean Engine. Lo que no rinde se corta. Los informes mensuales lo registran todo.',
  },
];

const caseStudies = [
  {
    client: "AGE 20's",
    image: '/images/clients/Age20/Age20-Picture1-scaled.jpg',
    imageAlt: "Imagen de la campaña de AGE 20's para el lanzamiento de su base de maquillaje en China",
    metric: '3.87M',
    metricLabel: 'impresiones en Douyin frente a un objetivo de 1M',
    summary: 'Marca coreana de belleza que lanzaba una base de maquillaje en China. La campaña alcanzó 3,87 millones de impresiones en Douyin frente a un objetivo de 1 millón. El apodo del producto acabó circulando solo.',
    href: '/es/proyectos/age20s/',
  },
  {
    client: 'Langnese',
    image: '/images/clients/Langnese/Langnese-Douyin-Livestream.jpg',
    imageAlt: 'Miel Langnese presentada durante una sesión de venta en directo en Douyin',
    metric: 'Live',
    metricLabel: 'comercio en directo para una marca con historia',
    summary: 'Marca alemana de miel reposicionada para el consumidor chino. Los directos en Douyin y los vídeos de demostración enseñaron otro uso del producto y remitían a la venta en Tmall.',
    href: '/es/proyectos/langnese/',
  },
];

const faqs = [
  {
    q: '¿Pueden las empresas extranjeras anunciarse en Douyin?',
    a: 'Sí. Las marcas extranjeras se anuncian en Douyin a través de una agencia autorizada como TheRedScroll. Abrimos la cuenta, gestionamos los anuncios en Ocean Engine y facturamos la inversión a coste real. Sin constituir sociedad local.',
  },
  {
    q: '¿Necesito una licencia comercial china o una WFOE?',
    a: 'No para empezar. Las cuentas de empresa exigen una licencia comercial china o una agencia autorizada, y nosotros cubrimos la vía de la agencia. Para vender a través de Douyin Shop existen opciones transfronterizas para marcas sin entidad china. Recomendamos la estructura adecuada en la primera llamada.',
  },
  {
    q: '¿Cuánto cuesta una agencia Douyin?',
    a: 'La mayoría de las agencias presupuesta a medida, con entregables difusos. Nosotros trabajamos con paquetes a precio fijo que listan cada entregable desde el inicio. La inversión en Ocean Engine se factura aparte, a coste real, sin márgenes. Agende una llamada y le recomendaremos la opción que encaje con su presupuesto.',
  },
  {
    q: '¿En qué se diferencia Douyin de TikTok para un anunciante?',
    a: 'Son dos apps separadas de ByteDance sin ningún cruce de contenido. Douyin sirve a la China continental y funciona sobre Ocean Engine, su propia plataforma publicitaria. El comercio dentro de la app va mucho más lejos en Douyin: tiendas, venta en directo y pago sin salir de la app. Una estrategia de TikTok no se traslada sin más.',
  },
  {
    q: '¿Cuánto tardan en llegar los resultados?',
    a: 'Las campañas de pago pueden dar resultados en días. La tracción orgánica suele exigir de 8 a 12 semanas de publicación constante. El algoritmo premia la tasa de visualización completa y la regularidad, así que trabajamos con un mínimo de 3 a 5 publicaciones por semana.',
  },
  {
    q: '¿Podemos reutilizar nuestros vídeos de TikTok en Douyin?',
    a: 'Normalmente no. Douyin detecta los vídeos resubidos con marca de agua y los entierra. El público espera mandarín, tendencias y formatos locales. A veces adaptamos un buen concepto, pero el vídeo se rehace desde cero para el espectador chino.',
  },
  {
    q: '¿Cómo funcionan las campañas con KOL en Douyin?',
    a: 'Contratamos a los creadores a través de Xingtu, la plataforma oficial de ByteDance, así que cada contratación se apoya en datos verificados de audiencia e interacción. Seleccionamos por afinidad y rendimiento, no por número de seguidores. El briefing, los contratos, los pagos y los derechos de uso pasan por nosotros. Una capa de KOC pequeños suele rendir más que un solo gran nombre.',
  },
  {
    q: '¿Cómo funciona Douyin Shop para marcas extranjeras?',
    a: 'Douyin cuenta con un programa transfronterizo para marcas sin entidad china. Se vende a través de una tienda transfronteriza y se envía desde un almacén en depósito aduanero o desde el extranjero. Categorías, fianzas y documentación varían, así que confirmamos la elegibilidad antes de montar nada. Después, los directos y los vídeos cortos enlazan directo al pago.',
  },
  {
    q: '¿Necesitamos hablar chino en nuestro equipo?',
    a: 'No. Su responsable de cuenta trabaja con usted en inglés: estrategia, aprobaciones e informes. Nuestro equipo nativo en mandarín se ocupa de todo lo que mira a China, de los guiones y subtítulos a las respuestas en comentarios. Usted aprueba resúmenes en inglés, no documentos en chino.',
  },
  {
    q: '¿Cómo miden el éxito de una campaña en Douyin?',
    a: 'Contra los objetivos fijados en su alcance de trabajo. Los informes mensuales cubren visualizaciones, tasa de visualización completa, crecimiento de seguidores, interacción, resultados publicitarios en Ocean Engine y, cuando aplica, ventas por directo. Cada informe cierra con recomendaciones para el mes siguiente. Los formatos que no funcionan se recortan, no se defienden.',
  },
];
---

<PageLayout
  title="Agencia Douyin para marcas globales | TheRedScroll"
  description="Agencia Douyin integral para marcas globales: apertura de cuenta, contenido, campañas KOL, anuncios en Ocean Engine y comercio en directo. Agende una llamada."
  lang="es"
>
  <!-- The red thread: scroll progress -->
  <div class="red-thread" data-thread aria-hidden="true"></div>

  <!-- ============ HERO (ink bookend) ============ -->
  <section class="w-full bg-[#1A1A1A] relative overflow-hidden">
    <span
      class="hero-watermark absolute top-[6%] right-[-30px] z-[2] text-[240px] max-[640px]:text-[110px] font-medium text-[#FFFFFF] opacity-[0.03] pointer-events-none select-none whitespace-nowrap leading-none"
      aria-hidden="true"
      data-parallax="0.1"
    >
      抖音
    </span>
    <Container class="relative z-[1]">
      <div class="grid grid-cols-[1.05fr_0.95fr] max-[900px]:grid-cols-1 gap-[56px] max-[900px]:gap-[24px] items-center pt-[88px] pb-[72px] max-[640px]:pt-[48px] max-[640px]:pb-[48px]">
        <div>
          <p class="flex items-center gap-[10px] mb-[20px]" data-hero-reveal style="--d: 0ms">
            <span class="seal" aria-hidden="true">抖</span>
            <span class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333]">Agencia Douyin</span>
          </p>
          <h1 class="hero-title text-[#FFFFFF] mb-[20px]" data-hero-reveal style="--d: 80ms">
            Agencia Douyin: haga crecer su marca en la primera plataforma de vídeo corto de China
          </h1>
          <p class="text-[17px] max-[640px]:text-[15px] text-[rgba(255,255,255,0.6)] font-normal leading-[1.6] max-w-[460px] mb-[32px]" data-hero-reveal style="--d: 160ms">
            Apertura de cuenta, contenido, campañas KOL, anuncios en Ocean Engine y comercio en directo. A cargo de nuestro equipo en Shanghái y Hong Kong. Circuito cerrado, precio fijo.
          </p>
          <div class="flex items-center gap-[12px] flex-wrap mb-[12px]" data-hero-reveal style="--d: 240ms">
            <Button variant="primary" href="/es/contacto/">Agendar una llamada</Button>
            <Button variant="secondary-dark" href="#results">Ver los resultados</Button>
          </div>
          <p class="text-[13px] text-[rgba(255,255,255,0.4)] font-normal" data-hero-reveal style="--d: 300ms">
            Una llamada de 30 minutos. Sin discurso comercial.
          </p>
        </div>

        <div class="relative max-w-[500px] mx-auto w-full max-[900px]:max-w-[380px]" data-hero-reveal style="--d: 200ms">
          <img
            src="/images/douyin-agency/hero-phones-blend.webp"
            alt="Dos teléfonos con pantallas reales de Douyin: un feed vertical de vídeo corto con una ficha de producto y una sesión de venta en directo"
            width="665"
            height="672"
            class="hero-float w-full h-auto block"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="grid grid-cols-4 max-[900px]:grid-cols-2 gap-[24px] max-[640px]:gap-[16px] border-t border-[rgba(255,255,255,0.1)] py-[32px] max-[640px]:py-[24px]" data-hero-reveal style="--d: 360ms">
        {heroStats.map((stat) => (
          <div>
            <p class="text-[32px] max-[640px]:text-[26px] font-medium leading-[1.1] text-[#FFFFFF] mb-[4px] tabular-nums">
              <span data-count={stat.value} data-decimals={stat.decimals}>0</span><span>{stat.suffix}</span>
            </p>
            <p class="text-[12px] text-[rgba(255,255,255,0.4)] font-normal leading-[1.4]">{stat.label}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============ MANIFESTO + ECOSYSTEM (one blended block) ============ -->
  <section class="mt-[96px] max-[640px]:mt-[56px]">
    <Container>
      <figure class="m-0 bg-[#F7F2EE] rounded-[10px] p-[40px] max-[1024px]:p-[28px] max-[640px]:p-[20px] grid grid-cols-[0.9fr_1.1fr] max-[768px]:grid-cols-1 gap-[40px] max-[768px]:gap-[24px] items-center" data-reveal>
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            Por qué importa Douyin
          </p>
          <p class="manifesto" data-manifesto>
            Douyin no es TikTok. Es la economía china del vídeo corto. 750 millones de personas miran, compran y pagan sin salir de la app. Si su marca no está en el feed, su <span class="manifesto-hl">competidor</span> sí lo está.
          </p>
        </div>
        <div>
          <img
            src="/images/douyin-agency/ecosystem-banner-tight.webp"
            alt="Tres teléfonos con las tres caras de Douyin: el feed de vídeo, una sesión de venta en directo y una página de producto en Douyin Shop"
            width="1000"
            height="580"
            loading="lazy"
            class="w-full h-auto block rounded-[8px]"
          />
          <figcaption class="text-[13px] text-[#5C5C5C] font-normal leading-[1.4] mt-[12px] text-center">
            Una app, tres funciones: feed de entretenimiento, canal de directos y pago.
          </figcaption>
        </div>
      </figure>

      <div class="grid grid-cols-2 max-[768px]:grid-cols-1 gap-[48px] max-[768px]:gap-[32px] items-start mt-[64px] max-[640px]:mt-[40px]">
        <div data-reveal>
          <h2 class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.25] text-[#1A1A1A] mb-[16px]">
            Servicios de agencia Douyin para marcas que entran en China
          </h2>
          <div class="flex flex-col gap-[16px] text-[16px] font-normal leading-[1.6] text-[#1A1A1A] max-w-[560px]">
            <p>
              Douyin (抖音) llega cada día a 750 millones de personas en China. Sus clientes están ahí. Puede que sus competidores también.
            </p>
            <p>
              TheRedScroll es una agencia de redes sociales con base en China. Abrimos cuentas de Douyin para marcas extranjeras, producimos vídeo en mandarín nativo, gestionamos campañas KOL, compramos publicidad a través de Ocean Engine y vendemos en directos y en Douyin Shop.
            </p>
            <p>
              Cada colaboración parte de un SOW claro, el «alcance de trabajo», y de un precio fijo. Sabe qué recibe y qué cuesta antes de firmar.
            </p>
          </div>
        </div>
        <div class="bg-[#F7F2EE] rounded-[10px] p-[28px] max-[640px]:p-[20px]" data-reveal style="--d: 120ms">
          <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
            El alcance, de un vistazo
          </p>
          <ul class="flex flex-col list-none m-0 p-0">
            {scopeItems.map((item, i) => (
              <li class:list={[i > 0 && 'border-t border-[#E8E0D8]']}>
                <a href={item.href} class="group flex items-center justify-between gap-[12px] py-[14px] no-underline">
                  <span class="text-[14px] font-normal leading-[1.5] text-[#1A1A1A] group-hover:text-[#CC3333] transition-colors duration-150">{item.label}</span>
                  <span class="scope-arrow text-[14px] text-[#CC3333]" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============ SERVICES (rice-paper band, sticky scrollytelling) ============ -->
  <section class="mt-[128px] max-[640px]:mt-[72px] w-full bg-[#F7F2EE] py-[96px] max-[640px]:py-[56px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[900px]:grid-cols-1 gap-[64px] max-[1024px]:gap-[40px]" data-svc>
        <!-- Sticky header + media panel -->
        <div>
          <div class="sticky top-[104px] max-[900px]:static">
            <div class="mb-[32px] max-[900px]:mb-[8px]" data-reveal>
              <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[12px]">Nuestros servicios de agencia Douyin</p>
              <h2 class="text-[32px] max-[640px]:text-[24px] font-medium leading-[1.15] tracking-[-0.01em] text-[#1A1A1A] mb-[12px]">
                Seis servicios. Cada uno con un entregable concreto.
              </h2>
              <p class="text-[14px] text-[#5C5C5C] font-normal leading-[1.6] max-w-[420px] m-0">
                Todo figura en su alcance de trabajo antes de firmar. Sin contratos ambiguos.
              </p>
            </div>
            <div class="svc-frame relative max-[900px]:hidden">
              <div class="relative w-full aspect-[1344/570] rounded-[10px] overflow-hidden bg-[#FFFFFF]">
                {services.map((service, i) => (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="1344"
                    height="570"
                    loading={i === 0 ? 'eager' : 'lazy'}
