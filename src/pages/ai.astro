---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import SectionBar from '../components/ui/SectionBar.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
---

<PageLayout
  title="AI changed everything | TheRedScroll"
  description="We build AI into every service, every platform, every client. Strategy is human. Creative direction is human. AI clears everything else out of the way."
>

  <!-- Hero — same pattern as about page: background image + dark overlay -->
  <section class="relative w-full min-h-[600px] max-[640px]:min-h-[500px] overflow-hidden">
    <img
      src="/images/ai/ai-hero.webp"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-[#1A1A1A] opacity-[0.82]" aria-hidden="true"></div>

    <div class="relative z-[1] max-w-[800px] mx-auto px-[48px] max-[1024px]:px-[32px] max-[640px]:px-[20px] pt-[160px] pb-[96px] max-[1024px]:pt-[128px] max-[1024px]:pb-[72px] max-[640px]:pt-[112px] max-[640px]:pb-[56px] text-center">
      <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[16px]">
        Our AI
      </p>
      <h1 class="text-[#FFFFFF] text-[48px] max-[1024px]:text-[40px] max-[640px]:text-[28px] font-medium leading-[1.15] mb-[16px]">
        AI changed everything. We use it every day.
      </h1>
      <p class="text-[rgba(255,255,255,0.7)] text-[18px] max-[640px]:text-[16px] font-normal leading-[1.5] mb-[40px]">
        Built into every service. Every platform. Every client.
      </p>
      <div class="flex items-center justify-center gap-[12px] flex-wrap">
        <Button variant="primary" href="/contact/">Book a call</Button>
        <Button variant="secondary-dark" href="#how-it-works">See how it works</Button>
      </div>
    </div>
  </section>

  <!-- Intro — two-column, same as "Why we exist" on about page -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-start">
        <!-- Left -->
        <div>
          <SectionBar />
          <SectionHeading overline="Why AI">We do not talk about AI. We build it into everything we do.</SectionHeading>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            Market research, social listening, data reporting, performance analysis, project management, content writing, image production, video production. Every service. Every client. Every day.
          </p>
        </div>
        <!-- Right -->
        <div class="flex flex-col pt-[48px] max-[640px]:pt-[0px]">
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)] w-full">
            <p>
              This is not about replacing people. It is about making them better. AI clears the repetitive work out of the way so our team can focus on what actually matters: strategy, creative direction, and client relationships.
            </p>
            <p>
              That is the difference between talking about AI and using it.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- AI does the work — two-column with SVG illustration (same as "Our mission" on about) -->
  <section id="how-it-works" class="mt-[96px] max-[640px]:mt-[64px] scroll-mt-[76px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="AI augments every step of the workflow">
          <svg viewBox="0 0 440 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Title -->
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">AI-AUGMENTED WORKFLOW</text>

            <!-- Step 1: Research -->
            <rect x="20" y="48" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="48" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="68" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">01</text>
            <text x="60" y="68" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">Research</text>
            <text x="40" y="86" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">AI scans thousands of posts and competitor accounts</text>
            <rect x="340" y="58" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="73" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">Hours, not weeks</text>

            <!-- Arrow -->
            <line x1="220" y1="100" x2="220" y2="116" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,114 220,122 225,114" fill="#E8E0D8" />

            <!-- Step 2: Content -->
            <rect x="20" y="124" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="124" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="144" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">02</text>
            <text x="60" y="144" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">Content creation</text>
            <text x="40" y="162" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">AI drafts copy, generates visuals via HubStudio.ai</text>
            <rect x="340" y="134" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="149" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">80% faster</text>

            <!-- Arrow -->
            <line x1="220" y1="176" x2="220" y2="192" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,190 220,198 225,190" fill="#E8E0D8" />

            <!-- Step 3: Review (human) -->
            <rect x="20" y="200" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#1A1A1A" stroke-width="1" />
            <rect x="20" y="200" width="4" height="52" rx="2" fill="#1A1A1A" />
            <text x="40" y="220" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif">03</text>
            <text x="60" y="220" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">Human review</text>
            <text x="40" y="238" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Native editors refine. Creative team reviews every asset.</text>
            <rect x="340" y="210" width="68" height="22" rx="4" fill="#1A1A1A" opacity="0.08" stroke="#1A1A1A" stroke-width="0.5" />
            <text x="374" y="225" text-anchor="middle" fill="#1A1A1A" font-size="7" font-weight="500" font-family="Inter, sans-serif">100% human</text>

            <!-- Arrow -->
            <line x1="220" y1="252" x2="220" y2="268" stroke="#E8E0D8" stroke-width="1.5" />
            <polygon points="215,266 220,274 225,266" fill="#E8E0D8" />

            <!-- Step 4: Reporting -->
            <rect x="20" y="276" width="400" height="52" rx="6" fill="#FFFFFF" stroke="#E8E0D8" stroke-width="0.5" />
            <rect x="20" y="276" width="4" height="52" rx="2" fill="#CC3333" />
            <text x="40" y="296" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif">04</text>
            <text x="60" y="296" fill="#1A1A1A" font-size="11" font-weight="500" font-family="Inter, sans-serif">Reporting</text>
            <text x="40" y="314" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">AI compiles data. Strategists interpret and recommend.</text>
            <rect x="340" y="286" width="68" height="22" rx="4" fill="#CC3333" opacity="0.1" stroke="#CC3333" stroke-width="0.5" />
            <text x="374" y="301" text-anchor="middle" fill="#CC3333" font-size="7" font-weight="500" font-family="Inter, sans-serif">Real-time data</text>

            <!-- Bottom stats -->
            <line x1="20" y1="348" x2="420" y2="348" stroke="#E8E0D8" stroke-width="0.5" />

            <g transform="translate(20, 364)">
              <text x="0" y="12" fill="#CC3333" font-size="18" font-weight="500" font-family="Inter, sans-serif">AI</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">handles the volume</text>
            </g>
            <g transform="translate(150, 364)">
              <text x="0" y="12" fill="#1A1A1A" font-size="18" font-weight="500" font-family="Inter, sans-serif">People</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">handle the thinking</text>
            </g>
            <g transform="translate(310, 364)">
              <text x="0" y="12" fill="#1A1A1A" font-size="18" font-weight="500" font-family="Inter, sans-serif">100%</text>
              <text x="0" y="26" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">reviewed by humans</text>
            </g>
          </svg>
        </div>
        <div>
          <SectionBar />
          <SectionHeading overline="How it works">AI does the work. We do the thinking.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              Our social media managers are augmented by AI. The repetitive, time-consuming tasks disappear. What stays is the work that matters most.
            </p>
            <p>
              Strategy is human. Creative direction is human. Client relationships are human. AI makes all three better by clearing everything else out of the way.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- AI vs Human table — two-column with SVG on right (same as "Our vision" on about, reversed) -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
          <SectionHeading overline="Division of labor">AI handles the volume. People handle the thinking.</SectionHeading>
          <div class="flex flex-col gap-[24px] text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            <p>
              AI drafts copy in Chinese and English. Our team defines your brand voice and content pillars. AI generates product visuals and video. Our team sets the creative direction and reviews every asset.
            </p>
            <p>
              AI compiles performance data into reports. Our strategists interpret the data and adjust your strategy. AI screens thousands of KOL (Key Opinion Leader) profiles and flags fake followers. Our team picks the right influencers and negotiates the deal.
            </p>
          </div>
          <!-- Callout — same pattern as about page "Our vision" callout -->
          <div class="bg-[#F0F1F4] border-l-[3px] border-[#CC3333] rounded-none p-[20px] mt-[24px]">
            <p class="text-[16px] font-normal text-[#1A1A1A] leading-[1.6] m-0">
              Every piece of content is reviewed by a human before it goes live. Every single one.
            </p>
          </div>
        </div>
        <div class="w-full bg-[#F0F1F4] rounded-[8px] p-[32px] max-[640px]:p-[20px]" aria-label="AI versus human responsibility split">
          <svg viewBox="0 0 440 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
            <!-- Title -->
            <text x="220" y="24" text-anchor="middle" fill="#5C5C5C" font-size="10" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.05em">WHO DOES WHAT</text>

            <!-- Column headers -->
            <rect x="20" y="44" width="196" height="28" rx="4" fill="#CC3333" opacity="0.1" />
            <text x="118" y="62" text-anchor="middle" fill="#CC3333" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">AI DOES THIS</text>
            <rect x="224" y="44" width="196" height="28" rx="4" fill="#1A1A1A" opacity="0.06" />
            <text x="322" y="62" text-anchor="middle" fill="#1A1A1A" font-size="9" font-weight="500" font-family="Inter, sans-serif" letter-spacing="0.03em">OUR TEAM DOES THIS</text>

            <!-- Row 1 -->
            <line x1="20" y1="84" x2="420" y2="84" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="102" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Drafts copy in Chinese and English</text>
            <text x="232" y="102" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Defines brand voice and content pillars</text>

            <!-- Row 2 -->
            <line x1="20" y1="116" x2="420" y2="116" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="134" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Generates product visuals and video</text>
            <text x="232" y="134" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Sets creative direction, reviews every asset</text>

            <!-- Row 3 -->
            <line x1="20" y1="148" x2="420" y2="148" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="166" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Compiles performance data into reports</text>
            <text x="232" y="166" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Interprets data and adjusts your strategy</text>

            <!-- Row 4 -->
            <line x1="20" y1="180" x2="420" y2="180" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="198" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Monitors brand mentions and trends</text>
            <text x="232" y="198" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Decides what to act on and how to respond</text>

            <!-- Row 5 -->
            <line x1="20" y1="212" x2="420" y2="212" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="230" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Tracks deadlines and content approvals</text>
            <text x="232" y="230" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Runs workshops and asks the hard questions</text>

            <!-- Row 6 -->
            <line x1="20" y1="244" x2="420" y2="244" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="262" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Scans thousands of competitor posts</text>
            <text x="232" y="262" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Picks which platforms fit your audience</text>

            <!-- Row 7 -->
            <line x1="20" y1="276" x2="420" y2="276" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="294" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Produces first drafts of monthly reports</text>
            <text x="232" y="294" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Writes the strategic recommendations</text>

            <!-- Row 8 -->
            <line x1="20" y1="308" x2="420" y2="308" stroke="#E8E0D8" stroke-width="0.5" />
            <text x="28" y="326" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Screens KOL profiles, flags fake followers</text>
            <text x="232" y="326" fill="#1A1A1A" font-size="8" font-weight="500" font-family="Inter, sans-serif">Picks the right influencers, negotiates</text>
            <line x1="20" y1="340" x2="420" y2="340" stroke="#E8E0D8" stroke-width="0.5" />

            <!-- Bottom summary -->
            <g transform="translate(20, 360)">
              <rect x="0" y="0" width="196" height="40" rx="6" fill="#CC3333" opacity="0.08" />
              <text x="98" y="17" text-anchor="middle" fill="#CC3333" font-size="14" font-weight="500" font-family="Inter, sans-serif">Speed and scale</text>
              <text x="98" y="32" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Volume, data, first drafts</text>
            </g>
            <g transform="translate(224, 360)">
              <rect x="0" y="0" width="196" height="40" rx="6" fill="#1A1A1A" opacity="0.06" />
              <text x="98" y="17" text-anchor="middle" fill="#1A1A1A" font-size="14" font-weight="500" font-family="Inter, sans-serif">Judgment and taste</text>
              <text x="98" y="32" text-anchor="middle" fill="#5C5C5C" font-size="8" font-family="Inter, sans-serif">Strategy, nuance, relationships</text>
            </g>
          </svg>
        </div>
      </div>
    </Container>
  </section>

  <!-- Better content — rice paper card, same as about page "clients who trust" stats section -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="bg-[#F0F1F4] rounded-[10px] p-[48px] max-[1024px]:p-[32px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.05em] leading-[1.2] text-[#CC3333] mb-[24px] text-center">Better content. Not fake content.</p>
        <div class="grid grid-cols-3 max-[640px]:grid-cols-1 gap-[32px] max-[640px]:gap-[24px] text-center">
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]">0</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">Generic AI posts published</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#1A1A1A] mb-[4px]">100%</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">Content reviewed by a human</p>
          </div>
          <div>
            <p class="text-[28px] max-[640px]:text-[22px] font-medium leading-[1.2] text-[#CC3333] mb-[4px]">Every single one</p>
            <p class="text-[13px] font-normal text-[#5C5C5C] leading-[1.4]">Native Chinese editors refine every draft</p>
          </div>
        </div>
        <div class="max-w-[680px] mx-auto mt-[32px] flex flex-col gap-[24px] text-center">
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-ink)]">
            We do not publish fake AI content. No generic posts. No robotic captions. No obvious AI images dumped onto a feed. That is the fastest way to lose followers and credibility on Chinese platforms.
          </p>
          <p class="text-[16px] font-normal leading-[1.6] text-[var(--color-stone)]">
            AI drafts copy. Native Chinese editors refine it. AI generates product visuals through HubStudio.ai. Our creative team reviews every frame. AI pulls data for reports. Our strategists interpret it and tell you what it means.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Where AI shows up — numbered cards, same as about page "Our values" grid -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <SectionBar />
      <SectionHeading overline="Applications">Where AI shows up in our work</SectionHeading>

      <div class="grid grid-cols-2 max-[640px]:grid-cols-1 gap-[16px] mt-[24px]">
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-market-research.svg" alt="Market research illustration" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Market research</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">AI scans thousands of posts, comments, and competitor accounts in hours. Not weeks.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-social-listening.svg" alt="Social listening illustration" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Social listening</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">Real-time monitoring across WeChat, Douyin, RedNote, Weibo, and 14 more platforms. AI flags trends, sentiment shifts, and brand mentions as they happen.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-content-writing.svg" alt="Content writing illustration" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Content writing</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">AI produces first drafts in Chinese and English. Native speakers edit for tone, cultural context, and platform-specific format.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-image-video.svg" alt="Image and video production illustration" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Image and video production</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">HubStudio.ai generates product visuals, lifestyle imagery, and short-form video. Custom AI models trained on your brand identity. 80% faster. A fraction of the cost.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-performance-reporting.svg" alt="Performance reporting illustration" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Performance reporting</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">AI compiles data across every platform into one clear report. No manual spreadsheets. No three-week delays.</p>
        </div>
        <div class="bg-[var(--color-rice-paper)] rounded-[10px] p-[24px] max-[640px]:p-[20px]">
          <img src="/images/ai/ai-project-management.svg" alt="Project management illustration" class="w-full rounded-[8px] mb-[16px]" loading="lazy" decoding="async" />
          <h3 class="text-[18px] font-medium leading-[1.3] text-[var(--color-ink)] mb-[8px]">Project management</h3>
          <p class="text-[14px] font-normal leading-[1.5] text-[var(--color-stone)]">AI tracks deadlines, content approvals, and campaign milestones so nothing falls through the cracks.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Budget — two-column with SVG (same as about "Our vision" section, reversed) -->
  <section class="mt-[96px] max-[640px]:mt-[64px]">
    <Container>
      <div class="grid grid-cols-[1fr_1fr] max-[640px]:grid-cols-1 gap-[48px] max-[640px]:gap-[32px] items-center">
        <div>
          <SectionBar />
